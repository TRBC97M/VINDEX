// Bibliotheca componendi codicem machinalis x86-64, tota in VINDEX scripta.
// Continet omnes functiones ex prioribus experimentis collectas.

FUNCTIO SCRIBE_U16 REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    codex[indice] = valor & 255.
    codex[indice + 1] = (valor >> 8) & 255.
    REDDE indice + 2.
FIN-FUNCTIO.

FUNCTIO SCRIBE_U32 REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    codex[indice] = valor & 255.
    codex[indice + 1] = (valor >> 8) & 255.
    codex[indice + 2] = (valor >> 16) & 255.
    codex[indice + 3] = (valor >> 24) & 255.
    REDDE indice + 4.
FIN-FUNCTIO.

FUNCTIO SCRIBE_U64 REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    codex[indice] = valor & 255.
    codex[indice + 1] = (valor >> 8) & 255.
    codex[indice + 2] = (valor >> 16) & 255.
    codex[indice + 3] = (valor >> 24) & 255.
    codex[indice + 4] = (valor >> 32) & 255.
    codex[indice + 5] = (valor >> 40) & 255.
    codex[indice + 6] = (valor >> 48) & 255.
    codex[indice + 7] = (valor >> 56) & 255.
    REDDE indice + 8.
FIN-FUNCTIO.

FUNCTIO CONSTRUE_CAPUT_ELF REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT mensura_codicis SICUT NUMERUS.
    DECLARA basis SICUT NUMERUS VALENS 4194304.
    DECLARA ignoratum SICUT NUMERUS VALENS 0.

    codex[0] = 127.
    codex[1] = 69.
    codex[2] = 76.
    codex[3] = 70.
    codex[4] = 2.
    codex[5] = 1.
    codex[6] = 1.
    codex[7] = 0.

    ignoratum = SCRIBE_U16(codex, 16, 2).
    ignoratum = SCRIBE_U16(codex, 18, 62).
    ignoratum = SCRIBE_U32(codex, 20, 1).
    ignoratum = SCRIBE_U64(codex, 24, basis + 120).
    ignoratum = SCRIBE_U64(codex, 32, 64).
    ignoratum = SCRIBE_U64(codex, 40, 0).
    ignoratum = SCRIBE_U32(codex, 48, 0).
    ignoratum = SCRIBE_U16(codex, 52, 64).
    ignoratum = SCRIBE_U16(codex, 54, 56).
    ignoratum = SCRIBE_U16(codex, 56, 1).
    ignoratum = SCRIBE_U16(codex, 58, 0).
    ignoratum = SCRIBE_U16(codex, 60, 0).
    ignoratum = SCRIBE_U16(codex, 62, 0).

    ignoratum = SCRIBE_U32(codex, 64, 1).
    ignoratum = SCRIBE_U32(codex, 68, 7).
    ignoratum = SCRIBE_U64(codex, 72, 0).
    ignoratum = SCRIBE_U64(codex, 80, basis).
    ignoratum = SCRIBE_U64(codex, 88, basis).
    DECLARA mensura_totalis SICUT NUMERUS VALENS 120 + mensura_codicis.
    ignoratum = SCRIBE_U64(codex, 96, mensura_totalis).
    ignoratum = SCRIBE_U64(codex, 104, mensura_totalis).
    ignoratum = SCRIBE_U64(codex, 112, 4096).

    REDDE 120.
FIN-FUNCTIO.

FUNCTIO COMPONE_ONERA REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI registrum >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 184 + (registrum & 7).
    codex[indice + 2] = valor & 255.
    codex[indice + 3] = (valor >> 8) & 255.
    codex[indice + 4] = (valor >> 16) & 255.
    codex[indice + 5] = (valor >> 24) & 255.
    codex[indice + 6] = (valor >> 32) & 255.
    codex[indice + 7] = (valor >> 40) & 255.
    codex[indice + 8] = (valor >> 48) & 255.
    codex[indice + 9] = (valor >> 56) & 255.
    REDDE indice + 10.
FIN-FUNCTIO.

FUNCTIO COMPONE_ARITHMETICA REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT opcode SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI fons >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI destinatio >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = opcode.
    codex[indice + 2] = 192 + ((fons & 7) * 8) + (destinatio & 7).
    REDDE indice + 3.
FIN-FUNCTIO.

FUNCTIO COMPONE_ADD REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 1, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_SUB REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 41, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_CMP REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 57, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_MULTIPLICA REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI destinatio >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI fons >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 15.
    codex[indice + 2] = 175.
    codex[indice + 3] = 192 + ((destinatio & 7) * 8) + (fons & 7).
    REDDE indice + 4.
FIN-FUNCTIO.

FUNCTIO COMPONE_TRANSCRIBE REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI fons >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI destinatio >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 137.
    codex[indice + 2] = 192 + ((fons & 7) * 8) + (destinatio & 7).
    REDDE indice + 3.
FIN-FUNCTIO.

FUNCTIO COMPONE_SERVA_PILA REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT intervallum SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI registrum >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 137.
    codex[indice + 2] = 128 + ((registrum & 7) * 8) + 5.
    codex[indice + 3] = intervallum & 255.
    codex[indice + 4] = (intervallum >> 8) & 255.
    codex[indice + 5] = (intervallum >> 16) & 255.
    codex[indice + 6] = (intervallum >> 24) & 255.
    REDDE indice + 7.
FIN-FUNCTIO.

FUNCTIO COMPONE_SUME_PILA REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT intervallum SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI registrum >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 139.
    codex[indice + 2] = 128 + ((registrum & 7) * 8) + 5.
    codex[indice + 3] = intervallum & 255.
    codex[indice + 4] = (intervallum >> 8) & 255.
    codex[indice + 5] = (intervallum >> 16) & 255.
    codex[indice + 6] = (intervallum >> 24) & 255.
    REDDE indice + 7.
FIN-FUNCTIO.

FUNCTIO COMPONE_JNE_RETRO REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    codex[indice] = 15.
    codex[indice + 1] = 133.
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (indice + 6).
    codex[indice + 2] = relatio & 255.
    codex[indice + 3] = (relatio >> 8) & 255.
    codex[indice + 4] = (relatio >> 16) & 255.
    codex[indice + 5] = (relatio >> 24) & 255.
    REDDE indice + 6.
FIN-FUNCTIO.

FUNCTIO COMPONE_JNE_FUTURUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT loci SICUT ACUS<NUMERUS>.
    codex[indice] = 15.
    codex[indice + 1] = 133.
    CONTENTUM(loci) = indice + 2.
    REDDE indice + 6.
FIN-FUNCTIO.

FUNCTIO COMPONE_JMP_FUTURUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT loci SICUT ACUS<NUMERUS>.
    codex[indice] = 233.
    CONTENTUM(loci) = indice + 1.
    REDDE indice + 5.
FIN-FUNCTIO.

FUNCTIO COMPONE_JGE_FUTURUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT loci SICUT ACUS<NUMERUS>.
    codex[indice] = 15.
    codex[indice + 1] = 141.
    CONTENTUM(loci) = indice + 2.
    REDDE indice + 6.
FIN-FUNCTIO.

FUNCTIO COMPONE_JMP_RETRO REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    codex[indice] = 233.
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (indice + 5).
    codex[indice + 1] = relatio & 255.
    codex[indice + 2] = (relatio >> 8) & 255.
    codex[indice + 3] = (relatio >> 16) & 255.
    codex[indice + 4] = (relatio >> 24) & 255.
    REDDE indice + 5.
FIN-FUNCTIO.

FUNCTIO CORRIGE_SALTUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT loci SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (loci + 4).
    codex[loci] = relatio & 255.
    codex[loci + 1] = (relatio >> 8) & 255.
    codex[loci + 2] = (relatio >> 16) & 255.
    codex[loci + 3] = (relatio >> 24) & 255.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO COMPONE_IMPONE REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    DECLARA fin SICUT NUMERUS VALENS indice.
    SI registrum >= 8 TUNC
        codex[fin] = 65.
        fin = fin + 1.
    FIN-SI.
    codex[fin] = 80 + (registrum & 7).
    REDDE fin + 1.
FIN-FUNCTIO.

FUNCTIO COMPONE_AUFER REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    DECLARA fin SICUT NUMERUS VALENS indice.
    SI registrum >= 8 TUNC
        codex[fin] = 65.
        fin = fin + 1.
    FIN-SI.
    codex[fin] = 88 + (registrum & 7).
    REDDE fin + 1.
FIN-FUNCTIO.

FUNCTIO COMPONE_VOCA_FUTURUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT loci SICUT ACUS<NUMERUS>.
    codex[indice] = 232.
    CONTENTUM(loci) = indice + 1.
    REDDE indice + 5.
FIN-FUNCTIO.

FUNCTIO COMPONE_REVERTE REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    codex[indice] = 195.
    REDDE indice + 1.
FIN-FUNCTIO.

FUNCTIO COMPONE_VOCA_NUCLEUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    codex[indice] = 15.
    codex[indice + 1] = 5.
    REDDE indice + 2.
FIN-FUNCTIO.


FUNCTIO IGNORA_SPATIA REDDENS NUMERUS.
    ACCIPIT fons SICUT ORDO DE LITTERA.
    ACCIPIT pos SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    DUM CONTENTUM(pos) < n && fons[CONTENTUM(pos)] == 32 PERFICE
        CONTENTUM(pos) = CONTENTUM(pos) + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO CERCA_VARIABILEM REDDENS NUMERUS.
    ACCIPIT tabula SICUT ORDO DE NUMERUS.
    ACCIPIT nomen SICUT NUMERUS.
    DECLARA idx SICUT NUMERUS VALENS 0.
    DUM idx < 26 && tabula[idx] != 0 PERFICE
        SI tabula[idx] == nomen TUNC
            REDDE tabula[idx + 26].
        FIN-SI.
        idx = idx + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ANALYSA_FACTOR REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT pos_codicis SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ORDO DE LITTERA.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT tabula SICUT ORDO DE NUMERUS.

    DECLARA ignoratum SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).

    SI fons[CONTENTUM(pos_fontis)] == 40 TUNC
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        DECLARA r SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        REDDE 0.
    FIN-SI.

    SI (fons[CONTENTUM(pos_fontis)] >= 97 && fons[CONTENTUM(pos_fontis)] <= 122) TUNC
        DECLARA nomen SICUT NUMERUS VALENS fons[CONTENTUM(pos_fontis)].
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        DECLARA intervallum SICUT NUMERUS VALENS CERCA_VARIABILEM(tabula, nomen).
        CONTENTUM(pos_codicis) = COMPONE_SUME_PILA(codex, CONTENTUM(pos_codicis), 0, intervallum).
        REDDE 0.
    FIN-SI.

    DECLARA valor SICUT NUMERUS VALENS 0.
    DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] >= 48 && fons[CONTENTUM(pos_fontis)] <= 57 PERFICE
        valor = valor * 10 + (fons[CONTENTUM(pos_fontis)] - 48).
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
    FIN-DUM.
    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 0, valor).
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ANALYSA_TERMINUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT pos_codicis SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ORDO DE LITTERA.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT tabula SICUT ORDO DE NUMERUS.

    DECLARA ignoratum SICUT NUMERUS VALENS ANALYSA_FACTOR(codex, pos_codicis, fons, pos_fontis, n, tabula).

    ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] == 42 PERFICE
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
        ignoratum = ANALYSA_FACTOR(codex, pos_codicis, fons, pos_fontis, n, tabula).
        CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
        CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
        CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 0, 3).
        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ANALYSA_EXPRESSIO REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT pos_codicis SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ORDO DE LITTERA.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT tabula SICUT ORDO DE NUMERUS.

    DECLARA ignoratum SICUT NUMERUS VALENS ANALYSA_TERMINUM(codex, pos_codicis, fons, pos_fontis, n, tabula).

    ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    DUM CONTENTUM(pos_fontis) < n && (fons[CONTENTUM(pos_fontis)] == 43 || fons[CONTENTUM(pos_fontis)] == 45) PERFICE
        DECLARA operatio SICUT NUMERUS VALENS fons[CONTENTUM(pos_fontis)].
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
        ignoratum = ANALYSA_TERMINUM(codex, pos_codicis, fons, pos_fontis, n, tabula).
        CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
        CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
        SI operatio == 43 TUNC
            CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 0, 3).
        ALITER
            CONTENTUM(pos_codicis) = COMPONE_SUB(codex, CONTENTUM(pos_codicis), 0, 3).
        FIN-SI.
        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("probaZ.vindex").
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 2000).
    CLAUDE(fd).

    DECLARA fons SICUT ORDO DE LITTERA CAPACITAS 2000.
    DECLARA k SICUT NUMERUS VALENS 0.
    DUM k < n PERFICE
        fons[k] = OCTETUS(k).
        k = k + 1.
    FIN-DUM.

    DECLARA codex SICUT ORDO DE NUMERUS CAPACITAS 400.
    DECLARA pos SICUT NUMERUS VALENS 120.

    pos = COMPONE_IMPONE(codex, pos, 5).
    pos = COMPONE_TRANSCRIBE(codex, pos, 5, 4).

    DECLARA tabula SICUT ORDO DE NUMERUS CAPACITAS 52.
    DECLARA numerus_variabilium SICUT NUMERUS VALENS 0.
    DECLARA intervallum_currens SICUT NUMERUS VALENS 0 - 8.

    DECLARA i SICUT NUMERUS VALENS 0.

    DUM i < n PERFICE
        SI fons[i] == 68 && i + 6 < n && fons[i+1] == 69 && fons[i+2] == 67 && fons[i+3] == 76 && fons[i+4] == 65 && fons[i+5] == 82 && fons[i+6] == 65 TUNC
            i = i + 7.
            DUM i < n && fons[i] == 32 PERFICE
                i = i + 1.
            FIN-DUM.
            DECLARA nomen SICUT NUMERUS VALENS fons[i].
            DUM i < n && (fons[i] < 48 || fons[i] > 57) PERFICE
                i = i + 1.
            FIN-DUM.
            DECLARA valor_init SICUT NUMERUS VALENS 0.
            DUM i < n && fons[i] >= 48 && fons[i] <= 57 PERFICE
                valor_init = valor_init * 10 + (fons[i] - 48).
                i = i + 1.
            FIN-DUM.

            tabula[numerus_variabilium] = nomen.
            tabula[numerus_variabilium + 26] = intervallum_currens.
            numerus_variabilium = numerus_variabilium + 1.

            pos = COMPONE_ONERA(codex, pos, 0, valor_init).
            pos = COMPONE_SERVA_PILA(codex, pos, intervallum_currens, 0).
            intervallum_currens = intervallum_currens - 8.

        ALITER
            SI fons[i] == 82 && i + 5 < n && fons[i+1] == 69 && fons[i+2] == 68 && fons[i+3] == 68 && fons[i+4] == 69 && fons[i+5] == 32 TUNC
                i = i + 6.
                DECLARA ignoratum SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, SEDES(pos), fons, SEDES(i), n, tabula).
                i = n.
            ALITER
                SI (fons[i] >= 97 && fons[i] <= 122) && i + 1 < n && fons[i+1] == 32 TUNC
                    DECLARA nomen_affectatio SICUT NUMERUS VALENS fons[i].
                    DECLARA intervallum_affectatio SICUT NUMERUS VALENS CERCA_VARIABILEM(tabula, nomen_affectatio).
                    i = i + 1.
                    DUM i < n && fons[i] == 32 PERFICE
                        i = i + 1.
                    FIN-DUM.
                    SI i < n && fons[i] == 61 && (i+1>=n || fons[i+1] != 61) TUNC
                        i = i + 1.
                        DECLARA ignoratum2 SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, SEDES(pos), fons, SEDES(i), n, tabula).
                        pos = COMPONE_SERVA_PILA(codex, pos, intervallum_affectatio, 0).
                    FIN-SI.
                ALITER
                    i = i + 1.
                FIN-SI.
            FIN-SI.
        FIN-SI.
    FIN-DUM.

    pos = COMPONE_TRANSCRIBE(codex, pos, 7, 0).
    pos = COMPONE_ONERA(codex, pos, 0, 60).
    pos = COMPONE_VOCA_NUCLEUM(codex, pos).

    DECLARA ignoratum2 SICUT NUMERUS VALENS CONSTRUE_CAPUT_ELF(codex, pos - 120).

    DECLARA fd_scriptio SICUT NUMERUS VALENS APERI_SCRIBERE("probaZ_compilata").
    DECLARA scriptum SICUT NUMERUS VALENS MITTE(fd_scriptio, codex, pos).
    CLAUDE(fd_scriptio).

    PROCLAMA pos.
    PROCLAMA numerus_variabilium.

    REDDE 0.
FIN-FUNCTIO.
