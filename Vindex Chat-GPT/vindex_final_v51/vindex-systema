#!/usr/bin/env bash
# VINDEX Fenestrale in machina virtuali QEMU incipit.

set -eu

INITIATOR="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
RADIX="$(cd "$(dirname "$INITIATOR")" && pwd)"
QEMU="${VINDEX_QEMU:-qemu-system-x86_64}"

if ! command -v "$QEMU" >/dev/null 2>&1; then
    printf '%s\n' "ERRATUM: qemu-system-x86_64 deest." >&2
    printf '%s\n' "Fedora: sudo dnf install qemu-system-x86-core" >&2
    exit 69
fi
if [ ! -f "$RADIX/systema_vindex.img" ]; then
    printf '%s\n' "ERRATUM: imago Systematis deest; make systema exsequere." >&2
    exit 66
fi

exec "$QEMU" \
    -name "VINDEX Fenestrale" \
    -machine pc \
    -cpu qemu64 \
    -m 128M \
    -drive "format=raw,file=$RADIX/systema_vindex.img,if=ide,index=0" \
    -boot c \
    "$@"
