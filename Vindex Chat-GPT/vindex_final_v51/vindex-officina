#!/usr/bin/env bash
# Initiator portabilis Officinae VINDEX graphicae.

set -eu

INITIATOR="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
RADIX="$(cd "$(dirname "$INITIATOR")" && pwd)"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
PROJECTA="${VINDEX_PROJECTA_DIR:-$DATA_HOME/vindex-officina/projecta}"

if [ ! -x "$RADIX/officina_vindex" ] || \
   [ ! -x "$RADIX/vindex_graphica" ] || \
   [ ! -x "$RADIX/compilator_vindex" ] || \
   [ ! -f "$RADIX/formae/officina.forma" ]; then
    printf '%s\n' "ERRATUM: fasciculus Officinae imperfectus est." >&2
    exit 66
fi

FONS=""
if [ "$#" -ge 1 ]; then
    FONS="$(readlink -f -- "$1")"
fi

mkdir -p "$PROJECTA"
cd "$PROJECTA"

if [ -n "$FONS" ]; then
    exec "$RADIX/officina_vindex" "$RADIX/vindex_graphica" "$RADIX/compilator_vindex" \
        "$RADIX/formae/officina.forma" "$FONS"
fi
exec "$RADIX/officina_vindex" "$RADIX/vindex_graphica" "$RADIX/compilator_vindex" \
    "$RADIX/formae/officina.forma"
