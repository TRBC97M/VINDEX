// P11-E — regressio functionis ordinariae cum VIII argumentis.
// Distinctio positionum: OCTO(1,2,3,4,5,6,7,8) = 87654321.
// Custodit simul callerem et callee: VII est [rbp+16], VIII [rbp+24].

FUNCTIO OCTO REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT d SICUT NUMERUS.
    ACCIPIT e SICUT NUMERUS.
    ACCIPIT f SICUT NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    REDDE a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000 + h * 10000000.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA r SICUT NUMERUS VALENS OCTO(1, 2, 3, 4, 5, 6, 7, 8).
    PROCLAMA "ARGUMENTA OCTO".
    PROCLAMA r.
    SI r != 87654321 TUNC REDDE 81. FIN-SI.
    PROCLAMA "ARGUMENTA OCTO RECTE".
    REDDE 0.
FIN-FUNCTIO.