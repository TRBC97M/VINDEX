IMPORTA "bibliotheca/textus.vindex".
IMPORTA "bibliotheca/win32_ffi.vindex".
IMPORTA "bibliotheca/win32_app.vindex".

FUNCTIO MEM_I32_LEGE_LOCALIS REDDENS NUMERUS.
    ACCIPIT p SICUT NUMERUS.
    ACCIPIT off SICUT NUMERUS.
    DECLARA v SICUT NUMERUS VALENS OCTETUS_AB(p + off).
    v = v | (OCTETUS_AB(p + off + 1) << 8).
    v = v | (OCTETUS_AB(p + off + 2) << 16).
    v = v | (OCTETUS_AB(p + off + 3) << 24).
    SI v >= 2147483648 TUNC v = v - 4294967296. FIN-SI.
    REDDE v.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    ACCIPIT argc SICUT NUMERUS.
    ACCIPIT argv SICUT ACUS<NUMERUS>.

    // Haec probatio deliberate WINAPP_PRAESENTA cum VIII argumentis exercet.
    // Ita API Win32 simul regressionem ABI ordinariae P11-E custodit.
    PROCLAMA "WINAPP GRADUS 0".
    DECLARA ctx SICUT NUMERUS VALENS WINAPP_CONTEXUS_CREA().
    SI ctx == 0 TUNC REDDE 10. FIN-SI.
    PROCLAMA "WINAPP GRADUS 1 CONTEXTUS".
    DECLARA titulus SICUT TEXTUS VALENS "VINDEX WIN32 APP TEST".
    DECLARA hwnd SICUT NUMERUS VALENS WINAPP_FENESTRA_CREA(ctx, titulus, 160, 120).
    SI hwnd == 0 TUNC REDDE 11. FIN-SI.
    PROCLAMA "WINAPP GRADUS 2 FENESTRA".
    DECLARA hdc SICUT NUMERUS VALENS WINAPP_HDC_CAPE(ctx, hwnd).
    SI hdc == 0 TUNC REDDE 12. FIN-SI.
    PROCLAMA "WINAPP GRADUS 3 HDC".

    DECLARA rect SICUT NUMERUS VALENS RESERVA_OCTETA(16).
    DECLARA point SICUT NUMERUS VALENS RESERVA_OCTETA(8).
    DECLARA msg SICUT NUMERUS VALENS RESERVA_OCTETA(48).
    SI rect <= 0 || point <= 0 || msg <= 0 TUNC REDDE 13. FIN-SI.
    SI WINAPP_CLIENT_RECT(ctx, hwnd, rect) == 0 TUNC REDDE 14. FIN-SI.
    DECLARA dw SICUT NUMERUS VALENS MEM_I32_LEGE_LOCALIS(rect, 8).
    DECLARA dh SICUT NUMERUS VALENS MEM_I32_LEGE_LOCALIS(rect, 12).
    SI dw <= 0 || dh <= 0 TUNC REDDE 15. FIN-SI.
    PROCLAMA "WINAPP GRADUS 4 RECT".

    DECLARA pixels SICUT NUMERUS VALENS RESERVA_OCTETA(8 * 8 * 4).
    DECLARA bmi SICUT NUMERUS VALENS WINAPP_BITMAPINFO_CREA(8, 8).
    SI pixels <= 0 || bmi <= 0 TUNC REDDE 16. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < 64 PERFICE
        DECLARA p SICUT NUMERUS VALENS pixels + i * 4.
        SCRIBE_OCTETUM_AB(p, 12).
        SCRIBE_OCTETUM_AB(p + 1, 180).
        SCRIBE_OCTETUM_AB(p + 2, 32).
        SCRIBE_OCTETUM_AB(p + 3, 0).
        i = i + 1.
    FIN-DUM.
    PROCLAMA "WINAPP GRADUS 5 BUFFER".
    DECLARA superficies SICUT NUMERUS VALENS WINAPP_SUPERFICIES_CREA(pixels, bmi, 8, 8).
    SI superficies == 0 TUNC REDDE 17. FIN-SI.
    SI WINAPP_SUPERFICIES_DESTINATIO(superficies, hdc, dw, dh) == 0 TUNC REDDE 18. FIN-SI.
    DECLARA lineae SICUT NUMERUS VALENS WINAPP_PRAESENTA(ctx, superficies).
    SI lineae != 8 TUNC REDDE 19. FIN-SI.
    PROCLAMA "WINAPP GRADUS 6 PRAESENTA".

    SI WINAPP_TEXTUS_MODUS(ctx, hdc, 6091336) == 0 TUNC REDDE 18. FIN-SI.
    DECLARA s SICUT TEXTUS VALENS "WINAPP RECTE".
    SI WINAPP_TEXTUS(ctx, hdc, 4, 4, s) == 0 TUNC REDDE 19. FIN-SI.
    PROCLAMA "WINAPP GRADUS 7 TEXTUS".

    SI WINAPP_CURSOR_CAPE(ctx, point) == 0 TUNC REDDE 20. FIN-SI.
    SI WINAPP_SCREEN_AD_CLIENT(ctx, hwnd, point) == 0 TUNC REDDE 21. FIN-SI.
    DECLARA esc SICUT NUMERUS VALENS WINAPP_CLAVIS(ctx, 27).
    DECLARA n SICUT NUMERUS VALENS WINAPP_NUNTIUM_CAPE(ctx, msg).
    SI n != 0 TUNC DECLARA d SICUT NUMERUS VALENS WINAPP_NUNTIUM_DISPATCH(ctx, msg). FIN-SI.
    SI WINAPP_VIVIT(ctx, hwnd) == 0 TUNC REDDE 22. FIN-SI.
    PROCLAMA "WINAPP GRADUS 8 INPUT".

    DECLARA rel SICUT NUMERUS VALENS WINAPP_HDC_LIBERA(ctx, hwnd, hdc).
    DECLARA del SICUT NUMERUS VALENS WINAPP_FENESTRA_DELE(ctx, hwnd).
    PROCLAMA "WIN32 APP RECTE".
    PROCLAMA lineae.
    REDDE 0.
FIN-FUNCTIO.