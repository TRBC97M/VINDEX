IMPORTA "bibliotheca/vectores_numerorum.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA v SICUT NUMERUS VALENS VN_CREA().
    SI v == 0 TUNC REDDE 10. FIN-SI.
    SI VN_NUMERUS(v) != 0 TUNC REDDE 11. FIN-SI.
    SI VN_CAPACITAS(v) < 4 TUNC REDDE 12. FIN-SI.

    DECLARA i SICUT NUMERUS VALENS 1.
    DUM i <= 10 PERFICE
        SI VN_ADDE(v, i * 10) == 0 TUNC REDDE 20. FIN-SI.
        i = i + 1.
    FIN-DUM.

    SI VN_NUMERUS(v) != 10 TUNC REDDE 21. FIN-SI.
    SI VN_CAPACITAS(v) < 10 TUNC REDDE 22. FIN-SI.
    SI VN_CAPE(v, 0) != 10 TUNC REDDE 23. FIN-SI.
    SI VN_CAPE(v, 9) != 100 TUNC REDDE 24. FIN-SI.

    SI VN_PONE(v, 4, 99) == 0 TUNC REDDE 30. FIN-SI.
    SI VN_CAPE(v, 4) != 99 TUNC REDDE 31. FIN-SI.

    SI VN_DELE(v, 0) == 0 TUNC REDDE 40. FIN-SI.
    SI VN_NUMERUS(v) != 9 TUNC REDDE 41. FIN-SI.
    SI VN_CAPE(v, 0) != 20 TUNC REDDE 42. FIN-SI.

    SI VN_DELE(v, 3) == 0 TUNC REDDE 50. FIN-SI.
    SI VN_NUMERUS(v) != 8 TUNC REDDE 51. FIN-SI.
    SI VN_CAPE(v, 3) != 60 TUNC REDDE 52. FIN-SI.

    SI VN_DELE(v, VN_NUMERUS(v) - 1) == 0 TUNC REDDE 60. FIN-SI.
    SI VN_NUMERUS(v) != 7 TUNC REDDE 61. FIN-SI.
    SI VN_CAPE(v, 6) != 90 TUNC REDDE 62. FIN-SI.

    SI VN_PONE(v, 99, 1) != 0 TUNC REDDE 70. FIN-SI.
    SI VN_DELE(v, 99) != 0 TUNC REDDE 71. FIN-SI.

    DECLARA capacitas_ante SICUT NUMERUS VALENS VN_CAPACITAS(v).
    SI VN_PURGA(v) == 0 TUNC REDDE 80. FIN-SI.
    SI VN_NUMERUS(v) != 0 TUNC REDDE 81. FIN-SI.
    SI VN_CAPACITAS(v) != capacitas_ante TUNC REDDE 82. FIN-SI.

    SI VN_ADDE(v, 777) == 0 TUNC REDDE 90. FIN-SI.
    SI VN_CAPE(v, 0) != 777 TUNC REDDE 91. FIN-SI.

    SI VN_LIBERA(v) == 0 TUNC REDDE 100. FIN-SI.

    DECLARA parvus SICUT NUMERUS VALENS VN_CREA_CUM(1).
    SI parvus == 0 TUNC REDDE 110. FIN-SI.
    SI VN_ADDE(parvus, 5) == 0 TUNC REDDE 111. FIN-SI.
    SI VN_ADDE(parvus, 6) == 0 TUNC REDDE 112. FIN-SI.
    SI VN_CAPACITAS(parvus) < 2 TUNC REDDE 113. FIN-SI.
    SI VN_CAPE(parvus, 1) != 6 TUNC REDDE 114. FIN-SI.
    SI VN_LIBERA(parvus) == 0 TUNC REDDE 115. FIN-SI.

    PROCLAMA "VECTORES RECTE".
    REDDE 0.
FIN-FUNCTIO.
