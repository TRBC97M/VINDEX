IMPORTA "bibliotheca/series_numerorum.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA s SICUT NUMERUS VALENS SN_CREA().
    SI s == 0 TUNC REDDE 10. FIN-SI.
    SI SN_NUMERUS(s) != 0 TUNC REDDE 11. FIN-SI.
    SI SN_CAPACITAS(s) < 4 TUNC REDDE 12. FIN-SI.
    SI SN_BASIS(s) == 0 TUNC REDDE 13. FIN-SI.

    SI SN_ADDE(s, 10) == 0 TUNC REDDE 20. FIN-SI.
    SI SN_ADDE(s, 20) == 0 TUNC REDDE 21. FIN-SI.
    SI SN_ADDE(s, 30) == 0 TUNC REDDE 22. FIN-SI.
    SI SN_ADDE(s, 40) == 0 TUNC REDDE 23. FIN-SI.
    SI SN_ADDE(s, 50) == 0 TUNC REDDE 24. FIN-SI.
    SI SN_NUMERUS(s) != 5 TUNC REDDE 25. FIN-SI.
    SI SN_CAPACITAS(s) < 5 TUNC REDDE 26. FIN-SI.
    SI SN_CAPE(s, 0) != 10 TUNC REDDE 27. FIN-SI.
    SI SN_CAPE(s, 4) != 50 TUNC REDDE 28. FIN-SI.

    SI SN_PONE(s, 2, 99) == 0 TUNC REDDE 30. FIN-SI.
    SI SN_CAPE(s, 2) != 99 TUNC REDDE 31. FIN-SI.

    SI SN_INSERE(s, 0, 7) == 0 TUNC REDDE 40. FIN-SI.
    SI SN_INSERE(s, 3, 33) == 0 TUNC REDDE 41. FIN-SI.
    SI SN_INSERE(s, SN_NUMERUS(s), 77) == 0 TUNC REDDE 42. FIN-SI.
    SI SN_NUMERUS(s) != 8 TUNC REDDE 43. FIN-SI.
    SI SN_CAPE(s, 0) != 7 TUNC REDDE 44. FIN-SI.
    SI SN_CAPE(s, 3) != 33 TUNC REDDE 45. FIN-SI.
    SI SN_CAPE(s, 7) != 77 TUNC REDDE 46. FIN-SI.

    SI SN_DELE(s, 0) == 0 TUNC REDDE 50. FIN-SI.
    SI SN_DELE(s, 2) == 0 TUNC REDDE 51. FIN-SI.
    SI SN_NUMERUS(s) != 6 TUNC REDDE 52. FIN-SI.
    SI SN_CAPE(s, 0) != 10 TUNC REDDE 53. FIN-SI.
    SI SN_CAPE(s, 2) != 99 TUNC REDDE 54. FIN-SI.
    SI SN_CAPE(s, 5) != 77 TUNC REDDE 55. FIN-SI.

    SI SN_PONE(s, 99, 1) != 0 TUNC REDDE 60. FIN-SI.
    SI SN_DELE(s, 99) != 0 TUNC REDDE 61. FIN-SI.
    SI SN_INSERE(s, 99, 1) != 0 TUNC REDDE 62. FIN-SI.
    SI SN_CAPE(s, 99) != 0 TUNC REDDE 63. FIN-SI.

    SI SN_RESERVA(s, 20) == 0 TUNC REDDE 70. FIN-SI.
    SI SN_CAPACITAS(s) < 20 TUNC REDDE 71. FIN-SI.
    SI SN_CAPE(s, 0) != 10 TUNC REDDE 72. FIN-SI.
    SI CONTENTUM(SN_BASIS(s)) != 10 TUNC REDDE 73. FIN-SI.

    DECLARA capacitas_ante SICUT NUMERUS VALENS SN_CAPACITAS(s).
    SI SN_PURGA(s) == 0 TUNC REDDE 80. FIN-SI.
    SI SN_NUMERUS(s) != 0 TUNC REDDE 81. FIN-SI.
    SI SN_CAPACITAS(s) != capacitas_ante TUNC REDDE 82. FIN-SI.
    SI SN_ADDE(s, 55) == 0 TUNC REDDE 83. FIN-SI.
    SI SN_CAPE(s, 0) != 55 TUNC REDDE 84. FIN-SI.

    SI SN_LIBERA(s) == 0 TUNC REDDE 90. FIN-SI.

    PROCLAMA "SERIES RECTE".
    REDDE 0.
FIN-FUNCTIO.
