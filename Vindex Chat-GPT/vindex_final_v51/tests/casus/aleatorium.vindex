IMPORTA "bibliotheca/aleatorium.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA status SICUT NUMERUS VALENS RESERVA_OCTETA(8).
    SI status <= 0 TUNC REDDE 10. FIN-SI.

    DECLARA semen SICUT NUMERUS VALENS ALEA_SEMEN(status, 1).
    SI semen != 1 TUNC REDDE 11. FIN-SI.

    SI ALEA_PROXIMUM_U32(status) != 1015568748 TUNC REDDE 12. FIN-SI.
    SI ALEA_PROXIMUM_U32(status) != 1586005467 TUNC REDDE 13. FIN-SI.
    SI ALEA_PROXIMUM_U32(status) != 2165703038 TUNC REDDE 14. FIN-SI.
    SI ALEA_PROXIMUM_U32(status) != 3027450565 TUNC REDDE 15. FIN-SI.
    SI ALEA_PROXIMUM_U32(status) != 217083232 TUNC REDDE 16. FIN-SI.

    semen = ALEA_SEMEN(status, 7319).
    DECLARA a SICUT NUMERUS VALENS ALEA_INFRA(status, 100).
    DECLARA b SICUT NUMERUS VALENS ALEA_INTER(status, 5, 15).
    SI a < 0 || a >= 100 TUNC REDDE 20. FIN-SI.
    SI b < 5 || b > 15 TUNC REDDE 21. FIN-SI.

    DECLARA ante SICUT NUMERUS VALENS CONTENTUM(status).
    SI ALEA_INFRA(status, 0) != 0 TUNC REDDE 22. FIN-SI.
    SI CONTENTUM(status) != ante TUNC REDDE 23. FIN-SI.

    DECLARA h1 SICUT NUMERUS VALENS ALEA_MISCE_U32(7319, 12, 34).
    DECLARA h2 SICUT NUMERUS VALENS ALEA_MISCE_U32(7319, 12, 34).
    DECLARA h3 SICUT NUMERUS VALENS ALEA_MISCE_U32(7319, 12, 35).
    SI h1 != h2 TUNC REDDE 30. FIN-SI.
    SI h1 == h3 TUNC REDDE 31. FIN-SI.

    PROCLAMA "ALEATORIUM RECTE".
    PROCLAMA h1.
    REDDE 0.
FIN-FUNCTIO.
