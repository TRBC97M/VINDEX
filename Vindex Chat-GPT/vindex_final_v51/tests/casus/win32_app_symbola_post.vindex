IMPORTA "bibliotheca/textus.vindex".
IMPORTA "bibliotheca/win32_ffi.vindex".
IMPORTA "bibliotheca/win32_app.vindex".

// P11-E — probat symbola quae post WINAPP_SUPERFICIES_CREA definiuntur.
FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA superficies SICUT NUMERUS VALENS RESERVA_OCTETA(56).
    SI superficies <= 0 TUNC REDDE 1. FIN-SI.
    SI superficies == 0 TUNC
        DECLARA a SICUT NUMERUS VALENS WINAPP_SUPERFICIES_DESTINATIO(superficies, 1, 4, 4).
        DECLARA b SICUT NUMERUS VALENS WINAPP_PRAESENTA(1, superficies).
        PROCLAMA a + b.
    FIN-SI.
    PROCLAMA "WIN32 APP SYMBOLA POST RECTE".
    REDDE 0.
FIN-FUNCTIO.
