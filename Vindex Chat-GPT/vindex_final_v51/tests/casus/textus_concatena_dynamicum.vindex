IMPORTA "bibliotheca/textus.vindex".
IMPORTA "bibliotheca/conversio.vindex".

// Regressio ex ATMOS POC V: affectatio auto-referens TEXTUS
// `t = t + suffixum` novum descriptorem integrum servare debet.
FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA numerus SICUT TEXTUS VALENS TEXTUS_EX_NUMERO_DECIMALI(120).
    DECLARA primus SICUT TEXTUS VALENS "DEPTH " + numerus.
    DECLARA distinctus SICUT TEXTUS VALENS primus + " m".

    PROCLAMA "D0".
    PROCLAMA TEXTUS_SEDES(primus).
    PROCLAMA TEXTUS_SEDES(distinctus).
    PROCLAMA LONGITUDO(distinctus).
    PROCLAMA OCTETUS_AB(TEXTUS_BASIS_OCTETORUM(distinctus)).

    DECLARA t SICUT TEXTUS VALENS "DEPTH " + numerus.
    PROCLAMA "S0".
    PROCLAMA TEXTUS_SEDES(t).
    t = t + " m".
    PROCLAMA "S1".
    // Prima probatio non dereferens: si haec sedes falsa est, affectatio ipsa culpatur.
    PROCLAMA TEXTUS_SEDES(t).
    PROCLAMA "S2".
    PROCLAMA LONGITUDO(t).
    PROCLAMA OCTETUS_AB(TEXTUS_BASIS_OCTETORUM(t)).
    REDDE 0.
FIN-FUNCTIO.
