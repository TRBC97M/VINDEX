// P9 / P11-E — regressio identificatorum ultra XXXII litteras.
// Ex opere Claude #168 adoptatur: tampon historicus 32 octetorum
// nullo modo debet nomen functionis truncare aut memoriam corrumpere.

FUNCTIO IDENTIFICATOR_LONGISSIMUS_QUI_TAMPONEM_HISTORICUM_XXXII_OCTETORUM_EXCEDIT REDDENS NUMERUS.
    REDDE 7.
FIN-FUNCTIO.

FUNCTIO PRAEFIXUM_COMMUNE_TRIGINTA_DUARUM_LITTALPHA REDDENS NUMERUS.
    REDDE 11.
FIN-FUNCTIO.

FUNCTIO PRAEFIXUM_COMMUNE_TRIGINTA_DUARUM_LITTBETA REDDENS NUMERUS.
    REDDE 22.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA a SICUT NUMERUS VALENS IDENTIFICATOR_LONGISSIMUS_QUI_TAMPONEM_HISTORICUM_XXXII_OCTETORUM_EXCEDIT().
    DECLARA b SICUT NUMERUS VALENS PRAEFIXUM_COMMUNE_TRIGINTA_DUARUM_LITTALPHA().
    DECLARA c SICUT NUMERUS VALENS PRAEFIXUM_COMMUNE_TRIGINTA_DUARUM_LITTBETA().
    PROCLAMA a.
    PROCLAMA b.
    PROCLAMA c.
    SI a != 7 TUNC REDDE 91. FIN-SI.
    SI b != 11 TUNC REDDE 92. FIN-SI.
    SI c != 22 TUNC REDDE 93. FIN-SI.
    PROCLAMA "IDENTIFICATORES LONGI RECTE".
    REDDE 0.
FIN-FUNCTIO.
