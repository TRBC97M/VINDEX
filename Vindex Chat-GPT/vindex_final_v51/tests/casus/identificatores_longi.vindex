// P9 debitum #134: identificatores ultra XXXII litteras.
// Ante correctionem: tampon CAPACITAS 32 sine limite -> corruptio
// memoriae et compilator cadens; praeterea nomina post XXXII
// litteram differentia idem signum accipiebant.

FUNCTIO IDENTIFICATOR_LONGISSIMUS_QUI_TAMPONEM_HISTORICUM_XXXII_OCTETORUM_EXCEDIT REDDENS NUMERUS.
    REDDE 7.
FIN-FUNCTIO.

FUNCTIO PRAEFIXUM_COMMUNE_TRIGINTA_DUARUM_LITTALPHA REDDENS NUMERUS.
    REDDE 11.
FIN-FUNCTIO.

FUNCTIO PRAEFIXUM_COMMUNE_TRIGINTA_DUARUM_LITTBETA REDDENS NUMERUS.
    REDDE 22.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    PROCLAMA IDENTIFICATOR_LONGISSIMUS_QUI_TAMPONEM_HISTORICUM_XXXII_OCTETORUM_EXCEDIT().
    PROCLAMA PRAEFIXUM_COMMUNE_TRIGINTA_DUARUM_LITTALPHA().
    PROCLAMA PRAEFIXUM_COMMUNE_TRIGINTA_DUARUM_LITTBETA().
    REDDE 0.
FIN-FUNCTIO.
