IMPORTA "bibliotheca/textus.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA textus SICUT TEXTUS VALENS "VINDEX Sylvia OS".
    DECLARA vacuum SICUT TEXTUS VALENS "".

    SI LONGITUDO(textus) != 15 TUNC REDDE 10. FIN-SI.
    SI TEXTUS_VACUUS(textus) != 0 TUNC REDDE 11. FIN-SI.
    SI TEXTUS_VACUUS(vacuum) != 1 TUNC REDDE 12. FIN-SI.

    SI TEXTUS_INDEX(textus, "VINDEX") != 0 TUNC REDDE 20. FIN-SI.
    SI TEXTUS_INDEX(textus, "INDEX") != 1 TUNC REDDE 21. FIN-SI.
    SI TEXTUS_INDEX(textus, "Sylvia") != 6 TUNC REDDE 22. FIN-SI.
    SI TEXTUS_INDEX(textus, "OS") != 13 TUNC REDDE 23. FIN-SI.
    SI TEXTUS_INDEX(textus, "absens") != -1 TUNC REDDE 24. FIN-SI.
    SI TEXTUS_INDEX(textus, vacuum) != 0 TUNC REDDE 25. FIN-SI.

    SI TEXTUS_CONTINET(textus, "Sylvia") != 1 TUNC REDDE 30. FIN-SI.
    SI TEXTUS_CONTINET(textus, "Linux") != 0 TUNC REDDE 31. FIN-SI.

    SI TEXTUS_PRAEFIXUM(textus, "VINDEX") != 1 TUNC REDDE 40. FIN-SI.
    SI TEXTUS_PRAEFIXUM(textus, "INDEX") != 0 TUNC REDDE 41. FIN-SI.
    SI TEXTUS_PRAEFIXUM(textus, vacuum) != 1 TUNC REDDE 42. FIN-SI.

    SI TEXTUS_SUFFIXUM(textus, "OS") != 1 TUNC REDDE 50. FIN-SI.
    SI TEXTUS_SUFFIXUM(textus, "Sylvia") != 0 TUNC REDDE 51. FIN-SI.
    SI TEXTUS_SUFFIXUM(textus, vacuum) != 1 TUNC REDDE 52. FIN-SI.
    SI TEXTUS_SUFFIXUM("OS", textus) != 0 TUNC REDDE 53. FIN-SI.

    PROCLAMA "TEXTUS RECTE".
    REDDE 0.
FIN-FUNCTIO.
