IMPORTA "bibliotheca/textus.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA fons SICUT TEXTUS VALENS "Aé€😀Z".
    SI LONGITUDO(fons) != 11 TUNC REDDE 10. FIN-SI.
    SI LONGITUDO_SCALARUM(fons) != 5 TUNC REDDE 11. FIN-SI.

    DECLARA medium SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(fons, 1, 3).
    SI TEXTUS_SEDES(medium) == 0 TUNC REDDE 20. FIN-SI.
    SI medium != "é€😀" TUNC REDDE 21. FIN-SI.
    SI LONGITUDO(medium) != 9 TUNC REDDE 22. FIN-SI.
    SI LONGITUDO_SCALARUM(medium) != 3 TUNC REDDE 23. FIN-SI.
    SI UTF8_SCALARE_CAPE(medium, 0) != 233 TUNC REDDE 24. FIN-SI.
    SI UTF8_SCALARE_CAPE(medium, 1) != 8364 TUNC REDDE 25. FIN-SI.
    SI UTF8_SCALARE_CAPE(medium, 2) != 128512 TUNC REDDE 26. FIN-SI.

    DECLARA primus SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(fons, 0, 1).
    SI primus != "A" TUNC REDDE 30. FIN-SI.
    DECLARA ultimus SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(fons, 4, 1).
    SI ultimus != "Z" TUNC REDDE 31. FIN-SI.

    DECLARA vacuum_medium SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(fons, 2, 0).
    SI TEXTUS_SEDES(vacuum_medium) == 0 TUNC REDDE 40. FIN-SI.
    SI LONGITUDO(vacuum_medium) != 0 TUNC REDDE 41. FIN-SI.
    SI UTF8_VALIDUS(vacuum_medium) != 1 TUNC REDDE 42. FIN-SI.

    DECLARA vacuum_finis SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(fons, 5, 0).
    SI TEXTUS_SEDES(vacuum_finis) == 0 TUNC REDDE 43. FIN-SI.
    SI LONGITUDO(vacuum_finis) != 0 TUNC REDDE 44. FIN-SI.

    DECLARA totus SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(fons, 0, 5).
    SI totus != fons TUNC REDDE 50. FIN-SI.
    SI TEXTUS_SEDES(totus) == TEXTUS_SEDES(fons) TUNC REDDE 51. FIN-SI.

    DECLARA invalidus_initium SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(fons, 6, 0).
    SI TEXTUS_SEDES(invalidus_initium) != 0 TUNC REDDE 60. FIN-SI.
    DECLARA invalidus_numerus SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(fons, 4, 2).
    SI TEXTUS_SEDES(invalidus_numerus) != 0 TUNC REDDE 61. FIN-SI.
    DECLARA invalidus_neg SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(fons, -1, 1).
    SI TEXTUS_SEDES(invalidus_neg) != 0 TUNC REDDE 62. FIN-SI.

    DECLARA corruptus SICUT TEXTUS VALENS "x" + "x".
    DECLARA basis SICUT NUMERUS VALENS TEXTUS_BASIS_OCTETORUM(corruptus).
    SCRIBE_OCTETUM_AB(basis, 192).
    SCRIBE_OCTETUM_AB(basis + 1, 128).
    DECLARA ex_corrupto SICUT TEXTUS VALENS SUBTEXTUS_SCALARUM(corruptus, 0, 1).
    SI TEXTUS_SEDES(ex_corrupto) != 0 TUNC REDDE 70. FIN-SI.

    PROCLAMA "SUBTEXTUS RECTE".
    REDDE 0.
FIN-FUNCTIO.
