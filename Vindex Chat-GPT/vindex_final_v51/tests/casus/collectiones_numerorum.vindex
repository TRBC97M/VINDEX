IMPORTA "bibliotheca/collectiones_numerorum.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA c SICUT NUMERUS VALENS CN_CREA().
    SI c == 0 TUNC REDDE 10. FIN-SI.

    SI CN_ADDE(c, 10) == 0 TUNC REDDE 11. FIN-SI.
    SI CN_ADDE(c, 20) == 0 TUNC REDDE 12. FIN-SI.
    SI CN_ADDE(c, 30) == 0 TUNC REDDE 13. FIN-SI.
    SI CN_ADDE(c, 40) == 0 TUNC REDDE 14. FIN-SI.

    SI CN_NUMERUS(c) != 4 TUNC REDDE 20. FIN-SI.
    SI CN_CAPE(c, 0) != 10 TUNC REDDE 21. FIN-SI.
    SI CN_CAPE(c, 3) != 40 TUNC REDDE 22. FIN-SI.

    SI CN_PONE(c, 1, 99) == 0 TUNC REDDE 30. FIN-SI.
    SI CN_CAPE(c, 1) != 99 TUNC REDDE 31. FIN-SI.

    SI CN_DELE(c, 0) == 0 TUNC REDDE 40. FIN-SI.
    SI CN_NUMERUS(c) != 3 TUNC REDDE 41. FIN-SI.
    SI CN_CAPE(c, 0) != 99 TUNC REDDE 42. FIN-SI.

    SI CN_DELE(c, 1) == 0 TUNC REDDE 50. FIN-SI.
    SI CN_NUMERUS(c) != 2 TUNC REDDE 51. FIN-SI.
    SI CN_CAPE(c, 1) != 40 TUNC REDDE 52. FIN-SI.

    SI CN_DELE(c, 1) == 0 TUNC REDDE 60. FIN-SI.
    SI CN_NUMERUS(c) != 1 TUNC REDDE 61. FIN-SI.
    SI CN_CAPE(c, 0) != 99 TUNC REDDE 62. FIN-SI.

    SI CN_ADDE(c, 0) == 0 TUNC REDDE 70. FIN-SI.
    SI CN_NUMERUS(c) != 2 TUNC REDDE 71. FIN-SI.
    SI CN_CAPE(c, 1) != 0 TUNC REDDE 72. FIN-SI.

    SI CN_PONE(c, 9, 1) != 0 TUNC REDDE 80. FIN-SI.
    SI CN_DELE(c, 9) != 0 TUNC REDDE 81. FIN-SI.

    SI CN_PURGA(c) == 0 TUNC REDDE 90. FIN-SI.
    SI CN_NUMERUS(c) != 0 TUNC REDDE 91. FIN-SI.

    SI CN_ADDE(c, 55) == 0 TUNC REDDE 100. FIN-SI.
    SI CN_CAPE(c, 0) != 55 TUNC REDDE 101. FIN-SI.

    SI CN_LIBERA(c) == 0 TUNC REDDE 110. FIN-SI.

    PROCLAMA "COLLECTIONES RECTE".
    REDDE 0.
FIN-FUNCTIO.
