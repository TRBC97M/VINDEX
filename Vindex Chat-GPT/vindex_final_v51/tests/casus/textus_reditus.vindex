IMPORTA "bibliotheca/textus.vindex".

FUNCTIO SALUTATIO REDDENS TEXTUS.
    REDDE "Salve".
FIN-FUNCTIO.

FUNCTIO IDENTITAS_TEXTUS REDDENS TEXTUS.
    ACCIPIT textus SICUT TEXTUS.
    REDDE textus.
FIN-FUNCTIO.

FUNCTIO CONIUNGE_TEXTUS REDDENS TEXTUS.
    ACCIPIT a SICUT TEXTUS.
    ACCIPIT b SICUT TEXTUS.
    REDDE a + b.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA a SICUT TEXTUS VALENS SALUTATIO().
    SI a != "Salve" TUNC REDDE 10. FIN-SI.

    DECLARA b SICUT TEXTUS VALENS IDENTITAS_TEXTUS("Sylvia").
    SI b != "Sylvia" TUNC REDDE 20. FIN-SI.

    DECLARA c SICUT TEXTUS VALENS CONIUNGE_TEXTUS("VIN", "DEX").
    SI c != "VINDEX" TUNC REDDE 30. FIN-SI.
    PROCLAMA LONGITUDO(c).
    PROCLAMA UTF8_VALIDUS(c).
    PROCLAMA LONGITUDO_SCALARUM(c).
    PROCLAMA UTF8_SCALARE_CAPE(c, 0).

    DECLARA d SICUT TEXTUS VALENS CONIUNGE_TEXTUS("é", "😀").
    PROCLAMA LONGITUDO(d).
    PROCLAMA UTF8_VALIDUS(d).
    PROCLAMA LONGITUDO_SCALARUM(d).
    PROCLAMA UTF8_SCALARE_CAPE(d, 0).
    PROCLAMA UTF8_SCALARE_CAPE(d, 1).

    PROCLAMA "TEXTUS REDITUS RECTE".
    REDDE 0.
FIN-FUNCTIO.
