IMPORTA "bibliotheca/textus.vindex".
IMPORTA "bibliotheca/conversio.vindex".

FUNCTIO TEXTUS_AEQUUS REDDENS NUMERUS.
    ACCIPIT a SICUT TEXTUS.
    ACCIPIT b SICUT TEXTUS.
    DECLARA na SICUT NUMERUS VALENS LONGITUDO(a).
    DECLARA nb SICUT NUMERUS VALENS LONGITUDO(b).
    SI na != nb TUNC REDDE 0. FIN-SI.
    DECLARA ba SICUT NUMERUS VALENS TEXTUS_BASIS_OCTETORUM(a).
    DECLARA bb SICUT NUMERUS VALENS TEXTUS_BASIS_OCTETORUM(b).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < na PERFICE
        SI OCTETUS_AB(ba + i) != OCTETUS_AB(bb + i) TUNC REDDE 0. FIN-SI.
        i = i + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA z SICUT TEXTUS VALENS TEXTUS_EX_NUMERO_DECIMALI(0).
    SI TEXTUS_AEQUUS(z, "0") != 1 TUNC REDDE 10. FIN-SI.

    DECLARA p SICUT TEXTUS VALENS TEXTUS_EX_NUMERO_DECIMALI(120).
    SI TEXTUS_AEQUUS(p, "120") != 1 TUNC REDDE 11. FIN-SI.

    DECLARA n SICUT TEXTUS VALENS TEXTUS_EX_NUMERO_DECIMALI(0 - 42).
    SI TEXTUS_AEQUUS(n, "-42") != 1 TUNC REDDE 12. FIN-SI.

    DECLARA maxi SICUT TEXTUS VALENS TEXTUS_EX_NUMERO_DECIMALI(9223372036854775807).
    SI TEXTUS_AEQUUS(maxi, "9223372036854775807") != 1 TUNC REDDE 13. FIN-SI.

    DECLARA minimus SICUT NUMERUS VALENS (0 - 9223372036854775807) - 1.
    DECLARA mini SICUT TEXTUS VALENS TEXTUS_EX_NUMERO_DECIMALI(minimus).
    SI TEXTUS_AEQUUS(mini, "-9223372036854775808") != 1 TUNC REDDE 14. FIN-SI.

    SI UTF8_VALIDUS(z) != 1 || UTF8_VALIDUS(n) != 1 || UTF8_VALIDUS(maxi) != 1 || UTF8_VALIDUS(mini) != 1 TUNC REDDE 15. FIN-SI.

    PROCLAMA "CONVERSIO TEXTUS RECTE".
    REDDE 0.
FIN-FUNCTIO.
