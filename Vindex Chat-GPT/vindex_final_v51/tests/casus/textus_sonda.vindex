IMPORTA "bibliotheca/textus.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA textus SICUT TEXTUS VALENS "ABC".
    DECLARA fragmentum SICUT TEXTUS VALENS "B".
    DECLARA basis SICUT NUMERUS VALENS CONTENTUM(SEDES(textus)).
    PROCLAMA LONGITUDO(textus).
    PROCLAMA OCTETUS_AB(basis + 16).
    PROCLAMA OCTETUS_AB(basis + 17).
    PROCLAMA OCTETUS_AB(basis + 18).
    PROCLAMA TEXTUS_INDEX(textus, fragmentum).
    REDDE 0.
FIN-FUNCTIO.
