// Sylvia OS — P16-VII: primum emblema rasterum verum.
// Imago XXXII×XXXII antea rasterizata est; hic palette et RLE tantum servantur.
// Renderer figuram eius ignorat: pixela RGBA in SIMG v1 expanduntur et per alpha blit pinguntur.

FUNCTIO EVII_TEXTUS_SEDES REDDENS NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    REDDE textus.
FIN-FUNCTIO.

FUNCTIO EVII_HEX_NIBBLE REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    SI c>=48 && c<=57 TUNC REDDE c-48. FIN-SI.
    SI c>=65 && c<=70 TUNC REDDE c-55. FIN-SI.
    SI c>=97 && c<=102 TUNC REDDE c-87. FIN-SI.
    REDDE -1.
FIN-FUNCTIO.

FUNCTIO EVII_HEX_OCTETUM REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT pos SICUT NUMERUS.
    DECLARA a SICUT NUMERUS VALENS EVII_HEX_NIBBLE(OCTETUS_AB(basis+pos)).
    DECLARA b SICUT NUMERUS VALENS EVII_HEX_NIBBLE(OCTETUS_AB(basis+pos+1)).
    SI a<0 || b<0 TUNC REDDE -1. FIN-SI.
    REDDE a*16+b.
FIN-FUNCTIO.

FUNCTIO EVII_U32_LE_PONE REDDENS NUMERUS.
    ACCIPIT locus SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SCRIBE_OCTETUM_AB(locus,valor&255).
    SCRIBE_OCTETUM_AB(locus+1,(valor>>8)&255).
    SCRIBE_OCTETUM_AB(locus+2,(valor>>16)&255).
    SCRIBE_OCTETUM_AB(locus+3,(valor>>24)&255).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO EVII_CREA REDDENS TEXTUS.
    DECLARA palette_hex SICUT TEXTUS VALENS "000000001F3A48FF223C4AFF203B49FFCF9953FFC5F6FF00C3FFFF004B5149FFEAFFFFFF1F3948FFC69349FF142F3DFF183140FF203846FF1A3343FFEFCB8755E4BA7A55DBB47455D9B27255E2BC7855F0CB8555F6D68D55DDAE68AAD5A15BFFD79F59FFD09953FFD39B50FFD89C51FFD29853FFD69F58FFD49E59FF".
    DECLARA rle_hex SICUT TEXTUS VALENS "".

    DECLARA palette SICUT ORDO DE NUMERUS CAPACITAS 31.
    DECLARA pb SICUT NUMERUS VALENS EVII_TEXTUS_SEDES(palette_hex)+16.
    DECLARA p SICUT NUMERUS VALENS 0.
    DUM p<31 PERFICE
        DECLARA q SICUT NUMERUS VALENS p*8.
        DECLARA r SICUT NUMERUS VALENS EVII_HEX_OCTETUM(pb,q).
        DECLARA g SICUT NUMERUS VALENS EVII_HEX_OCTETUM(pb,q+2).
        DECLARA b SICUT NUMERUS VALENS EVII_HEX_OCTETUM(pb,q+4).
        DECLARA a SICUT NUMERUS VALENS EVII_HEX_OCTETUM(pb,q+6).
        SI r<0 || g<0 || b<0 || a<0 TUNC REDDE 0. FIN-SI.
        palette[p]=r+(g<<8)+(b<<16)+(a<<24).
        p=p+1.
    FIN-DUM.

    DECLARA mensura SICUT NUMERUS VALENS 24+32*32*4.
    DECLARA d SICUT NUMERUS VALENS RESERVA_OCTETA(17+mensura).
    SI d<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(d)=mensura. CONTENTUM(d+8)=mensura.
    DECLARA out SICUT NUMERUS VALENS d+16.
    SCRIBE_OCTETUM_AB(out,83). SCRIBE_OCTETUM_AB(out+1,73). SCRIBE_OCTETUM_AB(out+2,77). SCRIBE_OCTETUM_AB(out+3,71).
    SCRIBE_OCTETUM_AB(out+4,1). SCRIBE_OCTETUM_AB(out+5,1). SCRIBE_OCTETUM_AB(out+6,0). SCRIBE_OCTETUM_AB(out+7,0).
    DECLARA z SICUT NUMERUS VALENS EVII_U32_LE_PONE(out+8,32).
    z=EVII_U32_LE_PONE(out+12,32). z=EVII_U32_LE_PONE(out+16,128). z=EVII_U32_LE_PONE(out+20,0).

    DECLARA rb SICUT NUMERUS VALENS EVII_TEXTUS_SEDES(rle_hex)+16.
    DECLARA rn SICUT NUMERUS VALENS LONGITUDO(rle_hex).
    DECLARA rp SICUT NUMERUS VALENS 0.
    DECLARA pixel SICUT NUMERUS VALENS 0.
    DUM rp+3<rn PERFICE
        DECLARA cursus SICUT NUMERUS VALENS EVII_HEX_OCTETUM(rb,rp).
        DECLARA index SICUT NUMERUS VALENS EVII_HEX_OCTETUM(rb,rp+2).
        SI cursus<=0 || index<0 || index>=31 TUNC REDDE 0. FIN-SI.
        DECLARA rgba SICUT NUMERUS VALENS palette[index].
        DECLARA i SICUT NUMERUS VALENS 0.
        DUM i<cursus PERFICE
            SI pixel>=1024 TUNC REDDE 0. FIN-SI.
            DECLARA locus SICUT NUMERUS VALENS out+24+pixel*4.
            SCRIBE_OCTETUM_AB(locus,rgba&255).
            SCRIBE_OCTETUM_AB(locus+1,(rgba>>8)&255).
            SCRIBE_OCTETUM_AB(locus+2,(rgba>>16)&255).
            SCRIBE_OCTETUM_AB(locus+3,(rgba>>24)&255).
            pixel=pixel+1. i=i+1.
        FIN-DUM.
        rp=rp+4.
    FIN-DUM.
    SI pixel!=1024 TUNC REDDE 0. FIN-SI.
    SCRIBE_OCTETUM_AB(out+mensura,0).
    REDDE d.
FIN-FUNCTIO.
