// Sylvia OS — Graphica VIII: atlas typographicus UI compactus.
// Glyphi 5x7 in NUMERUS XXXV-bit servantur; atlas RGBA8888 256x120
// a VINDEX ipso rasterizatur cum interpolatione bilineari alpha.
// ASCII XXXII..CXXVI; litterae minusculae formam maiusculam huius primi fontis recipiunt.

FUNCTIO FUIVIII_U32_PONE REDDENS NUMERUS.
    ACCIPIT locus SICUT NUMERUS. ACCIPIT valor SICUT NUMERUS.
    SCRIBE_OCTETUM_AB(locus,valor&255). SCRIBE_OCTETUM_AB(locus+1,(valor>>8)&255).
    SCRIBE_OCTETUM_AB(locus+2,(valor>>16)&255). SCRIBE_OCTETUM_AB(locus+3,(valor>>24)&255).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FUIVIII_GLYPH REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    // ASCII XXXII spatium est: cella omnino vacua manere debet.
    SI c==32 TUNC REDDE 0. FIN-SI.
    SI c>=97 && c<=122 TUNC c=c-32. FIN-SI.
    SI c==65 TUNC REDDE 18842895918. FIN-SI.
    SI c==66 TUNC REDDE 16694887983. FIN-SI.
    SI c==67 TUNC REDDE 32246891582. FIN-SI.
    SI c==68 TUNC REDDE 16694953519. FIN-SI.
    SI c==69 TUNC REDDE 33321092159. FIN-SI.
    SI c==70 TUNC REDDE 1108837439. FIN-SI.
    SI c==71 TUNC REDDE 32801457214. FIN-SI.
    SI c==72 TUNC REDDE 18842895921. FIN-SI.
    SI c==73 TUNC REDDE 33424543903. FIN-SI.
    SI c==74 TUNC REDDE 6754148636. FIN-SI.
    SI c==75 TUNC REDDE 18560947505. FIN-SI.
    SI c==76 TUNC REDDE 33320633377. FIN-SI.
    SI c==77 TUNC REDDE 18842572657. FIN-SI.
    SI c==78 TUNC REDDE 18842703473. FIN-SI.
    SI c==79 TUNC REDDE 15621211694. FIN-SI.
    SI c==80 TUNC REDDE 1108854319. FIN-SI.
    SI c==81 TUNC REDDE 23946905134. FIN-SI.
    SI c==82 TUNC REDDE 18561353263. FIN-SI.
    SI c==83 TUNC REDDE 16660235326. FIN-SI.
    SI c==84 TUNC REDDE 4433514655. FIN-SI.
    SI c==85 TUNC REDDE 15621211697. FIN-SI.
    SI c==86 TUNC REDDE 4648912433. FIN-SI.
    SI c==87 TUNC REDDE 19182306865. FIN-SI.
    SI c==88 TUNC REDDE 18834663985. FIN-SI.
    SI c==89 TUNC REDDE 4433521201. FIN-SI.
    SI c==90 TUNC REDDE 33321787935. FIN-SI.
    SI c==48 TUNC REDDE 15623448110. FIN-SI.
    SI c==49 TUNC REDDE 15170932932. FIN-SI.
    SI c==50 TUNC REDDE 33357578798. FIN-SI.
    SI c==51 TUNC REDDE 16660251151. FIN-SI.
    SI c==52 TUNC REDDE 8891181448. FIN-SI.
    SI c==53 TUNC REDDE 16660268095. FIN-SI.
    SI c==54 TUNC REDDE 15621129262. FIN-SI.
    SI c==55 TUNC REDDE 2216829471. FIN-SI.
    SI c==56 TUNC REDDE 15621113390. FIN-SI.
    SI c==57 TUNC REDDE 15587034670. FIN-SI.
    SI c==45 TUNC REDDE 1015808. FIN-SI.
    SI c==47 TUNC REDDE 1143087376. FIN-SI.
    SI c==62 TUNC REDDE 1145311297. FIN-SI.
    SI c==60 TUNC REDDE 17452568848. FIN-SI.
    SI c==58 TUNC REDDE 138416256. FIN-SI.
    SI c==46 TUNC REDDE 13287555072. FIN-SI.
    SI c==44 TUNC REDDE 2294284288. FIN-SI.
    SI c==33 TUNC REDDE 4299296900. FIN-SI.
    SI c==63 TUNC REDDE 4299440686. FIN-SI.
    SI c==95 TUNC REDDE 33285996544. FIN-SI.
    SI c==61 TUNC REDDE 1016800. FIN-SI.
    SI c==43 TUNC REDDE 139432064. FIN-SI.
    SI c==40 TUNC REDDE 8726317192. FIN-SI.
    SI c==41 TUNC REDDE 2290360450. FIN-SI.
    SI c==91 TUNC REDDE 15101659214. FIN-SI.
    SI c==93 TUNC REDDE 15309480206. FIN-SI.
    REDDE 4299440686.
FIN-FUNCTIO.

FUNCTIO FUIVIII_ALPHA REDDENS NUMERUS.
    ACCIPIT glyph SICUT NUMERUS. ACCIPIT px SICUT NUMERUS. ACCIPIT py SICUT NUMERUS.
    SI px<2 || px>13 || py<2 || py>17 TUNC REDDE 0. FIN-SI.
    DECLARA ux SICUT NUMERUS VALENS (px-2)*1024/11.
    DECLARA uy SICUT NUMERUS VALENS (py-2)*1536/15.
    DECLARA x0 SICUT NUMERUS VALENS ux/256. DECLARA fx SICUT NUMERUS VALENS ux%256.
    DECLARA y0 SICUT NUMERUS VALENS uy/256. DECLARA fy SICUT NUMERUS VALENS uy%256.
    DECLARA x1 SICUT NUMERUS VALENS x0+1. SI x1>4 TUNC x1=4. FIN-SI.
    DECLARA y1 SICUT NUMERUS VALENS y0+1. SI y1>6 TUNC y1=6. FIN-SI.
    DECLARA v00 SICUT NUMERUS VALENS ((glyph>>(y0*5+x0))&1)*255.
    DECLARA v10 SICUT NUMERUS VALENS ((glyph>>(y0*5+x1))&1)*255.
    DECLARA v01 SICUT NUMERUS VALENS ((glyph>>(y1*5+x0))&1)*255.
    DECLARA v11 SICUT NUMERUS VALENS ((glyph>>(y1*5+x1))&1)*255.
    DECLARA supra SICUT NUMERUS VALENS v00*(256-fx)+v10*fx.
    DECLARA infra SICUT NUMERUS VALENS v01*(256-fx)+v11*fx.
    REDDE (supra*(256-fy)+infra*fy)/65536.
FIN-FUNCTIO.

FUNCTIO FUIVIII_CREA REDDENS TEXTUS.
    DECLARA w SICUT NUMERUS VALENS 256. DECLARA h SICUT NUMERUS VALENS 120.
    DECLARA cell_w SICUT NUMERUS VALENS 16. DECLARA cell_h SICUT NUMERUS VALENS 20.
    DECLARA stride SICUT NUMERUS VALENS w*4. DECLARA mensura SICUT NUMERUS VALENS 24+stride*h.
    DECLARA d SICUT NUMERUS VALENS RESERVA_OCTETA(17+mensura).
    SI d<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(d)=mensura. CONTENTUM(d+8)=mensura.
    DECLARA out SICUT NUMERUS VALENS d+16.
    SCRIBE_OCTETUM_AB(out,83). SCRIBE_OCTETUM_AB(out+1,73). SCRIBE_OCTETUM_AB(out+2,77). SCRIBE_OCTETUM_AB(out+3,71).
    SCRIBE_OCTETUM_AB(out+4,1). SCRIBE_OCTETUM_AB(out+5,1). SCRIBE_OCTETUM_AB(out+6,0). SCRIBE_OCTETUM_AB(out+7,0).
    DECLARA z SICUT NUMERUS VALENS FUIVIII_U32_PONE(out+8,w).
    z=FUIVIII_U32_PONE(out+12,h). z=FUIVIII_U32_PONE(out+16,stride). z=FUIVIII_U32_PONE(out+20,0).

    DECLARA code SICUT NUMERUS VALENS 32.
    DUM code<=126 PERFICE
        DECLARA index SICUT NUMERUS VALENS code-32.
        DECLARA col SICUT NUMERUS VALENS index%16. DECLARA row SICUT NUMERUS VALENS index/16.
        DECLARA glyph SICUT NUMERUS VALENS FUIVIII_GLYPH(code).
        DECLARA py SICUT NUMERUS VALENS 0.
        DUM py<cell_h PERFICE
            DECLARA px SICUT NUMERUS VALENS 0.
            DUM px<cell_w PERFICE
                DECLARA alpha SICUT NUMERUS VALENS FUIVIII_ALPHA(glyph,px,py).
                DECLARA x SICUT NUMERUS VALENS col*cell_w+px.
                DECLARA y SICUT NUMERUS VALENS row*cell_h+py.
                DECLARA locus SICUT NUMERUS VALENS out+24+y*stride+x*4.
                SCRIBE_OCTETUM_AB(locus,255). SCRIBE_OCTETUM_AB(locus+1,255). SCRIBE_OCTETUM_AB(locus+2,255). SCRIBE_OCTETUM_AB(locus+3,alpha).
                px=px+1.
            FIN-DUM.
            py=py+1.
        FIN-DUM.
        code=code+1.
    FIN-DUM.
    REDDE d.
FIN-FUNCTIO.

FUNCTIO FUIVIII_FONS_CREA REDDENS NUMERUS.
    DECLARA atlas SICUT TEXTUS VALENS FUIVIII_CREA().
    SI IR_VALIDUS(atlas)==0 TUNC REDDE 0. FIN-SI.
    REDDE TVIII_FONS_CREA(atlas,16,16,20,32,95).
FIN-FUNCTIO.
