// Atlas: ASCII XXXII..CXXVI, cella XVI×XX, XVI columnae, imago CCLVI×CXX RGBA8888.

FUNCTIO FUIVIII_HEX_NIBBLE REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    SI c>=48 && c<=57 TUNC REDDE c-48. FIN-SI.
    SI c>=65 && c<=70 TUNC REDDE c-55. FIN-SI.
    SI c>=97 && c<=102 TUNC REDDE c-87. FIN-SI.
    REDDE -1.
FIN-FUNCTIO.

FUNCTIO FUIVIII_HEX_OCTETUM REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS. ACCIPIT pos SICUT NUMERUS.
    DECLARA a SICUT NUMERUS VALENS FUIVIII_HEX_NIBBLE(OCTETUS_AB(basis+pos)).
    DECLARA b SICUT NUMERUS VALENS FUIVIII_HEX_NIBBLE(OCTETUS_AB(basis+pos+1)).
    SI a<0 || b<0 TUNC REDDE -1. FIN-SI.
    REDDE a*16+b.
FIN-FUNCTIO.

FUNCTIO FUIVIII_U32_PONE REDDENS NUMERUS.
    ACCIPIT locus SICUT NUMERUS. ACCIPIT valor SICUT NUMERUS.
    SCRIBE_OCTETUM_AB(locus,valor&255). SCRIBE_OCTETUM_AB(locus+1,(valor>>8)&255).
    SCRIBE_OCTETUM_AB(locus+2,(valor>>16)&255). SCRIBE_OCTETUM_AB(locus+3,(valor>>24)&255).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FUIVIII_CREA REDDENS TEXTUS.
    DECLARA a SICUT TEXTUS VALENS "".
    DECLARA b SICUT TEXTUS VALENS "".
    DECLARA rle SICUT TEXTUS VALENS a+b.
    DECLARA w SICUT NUMERUS VALENS 256. DECLARA h SICUT NUMERUS VALENS 120.
    DECLARA stride SICUT NUMERUS VALENS w*4. DECLARA mensura SICUT NUMERUS VALENS 24+stride*h.
    DECLARA d SICUT NUMERUS VALENS RESERVA_OCTETA(17+mensura).
    SI d<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(d)=mensura. CONTENTUM(d+8)=mensura.
    DECLARA out SICUT NUMERUS VALENS d+16.
    SCRIBE_OCTETUM_AB(out,83). SCRIBE_OCTETUM_AB(out+1,73). SCRIBE_OCTETUM_AB(out+2,77). SCRIBE_OCTETUM_AB(out+3,71).
    SCRIBE_OCTETUM_AB(out+4,1). SCRIBE_OCTETUM_AB(out+5,1). SCRIBE_OCTETUM_AB(out+6,0). SCRIBE_OCTETUM_AB(out+7,0).
    DECLARA z SICUT NUMERUS VALENS FUIVIII_U32_PONE(out+8,w). z=FUIVIII_U32_PONE(out+12,h). z=FUIVIII_U32_PONE(out+16,stride). z=FUIVIII_U32_PONE(out+20,0).
    DECLARA rb SICUT NUMERUS VALENS rle+16. DECLARA rn SICUT NUMERUS VALENS CONTENTUM(rle).
    DECLARA rp SICUT NUMERUS VALENS 0. DECLARA pixel SICUT NUMERUS VALENS 0.
    DUM rp+3<rn PERFICE
        DECLARA cursus SICUT NUMERUS VALENS FUIVIII_HEX_OCTETUM(rb,rp).
        DECLARA alpha SICUT NUMERUS VALENS FUIVIII_HEX_OCTETUM(rb,rp+2).
        SI cursus<=0 || alpha<0 TUNC REDDE 0. FIN-SI.
        DECLARA i SICUT NUMERUS VALENS 0.
        DUM i<cursus PERFICE
            SI pixel>=w*h TUNC REDDE 0. FIN-SI.
            DECLARA locus SICUT NUMERUS VALENS out+24+pixel*4.
            SCRIBE_OCTETUM_AB(locus,255). SCRIBE_OCTETUM_AB(locus+1,255). SCRIBE_OCTETUM_AB(locus+2,255). SCRIBE_OCTETUM_AB(locus+3,alpha).
            pixel=pixel+1. i=i+1.
        FIN-DUM.
        rp=rp+4.
    FIN-DUM.
    SI pixel!=w*h TUNC REDDE 0. FIN-SI.
    REDDE d.
FIN-FUNCTIO.

FUNCTIO FUIVIII_FONS_CREA REDDENS NUMERUS.
    DECLARA atlas SICUT TEXTUS VALENS FUIVIII_CREA().
    SI atlas==0 TUNC REDDE 0. FIN-SI.
    REDDE TVIII_FONS_CREA(atlas,16,16,20,32,95).
FIN-FUNCTIO.
