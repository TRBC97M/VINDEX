// Sylvia OS — P16-VII: imago raster SIMG v1.
// Formatum est backend-neutrum: datum integrum ut TEXTUS binarius accipitur.
// Header XXIV octeta:
// 0..3  = 'SIMG'; 4=versio I; 5=formatum I (RGBA8888); 6..7 reservata;
// 8..11 = latitudo u32 LE; 12..15 = altitudo u32 LE;
// 16..19 = stride u32 LE; 20..23 reservata; deinde pixela RGBA.

FUNCTIO IR_TEXTUS_SEDES REDDENS NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    REDDE textus.
FIN-FUNCTIO.

FUNCTIO IR_U32_LE REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT offset SICUT NUMERUS.
    REDDE OCTETUS_AB(basis+offset)+OCTETUS_AB(basis+offset+1)*256+OCTETUS_AB(basis+offset+2)*65536+OCTETUS_AB(basis+offset+3)*16777216.
FIN-FUNCTIO.

FUNCTIO IR_VALIDUS REDDENS NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    DECLARA d SICUT NUMERUS VALENS IR_TEXTUS_SEDES(imago).
    SI d==0 || CONTENTUM(d)<24 TUNC REDDE 0. FIN-SI.
    DECLARA b SICUT NUMERUS VALENS d+16.
    SI OCTETUS_AB(b)!=83 || OCTETUS_AB(b+1)!=73 || OCTETUS_AB(b+2)!=77 || OCTETUS_AB(b+3)!=71 TUNC REDDE 0. FIN-SI.
    SI OCTETUS_AB(b+4)!=1 || OCTETUS_AB(b+5)!=1 TUNC REDDE 0. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS IR_U32_LE(b,8).
    DECLARA h SICUT NUMERUS VALENS IR_U32_LE(b,12).
    DECLARA stride SICUT NUMERUS VALENS IR_U32_LE(b,16).
    SI w<=0 || h<=0 || w>4096 || h>4096 TUNC REDDE 0. FIN-SI.
    SI stride<w*4 || stride>16384 TUNC REDDE 0. FIN-SI.
    DECLARA opus SICUT NUMERUS VALENS 24+stride*h.
    SI opus>CONTENTUM(d) TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IR_LATITUDO REDDENS NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    SI IR_VALIDUS(imago)==0 TUNC REDDE 0. FIN-SI.
    DECLARA d SICUT NUMERUS VALENS IR_TEXTUS_SEDES(imago).
    REDDE IR_U32_LE(d+16,8).
FIN-FUNCTIO.

FUNCTIO IR_ALTITUDO REDDENS NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    SI IR_VALIDUS(imago)==0 TUNC REDDE 0. FIN-SI.
    DECLARA d SICUT NUMERUS VALENS IR_TEXTUS_SEDES(imago).
    REDDE IR_U32_LE(d+16,12).
FIN-FUNCTIO.

FUNCTIO IR_STRIDE REDDENS NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    SI IR_VALIDUS(imago)==0 TUNC REDDE 0. FIN-SI.
    DECLARA d SICUT NUMERUS VALENS IR_TEXTUS_SEDES(imago).
    REDDE IR_U32_LE(d+16,16).
FIN-FUNCTIO.

// Reddit R+G<<8+B<<16+A<<24 in ordine logico SIMG.
FUNCTIO IR_PIXEL_RGBA REDDENS NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    SI IR_VALIDUS(imago)==0 TUNC REDDE -1. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS IR_LATITUDO(imago).
    DECLARA h SICUT NUMERUS VALENS IR_ALTITUDO(imago).
    SI x<0 || y<0 || x>=w || y>=h TUNC REDDE -1. FIN-SI.
    DECLARA stride SICUT NUMERUS VALENS IR_STRIDE(imago).
    DECLARA d SICUT NUMERUS VALENS IR_TEXTUS_SEDES(imago).
    DECLARA locus SICUT NUMERUS VALENS d+16+24+y*stride+x*4.
    REDDE OCTETUS_AB(locus)+OCTETUS_AB(locus+1)*256+OCTETUS_AB(locus+2)*65536+OCTETUS_AB(locus+3)*16777216.
FIN-FUNCTIO.

FUNCTIO IR_BLIT_SUPERFICIE REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    SI superficies==0 || IR_VALIDUS(imago)==0 TUNC REDDE 0. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS IR_LATITUDO(imago).
    DECLARA h SICUT NUMERUS VALENS IR_ALTITUDO(imago).
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py<h PERFICE
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px<w PERFICE
            DECLARA rgba SICUT NUMERUS VALENS IR_PIXEL_RGBA(imago,px,py).
            DECLARA a SICUT NUMERUS VALENS (rgba>>24)&255.
            SI a>0 TUNC
                DECLARA r SICUT NUMERUS VALENS rgba&255.
                DECLARA g SICUT NUMERUS VALENS (rgba>>8)&255.
                DECLARA b SICUT NUMERUS VALENS (rgba>>16)&255.
                DECLARA color SICUT NUMERUS VALENS FV_COLOR(r,g,b).
                DECLARA f SICUT NUMERUS VALENS GSVII_PIXEL_ALPHA(superficies,dx+px,dy+py,color,a).
            FIN-SI.
            px=px+1.
        FIN-DUM.
        py=py+1.
    FIN-DUM.
    DECLARA nota SICUT NUMERUS VALENS GSVII_NOTA(superficies).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IR_BLIT_FRAMEBUFFER REDDENS NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    // SONDA P16-XI TEMPORARIA: solum emblema ad (164,18) omittitur.
    // Haec linea post diagnosticum delenda est; rastera cetera intacta manent.
    SI dx==164 && dy==18 TUNC REDDE 1. FIN-SI.
    SI IR_VALIDUS(imago)==0 TUNC REDDE 0. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS IR_LATITUDO(imago).
    DECLARA h SICUT NUMERUS VALENS IR_ALTITUDO(imago).
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py<h PERFICE
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px<w PERFICE
            DECLARA rgba SICUT NUMERUS VALENS IR_PIXEL_RGBA(imago,px,py).
            DECLARA a SICUT NUMERUS VALENS (rgba>>24)&255.
            SI a>0 TUNC
                DECLARA r SICUT NUMERUS VALENS rgba&255.
                DECLARA g SICUT NUMERUS VALENS (rgba>>8)&255.
                DECLARA b SICUT NUMERUS VALENS (rgba>>16)&255.
                DECLARA color SICUT NUMERUS VALENS FV_COLOR(r,g,b).
                DECLARA f SICUT NUMERUS VALENS GVII_PIXEL_ALPHA(dx+px,dy+py,color,a).
            FIN-SI.
            px=px+1.
        FIN-DUM.
        py=py+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.
