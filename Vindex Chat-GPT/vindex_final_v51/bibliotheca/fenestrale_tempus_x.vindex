// Sylvia OS — P16-XII-D: tempus et horologium frame Graphica X.
//
// Horologium LXIV octeta:
//   0 genus backendis: I UEFI, II manuale;
//   8 eventus UEFI;
//  16 BootServices;
//  24 periodus in unitatibus C ns (100 ns);
//  32 numerus frame;
//  40 numerus consultationum;
//  48 numerus signorum acceptorum;
//  56 activum.
//
// Backend UEFI utitur CreateEvent + SetTimer + CheckEvent.
// CheckEvent numquam expectat: input et compositor inter consultationes liberi manent.

FUNCTIO TX_MEM_PURA REDDENS NUMERUS.
    ACCIPIT p SICUT NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<n PERFICE
        SCRIBE_OCTETUM_AB(p+i,0).
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TX_CREA_MANUALE REDDENS NUMERUS.
    DECLARA h SICUT NUMERUS VALENS RESERVA_OCTETA(64).
    SI h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS TX_MEM_PURA(h,64).
    CONTENTUM(h)=2.
    CONTENTUM(h+24)=1.
    CONTENTUM(h+56)=1.
    REDDE h.
FIN-FUNCTIO.

FUNCTIO TX_CREA_UEFI REDDENS NUMERUS.
    ACCIPIT periodus_100ns SICUT NUMERUS.
    SI periodus_100ns<=0 TUNC REDDE 0. FIN-SI.
    DECLARA ts SICUT NUMERUS VALENS CONTENTUM(16777224).
    SI ts==0 TUNC REDDE 0. FIN-SI.
    DECLARA bs SICUT NUMERUS VALENS CONTENTUM(ts+96).
    SI bs==0 TUNC REDDE 0. FIN-SI.
    DECLARA crea_eventum SICUT NUMERUS VALENS CONTENTUM(bs+80).
    DECLARA pone_tempus SICUT NUMERUS VALENS CONTENTUM(bs+88).
    DECLARA verifica_eventum SICUT NUMERUS VALENS CONTENTUM(bs+120).
    SI crea_eventum==0 || pone_tempus==0 || verifica_eventum==0 TUNC REDDE 0. FIN-SI.

    DECLARA locus_eventus SICUT NUMERUS VALENS RESERVA_OCTETA(8).
    SI locus_eventus<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(locus_eventus)=0.
    // EVT_TIMER = 0x80000000; TPL_CALLBACK = VIII.
    DECLARA st SICUT NUMERUS VALENS UEFI_VOCA6(crea_eventum,2147483648,8,0,0,locus_eventus,0).
    SI st!=0 || CONTENTUM(locus_eventus)==0 TUNC REDDE 0. FIN-SI.
    DECLARA eventus SICUT NUMERUS VALENS CONTENTUM(locus_eventus).
    // TimerPeriodic = I.
    st=UEFI_VOCA6(pone_tempus,eventus,1,periodus_100ns,0,0,0).
    SI st!=0 TUNC
        DECLARA claude SICUT NUMERUS VALENS CONTENTUM(bs+112).
        SI claude!=0 TUNC DECLARA ig_c SICUT NUMERUS VALENS UEFI_VOCA6(claude,eventus,0,0,0,0,0). FIN-SI.
        REDDE 0.
    FIN-SI.

    DECLARA h SICUT NUMERUS VALENS RESERVA_OCTETA(64).
    SI h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS TX_MEM_PURA(h,64).
    CONTENTUM(h)=1.
    CONTENTUM(h+8)=eventus.
    CONTENTUM(h+16)=bs.
    CONTENTUM(h+24)=periodus_100ns.
    CONTENTUM(h+56)=1.
    REDDE h.
FIN-FUNCTIO.

FUNCTIO TX_FRAME REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(h+32).
FIN-FUNCTIO.

FUNCTIO TX_CONSULTATIONES REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(h+40).
FIN-FUNCTIO.

FUNCTIO TX_SIGNA REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(h+48).
FIN-FUNCTIO.

FUNCTIO TX_PULSA_MANUALE REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 || CONTENTUM(h)!=2 || CONTENTUM(h+56)==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(h+40)=CONTENTUM(h+40)+1.
    CONTENTUM(h+48)=CONTENTUM(h+48)+1.
    CONTENTUM(h+32)=CONTENTUM(h+32)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TX_CONSULE REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 || CONTENTUM(h+56)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(h)==2 TUNC REDDE TX_PULSA_MANUALE(h). FIN-SI.
    SI CONTENTUM(h)!=1 TUNC REDDE 0. FIN-SI.
    DECLARA bs SICUT NUMERUS VALENS CONTENTUM(h+16).
    DECLARA eventus SICUT NUMERUS VALENS CONTENTUM(h+8).
    SI bs==0 || eventus==0 TUNC REDDE 0. FIN-SI.
    DECLARA verifica SICUT NUMERUS VALENS CONTENTUM(bs+120).
    SI verifica==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(h+40)=CONTENTUM(h+40)+1.
    DECLARA st SICUT NUMERUS VALENS UEFI_VOCA6(verifica,eventus,0,0,0,0,0).
    SI st!=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(h+48)=CONTENTUM(h+48)+1.
    CONTENTUM(h+32)=CONTENTUM(h+32)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TX_CLAUDE REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 || CONTENTUM(h+56)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(h)==1 TUNC
        DECLARA bs SICUT NUMERUS VALENS CONTENTUM(h+16).
        DECLARA eventus SICUT NUMERUS VALENS CONTENTUM(h+8).
        SI bs!=0 && eventus!=0 TUNC
            DECLARA claude SICUT NUMERUS VALENS CONTENTUM(bs+112).
            SI claude!=0 TUNC DECLARA ig SICUT NUMERUS VALENS UEFI_VOCA6(claude,eventus,0,0,0,0,0). FIN-SI.
        FIN-SI.
    FIN-SI.
    CONTENTUM(h+56)=0.
    REDDE 1.
FIN-FUNCTIO.
