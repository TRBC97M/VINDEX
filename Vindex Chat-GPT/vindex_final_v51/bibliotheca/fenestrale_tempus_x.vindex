// Sylvia OS — P16-XII-D: tempus et horologium frame Graphica X.
//
// Horologium CXII octeta:
//   0 genus backendis: I UEFI/TSC, II manuale;
//   8 eventus UEFI;
//  16 BootServices;
//  24 periodus in unitatibus C ns (100 ns);
//  32 numerus frame temporalis;
//  40 numerus consultationum;
//  48 numerus signorum UEFI observatorum;
//  56 activum;
//  64 stub TSC x86-64;
//  72 TSC originis;
//  80 TSC per frame;
//  88 maximus saltus frame;
//  96 frame omissae presentationis;
// 104 delta TSC calibrationis X ms.
//
// Lex XII-D: signum timeris NON est ipsum tempus. UEFI eventus tantum
// pacing/telemetriam praebet. Tempus animationis ex TSC monotono derivatur.
// Si render tardior est quam periodus, frame temporalis salit ad tempus verum
// potius quam animationem lente agere.

FUNCTIO TX_MEM_PURA REDDENS NUMERUS.
    ACCIPIT p SICUT NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<n PERFICE
        SCRIBE_OCTETUM_AB(p+i,0).
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TX_TSC_STUB_CREA REDDENS NUMERUS.
    // x86-64, XIII octeta:
    // lfence ; rdtsc ; shl rdx,32 ; or rax,rdx ; ret
    // Memoria ELF VINDEX sub Sylvia RWX est; nullum assembler externum adhibetur.
    DECLARA p SICUT NUMERUS VALENS RESERVA_OCTETA(16).
    SI p<=0 TUNC REDDE 0. FIN-SI.
    SCRIBE_OCTETUM_AB(p,15). SCRIBE_OCTETUM_AB(p+1,174). SCRIBE_OCTETUM_AB(p+2,232).
    SCRIBE_OCTETUM_AB(p+3,15). SCRIBE_OCTETUM_AB(p+4,49).
    SCRIBE_OCTETUM_AB(p+5,72). SCRIBE_OCTETUM_AB(p+6,193). SCRIBE_OCTETUM_AB(p+7,226). SCRIBE_OCTETUM_AB(p+8,32).
    SCRIBE_OCTETUM_AB(p+9,72). SCRIBE_OCTETUM_AB(p+10,9). SCRIBE_OCTETUM_AB(p+11,208).
    SCRIBE_OCTETUM_AB(p+12,195).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO TX_TSC_LEGE REDDENS NUMERUS.
    ACCIPIT stub SICUT NUMERUS.
    SI stub==0 TUNC REDDE 0. FIN-SI.
    REDDE UEFI_VOCA6(stub,0,0,0,0,0,0).
FIN-FUNCTIO.

FUNCTIO TX_TSC_CALIBRA REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    DECLARA bs SICUT NUMERUS VALENS CONTENTUM(h+16).
    DECLARA stub SICUT NUMERUS VALENS CONTENTUM(h+64).
    DECLARA periodus SICUT NUMERUS VALENS CONTENTUM(h+24).
    SI bs==0 || stub==0 || periodus<=0 TUNC REDDE 0. FIN-SI.
    DECLARA stall SICUT NUMERUS VALENS CONTENTUM(bs+248).
    SI stall==0 TUNC REDDE 0. FIN-SI.
    DECLARA t0 SICUT NUMERUS VALENS TX_TSC_LEGE(stub).
    // Calibratio semel ante ansam UI: X ms = C milia unitatum C ns.
    DECLARA st SICUT NUMERUS VALENS UEFI_VOCA6(stall,10000,0,0,0,0,0).
    DECLARA t1 SICUT NUMERUS VALENS TX_TSC_LEGE(stub).
    SI st!=0 || t1<=t0 TUNC REDDE 0. FIN-SI.
    DECLARA delta SICUT NUMERUS VALENS t1-t0.
    DECLARA per_frame SICUT NUMERUS VALENS delta*periodus/100000.
    SI per_frame<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(h+72)=t1.
    CONTENTUM(h+80)=per_frame.
    CONTENTUM(h+104)=delta.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TX_CREA_MANUALE REDDENS NUMERUS.
    DECLARA h SICUT NUMERUS VALENS RESERVA_OCTETA(112).
    SI h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS TX_MEM_PURA(h,112).
    CONTENTUM(h)=2.
    CONTENTUM(h+24)=1.
    CONTENTUM(h+56)=1.
    REDDE h.
FIN-FUNCTIO.

FUNCTIO TX_CREA_UEFI REDDENS NUMERUS.
    ACCIPIT periodus_100ns SICUT NUMERUS.
    SI periodus_100ns<=0 TUNC REDDE 0. FIN-SI.
    DECLARA ts SICUT NUMERUS VALENS CONTENTUM(16777224).
    SI ts==0 TUNC REDDE 0. FIN-SI.
    DECLARA bs SICUT NUMERUS VALENS CONTENTUM(ts+96).
    SI bs==0 TUNC REDDE 0. FIN-SI.
    DECLARA crea_eventum SICUT NUMERUS VALENS CONTENTUM(bs+80).
    DECLARA pone_tempus SICUT NUMERUS VALENS CONTENTUM(bs+88).
    DECLARA verifica_eventum SICUT NUMERUS VALENS CONTENTUM(bs+120).
    DECLARA stall SICUT NUMERUS VALENS CONTENTUM(bs+248).
    SI crea_eventum==0 || pone_tempus==0 || verifica_eventum==0 || stall==0 TUNC REDDE 0. FIN-SI.

    DECLARA h SICUT NUMERUS VALENS RESERVA_OCTETA(112).
    SI h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS TX_MEM_PURA(h,112).
    CONTENTUM(h)=1.
    CONTENTUM(h+16)=bs.
    CONTENTUM(h+24)=periodus_100ns.
    CONTENTUM(h+64)=TX_TSC_STUB_CREA().
    SI CONTENTUM(h+64)==0 TUNC REDDE 0. FIN-SI.
    SI TX_TSC_CALIBRA(h)==0 TUNC REDDE 0. FIN-SI.

    DECLARA locus_eventus SICUT NUMERUS VALENS RESERVA_OCTETA(8).
    SI locus_eventus<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(locus_eventus)=0.
    // EVT_TIMER = 0x80000000; TPL_CALLBACK = VIII.
    DECLARA st SICUT NUMERUS VALENS UEFI_VOCA6(crea_eventum,2147483648,8,0,0,locus_eventus,0).
    SI st!=0 || CONTENTUM(locus_eventus)==0 TUNC REDDE 0. FIN-SI.
    DECLARA eventus SICUT NUMERUS VALENS CONTENTUM(locus_eventus).
    // TimerPeriodic = I. Eventus pacing/telemetria est, non fons temporis.
    st=UEFI_VOCA6(pone_tempus,eventus,1,periodus_100ns,0,0,0).
    SI st!=0 TUNC
        DECLARA claude SICUT NUMERUS VALENS CONTENTUM(bs+112).
        SI claude!=0 TUNC DECLARA ig_c SICUT NUMERUS VALENS UEFI_VOCA6(claude,eventus,0,0,0,0,0). FIN-SI.
        REDDE 0.
    FIN-SI.

    CONTENTUM(h+8)=eventus.
    CONTENTUM(h+56)=1.
    REDDE h.
FIN-FUNCTIO.

FUNCTIO TX_FRAME REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(h+32).
FIN-FUNCTIO.

FUNCTIO TX_CONSULTATIONES REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(h+40).
FIN-FUNCTIO.

FUNCTIO TX_SIGNA REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(h+48).
FIN-FUNCTIO.

FUNCTIO TX_SALTUS_MAX REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(h+88).
FIN-FUNCTIO.

FUNCTIO TX_OMISSAE REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(h+96).
FIN-FUNCTIO.

FUNCTIO TX_TSC_PER_FRAME REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(h+80).
FIN-FUNCTIO.

FUNCTIO TX_PULSA_MANUALE REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 || CONTENTUM(h)!=2 || CONTENTUM(h+56)==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(h+40)=CONTENTUM(h+40)+1.
    CONTENTUM(h+48)=CONTENTUM(h+48)+1.
    CONTENTUM(h+32)=CONTENTUM(h+32)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TX_CONSULE REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 || CONTENTUM(h+56)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(h)==2 TUNC REDDE TX_PULSA_MANUALE(h). FIN-SI.
    SI CONTENTUM(h)!=1 TUNC REDDE 0. FIN-SI.
    DECLARA bs SICUT NUMERUS VALENS CONTENTUM(h+16).
    DECLARA eventus SICUT NUMERUS VALENS CONTENTUM(h+8).
    DECLARA stub SICUT NUMERUS VALENS CONTENTUM(h+64).
    DECLARA per_frame SICUT NUMERUS VALENS CONTENTUM(h+80).
    SI bs==0 || eventus==0 || stub==0 || per_frame<=0 TUNC REDDE 0. FIN-SI.
    DECLARA verifica SICUT NUMERUS VALENS CONTENTUM(bs+120).
    SI verifica==0 TUNC REDDE 0. FIN-SI.

    CONTENTUM(h+40)=CONTENTUM(h+40)+1.
    // Eventus periodicus tantum telemetriam servat.
    DECLARA st SICUT NUMERUS VALENS UEFI_VOCA6(verifica,eventus,0,0,0,0,0).
    SI st==0 TUNC CONTENTUM(h+48)=CONTENTUM(h+48)+1. FIN-SI.

    DECLARA nunc SICUT NUMERUS VALENS TX_TSC_LEGE(stub).
    DECLARA initium SICUT NUMERUS VALENS CONTENTUM(h+72).
    SI nunc<=initium TUNC REDDE 0. FIN-SI.
    DECLARA candidata SICUT NUMERUS VALENS (nunc-initium)/per_frame.
    DECLARA vetus SICUT NUMERUS VALENS CONTENTUM(h+32).
    SI candidata<=vetus TUNC REDDE 0. FIN-SI.
    DECLARA saltus SICUT NUMERUS VALENS candidata-vetus.
    SI saltus>CONTENTUM(h+88) TUNC CONTENTUM(h+88)=saltus. FIN-SI.
    SI saltus>1 TUNC CONTENTUM(h+96)=CONTENTUM(h+96)+saltus-1. FIN-SI.
    CONTENTUM(h+32)=candidata.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TX_CLAUDE REDDENS NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI h==0 || CONTENTUM(h+56)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(h)==1 TUNC
        DECLARA bs SICUT NUMERUS VALENS CONTENTUM(h+16).
        DECLARA eventus SICUT NUMERUS VALENS CONTENTUM(h+8).
        SI bs!=0 && eventus!=0 TUNC
            DECLARA claude SICUT NUMERUS VALENS CONTENTUM(bs+112).
            SI claude!=0 TUNC DECLARA ig SICUT NUMERUS VALENS UEFI_VOCA6(claude,eventus,0,0,0,0,0). FIN-SI.
        FIN-SI.
    FIN-SI.
    CONTENTUM(h+56)=0.
    REDDE 1.
FIN-FUNCTIO.
