// Sylvia OS — P16-XII: familia iconarum premium JL-UX.
// Asseta LXIV×LXIV RGBA semel creantur, deinde per SIMG II / Graphica IX
// ad mensuram bureau vel INITIUM interpolantur.
// SII_* et GVIII_RECT_* ante hoc folium importentur.

FUNCTIO IXII_RGBA REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    REDDE (r&255)+((g&255)<<8)+((b&255)<<16)+((a&255)<<24).
FIN-FUNCTIO.

FUNCTIO IXII_PIXEL_COMPONE REDDENS NUMERUS.
    ACCIPIT pix SICUT TEXTUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT rgba SICUT NUMERUS.
    SI x<0 || y<0 || x>=w || y>=h TUNC REDDE 0. FIN-SI.
    DECLARA basis SICUT NUMERUS VALENS SII_CORPUS(pix).
    SI basis==0 TUNC REDDE 0. FIN-SI.
    DECLARA locus SICUT NUMERUS VALENS basis+(y*w+x)*4.
    DECLARA sr SICUT NUMERUS VALENS rgba&255.
    DECLARA sg SICUT NUMERUS VALENS (rgba>>8)&255.
    DECLARA sb SICUT NUMERUS VALENS (rgba>>16)&255.
    DECLARA sa SICUT NUMERUS VALENS (rgba>>24)&255.
    SI sa<=0 TUNC REDDE 1. FIN-SI.
    DECLARA dr SICUT NUMERUS VALENS OCTETUS_AB(locus).
    DECLARA dg SICUT NUMERUS VALENS OCTETUS_AB(locus+1).
    DECLARA db SICUT NUMERUS VALENS OCTETUS_AB(locus+2).
    DECLARA da SICUT NUMERUS VALENS OCTETUS_AB(locus+3).
    DECLARA inv SICUT NUMERUS VALENS 255-sa.
    DECLARA oa SICUT NUMERUS VALENS sa+da*inv/255.
    SI oa<=0 TUNC REDDE 1. FIN-SI.
    DECLARA rr SICUT NUMERUS VALENS (sr*sa+dr*da*inv/255+oa/2)/oa.
    DECLARA rg SICUT NUMERUS VALENS (sg*sa+dg*da*inv/255+oa/2)/oa.
    DECLARA rb SICUT NUMERUS VALENS (sb*sa+db*da*inv/255+oa/2)/oa.
    SCRIBE_OCTETUM_AB(locus,rr).
    SCRIBE_OCTETUM_AB(locus+1,rg).
    SCRIBE_OCTETUM_AB(locus+2,rb).
    SCRIBE_OCTETUM_AB(locus+3,oa).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IXII_RECT_RGBA REDDENS NUMERUS.
    ACCIPIT pix SICUT TEXTUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT rect SICUT NUMERUS.
    ACCIPIT rgba SICUT NUMERUS.
    SI rect==0 TUNC REDDE 0. FIN-SI.
    DECLARA x0 SICUT NUMERUS VALENS GVIII_RECT_X(rect).
    DECLARA y0 SICUT NUMERUS VALENS GVIII_RECT_Y(rect).
    DECLARA rw SICUT NUMERUS VALENS GVIII_RECT_W(rect).
    DECLARA rh SICUT NUMERUS VALENS GVIII_RECT_H(rect).
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<rh PERFICE
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x<rw PERFICE
            DECLARA q SICUT NUMERUS VALENS IXII_PIXEL_COMPONE(pix,w,h,x0+x,y0+y,rgba).
            x=x+1.
        FIN-DUM.
        y=y+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IXII_RECT_GRAD REDDENS NUMERUS.
    ACCIPIT pix SICUT TEXTUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT rect SICUT NUMERUS.
    ACCIPIT summus SICUT NUMERUS.
    ACCIPIT inferus SICUT NUMERUS.
    SI rect==0 TUNC REDDE 0. FIN-SI.
    DECLARA x0 SICUT NUMERUS VALENS GVIII_RECT_X(rect).
    DECLARA y0 SICUT NUMERUS VALENS GVIII_RECT_Y(rect).
    DECLARA rw SICUT NUMERUS VALENS GVIII_RECT_W(rect).
    DECLARA rh SICUT NUMERUS VALENS GVIII_RECT_H(rect).
    SI rw<=0 || rh<=0 TUNC REDDE 0. FIN-SI.
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<rh PERFICE
        DECLARA den SICUT NUMERUS VALENS rh-1.
        SI den<1 TUNC den=1. FIN-SI.
        DECLARA sr SICUT NUMERUS VALENS summus&255.
        DECLARA sg SICUT NUMERUS VALENS (summus>>8)&255.
        DECLARA sb SICUT NUMERUS VALENS (summus>>16)&255.
        DECLARA sa SICUT NUMERUS VALENS (summus>>24)&255.
        DECLARA ir SICUT NUMERUS VALENS inferus&255.
        DECLARA ig SICUT NUMERUS VALENS (inferus>>8)&255.
        DECLARA ib SICUT NUMERUS VALENS (inferus>>16)&255.
        DECLARA ia SICUT NUMERUS VALENS (inferus>>24)&255.
        DECLARA r SICUT NUMERUS VALENS (sr*(den-y)+ir*y)/den.
        DECLARA g SICUT NUMERUS VALENS (sg*(den-y)+ig*y)/den.
        DECLARA b SICUT NUMERUS VALENS (sb*(den-y)+ib*y)/den.
        DECLARA a SICUT NUMERUS VALENS (sa*(den-y)+ia*y)/den.
        DECLARA rgba SICUT NUMERUS VALENS IXII_RGBA(r,g,b,a).
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x<rw PERFICE
            DECLARA q SICUT NUMERUS VALENS IXII_PIXEL_COMPONE(pix,w,h,x0+x,y0+y,rgba).
            x=x+1.
        FIN-DUM.
        y=y+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IXII_ROT_GRAD REDDENS NUMERUS.
    ACCIPIT pix SICUT TEXTUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT rect SICUT NUMERUS.
    ACCIPIT radius SICUT NUMERUS.
    ACCIPIT summus SICUT NUMERUS.
    ACCIPIT inferus SICUT NUMERUS.
    SI rect==0 TUNC REDDE 0. FIN-SI.
    DECLARA x0 SICUT NUMERUS VALENS GVIII_RECT_X(rect).
    DECLARA y0 SICUT NUMERUS VALENS GVIII_RECT_Y(rect).
    DECLARA rw SICUT NUMERUS VALENS GVIII_RECT_W(rect).
    DECLARA rh SICUT NUMERUS VALENS GVIII_RECT_H(rect).
    SI rw<=0 || rh<=0 TUNC REDDE 0. FIN-SI.
    SI radius<1 TUNC REDDE IXII_RECT_GRAD(pix,w,h,rect,summus,inferus). FIN-SI.
    DECLARA maxr SICUT NUMERUS VALENS rw/2.
    SI rh/2<maxr TUNC maxr=rh/2. FIN-SI.
    SI radius>maxr TUNC radius=maxr. FIN-SI.
    DECLARA inner SICUT NUMERUS VALENS radius-1.
    SI inner<0 TUNC inner=0. FIN-SI.
    DECLARA i2 SICUT NUMERUS VALENS inner*inner.
    DECLARA o2 SICUT NUMERUS VALENS radius*radius.
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<rh PERFICE
        DECLARA den SICUT NUMERUS VALENS rh-1.
        SI den<1 TUNC den=1. FIN-SI.
        DECLARA sr SICUT NUMERUS VALENS summus&255.
        DECLARA sg SICUT NUMERUS VALENS (summus>>8)&255.
        DECLARA sb SICUT NUMERUS VALENS (summus>>16)&255.
        DECLARA sa SICUT NUMERUS VALENS (summus>>24)&255.
        DECLARA ir SICUT NUMERUS VALENS inferus&255.
        DECLARA ig SICUT NUMERUS VALENS (inferus>>8)&255.
        DECLARA ib SICUT NUMERUS VALENS (inferus>>16)&255.
        DECLARA ia SICUT NUMERUS VALENS (inferus>>24)&255.
        DECLARA rr SICUT NUMERUS VALENS (sr*(den-y)+ir*y)/den.
        DECLARA rg SICUT NUMERUS VALENS (sg*(den-y)+ig*y)/den.
        DECLARA rb SICUT NUMERUS VALENS (sb*(den-y)+ib*y)/den.
        DECLARA ra SICUT NUMERUS VALENS (sa*(den-y)+ia*y)/den.
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x<rw PERFICE
            DECLARA cov SICUT NUMERUS VALENS 255.
            DECLARA cx SICUT NUMERUS VALENS x.
            DECLARA cy SICUT NUMERUS VALENS y.
            SI x<radius && y<radius TUNC cx=radius-1-x. cy=radius-1-y. FIN-SI.
            SI x>=rw-radius && y<radius TUNC cx=x-(rw-radius). cy=radius-1-y. FIN-SI.
            SI x<radius && y>=rh-radius TUNC cx=radius-1-x. cy=y-(rh-radius). FIN-SI.
            SI x>=rw-radius && y>=rh-radius TUNC cx=x-(rw-radius). cy=y-(rh-radius). FIN-SI.
            SI (x<radius || x>=rw-radius) && (y<radius || y>=rh-radius) TUNC
                DECLARA d2 SICUT NUMERUS VALENS cx*cx+cy*cy.
                SI d2>=o2 TUNC cov=0.
                ALITER SI d2>i2 TUNC
                    DECLARA span SICUT NUMERUS VALENS o2-i2.
                    SI span<1 TUNC span=1. FIN-SI.
                    cov=(o2-d2)*255/span.
                FIN-SI. FIN-SI.
            FIN-SI.
            SI cov>0 TUNC
                DECLARA a SICUT NUMERUS VALENS ra*cov/255.
                DECLARA rgba SICUT NUMERUS VALENS IXII_RGBA(rr,rg,rb,a).
                DECLARA q SICUT NUMERUS VALENS IXII_PIXEL_COMPONE(pix,w,h,x0+x,y0+y,rgba).
            FIN-SI.
            x=x+1.
        FIN-DUM.
        y=y+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IXII_BASIS REDDENS NUMERUS.
    ACCIPIT pix SICUT TEXTUS.
    DECLARA w SICUT NUMERUS VALENS 64.
    DECLARA h SICUT NUMERUS VALENS 64.
    DECLARA f SICUT NUMERUS VALENS IXII_ROT_GRAD(pix,w,h,GVIII_RECT_CREA(7,9,50,49),13,IXII_RGBA(0,0,0,72),IXII_RGBA(0,0,0,128)).
    f=IXII_ROT_GRAD(pix,w,h,GVIII_RECT_CREA(5,5,52,52),13,IXII_RGBA(104,132,149,232),IXII_RGBA(26,29,32,244)).
    f=IXII_ROT_GRAD(pix,w,h,GVIII_RECT_CREA(7,7,48,47),11,IXII_RGBA(74,96,114,218),IXII_RGBA(18,27,34,238)).
    f=IXII_RECT_GRAD(pix,w,h,GVIII_RECT_CREA(13,9,36,2),IXII_RGBA(242,244,247,188),IXII_RGBA(189,239,242,90)).
    f=IXII_RECT_RGBA(pix,w,h,GVIII_RECT_CREA(13,52,36,1),IXII_RGBA(181,138,84,170)).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IXII_PROGRAMMATA REDDENS TEXTUS.
    DECLARA pix SICUT TEXTUS VALENS SII_TEXTUS_CREA(64*64*4).
    SI SII_CORPUS(pix)==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS IXII_BASIS(pix).
    // Scrinium translucens cum quattuor codicibus distinctis.
    f=IXII_ROT_GRAD(pix,64,64,GVIII_RECT_CREA(13,22,38,25),5,IXII_RGBA(242,244,247,248),IXII_RGBA(191,199,207,236)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(13,18,21,7),IXII_RGBA(181,138,84,245)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(17,26,5,16),IXII_RGBA(0,198,255,238)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(24,24,6,18),IXII_RGBA(181,138,84,248)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(32,27,5,15),IXII_RGBA(104,177,123,242)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(39,23,7,19),IXII_RGBA(74,96,114,250)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(15,44,34,2),IXII_RGBA(181,138,84,235)).
    REDDE SII_CREA_RGBA(64,64,pix,1,2,2000).
FIN-FUNCTIO.

FUNCTIO IXII_TABULA REDDENS TEXTUS.
    DECLARA pix SICUT TEXTUS VALENS SII_TEXTUS_CREA(64*64*4).
    SI SII_CORPUS(pix)==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS IXII_BASIS(pix).
    // Tabula vitrea cum capite cyan et cellulis eburneis.
    f=IXII_ROT_GRAD(pix,64,64,GVIII_RECT_CREA(14,17,36,31),5,IXII_RGBA(242,244,247,250),IXII_RGBA(191,199,207,235)).
    f=IXII_RECT_GRAD(pix,64,64,GVIII_RECT_CREA(14,17,36,7),IXII_RGBA(189,239,242,255),IXII_RGBA(0,198,255,235)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(25,24,1,21),IXII_RGBA(74,96,114,205)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(37,24,1,21),IXII_RGBA(74,96,114,205)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(16,31,32,1),IXII_RGBA(74,96,114,190)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(16,38,32,1),IXII_RGBA(74,96,114,190)).
    f=IXII_ROT_GRAD(pix,64,64,GVIII_RECT_CREA(17,26,7,4),2,IXII_RGBA(104,177,123,255),IXII_RGBA(72,142,96,245)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(40,41,6,3),IXII_RGBA(181,138,84,240)).
    REDDE SII_CREA_RGBA(64,64,pix,1,2,2000).
FIN-FUNCTIO.

FUNCTIO IXII_TERMINALE REDDENS TEXTUS.
    DECLARA pix SICUT TEXTUS VALENS SII_TEXTUS_CREA(64*64*4).
    SI SII_CORPUS(pix)==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS IXII_BASIS(pix).
    // Monitor vitreo-metallicus, lumen cyan et promptum laureum.
    f=IXII_ROT_GRAD(pix,64,64,GVIII_RECT_CREA(12,16,40,29),6,IXII_RGBA(191,199,207,248),IXII_RGBA(74,96,114,248)).
    f=IXII_ROT_GRAD(pix,64,64,GVIII_RECT_CREA(15,19,34,22),4,IXII_RGBA(22,44,58,255),IXII_RGBA(7,15,20,255)).
    f=IXII_RECT_GRAD(pix,64,64,GVIII_RECT_CREA(17,20,30,2),IXII_RGBA(0,198,255,200),IXII_RGBA(189,239,242,70)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(20,27,7,2),IXII_RGBA(104,177,123,255)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(25,29,2,4),IXII_RGBA(104,177,123,255)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(20,33,7,2),IXII_RGBA(104,177,123,255)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(31,34,11,2),IXII_RGBA(0,198,255,245)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(29,45,6,5),IXII_RGBA(191,199,207,240)).
    f=IXII_ROT_GRAD(pix,64,64,GVIII_RECT_CREA(21,49,22,4),2,IXII_RGBA(181,138,84,245),IXII_RGBA(74,96,114,240)).
    REDDE SII_CREA_RGBA(64,64,pix,1,2,2000).
FIN-FUNCTIO.

FUNCTIO IXII_OFFICINA REDDENS TEXTUS.
    DECLARA pix SICUT TEXTUS VALENS SII_TEXTUS_CREA(64*64*4).
    SI SII_CORPUS(pix)==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS IXII_BASIS(pix).
    // Folium eburneum cum spina bronzea, lineis cyan et sigillo.
    f=IXII_ROT_GRAD(pix,64,64,GVIII_RECT_CREA(17,13,31,39),5,IXII_RGBA(255,255,252,255),IXII_RGBA(226,231,235,250)).
    f=IXII_RECT_GRAD(pix,64,64,GVIII_RECT_CREA(17,15,5,35),IXII_RGBA(181,138,84,255),IXII_RGBA(128,87,53,250)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(26,23,16,2),IXII_RGBA(0,198,255,225)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(26,29,13,2),IXII_RGBA(74,96,114,205)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(26,35,17,2),IXII_RGBA(74,96,114,205)).
    f=IXII_RECT_RGBA(pix,64,64,GVIII_RECT_CREA(26,41,11,2),IXII_RGBA(104,177,123,220)).
    f=IXII_ROT_GRAD(pix,64,64,GVIII_RECT_CREA(38,42,8,8),4,IXII_RGBA(189,239,242,245),IXII_RGBA(181,138,84,245)).
    REDDE SII_CREA_RGBA(64,64,pix,1,2,2000).
FIN-FUNCTIO.

FUNCTIO IXII_CREA REDDENS TEXTUS.
    ACCIPIT genus SICUT NUMERUS.
    SI genus==1 TUNC REDDE IXII_PROGRAMMATA(). FIN-SI.
    SI genus==2 TUNC REDDE IXII_TABULA(). FIN-SI.
    SI genus==3 TUNC REDDE IXII_TERMINALE(). FIN-SI.
    SI genus==4 TUNC REDDE IXII_OFFICINA(). FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO IXII_GESTOR_CREA REDDENS NUMERUS.
    DECLARA gestor SICUT NUMERUS VALENS AII_CREA(1000).
    SI gestor==0 TUNC REDDE 0. FIN-SI.
    DECLARA g SICUT NUMERUS VALENS 1.
    DUM g<=4 PERFICE
        DECLARA imago SICUT TEXTUS VALENS IXII_CREA(g).
        SI SII_VALIDUS(imago)==0 TUNC REDDE 0. FIN-SI.
        SI AII_ADDE(gestor,g,imago)==0 TUNC REDDE 0. FIN-SI.
        g=g+1.
    FIN-DUM.
    REDDE gestor.
FIN-FUNCTIO.
