    SI codex == 63 TUNC q=FVT_SEG(c,x,y,g,cr,color,alpha,0,1,1,0). q=FVT_SEG(c,x,y,g,cr,color,alpha,1,0,5,0). q=FVT_SEG(c,x,y,g,cr,color,alpha,5,0,6,1). q=FVT_SEG(c,x,y,g,cr,color,alpha,6,1,3,4). q=FVT_SEG(c,x,y,g,cr,color,alpha,3,4,3,5). q=FVT_SEG(c,x,y,g,cr,color,alpha,3,8,3,8). REDDE 1. FIN-SI.
    SI codex == 37 TUNC q=FVT_SEG(c,x,y,g,cr,color,alpha,0,8,6,0). q=FVT_SEG(c,x,y,g,cr,color,alpha,1,1,1,2). q=FVT_SEG(c,x,y,g,cr,color,alpha,5,6,5,7). REDDE 1. FIN-SI.
    SI codex == 40 TUNC q=FVT_SEG(c,x,y,g,cr,color,alpha,4,0,2,2). q=FVT_SEG(c,x,y,g,cr,color,alpha,2,2,2,6). q=FVT_SEG(c,x,y,g,cr,color,alpha,2,6,4,8). REDDE 1. FIN-SI.
    SI codex == 41 TUNC q=FVT_SEG(c,x,y,g,cr,color,alpha,2,0,4,2). q=FVT_SEG(c,x,y,g,cr,color,alpha,4,2,4,6). q=FVT_SEG(c,x,y,g,cr,color,alpha,4,6,2,8). REDDE 1. FIN-SI.
    SI codex == 91 TUNC q=FVT_SEG(c,x,y,g,cr,color,alpha,4,0,1,0). q=FVT_SEG(c,x,y,g,cr,color,alpha,1,0,1,8). q=FVT_SEG(c,x,y,g,cr,color,alpha,1,8,4,8). REDDE 1. FIN-SI.
    SI codex == 93 TUNC q=FVT_SEG(c,x,y,g,cr,color,alpha,2,0,5,0). q=FVT_SEG(c,x,y,g,cr,color,alpha,5,0,5,8). q=FVT_SEG(c,x,y,g,cr,color,alpha,5,8,2,8). REDDE 1. FIN-SI.

    // Caractere inconnu: losange discret plutot qu'un bloc bitmap.
    q=FVT_SEG(c,x,y,g,cr,color,alpha,3,0,6,4). q=FVT_SEG(c,x,y,g,cr,color,alpha,6,4,3,8). q=FVT_SEG(c,x,y,g,cr,color,alpha,3,8,0,4). q=FVT_SEG(c,x,y,g,cr,color,alpha,0,4,3,0).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FVT_CHAR REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT codex SICUT NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA cr SICUT NUMERUS VALENS g / 2.
    SI cr < 1 TUNC cr = 1. FIN-SI.
    REDDE FVT_CHAR_ALPHA(c,x,y,codex,g,cr,color,245).
FIN-FUNCTIO.

FUNCTIO FVT_TEXTUS REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    SI c <= 0 || g <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS LONGITUDO(textus).
    DECLARA basis SICUT NUMERUS VALENS TEXTUS_BASIS_OCTETORUM(textus).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < n PERFICE
        DECLARA codex SICUT NUMERUS VALENS OCTETUS_AB(basis + i).
        DECLARA q SICUT NUMERUS VALENS FVT_CHAR(c, x + i * 8 * g, y, codex, g, color).
        i = i + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FVT_TEXTUS_GLOW REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    SI c <= 0 || g <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS LONGITUDO(textus).
    DECLARA basis SICUT NUMERUS VALENS TEXTUS_BASIS_OCTETORUM(textus).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < n PERFICE
        DECLARA codex SICUT NUMERUS VALENS OCTETUS_AB(basis + i).
        DECLARA gx SICUT NUMERUS VALENS x + i * 8 * g.
        DECLARA cr SICUT NUMERUS VALENS g + 3.
        DECLARA q SICUT NUMERUS VALENS FVT_CHAR_ALPHA(c,gx,y,codex,g,cr,color,16).
        cr = g + 1.
        q = FVT_CHAR_ALPHA(c,gx,y,codex,g,cr,color,40).
        q = FVT_CHAR(c,gx,y,codex,g,color).
        i = i + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FVT_LATITUDO REDDENS NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    ACCIPIT g SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS LONGITUDO(textus).
    SI n <= 0 || g <= 0 TUNC REDDE 0. FIN-SI.
    REDDE n * 8 * g - 2 * g.
FIN-FUNCTIO.