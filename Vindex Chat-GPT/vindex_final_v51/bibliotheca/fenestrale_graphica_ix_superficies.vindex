// Sylvia OS — Graphica IX: rastera premium in superficies privatas.
// GIX_RGBA_LINEAR, GSVII_* et AII_* ante hoc folium importentur.

FUNCTIO GIX_RGBA_REGION_S REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT rgba SICUT TEXTUS.
    ACCIPIT iw SICUT NUMERUS.
    ACCIPIT ih SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    SI superficies==0 || SII_CORPUS(rgba)==0 || iw<=0 || ih<=0 || fons==0 || destinatio==0 TUNC REDDE 0. FIN-SI.
    SI SII_LONGITUDO(rgba)<iw*ih*4 TUNC REDDE 0. FIN-SI.
    DECLARA sx SICUT NUMERUS VALENS GVIII_RECT_X(fons).
    DECLARA sy SICUT NUMERUS VALENS GVIII_RECT_Y(fons).
    DECLARA sw SICUT NUMERUS VALENS GVIII_RECT_W(fons).
    DECLARA sh SICUT NUMERUS VALENS GVIII_RECT_H(fons).
    DECLARA dx SICUT NUMERUS VALENS GVIII_RECT_X(destinatio).
    DECLARA dy SICUT NUMERUS VALENS GVIII_RECT_Y(destinatio).
    DECLARA dw SICUT NUMERUS VALENS GVIII_RECT_W(destinatio).
    DECLARA dh SICUT NUMERUS VALENS GVIII_RECT_H(destinatio).
    SI sw<=0 || sh<=0 || dw<=0 || dh<=0 TUNC REDDE 0. FIN-SI.
    SI sx<0 || sy<0 || sx+sw>iw || sy+sh>ih TUNC REDDE 0. FIN-SI.
    DECLARA ag SICUT NUMERUS VALENS GIX_CLAMPA(alpha_globalis,0,255).
    SI ag==0 TUNC REDDE 1. FIN-SI.
    DECLARA surf_w SICUT NUMERUS VALENS CONTENTUM(superficies).
    DECLARA surf_h SICUT NUMERUS VALENS CONTENTUM(superficies+8).
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py<dh PERFICE
        DECLARA yy SICUT NUMERUS VALENS dy+py.
        SI yy>=0 && yy<surf_h TUNC
            DECLARA uy SICUT NUMERUS VALENS sy*65536.
            SI dh>1 && sh>1 TUNC uy=uy+py*(sh-1)*65536/(dh-1). FIN-SI.
            DECLARA px SICUT NUMERUS VALENS 0.
            DUM px<dw PERFICE
                DECLARA xx SICUT NUMERUS VALENS dx+px.
                SI xx>=0 && xx<surf_w TUNC
                    DECLARA ux SICUT NUMERUS VALENS sx*65536.
                    SI dw>1 && sw>1 TUNC ux=ux+px*(sw-1)*65536/(dw-1). FIN-SI.
                    DECLARA q SICUT NUMERUS VALENS GIX_RGBA_LINEAR(rgba,iw,ih,ux,uy).
                    DECLARA a SICUT NUMERUS VALENS ((q>>24)&255)*ag/255.
                    SI a>0 TUNC
                        DECLARA color SICUT NUMERUS VALENS FV_COLOR(q&255,(q>>8)&255,(q>>16)&255).
                        DECLARA f SICUT NUMERUS VALENS GSVII_PIXEL_ALPHA(superficies,xx,yy,color,a).
                    FIN-SI.
                FIN-SI.
                px=px+1.
            FIN-DUM.
        FIN-SI.
        py=py+1.
    FIN-DUM.
    REDDE GSVII_NOTA(superficies).
FIN-FUNCTIO.

FUNCTIO GIX_ASSET_REGION_S REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT gestor SICUT NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS AII_OPTIMUM_NODUS(gestor,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    DECLARA rgba SICUT TEXTUS VALENS AII_RGBA_CACHE(gestor,id).
    SI SII_CORPUS(rgba)==0 TUNC REDDE 0. FIN-SI.
    REDDE GIX_RGBA_REGION_S(superficies,rgba,AII_LATITUDO(n),AII_ALTITUDO(n),fons,destinatio,alpha_globalis).
FIN-FUNCTIO.

FUNCTIO GIX_ASSET_LINEAR_S REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT gestor SICUT NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS AII_OPTIMUM_NODUS(gestor,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    DECLARA fons SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,AII_LATITUDO(n),AII_ALTITUDO(n)).
    REDDE GIX_ASSET_REGION_S(superficies,gestor,id,fons,destinatio,alpha_globalis).
FIN-FUNCTIO.

FUNCTIO GIX_ASSET_NOVEM_S REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT gestor SICUT NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS AII_OPTIMUM_NODUS(gestor,id).
    SI superficies==0 || n==0 || destinatio==0 TUNC REDDE 0. FIN-SI.
    DECLARA imago SICUT TEXTUS VALENS AII_IMAGO(n).
    SI SII_VALIDUS(imago)==0 || (SII_META_VEXILLA(imago)&1)==0 TUNC REDDE 0. FIN-SI.
    DECLARA rgba SICUT TEXTUS VALENS AII_RGBA_CACHE(gestor,id).
    SI SII_CORPUS(rgba)==0 TUNC REDDE 0. FIN-SI.
    DECLARA iw SICUT NUMERUS VALENS AII_LATITUDO(n).
    DECLARA ih SICUT NUMERUS VALENS AII_ALTITUDO(n).
    DECLARA ml SICUT NUMERUS VALENS SII_MARGO(imago,0).
    DECLARA mt SICUT NUMERUS VALENS SII_MARGO(imago,1).
    DECLARA mr SICUT NUMERUS VALENS SII_MARGO(imago,2).
    DECLARA mb SICUT NUMERUS VALENS SII_MARGO(imago,3).
    DECLARA dx SICUT NUMERUS VALENS GVIII_RECT_X(destinatio).
    DECLARA dy SICUT NUMERUS VALENS GVIII_RECT_Y(destinatio).
    DECLARA dw SICUT NUMERUS VALENS GVIII_RECT_W(destinatio).
    DECLARA dh SICUT NUMERUS VALENS GVIII_RECT_H(destinatio).
    SI ml+mr>iw || mt+mb>ih || dw<ml+mr || dh<mt+mb TUNC REDDE 0. FIN-SI.
    DECLARA smw SICUT NUMERUS VALENS iw-ml-mr.
    DECLARA smh SICUT NUMERUS VALENS ih-mt-mb.
    DECLARA dmw SICUT NUMERUS VALENS dw-ml-mr.
    DECLARA dmh SICUT NUMERUS VALENS dh-mt-mb.
    DECLARA f SICUT NUMERUS VALENS 0.
    f=GIX_RGBA_REGION_S(superficies,rgba,iw,ih,GVIII_RECT_CREA(0,0,ml,mt),GVIII_RECT_CREA(dx,dy,ml,mt),alpha_globalis).
    f=GIX_RGBA_REGION_S(superficies,rgba,iw,ih,GVIII_RECT_CREA(ml,0,smw,mt),GVIII_RECT_CREA(dx+ml,dy,dmw,mt),alpha_globalis).
    f=GIX_RGBA_REGION_S(superficies,rgba,iw,ih,GVIII_RECT_CREA(iw-mr,0,mr,mt),GVIII_RECT_CREA(dx+dw-mr,dy,mr,mt),alpha_globalis).
    f=GIX_RGBA_REGION_S(superficies,rgba,iw,ih,GVIII_RECT_CREA(0,mt,ml,smh),GVIII_RECT_CREA(dx,dy+mt,ml,dmh),alpha_globalis).
    f=GIX_RGBA_REGION_S(superficies,rgba,iw,ih,GVIII_RECT_CREA(ml,mt,smw,smh),GVIII_RECT_CREA(dx+ml,dy+mt,dmw,dmh),alpha_globalis).
    f=GIX_RGBA_REGION_S(superficies,rgba,iw,ih,GVIII_RECT_CREA(iw-mr,mt,mr,smh),GVIII_RECT_CREA(dx+dw-mr,dy+mt,mr,dmh),alpha_globalis).
    f=GIX_RGBA_REGION_S(superficies,rgba,iw,ih,GVIII_RECT_CREA(0,ih-mb,ml,mb),GVIII_RECT_CREA(dx,dy+dh-mb,ml,mb),alpha_globalis).
    f=GIX_RGBA_REGION_S(superficies,rgba,iw,ih,GVIII_RECT_CREA(ml,ih-mb,smw,mb),GVIII_RECT_CREA(dx+ml,dy+dh-mb,dmw,mb),alpha_globalis).
    f=GIX_RGBA_REGION_S(superficies,rgba,iw,ih,GVIII_RECT_CREA(iw-mr,ih-mb,mr,mb),GVIII_RECT_CREA(dx+dw-mr,dy+dh-mb,mr,mb),alpha_globalis).
    REDDE GSVII_NOTA(superficies).
FIN-FUNCTIO.
