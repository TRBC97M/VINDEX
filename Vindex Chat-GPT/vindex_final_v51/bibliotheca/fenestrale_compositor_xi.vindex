// Sylvia OS — P16-XI: compositor Bureau Lucidum I, implementatio II.
// Wallpaper cache + Bureau Graphica VIII; fenestrae P16-VIII et testa P16-IX servantur.

FUNCTIO IVXI_REDDE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT fenestrae SICUT NUMERUS.
    ACCIPIT clientes SICUT NUMERUS.
    ACCIPIT applicationes SICUT NUMERUS.
    ACCIPIT emblema SICUT TEXTUS.
    ACCIPIT atlas SICUT TEXTUS.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(50333728).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(50333736).
    DECLARA utilis SICUT NUMERUS VALENS h-FV_METRUM_TASKBAR().
    DECLARA f SICUT NUMERUS VALENS 0.
    SI s[42]!=0 TUNC
        f=FS_BLIT(s[42],0,0,w,utilis).
    ALITER
        f=FV_FUNDUM().
    FIN-SI.
    f=CXI_BUREAU_REDDE(s,applicationes).
    SI IR_VALIDUS(emblema)!=0 TUNC f=IR_BLIT_FRAMEBUFFER(164,18,emblema). FIN-SI.
    SI IR_VALIDUS(atlas)!=0 TUNC f=CXI_BUREAU_ICONAE(s,applicationes,atlas). FIN-SI.
    DECLARA focus SICUT NUMERUS VALENS FI_RELEGE_FOCUS(fenestrae).
    DECLARA n SICUT NUMERUS VALENS FI_PRIMUS(fenestrae).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)==0 TUNC f=CVIII_FENESTRA(fenestrae,clientes,applicationes,n). FIN-SI.
        n=FI_PROXIMUS(n).
    FIN-DUM.
    SI s[38]==1 TUNC
        f=CIX_INITIUM_REDDE(s,applicationes).
        SI IR_VALIDUS(atlas)!=0 TUNC f=IVVII_INITIUM_ICONAE(s,applicationes,atlas). FIN-SI.
    FIN-SI.
    f=CIX_TASKBAR_REDDE(s,fenestrae,clientes,applicationes).
    f=FV_CURSOR(s[11],s[12]).
    REDDE 1.
FIN-FUNCTIO.
