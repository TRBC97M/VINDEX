// VINDEX — fons stroke scalabilis ex topologia 5x7.
// Non sunt quadrata bitmap directa: glyphi componuntur lineis crassis,
// diagonalis ubi opus est, et possunt glow accipere.
// Dependit a fons_bitmap_5x7.vindex et canvas_bgra_fx.vindex.

FUNCTIO FS5_ON REDDENS NUMERUS.
    ACCIPIT glyph SICUT NUMERUS.
    ACCIPIT gx SICUT NUMERUS.
    ACCIPIT gy SICUT NUMERUS.
    SI gx < 0 || gx >= 5 || gy < 0 || gy >= 7 TUNC REDDE 0. FIN-SI.
    REDDE (glyph >> (gy * 5 + gx)) & 1.
FIN-FUNCTIO.

FUNCTIO FS5_CHAR_ALPHA REDDENS NUMERUS.
    ACCIPIT canvas SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT codex SICUT NUMERUS.
    ACCIPIT gradus SICUT NUMERUS.
    ACCIPIT crassitudo SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    SI canvas <= 0 || gradus <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA glyph SICUT NUMERUS VALENS FB5_GLYPH(codex).
    SI glyph == 0 TUNC REDDE 1. FIN-SI.
    SI crassitudo < 1 TUNC crassitudo = 1. FIN-SI.

    DECLARA gy SICUT NUMERUS VALENS 0.
    DUM gy < 7 PERFICE
        DECLARA gx SICUT NUMERUS VALENS 0.
        DUM gx < 5 PERFICE
            SI FS5_ON(glyph, gx, gy) != 0 TUNC
                DECLARA px SICUT NUMERUS VALENS x + gx * gradus.
                DECLARA py SICUT NUMERUS VALENS y + gy * gradus.
                DECLARA node SICUT NUMERUS VALENS CBGRA_LINEA_GROSSA(canvas, px, py, px, py, crassitudo + 1, color, alpha).

                SI gx < 4 TUNC
                    SI FS5_ON(glyph, gx + 1, gy) != 0 TUNC
                        node = CBGRA_LINEA_GROSSA(canvas, px, py, px + gradus, py, crassitudo, color, alpha).
                    FIN-SI.
                FIN-SI.
                SI gy < 6 TUNC
                    SI FS5_ON(glyph, gx, gy + 1) != 0 TUNC
                        node = CBGRA_LINEA_GROSSA(canvas, px, py, px, py + gradus, crassitudo, color, alpha).
                    FIN-SI.
                FIN-SI.

                // Diagonales tantum cum nexus orthogonales absunt.
                SI gx < 4 && gy < 6 TUNC
                    DECLARA right SICUT NUMERUS VALENS FS5_ON(glyph, gx + 1, gy).
                    DECLARA down SICUT NUMERUS VALENS FS5_ON(glyph, gx, gy + 1).
                    DECLARA diag SICUT NUMERUS VALENS FS5_ON(glyph, gx + 1, gy + 1).
                    SI diag != 0 && right == 0 && down == 0 TUNC
                        node = CBGRA_LINEA_GROSSA(canvas, px, py, px + gradus, py + gradus, crassitudo, color, alpha).
                    FIN-SI.
                FIN-SI.
                SI gx > 0 && gy < 6 TUNC
                    DECLARA left SICUT NUMERUS VALENS FS5_ON(glyph, gx - 1, gy).
                    DECLARA down2 SICUT NUMERUS VALENS FS5_ON(glyph, gx, gy + 1).
                    DECLARA diag2 SICUT NUMERUS VALENS FS5_ON(glyph, gx - 1, gy + 1).
                    SI diag2 != 0 && left == 0 && down2 == 0 TUNC
                        node = CBGRA_LINEA_GROSSA(canvas, px, py, px - gradus, py + gradus, crassitudo, color, alpha).
                    FIN-SI.
                FIN-SI.
            FIN-SI.
            gx = gx + 1.
        FIN-DUM.
        gy = gy + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FS5_CHAR REDDENS NUMERUS.
    ACCIPIT canvas SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT codex SICUT NUMERUS.
    ACCIPIT gradus SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA crassitudo SICUT NUMERUS VALENS gradus / 2.
    SI crassitudo < 1 TUNC crassitudo = 1. FIN-SI.
    REDDE FS5_CHAR_ALPHA(canvas, x, y, codex, gradus, crassitudo, color, 255).
FIN-FUNCTIO.

FUNCTIO FS5_TEXTUS REDDENS NUMERUS.
    ACCIPIT canvas SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    ACCIPIT gradus SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    SI canvas <= 0 || gradus <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS LONGITUDO(textus).
    DECLARA basis SICUT NUMERUS VALENS TEXTUS_BASIS_OCTETORUM(textus).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < n PERFICE
        DECLARA codex SICUT NUMERUS VALENS OCTETUS_AB(basis + i).
        DECLARA q SICUT NUMERUS VALENS FS5_CHAR(canvas, x + i * 7 * gradus, y, codex, gradus, color).
        i = i + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FS5_TEXTUS_GLOW REDDENS NUMERUS.
    ACCIPIT canvas SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    ACCIPIT gradus SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    SI canvas <= 0 || gradus <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS LONGITUDO(textus).
    DECLARA basis SICUT NUMERUS VALENS TEXTUS_BASIS_OCTETORUM(textus).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < n PERFICE
        DECLARA codex SICUT NUMERUS VALENS OCTETUS_AB(basis + i).
        DECLARA gx SICUT NUMERUS VALENS x + i * 7 * gradus.
        DECLARA thick SICUT NUMERUS VALENS gradus + 3.
        DECLARA q SICUT NUMERUS VALENS FS5_CHAR_ALPHA(canvas, gx, y, codex, gradus, thick, color, 24).
        thick = gradus.
        q = FS5_CHAR_ALPHA(canvas, gx, y, codex, gradus, thick, color, 55).
        q = FS5_CHAR(canvas, gx, y, codex, gradus, color).
        i = i + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FS5_LATITUDO REDDENS NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    ACCIPIT gradus SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS LONGITUDO(textus).
    SI n <= 0 || gradus <= 0 TUNC REDDE 0. FIN-SI.
    REDDE n * 7 * gradus - 2 * gradus.
FIN-FUNCTIO.