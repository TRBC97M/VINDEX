// Sylvia OS — P16-VII: atlas iconarum rasterarum applicationum.
// Quattuor tesserae XLVIII×XLVIII in imagine XCVI×XCVI:
// 1 PROGRAMMATA, 2 TABULA, 3 TERMINALE, 4 OFFICINA.
// Renderer formas ignorat: palette + RLE in SIMG RGBA8888 expanduntur.

FUNCTIO ICVII_CREA REDDENS TEXTUS.
    DECLARA palette SICUT TEXTUS VALENS "0C101507334A350E55502F0D71734E24DFD0A2F4121B4710936D381CF1C673FAD5A356EF926F4621D59D4E4FDFA3509DF0F0E0F6B1894DF9535C56F92E4B53F71E3B47F8F0FAFB4FA1B0A4E35B8578FD6E998FFBA5DDDADBA4753DFEC7853CFD9E7945F9111C22FB5ED9DAF34F4A38F64E292B0E78DAE222EEFFFF0F8CE7EF1C".
    DECLARA rle SICUT TEXTUS VALENS "".
    REDDE RRVII_CREA(96,96,palette,32,rle).
FIN-FUNCTIO.

FUNCTIO ICVII_FONS_X REDDENS NUMERUS.
    ACCIPIT genus SICUT NUMERUS.
    SI genus==2 || genus==4 TUNC REDDE 48. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ICVII_FONS_Y REDDENS NUMERUS.
    ACCIPIT genus SICUT NUMERUS.
    SI genus>=3 TUNC REDDE 48. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
