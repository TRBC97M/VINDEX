// Sylvia OS — Capacitas Graphica VIII: compositio in superficies privatas.
// FS_*, GSVII_*, IR_* et GVIII_* ante hoc importentur.

// Copia opaca rectanguli inter duas superficies, duobus pixelis per qword ubi licet.
FUNCTIO GVIII_SUPERFICIES_COPIA_RECT REDDENS NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    ACCIPIT sx SICUT NUMERUS.
    ACCIPIT sy SICUT NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI destinatio==0 || fons==0 || w<=0 || h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(fons).
    DECLARA sh SICUT NUMERUS VALENS CONTENTUM(fons+8).
    DECLARA dw SICUT NUMERUS VALENS CONTENTUM(destinatio).
    DECLARA dh SICUT NUMERUS VALENS CONTENTUM(destinatio+8).

    SI sx<0 TUNC dx=dx-sx. w=w+sx. sx=0. FIN-SI.
    SI sy<0 TUNC dy=dy-sy. h=h+sy. sy=0. FIN-SI.
    SI dx<0 TUNC sx=sx-dx. w=w+dx. dx=0. FIN-SI.
    SI dy<0 TUNC sy=sy-dy. h=h+dy. dy=0. FIN-SI.
    SI sx+w>sw TUNC w=sw-sx. FIN-SI.
    SI sy+h>sh TUNC h=sh-sy. FIN-SI.
    SI dx+w>dw TUNC w=dw-dx. FIN-SI.
    SI dy+h>dh TUNC h=dh-dy. FIN-SI.
    SI w<=0 || h<=0 TUNC REDDE 0. FIN-SI.

    DECLARA sb SICUT NUMERUS VALENS CONTENTUM(fons+24).
    DECLARA db SICUT NUMERUS VALENS CONTENTUM(destinatio+24).
    DECLARA ss SICUT NUMERUS VALENS CONTENTUM(fons+16).
    DECLARA ds SICUT NUMERUS VALENS CONTENTUM(destinatio+16).
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py<h PERFICE
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px+1<w PERFICE
            CONTENTUM(db+((dy+py)*ds+dx+px)*4)=CONTENTUM(sb+((sy+py)*ss+sx+px)*4).
            px=px+2.
        FIN-DUM.
        SI px<w TUNC
            DECLARA ls SICUT NUMERUS VALENS sb+((sy+py)*ss+sx+px)*4.
            DECLARA ld SICUT NUMERUS VALENS db+((dy+py)*ds+dx+px)*4.
            SCRIBE_OCTETUM_AB(ld,OCTETUS_AB(ls)).
            SCRIBE_OCTETUM_AB(ld+1,OCTETUS_AB(ls+1)).
            SCRIBE_OCTETUM_AB(ld+2,OCTETUS_AB(ls+2)).
            SCRIBE_OCTETUM_AB(ld+3,0).
        FIN-SI.
        py=py+1.
    FIN-DUM.
    REDDE GSVII_NOTA(destinatio).
FIN-FUNCTIO.

// Regionem SIMG nearest-neighbour in superficiem privatam cum alpha componit.
FUNCTIO GVIII_SIMG_REGIONEM_SCALA_S REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    ACCIPIT sx SICUT NUMERUS.
    ACCIPIT sy SICUT NUMERUS.
    ACCIPIT sw SICUT NUMERUS.
    ACCIPIT sh SICUT NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    ACCIPIT dw SICUT NUMERUS.
    ACCIPIT dh SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    SI superficies==0 || IR_VALIDUS(imago)==0 || sw<=0 || sh<=0 || dw<=0 || dh<=0 TUNC REDDE 0. FIN-SI.
    DECLARA iw SICUT NUMERUS VALENS IR_LATITUDO(imago).
    DECLARA ih SICUT NUMERUS VALENS IR_ALTITUDO(imago).
    SI sx<0 || sy<0 || sx+sw>iw || sy+sh>ih TUNC REDDE 0. FIN-SI.
    DECLARA surf_w SICUT NUMERUS VALENS CONTENTUM(superficies).
    DECLARA surf_h SICUT NUMERUS VALENS CONTENTUM(superficies+8).
    DECLARA ag SICUT NUMERUS VALENS GVIII_CLAMPA(alpha_globalis,0,255).
    SI ag==0 TUNC REDDE 1. FIN-SI.
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py<dh PERFICE
        DECLARA yy SICUT NUMERUS VALENS dy+py.
        SI yy>=0 && yy<surf_h TUNC
            DECLARA iy SICUT NUMERUS VALENS sy+py*sh/dh.
            SI iy>=sy+sh TUNC iy=sy+sh-1. FIN-SI.
            DECLARA px SICUT NUMERUS VALENS 0.
            DUM px<dw PERFICE
                DECLARA xx SICUT NUMERUS VALENS dx+px.
                SI xx>=0 && xx<surf_w TUNC
                    DECLARA ix SICUT NUMERUS VALENS sx+px*sw/dw.
                    SI ix>=sx+sw TUNC ix=sx+sw-1. FIN-SI.
                    DECLARA rgba SICUT NUMERUS VALENS IR_PIXEL_RGBA(imago,ix,iy).
                    DECLARA a SICUT NUMERUS VALENS ((rgba>>24)&255)*ag/255.
                    SI a>0 TUNC
                        DECLARA r SICUT NUMERUS VALENS rgba&255.
                        DECLARA g SICUT NUMERUS VALENS (rgba>>8)&255.
                        DECLARA b SICUT NUMERUS VALENS (rgba>>16)&255.
                        DECLARA c SICUT NUMERUS VALENS FV_COLOR(r,g,b).
                        DECLARA f SICUT NUMERUS VALENS GSVII_PIXEL_ALPHA(superficies,xx,yy,c,a).
                    FIN-SI.
                FIN-SI.
                px=px+1.
            FIN-DUM.
        FIN-SI.
        py=py+1.
    FIN-DUM.
    REDDE GSVII_NOTA(superficies).
FIN-FUNCTIO.

FUNCTIO GVIII_SIMG_SCALA_S REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    ACCIPIT dw SICUT NUMERUS.
    ACCIPIT dh SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    SI IR_VALIDUS(imago)==0 TUNC REDDE 0. FIN-SI.
    REDDE GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,0,0,IR_LATITUDO(imago),IR_ALTITUDO(imago),dx,dy,dw,dh,alpha_globalis).
FIN-FUNCTIO.

FUNCTIO GVIII_SIMG_NOVEM_PARTES_S REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    ACCIPIT m_sin SICUT NUMERUS.
    ACCIPIT m_sup SICUT NUMERUS.
    ACCIPIT m_dex SICUT NUMERUS.
    ACCIPIT m_inf SICUT NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    ACCIPIT dw SICUT NUMERUS.
    ACCIPIT dh SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    SI superficies==0 || IR_VALIDUS(imago)==0 TUNC REDDE 0. FIN-SI.
    DECLARA iw SICUT NUMERUS VALENS IR_LATITUDO(imago).
    DECLARA ih SICUT NUMERUS VALENS IR_ALTITUDO(imago).
    SI m_sin<0 || m_sup<0 || m_dex<0 || m_inf<0 TUNC REDDE 0. FIN-SI.
    SI m_sin+m_dex>=iw || m_sup+m_inf>=ih TUNC REDDE 0. FIN-SI.
    SI dw<m_sin+m_dex || dh<m_sup+m_inf TUNC REDDE 0. FIN-SI.
    DECLARA smw SICUT NUMERUS VALENS iw-m_sin-m_dex.
    DECLARA smh SICUT NUMERUS VALENS ih-m_sup-m_inf.
    DECLARA dmw SICUT NUMERUS VALENS dw-m_sin-m_dex.
    DECLARA dmh SICUT NUMERUS VALENS dh-m_sup-m_inf.
    DECLARA f SICUT NUMERUS VALENS 0.
    f=GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,0,0,m_sin,m_sup,dx,dy,m_sin,m_sup,alpha_globalis).
    f=GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,m_sin,0,smw,m_sup,dx+m_sin,dy,dmw,m_sup,alpha_globalis).
    f=GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,iw-m_dex,0,m_dex,m_sup,dx+dw-m_dex,dy,m_dex,m_sup,alpha_globalis).
    f=GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,0,m_sup,m_sin,smh,dx,dy+m_sup,m_sin,dmh,alpha_globalis).
    f=GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,m_sin,m_sup,smw,smh,dx+m_sin,dy+m_sup,dmw,dmh,alpha_globalis).
    f=GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,iw-m_dex,m_sup,m_dex,smh,dx+dw-m_dex,dy+m_sup,m_dex,dmh,alpha_globalis).
    f=GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,0,ih-m_inf,m_sin,m_inf,dx,dy+dh-m_inf,m_sin,m_inf,alpha_globalis).
    f=GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,m_sin,ih-m_inf,smw,m_inf,dx+m_sin,dy+dh-m_inf,dmw,m_inf,alpha_globalis).
    f=GVIII_SIMG_REGIONEM_SCALA_S(superficies,imago,iw-m_dex,ih-m_inf,m_dex,m_inf,dx+dw-m_dex,dy+dh-m_inf,m_dex,m_inf,alpha_globalis).
    REDDE GSVII_NOTA(superficies).
FIN-FUNCTIO.
