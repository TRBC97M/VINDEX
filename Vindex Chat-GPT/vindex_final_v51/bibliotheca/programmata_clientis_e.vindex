// Sylvia OS — PROGRAMMATA clientis Gradus E / P16-VI.
// Status et click intra contentum clientis sine ornamentis systematis.

FUNCTIO PE_CLICK REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT status SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    SI superficies == 0 TUNC REDDE status. FIN-SI.
    SI y >= 5 && y < 29 TUNC
        SI x >= 8 && x < 70 TUNC REDDE 2. FIN-SI.
        SI x >= 76 && x < 138 TUNC REDDE 3. FIN-SI.
        SI x >= 144 && x < 206 TUNC REDDE 4. FIN-SI.
        SI x >= 212 && x < 274 TUNC REDDE 5. FIN-SI.
    FIN-SI.
    SI x >= 154 && x < CONTENTUM(superficies) - 12 && y >= 48 && y < 164 TUNC
        REDDE 1.
    FIN-SI.
    REDDE status.
FIN-FUNCTIO.

FUNCTIO PE_RENDE REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT status SICUT NUMERUS.
    SI superficies == 0 TUNC REDDE 0. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(superficies).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(superficies + 8).
    DECLARA ebur SICUT NUMERUS VALENS FV_COLOR(241,238,228).
    DECLARA papyrus SICUT NUMERUS VALENS FV_COLOR(219,211,196).
    DECLARA charta SICUT NUMERUS VALENS FV_COLOR(249,247,240).
    DECLARA nox SICUT NUMERUS VALENS FV_COLOR(28,31,32).
    DECLARA lapis SICUT NUMERUS VALENS FV_COLOR(49,55,55).
    DECLARA chalybs SICUT NUMERUS VALENS FV_COLOR(92,99,96).
    DECLARA bronzeum SICUT NUMERUS VALENS FV_COLOR(185,138,82).
    DECLARA aes SICUT NUMERUS VALENS FV_COLOR(128,87,53).
    DECLARA viride SICUT NUMERUS VALENS FV_COLOR(71,118,111).
    DECLARA viride_pallidum SICUT NUMERUS VALENS FV_COLOR(219,229,221).
    DECLARA rubrum SICUT NUMERUS VALENS FV_COLOR(143,64,58).
    DECLARA f SICUT NUMERUS VALENS FS_RECT(superficies,0,0,w,h,ebur).

    // Instrumenta in papyro; actio activa aere, deletio rubro indicatur.
    f = FS_RECT(superficies,0,0,w,34,papyrus).
    f = FS_RECT(superficies,0,33,w,1,chalybs).
    DECLARA b1 SICUT NUMERUS VALENS charta.
    DECLARA b2 SICUT NUMERUS VALENS charta.
    DECLARA b3 SICUT NUMERUS VALENS charta.
    DECLARA b4 SICUT NUMERUS VALENS charta.
    SI status == 2 TUNC b1=bronzeum. FIN-SI.
    SI status == 3 TUNC b2=bronzeum. FIN-SI.
    SI status == 4 TUNC b3=bronzeum. FIN-SI.
    SI status == 5 TUNC b4=rubrum. FIN-SI.
    f = FS_RECT(superficies,8,5,62,24,b1).
    f = FS_TEXTUM(superficies,16,13,"NOVUM",nox).
    f = FS_RECT(superficies,76,5,62,24,b2).
    f = FS_TEXTUM(superficies,84,13,"EDITE",nox).
    f = FS_RECT(superficies,144,5,62,24,b3).
    f = FS_TEXTUM(superficies,152,13,"NOMEN",nox).
    f = FS_RECT(superficies,212,5,62,24,b4).
    f = FS_TEXTUM(superficies,220,13,"DELE",nox).

    // Columna locorum lapidea, card centralis eburnea.
    f = FS_RECT(superficies,0,34,142,h-34,papyrus).
    f = FS_TEXTUM(superficies,14,54,"LOCORUM",lapis).
    f = FS_RECT(superficies,10,72,122,22,charta).
    f = FS_RECT(superficies,10,72,3,22,viride).
    f = FS_TEXTUM(superficies,20,79,"PROGRAMMATA",nox).
    DECLARA card SICUT NUMERUS VALENS charta.
    SI status == 1 || status == 3 || status == 4 || status == 5 TUNC card=viride_pallidum. FIN-SI.
    f = FS_RECT(superficies,154,48,w-166,116,card).
    f = FS_RECT(superficies,154,48,w-166,2,viride).
    SI status == 1 || status == 3 || status == 4 || status == 5 TUNC
        f = FS_RECT(superficies,154,48,2,116,bronzeum).
    FIN-SI.

    // Pictogramma TABULAE e lapide et aere.
    f = FS_RECT(superficies,174,68,66,66,lapis).
    f = FS_RECT(superficies,184,78,46,46,papyrus).
    f = FS_RECT(superficies,189,83,16,14,bronzeum).
    f = FS_RECT(superficies,209,83,16,14,viride).
    f = FS_RECT(superficies,189,101,36,18,charta).
    f = FS_TEXTUM(superficies,254,82,"TABULA.VXNAT",nox).
    f = FS_TEXTUM(superficies,254,104,"APPLICATIO",viride).

    f = FS_RECT(superficies,154,178,w-166,h-188,papyrus).
    f = FS_RECT(superficies,154,178,w-166,1,chalybs).
    SI status == 0 TUNC f = FS_TEXTUM(superficies,168,194,"PARATUS",lapis). FIN-SI.
    SI status == 1 TUNC f = FS_TEXTUM(superficies,168,194,"SELECTUM: TABULA.VXNAT",nox). FIN-SI.
    SI status == 2 TUNC f = FS_TEXTUM(superficies,168,194,"NOVUM: CLIENTIS ACTIO",nox). FIN-SI.
    SI status == 3 TUNC f = FS_TEXTUM(superficies,168,194,"EDITE: TABULA.VXNAT",nox). FIN-SI.
    SI status == 4 TUNC f = FS_TEXTUM(superficies,168,194,"NOMEN: TABULA.VXNAT",nox). FIN-SI.
    SI status == 5 TUNC f = FS_TEXTUM(superficies,168,194,"DELE: CONFIRMATIO NECESSARIA",rubrum). FIN-SI.
    REDDE 1.
FIN-FUNCTIO.
