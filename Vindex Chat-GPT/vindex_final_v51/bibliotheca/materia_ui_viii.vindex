// Sylvia OS — Graphica VIII: materia rastera novem-partium pro componentibus JL-UX.
// Imago XXXII×XXXII RGBA8888 runtime creatur: anguli translucidi servantur,
// margines lumen aqua/ebur/aes accipiunt, centrum ad ivory-cool gradum descendit.

FUNCTIO MUIVIII_U32_PONE REDDENS NUMERUS.
    ACCIPIT locus SICUT NUMERUS. ACCIPIT valor SICUT NUMERUS.
    SCRIBE_OCTETUM_AB(locus,valor&255). SCRIBE_OCTETUM_AB(locus+1,(valor>>8)&255).
    SCRIBE_OCTETUM_AB(locus+2,(valor>>16)&255). SCRIBE_OCTETUM_AB(locus+3,(valor>>24)&255).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO MUIVIII_CREA REDDENS TEXTUS.
    DECLARA w SICUT NUMERUS VALENS 32. DECLARA h SICUT NUMERUS VALENS 32.
    DECLARA stride SICUT NUMERUS VALENS w*4.
    DECLARA mensura SICUT NUMERUS VALENS 24+stride*h.
    DECLARA d SICUT NUMERUS VALENS RESERVA_OCTETA(17+mensura).
    SI d<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(d)=mensura. CONTENTUM(d+8)=mensura.
    DECLARA out SICUT NUMERUS VALENS d+16.
    SCRIBE_OCTETUM_AB(out,83). SCRIBE_OCTETUM_AB(out+1,73). SCRIBE_OCTETUM_AB(out+2,77). SCRIBE_OCTETUM_AB(out+3,71).
    SCRIBE_OCTETUM_AB(out+4,1). SCRIBE_OCTETUM_AB(out+5,1). SCRIBE_OCTETUM_AB(out+6,0). SCRIBE_OCTETUM_AB(out+7,0).
    DECLARA z SICUT NUMERUS VALENS MUIVIII_U32_PONE(out+8,w).
    z=MUIVIII_U32_PONE(out+12,h). z=MUIVIII_U32_PONE(out+16,stride). z=MUIVIII_U32_PONE(out+20,0).

    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<h PERFICE
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x<w PERFICE
            DECLARA a SICUT NUMERUS VALENS 255.
            DECLARA r SICUT NUMERUS VALENS 236-(y*16/(h-1)).
            DECLARA g SICUT NUMERUS VALENS 242-(y*18/(h-1)).
            DECLARA b SICUT NUMERUS VALENS 239-(y*17/(h-1)).

            // Radius VIII: exterior angulorum translucet, annulus proximus anti-aliased est.
            DECLARA dx SICUT NUMERUS VALENS 0. DECLARA dy SICUT NUMERUS VALENS 0.
            SI x<8 TUNC dx=7-x. FIN-SI. SI x>=24 TUNC dx=x-24. FIN-SI.
            SI y<8 TUNC dy=7-y. FIN-SI. SI y>=24 TUNC dy=y-24. FIN-SI.
            SI dx>0 && dy>0 TUNC
                DECLARA d2 SICUT NUMERUS VALENS dx*dx+dy*dy.
                SI d2>=64 TUNC
                    a=0.
                ALITER
                    SI d2>=49 TUNC
                        a=(64-d2)*17.
                    FIN-SI.
                FIN-SI.
            FIN-SI.

            // Ora superior aquatica, inferior aenea, latera argentea.
            SI a>0 && y==0 TUNC r=184. g=232. b=230. FIN-SI.
            SI a>0 && y==1 TUNC r=213. g=245. b=242. FIN-SI.
            SI a>0 && y==31 TUNC r=181. g=137. b=82. FIN-SI.
            SI a>0 && (x==0 || x==31) && y>1 && y<31 TUNC r=169. g=180. b=178. FIN-SI.

            DECLARA p SICUT NUMERUS VALENS out+24+y*stride+x*4.
            SCRIBE_OCTETUM_AB(p,r). SCRIBE_OCTETUM_AB(p+1,g). SCRIBE_OCTETUM_AB(p+2,b). SCRIBE_OCTETUM_AB(p+3,a).
            x=x+1.
        FIN-DUM.
        y=y+1.
    FIN-DUM.
    REDDE d.
FIN-FUNCTIO.
