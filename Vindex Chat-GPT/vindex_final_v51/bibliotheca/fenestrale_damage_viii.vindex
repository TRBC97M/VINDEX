// Sylvia OS — Capacitas Graphica VIII: damnum / regiones invalidandae.
// d[0]=numerus; d[1+i]=rectum compactum GVIII. Capacitas calleris = 1+max_recta.
// Haec forma minus memoriae tangit et ABI VII argumentorum naturaliter servat.

FUNCTIO DVIII_INIT REDDENS NUMERUS.
    ACCIPIT d SICUT ORDO DE NUMERUS.
    d[0]=0. REDDE 1.
FIN-FUNCTIO.

FUNCTIO DVIII_NUMERUS REDDENS NUMERUS.
    ACCIPIT d SICUT ORDO DE NUMERUS.
    REDDE d[0].
FIN-FUNCTIO.

FUNCTIO DVIII_RECT REDDENS NUMERUS.
    ACCIPIT d SICUT ORDO DE NUMERUS. ACCIPIT i SICUT NUMERUS.
    SI i<0 || i>=d[0] TUNC REDDE 0. FIN-SI.
    REDDE d[1+i].
FIN-FUNCTIO.

FUNCTIO DVIII_X REDDENS NUMERUS. ACCIPIT d SICUT ORDO DE NUMERUS. ACCIPIT i SICUT NUMERUS. REDDE GVIII_RECT_X(DVIII_RECT(d,i)). FIN-FUNCTIO.
FUNCTIO DVIII_Y REDDENS NUMERUS. ACCIPIT d SICUT ORDO DE NUMERUS. ACCIPIT i SICUT NUMERUS. REDDE GVIII_RECT_Y(DVIII_RECT(d,i)). FIN-FUNCTIO.
FUNCTIO DVIII_W REDDENS NUMERUS. ACCIPIT d SICUT ORDO DE NUMERUS. ACCIPIT i SICUT NUMERUS. REDDE GVIII_RECT_W(DVIII_RECT(d,i)). FIN-FUNCTIO.
FUNCTIO DVIII_H REDDENS NUMERUS. ACCIPIT d SICUT ORDO DE NUMERUS. ACCIPIT i SICUT NUMERUS. REDDE GVIII_RECT_H(DVIII_RECT(d,i)). FIN-FUNCTIO.

FUNCTIO DVIII_PONE REDDENS NUMERUS.
    ACCIPIT d SICUT ORDO DE NUMERUS. ACCIPIT i SICUT NUMERUS. ACCIPIT rectum SICUT NUMERUS.
    SI i<0 || rectum==0 TUNC REDDE 0. FIN-SI.
    d[1+i]=rectum. REDDE 1.
FIN-FUNCTIO.

FUNCTIO DVIII_TANGUNT REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS. ACCIPIT b SICUT NUMERUS.
    SI a==0 || b==0 TUNC REDDE 0. FIN-SI.
    DECLARA ax SICUT NUMERUS VALENS GVIII_RECT_X(a). DECLARA ay SICUT NUMERUS VALENS GVIII_RECT_Y(a).
    DECLARA aw SICUT NUMERUS VALENS GVIII_RECT_W(a). DECLARA ah SICUT NUMERUS VALENS GVIII_RECT_H(a).
    DECLARA bx SICUT NUMERUS VALENS GVIII_RECT_X(b). DECLARA by SICUT NUMERUS VALENS GVIII_RECT_Y(b).
    DECLARA bw SICUT NUMERUS VALENS GVIII_RECT_W(b). DECLARA bh SICUT NUMERUS VALENS GVIII_RECT_H(b).
    // Contactus orarum quoque coalescit, ut fissurae unius pixeli non multiplicent redraw.
    SI ax+aw<bx TUNC REDDE 0. FIN-SI. SI bx+bw<ax TUNC REDDE 0. FIN-SI.
    SI ay+ah<by TUNC REDDE 0. FIN-SI. SI by+bh<ay TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO DVIII_UNIO REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS. ACCIPIT b SICUT NUMERUS.
    SI a==0 TUNC REDDE b. FIN-SI. SI b==0 TUNC REDDE a. FIN-SI.
    DECLARA x0 SICUT NUMERUS VALENS GVIII_MIN(GVIII_RECT_X(a),GVIII_RECT_X(b)).
    DECLARA y0 SICUT NUMERUS VALENS GVIII_MIN(GVIII_RECT_Y(a),GVIII_RECT_Y(b)).
    DECLARA x1 SICUT NUMERUS VALENS GVIII_MAX(GVIII_RECT_X(a)+GVIII_RECT_W(a),GVIII_RECT_X(b)+GVIII_RECT_W(b)).
    DECLARA y1 SICUT NUMERUS VALENS GVIII_MAX(GVIII_RECT_Y(a)+GVIII_RECT_H(a),GVIII_RECT_Y(b)+GVIII_RECT_H(b)).
    REDDE GVIII_RECT_CREA(x0,y0,x1-x0,y1-y0).
FIN-FUNCTIO.

FUNCTIO DVIII_REMOVE REDDENS NUMERUS.
    ACCIPIT d SICUT ORDO DE NUMERUS. ACCIPIT i SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS d[0].
    SI i<0 || i>=n TUNC REDDE 0. FIN-SI.
    DECLARA j SICUT NUMERUS VALENS i.
    DUM j<n-1 PERFICE d[1+j]=d[1+j+1]. j=j+1. FIN-DUM.
    d[0]=n-1. REDDE 1.
FIN-FUNCTIO.

FUNCTIO DVIII_COLLAPSA REDDENS NUMERUS.
    ACCIPIT d SICUT ORDO DE NUMERUS.
    SI d[0]<=1 TUNC REDDE 1. FIN-SI.
    DECLARA totum SICUT NUMERUS VALENS d[1].
    DECLARA i SICUT NUMERUS VALENS 1.
    DUM i<d[0] PERFICE totum=DVIII_UNIO(totum,d[1+i]). i=i+1. FIN-DUM.
    d[0]=1. d[1]=totum. REDDE 1.
FIN-FUNCTIO.

// Addit rectum post clipping ad limen. Regiones tangentia iteratim coalescuntur.
FUNCTIO DVIII_ADDE REDDENS NUMERUS.
    ACCIPIT d SICUT ORDO DE NUMERUS. ACCIPIT max_recta SICUT NUMERUS. ACCIPIT rectum SICUT NUMERUS. ACCIPIT limen SICUT NUMERUS.
    SI max_recta<1 || rectum==0 || limen==0 TUNC REDDE 0. FIN-SI.
    DECLARA novum SICUT NUMERUS VALENS GVIII_RECT_SECA(rectum,limen).
    SI novum==0 TUNC REDDE 1. FIN-SI.

    DECLARA mutatum SICUT NUMERUS VALENS 1.
    DUM mutatum!=0 PERFICE
        mutatum=0.
        DECLARA i SICUT NUMERUS VALENS 0.
        DUM i<d[0] PERFICE
            SI DVIII_TANGUNT(novum,d[1+i])!=0 TUNC
                novum=DVIII_UNIO(novum,d[1+i]).
                DECLARA rm SICUT NUMERUS VALENS DVIII_REMOVE(d,i).
                mutatum=1. i=d[0].
            ALITER i=i+1. FIN-SI.
        FIN-DUM.
    FIN-DUM.

    SI d[0]<max_recta TUNC
        d[1+d[0]]=novum. d[0]=d[0]+1. REDDE 1.
    FIN-SI.

    // Saturatio: correctness ante micro-optimisationem — unum bounding rect tutum.
    DECLARA totum SICUT NUMERUS VALENS novum.
    DECLARA k SICUT NUMERUS VALENS 0.
    DUM k<d[0] PERFICE totum=DVIII_UNIO(totum,d[1+k]). k=k+1. FIN-DUM.
    d[0]=1. d[1]=totum. REDDE 1.
FIN-FUNCTIO.

FUNCTIO DVIII_ADDE_FB REDDENS NUMERUS.
    ACCIPIT d SICUT ORDO DE NUMERUS. ACCIPIT max_recta SICUT NUMERUS. ACCIPIT rectum SICUT NUMERUS.
    DECLARA limen SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,CONTENTUM(50333728),CONTENTUM(50333736)).
    REDDE DVIII_ADDE(d,max_recta,rectum,limen).
FIN-FUNCTIO.

FUNCTIO DVIII_AREA REDDENS NUMERUS.
    ACCIPIT d SICUT ORDO DE NUMERUS.
    DECLARA area SICUT NUMERUS VALENS 0. DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<d[0] PERFICE area=area+GVIII_RECT_W(d[1+i])*GVIII_RECT_H(d[1+i]). i=i+1. FIN-DUM.
    REDDE area.
FIN-FUNCTIO.
