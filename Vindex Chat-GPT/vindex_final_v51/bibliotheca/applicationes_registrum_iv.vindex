// Sylvia OS — registrum dynamicum applicationum P16-IV.
// Unus catalogus INITIUM, bureau et fenestras de applicationibus informat.
// Registrum: numerus, primus, ultimus.
// Nodus: id, cliens, genus, nomen TEXTUS, in_bureau, proximus.

FUNCTIO AI_TEXTUS_SEDES REDDENS NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    REDDE textus.
FIN-FUNCTIO.

FUNCTIO AI_TEXTUS_EX_SEDE REDDENS TEXTUS.
    ACCIPIT sedes SICUT NUMERUS.
    REDDE sedes.
FIN-FUNCTIO.

FUNCTIO AI_CREA REDDENS NUMERUS.
    DECLARA registrum SICUT NUMERUS VALENS RESERVA_OCTETA(24).
    SI registrum<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(registrum)=0.
    CONTENTUM(registrum+8)=0.
    CONTENTUM(registrum+16)=0.
    REDDE registrum.
FIN-FUNCTIO.

FUNCTIO AI_NUMERUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(registrum).
FIN-FUNCTIO.

FUNCTIO AI_PRIMUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(registrum+8).
FIN-FUNCTIO.

FUNCTIO AI_ULTIMUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(registrum+16).
FIN-FUNCTIO.

FUNCTIO AI_PROXIMUS REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus==0 TUNC REDDE 0. FIN-SI.
    // SONDA P16-XI TEMPORARIA: dichotomia, unus nodus tantum.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO AI_QUAERE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    SI registrum==0 || id<=0 TUNC REDDE 0. FIN-SI.
    DECLARA nodus SICUT NUMERUS VALENS CONTENTUM(registrum+8).
    DUM nodus!=0 PERFICE
        SI CONTENTUM(nodus)==id TUNC REDDE nodus. FIN-SI.
        nodus=CONTENTUM(nodus+40).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO AI_CLIENTIS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT cliens SICUT NUMERUS.
    SI registrum==0 || cliens<=0 TUNC REDDE 0. FIN-SI.
    DECLARA nodus SICUT NUMERUS VALENS CONTENTUM(registrum+8).
    DUM nodus!=0 PERFICE
        SI CONTENTUM(nodus+8)==cliens TUNC REDDE nodus. FIN-SI.
        nodus=CONTENTUM(nodus+40).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO AI_ADDE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT cliens SICUT NUMERUS.
    ACCIPIT genus SICUT NUMERUS.
    ACCIPIT nomen SICUT TEXTUS.
    ACCIPIT in_bureau SICUT NUMERUS.
    SI registrum==0 || cliens<=0 || AI_TEXTUS_SEDES(nomen)==0 TUNC REDDE 0. FIN-SI.
    SI AI_CLIENTIS(registrum,cliens)!=0 TUNC REDDE 0. FIN-SI.
    DECLARA nodus SICUT NUMERUS VALENS RESERVA_OCTETA(48).
    SI nodus<=0 TUNC REDDE 0. FIN-SI.
    DECLARA id SICUT NUMERUS VALENS CONTENTUM(registrum)+1.
    DECLARA ultimus SICUT NUMERUS VALENS CONTENTUM(registrum+16).
    CONTENTUM(nodus)=id.
    CONTENTUM(nodus+8)=cliens.
    CONTENTUM(nodus+16)=genus.
    CONTENTUM(nodus+24)=AI_TEXTUS_SEDES(nomen).
    CONTENTUM(nodus+32)=0.
    SI in_bureau!=0 TUNC CONTENTUM(nodus+32)=1. FIN-SI.
    CONTENTUM(nodus+40)=0.
    SI ultimus!=0 TUNC CONTENTUM(ultimus+40)=nodus. ALITER CONTENTUM(registrum+8)=nodus. FIN-SI.
    CONTENTUM(registrum+16)=nodus.
    CONTENTUM(registrum)=id.
    REDDE id.
FIN-FUNCTIO.

FUNCTIO AI_NODUS_ID REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(nodus).
FIN-FUNCTIO.

FUNCTIO AI_NODUS_CLIENTE REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(nodus+8).
FIN-FUNCTIO.

FUNCTIO AI_NODUS_GENUS REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(nodus+16).
FIN-FUNCTIO.

FUNCTIO AI_NODUS_NOMEN REDDENS TEXTUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus==0 TUNC REDDE 0. FIN-SI.
    REDDE AI_TEXTUS_EX_SEDE(CONTENTUM(nodus+24)).
FIN-FUNCTIO.

FUNCTIO AI_NODUS_IN_BUREAU REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(nodus+32).
FIN-FUNCTIO.

FUNCTIO AI_CLIENTE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    REDDE AI_NODUS_CLIENTE(AI_QUAERE(registrum,id)).
FIN-FUNCTIO.

FUNCTIO AI_GENUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    REDDE AI_NODUS_GENUS(AI_QUAERE(registrum,id)).
FIN-FUNCTIO.

FUNCTIO AI_NOMEN REDDENS TEXTUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    REDDE AI_NODUS_NOMEN(AI_QUAERE(registrum,id)).
FIN-FUNCTIO.

FUNCTIO AI_IN_BUREAU REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    REDDE AI_NODUS_IN_BUREAU(AI_QUAERE(registrum,id)).
FIN-FUNCTIO.
