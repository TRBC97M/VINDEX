// Sylvia OS — dispatchus clientium Fenestralis Purus I / P17-II / P18-I.
// Eventa ad clientes per registrum clientium et registrum fenestrarum traduntur.
// Genus eventus: 1 = clic; 2 = clavis ad clientem focalem, cum scan et Unicode.

FUNCTIO CI_EVENTA_AGE REDDENS NUMERUS.
    ACCIPIT clientes SICUT NUMERUS.
    ACCIPIT fenestrae SICUT NUMERUS.
    ACCIPIT coda SICUT NUMERUS.
    SI clientes==0 || fenestrae==0 || coda==0 TUNC REDDE 0. FIN-SI.
    DECLARA mutata SICUT NUMERUS VALENS 0.
    DUM EG_NUMERUS(coda)>0 PERFICE
        DECLARA e SICUT ORDO DE NUMERUS CAPACITAS 5.
        DECLARA captum SICUT NUMERUS VALENS EG_CAPE(coda,e).
        SI captum==0 TUNC REDDE mutata. FIN-SI.
        DECLARA cliens SICUT NUMERUS VALENS e[1].
        DECLARA nodus SICUT NUMERUS VALENS CH_QUAERE(clientes,cliens).
        DECLARA fenestra SICUT NUMERUS VALENS FI_CLIENTIS(fenestrae,cliens).
        SI nodus!=0 && fenestra!=0 && FI_STATUS(fenestrae,fenestra)==0 TUNC
            DECLARA genus SICUT NUMERUS VALENS CONTENTUM(nodus+8).
            DECLARA superficies SICUT NUMERUS VALENS CONTENTUM(nodus+16).
            DECLARA status SICUT NUMERUS VALENS CONTENTUM(nodus+24).
            SI e[0]==1 && genus==1 TUNC
                DECLARA novus_p SICUT NUMERUS VALENS PE_CLICK(superficies,status,e[2],e[3]).
                SI novus_p!=status TUNC
                    CONTENTUM(nodus+24)=novus_p.
                    DECLARA rp SICUT NUMERUS VALENS PE_RENDE(superficies,novus_p).
                    mutata=mutata+1.
                FIN-SI.
            FIN-SI.
            SI e[0]==1 && genus==2 TUNC
                DECLARA novus_t SICUT NUMERUS VALENS TF_CLICK(superficies,status,e[2],e[3]).
                SI novus_t!=status TUNC
                    CONTENTUM(nodus+24)=novus_t.
                    DECLARA rt SICUT NUMERUS VALENS TF_RENDE(superficies,novus_t).
                    mutata=mutata+1.
                FIN-SI.
            FIN-SI.
            SI e[0]==2 && genus==3 TUNC
                DECLARA mutatum_e SICUT NUMERUS VALENS TE_CLAVIS_EVENTUM(status,e[2],e[4]).
                SI mutatum_e!=0 TUNC
                    DECLARA re SICUT NUMERUS VALENS TE_RENDE(superficies,status).
                    mutata=mutata+1.
                FIN-SI.
            FIN-SI.
            SI e[0]==2 && genus==4 TUNC
                DECLARA mutatum_o SICUT NUMERUS VALENS OE_CLAVIS_EVENTUM(status,e[2],e[4]).
                SI mutatum_o!=0 TUNC
                    DECLARA ro SICUT NUMERUS VALENS OE_RENDE(superficies,status).
                    mutata=mutata+1.
                FIN-SI.
            FIN-SI.
        FIN-SI.
    FIN-DUM.
    REDDE mutata.
FIN-FUNCTIO.
