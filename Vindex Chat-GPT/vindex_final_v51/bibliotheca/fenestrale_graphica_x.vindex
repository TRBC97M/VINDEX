// Sylvia OS — P16-XII / Graphica X: fundamentum compositoris moderni.
// Superficies GX_* RGBA canonico praemultiplicato servantur.
// FS_* historicae clientium non mutantur: migratio potest fieri gradatim.
// GVIII_* et GVII_* ante hoc folium importentur.
//
// Descriptor XCVI octeta:
//  0 w, 8 h, 16 stride, 24 pixela,
// 32 damnum x, 40 y, 48 w, 56 h,
// 64 vexillum damni, 72 generatio, 80 backend memoriae, 88 capacitas octetorum.
// Backend 0: acervus VINDEX historicus; backend 1: piscina UEFI liberabilis;
// backend 2: memoria externa adoptata, cuius dominium apud vocatorem manet.

FUNCTIO GX_MEM_PURA REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    SI basis==0 || n<=0 TUNC REDDE 0. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i+8<=n PERFICE
        CONTENTUM(basis+i)=0.
        i=i+8.
    FIN-DUM.
    DUM i<n PERFICE
        SCRIBE_OCTETUM_AB(basis+i,0).
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_CREA REDDENS NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI w<=0 || h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA caput SICUT NUMERUS VALENS RESERVA_OCTETA(96).
    SI caput<=0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS w*h*4.
    DECLARA pix SICUT NUMERUS VALENS RESERVA_OCTETA(n).
    SI pix<=0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(caput,96).
    f=GX_MEM_PURA(pix,n).
    CONTENTUM(caput)=w.
    CONTENTUM(caput+8)=h.
    CONTENTUM(caput+16)=w.
    CONTENTUM(caput+24)=pix.
    CONTENTUM(caput+72)=1.
    CONTENTUM(caput+80)=0.
    CONTENTUM(caput+88)=n.
    REDDE caput.
FIN-FUNCTIO.

FUNCTIO GX_ADOPTA REDDENS NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT stride SICUT NUMERUS.
    ACCIPIT pix SICUT NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    SI w<=0 || h<=0 || stride<w || pix==0 || capacitas<=0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS stride*h*4.
    SI n<=0 || n>capacitas TUNC REDDE 0. FIN-SI.
    DECLARA caput SICUT NUMERUS VALENS RESERVA_OCTETA(96).
    SI caput<=0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(caput,96).
    CONTENTUM(caput)=w. CONTENTUM(caput+8)=h. CONTENTUM(caput+16)=stride.
    CONTENTUM(caput+24)=pix. CONTENTUM(caput+72)=1.
    CONTENTUM(caput+80)=2. CONTENTUM(caput+88)=capacitas.
    REDDE caput.
FIN-FUNCTIO.

FUNCTIO GX_UEFI_ALLOCA REDDENS NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    SI n<=0 TUNC REDDE 0. FIN-SI.
    DECLARA systema SICUT NUMERUS VALENS CONTENTUM(50333704).
    SI systema==0 TUNC REDDE 0. FIN-SI.
    DECLARA officia SICUT NUMERUS VALENS CONTENTUM(systema+96).
    SI officia==0 TUNC REDDE 0. FIN-SI.
    DECLARA alloca SICUT NUMERUS VALENS CONTENTUM(officia+64).
    SI alloca==0 TUNC REDDE 0. FIN-SI.
    DECLARA locus SICUT ORDO DE NUMERUS CAPACITAS 1.
    locus[0]=0.
    DECLARA status SICUT NUMERUS VALENS UEFI_VOCA6(alloca,2,n,SEDES(locus),0,0,0).
    SI status!=0 TUNC REDDE 0. FIN-SI.
    REDDE locus[0].
FIN-FUNCTIO.

FUNCTIO GX_UEFI_LIBERA REDDENS NUMERUS.
    ACCIPIT p SICUT NUMERUS.
    SI p==0 TUNC REDDE 1. FIN-SI.
    DECLARA systema SICUT NUMERUS VALENS CONTENTUM(50333704).
    SI systema==0 TUNC REDDE 0. FIN-SI.
    DECLARA officia SICUT NUMERUS VALENS CONTENTUM(systema+96).
    SI officia==0 TUNC REDDE 0. FIN-SI.
    DECLARA libera SICUT NUMERUS VALENS CONTENTUM(officia+72).
    SI libera==0 TUNC REDDE 0. FIN-SI.
    DECLARA status SICUT NUMERUS VALENS UEFI_VOCA6(libera,p,0,0,0,0,0).
    SI status!=0 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_CREA_UEFI REDDENS NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI w<=0 || h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA caput SICUT NUMERUS VALENS RESERVA_OCTETA(96).
    SI caput<=0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS w*h*4.
    DECLARA pix SICUT NUMERUS VALENS GX_UEFI_ALLOCA(n).
    SI pix==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(caput,96).
    f=GX_MEM_PURA(pix,n).
    CONTENTUM(caput)=w. CONTENTUM(caput+8)=h. CONTENTUM(caput+16)=w.
    CONTENTUM(caput+24)=pix. CONTENTUM(caput+72)=1.
    CONTENTUM(caput+80)=1. CONTENTUM(caput+88)=n.
    REDDE caput.
FIN-FUNCTIO.

FUNCTIO GX_REFORMA_UEFI REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI s==0 || w<=0 || h<=0 || CONTENTUM(s+80)!=1 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS w*h*4.
    DECLARA pix SICUT NUMERUS VALENS CONTENTUM(s+24).
    SI CONTENTUM(s+88)<n TUNC
        DECLARA novum SICUT NUMERUS VALENS GX_UEFI_ALLOCA(n).
        SI novum==0 TUNC REDDE 0. FIN-SI.
        DECLARA liberatum SICUT NUMERUS VALENS GX_UEFI_LIBERA(pix).
        SI liberatum==0 TUNC DECLARA ig SICUT NUMERUS VALENS GX_UEFI_LIBERA(novum). REDDE 0. FIN-SI.
        pix=novum. CONTENTUM(s+24)=pix. CONTENTUM(s+88)=n.
    FIN-SI.
    DECLARA purum SICUT NUMERUS VALENS GX_MEM_PURA(pix,n).
    CONTENTUM(s)=w. CONTENTUM(s+8)=h. CONTENTUM(s+16)=w.
    CONTENTUM(s+32)=0. CONTENTUM(s+40)=0. CONTENTUM(s+48)=0. CONTENTUM(s+56)=0.
    CONTENTUM(s+64)=0. CONTENTUM(s+72)=CONTENTUM(s+72)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_LIBERA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI s==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(s+80)==2 TUNC
        CONTENTUM(s)=0. CONTENTUM(s+8)=0. CONTENTUM(s+16)=0. CONTENTUM(s+24)=0.
        CONTENTUM(s+64)=0. CONTENTUM(s+80)=0. CONTENTUM(s+88)=0.
        REDDE 1.
    FIN-SI.
    SI CONTENTUM(s+80)!=1 TUNC REDDE 0. FIN-SI.
    DECLARA pix SICUT NUMERUS VALENS CONTENTUM(s+24).
    SI GX_UEFI_LIBERA(pix)==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(s)=0. CONTENTUM(s+8)=0. CONTENTUM(s+16)=0. CONTENTUM(s+24)=0.
    CONTENTUM(s+64)=0. CONTENTUM(s+80)=0. CONTENTUM(s+88)=0.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_W REDDENS NUMERUS. ACCIPIT s SICUT NUMERUS. SI s==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(s). FIN-FUNCTIO.
FUNCTIO GX_H REDDENS NUMERUS. ACCIPIT s SICUT NUMERUS. SI s==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(s+8). FIN-FUNCTIO.
FUNCTIO GX_BASIS REDDENS NUMERUS. ACCIPIT s SICUT NUMERUS. SI s==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(s+24). FIN-FUNCTIO.

FUNCTIO GX_DAMNA_PURA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI s==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(s+64)=0.
    CONTENTUM(s+32)=0. CONTENTUM(s+40)=0.
    CONTENTUM(s+48)=0. CONTENTUM(s+56)=0.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_DAMNA_NOTA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI s==0 || r==0 TUNC REDDE 0. FIN-SI.
    DECLARA limen SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,GX_W(s),GX_H(s)).
    DECLARA q SICUT NUMERUS VALENS GVIII_RECT_SECA(r,limen).
    SI q==0 TUNC REDDE 0. FIN-SI.
    DECLARA x SICUT NUMERUS VALENS GVIII_RECT_X(q).
    DECLARA y SICUT NUMERUS VALENS GVIII_RECT_Y(q).
    DECLARA w SICUT NUMERUS VALENS GVIII_RECT_W(q).
    DECLARA h SICUT NUMERUS VALENS GVIII_RECT_H(q).
    SI CONTENTUM(s+64)==0 TUNC
        CONTENTUM(s+32)=x. CONTENTUM(s+40)=y.
        CONTENTUM(s+48)=w. CONTENTUM(s+56)=h.
        CONTENTUM(s+64)=1.
        CONTENTUM(s+72)=CONTENTUM(s+72)+1.
        REDDE 1.
    FIN-SI.
    DECLARA ax SICUT NUMERUS VALENS CONTENTUM(s+32).
    DECLARA ay SICUT NUMERUS VALENS CONTENTUM(s+40).
    DECLARA aw SICUT NUMERUS VALENS CONTENTUM(s+48).
    DECLARA ah SICUT NUMERUS VALENS CONTENTUM(s+56).
    DECLARA x0 SICUT NUMERUS VALENS GVIII_MIN(ax,x).
    DECLARA y0 SICUT NUMERUS VALENS GVIII_MIN(ay,y).
    DECLARA x1 SICUT NUMERUS VALENS GVIII_MAX(ax+aw,x+w).
    DECLARA y1 SICUT NUMERUS VALENS GVIII_MAX(ay+ah,y+h).
    CONTENTUM(s+32)=x0. CONTENTUM(s+40)=y0.
    CONTENTUM(s+48)=x1-x0. CONTENTUM(s+56)=y1-y0.
    CONTENTUM(s+72)=CONTENTUM(s+72)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_DAMNA_RECT REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI s==0 || CONTENTUM(s+64)==0 TUNC REDDE 0. FIN-SI.
    REDDE GVIII_RECT_CREA(CONTENTUM(s+32),CONTENTUM(s+40),CONTENTUM(s+48),CONTENTUM(s+56)).
FIN-FUNCTIO.

FUNCTIO GX_PIX_PM_LEGE REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    SI s==0 || x<0 || y<0 || x>=GX_W(s) || y>=GX_H(s) TUNC REDDE -1. FIN-SI.
    DECLARA p SICUT NUMERUS VALENS GX_BASIS(s)+(y*CONTENTUM(s+16)+x)*4.
    REDDE OCTETUS_AB(p)|(OCTETUS_AB(p+1)<<8)|(OCTETUS_AB(p+2)<<16)|(OCTETUS_AB(p+3)<<24).
FIN-FUNCTIO.

FUNCTIO GX_PIX_PM_PONE REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT q SICUT NUMERUS.
    SI s==0 || x<0 || y<0 || x>=GX_W(s) || y>=GX_H(s) TUNC REDDE 0. FIN-SI.
    DECLARA p SICUT NUMERUS VALENS GX_BASIS(s)+(y*CONTENTUM(s+16)+x)*4.
    SCRIBE_OCTETUM_AB(p,q&255).
    SCRIBE_OCTETUM_AB(p+1,(q>>8)&255).
    SCRIBE_OCTETUM_AB(p+2,(q>>16)&255).
    SCRIBE_OCTETUM_AB(p+3,(q>>24)&255).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_PIX_PONE REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    DECLARA a SICUT NUMERUS VALENS GVIII_CLAMPA(alpha,0,255).
    SI s==0 || x<0 || y<0 || x>=GX_W(s) || y>=GX_H(s) TUNC REDDE 0. FIN-SI.
    DECLARA r SICUT NUMERUS VALENS (color&255)*a/255.
    DECLARA g SICUT NUMERUS VALENS ((color>>8)&255)*a/255.
    DECLARA b SICUT NUMERUS VALENS ((color>>16)&255)*a/255.
    DECLARA f SICUT NUMERUS VALENS GX_PIX_PM_PONE(s,x,y,r|(g<<8)|(b<<16)|(a<<24)).
    f=GX_DAMNA_NOTA(s,GVIII_RECT_CREA(x,y,1,1)).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_PM_SUPER REDDENS NUMERUS.
    ACCIPIT sub SICUT NUMERUS.
    ACCIPIT sup SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    DECLARA ag SICUT NUMERUS VALENS GVIII_CLAMPA(alpha_globalis,0,255).
    DECLARA sa SICUT NUMERUS VALENS ((sup>>24)&255)*ag/255.
    DECLARA sr SICUT NUMERUS VALENS (sup&255)*ag/255.
    DECLARA sg SICUT NUMERUS VALENS ((sup>>8)&255)*ag/255.
    DECLARA sb SICUT NUMERUS VALENS ((sup>>16)&255)*ag/255.
    DECLARA da SICUT NUMERUS VALENS (sub>>24)&255.
    DECLARA dr SICUT NUMERUS VALENS sub&255.
    DECLARA dg SICUT NUMERUS VALENS (sub>>8)&255.
    DECLARA db SICUT NUMERUS VALENS (sub>>16)&255.
    DECLARA inv SICUT NUMERUS VALENS 255-sa.
    DECLARA oa SICUT NUMERUS VALENS sa+da*inv/255.
    DECLARA orr SICUT NUMERUS VALENS sr+dr*inv/255.
    DECLARA og SICUT NUMERUS VALENS sg+dg*inv/255.
    DECLARA ob SICUT NUMERUS VALENS sb+db*inv/255.
    SI orr>255 TUNC orr=255. FIN-SI. SI og>255 TUNC og=255. FIN-SI. SI ob>255 TUNC ob=255. FIN-SI. SI oa>255 TUNC oa=255. FIN-SI.
    REDDE orr|(og<<8)|(ob<<16)|(oa<<24).
FIN-FUNCTIO.

FUNCTIO GX_RECT_ALPHA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    SI s==0 || rectum==0 || alpha<=0 TUNC REDDE 0. FIN-SI.
    DECLARA limen SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,GX_W(s),GX_H(s)).
    DECLARA q SICUT NUMERUS VALENS GVIII_RECT_SECA(rectum,limen).
    SI q==0 TUNC REDDE 0. FIN-SI.
    DECLARA a SICUT NUMERUS VALENS GVIII_CLAMPA(alpha,0,255).
    DECLARA sr SICUT NUMERUS VALENS (color&255)*a/255.
    DECLARA sg SICUT NUMERUS VALENS ((color>>8)&255)*a/255.
    DECLARA sb SICUT NUMERUS VALENS ((color>>16)&255)*a/255.
    DECLARA sup SICUT NUMERUS VALENS sr|(sg<<8)|(sb<<16)|(a<<24).
    DECLARA x0 SICUT NUMERUS VALENS GVIII_RECT_X(q). DECLARA y0 SICUT NUMERUS VALENS GVIII_RECT_Y(q).
    DECLARA x1 SICUT NUMERUS VALENS x0+GVIII_RECT_W(q). DECLARA y1 SICUT NUMERUS VALENS y0+GVIII_RECT_H(q).
    DECLARA y SICUT NUMERUS VALENS y0.
    DUM y<y1 PERFICE
        DECLARA x SICUT NUMERUS VALENS x0.
        DUM x<x1 PERFICE
            DECLARA sub SICUT NUMERUS VALENS GX_PIX_PM_LEGE(s,x,y).
            DECLARA f SICUT NUMERUS VALENS GX_PIX_PM_PONE(s,x,y,GX_PM_SUPER(sub,sup,255)).
            x=x+1.
        FIN-DUM.
        y=y+1.
    FIN-DUM.
    REDDE GX_DAMNA_NOTA(s,q).
FIN-FUNCTIO.

FUNCTIO GX_COMPOSITA_S REDDENS NUMERUS.
    ACCIPIT dst SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    SI dst==0 || src==0 || alpha_globalis<=0 TUNC REDDE 0. FIN-SI.
    DECLARA sw SICUT NUMERUS VALENS GX_W(src). DECLARA sh SICUT NUMERUS VALENS GX_H(src).
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<sh PERFICE
        DECLARA yy SICUT NUMERUS VALENS dy+y.
        SI yy>=0 && yy<GX_H(dst) TUNC
            DECLARA x SICUT NUMERUS VALENS 0.
            DUM x<sw PERFICE
                DECLARA xx SICUT NUMERUS VALENS dx+x.
                SI xx>=0 && xx<GX_W(dst) TUNC
                    DECLARA sup SICUT NUMERUS VALENS GX_PIX_PM_LEGE(src,x,y).
                    SI ((sup>>24)&255)>0 TUNC
                        DECLARA sub SICUT NUMERUS VALENS GX_PIX_PM_LEGE(dst,xx,yy).
                        DECLARA f SICUT NUMERUS VALENS GX_PIX_PM_PONE(dst,xx,yy,GX_PM_SUPER(sub,sup,alpha_globalis)).
                    FIN-SI.
                FIN-SI.
                x=x+1.
            FIN-DUM.
        FIN-SI.
        y=y+1.
    FIN-DUM.
    REDDE GX_DAMNA_NOTA(dst,GVIII_RECT_CREA(dx,dy,sw,sh)).
FIN-FUNCTIO.

FUNCTIO GX_REGION_COPIA REDDENS NUMERUS.
    ACCIPIT dst SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT src_rect SICUT NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    SI dst==0 || src==0 || src_rect==0 TUNC REDDE 0. FIN-SI.
    DECLARA sx0 SICUT NUMERUS VALENS GVIII_RECT_X(src_rect). DECLARA sy0 SICUT NUMERUS VALENS GVIII_RECT_Y(src_rect).
    DECLARA sw SICUT NUMERUS VALENS GVIII_RECT_W(src_rect). DECLARA sh SICUT NUMERUS VALENS GVIII_RECT_H(src_rect).
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<sh PERFICE
        DECLARA yy SICUT NUMERUS VALENS dy+y.
        DECLARA sy SICUT NUMERUS VALENS sy0+y.
        SI yy>=0 && yy<GX_H(dst) && sy>=0 && sy<GX_H(src) TUNC
            DECLARA x SICUT NUMERUS VALENS 0.
            SI dx>=0 && dx+sw<=GX_W(dst) && sx0>=0 && sx0+sw<=GX_W(src) TUNC
                DUM x+1<sw PERFICE
                    DECLARA xx SICUT NUMERUS VALENS dx+x. DECLARA sx SICUT NUMERUS VALENS sx0+x.
                    DECLARA sp SICUT NUMERUS VALENS GX_BASIS(src)+(sy*CONTENTUM(src+16)+sx)*4.
                    DECLARA dp SICUT NUMERUS VALENS GX_BASIS(dst)+(yy*CONTENTUM(dst+16)+xx)*4.
                    CONTENTUM(dp)=CONTENTUM(sp).
                    x=x+2.
                FIN-DUM.
                SI x<sw TUNC DECLARA f1 SICUT NUMERUS VALENS GX_PIX_PM_PONE(dst,dx+x,yy,GX_PIX_PM_LEGE(src,sx0+x,sy)). FIN-SI.
            ALITER
                DUM x<sw PERFICE
                    DECLARA xx1 SICUT NUMERUS VALENS dx+x. DECLARA sx1 SICUT NUMERUS VALENS sx0+x.
                    SI xx1>=0 && xx1<GX_W(dst) && sx1>=0 && sx1<GX_W(src) TUNC DECLARA f2 SICUT NUMERUS VALENS GX_PIX_PM_PONE(dst,xx1,yy,GX_PIX_PM_LEGE(src,sx1,sy)). FIN-SI.
                    x=x+1.
                FIN-DUM.
            FIN-SI.
        FIN-SI.
        y=y+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_REGION_COMPONE REDDENS NUMERUS.
    ACCIPIT dst SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT src_rect SICUT NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    SI dst==0 || src==0 || src_rect==0 || alpha_globalis<=0 TUNC REDDE 0. FIN-SI.
    DECLARA sx0 SICUT NUMERUS VALENS GVIII_RECT_X(src_rect). DECLARA sy0 SICUT NUMERUS VALENS GVIII_RECT_Y(src_rect).
    DECLARA sw SICUT NUMERUS VALENS GVIII_RECT_W(src_rect). DECLARA sh SICUT NUMERUS VALENS GVIII_RECT_H(src_rect).
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<sh PERFICE
        DECLARA yy SICUT NUMERUS VALENS dy+y. DECLARA sy SICUT NUMERUS VALENS sy0+y.
        SI yy>=0 && yy<GX_H(dst) && sy>=0 && sy<GX_H(src) TUNC
            DECLARA x SICUT NUMERUS VALENS 0.
            SI dx>=0 && dx+sw<=GX_W(dst) && sx0>=0 && sx0+sw<=GX_W(src) TUNC
                DUM x+1<sw PERFICE
                    DECLARA xx SICUT NUMERUS VALENS dx+x. DECLARA sx SICUT NUMERUS VALENS sx0+x.
                    DECLARA sp SICUT NUMERUS VALENS GX_BASIS(src)+(sy*CONTENTUM(src+16)+sx)*4.
                    DECLARA dp SICUT NUMERUS VALENS GX_BASIS(dst)+(yy*CONTENTUM(dst+16)+xx)*4.
                    DECLARA duo SICUT NUMERUS VALENS CONTENTUM(sp).
                    DECLARA a0 SICUT NUMERUS VALENS (duo>>24)&255. DECLARA a1 SICUT NUMERUS VALENS (duo>>56)&255.
                    SI alpha_globalis==255 && a0==255 && a1==255 TUNC
                        CONTENTUM(dp)=duo.
                    ALITER
                        SI a0>0 TUNC
                            DECLARA sup0 SICUT NUMERUS VALENS duo&4294967295.
                            DECLARA sub0 SICUT NUMERUS VALENS GX_PIX_PM_LEGE(dst,xx,yy).
                            DECLARA f0 SICUT NUMERUS VALENS GX_PIX_PM_PONE(dst,xx,yy,GX_PM_SUPER(sub0,sup0,alpha_globalis)).
                        FIN-SI.
                        SI a1>0 TUNC
                            DECLARA sup1 SICUT NUMERUS VALENS (duo>>32)&4294967295.
                            DECLARA sub1 SICUT NUMERUS VALENS GX_PIX_PM_LEGE(dst,xx+1,yy).
                            DECLARA f1 SICUT NUMERUS VALENS GX_PIX_PM_PONE(dst,xx+1,yy,GX_PM_SUPER(sub1,sup1,alpha_globalis)).
                        FIN-SI.
                    FIN-SI.
                    x=x+2.
                FIN-DUM.
                SI x<sw TUNC
                    DECLARA xx2 SICUT NUMERUS VALENS dx+x. DECLARA sx2 SICUT NUMERUS VALENS sx0+x.
                    DECLARA sup2 SICUT NUMERUS VALENS GX_PIX_PM_LEGE(src,sx2,sy).
                    SI ((sup2>>24)&255)>0 TUNC DECLARA sub2 SICUT NUMERUS VALENS GX_PIX_PM_LEGE(dst,xx2,yy). DECLARA f2 SICUT NUMERUS VALENS GX_PIX_PM_PONE(dst,xx2,yy,GX_PM_SUPER(sub2,sup2,alpha_globalis)). FIN-SI.
                FIN-SI.
            ALITER
                DUM x<sw PERFICE
                    DECLARA xx3 SICUT NUMERUS VALENS dx+x. DECLARA sx3 SICUT NUMERUS VALENS sx0+x.
                    SI xx3>=0 && xx3<GX_W(dst) && sx3>=0 && sx3<GX_W(src) TUNC
                        DECLARA sup3 SICUT NUMERUS VALENS GX_PIX_PM_LEGE(src,sx3,sy).
                        SI ((sup3>>24)&255)>0 TUNC DECLARA sub3 SICUT NUMERUS VALENS GX_PIX_PM_LEGE(dst,xx3,yy). DECLARA f3 SICUT NUMERUS VALENS GX_PIX_PM_PONE(dst,xx3,yy,GX_PM_SUPER(sub3,sup3,alpha_globalis)). FIN-SI.
                    FIN-SI.
                    x=x+1.
                FIN-DUM.
            FIN-SI.
        FIN-SI.
        y=y+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_NOVEM_COMPONE REDDENS NUMERUS.
    ACCIPIT dst SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT sectio SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    SI dst==0 || src==0 || destinatio==0 || sectio==0 || alpha<=0 TUNC REDDE 0. FIN-SI.
    DECLARA sw SICUT NUMERUS VALENS GX_W(src). DECLARA sh SICUT NUMERUS VALENS GX_H(src).
    DECLARA tw SICUT NUMERUS VALENS GVIII_RECT_W(destinatio). DECLARA th SICUT NUMERUS VALENS GVIII_RECT_H(destinatio).
    SI sw<3 || sh<3 || tw<1 || th<1 TUNC REDDE 0. FIN-SI.
    DECLARA inter SICUT NUMERUS VALENS GVIII_RECT_SECA(sectio,destinatio).
    SI inter!=0 TUNC inter=GVIII_RECT_SECA(inter,GVIII_RECT_CREA(0,0,GX_W(dst),GX_H(dst))). FIN-SI.
    SI inter==0 TUNC REDDE 0. FIN-SI.
    DECLARA cutx SICUT NUMERUS VALENS (sw-1)/2. DECLARA cuty SICUT NUMERUS VALENS (sh-1)/2.
    DECLARA ix SICUT NUMERUS VALENS GVIII_RECT_X(inter). DECLARA iy SICUT NUMERUS VALENS GVIII_RECT_Y(inter).
    DECLARA iw SICUT NUMERUS VALENS GVIII_RECT_W(inter). DECLARA ih SICUT NUMERUS VALENS GVIII_RECT_H(inter).
    DECLARA ox SICUT NUMERUS VALENS GVIII_RECT_X(destinatio). DECLARA oy SICUT NUMERUS VALENS GVIII_RECT_Y(destinatio).
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<ih PERFICE
        DECLARA py SICUT NUMERUS VALENS iy+y. DECLARA ly SICUT NUMERUS VALENS py-oy.
        DECLARA sy SICUT NUMERUS VALENS cuty.
        SI cuty*2>=th TUNC sy=ly*sh/th. ALITER SI ly<cuty TUNC sy=ly. ALITER SI ly>=th-cuty TUNC sy=sh-(th-ly). FIN-SI. FIN-SI. FIN-SI.
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x<iw PERFICE
            DECLARA px SICUT NUMERUS VALENS ix+x. DECLARA lx SICUT NUMERUS VALENS px-ox.
            DECLARA sx SICUT NUMERUS VALENS cutx.
            SI cutx*2>=tw TUNC sx=lx*sw/tw. ALITER SI lx<cutx TUNC sx=lx. ALITER SI lx>=tw-cutx TUNC sx=sw-(tw-lx). FIN-SI. FIN-SI. FIN-SI.
            DECLARA sup SICUT NUMERUS VALENS GX_PIX_PM_LEGE(src,sx,sy).
            SI ((sup>>24)&255)>0 TUNC
                DECLARA sub SICUT NUMERUS VALENS GX_PIX_PM_LEGE(dst,px,py).
                DECLARA f SICUT NUMERUS VALENS GX_PIX_PM_PONE(dst,px,py,GX_PM_SUPER(sub,sup,alpha)).
            FIN-SI.
            x=x+1.
        FIN-DUM.
        y=y+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO GX_CAPTURA_FB REDDENS NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    SI rectum==0 TUNC REDDE 0. FIN-SI.
    DECLARA q SICUT NUMERUS VALENS GVIII_RECT_FRAMEBUFFER(rectum).
    SI q==0 || GVIII_RECT_W(q)!=GVIII_RECT_W(rectum) || GVIII_RECT_H(q)!=GVIII_RECT_H(rectum) TUNC REDDE 0. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS GVIII_RECT_W(q). DECLARA h SICUT NUMERUS VALENS GVIII_RECT_H(q).
    DECLARA x0 SICUT NUMERUS VALENS GVIII_RECT_X(q). DECLARA y0 SICUT NUMERUS VALENS GVIII_RECT_Y(q).
    DECLARA s SICUT NUMERUS VALENS GX_CREA(w,h). SI s==0 TUNC REDDE 0. FIN-SI.
    DECLARA forma SICUT NUMERUS VALENS CONTENTUM(50333744).
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<h PERFICE
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x<w PERFICE
            DECLARA c SICUT NUMERUS VALENS GVII_PIXEL_LEGE(x0+x,y0+y).
            DECLARA r SICUT NUMERUS VALENS c&255. DECLARA g SICUT NUMERUS VALENS (c>>8)&255. DECLARA b SICUT NUMERUS VALENS (c>>16)&255.
            SI forma!=0 TUNC DECLARA t SICUT NUMERUS VALENS r. r=b. b=t. FIN-SI.
            DECLARA f SICUT NUMERUS VALENS GX_PIX_PM_PONE(s,x,y,r|(g<<8)|(b<<16)|(255<<24)).
            x=x+1.
        FIN-DUM.
        y=y+1.
    FIN-DUM.
    DECLARA f2 SICUT NUMERUS VALENS GX_DAMNA_NOTA(s,GVIII_RECT_CREA(0,0,w,h)).
    REDDE s.
FIN-FUNCTIO.

FUNCTIO GX_COMPOSITA_FB REDDENS NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    ACCIPIT alpha_globalis SICUT NUMERUS.
    SI src==0 || alpha_globalis<=0 TUNC REDDE 0. FIN-SI.
    DECLARA sw SICUT NUMERUS VALENS GX_W(src). DECLARA sh SICUT NUMERUS VALENS GX_H(src).
    DECLARA fw SICUT NUMERUS VALENS CONTENTUM(50333728). DECLARA fh SICUT NUMERUS VALENS CONTENTUM(50333736).
    DECLARA forma SICUT NUMERUS VALENS CONTENTUM(50333744).
    DECLARA ag SICUT NUMERUS VALENS GVIII_CLAMPA(alpha_globalis,0,255).
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<sh PERFICE
        DECLARA yy SICUT NUMERUS VALENS dy+y.
        SI yy>=0 && yy<fh TUNC
            DECLARA x SICUT NUMERUS VALENS 0.
            DUM x<sw PERFICE
                DECLARA xx SICUT NUMERUS VALENS dx+x.
                SI xx>=0 && xx<fw TUNC
                    DECLARA q SICUT NUMERUS VALENS GX_PIX_PM_LEGE(src,x,y).
                    DECLARA sa SICUT NUMERUS VALENS ((q>>24)&255)*ag/255.
                    SI sa>0 TUNC
                        DECLARA sr SICUT NUMERUS VALENS (q&255)*ag/255.
                        DECLARA sg SICUT NUMERUS VALENS ((q>>8)&255)*ag/255.
                        DECLARA sb SICUT NUMERUS VALENS ((q>>16)&255)*ag/255.
                        SI forma!=0 TUNC DECLARA t SICUT NUMERUS VALENS sr. sr=sb. sb=t. FIN-SI.
                        DECLARA sub SICUT NUMERUS VALENS GVII_PIXEL_LEGE(xx,yy).
                        DECLARA inv SICUT NUMERUS VALENS 255-sa.
                        DECLARA orr SICUT NUMERUS VALENS sr+(sub&255)*inv/255.
                        DECLARA og SICUT NUMERUS VALENS sg+((sub>>8)&255)*inv/255.
                        DECLARA ob SICUT NUMERUS VALENS sb+((sub>>16)&255)*inv/255.
                        DECLARA f SICUT NUMERUS VALENS FV_PIXEL_COLOR(xx,yy,orr|(og<<8)|(ob<<16)).
                    FIN-SI.
                FIN-SI.
                x=x+1.
            FIN-DUM.
        FIN-SI.
        y=y+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.
