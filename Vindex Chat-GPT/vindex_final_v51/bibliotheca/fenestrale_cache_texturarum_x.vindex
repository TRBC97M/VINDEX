// Sylvia OS — P16-XII-F2: cache texturarum Graphica X backend-neutrum.
// GX_* ante hoc folium importentur.
//
// Gestor XCVI octeta:
//  0 activa, 8 libera, 16 numerus, 24 capacitas,
// 32 octeta residentia, 40 limes octetorum,
// 48 hits, 56 misses, 64 evictiones, 72 invalidationes,
// 80 horologium LRU, 88 identitas proxima.
//
// Nodus LXXX octeta:
//  0 identitas, 8 superficies GX, 16 generatio GX, 24 octeta,
// 32 usus recentissimus, 40 fibulae, 48 proximus,
// 56 vexilla, 64 manubrium backendis, 72 reservatum.
// Vexillum I significat generationem invalidam post ultimam relaxationem.
// Residentia hic contractum et vitam resource describit; memoria GPU non fingitur.

FUNCTIO TXC_CREA REDDENS NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    ACCIPIT limes SICUT NUMERUS.
    SI capacitas<=0 || capacitas>4096 || limes<=0 TUNC REDDE 0. FIN-SI.
    DECLARA c SICUT NUMERUS VALENS RESERVA_OCTETA(96).
    SI c==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(c,96).
    CONTENTUM(c+24)=capacitas. CONTENTUM(c+40)=limes. CONTENTUM(c+88)=1.
    REDDE c.
FIN-FUNCTIO.

FUNCTIO TXC_REMOVE REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT petitus SICUT NUMERUS.
    SI c==0 || petitus==0 || CONTENTUM(petitus+40)!=0 TUNC REDDE 0. FIN-SI.
    DECLARA prior SICUT NUMERUS VALENS 0.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(c).
    DUM n!=0 && n!=petitus PERFICE
        prior=n. n=CONTENTUM(n+48).
    FIN-DUM.
    SI n==0 TUNC REDDE 0. FIN-SI.
    DECLARA proximus SICUT NUMERUS VALENS CONTENTUM(n+48).
    SI prior==0 TUNC CONTENTUM(c)=proximus. ALITER CONTENTUM(prior+48)=proximus. FIN-SI.
    CONTENTUM(c+16)=CONTENTUM(c+16)-1.
    CONTENTUM(c+32)=CONTENTUM(c+32)-CONTENTUM(n+24).
    DECLARA liberum SICUT NUMERUS VALENS CONTENTUM(c+8).
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(n,80).
    CONTENTUM(n+48)=liberum. CONTENTUM(c+8)=n.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TXC_NODUS_SUMIT REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    SI c==0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(c+8).
    SI n!=0 TUNC
        CONTENTUM(c+8)=CONTENTUM(n+48).
        DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(n,80).
        REDDE n.
    FIN-SI.
    n=RESERVA_OCTETA(80).
    SI n==0 TUNC REDDE 0. FIN-SI.
    DECLARA f2 SICUT NUMERUS VALENS GX_MEM_PURA(n,80).
    REDDE n.
FIN-FUNCTIO.

FUNCTIO TXC_EVICTA_UNUM REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    SI c==0 TUNC REDDE 0. FIN-SI.
    DECLARA victima SICUT NUMERUS VALENS 0.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(c).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+40)==0 TUNC
            SI victima==0 || CONTENTUM(n+32)<CONTENTUM(victima+32) || (CONTENTUM(n+32)==CONTENTUM(victima+32) && CONTENTUM(n)<CONTENTUM(victima)) TUNC
                victima=n.
            FIN-SI.
        FIN-SI.
        n=CONTENTUM(n+48).
    FIN-DUM.
    SI victima==0 TUNC REDDE 0. FIN-SI.
    SI TXC_REMOVE(c,victima)==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(c+64)=CONTENTUM(c+64)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TXC_LOCUM_PARA REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT octeta SICUT NUMERUS.
    SI c==0 || octeta<=0 || octeta>CONTENTUM(c+40) TUNC REDDE 0. FIN-SI.
    DUM CONTENTUM(c+16)>=CONTENTUM(c+24) || CONTENTUM(c+32)+octeta>CONTENTUM(c+40) PERFICE
        SI TXC_EVICTA_UNUM(c)==0 TUNC REDDE 0. FIN-SI.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TXC_INVALIDA REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    SI c==0 || superficies==0 TUNC REDDE 0. FIN-SI.
    DECLARA mutata SICUT NUMERUS VALENS 0.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(c).
    DUM n!=0 PERFICE
        DECLARA proximus SICUT NUMERUS VALENS CONTENTUM(n+48).
        SI CONTENTUM(n+8)==superficies && (CONTENTUM(n+56)&1)==0 TUNC
            CONTENTUM(c+72)=CONTENTUM(c+72)+1. mutata=mutata+1.
            SI CONTENTUM(n+40)>0 TUNC
                CONTENTUM(n+56)=CONTENTUM(n+56)|1.
            ALITER
                DECLARA f SICUT NUMERUS VALENS TXC_REMOVE(c,n).
            FIN-SI.
        FIN-SI.
        n=proximus.
    FIN-DUM.
    REDDE mutata.
FIN-FUNCTIO.

FUNCTIO TXC_PURGA REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    SI c==0 TUNC REDDE 0. FIN-SI.
    DECLARA mutata SICUT NUMERUS VALENS 0.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(c).
    DUM n!=0 PERFICE
        DECLARA proximus SICUT NUMERUS VALENS CONTENTUM(n+48).
        SI (CONTENTUM(n+56)&1)==0 TUNC
            CONTENTUM(c+72)=CONTENTUM(c+72)+1. mutata=mutata+1.
            SI CONTENTUM(n+40)>0 TUNC
                CONTENTUM(n+56)=CONTENTUM(n+56)|1.
            ALITER
                DECLARA f SICUT NUMERUS VALENS TXC_REMOVE(c,n).
            FIN-SI.
        FIN-SI.
        n=proximus.
    FIN-DUM.
    REDDE mutata.
FIN-FUNCTIO.

FUNCTIO TXC_PETE REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    SI c==0 || superficies==0 TUNC REDDE 0. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS GX_W(superficies).
    DECLARA h SICUT NUMERUS VALENS GX_H(superficies).
    DECLARA generatio SICUT NUMERUS VALENS CONTENTUM(superficies+72).
    SI w<=0 || h<=0 || GX_BASIS(superficies)==0 || generatio<=0 TUNC
        DECLARA mortua SICUT NUMERUS VALENS TXC_INVALIDA(c,superficies).
        REDDE 0.
    FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(c).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+8)==superficies && CONTENTUM(n+16)==generatio && (CONTENTUM(n+56)&1)==0 TUNC
            CONTENTUM(c+48)=CONTENTUM(c+48)+1. CONTENTUM(c+80)=CONTENTUM(c+80)+1.
            CONTENTUM(n+32)=CONTENTUM(c+80). CONTENTUM(n+40)=CONTENTUM(n+40)+1.
            REDDE n.
        FIN-SI.
        n=CONTENTUM(n+48).
    FIN-DUM.
    CONTENTUM(c+56)=CONTENTUM(c+56)+1.
    DECLARA veteres SICUT NUMERUS VALENS TXC_INVALIDA(c,superficies).
    DECLARA octeta SICUT NUMERUS VALENS w*h*4.
    SI TXC_LOCUM_PARA(c,octeta)==0 TUNC REDDE 0. FIN-SI.
    n=TXC_NODUS_SUMIT(c).
    SI n==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(c+80)=CONTENTUM(c+80)+1.
    CONTENTUM(n)=CONTENTUM(c+88). CONTENTUM(c+88)=CONTENTUM(c+88)+1.
    CONTENTUM(n+8)=superficies. CONTENTUM(n+16)=generatio. CONTENTUM(n+24)=octeta.
    CONTENTUM(n+32)=CONTENTUM(c+80). CONTENTUM(n+40)=1. CONTENTUM(n+48)=CONTENTUM(c).
    CONTENTUM(c)=n. CONTENTUM(c+16)=CONTENTUM(c+16)+1. CONTENTUM(c+32)=CONTENTUM(c+32)+octeta.
    REDDE n.
FIN-FUNCTIO.

FUNCTIO TXC_RELAXA REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI c==0 || nodus==0 || CONTENTUM(nodus+40)<=0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(c).
    DUM n!=0 && n!=nodus PERFICE n=CONTENTUM(n+48). FIN-DUM.
    SI n==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(nodus+40)=CONTENTUM(nodus+40)-1.
    SI CONTENTUM(nodus+40)==0 && (CONTENTUM(nodus+56)&1)!=0 TUNC
        REDDE TXC_REMOVE(c,nodus).
    FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TXC_NUMERUS REDDENS NUMERUS. ACCIPIT c SICUT NUMERUS. SI c==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(c+16). FIN-FUNCTIO.
FUNCTIO TXC_OCTETA REDDENS NUMERUS. ACCIPIT c SICUT NUMERUS. SI c==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(c+32). FIN-FUNCTIO.
FUNCTIO TXC_HITS REDDENS NUMERUS. ACCIPIT c SICUT NUMERUS. SI c==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(c+48). FIN-FUNCTIO.
FUNCTIO TXC_MISSES REDDENS NUMERUS. ACCIPIT c SICUT NUMERUS. SI c==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(c+56). FIN-FUNCTIO.
FUNCTIO TXC_EVICTIONES REDDENS NUMERUS. ACCIPIT c SICUT NUMERUS. SI c==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(c+64). FIN-FUNCTIO.
FUNCTIO TXC_INVALIDATIONES REDDENS NUMERUS. ACCIPIT c SICUT NUMERUS. SI c==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(c+72). FIN-FUNCTIO.
FUNCTIO TXC_ID REDDENS NUMERUS. ACCIPIT n SICUT NUMERUS. SI n==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(n). FIN-FUNCTIO.
FUNCTIO TXC_GENERATIO REDDENS NUMERUS. ACCIPIT n SICUT NUMERUS. SI n==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(n+16). FIN-FUNCTIO.
FUNCTIO TXC_FIBULAE REDDENS NUMERUS. ACCIPIT n SICUT NUMERUS. SI n==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(n+40). FIN-FUNCTIO.
