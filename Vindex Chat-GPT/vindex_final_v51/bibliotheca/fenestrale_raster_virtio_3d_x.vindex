// Sylvia OS — P16-XII-F9-III: raster target Graphica X super VIRGL.
// GX_*, RV3D_*, VG2D_*, VG3DR_* et VG3DX_* ante hoc folium importentur.
//
// F9-II residentiam texturarum servat intactam. Hic nodus separatus est
// render-target probationis: initio hosti nigrum imponit, deinde SUBMIT_3D
// potest superficiem mutare, et TRANSFER_FROM_HOST_3D mutationem ad memoriam
// VINDEX reducit. Sic compositor software manet oraculum semanticum.
//
// Nodus LXXX octeta:
//  0 gestor RV3D, 8 resource id, 16 backing DMA, 24 w, 32 h, 40 stride bytes,
// 48 status, 56 submit numerus, 64 readback numerus, 72 erratum.
// Status: 0 localis, 1 resource, 2 backing, 3 contextui adiuncta, 7 libera.

FUNCTIO RX3D_PARATUS REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus == 0 || CONTENTUM(nodus + 48) != 3 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(nodus) == 0 || CONTENTUM(nodus + 8) <= 0 || CONTENTUM(nodus + 16) == 0 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO RX3D_LIBERA REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus == 0 TUNC REDDE 0. FIN-SI.
    DECLARA status SICUT NUMERUS VALENS CONTENTUM(nodus + 48).
    SI status == 7 TUNC REDDE 1. FIN-SI.
    DECLARA gestor SICUT NUMERUS VALENS CONTENTUM(nodus).
    DECLARA identitas SICUT NUMERUS VALENS CONTENTUM(nodus + 8).
    DECLARA backing SICUT NUMERUS VALENS CONTENTUM(nodus + 16).
    SI gestor == 0 TUNC
        SI backing != 0 TUNC DECLARA dl0 SICUT NUMERUS VALENS DMA_UEFI_LIBERA(backing). FIN-SI.
        CONTENTUM(nodus + 16) = 0. CONTENTUM(nodus + 48) = 7. REDDE 1.
    FIN-SI.
    DECLARA vp SICUT NUMERUS VALENS CONTENTUM(gestor).
    DECLARA coda SICUT NUMERUS VALENS CONTENTUM(gestor + 8).
    DECLARA contextus SICUT NUMERUS VALENS CONTENTUM(gestor + 16).
    SI status == 3 TUNC
        SI VG3DR_CTX_SEPARA(vp, coda, RV3D_MANDATUM(), RV3D_RESPONSUM(), contextus, identitas) == 0 TUNC CONTENTUM(nodus + 72) = 30. REDDE 0. FIN-SI.
        CONTENTUM(nodus + 48) = 2. status = 2.
    FIN-SI.
    SI status == 2 TUNC
        DECLARA d1 SICUT NUMERUS VALENS VG2D_BACKING_SEPARA(vp, coda, RV3D_MANDATUM(), RV3D_RESPONSUM(), identitas).
        SI d1 != VG2D_RESP_NODATA() TUNC CONTENTUM(nodus + 72) = 31. REDDE 0. FIN-SI.
        CONTENTUM(nodus + 48) = 1. status = 1.
    FIN-SI.
    SI status == 1 TUNC
        DECLARA d2 SICUT NUMERUS VALENS VG2D_RESOURCE_LIBERA(vp, coda, RV3D_MANDATUM(), RV3D_RESPONSUM(), identitas).
        SI d2 != VG2D_RESP_NODATA() TUNC CONTENTUM(nodus + 72) = 32. REDDE 0. FIN-SI.
        CONTENTUM(nodus + 48) = 0. status = 0.
    FIN-SI.
    SI status == 0 TUNC
        SI backing != 0 && DMA_UEFI_LIBERA(backing) == 0 TUNC CONTENTUM(nodus + 72) = 33. REDDE 0. FIN-SI.
        CONTENTUM(nodus + 16) = 0. CONTENTUM(nodus + 48) = 7. REDDE 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO RX3D_CREA REDDENS NUMERUS.
    ACCIPIT gestor SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI RV3D_PARATUS(gestor) == 0 || w <= 0 || h <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA stride SICUT NUMERUS VALENS w * 4.
    DECLARA octeta SICUT NUMERUS VALENS stride * h.
    SI stride <= 0 || octeta <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA nodus SICUT NUMERUS VALENS RESERVA_OCTETA(80).
    SI nodus == 0 TUNC REDDE 0. FIN-SI.
    DECLARA purgatus SICUT NUMERUS VALENS GX_MEM_PURA(nodus, 80).
    CONTENTUM(nodus) = gestor. CONTENTUM(nodus + 24) = w. CONTENTUM(nodus + 32) = h. CONTENTUM(nodus + 40) = stride.
    DECLARA vexilla SICUT NUMERUS VALENS DMA_APPARATUS_LEGE() | DMA_APPARATUS_SCRIBE().
    DECLARA backing SICUT NUMERUS VALENS DMA_UEFI_ALLOCA(CONTENTUM(gestor + 120), octeta, 0, vexilla).
    SI backing == 0 TUNC CONTENTUM(nodus + 72) = 1. REDDE 0. FIN-SI.
    CONTENTUM(nodus + 16) = backing.
    DECLARA memoria SICUT NUMERUS VALENS CONTENTUM(backing + 8).
    SI memoria == 0 TUNC CONTENTUM(nodus + 72) = 2. DECLARA rb0 SICUT NUMERUS VALENS RX3D_LIBERA(nodus). REDDE 0. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < octeta PERFICE
        SCRIBE_OCTETUM_AB(memoria + i, 0).
        i = i + 1.
    FIN-DUM.
    SI DMA_SYNCHRONIZA(backing, DMA_AD_APPARATUM()) == 0 TUNC CONTENTUM(nodus + 72) = 3. DECLARA rb1 SICUT NUMERUS VALENS RX3D_LIBERA(nodus). REDDE 0. FIN-SI.

    DECLARA identitas SICUT NUMERUS VALENS CONTENTUM(gestor + 32).
    CONTENTUM(gestor + 32) = identitas + 1. CONTENTUM(nodus + 8) = identitas.
    SI VG3DX_RESOURCE_CREA_RT(CONTENTUM(gestor), CONTENTUM(gestor + 8), RV3D_MANDATUM(), RV3D_RESPONSUM(), identitas, w, h) == 0 TUNC CONTENTUM(nodus + 72) = 4. DECLARA rb2 SICUT NUMERUS VALENS RX3D_LIBERA(nodus). REDDE 0. FIN-SI.
    CONTENTUM(nodus + 48) = 1.
    DECLARA a SICUT NUMERUS VALENS VG2D_BACKING_ADIUNGE(CONTENTUM(gestor), CONTENTUM(gestor + 8), RV3D_MANDATUM(), RV3D_RESPONSUM(), identitas, backing).
    SI a != VG2D_RESP_NODATA() TUNC CONTENTUM(nodus + 72) = 5. DECLARA rb3 SICUT NUMERUS VALENS RX3D_LIBERA(nodus). REDDE 0. FIN-SI.
    CONTENTUM(nodus + 48) = 2.
    SI VG3DR_CTX_ADIUNGE(CONTENTUM(gestor), CONTENTUM(gestor + 8), RV3D_MANDATUM(), RV3D_RESPONSUM(), CONTENTUM(gestor + 16), identitas) == 0 TUNC CONTENTUM(nodus + 72) = 6. DECLARA rb4 SICUT NUMERUS VALENS RX3D_LIBERA(nodus). REDDE 0. FIN-SI.
    CONTENTUM(nodus + 48) = 3.

    // Initium hostis deliberate nigrum est, ut clear subsequens mutationem probet.
    DECLARA param SICUT NUMERUS VALENS VG3DR_TRANSFER_PARAM(identitas, w, h, stride, octeta).
    SI param == 0 || VG3DR_TRANSFER_AD_HOSTEM(CONTENTUM(gestor), CONTENTUM(gestor + 8), RV3D_MANDATUM(), RV3D_RESPONSUM(), CONTENTUM(gestor + 16), param) == 0 TUNC CONTENTUM(nodus + 72) = 7. DECLARA rb5 SICUT NUMERUS VALENS RX3D_LIBERA(nodus). REDDE 0. FIN-SI.
    CONTENTUM(nodus + 72) = 0.
    REDDE nodus.
FIN-FUNCTIO.

FUNCTIO RX3D_LEGE_AB_HOSTE REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI RX3D_PARATUS(nodus) == 0 TUNC REDDE 0. FIN-SI.
    DECLARA gestor SICUT NUMERUS VALENS CONTENTUM(nodus).
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(nodus + 24).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(nodus + 32).
    DECLARA stride SICUT NUMERUS VALENS CONTENTUM(nodus + 40).
    DECLARA octeta SICUT NUMERUS VALENS stride * h.
    DECLARA param SICUT NUMERUS VALENS VG3DR_TRANSFER_PARAM(CONTENTUM(nodus + 8), w, h, stride, octeta).
    SI param == 0 || VG3DX_TRANSFER_AB_HOSTE(CONTENTUM(gestor), CONTENTUM(gestor + 8), RV3D_MANDATUM(), RV3D_RESPONSUM(), CONTENTUM(gestor + 16), param) == 0 TUNC CONTENTUM(nodus + 72) = 20. REDDE 0. FIN-SI.
    SI DMA_SYNCHRONIZA(CONTENTUM(nodus + 16), DMA_AB_APPARATU()) == 0 TUNC CONTENTUM(nodus + 72) = 21. REDDE 0. FIN-SI.
    CONTENTUM(nodus + 64) = CONTENTUM(nodus + 64) + 1. CONTENTUM(nodus + 72) = 0.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO RX3D_CLEAR_CANONICUS REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI RX3D_PARATUS(nodus) == 0 TUNC REDDE 0. FIN-SI.
    DECLARA gestor SICUT NUMERUS VALENS CONTENTUM(nodus).
    DECLARA identitas SICUT NUMERUS VALENS CONTENTUM(nodus + 8).
    // Magenta opacum: (1,0,1,1), exactum in RGBA8 et in oraculo software.
    DECLARA param SICUT NUMERUS VALENS VG3DX_CLEAR_PARAM(CONTENTUM(gestor + 16), identitas, identitas, VG3DX_F32_UNUM(), VG3DX_F32_ZERO(), VG3DX_F32_UNUM(), VG3DX_F32_UNUM()).
    SI param == 0 TUNC CONTENTUM(nodus + 72) = 22. REDDE 0. FIN-SI.
    SI VG3DX_SUBMIT_CLEAR(CONTENTUM(gestor), CONTENTUM(gestor + 8), RV3D_MANDATUM(), RV3D_RESPONSUM(), param) == 0 TUNC CONTENTUM(nodus + 72) = 23. REDDE 0. FIN-SI.
    CONTENTUM(nodus + 56) = CONTENTUM(nodus + 56) + 1. CONTENTUM(nodus + 72) = 0.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO RX3D_PIXEL REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    SI RX3D_PARATUS(nodus) == 0 || x < 0 || y < 0 || x >= CONTENTUM(nodus + 24) || y >= CONTENTUM(nodus + 32) TUNC REDDE 0. FIN-SI.
    DECLARA backing SICUT NUMERUS VALENS CONTENTUM(nodus + 16).
    DECLARA p SICUT NUMERUS VALENS CONTENTUM(backing + 8) + y * CONTENTUM(nodus + 40) + x * 4.
    REDDE OCTETUS_AB(p) | (OCTETUS_AB(p + 1) << 8) | (OCTETUS_AB(p + 2) << 16) | (OCTETUS_AB(p + 3) << 24).
FIN-FUNCTIO.

FUNCTIO RX3D_AEQUALIS_GX REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    SI RX3D_PARATUS(nodus) == 0 || superficies == 0 TUNC REDDE 0. FIN-SI.
    SI GX_W(superficies) != CONTENTUM(nodus + 24) || GX_H(superficies) != CONTENTUM(nodus + 32) TUNC REDDE 0. FIN-SI.
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y < CONTENTUM(nodus + 32) PERFICE
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x < CONTENTUM(nodus + 24) PERFICE
            SI RX3D_PIXEL(nodus, x, y) != GX_PIX_PM_LEGE(superficies, x, y) TUNC REDDE 0. FIN-SI.
            x = x + 1.
        FIN-DUM.
        y = y + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO RX3D_SUBMISA REDDENS NUMERUS. ACCIPIT n SICUT NUMERUS. SI n == 0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(n + 56). FIN-FUNCTIO.
FUNCTIO RX3D_LECTA REDDENS NUMERUS. ACCIPIT n SICUT NUMERUS. SI n == 0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(n + 64). FIN-FUNCTIO.
FUNCTIO RX3D_ERRATUM REDDENS NUMERUS. ACCIPIT n SICUT NUMERUS. SI n == 0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(n + 72). FIN-FUNCTIO.