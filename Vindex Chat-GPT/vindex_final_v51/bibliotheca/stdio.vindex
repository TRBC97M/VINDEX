// VINDEX — STDIO portabile I.
//
// Contractus humilis et communis applicationibus ordinariis:
//   descriptor 0 = stdin
//   descriptor 1 = stdout
//
// Backend targetis hos descriptores abstractos ad mechanismum systematis sui
// traducere debet. PE32+ Win64 hoc contractum a P11-B per GetStdHandle implet.

FUNCTIO STDIO_SCRIBE REDDENS NUMERUS.
    ACCIPIT tampon SICUT ACUS<LITTERA>.
    ACCIPIT longitudo SICUT NUMERUS.
    SI tampon == 0 || longitudo < 0 TUNC REDDE -1. FIN-SI.
    REDDE MITTE(1, tampon, longitudo).
FIN-FUNCTIO.

FUNCTIO STDIO_PROMPTUM REDDENS NUMERUS.
    DECLARA signum SICUT ORDO DE LITTERA CAPACITAS 2.
    signum[0] = 62.
    signum[1] = 32.
    REDDE MITTE(1, signum, 2).
FIN-FUNCTIO.

// Lineam unam UTF-8 ut octeta cruda legit. CR removetur; LF terminat.
// Reddit:
//   >= 0  numerum octetorum in linea;
//   -1    errorem I/O vel argumentum invalidum;
//   -2    EOF ante ullum octetum.
// Tampon semper NUL terminatur ubi capacitas id permittit.
//
// Nota: LITTERA in structuris humilis gradus byte-addressata est. Hic
// OCTETUS_AB/SCRIBE_OCTETUM_AB deliberate adhibentur ne lectio verbi LXIV
// bitorum per accidens plures litteras simul comparet aut mutet.
FUNCTIO STDIO_LEGE_LINEAM REDDENS NUMERUS.
    ACCIPIT tampon SICUT ACUS<LITTERA>.
    ACCIPIT capacitas SICUT NUMERUS.
    SI tampon == 0 || capacitas <= 1 TUNC REDDE -1. FIN-SI.

    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < capacitas - 1 PERFICE
        DECLARA n SICUT NUMERUS VALENS LEGE(0, 1).
        SI n < 0 TUNC
            SCRIBE_OCTETUM_AB(tampon + i, 0).
            REDDE -1.
        FIN-SI.
        SI n == 0 TUNC
            SCRIBE_OCTETUM_AB(tampon + i, 0).
            SI i == 0 TUNC REDDE -2. FIN-SI.
            REDDE i.
        FIN-SI.

        DECLARA c SICUT NUMERUS VALENS OCTETUS(0).
        SI c == 10 TUNC
            SCRIBE_OCTETUM_AB(tampon + i, 0).
            REDDE i.
        FIN-SI.
        SI c != 13 TUNC
            SCRIBE_OCTETUM_AB(tampon + i, c).
            i = i + 1.
        FIN-SI.
    FIN-DUM.

    SCRIBE_OCTETUM_AB(tampon + i, 0).
    REDDE i.
FIN-FUNCTIO.

FUNCTIO STDIO_AEQUA REDDENS NUMERUS.
    ACCIPIT a SICUT ACUS<LITTERA>.
    ACCIPIT na SICUT NUMERUS.
    ACCIPIT b SICUT ACUS<LITTERA>.
    ACCIPIT nb SICUT NUMERUS.
    SI a == 0 || b == 0 || na != nb || na < 0 TUNC REDDE 0. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < na PERFICE
        SI OCTETUS_AB(a + i) != OCTETUS_AB(b + i) TUNC REDDE 0. FIN-SI.
        i = i + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.
