    CONTENTUM(p) = hwnd. CONTENTUM(p + 8) = 5.
    DECLARA r SICUT NUMERUS VALENS MSX64_VOCA(CONTENTUM(ctx + 56), p).
    ig = MSX64_ARGUMENTA_VACUA(p). CONTENTUM(p) = hwnd.
    DECLARA u SICUT NUMERUS VALENS MSX64_VOCA(CONTENTUM(ctx + 64), p).
