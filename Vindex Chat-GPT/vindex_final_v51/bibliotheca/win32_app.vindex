// WIN32_APP — API applicationis Win64 alti gradus super win32_ffi.vindex.
//
// Client ante hanc bibliothecam importare debet:
//   bibliotheca/textus.vindex
//   bibliotheca/win32_ffi.vindex
//
// Contextus internus XXIII verba NUMERUS continet; offsets non sunt API publica.

FUNCTIO WINAPP_SYMBOLUM_IMPONE REDDENS NUMERUS.
    ACCIPIT ctx SICUT NUMERUS.
    ACCIPIT off SICUT NUMERUS.
    ACCIPIT modulus SICUT NUMERUS.
    ACCIPIT nomen SICUT TEXTUS.
    DECLARA p SICUT NUMERUS VALENS WIN32_SYMBOLUM(modulus, nomen).
    CONTENTUM(ctx + off) = p.
    REDDE p.
FIN-FUNCTIO.

FUNCTIO WINAPP_CONTEXUS_CREA REDDENS NUMERUS.
    DECLARA ctx SICUT NUMERUS VALENS RESERVA_OCTETA(184).
    SI ctx <= 0 TUNC REDDE 0. FIN-SI.

    DECLARA user32 SICUT NUMERUS VALENS WIN32_MODULUM_APERI("user32.dll").
    DECLARA gdi32 SICUT NUMERUS VALENS WIN32_MODULUM_APERI("gdi32.dll").
    DECLARA kernel32 SICUT NUMERUS VALENS WIN32_MODULUM_APERI("kernel32.dll").
    SI user32 == 0 || gdi32 == 0 || kernel32 == 0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(ctx) = user32.
    CONTENTUM(ctx + 8) = gdi32.
    CONTENTUM(ctx + 16) = kernel32.

    DECLARA ok SICUT NUMERUS VALENS 1.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 24, user32, "CreateWindowExA") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 32, user32, "GetDC") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 40, user32, "ReleaseDC") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 48, user32, "DestroyWindow") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 56, user32, "ShowWindow") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 64, user32, "UpdateWindow") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 72, user32, "PeekMessageA") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 80, user32, "TranslateMessage") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 88, user32, "DispatchMessageA") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 96, user32, "GetAsyncKeyState") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 104, user32, "GetCursorPos") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 112, user32, "ScreenToClient") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 120, user32, "GetClientRect") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 128, user32, "IsWindow") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 136, gdi32, "StretchDIBits") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 144, gdi32, "TextOutA") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 152, gdi32, "SetTextColor") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 160, gdi32, "SetBkMode") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 168, kernel32, "GetModuleHandleA") == 0 TUNC ok = 0. FIN-SI.
    SI WINAPP_SYMBOLUM_IMPONE(ctx, 176, kernel32, "Sleep") == 0 TUNC ok = 0. FIN-SI.
    SI ok == 0 TUNC REDDE 0. FIN-SI.
    REDDE ctx.
FIN-FUNCTIO.

FUNCTIO WINAPP_FENESTRA_CREA REDDENS NUMERUS.
    ACCIPIT ctx SICUT NUMERUS.
    ACCIPIT titulus SICUT TEXTUS.
    ACCIPIT latitudo SICUT NUMERUS.
    ACCIPIT altitudo SICUT NUMERUS.
    DECLARA argumenta SICUT ORDO DE NUMERUS CAPACITAS 16.
    DECLARA args SICUT NUMERUS VALENS SEDES(argumenta).
    DECLARA ig SICUT NUMERUS VALENS MSX64_ARGUMENTA_VACUA(args).
    CONTENTUM(args) = 0.
    DECLARA hinstance SICUT NUMERUS VALENS MSX64_VOCA(CONTENTUM(ctx + 168), args).
    SI hinstance == 0 TUNC REDDE 0. FIN-SI.
    DECLARA classis SICUT TEXTUS VALENS "STATIC".
    ig = MSX64_ARGUMENTA_VACUA(args).
    CONTENTUM(args + 0) = 0.
    CONTENTUM(args + 8) = TEXTUS_BASIS_OCTETORUM(classis).
    CONTENTUM(args + 16) = TEXTUS_BASIS_OCTETORUM(titulus).
    CONTENTUM(args + 24) = 13565952.
    CONTENTUM(args + 32) = 80.
    CONTENTUM(args + 40) = 80.
    CONTENTUM(args + 48) = latitudo.
    CONTENTUM(args + 56) = altitudo.
    CONTENTUM(args + 64) = 0.
    CONTENTUM(args + 72) = 0.
    CONTENTUM(args + 80) = hinstance.
    CONTENTUM(args + 88) = 0.
    REDDE MSX64_VOCA(CONTENTUM(ctx + 24), args).
FIN-FUNCTIO.

FUNCTIO WINAPP_HDC_CAPE REDDENS NUMERUS.
    ACCIPIT ctx SICUT NUMERUS.
    ACCIPIT hwnd SICUT NUMERUS.
    DECLARA a SICUT ORDO DE NUMERUS CAPACITAS 16.
    DECLARA p SICUT NUMERUS VALENS SEDES(a).
    DECLARA ig SICUT NUMERUS VALENS MSX64_ARGUMENTA_VACUA(p).
    CONTENTUM(p) = hwnd.
    REDDE MSX64_VOCA(CONTENTUM(ctx + 32), p).
FIN-FUNCTIO.

