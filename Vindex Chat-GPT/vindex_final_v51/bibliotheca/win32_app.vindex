    CONTENTUM(p) = msg.
    DECLARA t SICUT NUMERUS VALENS MSX64_VOCA(CONTENTUM(ctx + 80), p).
    ig = MSX64_ARGUMENTA_VACUA(p). CONTENTUM(p) = msg.
