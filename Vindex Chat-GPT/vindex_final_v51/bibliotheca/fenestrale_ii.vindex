// Sylvia OS — Fenestrale II, Gradus D.
// Bibliotheca clientis VINDEX pro descriptoribus et eventis Fenestralis II.

FUNCTIO FENESTRALE_II_BASIS REDDENS NUMERUS.
    REDDE 50333952.
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_EVENTA_CAPUT REDDENS NUMERUS.
    REDDE 50334080.
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_EVENTA_BASIS REDDENS NUMERUS.
    REDDE 50334112.
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_AD_EST REDDENS NUMERUS.
    SI CONTENTUM(50333952) == 14159808274651475 && CONTENTUM(50333960) == 1 && CONTENTUM(50333968) >= 128 TUNC
        REDDE 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_CAPACITATES REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50333976).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_FRAMEBUFFER REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50333984).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_LATITUDO REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50333992).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_ALTITUDO REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50334000).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_PIXEL_PER_LINEAM REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50334008).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_FORMATUM_PIXELORUM REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50334016).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_BITS_PER_PIXEL REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50334024).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_MURUS_X REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50334032).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_MURUS_Y REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50334040).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_BULLAE REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50334048).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_NUMERUS_EVENTUUM REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50334056).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_TASKBAR_ALTITUDO REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50334064).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_SCALA_PER_MILLE REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 1000. FIN-SI.
    REDDE CONTENTUM(50334072).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_EVENTA_PARATA REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    DECLARA scriptura SICUT NUMERUS VALENS CONTENTUM(50334080).
    DECLARA lectio SICUT NUMERUS VALENS CONTENTUM(50334088).
    SI scriptura <= lectio TUNC REDDE 0. FIN-SI.
    DECLARA numerus SICUT NUMERUS VALENS scriptura - lectio.
    SI numerus > 32 TUNC numerus = 32. FIN-SI.
    REDDE numerus.
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_EVENTUM_LOCUS REDDENS NUMERUS.
    ACCIPIT ordo SICUT NUMERUS.
    SI ordo < 0 || ordo >= FENESTRALE_II_EVENTA_PARATA() TUNC REDDE 0. FIN-SI.
    DECLARA lectio SICUT NUMERUS VALENS CONTENTUM(50334088).
    DECLARA index SICUT NUMERUS VALENS (lectio + ordo) % 32.
    REDDE 50334112 + index * 32.
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_EVENTUM_TYPUS REDDENS NUMERUS.
    ACCIPIT ordo SICUT NUMERUS.
    DECLARA locus SICUT NUMERUS VALENS FENESTRALE_II_EVENTUM_LOCUS(ordo).
    SI locus == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(locus).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_EVENTUM_VEXILLA REDDENS NUMERUS.
    ACCIPIT ordo SICUT NUMERUS.
    DECLARA locus SICUT NUMERUS VALENS FENESTRALE_II_EVENTUM_LOCUS(ordo).
    SI locus == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(locus + 8).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_EVENTUM_A REDDENS NUMERUS.
    ACCIPIT ordo SICUT NUMERUS.
    DECLARA locus SICUT NUMERUS VALENS FENESTRALE_II_EVENTUM_LOCUS(ordo).
    SI locus == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(locus + 16).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_EVENTUM_B REDDENS NUMERUS.
    ACCIPIT ordo SICUT NUMERUS.
    DECLARA locus SICUT NUMERUS VALENS FENESTRALE_II_EVENTUM_LOCUS(ordo).
    SI locus == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(locus + 24).
FIN-FUNCTIO.

FUNCTIO FENESTRALE_II_EVENTUM_CONSUME REDDENS NUMERUS.
    SI FENESTRALE_II_EVENTA_PARATA() == 0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(50334088) = CONTENTUM(50334088) + 1.
    REDDE 1.
FIN-FUNCTIO.
