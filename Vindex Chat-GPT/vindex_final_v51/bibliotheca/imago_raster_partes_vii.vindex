// Sylvia OS — P16-VII: blit partium rasterarum cum scala nearest-neighbor.
// Recta fontis et destinationis in NUMERUS singulos condensantur ut ABI
// vocationum internarum breve et stabile maneat.

FUNCTIO IRVII_RECT_CREA REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI x<0 || y<0 || w<=0 || h<=0 || x>65535 || y>65535 || w>65535 || h>65535 TUNC REDDE 0. FIN-SI.
    REDDE (x&65535)|((y&65535)<<16)|((w&65535)<<32)|((h&65535)<<48).
FIN-FUNCTIO.

FUNCTIO IRVII_RECT_X REDDENS NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    REDDE rectum&65535.
FIN-FUNCTIO.

FUNCTIO IRVII_RECT_Y REDDENS NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    REDDE (rectum>>16)&65535.
FIN-FUNCTIO.

FUNCTIO IRVII_RECT_W REDDENS NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    REDDE (rectum>>32)&65535.
FIN-FUNCTIO.

FUNCTIO IRVII_RECT_H REDDENS NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    REDDE (rectum>>48)&65535.
FIN-FUNCTIO.

FUNCTIO IRVII_PARTEM_VALIDAM REDDENS NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    ACCIPIT sx SICUT NUMERUS.
    ACCIPIT sy SICUT NUMERUS.
    ACCIPIT sw SICUT NUMERUS.
    ACCIPIT sh SICUT NUMERUS.
    SI IR_VALIDUS(imago)==0 || sw<=0 || sh<=0 || sx<0 || sy<0 TUNC REDDE 0. FIN-SI.
    DECLARA iw SICUT NUMERUS VALENS IR_LATITUDO(imago).
    DECLARA ih SICUT NUMERUS VALENS IR_ALTITUDO(imago).
    SI sx+sw>iw || sy+sh>ih TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IRVII_RGBA_AD_COLOR REDDENS NUMERUS.
    ACCIPIT rgba SICUT NUMERUS.
    DECLARA r SICUT NUMERUS VALENS rgba&255.
    DECLARA g SICUT NUMERUS VALENS (rgba>>8)&255.
    DECLARA b SICUT NUMERUS VALENS (rgba>>16)&255.
    REDDE FV_COLOR(r,g,b).
FIN-FUNCTIO.

FUNCTIO IRVII_PIXEL_EX_FONTE REDDENS NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    DECLARA d SICUT NUMERUS VALENS IR_TEXTUS_SEDES(imago).
    DECLARA stride SICUT NUMERUS VALENS IR_STRIDE(imago).
    DECLARA locus SICUT NUMERUS VALENS d+16+24+y*stride+x*4.
    REDDE OCTETUS_AB(locus)+OCTETUS_AB(locus+1)*256+OCTETUS_AB(locus+2)*65536+OCTETUS_AB(locus+3)*16777216.
FIN-FUNCTIO.

FUNCTIO IRVII_BLIT_FB REDDENS NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT pars SICUT NUMERUS.
    // SONDA P16-XI TEMPORARIA: nullum pixelum iconis hic pingitur.
    // Si taskbar et cursor redeunt, locus obstructionis definitive hic est.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IRVII_BLIT_FS REDDENS NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT imago SICUT TEXTUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT pars SICUT NUMERUS.
    SI superficies==0 || destinatio==0 || pars==0 TUNC REDDE 0. FIN-SI.
    DECLARA dx SICUT NUMERUS VALENS IRVII_RECT_X(destinatio).
    DECLARA dy SICUT NUMERUS VALENS IRVII_RECT_Y(destinatio).
    DECLARA dw SICUT NUMERUS VALENS IRVII_RECT_W(destinatio).
    DECLARA dh SICUT NUMERUS VALENS IRVII_RECT_H(destinatio).
    DECLARA sx SICUT NUMERUS VALENS IRVII_RECT_X(pars).
    DECLARA sy SICUT NUMERUS VALENS IRVII_RECT_Y(pars).
    DECLARA sw SICUT NUMERUS VALENS IRVII_RECT_W(pars).
    DECLARA sh SICUT NUMERUS VALENS IRVII_RECT_H(pars).
    SI IRVII_PARTEM_VALIDAM(imago,sx,sy,sw,sh)==0 TUNC REDDE 0. FIN-SI.
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py<dh PERFICE
        DECLARA fy SICUT NUMERUS VALENS sy+(py*sh)/dh.
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px<dw PERFICE
            DECLARA fx SICUT NUMERUS VALENS sx+(px*sw)/dw.
            DECLARA rgba SICUT NUMERUS VALENS IRVII_PIXEL_EX_FONTE(imago,fx,fy).
            DECLARA a SICUT NUMERUS VALENS (rgba>>24)&255.
            SI a>0 TUNC
                DECLARA color SICUT NUMERUS VALENS IRVII_RGBA_AD_COLOR(rgba).
                DECLARA f SICUT NUMERUS VALENS GSVII_PIXEL_ALPHA(superficies,dx+px,dy+py,color,a).
            FIN-SI.
            px=px+1.
        FIN-DUM.
        py=py+1.
    FIN-DUM.
    DECLARA nota SICUT NUMERUS VALENS GSVII_NOTA(superficies).
    REDDE 1.
FIN-FUNCTIO.
