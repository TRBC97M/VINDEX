// Sylvia OS — P16-XII-C1: effectus productionis Graphica X.
// GX_* et effectus X ante hoc folium importentur.
// Cache effectus staticos servat; mutatio fontis generatione distinguitur.

// Gestor XLVIII octeta:
// 0 primus nodus, 8 numerus, 16 hit, 24 miss, 32 capacitas, 40 reservatum.
// Nodus XCVI octeta:
// 0 typus, 8..64 claves, 72 superficies, 80 proximum, 88 reservatum.

FUNCTIO XP_CACHE_CREA REDDENS NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    DECLARA c SICUT NUMERUS VALENS capacitas.
    SI c<1 TUNC c=1. FIN-SI. SI c>256 TUNC c=256. FIN-SI.
    DECLARA g SICUT NUMERUS VALENS RESERVA_OCTETA(48).
    SI g<=0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(g,48).
    CONTENTUM(g+32)=c.
    REDDE g.
FIN-FUNCTIO.

FUNCTIO XP_CACHE_HIT REDDENS NUMERUS. ACCIPIT g SICUT NUMERUS. SI g==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(g+16). FIN-FUNCTIO.
FUNCTIO XP_CACHE_MISS REDDENS NUMERUS. ACCIPIT g SICUT NUMERUS. SI g==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(g+24). FIN-FUNCTIO.
FUNCTIO XP_CACHE_NUMERUS REDDENS NUMERUS. ACCIPIT g SICUT NUMERUS. SI g==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(g+8). FIN-FUNCTIO.

FUNCTIO XP_RADIUS_ADAPT REDDENS NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT petitus SICUT NUMERUS.
    DECLARA r SICUT NUMERUS VALENS petitus.
    SI r<1 TUNC r=1. FIN-SI. SI r>24 TUNC r=24. FIN-SI.
    DECLARA area SICUT NUMERUS VALENS w*h.
    SI area>1048576 && r>8 TUNC r=8. FIN-SI.
    SI area>262144 && area<=1048576 && r>12 TUNC r=12. FIN-SI.
    SI area<=262144 && r>20 TUNC r=20. FIN-SI.
    REDDE r.
FIN-FUNCTIO.

FUNCTIO XP_BLUR_ADAPT REDDENS NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT radius SICUT NUMERUS.
    SI src==0 TUNC REDDE 0. FIN-SI.
    REDDE GX_BLUR(src,XP_RADIUS_ADAPT(GX_W(src),GX_H(src),radius)).
FIN-FUNCTIO.

FUNCTIO XP_NODUM_ADDE REDDENS NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT typus SICUT NUMERUS.
    SI g==0 || CONTENTUM(g+8)>=CONTENTUM(g+32) TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS RESERVA_OCTETA(96).
    SI n<=0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(n,96).
    CONTENTUM(n)=typus.
    CONTENTUM(n+80)=CONTENTUM(g).
    CONTENTUM(g)=n.
    CONTENTUM(g+8)=CONTENTUM(g+8)+1.
    REDDE n.
FIN-FUNCTIO.

FUNCTIO XP_UMBRA_CACHE REDDENS NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT radius SICUT NUMERUS.
    ACCIPIT blur SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    SI g==0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(g).
    DUM n!=0 PERFICE
        SI CONTENTUM(n)==1 && CONTENTUM(n+8)==w && CONTENTUM(n+16)==h && CONTENTUM(n+24)==radius && CONTENTUM(n+32)==blur && CONTENTUM(n+40)==color && CONTENTUM(n+48)==alpha TUNC
            CONTENTUM(g+16)=CONTENTUM(g+16)+1.
            REDDE CONTENTUM(n+72).
        FIN-SI.
        n=CONTENTUM(n+80).
    FIN-DUM.
    CONTENTUM(g+24)=CONTENTUM(g+24)+1.
    DECLARA s SICUT NUMERUS VALENS GX_UMBRA_CREA(w,h,radius,blur,color,alpha).
    SI s==0 TUNC REDDE 0. FIN-SI.
    DECLARA novus SICUT NUMERUS VALENS XP_NODUM_ADDE(g,1).
    SI novus!=0 TUNC
        CONTENTUM(novus+8)=w. CONTENTUM(novus+16)=h. CONTENTUM(novus+24)=radius.
        CONTENTUM(novus+32)=blur. CONTENTUM(novus+40)=color. CONTENTUM(novus+48)=alpha.
        CONTENTUM(novus+72)=s.
    FIN-SI.
    REDDE s.
FIN-FUNCTIO.

FUNCTIO XP_BACKDROP_CACHE REDDENS NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    ACCIPIT radius SICUT NUMERUS.
    ACCIPIT tinctura SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    SI g==0 || src==0 || rectum==0 TUNC REDDE 0. FIN-SI.
    DECLARA x SICUT NUMERUS VALENS GVIII_RECT_X(rectum). DECLARA y SICUT NUMERUS VALENS GVIII_RECT_Y(rectum).
    DECLARA w SICUT NUMERUS VALENS GVIII_RECT_W(rectum). DECLARA h SICUT NUMERUS VALENS GVIII_RECT_H(rectum).
    DECLARA gen SICUT NUMERUS VALENS CONTENTUM(src+72).
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(g).
    DUM n!=0 PERFICE
        SI CONTENTUM(n)==2 && CONTENTUM(n+8)==src && CONTENTUM(n+16)==gen && CONTENTUM(n+24)==x && CONTENTUM(n+32)==y && CONTENTUM(n+40)==w && CONTENTUM(n+48)==h && CONTENTUM(n+56)==radius && CONTENTUM(n+64)==tinctura TUNC
            // Alpha tinctura in campo reservato cum superficie non miscetur; nodi diversi
            // pro alpha diverso per generationem sequentem creantur per clavem compactam.
            SI CONTENTUM(n+88)==alpha TUNC
                CONTENTUM(g+16)=CONTENTUM(g+16)+1.
                REDDE CONTENTUM(n+72).
            FIN-SI.
        FIN-SI.
        n=CONTENTUM(n+80).
    FIN-DUM.
    CONTENTUM(g+24)=CONTENTUM(g+24)+1.
    DECLARA capta SICUT NUMERUS VALENS GX_COPIA_RECT(src,rectum).
    SI capta==0 TUNC REDDE 0. FIN-SI.
    DECLARA mollis SICUT NUMERUS VALENS XP_BLUR_ADAPT(capta,radius).
    SI mollis==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_RECT_ALPHA(mollis,GVIII_RECT_CREA(0,0,GX_W(mollis),GX_H(mollis)),tinctura,alpha).
    DECLARA novus SICUT NUMERUS VALENS XP_NODUM_ADDE(g,2).
    SI novus!=0 TUNC
        CONTENTUM(novus+8)=src. CONTENTUM(novus+16)=gen. CONTENTUM(novus+24)=x.
        CONTENTUM(novus+32)=y. CONTENTUM(novus+40)=w. CONTENTUM(novus+48)=h.
        CONTENTUM(novus+56)=radius. CONTENTUM(novus+64)=tinctura. CONTENTUM(novus+72)=mollis.
        CONTENTUM(novus+88)=alpha.
    FIN-SI.
    REDDE mollis.
FIN-FUNCTIO.

FUNCTIO XP_CLIP_COPIA REDDENS NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    REDDE GX_COPIA_RECT(src,rectum).
FIN-FUNCTIO.

FUNCTIO XP_MASCA_APPLICA REDDENS NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT masca SICUT NUMERUS.
    SI src==0 || masca==0 || GX_W(src)!=GX_W(masca) || GX_H(src)!=GX_H(masca) TUNC REDDE 0. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS GX_W(src). DECLARA h SICUT NUMERUS VALENS GX_H(src).
    DECLARA dst SICUT NUMERUS VALENS GX_CREA(w,h). SI dst==0 TUNC REDDE 0. FIN-SI.
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<h PERFICE
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x<w PERFICE
            DECLARA q SICUT NUMERUS VALENS GX_PIX_PM_LEGE(src,x,y).
            DECLARA m SICUT NUMERUS VALENS GX_PIX_PM_LEGE(masca,x,y).
            DECLARA ma SICUT NUMERUS VALENS (m>>24)&255.
            DECLARA r SICUT NUMERUS VALENS (q&255)*ma/255.
            DECLARA gg SICUT NUMERUS VALENS ((q>>8)&255)*ma/255.
            DECLARA b SICUT NUMERUS VALENS ((q>>16)&255)*ma/255.
            DECLARA a SICUT NUMERUS VALENS ((q>>24)&255)*ma/255.
            DECLARA f SICUT NUMERUS VALENS GX_PIX_PM_PONE(dst,x,y,r|(gg<<8)|(b<<16)|(a<<24)).
            x=x+1.
        FIN-DUM.
        y=y+1.
    FIN-DUM.
    DECLARA nota SICUT NUMERUS VALENS GX_DAMNA_NOTA(dst,GVIII_RECT_CREA(0,0,w,h)).
    REDDE dst.
FIN-FUNCTIO.

FUNCTIO XP_GLOSS REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    SI s==0 || rectum==0 || alpha<=0 TUNC REDDE 0. FIN-SI.
    DECLARA x SICUT NUMERUS VALENS GVIII_RECT_X(rectum). DECLARA y SICUT NUMERUS VALENS GVIII_RECT_Y(rectum).
    DECLARA w SICUT NUMERUS VALENS GVIII_RECT_W(rectum). DECLARA h SICUT NUMERUS VALENS GVIII_RECT_H(rectum).
    SI w<=0 || h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA gh SICUT NUMERUS VALENS h/3. SI gh<2 TUNC gh=2. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<gh PERFICE
        DECLARA a SICUT NUMERUS VALENS alpha*(gh-i)/gh.
        DECLARA f SICUT NUMERUS VALENS GX_RECT_ALPHA(s,GVIII_RECT_CREA(x+1,y+i,w-2,1),color,a).
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.
