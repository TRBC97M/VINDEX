    SI BX_PARATUS(b)==0 TUNC CONTENTUM(b+40)=4. REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=0 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    SI QVIII_RESET(CONTENTUM(b+24))==0 TUNC CONTENTUM(b+40)=3. REDDE 0. FIN-SI.
    CONTENTUM(b+32)=1. CONTENTUM(b+40)=0.
    REDDE CONTENTUM(b+48).
FIN-FUNCTIO.

FUNCTIO BX_PRAESENTA_ADDE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 || superficies==0 || rectum==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=1 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    DECLARA limen SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,GX_W(superficies),GX_H(superficies)).
    DECLARA qrect SICUT NUMERUS VALENS GVIII_RECT_SECA(rectum,limen).
    SI qrect==0 TUNC CONTENTUM(b+40)=5. REDDE 0. FIN-SI.
    SI QVIII_ADDE(CONTENTUM(b+24),BX_OP_PRAESENTA(),superficies,qrect,0,0,0)==0 TUNC
        CONTENTUM(b+40)=3. REDDE 0.
    FIN-SI.
    CONTENTUM(b+64)=CONTENTUM(b+64)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_COPIA_ADDE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT dst SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT src_rect SICUT NUMERUS.
    ACCIPIT dst_rect SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 || dst==0 || src==0 || src_rect==0 || dst_rect==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=1 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    SI GVIII_RECT_W(src_rect)!=GVIII_RECT_W(dst_rect) || GVIII_RECT_H(src_rect)!=GVIII_RECT_H(dst_rect) TUNC CONTENTUM(b+40)=5. REDDE 0. FIN-SI.
    SI BX_TEXTURE_PARA(b,src)==0 TUNC REDDE 0. FIN-SI.
    SI QVIII_ADDE(CONTENTUM(b+24),BX_OP_COPIA(),dst,src,src_rect,dst_rect,255)==0 TUNC CONTENTUM(b+40)=3. REDDE 0. FIN-SI.
    CONTENTUM(b+64)=CONTENTUM(b+64)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_COMPONE_ADDE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT dst SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT src_rect SICUT NUMERUS.
    ACCIPIT dst_rect SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 || dst==0 || src==0 || src_rect==0 || dst_rect==0 || alpha<=0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=1 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    SI GVIII_RECT_W(src_rect)!=GVIII_RECT_W(dst_rect) || GVIII_RECT_H(src_rect)!=GVIII_RECT_H(dst_rect) TUNC CONTENTUM(b+40)=5. REDDE 0. FIN-SI.
    SI BX_TEXTURE_PARA(b,src)==0 TUNC REDDE 0. FIN-SI.
    SI QVIII_ADDE(CONTENTUM(b+24),BX_OP_COMPONE(),dst,src,src_rect,dst_rect,GVIII_CLAMPA(alpha,0,255))==0 TUNC CONTENTUM(b+40)=3. REDDE 0. FIN-SI.
