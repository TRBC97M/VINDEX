// Sylvia OS — P16-XII-F: contractus backendis Graphica X accelerabilis.
// GX_* et GVIII_* ante hoc folium importentur.
//
// Descriptor backendis CXXVIII octeta:
//  0 versio ABI, 8 genus, 16 capacitates, 24 coda QVIII,
// 32 status framei, 40 erratum, 48 fence proxima, 56 fence completa,
// 64 mandata recepta, 72 mandata completa, 80 target software,
// 88 numerus fallback, 96 executor reservatus, 104 vexilla,
// 112 cache texturarum TXC, 120 contextus reservatus.
//
// Target software XL octeta:
//  0 basis, 8 stride pixelorum, 16 w, 24 h, 32 formatum GOP.
// Target 0 significat framebuffer canonicum a ponticulo UEFI traditum.
//
// Coda est contractus, non promissum GPU fictum. Genus GPU reservatur,
// sed backend software manet sola implementatio parata donec P12 id sinit.

FUNCTIO BX_ABI REDDENS NUMERUS. REDDE 1. FIN-FUNCTIO.
FUNCTIO BX_GENUS_SOFTWARE REDDENS NUMERUS. REDDE 1. FIN-FUNCTIO.
FUNCTIO BX_GENUS_GPU REDDENS NUMERUS. REDDE 2. FIN-FUNCTIO.
FUNCTIO BX_CAP_CODA REDDENS NUMERUS. REDDE 1. FIN-FUNCTIO.
FUNCTIO BX_CAP_REGION REDDENS NUMERUS. REDDE 2. FIN-FUNCTIO.
FUNCTIO BX_CAP_RGBA_PM REDDENS NUMERUS. REDDE 4. FIN-FUNCTIO.
FUNCTIO BX_CAP_PRAESENTA REDDENS NUMERUS. REDDE 8. FIN-FUNCTIO.
FUNCTIO BX_CAP_TEXTURE REDDENS NUMERUS. REDDE 16. FIN-FUNCTIO.
FUNCTIO BX_OP_PRAESENTA REDDENS NUMERUS. REDDE 256. FIN-FUNCTIO.

FUNCTIO BX_CAP_MINIMUM REDDENS NUMERUS.
    REDDE BX_CAP_CODA()|BX_CAP_REGION()|BX_CAP_RGBA_PM()|BX_CAP_PRAESENTA().
FIN-FUNCTIO.

FUNCTIO BX_TARGET_CREA REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT stride SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT formatum SICUT NUMERUS.
    SI basis==0 || w<=0 || h<=0 || stride<w || formatum<0 || formatum>1 TUNC REDDE 0. FIN-SI.
    DECLARA t SICUT NUMERUS VALENS RESERVA_OCTETA(40).
    SI t==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(t)=basis. CONTENTUM(t+8)=stride.
    CONTENTUM(t+16)=w. CONTENTUM(t+24)=h. CONTENTUM(t+32)=formatum.
    REDDE t.
FIN-FUNCTIO.

FUNCTIO BX_CREA_SW_TARGET REDDENS NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    ACCIPIT target SICUT NUMERUS.
    DECLARA q SICUT NUMERUS VALENS QVIII_CREA(capacitas).
    SI q==0 TUNC REDDE 0. FIN-SI.
    DECLARA b SICUT NUMERUS VALENS RESERVA_OCTETA(128).
    SI b==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(b,128).
    CONTENTUM(b)=BX_ABI(). CONTENTUM(b+8)=BX_GENUS_SOFTWARE().
    CONTENTUM(b+16)=BX_CAP_MINIMUM(). CONTENTUM(b+24)=q.
    CONTENTUM(b+48)=1. CONTENTUM(b+80)=target. CONTENTUM(b+104)=1.
    REDDE b.
FIN-FUNCTIO.

FUNCTIO BX_CREA_SW REDDENS NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    REDDE BX_CREA_SW_TARGET(capacitas,0).
FIN-FUNCTIO.

FUNCTIO BX_CACHE_INSTITUE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    ACCIPIT limes SICUT NUMERUS.
    SI b==0 || CONTENTUM(b+32)!=0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+112)!=0 TUNC REDDE CONTENTUM(b+112). FIN-SI.
    DECLARA cache SICUT NUMERUS VALENS TXC_CREA(capacitas,limes).
    SI cache==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(b+112)=cache. CONTENTUM(b+16)=CONTENTUM(b+16)|BX_CAP_TEXTURE().
    REDDE cache.
FIN-FUNCTIO.

FUNCTIO BX_CACHE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI b==0 || (CONTENTUM(b+16)&BX_CAP_TEXTURE())==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(b+112).
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_PETE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE(b).
    SI cache==0 TUNC REDDE 0. FIN-SI.
    REDDE TXC_PETE(cache,superficies).
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_RELAXA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE(b).
    SI cache==0 TUNC REDDE 0. FIN-SI.
    REDDE TXC_RELAXA(cache,nodus).
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_INVALIDA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE(b).
    SI cache==0 TUNC REDDE 0. FIN-SI.
    REDDE TXC_INVALIDA(cache,superficies).
FIN-FUNCTIO.

FUNCTIO BX_COMPATIBILIS REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI b==0 || CONTENTUM(b)!=BX_ABI() || CONTENTUM(b+24)==0 TUNC REDDE 0. FIN-SI.
    SI (CONTENTUM(b+16)&BX_CAP_MINIMUM())!=BX_CAP_MINIMUM() TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+8)!=BX_GENUS_SOFTWARE() && CONTENTUM(b+8)!=BX_GENUS_GPU() TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_PARATUS REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 || (CONTENTUM(b+104)&1)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+8)==BX_GENUS_SOFTWARE() TUNC REDDE 1. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO BX_ELIGE REDDENS NUMERUS.
    ACCIPIT candidatus SICUT NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    SI BX_PARATUS(candidatus)!=0 TUNC REDDE candidatus. FIN-SI.
    DECLARA b SICUT NUMERUS VALENS BX_CREA_SW(capacitas).
    SI b!=0 && candidatus!=0 TUNC CONTENTUM(b+88)=CONTENTUM(b+88)+1. FIN-SI.
    REDDE b.
FIN-FUNCTIO.

FUNCTIO BX_CODA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(b+24).
FIN-FUNCTIO.

FUNCTIO BX_ERRATUM REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI b==0 TUNC REDDE -1. FIN-SI.
    REDDE CONTENTUM(b+40).
FIN-FUNCTIO.

FUNCTIO BX_FENCE_COMPLETA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI b==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(b+56).
FIN-FUNCTIO.

FUNCTIO BX_FRAME_INCIPE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 TUNC REDDE 0. FIN-SI.
    SI BX_PARATUS(b)==0 TUNC CONTENTUM(b+40)=4. REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=0 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    SI QVIII_RESET(CONTENTUM(b+24))==0 TUNC CONTENTUM(b+40)=3. REDDE 0. FIN-SI.
    CONTENTUM(b+32)=1. CONTENTUM(b+40)=0.
    REDDE CONTENTUM(b+48).
FIN-FUNCTIO.

FUNCTIO BX_PRAESENTA_ADDE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 || superficies==0 || rectum==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=1 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    DECLARA limen SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,GX_W(superficies),GX_H(superficies)).
    DECLARA qrect SICUT NUMERUS VALENS GVIII_RECT_SECA(rectum,limen).
    SI qrect==0 TUNC CONTENTUM(b+40)=5. REDDE 0. FIN-SI.
    SI QVIII_ADDE(CONTENTUM(b+24),BX_OP_PRAESENTA(),superficies,qrect,0,0,0)==0 TUNC
        CONTENTUM(b+40)=3. REDDE 0.
    FIN-SI.
    CONTENTUM(b+64)=CONTENTUM(b+64)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_FRAME_ABICE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS QVIII_RESET(CONTENTUM(b+24)).
    CONTENTUM(b+32)=0. CONTENTUM(b+40)=0.
    REDDE f.
FIN-FUNCTIO.

FUNCTIO BX_SW_TARGET_LEGE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT index SICUT NUMERUS.
    DECLARA t SICUT NUMERUS VALENS CONTENTUM(b+80).
    SI t!=0 TUNC REDDE CONTENTUM(t+index*8). FIN-SI.
    SI index==0 TUNC REDDE CONTENTUM(50333712). FIN-SI.
    SI index==1 TUNC REDDE CONTENTUM(50333720). FIN-SI.
    SI index==2 TUNC REDDE CONTENTUM(50333728). FIN-SI.
    SI index==3 TUNC REDDE CONTENTUM(50333736). FIN-SI.
    SI index==4 TUNC REDDE CONTENTUM(50333744). FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO BX_SW_PRAESENTA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    SI b==0 || src==0 || rectum==0 TUNC REDDE 0. FIN-SI.
    DECLARA basis_fb SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,0).
    DECLARA linea_fb SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,1).
    DECLARA fw SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,2).
    DECLARA fh SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,3).
    DECLARA forma SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,4).
    SI basis_fb==0 || fw<=0 || fh<=0 || linea_fb<fw || forma<0 || forma>1 TUNC REDDE 0. FIN-SI.
    DECLARA limen_fb SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,fw,fh).
    DECLARA limen_src SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,GX_W(src),GX_H(src)).
    DECLARA qrect SICUT NUMERUS VALENS GVIII_RECT_SECA(rectum,limen_src).
    SI qrect!=0 TUNC qrect=GVIII_RECT_SECA(qrect,limen_fb). FIN-SI.
    SI qrect==0 TUNC REDDE 0. FIN-SI.
    DECLARA x0 SICUT NUMERUS VALENS GVIII_RECT_X(qrect). DECLARA y0 SICUT NUMERUS VALENS GVIII_RECT_Y(qrect).
    DECLARA w SICUT NUMERUS VALENS GVIII_RECT_W(qrect). DECLARA h SICUT NUMERUS VALENS GVIII_RECT_H(qrect).
    DECLARA basis_src SICUT NUMERUS VALENS GX_BASIS(src). DECLARA linea_src SICUT NUMERUS VALENS CONTENTUM(src+16).
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<h PERFICE
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x+1<w PERFICE
            DECLARA sp SICUT NUMERUS VALENS basis_src+((y0+y)*linea_src+x0+x)*4.
            DECLARA dp SICUT NUMERUS VALENS basis_fb+((y0+y)*linea_fb+x0+x)*4.
            DECLARA duo SICUT NUMERUS VALENS CONTENTUM(sp).
            DECLARA a0 SICUT NUMERUS VALENS (duo>>24)&255. DECLARA a1 SICUT NUMERUS VALENS (duo>>56)&255.
            SI a0==255 && a1==255 TUNC
                SI forma==0 TUNC
                    CONTENTUM(dp)=duo&72057589759737855.
                ALITER
                    DECLARA q0 SICUT NUMERUS VALENS duo&4294967295. DECLARA q1 SICUT NUMERUS VALENS (duo>>32)&4294967295.
                    DECLARA c0 SICUT NUMERUS VALENS ((q0&255)<<16)|(q0&65280)|((q0>>16)&255).
                    DECLARA c1 SICUT NUMERUS VALENS ((q1&255)<<16)|(q1&65280)|((q1>>16)&255).
                    CONTENTUM(dp)=c0+c1*4294967296.
                FIN-SI.
            ALITER
                DECLARA j SICUT NUMERUS VALENS 0.
                DUM j<2 PERFICE
                    DECLARA q SICUT NUMERUS VALENS (duo>>(j*32))&4294967295.
                    DECLARA a SICUT NUMERUS VALENS (q>>24)&255.
                    DECLARA r SICUT NUMERUS VALENS q&255. DECLARA g SICUT NUMERUS VALENS (q>>8)&255. DECLARA bl SICUT NUMERUS VALENS (q>>16)&255.
                    SI a>0 && a<255 TUNC r=GVIII_CLAMPA((r*255+a/2)/a,0,255). g=GVIII_CLAMPA((g*255+a/2)/a,0,255). bl=GVIII_CLAMPA((bl*255+a/2)/a,0,255). FIN-SI.
                    SI forma!=0 TUNC DECLARA t SICUT NUMERUS VALENS r. r=bl. bl=t. FIN-SI.
                    DECLARA p SICUT NUMERUS VALENS dp+j*4.
                    SCRIBE_OCTETUM_AB(p,r). SCRIBE_OCTETUM_AB(p+1,g). SCRIBE_OCTETUM_AB(p+2,bl). SCRIBE_OCTETUM_AB(p+3,0).
                    j=j+1.
                FIN-DUM.
            FIN-SI.
            x=x+2.
        FIN-DUM.
        SI x<w TUNC
            DECLARA q2 SICUT NUMERUS VALENS GX_PIX_PM_LEGE(src,x0+x,y0+y). DECLARA a2 SICUT NUMERUS VALENS (q2>>24)&255.
            DECLARA r2 SICUT NUMERUS VALENS q2&255. DECLARA g2 SICUT NUMERUS VALENS (q2>>8)&255. DECLARA b2 SICUT NUMERUS VALENS (q2>>16)&255.
            SI a2>0 && a2<255 TUNC r2=GVIII_CLAMPA((r2*255+a2/2)/a2,0,255). g2=GVIII_CLAMPA((g2*255+a2/2)/a2,0,255). b2=GVIII_CLAMPA((b2*255+a2/2)/a2,0,255). FIN-SI.
            SI forma!=0 TUNC DECLARA t2 SICUT NUMERUS VALENS r2. r2=b2. b2=t2. FIN-SI.
            DECLARA p2 SICUT NUMERUS VALENS basis_fb+((y0+y)*linea_fb+x0+x)*4.
            SCRIBE_OCTETUM_AB(p2,r2). SCRIBE_OCTETUM_AB(p2+1,g2). SCRIBE_OCTETUM_AB(p2+2,b2). SCRIBE_OCTETUM_AB(p2+3,0).
        FIN-SI.
        y=y+1.
    FIN-DUM.
    REDDE w*h.
FIN-FUNCTIO.

FUNCTIO BX_CODA_EXSEQUERE_SW REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    DECLARA q SICUT NUMERUS VALENS CONTENTUM(b+24).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<QVIII_NUMERUS(q) PERFICE
        DECLARA op SICUT NUMERUS VALENS QVIII_OPCODE(q,i).
        SI op!=BX_OP_PRAESENTA() TUNC CONTENTUM(b+40)=4. REDDE 0. FIN-SI.
        DECLARA n SICUT NUMERUS VALENS BX_SW_PRAESENTA(b,QVIII_A(q,i),QVIII_B(q,i)).
        SI n<=0 TUNC CONTENTUM(b+40)=6. REDDE 0. FIN-SI.
        CONTENTUM(b+72)=CONTENTUM(b+72)+1.
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_FRAME_COMMITTE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=1 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    SI QVIII_NUMERUS(CONTENTUM(b+24))<=0 TUNC CONTENTUM(b+40)=3. CONTENTUM(b+32)=0. REDDE 0. FIN-SI.
    SI CONTENTUM(b+8)!=BX_GENUS_SOFTWARE() TUNC CONTENTUM(b+40)=4. CONTENTUM(b+32)=0. REDDE 0. FIN-SI.
    SI BX_CODA_EXSEQUERE_SW(b)==0 TUNC CONTENTUM(b+32)=0. REDDE 0. FIN-SI.
    DECLARA fence SICUT NUMERUS VALENS CONTENTUM(b+48).
    CONTENTUM(b+56)=fence. CONTENTUM(b+48)=fence+1.
    CONTENTUM(b+32)=0. CONTENTUM(b+40)=0.
    REDDE fence.
FIN-FUNCTIO.
