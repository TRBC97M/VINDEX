    DECLARA t SICUT NUMERUS VALENS BX_TEXTURES_RELAXA(b).
    DECLARA f SICUT NUMERUS VALENS QVIII_RESET(CONTENTUM(b+24)).
    CONTENTUM(b+32)=0. CONTENTUM(b+40)=0.
    REDDE f.
FIN-FUNCTIO.

FUNCTIO BX_SW_TARGET_LEGE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT index SICUT NUMERUS.
    DECLARA t SICUT NUMERUS VALENS CONTENTUM(b+80).
    SI t!=0 TUNC REDDE CONTENTUM(t+index*8). FIN-SI.
    SI index==0 TUNC REDDE CONTENTUM(50333712). FIN-SI.
    SI index==1 TUNC REDDE CONTENTUM(50333720). FIN-SI.
    SI index==2 TUNC REDDE CONTENTUM(50333728). FIN-SI.
    SI index==3 TUNC REDDE CONTENTUM(50333736). FIN-SI.
    SI index==4 TUNC REDDE CONTENTUM(50333744). FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO BX_SW_PRAESENTA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    SI b==0 || src==0 || rectum==0 TUNC REDDE 0. FIN-SI.
    DECLARA basis_fb SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,0).
    DECLARA linea_fb SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,1).
    DECLARA fw SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,2).
    DECLARA fh SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,3).
    DECLARA forma SICUT NUMERUS VALENS BX_SW_TARGET_LEGE(b,4).
    SI basis_fb==0 || fw<=0 || fh<=0 || linea_fb<fw || forma<0 || forma>1 TUNC REDDE 0. FIN-SI.
    DECLARA limen_fb SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,fw,fh).
    DECLARA limen_src SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,GX_W(src),GX_H(src)).
    DECLARA qrect SICUT NUMERUS VALENS GVIII_RECT_SECA(rectum,limen_src).
    SI qrect!=0 TUNC qrect=GVIII_RECT_SECA(qrect,limen_fb). FIN-SI.
    SI qrect==0 TUNC REDDE 0. FIN-SI.
    DECLARA x0 SICUT NUMERUS VALENS GVIII_RECT_X(qrect). DECLARA y0 SICUT NUMERUS VALENS GVIII_RECT_Y(qrect).
    DECLARA w SICUT NUMERUS VALENS GVIII_RECT_W(qrect). DECLARA h SICUT NUMERUS VALENS GVIII_RECT_H(qrect).
    DECLARA basis_src SICUT NUMERUS VALENS GX_BASIS(src). DECLARA linea_src SICUT NUMERUS VALENS CONTENTUM(src+16).
    DECLARA y SICUT NUMERUS VALENS 0.
    DUM y<h PERFICE
        DECLARA x SICUT NUMERUS VALENS 0.
        DUM x+1<w PERFICE
            DECLARA sp SICUT NUMERUS VALENS basis_src+((y0+y)*linea_src+x0+x)*4.
            DECLARA dp SICUT NUMERUS VALENS basis_fb+((y0+y)*linea_fb+x0+x)*4.
            DECLARA duo SICUT NUMERUS VALENS CONTENTUM(sp).
            DECLARA a0 SICUT NUMERUS VALENS (duo>>24)&255. DECLARA a1 SICUT NUMERUS VALENS (duo>>56)&255.
            SI a0==255 && a1==255 TUNC
                SI forma==0 TUNC
                    CONTENTUM(dp)=duo&72057589759737855.
                ALITER
                    DECLARA q0 SICUT NUMERUS VALENS duo&4294967295. DECLARA q1 SICUT NUMERUS VALENS (duo>>32)&4294967295.
                    DECLARA c0 SICUT NUMERUS VALENS ((q0&255)<<16)|(q0&65280)|((q0>>16)&255).
                    DECLARA c1 SICUT NUMERUS VALENS ((q1&255)<<16)|(q1&65280)|((q1>>16)&255).
                    CONTENTUM(dp)=c0+c1*4294967296.
                FIN-SI.
            ALITER
                DECLARA j SICUT NUMERUS VALENS 0.
                DUM j<2 PERFICE
                    DECLARA q SICUT NUMERUS VALENS (duo>>(j*32))&4294967295.
                    DECLARA a SICUT NUMERUS VALENS (q>>24)&255.
                    DECLARA r SICUT NUMERUS VALENS q&255. DECLARA g SICUT NUMERUS VALENS (q>>8)&255. DECLARA bl SICUT NUMERUS VALENS (q>>16)&255.
                    SI a>0 && a<255 TUNC r=GVIII_CLAMPA((r*255+a/2)/a,0,255). g=GVIII_CLAMPA((g*255+a/2)/a,0,255). bl=GVIII_CLAMPA((bl*255+a/2)/a,0,255). FIN-SI.
                    SI forma!=0 TUNC DECLARA t SICUT NUMERUS VALENS r. r=bl. bl=t. FIN-SI.
                    DECLARA p SICUT NUMERUS VALENS dp+j*4.
                    SCRIBE_OCTETUM_AB(p,r). SCRIBE_OCTETUM_AB(p+1,g). SCRIBE_OCTETUM_AB(p+2,bl). SCRIBE_OCTETUM_AB(p+3,0).
                    j=j+1.
                FIN-DUM.
            FIN-SI.
            x=x+2.
        FIN-DUM.
        SI x<w TUNC
            DECLARA q2 SICUT NUMERUS VALENS GX_PIX_PM_LEGE(src,x0+x,y0+y). DECLARA a2 SICUT NUMERUS VALENS (q2>>24)&255.
            DECLARA r2 SICUT NUMERUS VALENS q2&255. DECLARA g2 SICUT NUMERUS VALENS (q2>>8)&255. DECLARA b2 SICUT NUMERUS VALENS (q2>>16)&255.
            SI a2>0 && a2<255 TUNC r2=GVIII_CLAMPA((r2*255+a2/2)/a2,0,255). g2=GVIII_CLAMPA((g2*255+a2/2)/a2,0,255). b2=GVIII_CLAMPA((b2*255+a2/2)/a2,0,255). FIN-SI.
            SI forma!=0 TUNC DECLARA t2 SICUT NUMERUS VALENS r2. r2=b2. b2=t2. FIN-SI.
            DECLARA p2 SICUT NUMERUS VALENS basis_fb+((y0+y)*linea_fb+x0+x)*4.
            SCRIBE_OCTETUM_AB(p2,r2). SCRIBE_OCTETUM_AB(p2+1,g2). SCRIBE_OCTETUM_AB(p2+2,b2). SCRIBE_OCTETUM_AB(p2+3,0).
        FIN-SI.
        y=y+1.
    FIN-DUM.
    REDDE w*h.
FIN-FUNCTIO.

FUNCTIO BX_SW_RESOURCE_CREA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT generatio SICUT NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT octeta SICUT NUMERUS.
    SI BX_RESOURCE_VALIDA(b,r)==0 || superficies==0 || CONTENTUM(r+8)!=superficies || CONTENTUM(r+32)!=0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(r+72)!=BX_OP_TEXTURE_CREA() || CONTENTUM(superficies+72)!=generatio || GX_BASIS(superficies)!=basis || CONTENTUM(r+64)!=octeta TUNC REDDE 0. FIN-SI.
    CONTENTUM(r+24)=CONTENTUM(r). CONTENTUM(r+32)=1.
    CONTENTUM(b+152)=CONTENTUM(b+152)+1. CONTENTUM(b+176)=CONTENTUM(b+176)+octeta. CONTENTUM(b+184)=CONTENTUM(b+184)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_SW_RESOURCE_RENOVA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT generatio SICUT NUMERUS.
    ACCIPIT vetus SICUT NUMERUS.
    SI BX_RESOURCE_VALIDA(b,r)==0 || superficies==0 || CONTENTUM(r+8)!=superficies || CONTENTUM(r+32)!=1 || CONTENTUM(r+24)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(r+72)!=BX_OP_TEXTURE_RENOVA() || CONTENTUM(r+16)!=vetus || CONTENTUM(superficies+72)!=generatio TUNC REDDE 0. FIN-SI.
    CONTENTUM(r+16)=generatio. CONTENTUM(r+56)=CONTENTUM(r+56)+1. CONTENTUM(b+160)=CONTENTUM(b+160)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_SW_RESOURCE_LIBERA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    ACCIPIT manubrium SICUT NUMERUS.
    ACCIPIT generatio SICUT NUMERUS.
    ACCIPIT octeta SICUT NUMERUS.
    SI BX_RESOURCE_VALIDA(b,r)==0 || CONTENTUM(r+32)!=1 || CONTENTUM(r+24)!=manubrium || CONTENTUM(r+16)!=generatio TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(r+72)!=BX_OP_TEXTURE_LIBERA() || CONTENTUM(r+64)!=octeta TUNC REDDE 0. FIN-SI.
    CONTENTUM(r+24)=0. CONTENTUM(r+32)=2.
    CONTENTUM(b+168)=CONTENTUM(b+168)+1. CONTENTUM(b+176)=CONTENTUM(b+176)-octeta. CONTENTUM(b+184)=CONTENTUM(b+184)-1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_SW_RESOURCE_REVERTE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT q SICUT NUMERUS.
    ACCIPIT ultimus SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS ultimus.
    DECLARA mutata SICUT NUMERUS VALENS 0.
    DUM i>=0 PERFICE
        DECLARA op SICUT NUMERUS VALENS QVIII_OPCODE(q,i).
        DECLARA r SICUT NUMERUS VALENS QVIII_A(q,i).
        SI op==BX_OP_TEXTURE_CREA() && r!=0 && CONTENTUM(r+32)==1 TUNC
            CONTENTUM(r+24)=0. CONTENTUM(r+32)=0.
            CONTENTUM(b+152)=CONTENTUM(b+152)-1. CONTENTUM(b+176)=CONTENTUM(b+176)-CONTENTUM(r+64). CONTENTUM(b+184)=CONTENTUM(b+184)-1. mutata=mutata+1.
        FIN-SI.
        SI op==BX_OP_TEXTURE_RENOVA() && r!=0 && CONTENTUM(r+32)==1 TUNC
            CONTENTUM(r+16)=QVIII_D(q,i). CONTENTUM(r+56)=CONTENTUM(r+56)-1. CONTENTUM(b+160)=CONTENTUM(b+160)-1. mutata=mutata+1.
        FIN-SI.
        SI op==BX_OP_TEXTURE_LIBERA() && r!=0 && CONTENTUM(r+32)==2 TUNC
            CONTENTUM(r+24)=QVIII_B(q,i). CONTENTUM(r+32)=1.
            CONTENTUM(b+168)=CONTENTUM(b+168)-1. CONTENTUM(b+176)=CONTENTUM(b+176)+QVIII_D(q,i). CONTENTUM(b+184)=CONTENTUM(b+184)+1. mutata=mutata+1.
        FIN-SI.
        i=i-1.
    FIN-DUM.
    REDDE mutata.
FIN-FUNCTIO.

FUNCTIO BX_CODA_EXSEQUERE_SW REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    DECLARA q SICUT NUMERUS VALENS CONTENTUM(b+24).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<QVIII_NUMERUS(q) PERFICE
        DECLARA op SICUT NUMERUS VALENS QVIII_OPCODE(q,i).
        DECLARA n SICUT NUMERUS VALENS 0.
        SI op==BX_OP_PRAESENTA() TUNC n=BX_SW_PRAESENTA(b,QVIII_A(q,i),QVIII_B(q,i)). FIN-SI.
        SI op==BX_OP_TEXTURE_CREA() TUNC n=BX_SW_RESOURCE_CREA(b,QVIII_A(q,i),QVIII_B(q,i),QVIII_C(q,i),QVIII_D(q,i),QVIII_E(q,i)). FIN-SI.
        SI op==BX_OP_TEXTURE_RENOVA() TUNC n=BX_SW_RESOURCE_RENOVA(b,QVIII_A(q,i),QVIII_B(q,i),QVIII_C(q,i),QVIII_D(q,i)). FIN-SI.
        SI op==BX_OP_TEXTURE_LIBERA() TUNC n=BX_SW_RESOURCE_LIBERA(b,QVIII_A(q,i),QVIII_B(q,i),QVIII_C(q,i),QVIII_D(q,i)). FIN-SI.
        SI op==BX_OP_COPIA() TUNC n=GX_REGION_COPIA(QVIII_A(q,i),QVIII_B(q,i),QVIII_C(q,i),GVIII_RECT_X(QVIII_D(q,i)),GVIII_RECT_Y(QVIII_D(q,i))). FIN-SI.
        SI op==BX_OP_COMPONE() TUNC n=GX_REGION_COMPONE(QVIII_A(q,i),QVIII_B(q,i),QVIII_C(q,i),GVIII_RECT_X(QVIII_D(q,i)),GVIII_RECT_Y(QVIII_D(q,i)),QVIII_E(q,i)). FIN-SI.
        SI op==BX_OP_NOVEM() TUNC n=GX_NOVEM_COMPONE(QVIII_A(q,i),QVIII_B(q,i),QVIII_C(q,i),QVIII_D(q,i),QVIII_E(q,i)). FIN-SI.
        SI op<BX_OP_PRAESENTA() || op>BX_OP_TEXTURE_LIBERA() TUNC CONTENTUM(b+40)=4. DECLARA rv SICUT NUMERUS VALENS BX_SW_RESOURCE_REVERTE(b,q,i-1). REDDE 0. FIN-SI.
        SI n<=0 TUNC CONTENTUM(b+40)=6. DECLARA rv2 SICUT NUMERUS VALENS BX_SW_RESOURCE_REVERTE(b,q,i-1). REDDE 0. FIN-SI.
        CONTENTUM(b+72)=CONTENTUM(b+72)+1.
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_EXECUTOR_SUBMITTE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=1 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    SI QVIII_NUMERUS(CONTENTUM(b+24))<=0 TUNC CONTENTUM(b+40)=3. REDDE 0. FIN-SI.
    DECLARA executor SICUT NUMERUS VALENS CONTENTUM(b+96).
    SI BX_EXECUTOR_PARATUS_EST(executor)==0 TUNC CONTENTUM(b+40)=4. REDDE 0. FIN-SI.
    CONTENTUM(executor+32)=BX_EX_AGENS(). CONTENTUM(executor+40)=0.
    CONTENTUM(executor+48)=CONTENTUM(executor+48)+1. CONTENTUM(executor+72)=QVIII_NUMERUS(CONTENTUM(b+24)).
    DECLARA rectum SICUT NUMERUS VALENS 0.
    SI CONTENTUM(executor+8)==BX_GENUS_SOFTWARE() || CONTENTUM(executor+8)==BX_GENUS_GPU() TUNC rectum=BX_CODA_EXSEQUERE_SW(b). FIN-SI.
    SI rectum==0 TUNC
        SI CONTENTUM(b+40)==0 TUNC CONTENTUM(b+40)=4. FIN-SI.
        CONTENTUM(executor+40)=CONTENTUM(b+40). CONTENTUM(executor+64)=CONTENTUM(executor+64)+1.
        CONTENTUM(executor+32)=BX_EX_PARATUS(). REDDE 0.
    FIN-SI.
    CONTENTUM(executor+56)=CONTENTUM(executor+56)+1. CONTENTUM(executor+80)=CONTENTUM(b+48).
    CONTENTUM(executor+32)=BX_EX_PARATUS(). CONTENTUM(executor+40)=0.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_FRAME_COMMITTE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=1 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    DECLARA reconciliata SICUT NUMERUS VALENS BX_RESOURCE_RECONCILIA_ADDE(b).
    SI reconciliata<0 TUNC DECLARA a0 SICUT NUMERUS VALENS BX_FRAME_ABICE(b). CONTENTUM(b+40)=7. REDDE 0. FIN-SI.
    SI QVIII_NUMERUS(CONTENTUM(b+24))<=0 TUNC CONTENTUM(b+40)=3. DECLARA t0 SICUT NUMERUS VALENS BX_TEXTURES_RELAXA(b). CONTENTUM(b+32)=0. REDDE 0. FIN-SI.
    SI BX_EXECUTOR_SUBMITTE(b)==0 TUNC
        DECLARA erratum SICUT NUMERUS VALENS CONTENTUM(b+40).
        DECLARA p SICUT NUMERUS VALENS BX_RESOURCE_PENDENTIA_PURA(b).
        DECLARA t1 SICUT NUMERUS VALENS BX_TEXTURES_RELAXA(b).
        DECLARA purgatum SICUT NUMERUS VALENS QVIII_RESET(CONTENTUM(b+24)).
        CONTENTUM(b+32)=0. CONTENTUM(b+40)=erratum.
        REDDE 0.
    FIN-SI.
    DECLARA fence SICUT NUMERUS VALENS CONTENTUM(b+48).
    DECLARA p2 SICUT NUMERUS VALENS BX_RESOURCE_PENDENTIA_PURA(b).
    DECLARA t2 SICUT NUMERUS VALENS BX_TEXTURES_RELAXA(b).
    CONTENTUM(b+56)=fence. CONTENTUM(b+48)=fence+1.
    CONTENTUM(b+32)=0. CONTENTUM(b+40)=0.
    REDDE fence.
FIN-FUNCTIO.
