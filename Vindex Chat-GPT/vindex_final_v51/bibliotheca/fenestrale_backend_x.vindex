    ACCIPIT alpha SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 || dst==0 || src==0 || destinatio==0 || sectio==0 || alpha<=0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+32)!=1 TUNC CONTENTUM(b+40)=2. REDDE 0. FIN-SI.
    SI GX_W(src)<3 || GX_H(src)<3 TUNC CONTENTUM(b+40)=5. REDDE 0. FIN-SI.
    SI BX_TEXTURE_PARA(b,src)==0 TUNC REDDE 0. FIN-SI.
    SI QVIII_ADDE(CONTENTUM(b+24),BX_OP_NOVEM(),dst,src,destinatio,sectio,GVIII_CLAMPA(alpha,0,255))==0 TUNC CONTENTUM(b+40)=3. REDDE 0. FIN-SI.
