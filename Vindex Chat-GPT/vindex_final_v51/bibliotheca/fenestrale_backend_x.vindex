// Sylvia OS — P16-XII-F: contractus backendis Graphica X accelerabilis.
// GX_* et GVIII_* ante hoc folium importentur.
//
// Descriptor backendis CXCII octeta:
//  0 versio ABI, 8 genus, 16 capacitates, 24 coda QVIII,
// 32 status framei, 40 erratum, 48 fence proxima, 56 fence completa,
// 64 mandata recepta, 72 mandata completa, 80 target software,
// 88 numerus fallback, 96 executor BX, 104 vexilla,
// 112 cache texturarum TXC, 120 contextus exsecutoris,
// 128 resource activae, 136 reservatum, 144 identitas proxima,
// 152 creatae, 160 renovatae, 168 liberatae,
// 176 octeta residentia, 184 numerus residentium.
//
// Target software XL octeta:
//  0 basis, 8 stride pixelorum, 16 w, 24 h, 32 formatum GOP.
// Target 0 significat framebuffer canonicum a ponticulo UEFI traditum.
//
// Resource texturae LXXXVIII octeta:
//  0 identitas, 8 superficies GX, 16 generatio, 24 manubrium backendis,
// 32 status, 40 proxima, 48 nodus cache fibulatus, 56 renovationes,
// 64 octeta, 72 operatio pendens, 80 vexilla.
// Status 0 est nova, 1 residens, 2 liberata.
// Vexillum I significat resource a cache automatice gubernatam.
//
// Executor XCVI octeta:
//  0 versio ABI, 8 genus, 16 capacitates, 24 contextus,
// 32 status, 40 erratum ultimum, 48 submissiones, 56 completiones,
// 64 defectus, 72 mandata submissionis ultimae,
// 80 fence ultima completa, 88 vexilla.
// Status 0 est inactivus, 1 paratus, 2 agens.
//
// Coda et executor sunt contractus, non promissum GPU fictum. Executor
// software manet oracle semanticum. F7 eundem executorem compositionis cum
// target DMA et praesentatore VirtIO GPU coniungit; descriptor GPU tantum
// paratus fit post transportum, resource et scanout hardware consummata.

FUNCTIO BX_ABI REDDENS NUMERUS. REDDE 1. FIN-FUNCTIO.
FUNCTIO BX_EX_ABI REDDENS NUMERUS. REDDE 1. FIN-FUNCTIO.
FUNCTIO BX_GENUS_SOFTWARE REDDENS NUMERUS. REDDE 1. FIN-FUNCTIO.
FUNCTIO BX_GENUS_GPU REDDENS NUMERUS. REDDE 2. FIN-FUNCTIO.
FUNCTIO BX_EX_INACTIVUS REDDENS NUMERUS. REDDE 0. FIN-FUNCTIO.
FUNCTIO BX_EX_PARATUS REDDENS NUMERUS. REDDE 1. FIN-FUNCTIO.
FUNCTIO BX_EX_AGENS REDDENS NUMERUS. REDDE 2. FIN-FUNCTIO.
FUNCTIO BX_CAP_CODA REDDENS NUMERUS. REDDE 1. FIN-FUNCTIO.
FUNCTIO BX_CAP_REGION REDDENS NUMERUS. REDDE 2. FIN-FUNCTIO.
FUNCTIO BX_CAP_RGBA_PM REDDENS NUMERUS. REDDE 4. FIN-FUNCTIO.
FUNCTIO BX_CAP_PRAESENTA REDDENS NUMERUS. REDDE 8. FIN-FUNCTIO.
FUNCTIO BX_CAP_TEXTURE REDDENS NUMERUS. REDDE 16. FIN-FUNCTIO.
FUNCTIO BX_CAP_COMPOSITIO REDDENS NUMERUS. REDDE 32. FIN-FUNCTIO.
FUNCTIO BX_CAP_NOVEM REDDENS NUMERUS. REDDE 64. FIN-FUNCTIO.
FUNCTIO BX_CAP_VITA_TEXTURE REDDENS NUMERUS. REDDE 128. FIN-FUNCTIO.
FUNCTIO BX_OP_PRAESENTA REDDENS NUMERUS. REDDE 256. FIN-FUNCTIO.
FUNCTIO BX_OP_COPIA REDDENS NUMERUS. REDDE 257. FIN-FUNCTIO.
FUNCTIO BX_OP_COMPONE REDDENS NUMERUS. REDDE 258. FIN-FUNCTIO.
FUNCTIO BX_OP_NOVEM REDDENS NUMERUS. REDDE 259. FIN-FUNCTIO.
FUNCTIO BX_OP_TEXTURE_CREA REDDENS NUMERUS. REDDE 260. FIN-FUNCTIO.
FUNCTIO BX_OP_TEXTURE_RENOVA REDDENS NUMERUS. REDDE 261. FIN-FUNCTIO.
FUNCTIO BX_OP_TEXTURE_LIBERA REDDENS NUMERUS. REDDE 262. FIN-FUNCTIO.

FUNCTIO BX_CAP_MINIMUM REDDENS NUMERUS.
    REDDE BX_CAP_CODA()|BX_CAP_REGION()|BX_CAP_RGBA_PM()|BX_CAP_PRAESENTA().
FIN-FUNCTIO.

FUNCTIO BX_EXECUTOR_COMPATIBILIS REDDENS NUMERUS.
    ACCIPIT executor SICUT NUMERUS.
    SI executor==0 || CONTENTUM(executor)!=BX_EX_ABI() TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(executor+8)!=BX_GENUS_SOFTWARE() && CONTENTUM(executor+8)!=BX_GENUS_GPU() TUNC REDDE 0. FIN-SI.
    SI (CONTENTUM(executor+16)&BX_CAP_MINIMUM())!=BX_CAP_MINIMUM() TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_EXECUTOR_CREA REDDENS NUMERUS.
    ACCIPIT genus SICUT NUMERUS.
    ACCIPIT capacitates SICUT NUMERUS.
    ACCIPIT contextus SICUT NUMERUS.
    SI genus!=BX_GENUS_SOFTWARE() && genus!=BX_GENUS_GPU() TUNC REDDE 0. FIN-SI.
    SI (capacitates&BX_CAP_MINIMUM())!=BX_CAP_MINIMUM() TUNC REDDE 0. FIN-SI.
    SI (capacitates&BX_CAP_TEXTURE())!=0 TUNC capacitates=capacitates-BX_CAP_TEXTURE(). FIN-SI.
    DECLARA executor SICUT NUMERUS VALENS RESERVA_OCTETA(96).
    SI executor==0 TUNC REDDE 0. FIN-SI.
    DECLARA pura SICUT NUMERUS VALENS GX_MEM_PURA(executor,96).
    CONTENTUM(executor)=BX_EX_ABI(). CONTENTUM(executor+8)=genus.
    CONTENTUM(executor+16)=capacitates. CONTENTUM(executor+24)=contextus.
    SI genus==BX_GENUS_SOFTWARE() TUNC CONTENTUM(executor+32)=BX_EX_PARATUS(). CONTENTUM(executor+88)=1. FIN-SI.
    REDDE executor.
FIN-FUNCTIO.

FUNCTIO BX_EXECUTOR_SW_CREA REDDENS NUMERUS.
    ACCIPIT target SICUT NUMERUS.
    REDDE BX_EXECUTOR_CREA(BX_GENUS_SOFTWARE(),BX_CAP_MINIMUM()|BX_CAP_COMPOSITIO()|BX_CAP_NOVEM()|BX_CAP_VITA_TEXTURE(),target).
FIN-FUNCTIO.

FUNCTIO BX_EXECUTOR_PARATUS_EST REDDENS NUMERUS.
    ACCIPIT executor SICUT NUMERUS.
    SI BX_EXECUTOR_COMPATIBILIS(executor)==0 || CONTENTUM(executor+32)!=BX_EX_PARATUS() || (CONTENTUM(executor+88)&1)==0 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_CREA_CUM_EXECUTORE REDDENS NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    ACCIPIT executor SICUT NUMERUS.
    SI BX_EXECUTOR_COMPATIBILIS(executor)==0 TUNC REDDE 0. FIN-SI.
    DECLARA q SICUT NUMERUS VALENS QVIII_CREA(capacitas).
    SI q==0 TUNC REDDE 0. FIN-SI.
    DECLARA b SICUT NUMERUS VALENS RESERVA_OCTETA(192).
    SI b==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(b,192).
    CONTENTUM(b)=BX_ABI(). CONTENTUM(b+8)=CONTENTUM(executor+8).
    CONTENTUM(b+16)=CONTENTUM(executor+16). CONTENTUM(b+24)=q.
    CONTENTUM(b+48)=1. CONTENTUM(b+80)=CONTENTUM(executor+24).
    CONTENTUM(b+96)=executor. CONTENTUM(b+104)=1. CONTENTUM(b+120)=CONTENTUM(executor+24). CONTENTUM(b+144)=1.
    REDDE b.
FIN-FUNCTIO.

FUNCTIO BX_TARGET_CREA REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT stride SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT formatum SICUT NUMERUS.
    SI basis==0 || w<=0 || h<=0 || stride<w || formatum<0 || formatum>1 TUNC REDDE 0. FIN-SI.
    DECLARA t SICUT NUMERUS VALENS RESERVA_OCTETA(40).
    SI t==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(t)=basis. CONTENTUM(t+8)=stride.
    CONTENTUM(t+16)=w. CONTENTUM(t+24)=h. CONTENTUM(t+32)=formatum.
    REDDE t.
FIN-FUNCTIO.

FUNCTIO BX_CREA_SW_TARGET REDDENS NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    ACCIPIT target SICUT NUMERUS.
    DECLARA executor SICUT NUMERUS VALENS BX_EXECUTOR_SW_CREA(target).
    SI executor==0 TUNC REDDE 0. FIN-SI.
    REDDE BX_CREA_CUM_EXECUTORE(capacitas,executor).
FIN-FUNCTIO.

FUNCTIO BX_CREA_SW REDDENS NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    REDDE BX_CREA_SW_TARGET(capacitas,0).
FIN-FUNCTIO.

FUNCTIO BX_CACHE_INSTITUE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    ACCIPIT limes SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 || CONTENTUM(b+32)!=0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+112)!=0 TUNC REDDE CONTENTUM(b+112). FIN-SI.
    DECLARA cache SICUT NUMERUS VALENS TXC_CREA(capacitas,limes).
    SI cache==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(b+112)=cache. CONTENTUM(b+16)=CONTENTUM(b+16)|BX_CAP_TEXTURE().
    CONTENTUM(CONTENTUM(b+96)+16)=CONTENTUM(CONTENTUM(b+96)+16)|BX_CAP_TEXTURE().
    REDDE cache.
FIN-FUNCTIO.

FUNCTIO BX_CACHE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI b==0 || (CONTENTUM(b+16)&BX_CAP_TEXTURE())==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(b+112).
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_PETE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE(b).
    SI cache==0 TUNC REDDE 0. FIN-SI.
    REDDE TXC_PETE(cache,superficies).
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_RELAXA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE(b).
    SI cache==0 TUNC REDDE 0. FIN-SI.
    REDDE TXC_RELAXA(cache,nodus).
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_INVALIDA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE(b).
    SI cache==0 TUNC REDDE 0. FIN-SI.
    REDDE TXC_INVALIDA(cache,superficies).
FIN-FUNCTIO.

FUNCTIO BX_RESOURCE_VALIDA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI b==0 || r==0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(b+128).
    DUM n!=0 && n!=r PERFICE n=CONTENTUM(n+40). FIN-DUM.
    SI n==r TUNC REDDE 1. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO BX_RESOURCE_CREA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    SI BX_COMPATIBILIS(b)==0 || (CONTENTUM(b+16)&BX_CAP_VITA_TEXTURE())==0 || superficies==0 || GX_BASIS(superficies)==0 || GX_W(superficies)<=0 || GX_H(superficies)<=0 TUNC REDDE 0. FIN-SI.
    DECLARA r SICUT NUMERUS VALENS RESERVA_OCTETA(88).
    SI r==0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_MEM_PURA(r,88).
    CONTENTUM(r)=CONTENTUM(b+144). CONTENTUM(b+144)=CONTENTUM(b+144)+1.
    CONTENTUM(r+8)=superficies. CONTENTUM(r+16)=CONTENTUM(superficies+72).
    CONTENTUM(r+32)=0. CONTENTUM(r+40)=CONTENTUM(b+128).
    CONTENTUM(r+64)=GX_W(superficies)*GX_H(superficies)*4.
    CONTENTUM(b+128)=r.
    REDDE r.
FIN-FUNCTIO.

FUNCTIO BX_RESOURCE_QUAERE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    SI b==0 || superficies==0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(b+128).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+8)==superficies && CONTENTUM(n+32)!=2 TUNC REDDE n. FIN-SI.
        n=CONTENTUM(n+40).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO BX_RESOURCE_AUTOMATUM REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    DECLARA r SICUT NUMERUS VALENS BX_RESOURCE_QUAERE(b,superficies).
    SI r!=0 TUNC REDDE r. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(b+128).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+8)==superficies && CONTENTUM(n+32)==2 && (CONTENTUM(n+80)&1)!=0 TUNC
            CONTENTUM(n+16)=CONTENTUM(superficies+72). CONTENTUM(n+24)=0.
            CONTENTUM(n+32)=0. CONTENTUM(n+48)=0. CONTENTUM(n+64)=GX_W(superficies)*GX_H(superficies)*4. CONTENTUM(n+72)=0.
            REDDE n.
        FIN-SI.
        n=CONTENTUM(n+40).
    FIN-DUM.
    DECLARA creatum SICUT NUMERUS VALENS BX_RESOURCE_CREA(b,superficies).
    SI creatum!=0 TUNC CONTENTUM(creatum+80)=CONTENTUM(creatum+80)|1. FIN-SI.
    REDDE creatum.
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_CREA_ADDE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI BX_RESOURCE_VALIDA(b,r)==0 || CONTENTUM(b+32)!=1 || CONTENTUM(r+32)!=0 || CONTENTUM(r+72)!=0 TUNC REDDE 0. FIN-SI.
    DECLARA superficies SICUT NUMERUS VALENS CONTENTUM(r+8).
    SI superficies==0 || CONTENTUM(superficies+72)!=CONTENTUM(r+16) TUNC CONTENTUM(b+40)=7. REDDE 0. FIN-SI.
    SI QVIII_ADDE(CONTENTUM(b+24),BX_OP_TEXTURE_CREA(),r,superficies,CONTENTUM(r+16),GX_BASIS(superficies),CONTENTUM(r+64))==0 TUNC CONTENTUM(b+40)=3. REDDE 0. FIN-SI.
    CONTENTUM(r+72)=BX_OP_TEXTURE_CREA(). CONTENTUM(b+64)=CONTENTUM(b+64)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_RENOVA_ADDE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI BX_RESOURCE_VALIDA(b,r)==0 || CONTENTUM(b+32)!=1 || CONTENTUM(r+32)!=1 || CONTENTUM(r+72)!=0 TUNC REDDE 0. FIN-SI.
    DECLARA superficies SICUT NUMERUS VALENS CONTENTUM(r+8).
    SI superficies==0 TUNC CONTENTUM(b+40)=7. REDDE 0. FIN-SI.
    DECLARA generatio SICUT NUMERUS VALENS CONTENTUM(superficies+72).
    SI generatio==CONTENTUM(r+16) TUNC CONTENTUM(b+40)=7. REDDE 0. FIN-SI.
    SI QVIII_ADDE(CONTENTUM(b+24),BX_OP_TEXTURE_RENOVA(),r,superficies,generatio,CONTENTUM(r+16),CONTENTUM(r+64))==0 TUNC CONTENTUM(b+40)=3. REDDE 0. FIN-SI.
    CONTENTUM(r+72)=BX_OP_TEXTURE_RENOVA(). CONTENTUM(b+64)=CONTENTUM(b+64)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_LIBERA_ADDE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI BX_RESOURCE_VALIDA(b,r)==0 || CONTENTUM(b+32)!=1 || CONTENTUM(r+32)!=1 || CONTENTUM(r+72)!=0 || CONTENTUM(r+24)==0 TUNC REDDE 0. FIN-SI.
    SI QVIII_ADDE(CONTENTUM(b+24),BX_OP_TEXTURE_LIBERA(),r,CONTENTUM(r+24),CONTENTUM(r+16),CONTENTUM(r+64),0)==0 TUNC CONTENTUM(b+40)=3. REDDE 0. FIN-SI.
    CONTENTUM(r+72)=BX_OP_TEXTURE_LIBERA(). CONTENTUM(b+64)=CONTENTUM(b+64)+1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_RESOURCE_PENDENTIA_PURA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI b==0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(b+128).
    DECLARA numerus SICUT NUMERUS VALENS 0.
    DUM n!=0 PERFICE
        SI CONTENTUM(n+72)!=0 TUNC CONTENTUM(n+72)=0. numerus=numerus+1. FIN-SI.
        n=CONTENTUM(n+40).
    FIN-DUM.
    REDDE numerus.
FIN-FUNCTIO.

FUNCTIO BX_TEXTURES_RELAXA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE(b).
    SI b==0 || cache==0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(b+128).
    DECLARA numerus SICUT NUMERUS VALENS 0.
    DUM n!=0 PERFICE
        DECLARA nodus SICUT NUMERUS VALENS CONTENTUM(n+48).
        SI nodus!=0 TUNC
            DECLARA f SICUT NUMERUS VALENS TXC_RELAXA(cache,nodus).
            CONTENTUM(n+48)=0. numerus=numerus+1.
        FIN-SI.
        n=CONTENTUM(n+40).
    FIN-DUM.
    REDDE numerus.
FIN-FUNCTIO.

FUNCTIO BX_TEXTURE_PARA REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE(b).
    SI cache==0 TUNC REDDE 1. FIN-SI.
    DECLARA r SICUT NUMERUS VALENS BX_RESOURCE_AUTOMATUM(b,superficies).
    SI r==0 TUNC CONTENTUM(b+40)=8. REDDE 0. FIN-SI.
    SI CONTENTUM(r+48)==0 TUNC
        DECLARA nodus SICUT NUMERUS VALENS TXC_PETE(cache,superficies).
        SI nodus==0 TUNC CONTENTUM(b+40)=8. REDDE 0. FIN-SI.
        CONTENTUM(r+48)=nodus.
    FIN-SI.
    DECLARA status SICUT NUMERUS VALENS CONTENTUM(r+32).
    DECLARA pendens SICUT NUMERUS VALENS CONTENTUM(r+72).
    DECLARA generatio SICUT NUMERUS VALENS CONTENTUM(superficies+72).
    SI status==0 TUNC
        SI pendens==0 TUNC
            SI BX_TEXTURE_CREA_ADDE(b,r)==0 TUNC REDDE 0. FIN-SI.
        ALITER
            SI pendens!=BX_OP_TEXTURE_CREA() || CONTENTUM(r+16)!=generatio TUNC CONTENTUM(b+40)=7. REDDE 0. FIN-SI.
        FIN-SI.
        REDDE r.
    FIN-SI.
    SI status==1 TUNC
        SI CONTENTUM(r+16)!=generatio TUNC
            SI pendens==0 TUNC
                SI BX_TEXTURE_RENOVA_ADDE(b,r)==0 TUNC REDDE 0. FIN-SI.
            ALITER
                SI pendens!=BX_OP_TEXTURE_RENOVA() TUNC CONTENTUM(b+40)=7. REDDE 0. FIN-SI.
            FIN-SI.
        ALITER
            SI pendens!=0 TUNC CONTENTUM(b+40)=7. REDDE 0. FIN-SI.
        FIN-SI.
        REDDE r.
    FIN-SI.
    CONTENTUM(b+40)=7. REDDE 0.
FIN-FUNCTIO.

FUNCTIO BX_RESOURCE_RECONCILIA_ADDE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE(b).
    SI b==0 || cache==0 TUNC REDDE 0. FIN-SI.
    DECLARA q SICUT NUMERUS VALENS CONTENTUM(b+24).
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(b+128).
    DECLARA numerus SICUT NUMERUS VALENS 0.
    DUM n!=0 PERFICE
        SI CONTENTUM(n+32)==1 && (CONTENTUM(n+80)&1)!=0 && CONTENTUM(n+72)==0 && CONTENTUM(n+48)==0 && TXC_QUAERE(cache,CONTENTUM(n+8),CONTENTUM(n+16))==0 TUNC
            SI QVIII_NUMERUS(q)>=QVIII_CAPACITAS(q) TUNC REDDE numerus. FIN-SI.
            SI BX_TEXTURE_LIBERA_ADDE(b,n)==0 TUNC REDDE -1. FIN-SI.
            numerus=numerus+1.
        FIN-SI.
        n=CONTENTUM(n+40).
    FIN-DUM.
    REDDE numerus.
FIN-FUNCTIO.

FUNCTIO BX_RESOURCE_STATUS REDDENS NUMERUS. ACCIPIT r SICUT NUMERUS. SI r==0 TUNC REDDE -1. FIN-SI. REDDE CONTENTUM(r+32). FIN-FUNCTIO.
FUNCTIO BX_RESOURCE_MANUBRIUM REDDENS NUMERUS. ACCIPIT r SICUT NUMERUS. SI r==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(r+24). FIN-FUNCTIO.
FUNCTIO BX_RESOURCE_GENERATIO REDDENS NUMERUS. ACCIPIT r SICUT NUMERUS. SI r==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(r+16). FIN-FUNCTIO.
FUNCTIO BX_RESOURCE_AUTOMATA REDDENS NUMERUS. ACCIPIT r SICUT NUMERUS. SI r==0 TUNC REDDE 0. FIN-SI. SI (CONTENTUM(r+80)&1)!=0 TUNC REDDE 1. FIN-SI. REDDE 0. FIN-FUNCTIO.
FUNCTIO BX_RESOURCE_CREATAE REDDENS NUMERUS. ACCIPIT b SICUT NUMERUS. SI b==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(b+152). FIN-FUNCTIO.
FUNCTIO BX_RESOURCE_RENOVATAE REDDENS NUMERUS. ACCIPIT b SICUT NUMERUS. SI b==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(b+160). FIN-FUNCTIO.
FUNCTIO BX_RESOURCE_LIBERATAE REDDENS NUMERUS. ACCIPIT b SICUT NUMERUS. SI b==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(b+168). FIN-FUNCTIO.
FUNCTIO BX_RESOURCE_OCTETA REDDENS NUMERUS. ACCIPIT b SICUT NUMERUS. SI b==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(b+176). FIN-FUNCTIO.
FUNCTIO BX_RESOURCE_RESIDENTES REDDENS NUMERUS. ACCIPIT b SICUT NUMERUS. SI b==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(b+184). FIN-FUNCTIO.

FUNCTIO BX_COMPATIBILIS REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI b==0 || CONTENTUM(b)!=BX_ABI() || CONTENTUM(b+24)==0 TUNC REDDE 0. FIN-SI.
    SI (CONTENTUM(b+16)&BX_CAP_MINIMUM())!=BX_CAP_MINIMUM() TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+8)!=BX_GENUS_SOFTWARE() && CONTENTUM(b+8)!=BX_GENUS_GPU() TUNC REDDE 0. FIN-SI.
    DECLARA executor SICUT NUMERUS VALENS CONTENTUM(b+96).
    SI BX_EXECUTOR_COMPATIBILIS(executor)==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+8)!=CONTENTUM(executor+8) || CONTENTUM(b+16)!=CONTENTUM(executor+16) TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(b+120)!=CONTENTUM(executor+24) TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO BX_EXECUTOR REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI b==0 || CONTENTUM(b)!=BX_ABI() TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(b+96).
FIN-FUNCTIO.

FUNCTIO BX_EXECUTOR_STATUS REDDENS NUMERUS.
    ACCIPIT executor SICUT NUMERUS.
    SI BX_EXECUTOR_COMPATIBILIS(executor)==0 TUNC REDDE -1. FIN-SI.
    REDDE CONTENTUM(executor+32).
FIN-FUNCTIO.

FUNCTIO BX_EXECUTOR_CONTEXTUS REDDENS NUMERUS.
    ACCIPIT executor SICUT NUMERUS.
    SI BX_EXECUTOR_COMPATIBILIS(executor)==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(executor+24).
FIN-FUNCTIO.

FUNCTIO BX_EXECUTOR_ERRATUM REDDENS NUMERUS.
    ACCIPIT executor SICUT NUMERUS.
    SI BX_EXECUTOR_COMPATIBILIS(executor)==0 TUNC REDDE -1. FIN-SI.
