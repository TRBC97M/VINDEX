// Sylvia OS — registrum dynamicum fenestrarum Fenestralis Purus I.
// Nulla capacitas fixa: unaquaeque fenestra nodum memoria VINDEX possidet.
// Registrum: numerus, ima, summa, focus, id sequens.
// Nodus: id, cliens, x, y, w, h, status, maximus, restitutio x/y/w/h, prior, proximus.

FUNCTIO FI_CREA REDDENS NUMERUS.
    DECLARA registrum SICUT NUMERUS VALENS RESERVA_OCTETA(40).
    SI registrum < 0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(registrum)=0.
    CONTENTUM(registrum+8)=0.
    CONTENTUM(registrum+16)=0.
    CONTENTUM(registrum+24)=0.
    CONTENTUM(registrum+32)=1.
    REDDE registrum.
FIN-FUNCTIO.

FUNCTIO FI_NUMERUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(registrum).
FIN-FUNCTIO.

FUNCTIO FI_PRIMUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(registrum+8).
FIN-FUNCTIO.

FUNCTIO FI_SUPREMUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(registrum+16).
FIN-FUNCTIO.

FUNCTIO FI_PROXIMUS REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(nodus+104).
FIN-FUNCTIO.

FUNCTIO FI_PRIOR REDDENS NUMERUS.
    ACCIPIT nodus SICUT NUMERUS.
    SI nodus==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(nodus+96).
FIN-FUNCTIO.

FUNCTIO FI_QUAERE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    SI registrum==0 || id<=0 TUNC REDDE 0. FIN-SI.
    DECLARA nodus SICUT NUMERUS VALENS CONTENTUM(registrum+8).
    DUM nodus!=0 PERFICE
        SI CONTENTUM(nodus)==id TUNC REDDE nodus. FIN-SI.
        nodus=CONTENTUM(nodus+104).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FI_ADDE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT cliens SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI registrum==0 || cliens<=0 || w<=0 || h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA nodus SICUT NUMERUS VALENS RESERVA_OCTETA(112).
    SI nodus < 0 TUNC REDDE 0. FIN-SI.
    DECLARA id SICUT NUMERUS VALENS CONTENTUM(registrum+32).
    DECLARA summa SICUT NUMERUS VALENS CONTENTUM(registrum+16).
    CONTENTUM(nodus)=id.
    CONTENTUM(nodus+8)=cliens.
    CONTENTUM(nodus+16)=x. CONTENTUM(nodus+24)=y.
    CONTENTUM(nodus+32)=w. CONTENTUM(nodus+40)=h.
    CONTENTUM(nodus+48)=0. CONTENTUM(nodus+56)=0.
    CONTENTUM(nodus+64)=x. CONTENTUM(nodus+72)=y.
    CONTENTUM(nodus+80)=w. CONTENTUM(nodus+88)=h.
    CONTENTUM(nodus+96)=summa. CONTENTUM(nodus+104)=0.
    SI summa!=0 TUNC CONTENTUM(summa+104)=nodus. ALITER CONTENTUM(registrum+8)=nodus. FIN-SI.
    CONTENTUM(registrum+16)=nodus.
    CONTENTUM(registrum+24)=id.
    CONTENTUM(registrum+32)=id+1.
    CONTENTUM(registrum)=CONTENTUM(registrum)+1.
    REDDE id.
FIN-FUNCTIO.

FUNCTIO FI_CLIENTE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(n+8).
FIN-FUNCTIO.

FUNCTIO FI_STATUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 TUNC REDDE 2. FIN-SI.
    REDDE CONTENTUM(n+48).
FIN-FUNCTIO.

FUNCTIO FI_STATUS_PONE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS. ACCIPIT status SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(n+48)=status.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FI_CLIENTIS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT cliens SICUT NUMERUS.
    SI registrum==0 || cliens<=0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(registrum+8).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+8)==cliens && CONTENTUM(n+48)!=2 TUNC REDDE CONTENTUM(n). FIN-SI.
        n=CONTENTUM(n+104).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FI_FOCUS_ID REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(registrum+24).
FIN-FUNCTIO.

FUNCTIO FI_RELEGE_FOCUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    DECLARA id SICUT NUMERUS VALENS CONTENTUM(registrum+24).
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n!=0 TUNC
        SI CONTENTUM(n+48)==0 TUNC REDDE id. FIN-SI.
    FIN-SI.
    n=CONTENTUM(registrum+16).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)==0 TUNC CONTENTUM(registrum+24)=CONTENTUM(n). REDDE CONTENTUM(n). FIN-SI.
        n=CONTENTUM(n+96).
    FIN-DUM.
    CONTENTUM(registrum+24)=0.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FI_FOCUS REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(n+48)==2 TUNC REDDE 0. FIN-SI.
    CONTENTUM(n+48)=0.
    DECLARA summa SICUT NUMERUS VALENS CONTENTUM(registrum+16).
    SI n!=summa TUNC
        DECLARA prior SICUT NUMERUS VALENS CONTENTUM(n+96).
        DECLARA proximus SICUT NUMERUS VALENS CONTENTUM(n+104).
        SI prior!=0 TUNC CONTENTUM(prior+104)=proximus. ALITER CONTENTUM(registrum+8)=proximus. FIN-SI.
        SI proximus!=0 TUNC CONTENTUM(proximus+96)=prior. FIN-SI.
        CONTENTUM(n+96)=summa. CONTENTUM(n+104)=0.
        SI summa!=0 TUNC CONTENTUM(summa+104)=n. ALITER CONTENTUM(registrum+8)=n. FIN-SI.
        CONTENTUM(registrum+16)=n.
    FIN-SI.
    CONTENTUM(registrum+24)=id.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FI_HIT REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(registrum+16).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)==0 TUNC
            DECLARA nx SICUT NUMERUS VALENS CONTENTUM(n+16). DECLARA ny SICUT NUMERUS VALENS CONTENTUM(n+24).
            DECLARA nw SICUT NUMERUS VALENS CONTENTUM(n+32). DECLARA nh SICUT NUMERUS VALENS CONTENTUM(n+40).
            SI x>=nx && y>=ny && x<nx+nw && y<ny+nh TUNC REDDE CONTENTUM(n). FIN-SI.
        FIN-SI.
        n=CONTENTUM(n+96).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FI_GEOM_PONE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS. ACCIPIT w SICUT NUMERUS. ACCIPIT h SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 || w<=0 || h<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(n+16)=x. CONTENTUM(n+24)=y. CONTENTUM(n+32)=w. CONTENTUM(n+40)=h.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FI_MINIMIZA REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(n+48)!=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(n+48)=1.
    SI CONTENTUM(registrum+24)==id TUNC CONTENTUM(registrum+24)=0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS FI_RELEGE_FOCUS(registrum).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FI_CLAUDE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(n+48)=2.
    SI CONTENTUM(registrum+24)==id TUNC CONTENTUM(registrum+24)=0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS FI_RELEGE_FOCUS(registrum).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FI_MAX_TOGGLE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    ACCIPIT sw SICUT NUMERUS. ACCIPIT sh SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(n+48)==2 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(n+56)==0 TUNC
        CONTENTUM(n+64)=CONTENTUM(n+16). CONTENTUM(n+72)=CONTENTUM(n+24).
        CONTENTUM(n+80)=CONTENTUM(n+32). CONTENTUM(n+88)=CONTENTUM(n+40).
        CONTENTUM(n+16)=0. CONTENTUM(n+24)=0. CONTENTUM(n+32)=sw. CONTENTUM(n+40)=sh-28.
        CONTENTUM(n+56)=1.
    ALITER
        CONTENTUM(n+16)=CONTENTUM(n+64). CONTENTUM(n+24)=CONTENTUM(n+72).
        CONTENTUM(n+32)=CONTENTUM(n+80). CONTENTUM(n+40)=CONTENTUM(n+88).
        CONTENTUM(n+56)=0.
    FIN-SI.
    CONTENTUM(n+48)=0.
    DECLARA f SICUT NUMERUS VALENS FI_FOCUS(registrum,id).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FI_MOVE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS. ACCIPIT dx SICUT NUMERUS. ACCIPIT dy SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(n+48)!=0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(n+56)!=0 TUNC REDDE 0. FIN-SI.
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(50333728). DECLARA sh SICUT NUMERUS VALENS CONTENTUM(50333736)-28.
    DECLARA x SICUT NUMERUS VALENS CONTENTUM(n+16)+dx. DECLARA y SICUT NUMERUS VALENS CONTENTUM(n+24)+dy.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(n+32). DECLARA h SICUT NUMERUS VALENS CONTENTUM(n+40).
    SI x<0 TUNC x=0. FIN-SI. SI y<0 TUNC y=0. FIN-SI.
    SI x+w>sw TUNC x=sw-w. FIN-SI. SI y+h>sh TUNC y=sh-h. FIN-SI.
    SI x<0 TUNC x=0. FIN-SI. SI y<0 TUNC y=0. FIN-SI.
    CONTENTUM(n+16)=x. CONTENTUM(n+24)=y.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FI_RESIZE REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT id SICUT NUMERUS. ACCIPIT margines SICUT NUMERUS.
    ACCIPIT dx SICUT NUMERUS. ACCIPIT dy SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(n+48)!=0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(n+56)!=0 TUNC REDDE 0. FIN-SI.
    SI margines==0 TUNC REDDE 0. FIN-SI.
    DECLARA x SICUT NUMERUS VALENS CONTENTUM(n+16). DECLARA y SICUT NUMERUS VALENS CONTENTUM(n+24).
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(n+32). DECLARA h SICUT NUMERUS VALENS CONTENTUM(n+40).
    DECLARA minw SICUT NUMERUS VALENS 320. DECLARA minh SICUT NUMERUS VALENS 220.
    SI (margines&1)!=0 TUNC x=x+dx. w=w-dx. FIN-SI. SI (margines&2)!=0 TUNC w=w+dx. FIN-SI.
    SI (margines&4)!=0 TUNC y=y+dy. h=h-dy. FIN-SI. SI (margines&8)!=0 TUNC h=h+dy. FIN-SI.
    SI w<minw TUNC SI (margines&1)!=0 TUNC x=x-(minw-w). FIN-SI. w=minw. FIN-SI.
    SI h<minh TUNC SI (margines&4)!=0 TUNC y=y-(minh-h). FIN-SI. h=minh. FIN-SI.
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(50333728). DECLARA sh SICUT NUMERUS VALENS CONTENTUM(50333736)-28.
    SI x<0 TUNC SI (margines&1)!=0 TUNC w=w+x. FIN-SI. x=0. FIN-SI.
    SI y<0 TUNC SI (margines&4)!=0 TUNC h=h+y. FIN-SI. y=0. FIN-SI.
    SI x+w>sw TUNC w=sw-x. FIN-SI. SI y+h>sh TUNC h=sh-y. FIN-SI.
    SI w<minw TUNC w=minw. SI x+w>sw TUNC x=sw-w. FIN-SI. FIN-SI.
    SI h<minh TUNC h=minh. SI y+h>sh TUNC y=sh-h. FIN-SI. FIN-SI.
    CONTENTUM(n+16)=x. CONTENTUM(n+24)=y. CONTENTUM(n+32)=w. CONTENTUM(n+40)=h.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FI_ALTERNA REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    DECLARA focus SICUT NUMERUS VALENS FI_RELEGE_FOCUS(registrum).
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(registrum,focus).
    SI n!=0 TUNC n=CONTENTUM(n+96). FIN-SI.
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)==0 TUNC DECLARA id SICUT NUMERUS VALENS CONTENTUM(n). DECLARA f SICUT NUMERUS VALENS FI_FOCUS(registrum,id). REDDE id. FIN-SI.
        n=CONTENTUM(n+96).
    FIN-DUM.
    n=CONTENTUM(registrum+16).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)==0 && CONTENTUM(n)!=focus TUNC DECLARA id2 SICUT NUMERUS VALENS CONTENTUM(n). DECLARA f2 SICUT NUMERUS VALENS FI_FOCUS(registrum,id2). REDDE id2. FIN-SI.
        n=CONTENTUM(n+96).
    FIN-DUM.
    REDDE focus.
FIN-FUNCTIO.

FUNCTIO FI_APERTA_NUM REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    SI registrum==0 TUNC REDDE 0. FIN-SI.
    DECLARA numerus SICUT NUMERUS VALENS 0. DECLARA n SICUT NUMERUS VALENS CONTENTUM(registrum+8).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)!=2 TUNC numerus=numerus+1. FIN-SI.
        n=CONTENTUM(n+104).
    FIN-DUM.
    REDDE numerus.
FIN-FUNCTIO.

FUNCTIO FI_APERTA_N REDDENS NUMERUS.
    ACCIPIT registrum SICUT NUMERUS. ACCIPIT index SICUT NUMERUS.
    SI registrum==0 || index<0 TUNC REDDE 0. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0. DECLARA n SICUT NUMERUS VALENS CONTENTUM(registrum+8).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)!=2 TUNC
            SI i==index TUNC REDDE CONTENTUM(n). FIN-SI.
            i=i+1.
        FIN-SI.
        n=CONTENTUM(n+104).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.