// Sylvia OS — coda backend-neutra Graphica VIII/X.
// Unum mandatum = XLVIII octeta: opcode,a,b,c,d,e.
// Descriptor = XXXII octeta: capacitas,numerus,data,erratum.
// Exsecutores Graphica VIII et Graphica X eandem structuram consumunt.

FUNCTIO QVIII_CREA REDDENS NUMERUS.
    ACCIPIT capacitas SICUT NUMERUS.
    SI capacitas<=0 || capacitas>4096 TUNC REDDE 0. FIN-SI.
    DECLARA q SICUT NUMERUS VALENS RESERVA_OCTETA(32).
    SI q<=0 TUNC REDDE 0. FIN-SI.
    DECLARA data SICUT NUMERUS VALENS RESERVA_OCTETA(capacitas*48).
    SI data<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(q)=capacitas. CONTENTUM(q+8)=0. CONTENTUM(q+16)=data. CONTENTUM(q+24)=0.
    REDDE q.
FIN-FUNCTIO.

FUNCTIO QVIII_CAPACITAS REDDENS NUMERUS. ACCIPIT q SICUT NUMERUS. SI q<=0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(q). FIN-FUNCTIO.
FUNCTIO QVIII_NUMERUS REDDENS NUMERUS. ACCIPIT q SICUT NUMERUS. SI q<=0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(q+8). FIN-FUNCTIO.
FUNCTIO QVIII_ERRATUM REDDENS NUMERUS. ACCIPIT q SICUT NUMERUS. SI q<=0 TUNC REDDE -1. FIN-SI. REDDE CONTENTUM(q+24). FIN-FUNCTIO.

FUNCTIO QVIII_RESET REDDENS NUMERUS.
    ACCIPIT q SICUT NUMERUS.
    SI q<=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(q+8)=0. CONTENTUM(q+24)=0. REDDE 1.
FIN-FUNCTIO.

FUNCTIO QVIII_SEDES REDDENS NUMERUS.
    ACCIPIT q SICUT NUMERUS. ACCIPIT i SICUT NUMERUS.
    SI q<=0 || i<0 || i>=CONTENTUM(q+8) TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(q+16)+i*48.
FIN-FUNCTIO.

// Exacte VII argumenta: limen ABI VINDEX servatur.
FUNCTIO QVIII_ADDE REDDENS NUMERUS.
    ACCIPIT q SICUT NUMERUS. ACCIPIT opcode SICUT NUMERUS. ACCIPIT a SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS. ACCIPIT c SICUT NUMERUS. ACCIPIT d SICUT NUMERUS. ACCIPIT e SICUT NUMERUS.
    SI q<=0 || opcode<=0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(q+8).
    SI n>=CONTENTUM(q) TUNC CONTENTUM(q+24)=1. REDDE 0. FIN-SI.
    DECLARA p SICUT NUMERUS VALENS CONTENTUM(q+16)+n*48.
    CONTENTUM(p)=opcode. CONTENTUM(p+8)=a. CONTENTUM(p+16)=b. CONTENTUM(p+24)=c. CONTENTUM(p+32)=d. CONTENTUM(p+40)=e.
    CONTENTUM(q+8)=n+1. REDDE 1.
FIN-FUNCTIO.

FUNCTIO QVIII_OPCODE REDDENS NUMERUS. ACCIPIT q SICUT NUMERUS. ACCIPIT i SICUT NUMERUS. DECLARA p SICUT NUMERUS VALENS QVIII_SEDES(q,i). SI p==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(p). FIN-FUNCTIO.
FUNCTIO QVIII_A REDDENS NUMERUS. ACCIPIT q SICUT NUMERUS. ACCIPIT i SICUT NUMERUS. DECLARA p SICUT NUMERUS VALENS QVIII_SEDES(q,i). SI p==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(p+8). FIN-FUNCTIO.
FUNCTIO QVIII_B REDDENS NUMERUS. ACCIPIT q SICUT NUMERUS. ACCIPIT i SICUT NUMERUS. DECLARA p SICUT NUMERUS VALENS QVIII_SEDES(q,i). SI p==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(p+16). FIN-FUNCTIO.
FUNCTIO QVIII_C REDDENS NUMERUS. ACCIPIT q SICUT NUMERUS. ACCIPIT i SICUT NUMERUS. DECLARA p SICUT NUMERUS VALENS QVIII_SEDES(q,i). SI p==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(p+24). FIN-FUNCTIO.
FUNCTIO QVIII_D REDDENS NUMERUS. ACCIPIT q SICUT NUMERUS. ACCIPIT i SICUT NUMERUS. DECLARA p SICUT NUMERUS VALENS QVIII_SEDES(q,i). SI p==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(p+32). FIN-FUNCTIO.
FUNCTIO QVIII_E REDDENS NUMERUS. ACCIPIT q SICUT NUMERUS. ACCIPIT i SICUT NUMERUS. DECLARA p SICUT NUMERUS VALENS QVIII_SEDES(q,i). SI p==0 TUNC REDDE 0. FIN-SI. REDDE CONTENTUM(p+40). FIN-FUNCTIO.
