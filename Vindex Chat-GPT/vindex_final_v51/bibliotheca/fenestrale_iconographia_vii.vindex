// Sylvia OS — P16-VII: compositor finalis cum iconographia rastera.
// Ordo picturae servatur: fundum -> bureau -> rastera -> fenestrae -> INITIUM -> taskbar -> cursor.
// Gradus historici E–H et compositor P16-IV non mutantur.

FUNCTIO IVVII_ICONA_FONS_X REDDENS NUMERUS.
    ACCIPIT genus SICUT NUMERUS.
    REDDE ICVII_FONS_X(genus).
FIN-FUNCTIO.

FUNCTIO IVVII_ICONA_FONS_Y REDDENS NUMERUS.
    ACCIPIT genus SICUT NUMERUS.
    REDDE ICVII_FONS_Y(genus).
FIN-FUNCTIO.

FUNCTIO IVVII_BUREAU_ICONAE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT applicationes SICUT NUMERUS.
    ACCIPIT atlas SICUT TEXTUS.
    SI IR_VALIDUS(atlas)==0 TUNC REDDE 0. FIN-SI.
    DECLARA nox SICUT NUMERUS VALENS FV_COLOR(28,31,32).
    DECLARA lapis SICUT NUMERUS VALENS FV_COLOR(49,55,55).
    DECLARA index SICUT NUMERUS VALENS 0.
    DECLARA nodus SICUT NUMERUS VALENS AI_PRIMUS(applicationes).
    DUM nodus!=0 PERFICE
        SI AI_NODUS_IN_BUREAU(nodus)!=0 TUNC
            DECLARA x SICUT NUMERUS VALENS IV_BUREAU_X(index).
            DECLARA y SICUT NUMERUS VALENS IV_BUREAU_Y(index).
            DECLARA corpus SICUT NUMERUS VALENS nox.
            SI s[11]>=x && s[11]<x+FV_METRUM_BUREAU_LATITUDO() && s[12]>=y && s[12]<y+FV_METRUM_BUREAU_ALTITUDO() TUNC corpus=lapis. FIN-SI.
            // Pictogramma P16-VI vetus intra hanc regionem deletur; cardo et nomen servantur.
            DECLARA f SICUT NUMERUS VALENS FV_RECT(x+24,y+6,60,54,corpus).
            DECLARA genus SICUT NUMERUS VALENS AI_NODUS_GENUS(nodus).
            DECLARA sx SICUT NUMERUS VALENS IVVII_ICONA_FONS_X(genus).
            DECLARA sy SICUT NUMERUS VALENS IVVII_ICONA_FONS_Y(genus).
            DECLARA pars SICUT NUMERUS VALENS IRVII_RECT_CREA(sx,sy,48,48).
            DECLARA dst SICUT NUMERUS VALENS IRVII_RECT_CREA(x+30,y+8,48,48).
            f=IRVII_BLIT_FB(atlas,dst,pars).
            index=index+1.
        FIN-SI.
        nodus=AI_PROXIMUS(nodus).
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IVVII_INITIUM_ICONAE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT applicationes SICUT NUMERUS.
    ACCIPIT atlas SICUT TEXTUS.
    SI IR_VALIDUS(atlas)==0 TUNC REDDE 0. FIN-SI.
    DECLARA nox SICUT NUMERUS VALENS FV_COLOR(28,31,32).
    DECLARA index SICUT NUMERUS VALENS 0.
    DECLARA nodus SICUT NUMERUS VALENS AI_PRIMUS(applicationes).
    DUM nodus!=0 PERFICE
        DECLARA ix SICUT NUMERUS VALENS IV_INITIUM_ITEM_X(index).
        DECLARA iy SICUT NUMERUS VALENS IV_INITIUM_ITEM_Y(applicationes,index).
        // Antiquum pictogramma 32x32 deletur, deinde eadem tessera rastera 48x48 ad 32x32 minuitur.
        DECLARA f SICUT NUMERUS VALENS FV_RECT(ix+8,iy+6,32,32,nox).
        DECLARA genus SICUT NUMERUS VALENS AI_NODUS_GENUS(nodus).
        DECLARA sx SICUT NUMERUS VALENS IVVII_ICONA_FONS_X(genus).
        DECLARA sy SICUT NUMERUS VALENS IVVII_ICONA_FONS_Y(genus).
        DECLARA pars SICUT NUMERUS VALENS IRVII_RECT_CREA(sx,sy,48,48).
        DECLARA dst SICUT NUMERUS VALENS IRVII_RECT_CREA(ix+8,iy+6,32,32).
        f=IRVII_BLIT_FB(atlas,dst,pars).
        index=index+1.
        nodus=AI_PROXIMUS(nodus).
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO IVVII_REDDE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT fenestrae SICUT NUMERUS.
    ACCIPIT clientes SICUT NUMERUS.
    ACCIPIT applicationes SICUT NUMERUS.
    ACCIPIT emblema SICUT TEXTUS.
    ACCIPIT atlas SICUT TEXTUS.
    DECLARA f SICUT NUMERUS VALENS FV_FUNDUM().
    f=IV_BUREAU_REDDE(s,applicationes).
    SI IR_VALIDUS(emblema)!=0 TUNC f=IR_BLIT_FRAMEBUFFER(164,18,emblema). FIN-SI.
    SI IR_VALIDUS(atlas)!=0 TUNC f=IVVII_BUREAU_ICONAE(s,applicationes,atlas). FIN-SI.
    DECLARA focus SICUT NUMERUS VALENS FI_RELEGE_FOCUS(fenestrae).
    DECLARA n SICUT NUMERUS VALENS FI_PRIMUS(fenestrae).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)==0 TUNC f=IV_FENESTRA(fenestrae,clientes,applicationes,n). FIN-SI.
        n=FI_PROXIMUS(n).
    FIN-DUM.
    SI s[38]==1 TUNC
        f=IV_INITIUM_REDDE(s,applicationes).
        SI IR_VALIDUS(atlas)!=0 TUNC f=IVVII_INITIUM_ICONAE(s,applicationes,atlas). FIN-SI.
    FIN-SI.
    f=IV_TASKBAR_REDDE(fenestrae,clientes,applicationes).
    f=FV_CURSOR(s[11],s[12]).
    REDDE 1.
FIN-FUNCTIO.
