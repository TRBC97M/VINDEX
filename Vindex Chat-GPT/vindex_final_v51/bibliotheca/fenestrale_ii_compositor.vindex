// Sylvia OS — Fenestrale II, Gradus G.
// Bibliotheca experimentalis clientis ad superficies privatas compositorii.
// Client hanc bibliothecam post fenestrale_ii.vindex importare debet.

FUNCTIO FENESTRALE_II_COMPOSITOR_BASIS REDDENS NUMERUS.
    REDDE 50335232.
FIN-FUNCTIO.

FUNCTIO FII_CMP_AD_EST REDDENS NUMERUS.
    SI FENESTRALE_II_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    SI (FENESTRALE_II_CAPACITATES() & 32) == 0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50335232) != 14162041607313747 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50335240) != 1 || CONTENTUM(50335248) < 256 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FII_CMP_STATUS REDDENS NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 3. FIN-SI.
    REDDE CONTENTUM(50335256).
FIN-FUNCTIO.

FUNCTIO FII_CMP_OPERATIO REDDENS NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50335264).
FIN-FUNCTIO.

FUNCTIO FII_CMP_RESPONSUM REDDENS NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 1. FIN-SI.
    REDDE CONTENTUM(50335384).
FIN-FUNCTIO.

FUNCTIO FII_CMP_SUPERFICIES_ID REDDENS NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50335280).
FIN-FUNCTIO.

FUNCTIO FII_CMP_SUPERFICIES_BASIS REDDENS NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50335312).
FIN-FUNCTIO.

FUNCTIO FII_CMP_SUPERFICIES_LINEA REDDENS NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50335320).
FIN-FUNCTIO.

FUNCTIO FII_CMP_SUPERFICIES_FORMATUM REDDENS NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(50335328).
FIN-FUNCTIO.

FUNCTIO FII_CMP_RESPONSUM_PARATUM REDDENS NUMERUS.
    DECLARA status SICUT NUMERUS VALENS FII_CMP_STATUS().
    SI status == 2 || status == 3 TUNC REDDE 1. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FII_CMP_VACUA REDDENS NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50335256) == 1 TUNC REDDE 0. FIN-SI.
    CONTENTUM(50335256) = 0.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FII_CMP_SUPERFICIEM_PETE REDDENS NUMERUS.
    ACCIPIT client SICUT NUMERUS.
    ACCIPIT latitudo SICUT NUMERUS.
    ACCIPIT altitudo SICUT NUMERUS.
    ACCIPIT vexilla SICUT NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50335256) == 1 TUNC REDDE 0. FIN-SI.
    CONTENTUM(50335264) = 1.
    CONTENTUM(50335272) = client.
    CONTENTUM(50335280) = 0.
    CONTENTUM(50335288) = vexilla.
    CONTENTUM(50335296) = latitudo.
    CONTENTUM(50335304) = altitudo.
    CONTENTUM(50335312) = 0.
    CONTENTUM(50335320) = 0.
    CONTENTUM(50335384) = 0.
    CONTENTUM(50335392) = CONTENTUM(50335392) + 1.
    CONTENTUM(50335256) = 1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FII_CMP_PRAESENTA REDDENS NUMERUS.
    ACCIPIT client SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT damnum_x SICUT NUMERUS.
    ACCIPIT damnum_y SICUT NUMERUS.
    ACCIPIT damnum_latitudo SICUT NUMERUS.
    ACCIPIT damnum_altitudo SICUT NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50335256) == 1 TUNC REDDE 0. FIN-SI.
    CONTENTUM(50335264) = 3.
    CONTENTUM(50335272) = client.
    CONTENTUM(50335280) = superficies.
    CONTENTUM(50335352) = damnum_x.
    CONTENTUM(50335360) = damnum_y.
    CONTENTUM(50335368) = damnum_latitudo.
    CONTENTUM(50335376) = damnum_altitudo.
    CONTENTUM(50335384) = 0.
    CONTENTUM(50335392) = CONTENTUM(50335392) + 1.
    CONTENTUM(50335256) = 1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FII_CMP_MOVE REDDENS NUMERUS.
    ACCIPIT client SICUT NUMERUS.
    ACCIPIT superficies SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    SI FII_CMP_AD_EST() == 0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50335256) == 1 TUNC REDDE 0. FIN-SI.
    CONTENTUM(50335264) = 4.
    CONTENTUM(50335272) = client.
    CONTENTUM(50335280) = superficies.
    CONTENTUM(50335336) = x.
    CONTENTUM(50335344) = y.
    CONTENTUM(50335384) = 0.
    CONTENTUM(50335392) = CONTENTUM(50335392) + 1.
    CONTENTUM(50335256) = 1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FII_CMP_COLOR REDDENS NUMERUS.
    ACCIPIT formatum SICUT NUMERUS.
    ACCIPIT rubrum SICUT NUMERUS.
    ACCIPIT viride SICUT NUMERUS.
    ACCIPIT caeruleum SICUT NUMERUS.
    // Superficies Gradus G ARGB opacas scribit; alpha est CCLV.
    SI formatum == 0 TUNC
        REDDE rubrum + viride * 256 + caeruleum * 65536 + 4278190080.
    FIN-SI.
    REDDE caeruleum + viride * 256 + rubrum * 65536 + 4278190080.
FIN-FUNCTIO.

FUNCTIO FII_CMP_RECTANGULUM REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT linea SICUT NUMERUS.
    ACCIPIT formatum SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT latitudo SICUT NUMERUS.
    ACCIPIT altitudo SICUT NUMERUS.
    ACCIPIT rubrum SICUT NUMERUS.
    ACCIPIT viride SICUT NUMERUS.
    ACCIPIT caeruleum SICUT NUMERUS.
    SI basis == 0 || linea == 0 || latitudo <= 0 || altitudo <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA color SICUT NUMERUS VALENS FII_CMP_COLOR(formatum, rubrum, viride, caeruleum).
    DECLARA par SICUT NUMERUS VALENS color + color * 4294967296.
    DECLARA finis_x SICUT NUMERUS VALENS x + latitudo.
    DECLARA finis_y SICUT NUMERUS VALENS y + altitudo.
    SI x % 2 != 0 TUNC x = x + 1. FIN-SI.
    DECLARA py SICUT NUMERUS VALENS y.
    DUM py < finis_y PERFICE
        DECLARA px SICUT NUMERUS VALENS x.
        DUM px + 1 < finis_x PERFICE
            CONTENTUM(basis + (py * linea + px) * 4) = par.
            px = px + 2.
        FIN-DUM.
        py = py + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.
