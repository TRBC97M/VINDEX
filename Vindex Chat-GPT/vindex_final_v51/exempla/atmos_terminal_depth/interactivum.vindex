// ATMOS // TERMINAL DEPTH — Probatio II: sessio interactiva continua.
// Totum programma VINDEX est. Bibliotheca stdio generalis descriptoribus
// 0=stdin et 1=stdout utitur; status cum Probatione I atmos.sav compatitur.

IMPORTA "bibliotheca/stdio.vindex".

FUNCTIO ATMOS2_INIT REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI s <= 0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(s) = 0.
    CONTENTUM(s + 8) = 120.
    CONTENTUM(s + 16) = 100.
    CONTENTUM(s + 24) = 100.
    CONTENTUM(s + 32) = 100.
    CONTENTUM(s + 40) = 250.
    CONTENTUM(s + 48) = 0.
    CONTENTUM(s + 56) = 7319.
    CONTENTUM(s + 64) = 0.
    CONTENTUM(s + 72) = 0.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_CARICA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("atmos.sav").
    SI fd < 0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 48).
    DECLARA clausum SICUT NUMERUS VALENS CLAUDE(fd).
    SI n != 48 TUNC REDDE 0. FIN-SI.
    SI OCTETUS(0) != 65 || OCTETUS(1) != 84 || OCTETUS(2) != 68 || OCTETUS(3) != 49 TUNC REDDE 0. FIN-SI.
    SI OCTETUS(4) != 1 TUNC REDDE 0. FIN-SI.

    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < 10 PERFICE
        DECLARA p SICUT NUMERUS VALENS 8 + i * 4.
        DECLARA v SICUT NUMERUS VALENS OCTETUS(p).
        v = v + OCTETUS(p + 1) * 256.
        v = v + OCTETUS(p + 2) * 65536.
        v = v + OCTETUS(p + 3) * 16777216.
        CONTENTUM(s + i * 8) = v.
        i = i + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_SALVA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    DECLARA salva SICUT ORDO DE LITTERA CAPACITAS 48.
    salva[0] = 65. salva[1] = 84. salva[2] = 68. salva[3] = 49.
    salva[4] = 1. salva[5] = 0. salva[6] = 0. salva[7] = 0.

    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < 10 PERFICE
        DECLARA v SICUT NUMERUS VALENS CONTENTUM(s + i * 8).
        DECLARA p SICUT NUMERUS VALENS 8 + i * 4.
        salva[p] = v & 255.
        salva[p + 1] = (v >> 8) & 255.
        salva[p + 2] = (v >> 16) & 255.
        salva[p + 3] = (v >> 24) & 255.
        i = i + 1.
    FIN-DUM.

    DECLARA fd SICUT NUMERUS VALENS APERI_SCRIBERE("atmos.sav").
    SI fd < 0 TUNC REDDE 0. FIN-SI.
    DECLARA scriptum SICUT NUMERUS VALENS MITTE(fd, salva, 48).
    DECLARA clausum SICUT NUMERUS VALENS CLAUDE(fd).
    SI scriptum != 48 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_STATUS REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    PROCLAMA "----------------------------------------".
    PROCLAMA "ATMOS // TERMINAL DEPTH".
    PROCLAMA "VINDEX NATIVE INTERACTIVE POC II".
    PROCLAMA "CYCLE". PROCLAMA CONTENTUM(s).
    PROCLAMA "DEPTH_M". PROCLAMA CONTENTUM(s + 8).
    PROCLAMA "OXYGEN". PROCLAMA CONTENTUM(s + 16).
    PROCLAMA "ENERGY". PROCLAMA CONTENTUM(s + 24).
    PROCLAMA "HULL". PROCLAMA CONTENTUM(s + 32).
    PROCLAMA "CREDITS". PROCLAMA CONTENTUM(s + 40).
    PROCLAMA "ORE". PROCLAMA CONTENTUM(s + 48).
    PROCLAMA "WORLD_SEED". PROCLAMA CONTENTUM(s + 56).
    PROCLAMA "----------------------------------------".
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_AUXILIUM REDDENS NUMERUS.
    PROCLAMA "COMMANDS: status scan descend ascend mine trade repair new help quit".
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_EVENTUM REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    DECLARA profunditas SICUT NUMERUS VALENS CONTENTUM(s + 8).
    SI profunditas <= 300 TUNC REDDE 0. FIN-SI.
    DECLARA eventum SICUT NUMERUS VALENS (CONTENTUM(s + 56) * 97 + CONTENTUM(s) * 31 + profunditas * 7) % 100.
    SI eventum < 4 TUNC
        DECLARA integritas SICUT NUMERUS VALENS CONTENTUM(s + 32) - 7.
        SI integritas < 0 TUNC integritas = 0. FIN-SI.
        CONTENTUM(s + 32) = integritas.
        PROCLAMA "EVENT: PRESSURE FRACTURE".
        REDDE 1.
    FIN-SI.
    SI eventum >= 4 && eventum < 8 TUNC
        CONTENTUM(s + 40) = CONTENTUM(s + 40) + 25.
        PROCLAMA "EVENT: SALVAGE CACHE".
        REDDE 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ATMOS2_SCAN REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI CONTENTUM(s + 24) < 3 || CONTENTUM(s + 16) < 1 TUNC
        PROCLAMA "SCAN DENIED: INSUFFICIENT ENERGY/OXYGEN".
        REDDE 0.
    FIN-SI.
    CONTENTUM(s + 24) = CONTENTUM(s + 24) - 3.
    CONTENTUM(s + 16) = CONTENTUM(s + 16) - 1.
    CONTENTUM(s) = CONTENTUM(s) + 1.
    DECLARA signum SICUT NUMERUS VALENS (CONTENTUM(s + 56) + CONTENTUM(s) * 17 + CONTENTUM(s + 8) * 11) % 100.
    SI signum < 35 TUNC PROCLAMA "SONAR: MINERAL FIELD". FIN-SI.
    SI signum >= 35 && signum < 60 TUNC PROCLAMA "SONAR: STRUCTURE ECHO". FIN-SI.
    SI signum >= 60 && signum < 85 TUNC PROCLAMA "SONAR: CONVOY TRACE". FIN-SI.
    SI signum >= 85 TUNC PROCLAMA "SONAR: THE BELOW NOISE". FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_DESCENDE REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI CONTENTUM(s + 24) < 8 || CONTENTUM(s + 16) < 6 TUNC
        PROCLAMA "DESCENT DENIED: INSUFFICIENT ENERGY/OXYGEN".
        REDDE 0.
    FIN-SI.
    CONTENTUM(s + 8) = CONTENTUM(s + 8) + 150.
    CONTENTUM(s + 24) = CONTENTUM(s + 24) - 8.
    CONTENTUM(s + 16) = CONTENTUM(s + 16) - 6.
    CONTENTUM(s) = CONTENTUM(s) + 1.
    PROCLAMA "DESCENT COMPLETE".
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_ASCENDE REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI CONTENTUM(s + 24) < 5 || CONTENTUM(s + 16) < 3 TUNC
        PROCLAMA "ASCENT DENIED: INSUFFICIENT ENERGY/OXYGEN".
        REDDE 0.
    FIN-SI.
    DECLARA nova SICUT NUMERUS VALENS CONTENTUM(s + 8) - 150.
    SI nova < 0 TUNC nova = 0. FIN-SI.
    CONTENTUM(s + 8) = nova.
    CONTENTUM(s + 24) = CONTENTUM(s + 24) - 5.
    CONTENTUM(s + 16) = CONTENTUM(s + 16) - 3.
    CONTENTUM(s) = CONTENTUM(s) + 1.
    SI nova == 0 TUNC
        CONTENTUM(s + 16) = 100.
        DECLARA energia SICUT NUMERUS VALENS CONTENTUM(s + 24) + 10.
        SI energia > 100 TUNC energia = 100. FIN-SI.
        CONTENTUM(s + 24) = energia.
        PROCLAMA "SURFACE LINK RESTORED".
    ALITER
        PROCLAMA "ASCENT COMPLETE".
    FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_MINERA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI CONTENTUM(s + 8) < 100 TUNC
        PROCLAMA "MINING DENIED: DEPTH TOO LOW".
        REDDE 0.
    FIN-SI.
    SI CONTENTUM(s + 24) < 12 || CONTENTUM(s + 16) < 4 TUNC
        PROCLAMA "MINING DENIED: INSUFFICIENT ENERGY/OXYGEN".
        REDDE 0.
    FIN-SI.
    DECLARA lucrum SICUT NUMERUS VALENS 5 + ((CONTENTUM(s + 56) + CONTENTUM(s) + CONTENTUM(s + 8)) % 11).
    CONTENTUM(s + 48) = CONTENTUM(s + 48) + lucrum.
    CONTENTUM(s + 24) = CONTENTUM(s + 24) - 12.
    CONTENTUM(s + 16) = CONTENTUM(s + 16) - 4.
    CONTENTUM(s) = CONTENTUM(s) + 1.
    PROCLAMA "ORE EXTRACTED". PROCLAMA lucrum.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_MERCATURA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI CONTENTUM(s + 8) > 150 TUNC
        PROCLAMA "TRADE DENIED: RETURN NEAR THE SURFACE".
        REDDE 0.
    FIN-SI.
    SI CONTENTUM(s + 48) <= 0 TUNC
        PROCLAMA "TRADE DENIED: NO ORE".
        REDDE 0.
    FIN-SI.
    DECLARA pretium SICUT NUMERUS VALENS 8 + ((CONTENTUM(s + 56) + CONTENTUM(s)) % 5).
    DECLARA minera SICUT NUMERUS VALENS CONTENTUM(s + 48).
    CONTENTUM(s + 40) = CONTENTUM(s + 40) + minera * pretium.
    CONTENTUM(s + 48) = 0.
    CONTENTUM(s) = CONTENTUM(s) + 1.
    PROCLAMA "TRADE COMPLETE".
    PROCLAMA "PRICE_PER_ORE". PROCLAMA pretium.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_REPARA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI CONTENTUM(s + 32) >= 100 TUNC
        PROCLAMA "REPAIR DENIED: HULL ALREADY NOMINAL".
        REDDE 0.
    FIN-SI.
    SI CONTENTUM(s + 40) < 40 TUNC
        PROCLAMA "REPAIR DENIED: INSUFFICIENT CREDITS".
        REDDE 0.
    FIN-SI.
    CONTENTUM(s + 40) = CONTENTUM(s + 40) - 40.
    DECLARA integritas SICUT NUMERUS VALENS CONTENTUM(s + 32) + 20.
    SI integritas > 100 TUNC integritas = 100. FIN-SI.
    CONTENTUM(s + 32) = integritas.
    CONTENTUM(s) = CONTENTUM(s) + 1.
    PROCLAMA "HULL REPAIRED".
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ATMOS2_FINIS REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI CONTENTUM(s + 16) <= 0 TUNC PROCLAMA "MISSION LOST: OXYGEN DEPLETED". REDDE 1. FIN-SI.
    SI CONTENTUM(s + 24) <= 0 TUNC PROCLAMA "MISSION LOST: ENERGY DEPLETED". REDDE 1. FIN-SI.
    SI CONTENTUM(s + 32) <= 0 TUNC PROCLAMA "MISSION LOST: HULL FAILURE". REDDE 1. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA status SICUT NUMERUS VALENS RESERVA_OCTETA(80).
    SI status <= 0 TUNC PROCLAMA "ERRATUM: memoria status deest". REDDE 71. FIN-SI.

    DECLARA caricum SICUT NUMERUS VALENS ATMOS2_CARICA(status).
    SI caricum == 0 TUNC
        DECLARA initium SICUT NUMERUS VALENS ATMOS2_INIT(status).
        SI initium == 0 TUNC REDDE 72. FIN-SI.
        SI ATMOS2_SALVA(status) == 0 TUNC REDDE 74. FIN-SI.
        PROCLAMA "NEW EXPEDITION CREATED".
    FIN-SI.

    DECLARA linea SICUT ORDO DE LITTERA CAPACITAS 64.
    DECLARA c_status SICUT ORDO DE LITTERA CAPACITAS 6.
    c_status[0]=115. c_status[1]=116. c_status[2]=97. c_status[3]=116. c_status[4]=117. c_status[5]=115.
    DECLARA c_scan SICUT ORDO DE LITTERA CAPACITAS 4.
    c_scan[0]=115. c_scan[1]=99. c_scan[2]=97. c_scan[3]=110.
    DECLARA c_descend SICUT ORDO DE LITTERA CAPACITAS 7.
    c_descend[0]=100. c_descend[1]=101. c_descend[2]=115. c_descend[3]=99. c_descend[4]=101. c_descend[5]=110. c_descend[6]=100.
    DECLARA c_ascend SICUT ORDO DE LITTERA CAPACITAS 6.
    c_ascend[0]=97. c_ascend[1]=115. c_ascend[2]=99. c_ascend[3]=101. c_ascend[4]=110. c_ascend[5]=100.
    DECLARA c_mine SICUT ORDO DE LITTERA CAPACITAS 4.
    c_mine[0]=109. c_mine[1]=105. c_mine[2]=110. c_mine[3]=101.
    DECLARA c_trade SICUT ORDO DE LITTERA CAPACITAS 5.
    c_trade[0]=116. c_trade[1]=114. c_trade[2]=97. c_trade[3]=100. c_trade[4]=101.
    DECLARA c_repair SICUT ORDO DE LITTERA CAPACITAS 6.
    c_repair[0]=114. c_repair[1]=101. c_repair[2]=112. c_repair[3]=97. c_repair[4]=105. c_repair[5]=114.
    DECLARA c_new SICUT ORDO DE LITTERA CAPACITAS 3.
    c_new[0]=110. c_new[1]=101. c_new[2]=119.
    DECLARA c_help SICUT ORDO DE LITTERA CAPACITAS 4.
    c_help[0]=104. c_help[1]=101. c_help[2]=108. c_help[3]=112.
    DECLARA c_quit SICUT ORDO DE LITTERA CAPACITAS 4.
    c_quit[0]=113. c_quit[1]=117. c_quit[2]=105. c_quit[3]=116.

    PROCLAMA "ATMOS LINK ONLINE — INTERACTIVE VINDEX SESSION".
    DECLARA visus_init SICUT NUMERUS VALENS ATMOS2_STATUS(status).
    DECLARA aux_init SICUT NUMERUS VALENS ATMOS2_AUXILIUM().

    DECLARA currit SICUT NUMERUS VALENS 1.
    DUM currit == 1 PERFICE
        DECLARA promptum SICUT NUMERUS VALENS STDIO_PROMPTUM().
        SI promptum != 2 TUNC PROCLAMA "ERRATUM: stdout promptum". REDDE 75. FIN-SI.
        DECLARA n SICUT NUMERUS VALENS STDIO_LEGE_LINEAM(linea, 64).
        SI n == -2 TUNC
            PROCLAMA "EOF — SESSION CLOSED".
            DESINE.
        FIN-SI.
        SI n < 0 TUNC PROCLAMA "ERRATUM: stdin lectio". REDDE 76. FIN-SI.
        SI n == 0 TUNC PERGE. FIN-SI.

        DECLARA tractatum SICUT NUMERUS VALENS 0.
        DECLARA mutatum SICUT NUMERUS VALENS 0.

        SI STDIO_AEQUA(linea, n, c_status, 6) == 1 TUNC
            DECLARA visus SICUT NUMERUS VALENS ATMOS2_STATUS(status).
            tractatum = 1.
        FIN-SI.
        SI tractatum == 0 && STDIO_AEQUA(linea, n, c_help, 4) == 1 TUNC
            DECLARA aux SICUT NUMERUS VALENS ATMOS2_AUXILIUM().
            tractatum = 1.
        FIN-SI.
        SI tractatum == 0 && STDIO_AEQUA(linea, n, c_new, 3) == 1 TUNC
            DECLARA novum SICUT NUMERUS VALENS ATMOS2_INIT(status).
            SI novum == 0 || ATMOS2_SALVA(status) == 0 TUNC REDDE 74. FIN-SI.
            PROCLAMA "NEW EXPEDITION CREATED".
            DECLARA visus_novus SICUT NUMERUS VALENS ATMOS2_STATUS(status).
            tractatum = 1.
        FIN-SI.
        SI tractatum == 0 && STDIO_AEQUA(linea, n, c_scan, 4) == 1 TUNC
            mutatum = ATMOS2_SCAN(status). tractatum = 1.
        FIN-SI.
        SI tractatum == 0 && STDIO_AEQUA(linea, n, c_descend, 7) == 1 TUNC
            mutatum = ATMOS2_DESCENDE(status). tractatum = 1.
        FIN-SI.
        SI tractatum == 0 && STDIO_AEQUA(linea, n, c_ascend, 6) == 1 TUNC
            mutatum = ATMOS2_ASCENDE(status). tractatum = 1.
        FIN-SI.
        SI tractatum == 0 && STDIO_AEQUA(linea, n, c_mine, 4) == 1 TUNC
            mutatum = ATMOS2_MINERA(status). tractatum = 1.
        FIN-SI.
        SI tractatum == 0 && STDIO_AEQUA(linea, n, c_trade, 5) == 1 TUNC
            mutatum = ATMOS2_MERCATURA(status). tractatum = 1.
        FIN-SI.
        SI tractatum == 0 && STDIO_AEQUA(linea, n, c_repair, 6) == 1 TUNC
            mutatum = ATMOS2_REPARA(status). tractatum = 1.
        FIN-SI.
        SI tractatum == 0 && STDIO_AEQUA(linea, n, c_quit, 4) == 1 TUNC
            currit = 0. tractatum = 1.
        FIN-SI.

        SI tractatum == 0 TUNC
            PROCLAMA "UNKNOWN COMMAND — TYPE help".
        FIN-SI.

        SI mutatum == 1 TUNC
            DECLARA eventum SICUT NUMERUS VALENS ATMOS2_EVENTUM(status).
            SI ATMOS2_SALVA(status) == 0 TUNC PROCLAMA "ERRATUM: save scribi non potest". REDDE 74. FIN-SI.
            DECLARA visus_post SICUT NUMERUS VALENS ATMOS2_STATUS(status).
            SI ATMOS2_FINIS(status) == 1 TUNC currit = 0. FIN-SI.
        FIN-SI.
    FIN-DUM.

    PROCLAMA "SESSION CLOSED".
    REDDE 0.
FIN-FUNCTIO.
