# VINDEX Officina — forma declarativa Graphica 0.36.
FENESTRA	fenestra	VINDEX Officina	1180	780	10
VERTICALIS	radix	fenestra	8	INITIUM	1
HORIZONTALIS	caput	radix	12	INITIUM	0
TITULUS	marca	caput	VINDEX // OFFICINA	INITIUM	INITIUM	0
TITULUS	via	caput	fons nondum servatus	FINIS	FINIS	1
HORIZONTALIS	instrumenta	radix	6	INITIUM	0
BULLA	novum	instrumenta	NOVUM	78	Novum fontem VINDEX crea	INITIUM	0
BULLA	aperi	instrumenta	APERI	79	Fontem .vindex aperi	INITIUM	0
BULLA	serva	instrumenta	SERVA	83	Fontem serva	INITIUM	0
BULLA	exsequere	instrumenta	EXSEQUERE	88	Programma compilatum exsequere	FINIS	0
BULLA	compila	instrumenta	COMPILA	67	Fontem in ELF compila	FINIS	0
SEPARATOR	separator	radix	HORIZONTALIS	INITIUM	0
DIVISOR	panis	radix	VERTICALIS	520	INITIUM	1
EDITOR	fons	panis	ARGUMENTUM:@fons_initialis.vindex	via	PRIMUM	1
EXITUS	exitus	panis	VINDEX Officina graphica parata est.\nCompilator nativus exspectat.\n	180	SECUNDUM	0
TITULUS	status	radix	VINDEX Officina parata est	INITIUM	FINIS	0
STILUS	@officina.stilus
ICONA	fenestra	@../officina/vindex.svg
EVENTUM_CLAUSURAE	81
# Actiones fasciculorum respondent eventis NOVUM, APERI et SERVA.
RESPONSUM	78	NOVUM	fons	via	@fons_initialis.vindex
RESPONSUM	78	TEXTUS	exitus	Novus fons VINDEX paratus est.\n
RESPONSUM	78	TEXTUS	status	NOVUM: fons creatus est
RESPONSUM	79	APERI	fons	via	FONTEM APERI
RESPONSUM	79	TEXTUS	status	APERTIO: dialogus clausus est
RESPONSUM	83	SERVA	fons	via	FONTEM SERVA	programma.vindex
RESPONSUM	83	TEXTUS	status	RECTE: fons servatus est
# 99 = compilatio incepta; 120 = executio incepta.
RESPONSUM	99	TEXTUS	status	COMPILATIO A VINDEX INCIPIT…
RESPONSUM	99	SENSIBILIS	compila	0
RESPONSUM	99	SENSIBILIS	exsequere	0
RESPONSUM	120	TEXTUS	status	EXECUTIO A VINDEX INCIPIT…
RESPONSUM	120	SENSIBILIS	compila	0
RESPONSUM	120	SENSIBILIS	exsequere	0
# 82 = recte; 69 = erratum.
RESPONSUM	82	TEXTUS_ARCHIVO	exitus	.vindex-graphica-relatio
RESPONSUM	82	TEXTUS	status	RECTE: actio perfecta est
RESPONSUM	82	SENSIBILIS	compila	1
RESPONSUM	82	SENSIBILIS	exsequere	1
RESPONSUM	69	TEXTUS_ARCHIVO	exitus	.vindex-graphica-relatio
RESPONSUM	69	TEXTUS	status	ERRATUM: actio defecit
RESPONSUM	69	SENSIBILIS	compila	1
RESPONSUM	69	SENSIBILIS	exsequere	1
