                                    DECLARA es_flot_pcs SICUT NUMERUS VALENS PROSPICE_EST_FLUITANS(fons, CONTENTUM(pos_fontis), n, tabula).

                                    SI fons[CONTENTUM(pos_fontis)] == 34 TUNC
                                        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
