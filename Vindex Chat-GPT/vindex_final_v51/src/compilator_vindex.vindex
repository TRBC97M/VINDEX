            FIN-DUM.
            DECLARA idx_registrum_forma SICUT NUMERUS VALENS 0.
            DUM idx_registrum_forma < 15 && tabula[950 + idx_registrum_forma] != 0 PERFICE
                idx_registrum_forma = idx_registrum_forma + 1.
            FIN-DUM.
            tabula[950 + idx_registrum_forma] = nomen_forma.
            DECLARA summa_magnitudinis_forma SICUT NUMERUS VALENS 0.
