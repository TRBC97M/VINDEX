                                    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 3, 1).
                                    CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 1, 3).

                                    CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 9, 1).
                                    CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 2, 1).
                                    CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 6, 8).
                                    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 0, 1).
                                    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 7, 1).
                                    CONTENTUM(pos_codicis) = COMPONE_VOCA_NUCLEUM(codex, CONTENTUM(pos_codicis)).

                                    CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 7, 8).
                                    CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 6, 9).
                                    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 0, 11).
                                    CONTENTUM(pos_codicis) = COMPONE_VOCA_NUCLEUM(codex, CONTENTUM(pos_codicis)).

                                    DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                    FIN-DUM.
                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

                                ALITER
                                SI fons[i] == 80 && i + 3 < n && fons[i+1] == 69 && fons[i+2] == 82 && fons[i+3] == 32 TUNC
                                    CONTENTUM(pos_fontis) = i + 4.
                                    DECLARA ig_per SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                                    DECLARA nomen_per SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, pos_fontis, n).
                                    ig_per = IGNORA_SPATIA(fons, pos_fontis, n).
                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 3.
                                    ig_per = IGNORA_SPATIA(fons, pos_fontis, n).
                                    ig_per = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).

                                    DECLARA intervallum_i_per SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).
                                    DECLARA idx_per SICUT NUMERUS VALENS PROXIMUS_LOCUS_LIBER(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris)).
                                    LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_per, 0, nomen_per).
                                    LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_per, 1, intervallum_i_per).
                                    CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
                                    CONTENTUM(pos_codicis) = COMPONE_SERVA_PILA(codex, CONTENTUM(pos_codicis), intervallum_i_per, 0).

                                    ig_per = IGNORA_SPATIA(fons, pos_fontis, n).
                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 3.
                                    ig_per = IGNORA_SPATIA(fons, pos_fontis, n).
                                    ig_per = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).

                                    DECLARA intervallum_limes_per SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).
                                    CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
                                    CONTENTUM(pos_codicis) = COMPONE_SERVA_PILA(codex, CONTENTUM(pos_codicis), intervallum_limes_per, 0).

                                    ig_per = IGNORA_SPATIA(fons, pos_fontis, n).
                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 8.

                                    DECLARA pos_initium_per SICUT NUMERUS VALENS CONTENTUM(pos_codicis).
                                    CONTENTUM(pos_codicis) = COMPONE_SUME_PILA(codex, CONTENTUM(pos_codicis), 0, intervallum_i_per).
                                    CONTENTUM(pos_codicis) = COMPONE_SUME_PILA(codex, CONTENTUM(pos_codicis), 3, intervallum_limes_per).
                                    CONTENTUM(pos_codicis) = COMPONE_SUB(codex, CONTENTUM(pos_codicis), 0, 3).
                                    DECLARA loci_jg_per SICUT NUMERUS VALENS 0.
                                    CONTENTUM(pos_codicis) = COMPONE_JG_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_jg_per)).

                                    ig_per = ANALYSA_BLOCUS(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).

                                    CONTENTUM(pos_codicis) = COMPONE_SUME_PILA(codex, CONTENTUM(pos_codicis), 0, intervallum_i_per).
                                    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 3, 1).
                                    CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 0, 3).
                                    CONTENTUM(pos_codicis) = COMPONE_SERVA_PILA(codex, CONTENTUM(pos_codicis), intervallum_i_per, 0).
                                    CONTENTUM(pos_codicis) = COMPONE_JMP_RETRO(codex, CONTENTUM(pos_codicis), pos_initium_per).

                                    DECLARA pos_fin_per SICUT NUMERUS VALENS CONTENTUM(pos_codicis).
                                    ig_per = CORRIGE_SALTUM(codex, loci_jg_per, pos_fin_per).

                                    ig_per = IGNORA_SPATIA(fons, pos_fontis, n).
                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 7.

                                ALITER
                                SI fons[i] == 68 && i + 3 < n && fons[i+1] == 85 && fons[i+2] == 77 && fons[i+3] == 32 TUNC
                                    DECLARA pos_initium_dum SICUT NUMERUS VALENS CONTENTUM(pos_codicis).
                                    CONTENTUM(pos_fontis) = i + 4.
                                    ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 3, 0).
                                    CONTENTUM(pos_codicis) = COMPONE_SUB(codex, CONTENTUM(pos_codicis), 0, 3).
                                    DECLARA loci_je_dum SICUT NUMERUS VALENS 0.
                                    CONTENTUM(pos_codicis) = COMPONE_JE_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_je_dum)).

                                    ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 8.
                                    DECLARA tabula79_ante SICUT NUMERUS VALENS STATUS_DESINE_LEGE(contextus_parseris).
                                    ignoratum = STATUS_DESINE_SCRIBE(contextus_parseris, 0).
                                    ignoratum = ANALYSA_BLOCUS(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).

                                    CONTENTUM(pos_codicis) = COMPONE_JMP_RETRO(codex, CONTENTUM(pos_codicis), pos_initium_dum).
                                    DECLARA pos_fin_dum SICUT NUMERUS VALENS CONTENTUM(pos_codicis).
                                    ignoratum = CORRIGE_SALTUM(codex, loci_je_dum, pos_fin_dum).
                                    SI STATUS_DESINE_LEGE(contextus_parseris) != 0 TUNC
                                        ignoratum = CORRIGE_SALTUM(codex, STATUS_DESINE_LEGE(contextus_parseris), pos_fin_dum).
                                    FIN-SI.
                                    ignoratum = STATUS_DESINE_SCRIBE(contextus_parseris, tabula79_ante).

                                    ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 8.

                                ALITER
                                    SI (fons[i] >= 97 && fons[i] <= 122) TUNC
                                        CONTENTUM(pos_fontis) = i.
                                        DECLARA nomen_aff SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, pos_fontis, n).
                                        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).

                                        SI CONTENTUM(pos_fontis) + 2 < n && fons[CONTENTUM(pos_fontis)] == 68 && fons[CONTENTUM(pos_fontis)+1] == 69 && fons[CONTENTUM(pos_fontis)+2] == 32 TUNC
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 3.
                                            ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).

                                            DECLARA idx_campus_aff SICUT NUMERUS VALENS INDEX_CAMPUS_ULTIMAE_FORMAE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), nomen_aff).

                                            SI fons[CONTENTUM(pos_fontis)] == 67 && CONTENTUM(pos_fontis) + 9 < n && fons[CONTENTUM(pos_fontis)+1] == 79 && fons[CONTENTUM(pos_fontis)+2] == 78 && fons[CONTENTUM(pos_fontis)+3] == 84 && fons[CONTENTUM(pos_fontis)+4] == 69 && fons[CONTENTUM(pos_fontis)+5] == 78 && fons[CONTENTUM(pos_fontis)+6] == 84 && fons[CONTENTUM(pos_fontis)+7] == 85 && fons[CONTENTUM(pos_fontis)+8] == 77 && fons[CONTENTUM(pos_fontis)+9] == 40 TUNC
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 10.
                                                DECLARA offset_ptr_campus_aff SICUT NUMERUS VALENS OFFSET_PTR_CAMPUS_STRUCTA(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), fons, CONTENTUM(pos_fontis), n, idx_campus_aff, nomen_aff, contextus_parseris).
                                                DECLARA ig_campus_ptr_aff SICUT NUMERUS VALENS ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                                ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 3, offset_ptr_campus_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 0, 3).
                                                CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).

                                                ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                                ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                                CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
                                                CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 0, 3).

                                                DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                FIN-DUM.
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ALITER

                                            DECLARA nomen_var_campus_aff SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, pos_fontis, n).
                                            DECLARA intervallum_var_campus_aff SICUT NUMERUS VALENS CERCA_VARIABILEM(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_var_campus_aff).
                                            DECLARA idx_struct_campus_aff SICUT NUMERUS VALENS STRUCTURA_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_var_campus_aff).
                                            DECLARA offset_campus_w SICUT NUMERUS VALENS 0.
                                            SI idx_struct_campus_aff > 0 TUNC
                                                offset_campus_w = CAMPUS_STRUCTURAE_OFFSET(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_struct_campus_aff - 1, nomen_aff).
                                            ALITER
                                                offset_campus_w = OFFSET_CUMULATIVUS_CAMPI(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_campus_aff).
                                            FIN-SI.

                                            SI CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] == 91 TUNC
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                DECLARA r_idxc_aff SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                                DECLARA ign_idxca SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

                                                DECLARA magnitudo_arrc_aff SICUT NUMERUS VALENS MAGNITUDO_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_var_campus_aff).
                                                SI magnitudo_arrc_aff == 0 TUNC
                                                    magnitudo_arrc_aff = 8.
                                                FIN-SI.

                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, magnitudo_arrc_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 0, 2).
                                                CONTENTUM(pos_codicis) = COMPONE_LEA_PILA(codex, CONTENTUM(pos_codicis), 3, intervallum_var_campus_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 3, 0).
                                                DECLARA correctio_ref_aff SICUT NUMERUS VALENS magnitudo_arrc_aff - 8.
                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, correctio_ref_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 3, 2).
                                                DECLARA intervallum_ic_aff2 SICUT NUMERUS VALENS 0 - offset_campus_w.
                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, intervallum_ic_aff2).
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 3, 2).
                                                CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 3).

                                                ign_idxca = IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                ign_idxca = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                                CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 1, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 3).
                                                CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 3, 1).

                                                DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                FIN-DUM.
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ALITER

                                            DECLARA intervallum_campus_aff SICUT NUMERUS VALENS intervallum_var_campus_aff - offset_campus_w.

                                            ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                            SI idx_struct_campus_aff > 0 && CAMPUS_STRUCTURAE_EST_FLUITANS(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_struct_campus_aff - 1, nomen_aff) == 1 TUNC
                                                CONTENTUM(pos_codicis) = COMPONE_MOVQ_A_XMM(codex, CONTENTUM(pos_codicis), 0, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_MOVSD_SALVA(codex, CONTENTUM(pos_codicis), intervallum_campus_aff, 0).
                                            ALITER
                                                CONTENTUM(pos_codicis) = COMPONE_SERVA_PILA(codex, CONTENTUM(pos_codicis), intervallum_campus_aff, 0).
                                            FIN-SI.
                                            DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            FIN-DUM.
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            FIN-SI.
                                            FIN-SI.

                                        ALITER
                                        DECLARA intervallum_aff SICUT NUMERUS VALENS CERCA_VARIABILEM(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_aff).
                                        DECLARA est_series_aff SICUT NUMERUS VALENS ESTNE_SERIES(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_aff).
                                        DECLARA magnitudo_aff SICUT NUMERUS VALENS MAGNITUDO_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_aff).

                                        SI fons[CONTENTUM(pos_fontis)] == 91 TUNC
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            DECLARA r_idx2 SICUT NUMERUS VALENS ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                            DECLARA ign3 SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ign3 = IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

                                            CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
                                            ign3 = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                            CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
                                            CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).

                                            SI magnitudo_aff > 0 TUNC
                                                CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 3).
                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, magnitudo_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 0, 2).
                                                SI est_series_aff == 1 TUNC
                                                    CONTENTUM(pos_codicis) = COMPONE_LEA_PILA(codex, CONTENTUM(pos_codicis), 1, intervallum_aff).
                                                ALITER
                                                    CONTENTUM(pos_codicis) = COMPONE_SUME_PILA(codex, CONTENTUM(pos_codicis), 1, intervallum_aff).
                                                FIN-SI.
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 1, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
                                                SI magnitudo_aff == 1 TUNC
                                                    CONTENTUM(pos_codicis) = COMPONE_SERVA_OCTETUM(codex, CONTENTUM(pos_codicis), 1, 0).
                                                ALITER
                                                    CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 1, 0).
                                                FIN-SI.
                                            ALITER
                                            CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 3).
                                            CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, 8).
                                            CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 0, 2).
                                            SI est_series_aff == 2 TUNC
                                                CONTENTUM(pos_codicis) = COMPONE_SUME_PILA(codex, CONTENTUM(pos_codicis), 1, intervallum_aff).
                                            ALITER
                                                CONTENTUM(pos_codicis) = COMPONE_LEA_PILA(codex, CONTENTUM(pos_codicis), 1, intervallum_aff).
                                            FIN-SI.
                                            CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 1, 0).
                                            CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
                                            SI EST_FLUITANS_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_aff) == 1 TUNC
                                                CONTENTUM(pos_codicis) = COMPONE_MOVQ_A_XMM(codex, CONTENTUM(pos_codicis), 0, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_MOVSD_SALVA_IND(codex, CONTENTUM(pos_codicis), 1, 0).
                                            ALITER
                                                CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 1, 0).
                                            FIN-SI.
                                            FIN-SI.
                                        ALITER
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                            CONTENTUM(pos_codicis) = COMPONE_SERVA_PILA(codex, CONTENTUM(pos_codicis), intervallum_aff, 0).
                                        FIN-SI.

                                        DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                        FIN-DUM.
                                        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                        FIN-SI.
                                    ALITER
                                        SI fons[i] == 67 && i + 8 < n && fons[i+1] == 79 && fons[i+2] == 78 && fons[i+3] == 84 && fons[i+4] == 69 && fons[i+5] == 78 && fons[i+6] == 84 && fons[i+7] == 85 && fons[i+8] == 77 TUNC
                                            CONTENTUM(pos_fontis) = i + 9.
                                            DECLARA ign_cw SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ign_cw = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                            ign_cw = IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
                                            ign_cw = IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ign_cw = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                            CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
                                            CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
                                            CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 0, 3).
                                            DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            FIN-DUM.
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                        ALITER
                                            SI fons[i] >= 65 && fons[i] <= 90 TUNC
                                                CONTENTUM(pos_fontis) = i.
                                                DECLARA ign_appelnu SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                                                ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ALITER
                                                CONTENTUM(pos_fontis) = i + 1.
                                            FIN-SI.
                                        FIN-SI.
                                    FIN-SI.
                                FIN-SI.
                            FIN-SI.
                        FIN-SI.
                    FIN-SI.
                FIN-SI.
            FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FORMA IntervallumNominis.
    CAMPUS c0 SICUT NUMERUS.
    CAMPUS c1 SICUT NUMERUS.
    CAMPUS c2 SICUT NUMERUS.
    CAMPUS c3 SICUT NUMERUS.
    CAMPUS c4 SICUT NUMERUS.
    CAMPUS c5 SICUT NUMERUS.
    CAMPUS c6 SICUT NUMERUS.
    CAMPUS c7 SICUT NUMERUS.
    CAMPUS c8 SICUT NUMERUS.
    CAMPUS c9 SICUT NUMERUS.
    CAMPUS c10 SICUT NUMERUS.
    CAMPUS c11 SICUT NUMERUS.
    CAMPUS c12 SICUT NUMERUS.
    CAMPUS c13 SICUT NUMERUS.
    CAMPUS c14 SICUT NUMERUS.
    CAMPUS c15 SICUT NUMERUS.
    CAMPUS c16 SICUT NUMERUS.
    CAMPUS c17 SICUT NUMERUS.
    CAMPUS c18 SICUT NUMERUS.
    CAMPUS c19 SICUT NUMERUS.
    CAMPUS c20 SICUT NUMERUS.
    CAMPUS c21 SICUT NUMERUS.
    CAMPUS c22 SICUT NUMERUS.
    CAMPUS c23 SICUT NUMERUS.
    CAMPUS c24 SICUT NUMERUS.
