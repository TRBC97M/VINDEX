    CODEX_SCRIBE(codex, indice, 232).
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (indice + 5).
    CODEX_SCRIBE(codex, indice + 1, relatio & 255).
    CODEX_SCRIBE(codex, indice + 2, (relatio >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 3, (relatio >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 4, (relatio >> 24) & 255).
