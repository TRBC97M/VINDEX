    REDDE indice + 1.
FIN-FUNCTIO.

FUNCTIO COMPONE_VOCA_IAT_DYNAMICA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.
    ACCIPIT id_functionis SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, 255).
    CODEX_SCRIBE(codex, indice + 1, 21).
    DECLARA descriptor_iat SICUT NUMERUS VALENS DESCRIPTOR_IAT_PE_LEGE(contextus_parseris).
    DECLARA index_par_iat SICUT NUMERUS VALENS PARES_QUANTITAS(descriptor_iat).
    DECLARA ign_iat1 SICUT NUMERUS VALENS PARES_SCRIBE(descriptor_iat, index_par_iat, 0, id_functionis).
    DECLARA ign_iat2 SICUT NUMERUS VALENS PARES_SCRIBE(descriptor_iat, index_par_iat, 1, indice + 2).
    REDDE indice + 6.
FIN-FUNCTIO.

FUNCTIO COMPONE_SCRIBE_STDOUT_DYNAMICA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.
    ACCIPIT longitudo SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.
    p = COMPONE_ONERA(codex, p, 2, longitudo).
    SI MODUS_PE_LEGE(contextus_parseris) == 1 TUNC
        p = COMPONE_TRANSCRIBE(codex, p, 12, 2).
        p = COMPONE_TRANSCRIBE(codex, p, 13, 6).
        CODEX_SCRIBE(codex, p, 72).
        CODEX_SCRIBE(codex, p + 1, 131).
        CODEX_SCRIBE(codex, p + 2, 236).
        CODEX_SCRIBE(codex, p + 3, 40).
        p = p + 4.
        DECLARA valor_neg_std_output SICUT NUMERUS VALENS 0 - 11.
        p = COMPONE_ONERA(codex, p, 1, valor_neg_std_output).
        p = COMPONE_VOCA_IAT_DYNAMICA(codex, p, contextus_parseris, 2).
        p = COMPONE_TRANSCRIBE(codex, p, 1, 0).
        p = COMPONE_TRANSCRIBE(codex, p, 2, 13).
        p = COMPONE_TRANSCRIBE(codex, p, 8, 12).
        CODEX_SCRIBE(codex, p, 76).
        CODEX_SCRIBE(codex, p + 1, 141).
        CODEX_SCRIBE(codex, p + 2, 76).
        CODEX_SCRIBE(codex, p + 3, 36).
        CODEX_SCRIBE(codex, p + 4, 24).
        p = p + 5.
        CODEX_SCRIBE(codex, p, 72).
        CODEX_SCRIBE(codex, p + 1, 199).
        CODEX_SCRIBE(codex, p + 2, 68).
        CODEX_SCRIBE(codex, p + 3, 36).
        CODEX_SCRIBE(codex, p + 4, 32).
        CODEX_SCRIBE(codex, p + 5, 0).
        CODEX_SCRIBE(codex, p + 6, 0).
        CODEX_SCRIBE(codex, p + 7, 0).
        CODEX_SCRIBE(codex, p + 8, 0).
        p = p + 9.
        p = COMPONE_VOCA_IAT_DYNAMICA(codex, p, contextus_parseris, 3).
        CODEX_SCRIBE(codex, p, 72).
        CODEX_SCRIBE(codex, p + 1, 131).
        CODEX_SCRIBE(codex, p + 2, 196).
        CODEX_SCRIBE(codex, p + 3, 40).
        p = p + 4.
    ALITER
        p = COMPONE_ONERA(codex, p, 0, 1).
        p = COMPONE_ONERA(codex, p, 7, 1).
        p = COMPONE_VOCA_NUCLEUM(codex, p).
    FIN-SI.
    REDDE p.
FIN-FUNCTIO.


FUNCTIO SIGNUM_VERBI REDDENS NUMERUS.
    ACCIPIT verbum SICUT ORDO DE LITTERA.
    ACCIPIT mensura SICUT NUMERUS.
    DECLARA signum SICUT NUMERUS VALENS 0.
    PER idx AB 0 AD mensura - 1 PERFICE
        signum = signum * 31 + verbum[idx].
    FIN-PER.
    REDDE signum.
FIN-FUNCTIO.

FUNCTIO EXTRAHE_ET_SIGNA REDDENS NUMERUS.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    DECLARA verbum SICUT ORDO DE LITTERA CAPACITAS 32.
    DECLARA mensura SICUT NUMERUS VALENS 0.
    DUM CONTENTUM(pos) < n && ((fons[CONTENTUM(pos)] >= 65 && fons[CONTENTUM(pos)] <= 90) || (fons[CONTENTUM(pos)] >= 97 && fons[CONTENTUM(pos)] <= 122) || fons[CONTENTUM(pos)] == 95 || (fons[CONTENTUM(pos)] >= 48 && fons[CONTENTUM(pos)] <= 57)) PERFICE
        verbum[mensura] = fons[CONTENTUM(pos)].
        mensura = mensura + 1.
        CONTENTUM(pos) = CONTENTUM(pos) + 1.
    FIN-DUM.
    REDDE SIGNUM_VERBI(verbum, mensura).
FIN-FUNCTIO.

FUNCTIO COMPONE_SHL REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI destinatio >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    CODEX_SCRIBE(codex, indice, rex).
    CODEX_SCRIBE(codex, indice + 1, 211).
    CODEX_SCRIBE(codex, indice + 2, 224 + (destinatio & 7)).
    REDDE indice + 3.
FIN-FUNCTIO.

FUNCTIO COMPONE_SHR REDDENS NUMERUS.
