    CAMPUS c28 SICUT NUMERUS.
    CAMPUS c29 SICUT NUMERUS.
    CAMPUS c30 SICUT NUMERUS.
    CAMPUS c31 SICUT NUMERUS.
FIN-FORMA.

FUNCTIO LEGE_TOTUM_DYNAMICUM REDDENS NUMERUS.
    ACCIPIT descriptor SICUT NUMERUS.
    ACCIPIT longitudo SICUT ACUS<NUMERUS>.
    DECLARA limen SICUT NUMERUS VALENS 65536.
    DECLARA basis SICUT NUMERUS VALENS RESERVA_OCTETA(limen).
    SI basis < 0 TUNC
        CONTENTUM(longitudo) = 0 - 1.
        REDDE basis.
    FIN-SI.
    DECLARA quantitas SICUT NUMERUS VALENS 0.
    DECLARA continua SICUT NUMERUS VALENS 1.
    DUM continua == 1 PERFICE
        DECLARA pars SICUT NUMERUS VALENS LEGE(descriptor, 65536).
        SI pars < 0 TUNC
            CONTENTUM(longitudo) = 0 - 1.
            REDDE pars.
        FIN-SI.
        SI pars == 0 TUNC
            continua = 0.
        ALITER
            SI quantitas + pars > limen TUNC
                DECLARA nova_capacitas SICUT NUMERUS VALENS limen * 2.
                DUM nova_capacitas < quantitas + pars PERFICE
                    nova_capacitas = nova_capacitas * 2.
                FIN-DUM.
                DECLARA nova_basis SICUT NUMERUS VALENS RESERVA_OCTETA(nova_capacitas).
                SI nova_basis < 0 TUNC
                    CONTENTUM(longitudo) = 0 - 1.
                    REDDE nova_basis.
                FIN-SI.
                DECLARA i SICUT NUMERUS VALENS 0.
                DUM i < quantitas PERFICE
                    SCRIBE_OCTETUM_AB(nova_basis + i, OCTETUS_AB(basis + i)).
                    i = i + 1.
                FIN-DUM.
                basis = nova_basis.
                limen = nova_capacitas.
            FIN-SI.
            DECLARA j SICUT NUMERUS VALENS 0.
            DUM j < pars PERFICE
                SCRIBE_OCTETUM_AB(basis + quantitas + j, OCTETUS(j)).
                j = j + 1.
            FIN-DUM.
            quantitas = quantitas + pars.
        FIN-SI.
    FIN-DUM.
    CONTENTUM(longitudo) = quantitas.
    REDDE basis.
FIN-FUNCTIO.

FUNCTIO ASSECURA_BUFFERUM REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT necessaria SICUT NUMERUS.
    ACCIPIT limen SICUT ACUS<NUMERUS>.
    SI necessaria <= CONTENTUM(limen) TUNC
        REDDE basis.
    FIN-SI.
    DECLARA nova_capacitas SICUT NUMERUS VALENS CONTENTUM(limen) * 2.
    DUM nova_capacitas < necessaria PERFICE
        nova_capacitas = nova_capacitas * 2.
    FIN-DUM.
    DECLARA nova_basis SICUT NUMERUS VALENS RESERVA_OCTETA(nova_capacitas).
    SI nova_basis < 0 TUNC
        REDDE nova_basis.
    FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < longitudo PERFICE
        SCRIBE_OCTETUM_AB(nova_basis + i, OCTETUS_AB(basis + i)).
        i = i + 1.
    FIN-DUM.
    CONTENTUM(limen) = nova_capacitas.
    REDDE nova_basis.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    ACCIPIT argc SICUT NUMERUS.
    ACCIPIT argv SICUT ACUS<NUMERUS>.

    SI argc < 3 TUNC
        PROCLAMA "USUS: compilator_vindex <fons.vindex> <exsecutabile> [pe]".
        REDDE 64.
    FIN-SI.

    DECLARA modus_pe SICUT NUMERUS VALENS 0.
    SI argc >= 4 TUNC
        DECLARA arg3 SICUT ACUS<LITTERA> VALENS argv[3].
        SI arg3[0] == 112 && arg3[1] == 101 && arg3[2] == 0 TUNC
            modus_pe = 1.
        FIN-SI.
    FIN-SI.

    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE(argv[1]).
    SI fd < 0 TUNC
        PROCLAMA "ERRATUM: fons aperiri non potest".
        REDDE 66.
    FIN-SI.
    DECLARA n SICUT NUMERUS VALENS 0.
    DECLARA basis_fons_brut SICUT NUMERUS VALENS LEGE_TOTUM_DYNAMICUM(fd, SEDES(n)).
    CLAUDE(fd).
    SI n < 0 || basis_fons_brut < 0 TUNC
        PROCLAMA "ERRATUM: fons legi non potest".
        REDDE 74.
    FIN-SI.
    DECLARA fons_brut SICUT ACUS<LITTERA> VALENS basis_fons_brut.
    DECLARA capacitas_fons SICUT NUMERUS VALENS 65536.
    DECLARA basis_fons SICUT NUMERUS VALENS RESERVA_OCTETA(capacitas_fons).
    SI basis_fons < 0 TUNC
        PROCLAMA "ERRATUM: memoria fontium reservata non est".
        REDDE 71.
    FIN-SI.
    DECLARA pos_out_imp SICUT NUMERUS VALENS 0.
    DECLARA i_imp SICUT NUMERUS VALENS 0.

    DUM i_imp < n PERFICE
        SI fons_brut[i_imp] == 73 && i_imp + 7 < n && fons_brut[i_imp+1] == 77 && fons_brut[i_imp+2] == 80 && fons_brut[i_imp+3] == 79 && fons_brut[i_imp+4] == 82 && fons_brut[i_imp+5] == 84 && fons_brut[i_imp+6] == 65 && fons_brut[i_imp+7] == 32 TUNC
            i_imp = i_imp + 8.
            DUM i_imp < n && fons_brut[i_imp] != 34 PERFICE
                i_imp = i_imp + 1.
            FIN-DUM.
            i_imp = i_imp + 1.
            DECLARA debut_nom_imp SICUT NUMERUS VALENS i_imp.
            DUM i_imp < n && fons_brut[i_imp] != 34 PERFICE
                i_imp = i_imp + 1.
            FIN-DUM.
            DECLARA fin_nom_imp SICUT NUMERUS VALENS i_imp.

            DECLARA nomen_base_imp SICUT NUMERUS VALENS RESERVA(IntervallumNominis).
            DECLARA j_imp SICUT NUMERUS VALENS 0.
            DECLARA k2_imp SICUT NUMERUS VALENS debut_nom_imp.
            DUM k2_imp < fin_nom_imp PERFICE
                SCRIBE_OCTETUM_AB(nomen_base_imp + j_imp, fons_brut[k2_imp]).
                j_imp = j_imp + 1.
                k2_imp = k2_imp + 1.
            FIN-DUM.
            SCRIBE_OCTETUM_AB(nomen_base_imp + j_imp, 0).

            i_imp = i_imp + 1.
            DUM i_imp < n && fons_brut[i_imp] != 46 PERFICE
                i_imp = i_imp + 1.
            FIN-DUM.
            i_imp = i_imp + 1.

            DECLARA fd_imp2 SICUT NUMERUS VALENS APERI_LEGERE(nomen_base_imp).
            SI fd_imp2 >= 0 TUNC
                DECLARA n_imp2 SICUT NUMERUS VALENS 0.
                DECLARA basis_imp SICUT NUMERUS VALENS LEGE_TOTUM_DYNAMICUM(fd_imp2, SEDES(n_imp2)).
                CLAUDE(fd_imp2).
                SI n_imp2 < 0 || basis_imp < 0 TUNC
                    PROCLAMA "ERRATUM: fons importatus legi non potest".
                    REDDE 74.
                FIN-SI.
                DECLARA basis_crescens SICUT NUMERUS VALENS ASSECURA_BUFFERUM(basis_fons, pos_out_imp, pos_out_imp + n_imp2 + 1, SEDES(capacitas_fons)).
                SI basis_crescens < 0 TUNC
                    PROCLAMA "ERRATUM: memoria fontium augeri non potest".
                    REDDE 71.
                FIN-SI.
                basis_fons = basis_crescens.
                DECLARA m_imp SICUT NUMERUS VALENS 0.
                DUM m_imp < n_imp2 PERFICE
                    SCRIBE_OCTETUM_AB(basis_fons + pos_out_imp, OCTETUS_AB(basis_imp + m_imp)).
                    pos_out_imp = pos_out_imp + 1.
                    m_imp = m_imp + 1.
                FIN-DUM.
                SCRIBE_OCTETUM_AB(basis_fons + pos_out_imp, 10).
                pos_out_imp = pos_out_imp + 1.
            ALITER
                PROCLAMA "ERRATUM: fons importatus aperiri non potest".
                REDDE 66.
            FIN-SI.
        ALITER
            i_imp = i_imp + 1.
        FIN-SI.
    FIN-DUM.

    DECLARA basis_finalis SICUT NUMERUS VALENS ASSECURA_BUFFERUM(basis_fons, pos_out_imp, pos_out_imp + n, SEDES(capacitas_fons)).
    SI basis_finalis < 0 TUNC
        PROCLAMA "ERRATUM: memoria fontis finalis augeri non potest".
        REDDE 71.
    FIN-SI.
    basis_fons = basis_finalis.
    DECLARA m2_imp SICUT NUMERUS VALENS 0.
    DUM m2_imp < n PERFICE
        SCRIBE_OCTETUM_AB(basis_fons + pos_out_imp, OCTETUS_AB(basis_fons_brut + m2_imp)).
        pos_out_imp = pos_out_imp + 1.
        m2_imp = m2_imp + 1.
    FIN-DUM.
    n = pos_out_imp.
    DECLARA fons SICUT ACUS<LITTERA> VALENS basis_fons.

    DECLARA codex SICUT ACUS<NUMERUS> VALENS RESERVA_OCTETA(24).
    SI codex < 0 TUNC
        PROCLAMA "ERRATUM: descriptorium codicis reservatum non est".
        REDDE 71.
    FIN-SI.
    DECLARA status_initii_codicis SICUT NUMERUS VALENS INITIA_CODEX(codex, 65536).
    SI status_initii_codicis != 0 TUNC
        PROCLAMA "ERRATUM: memoria codicis reservata non est".
        REDDE 71.
    FIN-SI.
    DECLARA capita_reservata SICUT NUMERUS VALENS 120.
    SI modus_pe == 1 TUNC
        capita_reservata = 512.
    FIN-SI.
    DECLARA pos SICUT NUMERUS VALENS capita_reservata.
    DECLARA punctum_ingressus SICUT NUMERUS VALENS capita_reservata.
    DECLARA inventa_principalis SICUT NUMERUS VALENS 0.
    DECLARA loci_iat_exitprocess SICUT NUMERUS VALENS 0.
    DECLARA loci_iat_virtualalloc SICUT NUMERUS VALENS 0.

    DECLARA contextus_parseris SICUT ACUS<NUMERUS> VALENS RESERVA_OCTETA(72).
    SI contextus_parseris < 0 TUNC
        PROCLAMA "ERRATUM: memoria contextus parseris reservata non est".
        REDDE 71.
    FIN-SI.
    CONTENTUM(contextus_parseris) = 0.
    DECLARA ign_mpe SICUT NUMERUS VALENS MODUS_PE_SCRIBE(contextus_parseris, modus_pe).
    DECLARA descriptor_iat_pe_contextus SICUT NUMERUS VALENS RESERVA_OCTETA(24).
    SI descriptor_iat_pe_contextus < 0 TUNC
        PROCLAMA "ERRATUM: memoria descriptoris IAT reservata non est".
        REDDE 71.
    FIN-SI.
    DECLARA ign_diat SICUT NUMERUS VALENS DESCRIPTOR_IAT_PE_SCRIBE(contextus_parseris, descriptor_iat_pe_contextus).
    DECLARA status_iat_dynam SICUT NUMERUS VALENS INITIA_PARES_DYNAMICA(DESCRIPTOR_IAT_PE_LEGE(contextus_parseris), 16).
    SI status_iat_dynam != 0 TUNC
        PROCLAMA "ERRATUM: memoria pariam IAT reservata non est".
        REDDE 71.
    FIN-SI.
    DECLARA descriptor_functionum_contextus SICUT NUMERUS VALENS RESERVA_OCTETA(24).
    DECLARA descriptor_pendentium_contextus SICUT NUMERUS VALENS RESERVA_OCTETA(24).
    SI descriptor_functionum_contextus < 0 || descriptor_pendentium_contextus < 0 TUNC
        PROCLAMA "ERRATUM: memoria descriptorum functionum reservata non est".
        REDDE 71.
    FIN-SI.
    DESCRIPTOR_FUNCTIONUM_SCRIBE(contextus_parseris, descriptor_functionum_contextus).
    DESCRIPTOR_PENDENTIUM_SCRIBE(contextus_parseris, descriptor_pendentium_contextus).
    DECLARA descriptor_localium_contextus SICUT NUMERUS VALENS RESERVA_OCTETA(24).
    SI descriptor_localium_contextus < 0 TUNC
        PROCLAMA "ERRATUM: memoria descriptoris localium reservata non est".
        REDDE 71.
    FIN-SI.
    DESCRIPTOR_LOCALIUM_SCRIBE(contextus_parseris, descriptor_localium_contextus).
    DECLARA descriptor_formarum_contextus SICUT NUMERUS VALENS RESERVA_OCTETA(32).
    SI descriptor_formarum_contextus < 0 TUNC
        PROCLAMA "ERRATUM: memoria descriptoris formarum reservata non est".
        REDDE 71.
    FIN-SI.
    DESCRIPTOR_FORMARUM_SCRIBE(contextus_parseris, descriptor_formarum_contextus).
    CONTENTUM(contextus_parseris + 8) = 0.
    DECLARA status_locorum_dynam SICUT NUMERUS VALENS INITIA_LOCA_DYNAMICA(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris)).
    SI status_locorum_dynam != 0 TUNC
        PROCLAMA "ERRATUM: memoria symbolorum localium reservata non est".
        REDDE 71.
    FIN-SI.
    DECLARA status_functionum_dynam SICUT NUMERUS VALENS INITIA_PARES_DYNAMICA(DESCRIPTOR_FUNCTIONUM_LEGE(contextus_parseris), 64).
    DECLARA status_pendentium_dynam SICUT NUMERUS VALENS INITIA_PARES_DYNAMICA(DESCRIPTOR_PENDENTIUM_LEGE(contextus_parseris), 64).
    SI status_functionum_dynam != 0 || status_pendentium_dynam != 0 TUNC
        PROCLAMA "ERRATUM: memoria functionum dynamicarum reservata non est".
        REDDE 71.
    FIN-SI.
    DECLARA status_formarum_dynam SICUT NUMERUS VALENS INITIA_FORMAS_DYNAMICA(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris)).
    SI status_formarum_dynam != 0 TUNC
        PROCLAMA "ERRATUM: memoria formarum dynamicarum reservata non est".
        REDDE 71.
    FIN-SI.

    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < n PERFICE
        SI fons[i] == 73 && i + 7 < n && fons[i+1] == 77 && fons[i+2] == 80 && fons[i+3] == 79 && fons[i+4] == 82 && fons[i+5] == 84 && fons[i+6] == 65 && fons[i+7] == 32 TUNC
            i = i + 8.
            DUM i < n && fons[i] != 46 PERFICE
                i = i + 1.
            FIN-DUM.
            i = i + 1.
        ALITER
        SI fons[i] == 70 && i + 1 < n && fons[i+1] == 79 TUNC
            i = i + 6.
            DECLARA nomen_forma SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, SEDES(i), n).
            DUM i < n && fons[i] != 46 PERFICE
                i = i + 1.
            FIN-DUM.
            i = i + 1.
            DECLARA idx_registrum_forma SICUT NUMERUS VALENS FORMARUM_QUANTITAS(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris)).
            DECLARA status_formae SICUT NUMERUS VALENS FORMA_SCRIBE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_registrum_forma, 0, nomen_forma).
            SI status_formae == 0 TUNC
                status_formae = INITIA_CAMPI_FORMA(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_registrum_forma, 8).
            FIN-SI.
            SI status_formae != 0 TUNC
                PROCLAMA "ERRATUM: memoria camporum formae reservata non est".
                REDDE 71.
            FIN-SI.
            DECLARA numerus_campi SICUT NUMERUS VALENS 0.
            DECLARA offset_cumul_forma SICUT NUMERUS VALENS 0.
            DECLARA continua_forma SICUT NUMERUS VALENS 1.
            DUM continua_forma == 1 PERFICE
                DECLARA ig_fm SICUT NUMERUS VALENS IGNORA_SPATIA(fons, SEDES(i), n).
                SI fons[i] == 67 && i + 6 < n && fons[i+1] == 65 && fons[i+2] == 77 && fons[i+3] == 80 && fons[i+4] == 85 && fons[i+5] == 83 && fons[i+6] == 32 TUNC
                    i = i + 7.
                    DECLARA nomen_campus SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, SEDES(i), n).
                    DECLARA ig_fm2 SICUT NUMERUS VALENS IGNORA_SPATIA(fons, SEDES(i), n).
                    DECLARA magnitudo_campus SICUT NUMERUS VALENS 8.
                    DECLARA est_fluitans_campus SICUT NUMERUS VALENS 0.
                    SI fons[i] == 83 && i + 5 < n && fons[i+1] == 73 && fons[i+2] == 67 && fons[i+3] == 85 && fons[i+4] == 84 && fons[i+5] == 32 TUNC
                        i = i + 6.
                        ig_fm2 = IGNORA_SPATIA(fons, SEDES(i), n).
                        SI fons[i] == 70 && i + 7 < n && fons[i+1] == 76 && fons[i+2] == 85 && fons[i+3] == 73 && fons[i+4] == 84 && fons[i+5] == 65 && fons[i+6] == 78 && fons[i+7] == 83 TUNC
                            est_fluitans_campus = 1.
                        FIN-SI.
                        SI fons[i] == 79 && i + 3 < n && fons[i+1] == 82 && fons[i+2] == 68 && fons[i+3] == 79 TUNC
                            i = i + 5.
                            ig_fm2 = IGNORA_SPATIA(fons, SEDES(i), n).
                            i = i + 3.
                            ig_fm2 = IGNORA_SPATIA(fons, SEDES(i), n).
                            DUM i < n && ((fons[i] >= 65 && fons[i] <= 90) || (fons[i] >= 97 && fons[i] <= 122)) PERFICE
                                i = i + 1.
                            FIN-DUM.
                            ig_fm2 = IGNORA_SPATIA(fons, SEDES(i), n).
                            i = i + 10.
                            ig_fm2 = IGNORA_SPATIA(fons, SEDES(i), n).
                            DECLARA capacitas_campus SICUT NUMERUS VALENS 0.
                            DUM i < n && fons[i] >= 48 && fons[i] <= 57 PERFICE
                                capacitas_campus = capacitas_campus * 10 + (fons[i] - 48).
                                i = i + 1.
                            FIN-DUM.
                            magnitudo_campus = capacitas_campus * 8.
                        FIN-SI.
                    FIN-SI.
                    DECLARA status_campi_formae SICUT NUMERUS VALENS CAMPUS_FORMA_SCRIBE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_registrum_forma, numerus_campi, 0, nomen_campus).
                    SI status_campi_formae == 0 TUNC
                        status_campi_formae = CAMPUS_FORMA_SCRIBE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_registrum_forma, numerus_campi, 1, magnitudo_campus).
                    FIN-SI.
                    SI status_campi_formae == 0 TUNC
                        status_campi_formae = CAMPUS_FORMA_SCRIBE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_registrum_forma, numerus_campi, 2, offset_cumul_forma).
                    FIN-SI.
                    SI status_campi_formae == 0 TUNC
                        status_campi_formae = CAMPUS_FORMA_SCRIBE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_registrum_forma, numerus_campi, 3, est_fluitans_campus).
                    FIN-SI.
                    SI status_campi_formae != 0 TUNC
                        PROCLAMA "ERRATUM: memoria camporum formae augeri non potest".
                        REDDE 71.
                    FIN-SI.
                    offset_cumul_forma = offset_cumul_forma + magnitudo_campus.
                    numerus_campi = numerus_campi + 1.
                    DUM i < n && fons[i] != 46 PERFICE
                        i = i + 1.
                    FIN-DUM.
                    i = i + 1.
                ALITER
                    ig_fm = IGNORA_SPATIA(fons, SEDES(i), n).
                    i = i + 9.
                    continua_forma = 0.
                FIN-SI.
            FIN-DUM.
            status_formae = FORMA_SCRIBE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_registrum_forma, 1, offset_cumul_forma / 8).
            status_formae = FORMA_SCRIBE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_registrum_forma, 2, numerus_campi).
            FORMA_ULTIMA_SCRIBE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_registrum_forma).
        ALITER
        SI fons[i] == 70 && i + 7 < n && fons[i+1] == 85 && fons[i+2] == 78 && fons[i+3] == 67 && fons[i+4] == 84 && fons[i+5] == 73 && fons[i+6] == 79 && fons[i+7] == 32 TUNC
            i = i + 8.
            SI fons[i] == 80 && i + 10 < n && fons[i+1] == 82 && fons[i+2] == 73 && fons[i+3] == 78 && fons[i+4] == 67 && fons[i+5] == 73 && fons[i+6] == 80 && fons[i+7] == 65 && fons[i+8] == 76 && fons[i+9] == 73 && fons[i+10] == 83 TUNC
                inventa_principalis = 1.
                i = i + 11.
                DUM i < n && fons[i] != 46 PERFICE
                    i = i + 1.
                FIN-DUM.
                i = i + 1.
                DECLARA punctum_principalis SICUT NUMERUS VALENS pos.
                pos = COMPONE_IMPONE(codex, pos, 5).
                pos = COMPONE_TRANSCRIBE(codex, pos, 5, 4).
                DECLARA positio_reservationis1 SICUT NUMERUS VALENS pos + 2.
                pos = COMPONE_RESERVA_PILA_PROBATA(codex, pos, 0).
                DECLARA k_clear1 SICUT NUMERUS VALENS RESTITUE_LOCA_DYNAMICA(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris)).
                CURSOR_PILAE_SCRIBE(contextus_parseris, 0 - 8).
                DECLARA numerus_parametrorum_princ SICUT NUMERUS VALENS 0.
                DECLARA continua_param_princ SICUT NUMERUS VALENS 1.
                DUM continua_param_princ == 1 PERFICE
                    DECLARA ign_pp SICUT NUMERUS VALENS IGNORA_SPATIA(fons, SEDES(i), n).
                    SI fons[i] == 65 && i + 6 < n && fons[i+1] == 67 && fons[i+2] == 67 && fons[i+3] == 73 && fons[i+4] == 80 && fons[i+5] == 73 && fons[i+6] == 84 TUNC
                        i = i + 8.
                        DECLARA nomen_param_princ SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, SEDES(i), n).
                        DECLARA ign_typ_pp SICUT NUMERUS VALENS IGNORA_SPATIA(fons, SEDES(i), n).
                        i = i + 6.
                        ign_typ_pp = IGNORA_SPATIA(fons, SEDES(i), n).
                        DECLARA est_series_pp SICUT NUMERUS VALENS 0.
                        DECLARA magnitudo_pp SICUT NUMERUS VALENS 0.
                        SI fons[i] == 84 TUNC
                            magnitudo_pp = 0 - 1.
                        FIN-SI.
                        SI fons[i] == 79 TUNC
                            est_series_pp = 2.
                        FIN-SI.
                        SI fons[i] == 65 && i + 4 < n && fons[i+1] == 67 && fons[i+2] == 85 && fons[i+3] == 83 && fons[i+4] == 60 TUNC
                            SI fons[i+5] == 76 TUNC
                                magnitudo_pp = 1.
                            ALITER
                                magnitudo_pp = 8.
                            FIN-SI.
                        FIN-SI.
                        DUM i < n && fons[i] != 46 PERFICE
                            i = i + 1.
                        FIN-DUM.
                        i = i + 1.

                        DECLARA registrum_param_pp SICUT NUMERUS VALENS 7.
                        SI numerus_parametrorum_princ == 1 TUNC
                            registrum_param_pp = 6.
                        FIN-SI.

                        DECLARA idx_param_pp SICUT NUMERUS VALENS PROXIMUS_LOCUS_LIBER(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris)).
                        LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param_pp, 0, nomen_param_princ).
                        DECLARA intervallum_param_pp SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).
                        LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param_pp, 1, intervallum_param_pp).
                        LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param_pp, 2, est_series_pp).
                        SI magnitudo_pp == 0 - 1 TUNC
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param_pp, 3, 0).
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param_pp, 5, 2).
                        ALITER
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param_pp, 3, magnitudo_pp).
                        FIN-SI.
                        CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
                        pos = COMPONE_SERVA_PILA(codex, pos, intervallum_param_pp, registrum_param_pp).

                        numerus_parametrorum_princ = numerus_parametrorum_princ + 1.
                    ALITER
                        continua_param_princ = 0.
                    FIN-SI.
                FIN-DUM.

                CONTENTUM(contextus_parseris) = 0.
                CONTENTUM(contextus_parseris + 8) = 0.
                DECLARA ignoratum SICUT NUMERUS VALENS ANALYSA_BLOCUS(codex, SEDES(pos), fons, SEDES(i), n, contextus_parseris).
                DECLARA spatium_necessarium1 SICUT NUMERUS VALENS (((0 - CURSOR_PILAE_LEGE(contextus_parseris)) + 15) / 16) * 16.
                DECLARA ig_corr1 SICUT NUMERUS VALENS CORRIGE_PILA(codex, positio_reservationis1, spatium_necessarium1).

                punctum_ingressus = pos.
                pos = COMPONE_AUFER(codex, pos, 0).
                pos = COMPONE_TRANSCRIBE(codex, pos, 6, 4).
                pos = COMPONE_TRANSCRIBE(codex, pos, 7, 0).
                SI modus_pe == 1 TUNC
                    CODEX_SCRIBE(codex, pos, 72).
                    CODEX_SCRIBE(codex, pos + 1, 131).
                    CODEX_SCRIBE(codex, pos + 2, 236).
                    CODEX_SCRIBE(codex, pos + 3, 40).
                    pos = pos + 4.
                    pos = COMPONE_ONERA(codex, pos, 1, 33554432).
                    pos = COMPONE_ONERA(codex, pos, 2, 67108864).
                    pos = COMPONE_ONERA(codex, pos, 8, 12288).
                    pos = COMPONE_ONERA(codex, pos, 9, 4).
                    pos = COMPONE_VOCA_IAT_DYNAMICA(codex, pos, contextus_parseris, 1).
                    pos = COMPONE_ONERA(codex, pos, 2, 33554432).
                    pos = COMPONE_ONERA(codex, pos, 0, 33554448).
                    pos = COMPONE_SERVA_INDIRECTUM(codex, pos, 2, 0).
                ALITER
                    pos = COMPONE_ONERA(codex, pos, 2, 33554432).
                    pos = COMPONE_ONERA(codex, pos, 0, 33554448).
                    pos = COMPONE_SERVA_INDIRECTUM(codex, pos, 2, 0).
                FIN-SI.
                pos = COMPONE_VOCA_RETRO(codex, pos, punctum_principalis).
                SI modus_pe == 1 TUNC
                    pos = COMPONE_TRANSCRIBE(codex, pos, 1, 0).
                    pos = COMPONE_VOCA_IAT_DYNAMICA(codex, pos, contextus_parseris, 0).
                    pos = COMPONE_HLT(codex, pos).
                ALITER
                    pos = COMPONE_TRANSCRIBE(codex, pos, 7, 0).
                    pos = COMPONE_ONERA(codex, pos, 0, 60).
                    pos = COMPONE_VOCA_NUCLEUM(codex, pos).
                FIN-SI.

                i = n.
            ALITER
                DECLARA nomen_adiutoris SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, SEDES(i), n).
                DUM i < n && fons[i] != 46 PERFICE
                    i = i + 1.
                FIN-DUM.
                i = i + 1.

                DECLARA idx_fn SICUT NUMERUS VALENS PARES_QUANTITAS(DESCRIPTOR_FUNCTIONUM_LEGE(contextus_parseris)).
                DECLARA ig_fn_dyn SICUT NUMERUS VALENS PARES_SCRIBE(DESCRIPTOR_FUNCTIONUM_LEGE(contextus_parseris), idx_fn, 0, nomen_adiutoris).
                ig_fn_dyn = PARES_SCRIBE(DESCRIPTOR_FUNCTIONUM_LEGE(contextus_parseris), idx_fn, 1, pos).

                pos = COMPONE_IMPONE(codex, pos, 5).
                pos = COMPONE_TRANSCRIBE(codex, pos, 5, 4).
                DECLARA positio_reservationis2 SICUT NUMERUS VALENS pos + 2.
                pos = COMPONE_RESERVA_PILA_PROBATA(codex, pos, 0).
                DECLARA k_clear2 SICUT NUMERUS VALENS RESTITUE_LOCA_DYNAMICA(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris)).
                CURSOR_PILAE_SCRIBE(contextus_parseris, 0 - 8).

                DECLARA numerus_parametrorum SICUT NUMERUS VALENS 0.
                DECLARA continua_param SICUT NUMERUS VALENS 1.
                DUM continua_param == 1 PERFICE
                    DECLARA ignoratum3 SICUT NUMERUS VALENS IGNORA_SPATIA(fons, SEDES(i), n).
                    SI fons[i] == 65 && i + 6 < n && fons[i+1] == 67 && fons[i+2] == 67 && fons[i+3] == 73 && fons[i+4] == 80 && fons[i+5] == 73 && fons[i+6] == 84 TUNC
                        i = i + 8.
                        DECLARA nomen_param SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, SEDES(i), n).
                        DECLARA ign_typ_param SICUT NUMERUS VALENS IGNORA_SPATIA(fons, SEDES(i), n).
                        i = i + 6.
                        ign_typ_param = IGNORA_SPATIA(fons, SEDES(i), n).
                        DECLARA est_series_param SICUT NUMERUS VALENS 0.
                        DECLARA magnitudo_param SICUT NUMERUS VALENS 0.
                        DECLARA es_flot_param SICUT NUMERUS VALENS 0.
                        SI fons[i] == 84 TUNC
                            es_flot_param = 2.
                        FIN-SI.
                        SI fons[i] == 79 TUNC
                            est_series_param = 2.
                        FIN-SI.
                        SI fons[i] == 70 && i + 7 < n && fons[i+1] == 76 && fons[i+2] == 85 && fons[i+3] == 73 && fons[i+4] == 84 && fons[i+5] == 65 && fons[i+6] == 78 && fons[i+7] == 83 TUNC
                            es_flot_param = 1.
                        FIN-SI.
                        DECLARA idx_struct_param SICUT NUMERUS VALENS 0 - 1.
                        SI fons[i] == 65 && i + 4 < n && fons[i+1] == 67 && fons[i+2] == 85 && fons[i+3] == 83 && fons[i+4] == 60 TUNC
                            SI fons[i+5] == 76 TUNC
                                magnitudo_param = 1.
                            ALITER
                                magnitudo_param = 8.
                            FIN-SI.
                            idx_struct_param = INDEX_STRUCTURAE_INTERIOR_ACUS(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), fons, i + 5, n).
                        FIN-SI.
                        DUM i < n && fons[i] != 46 PERFICE
                            i = i + 1.
                        FIN-DUM.
                        i = i + 1.

                        DECLARA registrum_param SICUT NUMERUS VALENS 7.
                        SI numerus_parametrorum == 1 TUNC
                            registrum_param = 6.
                        FIN-SI.
                        SI numerus_parametrorum == 2 TUNC
                            registrum_param = 2.
                        FIN-SI.
                        SI numerus_parametrorum == 3 TUNC
                            registrum_param = 1.
                        FIN-SI.
                        SI numerus_parametrorum == 4 TUNC
                            registrum_param = 8.
                        FIN-SI.
                        SI numerus_parametrorum == 5 TUNC
                            registrum_param = 9.
                        FIN-SI.

                        DECLARA idx_param SICUT NUMERUS VALENS PROXIMUS_LOCUS_LIBER(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris)).
                        LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param, 0, nomen_param).
                        DECLARA intervallum_param SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).
                        LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param, 1, intervallum_param).
                        LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param, 2, est_series_param).
                        LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param, 3, magnitudo_param).
                        SI idx_struct_param >= 0 TUNC
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param, 4, idx_struct_param + 1).
                        FIN-SI.
                        SI es_flot_param > 0 TUNC
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_param, 5, es_flot_param).
                        FIN-SI.
                        CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
                        SI numerus_parametrorum == 6 TUNC
                            pos = COMPONE_SUME_PILA(codex, pos, 10, 16).
                            pos = COMPONE_SERVA_PILA(codex, pos, intervallum_param, 10).
                        ALITER
                            pos = COMPONE_SERVA_PILA(codex, pos, intervallum_param, registrum_param).
                        FIN-SI.

                        numerus_parametrorum = numerus_parametrorum + 1.
                    ALITER
                        continua_param = 0.
                    FIN-SI.
                FIN-DUM.

                CONTENTUM(contextus_parseris) = 0.
                CONTENTUM(contextus_parseris + 8) = 0.
                DECLARA ignoratum4 SICUT NUMERUS VALENS ANALYSA_BLOCUS(codex, SEDES(pos), fons, SEDES(i), n, contextus_parseris).
                DECLARA spatium_necessarium2 SICUT NUMERUS VALENS (((0 - CURSOR_PILAE_LEGE(contextus_parseris)) + 15) / 16) * 16.
                DECLARA ig_corr2 SICUT NUMERUS VALENS CORRIGE_PILA(codex, positio_reservationis2, spatium_necessarium2).

                DUM i < n && fons[i] != 46 PERFICE
                    i = i + 1.
                FIN-DUM.
                i = i + 1.
            FIN-SI.
        ALITER
            i = i + 1.
        FIN-SI.
        FIN-SI.
        FIN-SI.
    FIN-DUM.

    SI inventa_principalis == 0 TUNC
        PROCLAMA "ERRATUM: FUNCTIO PRINCIPALIS deest".
        REDDE 65.
    FIN-SI.

    DECLARA k_pendens SICUT NUMERUS VALENS 0.
    DUM k_pendens < PARES_QUANTITAS(DESCRIPTOR_PENDENTIUM_LEGE(contextus_parseris)) PERFICE
        DECLARA loci_p SICUT NUMERUS VALENS PARES_LEGE(DESCRIPTOR_PENDENTIUM_LEGE(contextus_parseris), k_pendens, 0).
        DECLARA nomen_p SICUT NUMERUS VALENS PARES_LEGE(DESCRIPTOR_PENDENTIUM_LEGE(contextus_parseris), k_pendens, 1).
        DECLARA loci_cible SICUT NUMERUS VALENS CERCA_FUNCTIONEM_DYNAMICAM(contextus_parseris, nomen_p).
        SI loci_cible == 0 TUNC
            PROCLAMA "ERRATUM: functio vocata non inventa est".
            REDDE 65.
        FIN-SI.
        DECLARA ig_patch SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_p, loci_cible).
        k_pendens = k_pendens + 1.
    FIN-DUM.

    SI modus_pe == 1 TUNC
        pos = CONSTRUE_CAPUT_PE(codex, pos - capita_reservata, punctum_ingressus, contextus_parseris).
    ALITER
        DECLARA ignoratum2 SICUT NUMERUS VALENS CONSTRUE_CAPUT_ELF(codex, pos - capita_reservata, punctum_ingressus).
    FIN-SI.

    DECLARA fd_scriptio SICUT NUMERUS VALENS APERI_SCRIBERE(argv[2]).
    SI fd_scriptio < 0 TUNC
        PROCLAMA "ERRATUM: exsecutabile scribi non potest".
        REDDE 73.
    FIN-SI.
    DECLARA buffer_scriptio SICUT ORDO DE NUMERUS CAPACITAS 4096.
    DECLARA index_scriptio SICUT NUMERUS VALENS 0.
    DECLARA scriptum SICUT NUMERUS VALENS 0.
    DUM index_scriptio < pos PERFICE
        DECLARA longitudo_partis SICUT NUMERUS VALENS pos - index_scriptio.
        SI longitudo_partis > 4096 TUNC
            longitudo_partis = 4096.
        FIN-SI.
        DECLARA j_scriptio SICUT NUMERUS VALENS 0.
        DUM j_scriptio < longitudo_partis PERFICE
            buffer_scriptio[j_scriptio] = CODEX_LEGE(codex, index_scriptio + j_scriptio).
            j_scriptio = j_scriptio + 1.
        FIN-DUM.
        DECLARA scriptum_partis SICUT NUMERUS VALENS MITTE(fd_scriptio, buffer_scriptio, longitudo_partis).
        SI scriptum_partis != longitudo_partis TUNC
            CLAUDE(fd_scriptio).
            PROCLAMA "ERRATUM: exsecutabile imperfecte scriptum est".
            REDDE 74.
        FIN-SI.
        scriptum = scriptum + scriptum_partis.
        index_scriptio = index_scriptio + longitudo_partis.
    FIN-DUM.
    CLAUDE(fd_scriptio).
    SI scriptum != pos TUNC
        PROCLAMA "ERRATUM: exsecutabile imperfecte scriptum est".
        REDDE 74.
    FIN-SI.

    REDDE 0.
FIN-FUNCTIO.
