FUNCTIO CERCA_VARIABILEM REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT nomen SICUT NUMERUS.
    DECLARA idx SICUT NUMERUS VALENS 0.
    DECLARA intervallum_inventus SICUT NUMERUS VALENS 0.
    DECLARA aliquid_inventum SICUT NUMERUS VALENS 0.
    DUM idx < CONTENTUM(descriptor + 16) PERFICE
        SI LOCALE_LEGE(descriptor, idx, 0) == nomen TUNC
            intervallum_inventus = LOCALE_LEGE(descriptor, idx, 1).
            aliquid_inventum = 1.
        FIN-SI.
        idx = idx + 1.
    FIN-DUM.
    SI aliquid_inventum == 1 TUNC
        REDDE intervallum_inventus.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ESTNE_SERIES REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT nomen SICUT NUMERUS.
    DECLARA idx SICUT NUMERUS VALENS 0.
    DECLARA signum_inventum SICUT NUMERUS VALENS 0.
    DECLARA aliquid_inventum SICUT NUMERUS VALENS 0.
    DUM idx < CONTENTUM(descriptor + 16) PERFICE
        SI LOCALE_LEGE(descriptor, idx, 0) == nomen TUNC
            signum_inventum = LOCALE_LEGE(descriptor, idx, 2).
            aliquid_inventum = 1.
        FIN-SI.
        idx = idx + 1.
    FIN-DUM.
    SI aliquid_inventum == 1 TUNC
        REDDE signum_inventum.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO COMPONE_CURRE REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.
    DECLARA p SICUT NUMERUS VALENS pos.

    CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
    DECLARA intervallum_argv SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).
    CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
    DECLARA intervallum_envp SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).
    CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
    DECLARA intervallum_fdredir SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).

    DECLARA ig1 SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, SEDES(p), fons, pos_fontis, n, contextus_parseris).
    p = COMPONE_SERVA_PILA(codex, p, intervallum_argv, 0).

    ig1 = IGNORA_SPATIA(fons, pos_fontis, n).
    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
    ig1 = IGNORA_SPATIA(fons, pos_fontis, n).

    ig1 = ANALYSA_EXPRESSIO(codex, SEDES(p), fons, pos_fontis, n, contextus_parseris).
    p = COMPONE_SERVA_PILA(codex, p, intervallum_envp, 0).

    ig1 = IGNORA_SPATIA(fons, pos_fontis, n).
    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
    ig1 = IGNORA_SPATIA(fons, pos_fontis, n).

    ig1 = ANALYSA_EXPRESSIO(codex, SEDES(p), fons, pos_fontis, n, contextus_parseris).
    p = COMPONE_SERVA_PILA(codex, p, intervallum_fdredir, 0).

    ig1 = IGNORA_SPATIA(fons, pos_fontis, n).
    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

    p = COMPONE_ONERA(codex, p, 0, 57).
    p = COMPONE_VOCA_NUCLEUM(codex, p).

    p = COMPONE_TRANSCRIBE(codex, p, 1, 0).
    p = COMPONE_ONERA(codex, p, 3, 0).
    p = COMPONE_CMP(codex, p, 0, 3).
    DECLARA loci_parent_curre SICUT NUMERUS VALENS 0.
    p = COMPONE_JNE_FUTURUM(codex, p, SEDES(loci_parent_curre)).

    p = COMPONE_SUME_PILA(codex, p, 0, intervallum_fdredir).
    p = COMPONE_ONERA(codex, p, 3, 0).
    p = COMPONE_CMP(codex, p, 0, 3).
    DECLARA loci_sin_redir SICUT NUMERUS VALENS 0.
    p = COMPONE_JL_FUTURUM(codex, p, SEDES(loci_sin_redir)).
    p = COMPONE_SUME_PILA(codex, p, 7, intervallum_fdredir).
    p = COMPONE_ONERA(codex, p, 6, 1).
    p = COMPONE_ONERA(codex, p, 0, 33).
    p = COMPONE_VOCA_NUCLEUM(codex, p).
    DECLARA pos_post_redir SICUT NUMERUS VALENS p.
    ig1 = CORRIGE_SALTUM(codex, loci_sin_redir, pos_post_redir).

    p = COMPONE_SUME_PILA(codex, p, 6, intervallum_argv).
    p = COMPONE_SUME_INDIRECTUM(codex, p, 7, 6).
    p = COMPONE_SUME_PILA(codex, p, 2, intervallum_envp).
    p = COMPONE_ONERA(codex, p, 0, 59).
    p = COMPONE_VOCA_NUCLEUM(codex, p).
    p = COMPONE_ONERA(codex, p, 7, 127).
    p = COMPONE_ONERA(codex, p, 0, 60).
    p = COMPONE_VOCA_NUCLEUM(codex, p).

    DECLARA pos_post_curre SICUT NUMERUS VALENS p.
    ig1 = CORRIGE_SALTUM(codex, loci_parent_curre, pos_post_curre).

    p = COMPONE_TRANSCRIBE(codex, p, 7, 1).
    p = COMPONE_ONERA(codex, p, 0, 0).
    p = COMPONE_IMPONE(codex, p, 0).
    p = COMPONE_TRANSCRIBE(codex, p, 6, 4).
    p = COMPONE_ONERA(codex, p, 2, 0).
    p = COMPONE_ONERA(codex, p, 10, 0).
    p = COMPONE_ONERA(codex, p, 0, 61).
    p = COMPONE_VOCA_NUCLEUM(codex, p).

    p = COMPONE_AUFER(codex, p, 0).
    p = COMPONE_ONERA(codex, p, 1, 8).
    p = COMPONE_SHR(codex, p, 0).
    p = COMPONE_ONERA(codex, p, 2, 255).
    p = COMPONE_AND(codex, p, 0, 2).

    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_TUBUS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.
    DECLARA p SICUT NUMERUS VALENS pos.

    CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
    DECLARA intervallum_fds SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).
    CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
    DECLARA intervallum_pack SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).

    DECLARA ig1 SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, SEDES(p), fons, pos_fontis, n, contextus_parseris).
    p = COMPONE_SERVA_PILA(codex, p, intervallum_fds, 0).
    ig1 = IGNORA_SPATIA(fons, pos_fontis, n).
    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

    p = COMPONE_LEA_PILA(codex, p, 7, intervallum_pack).
    p = COMPONE_ONERA(codex, p, 0, 22).
    p = COMPONE_VOCA_NUCLEUM(codex, p).
    p = COMPONE_IMPONE(codex, p, 0).

    p = COMPONE_SUME_PILA(codex, p, 0, intervallum_pack).
    p = COMPONE_ONERA(codex, p, 3, 4294967295).
    p = COMPONE_AND(codex, p, 0, 3).
    p = COMPONE_SUME_PILA(codex, p, 6, intervallum_fds).
    p = COMPONE_SERVA_INDIRECTUM(codex, p, 6, 0).

    p = COMPONE_SUME_PILA(codex, p, 0, intervallum_pack).
    p = COMPONE_ONERA(codex, p, 1, 32).
    p = COMPONE_SHR(codex, p, 0).
    p = COMPONE_SUME_PILA(codex, p, 6, intervallum_fds).
    p = COMPONE_ONERA(codex, p, 3, 8).
    p = COMPONE_ADD(codex, p, 6, 3).
    p = COMPONE_SERVA_INDIRECTUM(codex, p, 6, 0).

    p = COMPONE_AUFER(codex, p, 0).

    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_CAMBIA_DIRECTORIUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.
    DECLARA p SICUT NUMERUS VALENS pos.

    DECLARA ig_cd SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).

    SI fons[CONTENTUM(pos_fontis)] == 34 TUNC
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        DECLARA loci_saltus_cd SICUT NUMERUS VALENS 0.
        p = COMPONE_JMP_FUTURUM(codex, p, SEDES(loci_saltus_cd)).
        DECLARA sedes_cd SICUT NUMERUS VALENS p.
        DUM fons[CONTENTUM(pos_fontis)] != 34 PERFICE
            CODEX_SCRIBE(codex, p, fons[CONTENTUM(pos_fontis)]).
            p = p + 1.
            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        FIN-DUM.
        CODEX_SCRIBE(codex, p, 0).
        p = p + 1.
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        DECLARA pos_post_cd SICUT NUMERUS VALENS p.
        ig_cd = CORRIGE_SALTUM(codex, loci_saltus_cd, pos_post_cd).
        p = COMPONE_ONERA(codex, p, 7, 4194304 + sedes_cd).
    ALITER
        ig_cd = ANALYSA_EXPRESSIO(codex, SEDES(p), fons, pos_fontis, n, contextus_parseris).
        p = COMPONE_TRANSCRIBE(codex, p, 7, 0).
    FIN-SI.

    ig_cd = IGNORA_SPATIA(fons, pos_fontis, n).
    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

    p = COMPONE_ONERA(codex, p, 0, 80).
    p = COMPONE_VOCA_NUCLEUM(codex, p).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_RESERVA_OCTETA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    DECLARA p_mem SICUT NUMERUS VALENS pos.
    p_mem = COMPONE_TRANSCRIBE(codex, p_mem, 6, 0).
    p_mem = COMPONE_ONERA(codex, p_mem, 7, 0).
    p_mem = COMPONE_ONERA(codex, p_mem, 2, 3).
    p_mem = COMPONE_ONERA(codex, p_mem, 10, 34).
    p_mem = COMPONE_ONERA(codex, p_mem, 8, 0).
    p_mem = COMPONE_ONERA(codex, p_mem, 9, 0).
    p_mem = COMPONE_ONERA(codex, p_mem, 0, 9).
    p_mem = COMPONE_VOCA_NUCLEUM(codex, p_mem).
    REDDE p_mem.
FIN-FUNCTIO.

FUNCTIO ANALYSA_FACTOR REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos_codicis SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.

    DECLARA ignoratum SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).

    SI fons[CONTENTUM(pos_fontis)] == 34 TUNC
        REDDE COMPONE_LITTERALE_TEXTUS(codex, pos_codicis, fons, pos_fontis, n).
    FIN-SI.

    SI fons[CONTENTUM(pos_fontis)] == 82 && CONTENTUM(pos_fontis) + 14 < n && fons[CONTENTUM(pos_fontis)+1] == 69 && fons[CONTENTUM(pos_fontis)+2] == 83 && fons[CONTENTUM(pos_fontis)+3] == 69 && fons[CONTENTUM(pos_fontis)+4] == 82 && fons[CONTENTUM(pos_fontis)+5] == 86 && fons[CONTENTUM(pos_fontis)+6] == 65 && fons[CONTENTUM(pos_fontis)+7] == 95 && fons[CONTENTUM(pos_fontis)+8] == 79 && fons[CONTENTUM(pos_fontis)+9] == 67 && fons[CONTENTUM(pos_fontis)+10] == 84 && fons[CONTENTUM(pos_fontis)+11] == 69 && fons[CONTENTUM(pos_fontis)+12] == 84 && fons[CONTENTUM(pos_fontis)+13] == 65 && fons[CONTENTUM(pos_fontis)+14] == 40 TUNC
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 15.
        ignoratum = ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        CONTENTUM(pos_codicis) = COMPONE_RESERVA_OCTETA(codex, CONTENTUM(pos_codicis)).
        REDDE 0.
    FIN-SI.

    SI fons[CONTENTUM(pos_fontis)] == 40 TUNC
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        DECLARA r SICUT NUMERUS VALENS ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        REDDE 0.
    FIN-SI.

    SI (fons[CONTENTUM(pos_fontis)] >= 97 && fons[CONTENTUM(pos_fontis)] <= 122) TUNC
        DECLARA pos_ante_nomen SICUT NUMERUS VALENS CONTENTUM(pos_fontis).
        DECLARA nomen SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, pos_fontis, n).
        DECLARA ign_de SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).

        SI CONTENTUM(pos_fontis) + 2 < n && fons[CONTENTUM(pos_fontis)] == 68 && fons[CONTENTUM(pos_fontis)+1] == 69 && fons[CONTENTUM(pos_fontis)+2] == 32 TUNC
            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 3.
            ign_de = IGNORA_SPATIA(fons, pos_fontis, n).

            DECLARA idx_campus SICUT NUMERUS VALENS INDEX_CAMPUS_ULTIMAE_FORMAE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), nomen).

            SI fons[CONTENTUM(pos_fontis)] == 67 && CONTENTUM(pos_fontis) + 9 < n && fons[CONTENTUM(pos_fontis)+1] == 79 && fons[CONTENTUM(pos_fontis)+2] == 78 && fons[CONTENTUM(pos_fontis)+3] == 84 && fons[CONTENTUM(pos_fontis)+4] == 69 && fons[CONTENTUM(pos_fontis)+5] == 78 && fons[CONTENTUM(pos_fontis)+6] == 84 && fons[CONTENTUM(pos_fontis)+7] == 85 && fons[CONTENTUM(pos_fontis)+8] == 77 && fons[CONTENTUM(pos_fontis)+9] == 40 TUNC
                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 10.
                DECLARA offset_ptr_campus SICUT NUMERUS VALENS OFFSET_PTR_CAMPUS_STRUCTA(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), fons, CONTENTUM(pos_fontis), n, idx_campus, nomen, contextus_parseris).
                DECLARA ig_campus_ptr SICUT NUMERUS VALENS ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                ign_de = IGNORA_SPATIA(fons, pos_fontis, n).
                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 3, offset_ptr_campus).
                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 0, 3).
                CONTENTUM(pos_codicis) = COMPONE_SUME_INDIRECTUM(codex, CONTENTUM(pos_codicis), 0, 0).
                REDDE 0.
            FIN-SI.

            DECLARA nomen_var_campus SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, pos_fontis, n).
            DECLARA intervallum_var_campus SICUT NUMERUS VALENS CERCA_VARIABILEM(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_var_campus).
            DECLARA idx_struct_campus SICUT NUMERUS VALENS STRUCTURA_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_var_campus).
            DECLARA magnitudo_campus_r SICUT NUMERUS VALENS 8.
            DECLARA offset_campus_r SICUT NUMERUS VALENS 0.
            SI idx_struct_campus > 0 TUNC
                magnitudo_campus_r = CAMPUS_STRUCTURAE_MAGNITUDO(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_struct_campus - 1, nomen).
                offset_campus_r = CAMPUS_STRUCTURAE_OFFSET(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_struct_campus - 1, nomen).
            ALITER
                offset_campus_r = OFFSET_CUMULATIVUS_CAMPI(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), idx_campus).
            FIN-SI.

            SI CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] == 91 TUNC
                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                DECLARA r_idx_campus SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                DECLARA ign_idxc SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

                DECLARA magnitudo_arr_campus SICUT NUMERUS VALENS MAGNITUDO_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_var_campus).
                SI magnitudo_arr_campus == 0 TUNC
                    magnitudo_arr_campus = 8.
                FIN-SI.

                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, magnitudo_arr_campus).
                CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 0, 2).
