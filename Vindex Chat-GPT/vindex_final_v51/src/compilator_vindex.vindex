// Bibliotheca componendi codicem machinalis x86-64, tota in VINDEX scripta.
// Continet omnes functiones ex prioribus experimentis collectas.
//
// Ordinatio tabulae (structura partitionis unicae "tabula"):
//   0-99    : nomina variabilium localium (100 loca)
//   100-199 : intervalla variabilium localium (100 loca)
//   200-225 : nomina camporum structurae (26 loca)
//   226     : numerus acervi (pro RESERVA)
//   227     : locus pendens DESINE (pro ansis)
//   228-327 : signa "est_series" variabilium (100 loca, 1=tabula localis, 2=parametrum tabulae)
//   328-407 : nomina functionum auxiliarium (80 loca)
//   408-487 : positiones functionum auxiliarium (80 loca)
//   488     : numerus vocationum pendentium (relationes anteriores)
//   490-821 : par (locus, nomen) pro singulis vocationibus pendentibus (166 paria)
// Capacitas tabulae tota: 850.

FUNCTIO INITIA_CODEX REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT limen SICUT NUMERUS.
    DECLARA basis SICUT NUMERUS VALENS RESERVA_OCTETA(limen).
    SI basis < 0 TUNC
        REDDE 71.
    FIN-SI.
    CONTENTUM(codex) = basis.
    CONTENTUM(codex + 8) = limen.
    CONTENTUM(codex + 16) = 0.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ASSECURA_CODEX REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT necessaria SICUT NUMERUS.
    DECLARA limen SICUT NUMERUS VALENS CONTENTUM(codex + 8).
    SI necessaria <= limen TUNC
        REDDE 0.
    FIN-SI.
    DECLARA novum_limen SICUT NUMERUS VALENS limen * 2.
    DUM novum_limen < necessaria PERFICE
        novum_limen = novum_limen * 2.
    FIN-DUM.
    DECLARA nova_basis SICUT NUMERUS VALENS RESERVA_OCTETA(novum_limen).
    SI nova_basis < 0 TUNC
        REDDE 71.
    FIN-SI.
    DECLARA basis SICUT NUMERUS VALENS CONTENTUM(codex).
    DECLARA longitudo SICUT NUMERUS VALENS CONTENTUM(codex + 16).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < longitudo PERFICE
        SCRIBE_OCTETUM_AB(nova_basis + i, OCTETUS_AB(basis + i)).
        i = i + 1.
    FIN-DUM.
    CONTENTUM(codex) = nova_basis.
    CONTENTUM(codex + 8) = novum_limen.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO CODEX_SCRIBE REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT index SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    DECLARA necessaria SICUT NUMERUS VALENS index + 1.
    DECLARA status SICUT NUMERUS VALENS ASSECURA_CODEX(codex, necessaria).
    SI status != 0 TUNC
        REDDE status.
    FIN-SI.
    SCRIBE_OCTETUM_AB(CONTENTUM(codex) + index, valor).
    SI necessaria > CONTENTUM(codex + 16) TUNC
        CONTENTUM(codex + 16) = necessaria.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO CODEX_LEGE REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT index SICUT NUMERUS.
    REDDE OCTETUS_AB(CONTENTUM(codex) + index).
FIN-FUNCTIO.

FUNCTIO SCRIBE_U16 REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, valor & 255).
    CODEX_SCRIBE(codex, indice + 1, (valor >> 8) & 255).
    REDDE indice + 2.
FIN-FUNCTIO.

FUNCTIO SCRIBE_U32 REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, valor & 255).
    CODEX_SCRIBE(codex, indice + 1, (valor >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 2, (valor >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 3, (valor >> 24) & 255).
    REDDE indice + 4.
FIN-FUNCTIO.

FUNCTIO SCRIBE_U64 REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, valor & 255).
    CODEX_SCRIBE(codex, indice + 1, (valor >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 2, (valor >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 3, (valor >> 24) & 255).
    CODEX_SCRIBE(codex, indice + 4, (valor >> 32) & 255).
    CODEX_SCRIBE(codex, indice + 5, (valor >> 40) & 255).
    CODEX_SCRIBE(codex, indice + 6, (valor >> 48) & 255).
    CODEX_SCRIBE(codex, indice + 7, (valor >> 56) & 255).
    REDDE indice + 8.
FIN-FUNCTIO.

FUNCTIO CONSTRUE_CAPUT_ELF REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT mensura_codicis SICUT NUMERUS.
    ACCIPIT punctum_ingressus SICUT NUMERUS.
    DECLARA basis SICUT NUMERUS VALENS 4194304.
    DECLARA ignoratum SICUT NUMERUS VALENS 0.

    CODEX_SCRIBE(codex, 0, 127).
    CODEX_SCRIBE(codex, 1, 69).
    CODEX_SCRIBE(codex, 2, 76).
    CODEX_SCRIBE(codex, 3, 70).
    CODEX_SCRIBE(codex, 4, 2).
    CODEX_SCRIBE(codex, 5, 1).
    CODEX_SCRIBE(codex, 6, 1).
    CODEX_SCRIBE(codex, 7, 0).

    ignoratum = SCRIBE_U16(codex, 16, 2).
    ignoratum = SCRIBE_U16(codex, 18, 62).
    ignoratum = SCRIBE_U32(codex, 20, 1).
    ignoratum = SCRIBE_U64(codex, 24, basis + punctum_ingressus).
    ignoratum = SCRIBE_U64(codex, 32, 64).
    ignoratum = SCRIBE_U64(codex, 40, 0).
    ignoratum = SCRIBE_U32(codex, 48, 0).
    ignoratum = SCRIBE_U16(codex, 52, 64).
    ignoratum = SCRIBE_U16(codex, 54, 56).
    ignoratum = SCRIBE_U16(codex, 56, 1).
    ignoratum = SCRIBE_U16(codex, 58, 0).
    ignoratum = SCRIBE_U16(codex, 60, 0).
    ignoratum = SCRIBE_U16(codex, 62, 0).

    ignoratum = SCRIBE_U32(codex, 64, 1).
    ignoratum = SCRIBE_U32(codex, 68, 7).
    ignoratum = SCRIBE_U64(codex, 72, 0).
    ignoratum = SCRIBE_U64(codex, 80, basis).
    ignoratum = SCRIBE_U64(codex, 88, basis).
    DECLARA mensura_totalis SICUT NUMERUS VALENS 120 + mensura_codicis.
    ignoratum = SCRIBE_U64(codex, 96, mensura_totalis).
    ignoratum = SCRIBE_U64(codex, 104, 46137344).
    ignoratum = SCRIBE_U64(codex, 112, 4096).

    REDDE 120.
FIN-FUNCTIO.

FUNCTIO COMPONE_ONERA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI registrum >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    CODEX_SCRIBE(codex, indice, rex).
    CODEX_SCRIBE(codex, indice + 1, 184 + (registrum & 7)).
    CODEX_SCRIBE(codex, indice + 2, valor & 255).
    CODEX_SCRIBE(codex, indice + 3, (valor >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 4, (valor >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 5, (valor >> 24) & 255).
    CODEX_SCRIBE(codex, indice + 6, (valor >> 32) & 255).
    CODEX_SCRIBE(codex, indice + 7, (valor >> 40) & 255).
    CODEX_SCRIBE(codex, indice + 8, (valor >> 48) & 255).
    CODEX_SCRIBE(codex, indice + 9, (valor >> 56) & 255).
    REDDE indice + 10.
FIN-FUNCTIO.

FUNCTIO CORRIGE_PILA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT positio SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    CODEX_SCRIBE(codex, positio, valor & 255).
    CODEX_SCRIBE(codex, positio + 1, (valor >> 8) & 255).
    CODEX_SCRIBE(codex, positio + 2, (valor >> 16) & 255).
    CODEX_SCRIBE(codex, positio + 3, (valor >> 24) & 255).
    CODEX_SCRIBE(codex, positio + 4, (valor >> 32) & 255).
    CODEX_SCRIBE(codex, positio + 5, (valor >> 40) & 255).
    CODEX_SCRIBE(codex, positio + 6, (valor >> 48) & 255).
    CODEX_SCRIBE(codex, positio + 7, (valor >> 56) & 255).
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO COMPONE_ARITHMETICA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT opcode SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI fons >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI destinatio >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    CODEX_SCRIBE(codex, indice, rex).
    CODEX_SCRIBE(codex, indice + 1, opcode).
    CODEX_SCRIBE(codex, indice + 2, 192 + ((fons & 7) * 8) + (destinatio & 7)).
    REDDE indice + 3.
FIN-FUNCTIO.

FUNCTIO COMPONE_ADD REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 1, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_SUB REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 41, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_CMP REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 57, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_MULTIPLICA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI destinatio >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI fons >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    CODEX_SCRIBE(codex, indice, rex).
    CODEX_SCRIBE(codex, indice + 1, 15).
    CODEX_SCRIBE(codex, indice + 2, 175).
    CODEX_SCRIBE(codex, indice + 3, 192 + ((destinatio & 7) * 8) + (fons & 7)).
    REDDE indice + 4.
FIN-FUNCTIO.

FUNCTIO COMPONE_TRANSCRIBE REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI fons >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI destinatio >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    CODEX_SCRIBE(codex, indice, rex).
    CODEX_SCRIBE(codex, indice + 1, 137).
    CODEX_SCRIBE(codex, indice + 2, 192 + ((fons & 7) * 8) + (destinatio & 7)).
    REDDE indice + 3.
FIN-FUNCTIO.

FUNCTIO COMPONE_SERVA_PILA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT intervallum SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI registrum >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    CODEX_SCRIBE(codex, indice, rex).
    CODEX_SCRIBE(codex, indice + 1, 137).
    CODEX_SCRIBE(codex, indice + 2, 128 + ((registrum & 7) * 8) + 5).
    CODEX_SCRIBE(codex, indice + 3, intervallum & 255).
    CODEX_SCRIBE(codex, indice + 4, (intervallum >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 5, (intervallum >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 6, (intervallum >> 24) & 255).
    REDDE indice + 7.
FIN-FUNCTIO.

FUNCTIO CALCULA_NUMERUM_FLUITANIS REDDENS NUMERUS.
    ACCIPIT int_part SICUT NUMERUS.
    ACCIPIT frac_part SICUT NUMERUS.
    ACCIPIT frac_digits SICUT NUMERUS.

    SI int_part == 0 && frac_part == 0 TUNC
        REDDE 0.
    FIN-SI.

    DECLARA denom SICUT NUMERUS VALENS 1.
    DECLARA k SICUT NUMERUS VALENS 0.
    DUM k < frac_digits PERFICE
        denom = denom * 10.
        k = k + 1.
    FIN-DUM.

    DECLARA numer SICUT NUMERUS VALENS int_part * denom + frac_part.

    DECLARA nbits SICUT NUMERUS VALENS 0.
    DECLARA temp SICUT NUMERUS VALENS numer.
    DUM temp > 0 PERFICE
        temp = temp / 2.
        nbits = nbits + 1.
    FIN-DUM.

    DECLARA decal1 SICUT NUMERUS VALENS 62 - nbits.
    DECLARA numer_scaled SICUT NUMERUS VALENS numer.
    DECLARA s SICUT NUMERUS VALENS 0.
    DUM s < decal1 PERFICE
        numer_scaled = numer_scaled * 2.
        s = s + 1.
    FIN-DUM.

    DECLARA quot SICUT NUMERUS VALENS numer_scaled / denom.
    DECLARA resto SICUT NUMERUS VALENS numer_scaled - (quot * denom).
    SI resto * 2 >= denom TUNC
        quot = quot + 1.
    FIN-SI.

    DECLARA nbits_q SICUT NUMERUS VALENS 0.
    DECLARA temp2 SICUT NUMERUS VALENS quot.
    DUM temp2 > 0 PERFICE
        temp2 = temp2 / 2.
        nbits_q = nbits_q + 1.
    FIN-DUM.

    DECLARA mant SICUT NUMERUS VALENS quot.
    DECLARA extra_shift SICUT NUMERUS VALENS 53 - nbits_q.
    SI extra_shift > 0 TUNC
        DECLARA es SICUT NUMERUS VALENS 0.
        DUM es < extra_shift PERFICE
            mant = mant * 2.
            es = es + 1.
        FIN-DUM.
    ALITER
        DECLARA es2 SICUT NUMERUS VALENS 0 - extra_shift.
        DECLARA divisor2 SICUT NUMERUS VALENS 1.
        DECLARA es3 SICUT NUMERUS VALENS 0.
        DUM es3 < es2 PERFICE
            divisor2 = divisor2 * 2.
            es3 = es3 + 1.
        FIN-DUM.
        DECLARA mant_q SICUT NUMERUS VALENS mant / divisor2.
        DECLARA mant_r SICUT NUMERUS VALENS mant - (mant_q * divisor2).
        SI mant_r * 2 >= divisor2 TUNC
            mant_q = mant_q + 1.
        FIN-SI.
        mant = mant_q.
    FIN-SI.

    DECLARA expo SICUT NUMERUS VALENS 0 - (decal1 + extra_shift).
    DECLARA exp_field SICUT NUMERUS VALENS expo + 52 + 1023.
    DECLARA mantissa SICUT NUMERUS VALENS mant & 4503599627370495.
    DECLARA resultado SICUT NUMERUS VALENS (exp_field * 4503599627370496) + mantissa.
    REDDE resultado.
FIN-FUNCTIO.

FUNCTIO COMPONE_MOVQ_A_GP REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT gp_dest SICUT NUMERUS.
    ACCIPIT xmm_src SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, 102).
    CODEX_SCRIBE(codex, indice + 1, 72).
    CODEX_SCRIBE(codex, indice + 2, 15).
    CODEX_SCRIBE(codex, indice + 3, 126).
    CODEX_SCRIBE(codex, indice + 4, 192 + (xmm_src * 8) + gp_dest).
    REDDE indice + 5.
FIN-FUNCTIO.

FUNCTIO COMPONE_MOVQ_A_XMM REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT xmm_dest SICUT NUMERUS.
    ACCIPIT gp_src SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, 102).
    CODEX_SCRIBE(codex, indice + 1, 72).
    CODEX_SCRIBE(codex, indice + 2, 15).
    CODEX_SCRIBE(codex, indice + 3, 110).
    CODEX_SCRIBE(codex, indice + 4, 192 + (xmm_dest * 8) + gp_src).
    REDDE indice + 5.
FIN-FUNCTIO.

FUNCTIO COMPONE_MOVSD_SALVA_IND REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT gp_base SICUT NUMERUS.
    ACCIPIT xmm_src SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, 242).
    CODEX_SCRIBE(codex, indice + 1, 15).
    CODEX_SCRIBE(codex, indice + 2, 17).
    CODEX_SCRIBE(codex, indice + 3, (xmm_src * 8) + gp_base).
    REDDE indice + 4.
FIN-FUNCTIO.

FUNCTIO COMPONE_MOVSD_CARGA_IND REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT xmm_dest SICUT NUMERUS.
    ACCIPIT gp_base SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, 242).
    CODEX_SCRIBE(codex, indice + 1, 15).
    CODEX_SCRIBE(codex, indice + 2, 16).
    CODEX_SCRIBE(codex, indice + 3, (xmm_dest * 8) + gp_base).
    REDDE indice + 4.
FIN-FUNCTIO.

FUNCTIO COMPONE_LITTERALEM_FLUITANIS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT int_part SICUT NUMERUS.
    ACCIPIT frac_part SICUT NUMERUS.
    ACCIPIT frac_digits SICUT NUMERUS.

    DECLARA bits SICUT NUMERUS VALENS CALCULA_NUMERUM_FLUITANIS(int_part, frac_part, frac_digits).

    DECLARA p SICUT NUMERUS VALENS pos.
    DECLARA loci_salt SICUT NUMERUS VALENS 0.
    p = COMPONE_JMP_FUTURUM(codex, p, SEDES(loci_salt)).
    DECLARA sedes_lit SICUT NUMERUS VALENS p.
    p = SCRIBE_U64(codex, p, bits).
    DECLARA ig_lf SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_salt, p).

    p = COMPONE_ONERA(codex, p, 1, 4194304 + sedes_lit).
    p = COMPONE_MOVSD_CARGA_IND(codex, p, 0, 1).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO ANALYSA_LITTERALEM_FLUITANIS REDDENS NUMERUS.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    DECLARA int_part SICUT NUMERUS VALENS 0.
    DUM CONTENTUM(pos) < n && fons[CONTENTUM(pos)] >= 48 && fons[CONTENTUM(pos)] <= 57 PERFICE
        int_part = int_part * 10 + (fons[CONTENTUM(pos)] - 48).
        CONTENTUM(pos) = CONTENTUM(pos) + 1.
    FIN-DUM.
    DECLARA frac_part SICUT NUMERUS VALENS 0.
    DECLARA frac_digits SICUT NUMERUS VALENS 0.
    SI CONTENTUM(pos) < n && fons[CONTENTUM(pos)] == 46 TUNC
        CONTENTUM(pos) = CONTENTUM(pos) + 1.
        DUM CONTENTUM(pos) < n && fons[CONTENTUM(pos)] >= 48 && fons[CONTENTUM(pos)] <= 57 PERFICE
            frac_part = frac_part * 10 + (fons[CONTENTUM(pos)] - 48).
            frac_digits = frac_digits + 1.
            CONTENTUM(pos) = CONTENTUM(pos) + 1.
        FIN-DUM.
    FIN-SI.
    REDDE CALCULA_NUMERUM_FLUITANIS(int_part, frac_part, frac_digits).
FIN-FUNCTIO.

FUNCTIO COMPONE_NUMERUM_FLUITANIS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT bits SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.
    DECLARA loci_salt SICUT NUMERUS VALENS 0.
    p = COMPONE_JMP_FUTURUM(codex, p, SEDES(loci_salt)).
    DECLARA sedes_lit SICUT NUMERUS VALENS p.
    p = SCRIBE_U64(codex, p, bits).
    DECLARA ig_lfb SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_salt, p).
    p = COMPONE_ONERA(codex, p, 1, 4194304 + sedes_lit).
    p = COMPONE_MOVSD_CARGA_IND(codex, p, 0, 1).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_MOVSD_CARGA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT intervallum SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, 242).
    CODEX_SCRIBE(codex, indice + 1, 15).
    CODEX_SCRIBE(codex, indice + 2, 16).
    CODEX_SCRIBE(codex, indice + 3, 128 + (registrum * 8) + 5).
    CODEX_SCRIBE(codex, indice + 4, intervallum & 255).
    CODEX_SCRIBE(codex, indice + 5, (intervallum >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 6, (intervallum >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 7, (intervallum >> 24) & 255).
    REDDE indice + 8.
FIN-FUNCTIO.

FUNCTIO COMPONE_MOVSD_SALVA REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT intervallum SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, 242).
    CODEX_SCRIBE(codex, indice + 1, 15).
    CODEX_SCRIBE(codex, indice + 2, 17).
    CODEX_SCRIBE(codex, indice + 3, 128 + (registrum * 8) + 5).
    CODEX_SCRIBE(codex, indice + 4, intervallum & 255).
    CODEX_SCRIBE(codex, indice + 5, (intervallum >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 6, (intervallum >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 7, (intervallum >> 24) & 255).
    REDDE indice + 8.
FIN-FUNCTIO.

