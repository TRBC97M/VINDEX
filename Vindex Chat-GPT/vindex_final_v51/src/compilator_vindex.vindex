// Bibliotheca componendi codicem machinalis x86-64, tota in VINDEX scripta.
// Continet omnes functiones ex prioribus experimentis collectas.
//
// Metadata compilationis descriptoribus explicitis servantur.
// Symbola localia iam extra regiones 0-99, 100-199, 228-327, 850+, 2300+ et 2400+ servantur.
// Localia descriptore explicito extra tabulam utuntur.
// Unum symbolum locale XLVIII octeta habet: nomen, intervallum, series, magnitudo, structura, fluitans.
// Functiones et vocationes pendentes descriptoribus explicitis extra tabulam utuntur.
// Formae descriptore explicito extra tabulam utuntur.
// Unum recordum formae XL octeta habet: nomen, magnitudo in octetis VIII, numerus camporum, limen camporum, basis camporum.
// Unum recordum campi XXXII octeta habet: nomen, magnitudo, intervallum, fluitans.
// Cursor pilae et descriptores collectionum in contextu explicito servantur.

FUNCTIO INITIA_CODEX REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT limen SICUT NUMERUS.
    DECLARA basis SICUT NUMERUS VALENS RESERVA_OCTETA(limen).
    SI basis < 0 TUNC
        REDDE 71.
    FIN-SI.
    CONTENTUM(codex) = basis.
    CONTENTUM(codex + 8) = limen.
    CONTENTUM(codex + 16) = 0.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ASSECURA_CODEX REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT necessaria SICUT NUMERUS.
    DECLARA limen SICUT NUMERUS VALENS CONTENTUM(codex + 8).
    SI necessaria <= limen TUNC
        REDDE 0.
    FIN-SI.
    DECLARA novum_limen SICUT NUMERUS VALENS limen * 2.
    DUM novum_limen < necessaria PERFICE
        novum_limen = novum_limen * 2.
    FIN-DUM.
    DECLARA nova_basis SICUT NUMERUS VALENS RESERVA_OCTETA(novum_limen).
    SI nova_basis < 0 TUNC
        REDDE 71.
    FIN-SI.
    DECLARA basis SICUT NUMERUS VALENS CONTENTUM(codex).
    DECLARA longitudo SICUT NUMERUS VALENS CONTENTUM(codex + 16).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < longitudo PERFICE
        SCRIBE_OCTETUM_AB(nova_basis + i, OCTETUS_AB(basis + i)).
        i = i + 1.
    FIN-DUM.
    CONTENTUM(codex) = nova_basis.
    CONTENTUM(codex + 8) = novum_limen.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO CODEX_SCRIBE REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT index SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    DECLARA necessaria SICUT NUMERUS VALENS index + 1.
    DECLARA status SICUT NUMERUS VALENS ASSECURA_CODEX(codex, necessaria).
    SI status != 0 TUNC
        REDDE status.
    FIN-SI.
    SCRIBE_OCTETUM_AB(CONTENTUM(codex) + index, valor).
    SI necessaria > CONTENTUM(codex + 16) TUNC
        CONTENTUM(codex + 16) = necessaria.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO CODEX_LEGE REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT index SICUT NUMERUS.
    REDDE OCTETUS_AB(CONTENTUM(codex) + index).
FIN-FUNCTIO.

FUNCTIO SCRIBE_U16 REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, valor & 255).
    CODEX_SCRIBE(codex, indice + 1, (valor >> 8) & 255).
    REDDE indice + 2.
FIN-FUNCTIO.

FUNCTIO SCRIBE_U32 REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, valor & 255).
    CODEX_SCRIBE(codex, indice + 1, (valor >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 2, (valor >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 3, (valor >> 24) & 255).
    REDDE indice + 4.
FIN-FUNCTIO.

FUNCTIO SCRIBE_U64 REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, valor & 255).
    CODEX_SCRIBE(codex, indice + 1, (valor >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 2, (valor >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 3, (valor >> 24) & 255).
    CODEX_SCRIBE(codex, indice + 4, (valor >> 32) & 255).
    CODEX_SCRIBE(codex, indice + 5, (valor >> 40) & 255).
    CODEX_SCRIBE(codex, indice + 6, (valor >> 48) & 255).
    CODEX_SCRIBE(codex, indice + 7, (valor >> 56) & 255).
    REDDE indice + 8.
FIN-FUNCTIO.

FUNCTIO CONSTRUE_CAPUT_ELF REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT mensura_codicis SICUT NUMERUS.
    ACCIPIT punctum_ingressus SICUT NUMERUS.
    DECLARA basis SICUT NUMERUS VALENS 4194304.
    DECLARA ignoratum SICUT NUMERUS VALENS 0.

    CODEX_SCRIBE(codex, 0, 127).
    CODEX_SCRIBE(codex, 1, 69).
    CODEX_SCRIBE(codex, 2, 76).
    CODEX_SCRIBE(codex, 3, 70).
    CODEX_SCRIBE(codex, 4, 2).
    CODEX_SCRIBE(codex, 5, 1).
    CODEX_SCRIBE(codex, 6, 1).
    CODEX_SCRIBE(codex, 7, 0).

    ignoratum = SCRIBE_U16(codex, 16, 2).
    ignoratum = SCRIBE_U16(codex, 18, 62).
    ignoratum = SCRIBE_U32(codex, 20, 1).
    ignoratum = SCRIBE_U64(codex, 24, basis + punctum_ingressus).
    ignoratum = SCRIBE_U64(codex, 32, 64).
    ignoratum = SCRIBE_U64(codex, 40, 0).
    ignoratum = SCRIBE_U32(codex, 48, 0).
    ignoratum = SCRIBE_U16(codex, 52, 64).
    ignoratum = SCRIBE_U16(codex, 54, 56).
    ignoratum = SCRIBE_U16(codex, 56, 1).
    ignoratum = SCRIBE_U16(codex, 58, 0).
    ignoratum = SCRIBE_U16(codex, 60, 0).
    ignoratum = SCRIBE_U16(codex, 62, 0).

    ignoratum = SCRIBE_U32(codex, 64, 1).
    ignoratum = SCRIBE_U32(codex, 68, 7).
    ignoratum = SCRIBE_U64(codex, 72, 0).
    ignoratum = SCRIBE_U64(codex, 80, basis).
    ignoratum = SCRIBE_U64(codex, 88, basis).
    DECLARA mensura_totalis SICUT NUMERUS VALENS 120 + mensura_codicis.
    ignoratum = SCRIBE_U64(codex, 96, mensura_totalis).
    ignoratum = SCRIBE_U64(codex, 104, 46137344).
    ignoratum = SCRIBE_U64(codex, 112, 4096).

    REDDE 120.
FIN-FUNCTIO.

FUNCTIO CONSTRUE_CAPUT_PE REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT mensura_codicis SICUT NUMERUS.
    ACCIPIT punctum_ingressus SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.

    DECLARA fundamentum_imaginis SICUT NUMERUS VALENS 5368709120.
    DECLARA alignatio_fasciculi SICUT NUMERUS VALENS 512.
    DECLARA alignatio_sectionis SICUT NUMERUS VALENS 4096.
    DECLARA capita_mensura SICUT NUMERUS VALENS 512.
    DECLARA numerus_functionum_pe SICUT NUMERUS VALENS 4.

    DECLARA rva_textus SICUT NUMERUS VALENS 4096.
    DECLARA mensura_textus_fasciculi SICUT NUMERUS VALENS ((mensura_codicis + 511) / 512) * 512.
    DECLARA mensura_textus_memoriae SICUT NUMERUS VALENS ((mensura_codicis + 4095) / 4096) * 4096.
    DECLARA ptr_fasciculi_idata SICUT NUMERUS VALENS capita_mensura + mensura_textus_fasciculi.
    DECLARA rva_idata SICUT NUMERUS VALENS rva_textus + mensura_textus_memoriae.

    DECLARA pos_idata SICUT NUMERUS VALENS capita_mensura + mensura_textus_fasciculi.
    DECLARA off_ilt SICUT NUMERUS VALENS 40.
    DECLARA off_iat SICUT NUMERUS VALENS off_ilt + (numerus_functionum_pe + 1) * 8.
    DECLARA off_hint_ep SICUT NUMERUS VALENS off_iat + (numerus_functionum_pe + 1) * 8.
    DECLARA off_hint_va SICUT NUMERUS VALENS off_hint_ep + 14.
    DECLARA off_hint_gsh SICUT NUMERUS VALENS off_hint_va + 16.
    DECLARA off_hint_wf SICUT NUMERUS VALENS off_hint_gsh + 16.
    DECLARA off_nomen_dll SICUT NUMERUS VALENS off_hint_wf + 12.
    DECLARA mensura_idata SICUT NUMERUS VALENS off_nomen_dll + 13.

    DECLARA rva_ilt SICUT NUMERUS VALENS rva_idata + off_ilt.
    DECLARA rva_iat SICUT NUMERUS VALENS rva_idata + off_iat.
    DECLARA rva_hint_ep SICUT NUMERUS VALENS rva_idata + off_hint_ep.
    DECLARA rva_hint_va SICUT NUMERUS VALENS rva_idata + off_hint_va.
    DECLARA rva_hint_gsh SICUT NUMERUS VALENS rva_idata + off_hint_gsh.
    DECLARA rva_hint_wf SICUT NUMERUS VALENS rva_idata + off_hint_wf.
    DECLARA rva_nomen_dll SICUT NUMERUS VALENS rva_idata + off_nomen_dll.

    DECLARA igp1 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata, rva_ilt).
    DECLARA igp2 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata + 4, 0).
    DECLARA igp3 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata + 8, 0).
    DECLARA igp4 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata + 12, rva_nomen_dll).
    DECLARA igp5 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata + 16, rva_iat).
    DECLARA igp6 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata + 20, 0).
    DECLARA igp7 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata + 24, 0).
    DECLARA igp8 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata + 28, 0).
    DECLARA igp9 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata + 32, 0).
    DECLARA igp10 SICUT NUMERUS VALENS SCRIBE_U32(codex, pos_idata + 36, 0).

    DECLARA igp11 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_ilt, rva_hint_ep).
    DECLARA igp12 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_ilt + 8, rva_hint_va).
    DECLARA igp13 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_ilt + 16, rva_hint_gsh).
    DECLARA igp14 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_ilt + 24, rva_hint_wf).
    DECLARA igp15 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_ilt + 32, 0).
    DECLARA igp16 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_iat, rva_hint_ep).
    DECLARA igp17 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_iat + 8, rva_hint_va).
    DECLARA igp18 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_iat + 16, rva_hint_gsh).
    DECLARA igp19 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_iat + 24, rva_hint_wf).
    DECLARA igp20 SICUT NUMERUS VALENS SCRIBE_U64(codex, pos_idata + off_iat + 32, 0).

    DECLARA igp21 SICUT NUMERUS VALENS SCRIBE_U16(codex, pos_idata + off_hint_ep, 0).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 2, 69).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 3, 120).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 4, 105).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 5, 116).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 6, 80).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 7, 114).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 8, 111).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 9, 99).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 10, 101).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 11, 115).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 12, 115).
    CODEX_SCRIBE(codex, pos_idata + off_hint_ep + 13, 0).

    DECLARA igp22 SICUT NUMERUS VALENS SCRIBE_U16(codex, pos_idata + off_hint_va, 0).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 2, 86).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 3, 105).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 4, 114).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 5, 116).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 6, 117).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 7, 97).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 8, 108).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 9, 65).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 10, 108).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 11, 108).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 12, 111).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 13, 99).
    CODEX_SCRIBE(codex, pos_idata + off_hint_va + 14, 0).

    DECLARA igp23 SICUT NUMERUS VALENS SCRIBE_U16(codex, pos_idata + off_hint_gsh, 0).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 2, 71).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 3, 101).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 4, 116).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 5, 83).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 6, 116).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 7, 100).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 8, 72).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 9, 97).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 10, 110).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 11, 100).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 12, 108).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 13, 101).
    CODEX_SCRIBE(codex, pos_idata + off_hint_gsh + 14, 0).

    DECLARA igp24 SICUT NUMERUS VALENS SCRIBE_U16(codex, pos_idata + off_hint_wf, 0).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 2, 87).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 3, 114).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 4, 105).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 5, 116).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 6, 101).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 7, 70).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 8, 105).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 9, 108).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 10, 101).
    CODEX_SCRIBE(codex, pos_idata + off_hint_wf + 11, 0).

    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll, 107).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 1, 101).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 2, 114).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 3, 110).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 4, 101).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 5, 108).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 6, 51).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 7, 50).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 8, 46).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 9, 100).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 10, 108).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 11, 108).
    CODEX_SCRIBE(codex, pos_idata + off_nomen_dll + 12, 0).

    DECLARA locus_basis_textus SICUT NUMERUS VALENS fundamentum_imaginis + rva_textus.
    DECLARA descriptor_iat SICUT NUMERUS VALENS DESCRIPTOR_IAT_PE_LEGE(contextus_parseris).
    DECLARA numerus_patch_iat SICUT NUMERUS VALENS PARES_QUANTITAS(descriptor_iat).
    DECLARA idx_patch_iat SICUT NUMERUS VALENS 0.
    DUM idx_patch_iat < numerus_patch_iat PERFICE
        DECLARA id_fn_patch SICUT NUMERUS VALENS PARES_LEGE(descriptor_iat, idx_patch_iat, 0).
        DECLARA loci_patch SICUT NUMERUS VALENS PARES_LEGE(descriptor_iat, idx_patch_iat, 1).
        DECLARA rva_iat_slot SICUT NUMERUS VALENS rva_iat + (id_fn_patch * 8).
        DECLARA locus_iat_slot SICUT NUMERUS VALENS fundamentum_imaginis + rva_iat_slot.
        DECLARA locus_post_instr SICUT NUMERUS VALENS locus_basis_textus + (loci_patch - capita_mensura) + 4.
        DECLARA disp32_patch SICUT NUMERUS VALENS locus_iat_slot - locus_post_instr.
        DECLARA igpp SICUT NUMERUS VALENS SCRIBE_U32(codex, loci_patch, disp32_patch).
        idx_patch_iat = idx_patch_iat + 1.
    FIN-DUM.

    DECLARA mensura_idata_fasciculi SICUT NUMERUS VALENS ((mensura_idata + 511) / 512) * 512.
    DECLARA mensura_idata_memoriae SICUT NUMERUS VALENS ((mensura_idata + 4095) / 4096) * 4096.
    DECLARA mensura_imaginis SICUT NUMERUS VALENS ((rva_idata + mensura_idata_memoriae + 4095) / 4096) * 4096.

    DECLARA iga SICUT NUMERUS VALENS SCRIBE_U16(codex, 0, 23117).
    DECLARA igb SICUT NUMERUS VALENS SCRIBE_U32(codex, 60, 64).

    DECLARA igc SICUT NUMERUS VALENS SCRIBE_U32(codex, 64, 17744).
    DECLARA igd SICUT NUMERUS VALENS SCRIBE_U16(codex, 68, 34404).
    DECLARA ige SICUT NUMERUS VALENS SCRIBE_U16(codex, 70, 2).
    DECLARA igf SICUT NUMERUS VALENS SCRIBE_U32(codex, 72, 0).
    DECLARA igg SICUT NUMERUS VALENS SCRIBE_U32(codex, 76, 0).
    DECLARA igh SICUT NUMERUS VALENS SCRIBE_U32(codex, 80, 0).
    DECLARA igi SICUT NUMERUS VALENS SCRIBE_U16(codex, 84, 240).
    DECLARA igj SICUT NUMERUS VALENS SCRIBE_U16(codex, 86, 34).

    DECLARA igk SICUT NUMERUS VALENS SCRIBE_U16(codex, 88, 523).
    CODEX_SCRIBE(codex, 90, 0).
    CODEX_SCRIBE(codex, 91, 0).
    DECLARA igl SICUT NUMERUS VALENS SCRIBE_U32(codex, 92, mensura_textus_memoriae).
    DECLARA igm SICUT NUMERUS VALENS SCRIBE_U32(codex, 96, mensura_idata_memoriae).
    DECLARA ign SICUT NUMERUS VALENS SCRIBE_U32(codex, 100, 0).
    DECLARA igo SICUT NUMERUS VALENS SCRIBE_U32(codex, 104, (punctum_ingressus - capita_mensura) + rva_textus).
    DECLARA igq2 SICUT NUMERUS VALENS SCRIBE_U32(codex, 108, rva_textus).
    DECLARA igr2 SICUT NUMERUS VALENS SCRIBE_U64(codex, 112, fundamentum_imaginis).
    DECLARA igs2 SICUT NUMERUS VALENS SCRIBE_U32(codex, 120, alignatio_sectionis).
    DECLARA igt2 SICUT NUMERUS VALENS SCRIBE_U32(codex, 124, alignatio_fasciculi).
    DECLARA igu2 SICUT NUMERUS VALENS SCRIBE_U16(codex, 128, 6).
    DECLARA igv2 SICUT NUMERUS VALENS SCRIBE_U16(codex, 130, 0).
    DECLARA igw2 SICUT NUMERUS VALENS SCRIBE_U16(codex, 132, 0).
    DECLARA igx2 SICUT NUMERUS VALENS SCRIBE_U16(codex, 134, 0).
    DECLARA igy2 SICUT NUMERUS VALENS SCRIBE_U16(codex, 136, 6).
    DECLARA igz2 SICUT NUMERUS VALENS SCRIBE_U16(codex, 138, 0).
    DECLARA igaa SICUT NUMERUS VALENS SCRIBE_U32(codex, 140, 0).
    DECLARA igab SICUT NUMERUS VALENS SCRIBE_U32(codex, 144, mensura_imaginis).
    DECLARA igac SICUT NUMERUS VALENS SCRIBE_U32(codex, 148, capita_mensura).
    DECLARA igad SICUT NUMERUS VALENS SCRIBE_U32(codex, 152, 0).
    DECLARA igae SICUT NUMERUS VALENS SCRIBE_U16(codex, 156, 3).
    DECLARA igaf SICUT NUMERUS VALENS SCRIBE_U16(codex, 158, 0).
    DECLARA igag SICUT NUMERUS VALENS SCRIBE_U64(codex, 160, 1048576).
    DECLARA igah SICUT NUMERUS VALENS SCRIBE_U64(codex, 168, 4096).
    DECLARA igai SICUT NUMERUS VALENS SCRIBE_U64(codex, 176, 1048576).
    DECLARA igaj SICUT NUMERUS VALENS SCRIBE_U64(codex, 184, 4096).
    DECLARA igak SICUT NUMERUS VALENS SCRIBE_U32(codex, 192, 0).
    DECLARA igal SICUT NUMERUS VALENS SCRIBE_U32(codex, 196, 16).

    DECLARA igam SICUT NUMERUS VALENS SCRIBE_U32(codex, 208, rva_idata).
    DECLARA igan SICUT NUMERUS VALENS SCRIBE_U32(codex, 212, 40).
    DECLARA igao SICUT NUMERUS VALENS SCRIBE_U32(codex, 296, rva_iat).
    DECLARA igap2 SICUT NUMERUS VALENS SCRIBE_U32(codex, 300, numerus_functionum_pe * 8).

    CODEX_SCRIBE(codex, 328, 46).
    CODEX_SCRIBE(codex, 329, 116).
    CODEX_SCRIBE(codex, 330, 101).
    CODEX_SCRIBE(codex, 331, 120).
    CODEX_SCRIBE(codex, 332, 116).
    CODEX_SCRIBE(codex, 333, 0).
    CODEX_SCRIBE(codex, 334, 0).
    CODEX_SCRIBE(codex, 335, 0).
    DECLARA igaq SICUT NUMERUS VALENS SCRIBE_U32(codex, 336, mensura_textus_memoriae).
