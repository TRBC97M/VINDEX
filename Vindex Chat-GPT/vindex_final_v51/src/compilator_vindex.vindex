            DUM k_summa_forma < numerus_campi PERFICE
                summa_magnitudinis_forma = summa_magnitudinis_forma + tabula[1050 + k_summa_forma].
                k_summa_forma = k_summa_forma + 1.
            FIN-DUM.
            tabula[1000 + idx_registrum_forma] = summa_magnitudinis_forma / 8.

            DECLARA base_bloc_forma SICUT NUMERUS VALENS 1100 + (idx_registrum_forma * 78).
            DECLARA k_bloc_forma SICUT NUMERUS VALENS 0.
            DECLARA offset_cumul_forma SICUT NUMERUS VALENS 0.
            DUM k_bloc_forma < numerus_campi PERFICE
                tabula[base_bloc_forma + (k_bloc_forma * 3)] = tabula[200 + k_bloc_forma].
                tabula[base_bloc_forma + (k_bloc_forma * 3) + 1] = tabula[1050 + k_bloc_forma].
                tabula[base_bloc_forma + (k_bloc_forma * 3) + 2] = offset_cumul_forma.
                tabula[2530 + (idx_registrum_forma * 26) + k_bloc_forma] = tabula[2500 + k_bloc_forma].
                offset_cumul_forma = offset_cumul_forma + tabula[1050 + k_bloc_forma].
                k_bloc_forma = k_bloc_forma + 1.
            FIN-DUM.
        ALITER
        SI fons[i] == 70 && i + 7 < n && fons[i+1] == 85 && fons[i+2] == 78 && fons[i+3] == 67 && fons[i+4] == 84 && fons[i+5] == 73 && fons[i+6] == 79 && fons[i+7] == 32 TUNC
            i = i + 8.
