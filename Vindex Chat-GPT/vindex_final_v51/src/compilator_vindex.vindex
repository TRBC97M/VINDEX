    FIN-SI.
    DECLARA pos SICUT NUMERUS VALENS 120.
    DECLARA punctum_ingressus SICUT NUMERUS VALENS 120.
    DECLARA inventa_principalis SICUT NUMERUS VALENS 0.

    DECLARA tabula SICUT ORDO DE NUMERUS CAPACITAS 3000.

    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < n PERFICE
        SI fons[i] == 73 && i + 7 < n && fons[i+1] == 77 && fons[i+2] == 80 && fons[i+3] == 79 && fons[i+4] == 82 && fons[i+5] == 84 && fons[i+6] == 65 && fons[i+7] == 32 TUNC
            i = i + 8.
            DUM i < n && fons[i] != 46 PERFICE
                i = i + 1.
            FIN-DUM.
            i = i + 1.
