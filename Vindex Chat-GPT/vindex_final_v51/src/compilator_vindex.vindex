                        tabula[idx_param_pp + 100] = intervallum_param_pp.
                        tabula[228 + idx_param_pp] = est_series_pp.
                        SI magnitudo_pp == 0 - 1 TUNC
                            tabula[850 + idx_param_pp] = 0.
