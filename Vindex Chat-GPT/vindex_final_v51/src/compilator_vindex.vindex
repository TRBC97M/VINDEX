                                idx_struct_ptr = INDEX_STRUCTURAE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), nomen_typus_interior).
                                DECLARA pos_scrutinii SICUT NUMERUS VALENS CONTENTUM(pos_fontis) + 4.
