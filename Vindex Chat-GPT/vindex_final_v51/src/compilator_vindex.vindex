                                                idx_campus_aff = idx_campus_aff + 1.
                                            FIN-DUM.

                                            SI fons[CONTENTUM(pos_fontis)] == 67 && CONTENTUM(pos_fontis) + 9 < n && fons[CONTENTUM(pos_fontis)+1] == 79 && fons[CONTENTUM(pos_fontis)+2] == 78 && fons[CONTENTUM(pos_fontis)+3] == 84 && fons[CONTENTUM(pos_fontis)+4] == 69 && fons[CONTENTUM(pos_fontis)+5] == 78 && fons[CONTENTUM(pos_fontis)+6] == 84 && fons[CONTENTUM(pos_fontis)+7] == 85 && fons[CONTENTUM(pos_fontis)+8] == 77 && fons[CONTENTUM(pos_fontis)+9] == 40 TUNC
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 10.
                                                DECLARA offset_ptr_campus_aff SICUT NUMERUS VALENS OFFSET_PTR_CAMPUS_STRUCTA(tabula, fons, CONTENTUM(pos_fontis), n, idx_campus_aff, nomen_aff).
                                                DECLARA ig_campus_ptr_aff SICUT NUMERUS VALENS ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                                ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 3, offset_ptr_campus_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 0, 3).
                                                CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).

                                                ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                                ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                                CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
                                                CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 0, 3).

                                                DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                FIN-DUM.
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ALITER

                                            DECLARA nomen_var_campus_aff SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, pos_fontis, n).
                                            DECLARA intervallum_var_campus_aff SICUT NUMERUS VALENS CERCA_VARIABILEM(tabula, nomen_var_campus_aff).
                                            DECLARA idx_struct_campus_aff SICUT NUMERUS VALENS STRUCTURA_VARIABILIS(tabula, nomen_var_campus_aff).
                                            DECLARA offset_campus_w SICUT NUMERUS VALENS 0.
                                            SI idx_struct_campus_aff > 0 TUNC
                                                offset_campus_w = CAMPUS_STRUCTURAE_OFFSET(tabula, idx_struct_campus_aff - 1, nomen_aff).
                                            ALITER
                                                offset_campus_w = OFFSET_CUMULATIVUS_CAMPI(tabula, idx_campus_aff).
                                            FIN-SI.

                                            SI CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] == 91 TUNC
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                DECLARA r_idxc_aff SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                                DECLARA ign_idxca SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

                                                DECLARA magnitudo_arrc_aff SICUT NUMERUS VALENS MAGNITUDO_VARIABILIS(tabula, nomen_var_campus_aff).
                                                SI magnitudo_arrc_aff == 0 TUNC
                                                    magnitudo_arrc_aff = 8.
                                                FIN-SI.

                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, magnitudo_arrc_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 0, 2).
                                                CONTENTUM(pos_codicis) = COMPONE_LEA_PILA(codex, CONTENTUM(pos_codicis), 3, intervallum_var_campus_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 3, 0).
                                                DECLARA correctio_ref_aff SICUT NUMERUS VALENS magnitudo_arrc_aff - 8.
                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, correctio_ref_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 3, 2).
                                                DECLARA intervallum_ic_aff2 SICUT NUMERUS VALENS 0 - offset_campus_w.
                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, intervallum_ic_aff2).
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 3, 2).
                                                CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 3).

                                                ign_idxca = IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                ign_idxca = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                                CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 1, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 3).
                                                CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 3, 1).

                                                DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                                FIN-DUM.
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ALITER

                                            DECLARA intervallum_campus_aff SICUT NUMERUS VALENS intervallum_var_campus_aff - offset_campus_w.

                                            ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                            SI idx_struct_campus_aff > 0 && CAMPUS_STRUCTURAE_EST_FLUITANS(tabula, idx_struct_campus_aff - 1, nomen_aff) == 1 TUNC
                                                CONTENTUM(pos_codicis) = COMPONE_MOVQ_A_XMM(codex, CONTENTUM(pos_codicis), 0, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_MOVSD_SALVA(codex, CONTENTUM(pos_codicis), intervallum_campus_aff, 0).
                                            ALITER
                                                CONTENTUM(pos_codicis) = COMPONE_SERVA_PILA(codex, CONTENTUM(pos_codicis), intervallum_campus_aff, 0).
                                            FIN-SI.
                                            DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            FIN-DUM.
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            FIN-SI.
                                            FIN-SI.

                                        ALITER
                                        DECLARA intervallum_aff SICUT NUMERUS VALENS CERCA_VARIABILEM(tabula, nomen_aff).
                                        DECLARA est_series_aff SICUT NUMERUS VALENS ESTNE_SERIES(tabula, nomen_aff).
                                        DECLARA magnitudo_aff SICUT NUMERUS VALENS MAGNITUDO_VARIABILIS(tabula, nomen_aff).

                                        SI fons[CONTENTUM(pos_fontis)] == 91 TUNC
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            DECLARA r_idx2 SICUT NUMERUS VALENS ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                            DECLARA ign3 SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ign3 = IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

                                            CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
                                            ign3 = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                            CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
                                            CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).

                                            SI magnitudo_aff > 0 TUNC
                                                CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 3).
                                                CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, magnitudo_aff).
                                                CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 0, 2).
                                                SI est_series_aff == 1 TUNC
                                                    CONTENTUM(pos_codicis) = COMPONE_LEA_PILA(codex, CONTENTUM(pos_codicis), 1, intervallum_aff).
                                                ALITER
                                                    CONTENTUM(pos_codicis) = COMPONE_SUME_PILA(codex, CONTENTUM(pos_codicis), 1, intervallum_aff).
                                                FIN-SI.
                                                CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 1, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
                                                SI magnitudo_aff == 1 TUNC
                                                    CONTENTUM(pos_codicis) = COMPONE_SERVA_OCTETUM(codex, CONTENTUM(pos_codicis), 1, 0).
                                                ALITER
                                                    CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 1, 0).
                                                FIN-SI.
                                            ALITER
                                            CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 3).
                                            CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, 8).
                                            CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 0, 2).
                                            SI est_series_aff == 2 TUNC
                                                CONTENTUM(pos_codicis) = COMPONE_SUME_PILA(codex, CONTENTUM(pos_codicis), 1, intervallum_aff).
                                            ALITER
                                                CONTENTUM(pos_codicis) = COMPONE_LEA_PILA(codex, CONTENTUM(pos_codicis), 1, intervallum_aff).
                                            FIN-SI.
                                            CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 1, 0).
                                            CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
                                            SI EST_FLUITANS_VARIABILIS(tabula, nomen_aff) == 1 TUNC
                                                CONTENTUM(pos_codicis) = COMPONE_MOVQ_A_XMM(codex, CONTENTUM(pos_codicis), 0, 0).
                                                CONTENTUM(pos_codicis) = COMPONE_MOVSD_SALVA_IND(codex, CONTENTUM(pos_codicis), 1, 0).
                                            ALITER
                                                CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 1, 0).
                                            FIN-SI.
                                            FIN-SI.
                                        ALITER
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                            CONTENTUM(pos_codicis) = COMPONE_SERVA_PILA(codex, CONTENTUM(pos_codicis), intervallum_aff, 0).
                                        FIN-SI.

                                        DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                        FIN-DUM.
                                        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                        FIN-SI.
                                    ALITER
                                        SI fons[i] == 67 && i + 8 < n && fons[i+1] == 79 && fons[i+2] == 78 && fons[i+3] == 84 && fons[i+4] == 69 && fons[i+5] == 78 && fons[i+6] == 84 && fons[i+7] == 85 && fons[i+8] == 77 TUNC
                                            CONTENTUM(pos_fontis) = i + 9.
                                            DECLARA ign_cw SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ign_cw = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                            ign_cw = IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
                                            ign_cw = IGNORA_SPATIA(fons, pos_fontis, n).
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ign_cw = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                            CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
                                            CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
                                            CONTENTUM(pos_codicis) = COMPONE_SERVA_INDIRECTUM(codex, CONTENTUM(pos_codicis), 0, 3).
                                            DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 46 PERFICE
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            FIN-DUM.
                                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                        ALITER
                                            SI fons[i] >= 65 && fons[i] <= 90 TUNC
                                                CONTENTUM(pos_fontis) = i.
                                                DECLARA ign_appelnu SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, tabula).
                                                ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                                            ALITER
                                                CONTENTUM(pos_fontis) = i + 1.
                                            FIN-SI.
                                        FIN-SI.
                                    FIN-SI.
                                FIN-SI.
                            FIN-SI.
                        FIN-SI.
                    FIN-SI.
                FIN-SI.
            FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FORMA IntervallumNominis.
    CAMPUS c0 SICUT NUMERUS.
    CAMPUS c1 SICUT NUMERUS.
    CAMPUS c2 SICUT NUMERUS.
    CAMPUS c3 SICUT NUMERUS.
    CAMPUS c4 SICUT NUMERUS.
    CAMPUS c5 SICUT NUMERUS.
    CAMPUS c6 SICUT NUMERUS.
    CAMPUS c7 SICUT NUMERUS.
    CAMPUS c8 SICUT NUMERUS.
    CAMPUS c9 SICUT NUMERUS.
    CAMPUS c10 SICUT NUMERUS.
    CAMPUS c11 SICUT NUMERUS.
    CAMPUS c12 SICUT NUMERUS.
    CAMPUS c13 SICUT NUMERUS.
    CAMPUS c14 SICUT NUMERUS.
    CAMPUS c15 SICUT NUMERUS.
    CAMPUS c16 SICUT NUMERUS.
    CAMPUS c17 SICUT NUMERUS.
    CAMPUS c18 SICUT NUMERUS.
    CAMPUS c19 SICUT NUMERUS.
    CAMPUS c20 SICUT NUMERUS.
    CAMPUS c21 SICUT NUMERUS.
    CAMPUS c22 SICUT NUMERUS.
    CAMPUS c23 SICUT NUMERUS.
    CAMPUS c24 SICUT NUMERUS.
    CAMPUS c25 SICUT NUMERUS.
    CAMPUS c26 SICUT NUMERUS.
    CAMPUS c27 SICUT NUMERUS.
    CAMPUS c28 SICUT NUMERUS.
    CAMPUS c29 SICUT NUMERUS.
    CAMPUS c30 SICUT NUMERUS.
    CAMPUS c31 SICUT NUMERUS.
FIN-FORMA.

FUNCTIO LEGE_TOTUM_DYNAMICUM REDDENS NUMERUS.
    ACCIPIT descriptor SICUT NUMERUS.
    ACCIPIT longitudo SICUT ACUS<NUMERUS>.
    DECLARA limen SICUT NUMERUS VALENS 65536.
    DECLARA basis SICUT NUMERUS VALENS RESERVA_OCTETA(limen).
    SI basis < 0 TUNC
        CONTENTUM(longitudo) = 0 - 1.
        REDDE basis.
    FIN-SI.
    DECLARA quantitas SICUT NUMERUS VALENS 0.
    DECLARA continua SICUT NUMERUS VALENS 1.
    DUM continua == 1 PERFICE
        DECLARA pars SICUT NUMERUS VALENS LEGE(descriptor, 65536).
        SI pars < 0 TUNC
            CONTENTUM(longitudo) = 0 - 1.
            REDDE pars.
        FIN-SI.
        SI pars == 0 TUNC
            continua = 0.
        ALITER
            SI quantitas + pars > limen TUNC
                DECLARA nova_capacitas SICUT NUMERUS VALENS limen * 2.
                DUM nova_capacitas < quantitas + pars PERFICE
                    nova_capacitas = nova_capacitas * 2.
                FIN-DUM.
                DECLARA nova_basis SICUT NUMERUS VALENS RESERVA_OCTETA(nova_capacitas).
                SI nova_basis < 0 TUNC
                    CONTENTUM(longitudo) = 0 - 1.
                    REDDE nova_basis.
                FIN-SI.
                DECLARA i SICUT NUMERUS VALENS 0.
                DUM i < quantitas PERFICE
                    SCRIBE_OCTETUM_AB(nova_basis + i, OCTETUS_AB(basis + i)).
                    i = i + 1.
                FIN-DUM.
                basis = nova_basis.
                limen = nova_capacitas.
            FIN-SI.
            DECLARA j SICUT NUMERUS VALENS 0.
            DUM j < pars PERFICE
                SCRIBE_OCTETUM_AB(basis + quantitas + j, OCTETUS(j)).
                j = j + 1.
            FIN-DUM.
            quantitas = quantitas + pars.
        FIN-SI.
    FIN-DUM.
    CONTENTUM(longitudo) = quantitas.
    REDDE basis.
FIN-FUNCTIO.

FUNCTIO ASSECURA_BUFFERUM REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT necessaria SICUT NUMERUS.
    ACCIPIT limen SICUT ACUS<NUMERUS>.
    SI necessaria <= CONTENTUM(limen) TUNC
        REDDE basis.
    FIN-SI.
    DECLARA nova_capacitas SICUT NUMERUS VALENS CONTENTUM(limen) * 2.
    DUM nova_capacitas < necessaria PERFICE
        nova_capacitas = nova_capacitas * 2.
    FIN-DUM.
    DECLARA nova_basis SICUT NUMERUS VALENS RESERVA_OCTETA(nova_capacitas).
    SI nova_basis < 0 TUNC
        REDDE nova_basis.
    FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < longitudo PERFICE
        SCRIBE_OCTETUM_AB(nova_basis + i, OCTETUS_AB(basis + i)).
        i = i + 1.
    FIN-DUM.
    CONTENTUM(limen) = nova_capacitas.
    REDDE nova_basis.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    ACCIPIT argc SICUT NUMERUS.
    ACCIPIT argv SICUT ACUS<NUMERUS>.

    SI argc < 3 TUNC
        PROCLAMA "USUS: compilator_vindex <fons.vindex> <exsecutabile>".
        REDDE 64.
    FIN-SI.

    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE(argv[1]).
    SI fd < 0 TUNC
        PROCLAMA "ERRATUM: fons aperiri non potest".
        REDDE 66.
    FIN-SI.
    DECLARA n SICUT NUMERUS VALENS 0.
    DECLARA basis_fons_brut SICUT NUMERUS VALENS LEGE_TOTUM_DYNAMICUM(fd, SEDES(n)).
    CLAUDE(fd).
    SI n < 0 || basis_fons_brut < 0 TUNC
        PROCLAMA "ERRATUM: fons legi non potest".
        REDDE 74.
    FIN-SI.
    DECLARA fons_brut SICUT ACUS<LITTERA> VALENS basis_fons_brut.
    DECLARA capacitas_fons SICUT NUMERUS VALENS 65536.
    DECLARA basis_fons SICUT NUMERUS VALENS RESERVA_OCTETA(capacitas_fons).
    SI basis_fons < 0 TUNC
        PROCLAMA "ERRATUM: memoria fontium reservata non est".
        REDDE 71.
    FIN-SI.
    DECLARA pos_out_imp SICUT NUMERUS VALENS 0.
    DECLARA i_imp SICUT NUMERUS VALENS 0.

    DUM i_imp < n PERFICE
        SI fons_brut[i_imp] == 73 && i_imp + 7 < n && fons_brut[i_imp+1] == 77 && fons_brut[i_imp+2] == 80 && fons_brut[i_imp+3] == 79 && fons_brut[i_imp+4] == 82 && fons_brut[i_imp+5] == 84 && fons_brut[i_imp+6] == 65 && fons_brut[i_imp+7] == 32 TUNC
            i_imp = i_imp + 8.
            DUM i_imp < n && fons_brut[i_imp] != 34 PERFICE
                i_imp = i_imp + 1.
            FIN-DUM.
            i_imp = i_imp + 1.
            DECLARA debut_nom_imp SICUT NUMERUS VALENS i_imp.
            DUM i_imp < n && fons_brut[i_imp] != 34 PERFICE
                i_imp = i_imp + 1.
            FIN-DUM.
            DECLARA fin_nom_imp SICUT NUMERUS VALENS i_imp.

            DECLARA nomen_base_imp SICUT NUMERUS VALENS RESERVA(IntervallumNominis).
            DECLARA j_imp SICUT NUMERUS VALENS 0.
            DECLARA k2_imp SICUT NUMERUS VALENS debut_nom_imp.
            DUM k2_imp < fin_nom_imp PERFICE
                SCRIBE_OCTETUM_AB(nomen_base_imp + j_imp, fons_brut[k2_imp]).
                j_imp = j_imp + 1.
                k2_imp = k2_imp + 1.
            FIN-DUM.
            SCRIBE_OCTETUM_AB(nomen_base_imp + j_imp, 0).

            i_imp = i_imp + 1.
            DUM i_imp < n && fons_brut[i_imp] != 46 PERFICE
                i_imp = i_imp + 1.
            FIN-DUM.
            i_imp = i_imp + 1.

            DECLARA fd_imp2 SICUT NUMERUS VALENS APERI_LEGERE(nomen_base_imp).
            SI fd_imp2 >= 0 TUNC
                DECLARA n_imp2 SICUT NUMERUS VALENS 0.
                DECLARA basis_imp SICUT NUMERUS VALENS LEGE_TOTUM_DYNAMICUM(fd_imp2, SEDES(n_imp2)).
                CLAUDE(fd_imp2).
                SI n_imp2 < 0 || basis_imp < 0 TUNC
                    PROCLAMA "ERRATUM: fons importatus legi non potest".
                    REDDE 74.
                FIN-SI.
                DECLARA basis_crescens SICUT NUMERUS VALENS ASSECURA_BUFFERUM(basis_fons, pos_out_imp, pos_out_imp + n_imp2 + 1, SEDES(capacitas_fons)).
                SI basis_crescens < 0 TUNC
                    PROCLAMA "ERRATUM: memoria fontium augeri non potest".
                    REDDE 71.
                FIN-SI.
                basis_fons = basis_crescens.
                DECLARA m_imp SICUT NUMERUS VALENS 0.
                DUM m_imp < n_imp2 PERFICE
                    SCRIBE_OCTETUM_AB(basis_fons + pos_out_imp, OCTETUS_AB(basis_imp + m_imp)).
                    pos_out_imp = pos_out_imp + 1.
                    m_imp = m_imp + 1.
                FIN-DUM.
                SCRIBE_OCTETUM_AB(basis_fons + pos_out_imp, 10).
                pos_out_imp = pos_out_imp + 1.
            ALITER
                PROCLAMA "ERRATUM: fons importatus aperiri non potest".
