FUNCTIO COMPONE_JMP_RETRO REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, 233).
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (indice + 5).
    CODEX_SCRIBE(codex, indice + 1, relatio & 255).
    CODEX_SCRIBE(codex, indice + 2, (relatio >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 3, (relatio >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 4, (relatio >> 24) & 255).
    REDDE indice + 5.
FIN-FUNCTIO.

FUNCTIO CORRIGE_SALTUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT loci SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (loci + 4).
    CODEX_SCRIBE(codex, loci, relatio & 255).
    CODEX_SCRIBE(codex, loci + 1, (relatio >> 8) & 255).
    CODEX_SCRIBE(codex, loci + 2, (relatio >> 16) & 255).
    CODEX_SCRIBE(codex, loci + 3, (relatio >> 24) & 255).
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO COMPONE_IMPONE REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    DECLARA fin SICUT NUMERUS VALENS indice.
    SI registrum >= 8 TUNC
        CODEX_SCRIBE(codex, fin, 65).
        fin = fin + 1.
    FIN-SI.
    CODEX_SCRIBE(codex, fin, 80 + (registrum & 7)).
    REDDE fin + 1.
FIN-FUNCTIO.

FUNCTIO COMPONE_AUFER REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    DECLARA fin SICUT NUMERUS VALENS indice.
    SI registrum >= 8 TUNC
        CODEX_SCRIBE(codex, fin, 65).
        fin = fin + 1.
    FIN-SI.
    CODEX_SCRIBE(codex, fin, 88 + (registrum & 7)).
    REDDE fin + 1.
FIN-FUNCTIO.

FUNCTIO COMPONE_VOCA_RETRO REDDENS NUMERUS.
