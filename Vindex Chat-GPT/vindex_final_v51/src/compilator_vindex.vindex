    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI fons >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI basis >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    CODEX_SCRIBE(codex, indice, rex).
    CODEX_SCRIBE(codex, indice + 1, 137).
    CODEX_SCRIBE(codex, indice + 2, ((fons & 7) * 8) + (basis & 7)).
    REDDE indice + 3.
FIN-FUNCTIO.

FUNCTIO COMPONE_JNE_RETRO REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    CODEX_SCRIBE(codex, indice, 15).
    CODEX_SCRIBE(codex, indice + 1, 133).
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (indice + 6).
    CODEX_SCRIBE(codex, indice + 2, relatio & 255).
    CODEX_SCRIBE(codex, indice + 3, (relatio >> 8) & 255).
    CODEX_SCRIBE(codex, indice + 4, (relatio >> 16) & 255).
    CODEX_SCRIBE(codex, indice + 5, (relatio >> 24) & 255).
    REDDE indice + 6.
FIN-FUNCTIO.

