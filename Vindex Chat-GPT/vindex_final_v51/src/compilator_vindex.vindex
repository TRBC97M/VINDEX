                                    ignoratum = CORRIGE_SALTUM(codex, loci_je, pos_post2).
                                FIN-SI.

                                ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 6.

                            ALITER
                                SI fons[i] == 68 && i + 5 < n && fons[i+1] == 69 && fons[i+2] == 83 && fons[i+3] == 73 && fons[i+4] == 78 && fons[i+5] == 69 TUNC
                                    DECLARA loci_desine SICUT NUMERUS VALENS 0.
                                    CONTENTUM(pos_codicis) = COMPONE_JMP_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_desine)).
                                    tabula[227] = loci_desine.
                                    CONTENTUM(pos_fontis) = i + 7.

                            ALITER
