FUNCTIO COMPONE_LITTERALEM_FLUITANIS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT int_part SICUT NUMERUS.
    ACCIPIT frac_part SICUT NUMERUS.
    ACCIPIT frac_digits SICUT NUMERUS.

    DECLARA bits SICUT NUMERUS VALENS CALCULA_NUMERUM_FLUITANIS(int_part, frac_part, frac_digits).

    DECLARA p SICUT NUMERUS VALENS pos.
    DECLARA loci_salt SICUT NUMERUS VALENS 0.
    p = COMPONE_JMP_FUTURUM(codex, p, SEDES(loci_salt)).
    DECLARA sedes_lit SICUT NUMERUS VALENS p.
    p = SCRIBE_U64(codex, p, bits).
    DECLARA ig_lf SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_salt, p).

    p = COMPONE_ONERA(codex, p, 1, 4194304 + sedes_lit).
    p = COMPONE_MOVSD_CARGA_IND(codex, p, 0, 1).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO ANALYSA_LITTERALEM_FLUITANIS REDDENS NUMERUS.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    DECLARA int_part SICUT NUMERUS VALENS 0.
    DUM CONTENTUM(pos) < n && fons[CONTENTUM(pos)] >= 48 && fons[CONTENTUM(pos)] <= 57 PERFICE
        int_part = int_part * 10 + (fons[CONTENTUM(pos)] - 48).
        CONTENTUM(pos) = CONTENTUM(pos) + 1.
    FIN-DUM.
    DECLARA frac_part SICUT NUMERUS VALENS 0.
    DECLARA frac_digits SICUT NUMERUS VALENS 0.
    SI CONTENTUM(pos) < n && fons[CONTENTUM(pos)] == 46 TUNC
        CONTENTUM(pos) = CONTENTUM(pos) + 1.
        DUM CONTENTUM(pos) < n && fons[CONTENTUM(pos)] >= 48 && fons[CONTENTUM(pos)] <= 57 PERFICE
            frac_part = frac_part * 10 + (fons[CONTENTUM(pos)] - 48).
            frac_digits = frac_digits + 1.
            CONTENTUM(pos) = CONTENTUM(pos) + 1.
        FIN-DUM.
    FIN-SI.
    REDDE CALCULA_NUMERUM_FLUITANIS(int_part, frac_part, frac_digits).
FIN-FUNCTIO.

FUNCTIO COMPONE_NUMERUM_FLUITANIS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT bits SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.
    DECLARA loci_salt SICUT NUMERUS VALENS 0.
    p = COMPONE_JMP_FUTURUM(codex, p, SEDES(loci_salt)).
    DECLARA sedes_lit SICUT NUMERUS VALENS p.
    p = SCRIBE_U64(codex, p, bits).
    DECLARA ig_lfb SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_salt, p).
    p = COMPONE_ONERA(codex, p, 1, 4194304 + sedes_lit).
    p = COMPONE_MOVSD_CARGA_IND(codex, p, 0, 1).
    REDDE p.
FIN-FUNCTIO.

