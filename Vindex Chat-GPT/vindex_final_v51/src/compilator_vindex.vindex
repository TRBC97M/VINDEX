        rex = rex | 1.
    FIN-SI.
    CODEX_SCRIBE(codex, indice, rex).
    CODEX_SCRIBE(codex, indice + 1, 15).
    CODEX_SCRIBE(codex, indice + 2, 182).
    CODEX_SCRIBE(codex, indice + 3, ((destinatio & 7) * 8) + (basis & 7)).
