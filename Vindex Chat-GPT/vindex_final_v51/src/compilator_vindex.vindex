FUNCTIO COMPONE_IMPRIME_NUMERUS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT intervallum_scratch SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.

    p = COMPONE_ONERA(codex, p, 3, 0).
    p = COMPONE_SUB(codex, p, 0, 3).
    DECLARA loci_jge_signum SICUT NUMERUS VALENS 0.
    p = COMPONE_JGE_FUTURUM(codex, p, SEDES(loci_jge_signum)).
    p = COMPONE_ONERA(codex, p, 3, 0).
    p = COMPONE_SUB(codex, p, 3, 0).
    p = COMPONE_TRANSCRIBE(codex, p, 0, 3).
    p = COMPONE_IMPONE(codex, p, 0).
    p = COMPONE_ONERA(codex, p, 3, 45).
    p = COMPONE_SERVA_PILA(codex, p, intervallum_scratch, 3).
    p = COMPONE_LEA_PILA(codex, p, 6, intervallum_scratch).
    p = COMPONE_SCRIBE_STDOUT_DYNAMICA(codex, p, contextus_parseris, 1).
    p = COMPONE_AUFER(codex, p, 0).
    DECLARA pos_post_signum SICUT NUMERUS VALENS p.
    DECLARA ig1_pin SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_jge_signum, pos_post_signum).

    p = COMPONE_ONERA(codex, p, 1, 0).

    DECLARA pos_ansae_numerandi SICUT NUMERUS VALENS p.
    p = COMPONE_XOR(codex, p, 2, 2).
    p = COMPONE_ONERA(codex, p, 3, 10).
    p = COMPONE_DIV(codex, p, 3).
    p = COMPONE_ONERA(codex, p, 6, 48).
    p = COMPONE_ADD(codex, p, 2, 6).
    p = COMPONE_IMPONE(codex, p, 2).
    p = COMPONE_ONERA(codex, p, 6, 1).
    p = COMPONE_ADD(codex, p, 1, 6).
    p = COMPONE_ONERA(codex, p, 6, 0).
    p = COMPONE_SUB(codex, p, 0, 6).
    p = COMPONE_JNE_RETRO(codex, p, pos_ansae_numerandi).
    p = COMPONE_TRANSCRIBE(codex, p, 3, 1).

    DECLARA loci_je_proclama SICUT NUMERUS VALENS 0.
    DECLARA pos_ansae_scribendi SICUT NUMERUS VALENS p.
    p = COMPONE_ONERA(codex, p, 6, 0).
    p = COMPONE_SUB(codex, p, 3, 6).
    p = COMPONE_JE_FUTURUM(codex, p, SEDES(loci_je_proclama)).
    p = COMPONE_AUFER(codex, p, 0).
    p = COMPONE_SERVA_PILA(codex, p, intervallum_scratch, 0).
    p = COMPONE_LEA_PILA(codex, p, 6, intervallum_scratch).
    p = COMPONE_SCRIBE_STDOUT_DYNAMICA(codex, p, contextus_parseris, 1).
    p = COMPONE_ONERA(codex, p, 6, 1).
    p = COMPONE_SUB(codex, p, 3, 6).
    p = COMPONE_JMP_RETRO(codex, p, pos_ansae_scribendi).

    DECLARA pos_post_proclama SICUT NUMERUS VALENS p.
    DECLARA ig2_pin SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_je_proclama, pos_post_proclama).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_IMPRIME_CHAR REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT intervallum_scratch SICUT NUMERUS.
    ACCIPIT caracter SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.
    p = COMPONE_ONERA(codex, p, 0, caracter).
    p = COMPONE_SERVA_PILA(codex, p, intervallum_scratch, 0).
    p = COMPONE_LEA_PILA(codex, p, 6, intervallum_scratch).
    p = COMPONE_SCRIBE_STDOUT_DYNAMICA(codex, p, contextus_parseris, 1).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_IMPRIME_PADEADO REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT intervallum_scratch SICUT NUMERUS.
    ACCIPIT ancho SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.
    p = COMPONE_TRANSCRIBE(codex, p, 12, 0).

    DECLARA divisor SICUT NUMERUS VALENS 1.
    DECLARA k SICUT NUMERUS VALENS 1.
    DUM k < ancho PERFICE
        divisor = divisor * 10.
        k = k + 1.
    FIN-DUM.

    DUM divisor >= 1 PERFICE
        p = COMPONE_TRANSCRIBE(codex, p, 0, 12).
        p = COMPONE_XOR(codex, p, 2, 2).
        p = COMPONE_ONERA(codex, p, 3, divisor).
        p = COMPONE_DIV(codex, p, 3).
        p = COMPONE_XOR(codex, p, 2, 2).
        p = COMPONE_ONERA(codex, p, 3, 10).
        p = COMPONE_DIV(codex, p, 3).
        p = COMPONE_TRANSCRIBE(codex, p, 0, 2).
        p = COMPONE_ONERA(codex, p, 3, 48).
        p = COMPONE_ADD(codex, p, 0, 3).
        p = COMPONE_SERVA_PILA(codex, p, intervallum_scratch, 0).
        p = COMPONE_LEA_PILA(codex, p, 6, intervallum_scratch).
        p = COMPONE_SCRIBE_STDOUT_DYNAMICA(codex, p, contextus_parseris, 1).
        divisor = divisor / 10.
    FIN-DUM.
    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_IMPRIME_FLUITANIS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT intervallum_scratch SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.

    p = COMPONE_ONERA(codex, p, 3, 0).
    p = COMPONE_CMP(codex, p, 0, 3).
    DECLARA loci_flot_pos SICUT NUMERUS VALENS 0.
    p = COMPONE_JGE_FUTURUM(codex, p, SEDES(loci_flot_pos)).
    p = COMPONE_ONERA(codex, p, 3, 9223372036854775807).
    p = COMPONE_AND(codex, p, 0, 3).
    p = COMPONE_IMPONE(codex, p, 0).
    p = COMPONE_IMPRIME_CHAR(codex, p, intervallum_scratch, 45).
    p = COMPONE_AUFER(codex, p, 0).
    DECLARA pos_post_flot_sign SICUT NUMERUS VALENS p.
    DECLARA ig_fps SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_flot_pos, pos_post_flot_sign).

    p = COMPONE_MOVQ_A_XMM(codex, p, 0, 0).
    p = COMPONE_CVTTSD2SI(codex, p, 0, 0).
    p = COMPONE_IMPONE(codex, p, 0).
    p = COMPONE_IMPRIME_NUMERUS(codex, p, intervallum_scratch).
    p = COMPONE_IMPRIME_CHAR(codex, p, intervallum_scratch, 46).
    p = COMPONE_AUFER(codex, p, 0).

    p = COMPONE_CVTSI2SD(codex, p, 1, 0).
    p = COMPONE_SUBSD(codex, p, 0, 1).
    p = COMPONE_MOVSD_SALVA(codex, p, intervallum_scratch, 0).
    p = COMPONE_NUMERUM_FLUITANIS(codex, p, CALCULA_NUMERUM_FLUITANIS(1000000, 0, 1)).
    p = COMPONE_MOVSD_REG(codex, p, 1, 0).
    p = COMPONE_MOVSD_CARGA(codex, p, 0, intervallum_scratch).
    p = COMPONE_MULSD(codex, p, 0, 1).
    p = COMPONE_CVTTSD2SI(codex, p, 0, 0).
    p = COMPONE_IMPRIME_PADEADO(codex, p, intervallum_scratch, 6).

    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_COMPARA_FLUITANIS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.
    p = COMPONE_MOVQ_A_XMM(codex, p, 0, 0).
    p = COMPONE_MOVQ_A_XMM(codex, p, 1, 3).
    p = COMPONE_UCOMISD(codex, p, 0, 1).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO PROSPICE_LITTERALEM_FLUITANIS REDDENS NUMERUS.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    DECLARA scrut SICUT NUMERUS VALENS pos.
    DUM scrut < n && fons[scrut] >= 48 && fons[scrut] <= 57 PERFICE
        scrut = scrut + 1.
    FIN-DUM.
    DECLARA resultatum SICUT NUMERUS VALENS 0.
    SI scrut < n && fons[scrut] == 46 && scrut + 1 < n && fons[scrut+1] >= 48 && fons[scrut+1] <= 57 TUNC
        resultatum = 1.
    FIN-SI.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO PROSPICE_EST_FLUITANS REDDENS NUMERUS.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT descriptor_formarum SICUT ACUS<NUMERUS>.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.
    DECLARA resultatum SICUT NUMERUS VALENS 0.
    SI pos < n && fons[pos] == 34 TUNC
        REDDE 2.
    FIN-SI.
    SI pos < n && fons[pos] >= 97 && fons[pos] <= 122 TUNC
        DECLARA nomen_peek SICUT NUMERUS VALENS SIGNUM_AB_POSITIONE(fons, pos, n).
        resultatum = EST_FLUITANS_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_peek).
        SI resultatum == 0 TUNC
            DECLARA pos_apres_champ SICUT NUMERUS VALENS pos.
            DUM pos_apres_champ < n && ((fons[pos_apres_champ] >= 97 && fons[pos_apres_champ] <= 122) || (fons[pos_apres_champ] >= 48 && fons[pos_apres_champ] <= 57) || fons[pos_apres_champ] == 95) PERFICE
                pos_apres_champ = pos_apres_champ + 1.
            FIN-DUM.
            DUM pos_apres_champ < n && fons[pos_apres_champ] == 32 PERFICE
                pos_apres_champ = pos_apres_champ + 1.
            FIN-DUM.
            SI pos_apres_champ + 2 < n && fons[pos_apres_champ] == 68 && fons[pos_apres_champ+1] == 69 && fons[pos_apres_champ+2] == 32 TUNC
                DECLARA pos_var_struct SICUT NUMERUS VALENS pos_apres_champ + 3.
                DUM pos_var_struct < n && fons[pos_var_struct] == 32 PERFICE
                    pos_var_struct = pos_var_struct + 1.
                FIN-DUM.
                SI pos_var_struct < n && fons[pos_var_struct] >= 97 && fons[pos_var_struct] <= 122 TUNC
                    DECLARA nomen_var_struct SICUT NUMERUS VALENS SIGNUM_AB_POSITIONE(fons, pos_var_struct, n).
                    DECLARA idx_struct_peek SICUT NUMERUS VALENS STRUCTURA_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_var_struct).
                    SI idx_struct_peek > 0 TUNC
                        resultatum = CAMPUS_STRUCTURAE_EST_FLUITANS(descriptor_formarum, idx_struct_peek - 1, nomen_peek).
                    FIN-SI.
                FIN-SI.
            FIN-SI.
        FIN-SI.
    ALITER
        SI pos < n && fons[pos] >= 48 && fons[pos] <= 57 && PROSPICE_LITTERALEM_FLUITANIS(fons, pos, n) == 1 TUNC
            resultatum = 1.
        FIN-SI.
    FIN-SI.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO ANALYSA_TERMINUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos_codicis SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.

    DECLARA es_flot_term SICUT NUMERUS VALENS PROSPICE_EST_FLUITANS(fons, CONTENTUM(pos_fontis), n, DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), contextus_parseris).
    DECLARA ignoratum SICUT NUMERUS VALENS ANALYSA_FACTOR(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).

    ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    DUM CONTENTUM(pos_fontis) < n && (fons[CONTENTUM(pos_fontis)] == 42 || fons[CONTENTUM(pos_fontis)] == 37 || fons[CONTENTUM(pos_fontis)] == 47) PERFICE
        DECLARA operatio_term SICUT NUMERUS VALENS fons[CONTENTUM(pos_fontis)].
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
        ignoratum = ANALYSA_FACTOR(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
        CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
        CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
        SI es_flot_term == 1 TUNC
            CONTENTUM(pos_codicis) = APPLICA_OPERATOR_FLUITANIS(codex, CONTENTUM(pos_codicis), operatio_term).
        ALITER
        SI operatio_term == 42 TUNC
            CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 0, 3).
        ALITER
        SI operatio_term == 47 TUNC
            CONTENTUM(pos_codicis) = COMPONE_CQO(codex, CONTENTUM(pos_codicis)).
            CONTENTUM(pos_codicis) = COMPONE_DIV(codex, CONTENTUM(pos_codicis), 3).
        ALITER
            CONTENTUM(pos_codicis) = COMPONE_CQO(codex, CONTENTUM(pos_codicis)).
            CONTENTUM(pos_codicis) = COMPONE_DIV(codex, CONTENTUM(pos_codicis), 3).
            CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 0, 2).
        FIN-SI.
        FIN-SI.
        FIN-SI.
        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO INITIA_FORMAS_DYNAMICA REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    DECLARA limen_formarum SICUT NUMERUS VALENS 16.
    DECLARA basis_formarum SICUT NUMERUS VALENS RESERVA_OCTETA(limen_formarum * 40).
    SI basis_formarum < 0 TUNC
        REDDE 71.
    FIN-SI.
    CONTENTUM(descriptor) = basis_formarum.
    CONTENTUM(descriptor + 8) = limen_formarum.
    CONTENTUM(descriptor + 16) = 0.
    CONTENTUM(descriptor + 24) = 0 - 1.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ASSECURA_FORMAS_DYNAMICA REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT necessaria SICUT NUMERUS.
    DECLARA limen_formarum SICUT NUMERUS VALENS CONTENTUM(descriptor + 8).
    SI necessaria <= limen_formarum TUNC
        REDDE 0.
    FIN-SI.
    DECLARA novum_limen SICUT NUMERUS VALENS limen_formarum * 2.
    DUM novum_limen < necessaria PERFICE
        novum_limen = novum_limen * 2.
    FIN-DUM.
    DECLARA nova_basis SICUT NUMERUS VALENS RESERVA_OCTETA(novum_limen * 40).
    SI nova_basis < 0 TUNC
        REDDE 71.
    FIN-SI.
    DECLARA basis_formarum SICUT NUMERUS VALENS CONTENTUM(descriptor).
    DECLARA octeta SICUT NUMERUS VALENS CONTENTUM(descriptor + 16) * 40.
    DECLARA i_formarum SICUT NUMERUS VALENS 0.
    DUM i_formarum < octeta PERFICE
        SCRIBE_OCTETUM_AB(nova_basis + i_formarum, OCTETUS_AB(basis_formarum + i_formarum)).
        i_formarum = i_formarum + 1.
    FIN-DUM.
    CONTENTUM(descriptor) = nova_basis.
    CONTENTUM(descriptor + 8) = novum_limen.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FORMARUM_QUANTITAS REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    REDDE CONTENTUM(descriptor + 16).
FIN-FUNCTIO.

FUNCTIO FORMA_ULTIMA_LEGE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    REDDE CONTENTUM(descriptor + 24).
FIN-FUNCTIO.

FUNCTIO FORMA_ULTIMA_SCRIBE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT valor SICUT NUMERUS.
    CONTENTUM(descriptor + 24) = valor.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FORMA_LEGE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_formae SICUT NUMERUS.
    ACCIPIT campus_formae SICUT NUMERUS.
    SI idx_formae < 0 || idx_formae >= CONTENTUM(descriptor + 16) TUNC
        REDDE 0.
    FIN-SI.
    DECLARA sedes_formae SICUT NUMERUS VALENS CONTENTUM(descriptor) + (idx_formae * 40) + (campus_formae * 8).
    REDDE CONTENTUM(sedes_formae).
FIN-FUNCTIO.

FUNCTIO FORMA_SCRIBE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_formae SICUT NUMERUS.
    ACCIPIT campus_formae SICUT NUMERUS.
    ACCIPIT valor_formae SICUT NUMERUS.
    DECLARA status_formae SICUT NUMERUS VALENS ASSECURA_FORMAS_DYNAMICA(descriptor, idx_formae + 1).
    SI status_formae != 0 TUNC
        REDDE status_formae.
    FIN-SI.
    DECLARA basis_formarum SICUT NUMERUS VALENS CONTENTUM(descriptor).
    SI idx_formae >= CONTENTUM(descriptor + 16) TUNC
        DECLARA z_formae SICUT NUMERUS VALENS 0.
        DUM z_formae < 40 PERFICE
            SCRIBE_OCTETUM_AB(basis_formarum + (idx_formae * 40) + z_formae, 0).
            z_formae = z_formae + 1.
        FIN-DUM.
    FIN-SI.
    DECLARA sedes_formae SICUT NUMERUS VALENS basis_formarum + (idx_formae * 40) + (campus_formae * 8).
    CONTENTUM(sedes_formae) = valor_formae.
    SI idx_formae >= CONTENTUM(descriptor + 16) TUNC
        CONTENTUM(descriptor + 16) = idx_formae + 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO INITIA_CAMPI_FORMA REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_formae SICUT NUMERUS.
    ACCIPIT limen_init SICUT NUMERUS.
    DECLARA basis_camporum SICUT NUMERUS VALENS RESERVA_OCTETA(limen_init * 32).
    SI basis_camporum < 0 TUNC
        REDDE 71.
    FIN-SI.
    DECLARA status_campi SICUT NUMERUS VALENS FORMA_SCRIBE(descriptor, idx_formae, 2, 0).
    SI status_campi == 0 TUNC
        status_campi = FORMA_SCRIBE(descriptor, idx_formae, 3, limen_init).
    FIN-SI.
    SI status_campi == 0 TUNC
        status_campi = FORMA_SCRIBE(descriptor, idx_formae, 4, basis_camporum).
    FIN-SI.
    REDDE status_campi.
FIN-FUNCTIO.

FUNCTIO ASSECURA_CAMPI_FORMA REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_formae SICUT NUMERUS.
    ACCIPIT necessaria SICUT NUMERUS.
    DECLARA limen_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_formae, 3).
    SI necessaria <= limen_camporum TUNC
        REDDE 0.
    FIN-SI.
    DECLARA novum_limen SICUT NUMERUS VALENS limen_camporum * 2.
    SI novum_limen < 1 TUNC
        novum_limen = 8.
    FIN-SI.
    DUM novum_limen < necessaria PERFICE
        novum_limen = novum_limen * 2.
    FIN-DUM.
    DECLARA nova_basis SICUT NUMERUS VALENS RESERVA_OCTETA(novum_limen * 32).
    SI nova_basis < 0 TUNC
        REDDE 71.
    FIN-SI.
    DECLARA basis_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_formae, 4).
    DECLARA octeta SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_formae, 2) * 32.
    DECLARA i_camporum SICUT NUMERUS VALENS 0.
    DUM i_camporum < octeta PERFICE
        SCRIBE_OCTETUM_AB(nova_basis + i_camporum, OCTETUS_AB(basis_camporum + i_camporum)).
        i_camporum = i_camporum + 1.
    FIN-DUM.
    DECLARA status_campi SICUT NUMERUS VALENS FORMA_SCRIBE(descriptor, idx_formae, 3, novum_limen).
    SI status_campi == 0 TUNC
        status_campi = FORMA_SCRIBE(descriptor, idx_formae, 4, nova_basis).
    FIN-SI.
    REDDE status_campi.
FIN-FUNCTIO.

FUNCTIO CAMPUS_FORMA_LEGE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_formae SICUT NUMERUS.
    ACCIPIT idx_campi SICUT NUMERUS.
    ACCIPIT campus_campi SICUT NUMERUS.
    SI idx_campi < 0 || idx_campi >= FORMA_LEGE(descriptor, idx_formae, 2) TUNC
        REDDE 0.
    FIN-SI.
    DECLARA basis_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_formae, 4).
    DECLARA sedes_campi SICUT NUMERUS VALENS basis_camporum + (idx_campi * 32) + (campus_campi * 8).
    REDDE CONTENTUM(sedes_campi).
FIN-FUNCTIO.

FUNCTIO CAMPUS_FORMA_SCRIBE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_formae SICUT NUMERUS.
    ACCIPIT idx_campi SICUT NUMERUS.
    ACCIPIT campus_campi SICUT NUMERUS.
    ACCIPIT valor_campi SICUT NUMERUS.
    DECLARA status_campi SICUT NUMERUS VALENS ASSECURA_CAMPI_FORMA(descriptor, idx_formae, idx_campi + 1).
    SI status_campi != 0 TUNC
        REDDE status_campi.
    FIN-SI.
    DECLARA basis_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_formae, 4).
    DECLARA quantitas_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_formae, 2).
    SI idx_campi >= quantitas_camporum TUNC
        DECLARA z_campi SICUT NUMERUS VALENS 0.
        DUM z_campi < 32 PERFICE
            SCRIBE_OCTETUM_AB(basis_camporum + (idx_campi * 32) + z_campi, 0).
            z_campi = z_campi + 1.
        FIN-DUM.
    FIN-SI.
    DECLARA sedes_campi SICUT NUMERUS VALENS basis_camporum + (idx_campi * 32) + (campus_campi * 8).
    CONTENTUM(sedes_campi) = valor_campi.
    SI idx_campi >= quantitas_camporum TUNC
        status_campi = FORMA_SCRIBE(descriptor, idx_formae, 2, idx_campi + 1).
    FIN-SI.
    REDDE status_campi.
FIN-FUNCTIO.

FUNCTIO INDEX_CAMPUS_ULTIMAE_FORMAE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT nomen_campus SICUT NUMERUS.
    DECLARA idx_formae SICUT NUMERUS VALENS FORMA_ULTIMA_LEGE(descriptor).
    SI idx_formae < 0 TUNC
        REDDE 0.
    FIN-SI.
    DECLARA quantitas_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_formae, 2).
    DECLARA idx_campi SICUT NUMERUS VALENS 0.
    DECLARA resultatum SICUT NUMERUS VALENS quantitas_camporum.
    DUM idx_campi < quantitas_camporum PERFICE
        SI CAMPUS_FORMA_LEGE(descriptor, idx_formae, idx_campi, 0) == nomen_campus TUNC
            resultatum = idx_campi.
        FIN-SI.
        idx_campi = idx_campi + 1.
    FIN-DUM.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO INDEX_STRUCTURAE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT nomen_forma SICUT NUMERUS.
    DECLARA idx SICUT NUMERUS VALENS 0.
    DECLARA resultatum SICUT NUMERUS VALENS 0 - 1.
    DUM idx < FORMARUM_QUANTITAS(descriptor) PERFICE
        SI FORMA_LEGE(descriptor, idx, 0) == nomen_forma TUNC
            resultatum = idx.
        FIN-SI.
        idx = idx + 1.
    FIN-DUM.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO EST_FLUITANS_VARIABILIS REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT nomen SICUT NUMERUS.
    DECLARA idx SICUT NUMERUS VALENS 0.
    DECLARA resultatum SICUT NUMERUS VALENS 0.
    DUM idx < CONTENTUM(descriptor + 16) PERFICE
        SI LOCALE_LEGE(descriptor, idx, 0) == nomen TUNC
            resultatum = LOCALE_LEGE(descriptor, idx, 5).
        FIN-SI.
        idx = idx + 1.
    FIN-DUM.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO STRUCTURA_VARIABILIS REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT nomen SICUT NUMERUS.
    DECLARA idx SICUT NUMERUS VALENS 0.
    DECLARA resultatum SICUT NUMERUS VALENS 0.
    DUM idx < CONTENTUM(descriptor + 16) PERFICE
        SI LOCALE_LEGE(descriptor, idx, 0) == nomen TUNC
            resultatum = LOCALE_LEGE(descriptor, idx, 4).
        FIN-SI.
        idx = idx + 1.
    FIN-DUM.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO CAMPUS_STRUCTURAE_EST_FLUITANS REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_structurae SICUT NUMERUS.
    ACCIPIT nomen_campus SICUT NUMERUS.
    DECLARA k SICUT NUMERUS VALENS 0.
    DECLARA resultatum SICUT NUMERUS VALENS 0.
    DECLARA numerus_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_structurae, 2).
    DUM k < numerus_camporum PERFICE
        SI CAMPUS_FORMA_LEGE(descriptor, idx_structurae, k, 0) == nomen_campus TUNC
            resultatum = CAMPUS_FORMA_LEGE(descriptor, idx_structurae, k, 3).
        FIN-SI.
        k = k + 1.
    FIN-DUM.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO CAMPUS_STRUCTURAE_MAGNITUDO REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_structurae SICUT NUMERUS.
    ACCIPIT nomen_campus SICUT NUMERUS.
    DECLARA k SICUT NUMERUS VALENS 0.
    DECLARA resultatum SICUT NUMERUS VALENS 8.
    DECLARA numerus_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_structurae, 2).
    DUM k < numerus_camporum PERFICE
        SI CAMPUS_FORMA_LEGE(descriptor, idx_structurae, k, 0) == nomen_campus TUNC
            resultatum = CAMPUS_FORMA_LEGE(descriptor, idx_structurae, k, 1).
        FIN-SI.
        k = k + 1.
    FIN-DUM.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO CAMPUS_STRUCTURAE_OFFSET REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_structurae SICUT NUMERUS.
    ACCIPIT nomen_campus SICUT NUMERUS.
    DECLARA k SICUT NUMERUS VALENS 0.
    DECLARA resultatum SICUT NUMERUS VALENS 0.
    DECLARA numerus_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_structurae, 2).
    DUM k < numerus_camporum PERFICE
        SI CAMPUS_FORMA_LEGE(descriptor, idx_structurae, k, 0) == nomen_campus TUNC
            resultatum = CAMPUS_FORMA_LEGE(descriptor, idx_structurae, k, 2).
        FIN-SI.
        k = k + 1.
    FIN-DUM.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO SIGNUM_AB_POSITIONE REDDENS NUMERUS.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    DECLARA signum SICUT NUMERUS VALENS 0.
    DECLARA idx SICUT NUMERUS VALENS pos.
    DUM idx < n && ((fons[idx] >= 65 && fons[idx] <= 90) || (fons[idx] >= 97 && fons[idx] <= 122) || fons[idx] == 95 || (fons[idx] >= 48 && fons[idx] <= 57)) PERFICE
        signum = signum * 31 + fons[idx].
        idx = idx + 1.
    FIN-DUM.
    REDDE signum.
FIN-FUNCTIO.

FUNCTIO OFFSET_PTR_CAMPUS_STRUCTA REDDENS NUMERUS.
    ACCIPIT descriptor_formarum SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos SICUT NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT idx_campus_gen SICUT NUMERUS.
    ACCIPIT nomen_campus SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.
    DECLARA resultatum SICUT NUMERUS VALENS 0 - OFFSET_CUMULATIVUS_CAMPI(descriptor_formarum, idx_campus_gen).
    SI fons[pos] >= 97 && fons[pos] <= 122 TUNC
        DECLARA nomen_ptr SICUT NUMERUS VALENS SIGNUM_AB_POSITIONE(fons, pos, n).
        DECLARA idx_struct_ptr SICUT NUMERUS VALENS STRUCTURA_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_ptr).
        SI idx_struct_ptr > 0 TUNC
            resultatum = 0 - CAMPUS_STRUCTURAE_OFFSET(descriptor_formarum, idx_struct_ptr - 1, nomen_campus).
        FIN-SI.
    FIN-SI.
    REDDE resultatum.
FIN-FUNCTIO.

FUNCTIO INDEX_STRUCTURAE_INTERIOR_ACUS REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_post_acus SICUT NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    DECLARA nomen_int SICUT NUMERUS VALENS SIGNUM_AB_POSITIONE(fons, pos_post_acus, n).
    REDDE INDEX_STRUCTURAE(descriptor, nomen_int).
FIN-FUNCTIO.

FUNCTIO COMPONE_VERIFICA_TAS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.
    p = COMPONE_ONERA(codex, p, 2, 50331648).
    p = COMPONE_CMP(codex, p, 0, 2).
    DECLARA loci_tas_ok SICUT NUMERUS VALENS 0.
    p = COMPONE_JL_FUTURUM(codex, p, SEDES(loci_tas_ok)).
    p = COMPONE_ONERA(codex, p, 7, 137).
    p = COMPONE_ONERA(codex, p, 0, 60).
    p = COMPONE_VOCA_NUCLEUM(codex, p).
    DECLARA ig_vt SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_tas_ok, p).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO OFFSET_CUMULATIVUS_CAMPI REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT idx_campus SICUT NUMERUS.
    DECLARA idx_formae SICUT NUMERUS VALENS FORMA_ULTIMA_LEGE(descriptor).
    SI idx_formae < 0 TUNC
        REDDE 0.
    FIN-SI.
    DECLARA numerus_camporum SICUT NUMERUS VALENS FORMA_LEGE(descriptor, idx_formae, 2).
    SI idx_campus < numerus_camporum TUNC
        REDDE CAMPUS_FORMA_LEGE(descriptor, idx_formae, idx_campus, 2).
    FIN-SI.
    REDDE FORMA_LEGE(descriptor, idx_formae, 1) * 8.
FIN-FUNCTIO.

FUNCTIO MAGNITUDO_VARIABILIS REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT nomen SICUT NUMERUS.
    DECLARA idx SICUT NUMERUS VALENS 0.
    DECLARA magnitudo_inventa SICUT NUMERUS VALENS 0.
    DECLARA aliquid_inventum_mag SICUT NUMERUS VALENS 0.
    DUM idx < CONTENTUM(descriptor + 16) PERFICE
        SI LOCALE_LEGE(descriptor, idx, 0) == nomen TUNC
            magnitudo_inventa = LOCALE_LEGE(descriptor, idx, 3).
            aliquid_inventum_mag = 1.
        FIN-SI.
        idx = idx + 1.
    FIN-DUM.
    SI aliquid_inventum_mag == 1 TUNC
        REDDE magnitudo_inventa.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO NUMERUS_CAMPORUM_FORMAE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT nomen SICUT NUMERUS.
    DECLARA idx SICUT NUMERUS VALENS INDEX_STRUCTURAE(descriptor, nomen).
    SI idx >= 0 TUNC
        REDDE FORMA_LEGE(descriptor, idx, 1).
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ANALYSA_EXPRESSIO REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos_codicis SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.

    DECLARA magnitudo_sinistra SICUT NUMERUS VALENS 0.
    DECLARA es_flot_expr SICUT NUMERUS VALENS 0.
    DECLARA pos_ante_prospectum SICUT NUMERUS VALENS CONTENTUM(pos_fontis).
    SI fons[CONTENTUM(pos_fontis)] >= 97 && fons[CONTENTUM(pos_fontis)] <= 122 TUNC
        DECLARA nomen_prospectus SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, pos_fontis, n).
        magnitudo_sinistra = MAGNITUDO_VARIABILIS(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), nomen_prospectus).
        es_flot_expr = PROSPICE_EST_FLUITANS(fons, pos_ante_prospectum, n, DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), contextus_parseris).
        CONTENTUM(pos_fontis) = pos_ante_prospectum.
    ALITER
        es_flot_expr = PROSPICE_EST_FLUITANS(fons, CONTENTUM(pos_fontis), n, DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), contextus_parseris).
    FIN-SI.

    DECLARA ignoratum SICUT NUMERUS VALENS ANALYSA_TERMINUM(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).

    ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    DUM CONTENTUM(pos_fontis) < n && (fons[CONTENTUM(pos_fontis)] == 43 || fons[CONTENTUM(pos_fontis)] == 45 || (fons[CONTENTUM(pos_fontis)] == 38 && (CONTENTUM(pos_fontis)+1 >= n || fons[CONTENTUM(pos_fontis)+1] != 38)) || (fons[CONTENTUM(pos_fontis)] == 124 && (CONTENTUM(pos_fontis)+1 >= n || fons[CONTENTUM(pos_fontis)+1] != 124))) PERFICE
        DECLARA operatio SICUT NUMERUS VALENS fons[CONTENTUM(pos_fontis)].
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
        ignoratum = ANALYSA_TERMINUM(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
        CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
        CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
        SI es_flot_expr == 2 && operatio == 43 TUNC
            CONTENTUM(pos_codicis) = COMPONE_CONCATENA_TEXTUS(codex, CONTENTUM(pos_codicis)).
        ALITER
        SI es_flot_expr == 1 && (operatio == 43 || operatio == 45) TUNC
            CONTENTUM(pos_codicis) = APPLICA_OPERATOR_FLUITANIS(codex, CONTENTUM(pos_codicis), operatio).
        ALITER
        SI (operatio == 43 || operatio == 45) && magnitudo_sinistra > 1 TUNC
            CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 2, magnitudo_sinistra).
            CONTENTUM(pos_codicis) = COMPONE_MULTIPLICA(codex, CONTENTUM(pos_codicis), 3, 2).
        FIN-SI.
        SI es_flot_expr == 0 TUNC
        SI operatio == 43 TUNC
            CONTENTUM(pos_codicis) = COMPONE_ADD(codex, CONTENTUM(pos_codicis), 0, 3).
        FIN-SI.
        SI operatio == 45 TUNC
            CONTENTUM(pos_codicis) = COMPONE_SUB(codex, CONTENTUM(pos_codicis), 0, 3).
        FIN-SI.
        SI operatio == 38 TUNC
            CONTENTUM(pos_codicis) = COMPONE_AND(codex, CONTENTUM(pos_codicis), 0, 3).
        FIN-SI.
        SI operatio == 124 TUNC
            CONTENTUM(pos_codicis) = COMPONE_OR(codex, CONTENTUM(pos_codicis), 0, 3).
        FIN-SI.
        FIN-SI.
        FIN-SI.
        FIN-SI.
        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ANALYSA_COMPARATIO REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos_codicis SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.

    DECLARA es_flot_cmp SICUT NUMERUS VALENS PROSPICE_EST_FLUITANS(fons, CONTENTUM(pos_fontis), n, DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), contextus_parseris).
    DECLARA ignoratum SICUT NUMERUS VALENS ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
    ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).

    DECLARA op_cmp SICUT NUMERUS VALENS 0.
    SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 61 && fons[CONTENTUM(pos_fontis)+1] == 61 TUNC
        op_cmp = 1.
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
    ALITER
        SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 33 && fons[CONTENTUM(pos_fontis)+1] == 61 TUNC
            op_cmp = 2.
            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
        ALITER
            SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 62 && fons[CONTENTUM(pos_fontis)+1] == 61 TUNC
                op_cmp = 3.
                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
            ALITER
                SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 62 && fons[CONTENTUM(pos_fontis)+1] == 62 TUNC
                    op_cmp = 8.
                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
                ALITER
                SI CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] == 62 TUNC
                    op_cmp = 4.
                    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                ALITER
                    SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 60 && fons[CONTENTUM(pos_fontis)+1] == 61 TUNC
                        op_cmp = 5.
                        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
                    ALITER
                        SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 60 && fons[CONTENTUM(pos_fontis)+1] == 60 TUNC
                            op_cmp = 7.
                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
                        ALITER
                        SI CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] == 60 TUNC
                            op_cmp = 6.
                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                        FIN-SI.
                        FIN-SI.
                    FIN-SI.
                FIN-SI.
                FIN-SI.
            FIN-SI.
        FIN-SI.
    FIN-SI.

    SI op_cmp == 7 || op_cmp == 8 TUNC
        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
        CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
        ignoratum = ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
        CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 1, 0).
        CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
        SI op_cmp == 7 TUNC
            CONTENTUM(pos_codicis) = COMPONE_SHL(codex, CONTENTUM(pos_codicis), 0).
        ALITER
            CONTENTUM(pos_codicis) = COMPONE_SHR(codex, CONTENTUM(pos_codicis), 0).
        FIN-SI.
        REDDE 0.
    FIN-SI.

    SI op_cmp == 0 TUNC
        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
        SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 38 && fons[CONTENTUM(pos_fontis)+1] == 38 TUNC
            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
            CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
            ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
            CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
            CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
            CONTENTUM(pos_codicis) = COMPONE_AND(codex, CONTENTUM(pos_codicis), 0, 3).
        FIN-SI.
        SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 124 && fons[CONTENTUM(pos_fontis)+1] == 124 TUNC
            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
            CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
            ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
            CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
            CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
            CONTENTUM(pos_codicis) = COMPONE_OR(codex, CONTENTUM(pos_codicis), 0, 3).
        FIN-SI.
        REDDE 0.
    FIN-SI.

    ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
    ignoratum = ANALYSA_EXPRESSIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
    CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
    CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
    SI es_flot_cmp == 2 TUNC
        CONTENTUM(pos_codicis) = COMPONE_COMPARA_TEXTUS(codex, CONTENTUM(pos_codicis)).
    ALITER
        SI es_flot_cmp == 1 TUNC
            CONTENTUM(pos_codicis) = COMPONE_COMPARA_FLUITANIS(codex, CONTENTUM(pos_codicis)).
        ALITER
            CONTENTUM(pos_codicis) = COMPONE_SUB(codex, CONTENTUM(pos_codicis), 0, 3).
        FIN-SI.
    FIN-SI.

    DECLARA loci_cmp SICUT NUMERUS VALENS 0.
    SI op_cmp == 1 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JNE_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.
    SI op_cmp == 2 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JE_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.
    SI op_cmp == 3 && es_flot_cmp != 1 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JL_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.
    SI op_cmp == 4 && es_flot_cmp != 1 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JLE_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.
    SI op_cmp == 5 && es_flot_cmp != 1 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JG_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.
    SI op_cmp == 6 && es_flot_cmp != 1 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JGE_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.
    SI op_cmp == 3 && es_flot_cmp == 1 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JB_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.
    SI op_cmp == 4 && es_flot_cmp == 1 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JBE_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.
    SI op_cmp == 5 && es_flot_cmp == 1 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JA_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.
    SI op_cmp == 6 && es_flot_cmp == 1 TUNC
        CONTENTUM(pos_codicis) = COMPONE_JAE_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_cmp)).
    FIN-SI.

    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 0, 1).
    DECLARA loci_jmp_cmp SICUT NUMERUS VALENS 0.
    CONTENTUM(pos_codicis) = COMPONE_JMP_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_jmp_cmp)).
    DECLARA pos_falsus_cmp SICUT NUMERUS VALENS CONTENTUM(pos_codicis).
    ignoratum = CORRIGE_SALTUM(codex, loci_cmp, pos_falsus_cmp).
    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 0, 0).
    DECLARA pos_fin_cmp SICUT NUMERUS VALENS CONTENTUM(pos_codicis).
    ignoratum = CORRIGE_SALTUM(codex, loci_jmp_cmp, pos_fin_cmp).

    ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
    SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 38 && fons[CONTENTUM(pos_fontis)+1] == 38 TUNC
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
        CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
        ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
        CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
        CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
        CONTENTUM(pos_codicis) = COMPONE_AND(codex, CONTENTUM(pos_codicis), 0, 3).
    FIN-SI.
    SI CONTENTUM(pos_fontis) + 1 < n && fons[CONTENTUM(pos_fontis)] == 124 && fons[CONTENTUM(pos_fontis)+1] == 124 TUNC
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 2.
        CONTENTUM(pos_codicis) = COMPONE_IMPONE(codex, CONTENTUM(pos_codicis), 0).
        ignoratum = ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
        CONTENTUM(pos_codicis) = COMPONE_TRANSCRIBE(codex, CONTENTUM(pos_codicis), 3, 0).
        CONTENTUM(pos_codicis) = COMPONE_AUFER(codex, CONTENTUM(pos_codicis), 0).
        CONTENTUM(pos_codicis) = COMPONE_OR(codex, CONTENTUM(pos_codicis), 0, 3).
    FIN-SI.

    REDDE 0.
FIN-FUNCTIO.

FUNCTIO INITIA_PARES_DYNAMICA REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT limen_init SICUT NUMERUS.
    DECLARA basis_parium SICUT NUMERUS VALENS RESERVA_OCTETA(limen_init * 16).
    SI basis_parium < 0 TUNC
        REDDE 71.
    FIN-SI.
    CONTENTUM(descriptor) = basis_parium.
    CONTENTUM(descriptor + 8) = limen_init.
    CONTENTUM(descriptor + 16) = 0.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ASSECURA_PARES_DYNAMICA REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT necessaria SICUT NUMERUS.
    DECLARA limen_parium SICUT NUMERUS VALENS CONTENTUM(descriptor + 8).
    SI necessaria <= limen_parium TUNC
        REDDE 0.
    FIN-SI.
    DECLARA novum_limen_parium SICUT NUMERUS VALENS limen_parium * 2.
    DUM novum_limen_parium < necessaria PERFICE
        novum_limen_parium = novum_limen_parium * 2.
    FIN-DUM.
    DECLARA nova_basis_parium SICUT NUMERUS VALENS RESERVA_OCTETA(novum_limen_parium * 16).
    SI nova_basis_parium < 0 TUNC
        REDDE 71.
    FIN-SI.
    DECLARA basis_parium SICUT NUMERUS VALENS CONTENTUM(descriptor).
    DECLARA quantitas_parium SICUT NUMERUS VALENS CONTENTUM(descriptor + 16).
    DECLARA octeta_parium SICUT NUMERUS VALENS quantitas_parium * 16.
    DECLARA i_parium SICUT NUMERUS VALENS 0.
    DUM i_parium < octeta_parium PERFICE
        SCRIBE_OCTETUM_AB(nova_basis_parium + i_parium, OCTETUS_AB(basis_parium + i_parium)).
        i_parium = i_parium + 1.
    FIN-DUM.
    CONTENTUM(descriptor) = nova_basis_parium.
    CONTENTUM(descriptor + 8) = novum_limen_parium.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PARES_QUANTITAS REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    REDDE CONTENTUM(descriptor + 16).
FIN-FUNCTIO.

FUNCTIO PARES_LEGE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT index_par SICUT NUMERUS.
    ACCIPIT pars_paris SICUT NUMERUS.
    SI index_par < 0 || index_par >= CONTENTUM(descriptor + 16) TUNC
        REDDE 0.
    FIN-SI.
    DECLARA sedes_paris SICUT NUMERUS VALENS CONTENTUM(descriptor) + (index_par * 16) + (pars_paris * 8).
    REDDE CONTENTUM(sedes_paris).
FIN-FUNCTIO.

FUNCTIO PARES_SCRIBE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT index_par SICUT NUMERUS.
    ACCIPIT pars_paris SICUT NUMERUS.
    ACCIPIT valor_paris SICUT NUMERUS.
    DECLARA status_parium SICUT NUMERUS VALENS ASSECURA_PARES_DYNAMICA(descriptor, index_par + 1).
    SI status_parium != 0 TUNC
        REDDE status_parium.
    FIN-SI.
    DECLARA basis_parium SICUT NUMERUS VALENS CONTENTUM(descriptor).
    SI pars_paris == 0 && index_par >= CONTENTUM(descriptor + 16) TUNC
        DECLARA z_paris SICUT NUMERUS VALENS 0.
        DUM z_paris < 16 PERFICE
            SCRIBE_OCTETUM_AB(basis_parium + (index_par * 16) + z_paris, 0).
            z_paris = z_paris + 1.
        FIN-DUM.
    FIN-SI.
    DECLARA sedes_paris SICUT NUMERUS VALENS basis_parium + (index_par * 16) + (pars_paris * 8).
    CONTENTUM(sedes_paris) = valor_paris.
    SI index_par >= CONTENTUM(descriptor + 16) TUNC
        CONTENTUM(descriptor + 16) = index_par + 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO CERCA_FUNCTIONEM_DYNAMICAM REDDENS NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.
    ACCIPIT nomen_fn_dyn SICUT NUMERUS.
    DECLARA descriptor SICUT NUMERUS VALENS DESCRIPTOR_FUNCTIONUM_LEGE(contextus_parseris).
    DECLARA idx_fn_dyn SICUT NUMERUS VALENS 0.
    DECLARA locus_fn_dyn SICUT NUMERUS VALENS 0.
    DUM idx_fn_dyn < PARES_QUANTITAS(descriptor) PERFICE
        SI PARES_LEGE(descriptor, idx_fn_dyn, 0) == nomen_fn_dyn TUNC
            locus_fn_dyn = PARES_LEGE(descriptor, idx_fn_dyn, 1).
        FIN-SI.
        idx_fn_dyn = idx_fn_dyn + 1.
    FIN-DUM.
    REDDE locus_fn_dyn.
FIN-FUNCTIO.

FUNCTIO INITIA_LOCA_DYNAMICA REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    DECLARA limen_locorum SICUT NUMERUS VALENS 64.
    DECLARA basis SICUT NUMERUS VALENS RESERVA_OCTETA(limen_locorum * 48).
    SI basis < 0 TUNC
        REDDE 71.
    FIN-SI.
    CONTENTUM(descriptor) = basis.
    CONTENTUM(descriptor + 8) = limen_locorum.
    CONTENTUM(descriptor + 16) = 0.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ASSECURA_LOCA_DYNAMICA REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT necessaria SICUT NUMERUS.
    DECLARA limen_locorum SICUT NUMERUS VALENS CONTENTUM(descriptor + 8).
    SI necessaria <= limen_locorum TUNC
        REDDE 0.
    FIN-SI.
    DECLARA nova_capacitas SICUT NUMERUS VALENS limen_locorum * 2.
    DUM nova_capacitas < necessaria PERFICE
        nova_capacitas = nova_capacitas * 2.
    FIN-DUM.
    DECLARA nova_basis SICUT NUMERUS VALENS RESERVA_OCTETA(nova_capacitas * 48).
    SI nova_basis < 0 TUNC
        REDDE 71.
    FIN-SI.
    DECLARA basis SICUT NUMERUS VALENS CONTENTUM(descriptor).
    DECLARA numerus_locorum SICUT NUMERUS VALENS CONTENTUM(descriptor + 16).
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA octeta SICUT NUMERUS VALENS numerus_locorum * 48.
    DUM i < octeta PERFICE
        SCRIBE_OCTETUM_AB(nova_basis + i, OCTETUS_AB(basis + i)).
        i = i + 1.
    FIN-DUM.
    CONTENTUM(descriptor) = nova_basis.
    CONTENTUM(descriptor + 8) = nova_capacitas.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO LOCALE_LEGE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT index SICUT NUMERUS.
    ACCIPIT campus_localis SICUT NUMERUS.
    SI index < 0 || index >= CONTENTUM(descriptor + 16) TUNC
        REDDE 0.
    FIN-SI.
    DECLARA sedes_localis SICUT NUMERUS VALENS CONTENTUM(descriptor) + (index * 48) + (campus_localis * 8).
    REDDE CONTENTUM(sedes_localis).
FIN-FUNCTIO.

FUNCTIO LOCALE_SCRIBE REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    ACCIPIT index SICUT NUMERUS.
    ACCIPIT campus_localis SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    DECLARA status SICUT NUMERUS VALENS ASSECURA_LOCA_DYNAMICA(descriptor, index + 1).
    SI status != 0 TUNC
        REDDE status.
    FIN-SI.
    DECLARA basis SICUT NUMERUS VALENS CONTENTUM(descriptor).
    SI campus_localis == 0 && index >= CONTENTUM(descriptor + 16) TUNC
        DECLARA z SICUT NUMERUS VALENS 0.
        DUM z < 48 PERFICE
            SCRIBE_OCTETUM_AB(basis + (index * 48) + z, 0).
            z = z + 1.
        FIN-DUM.
    FIN-SI.
    DECLARA sedes_localis SICUT NUMERUS VALENS basis + (index * 48) + (campus_localis * 8).
    CONTENTUM(sedes_localis) = valor.
    SI index >= CONTENTUM(descriptor + 16) TUNC
        CONTENTUM(descriptor + 16) = index + 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO RESTITUE_LOCA_DYNAMICA REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    CONTENTUM(descriptor + 16) = 0.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PROXIMUS_LOCUS_LIBER REDDENS NUMERUS.
    ACCIPIT descriptor SICUT ACUS<NUMERUS>.
    REDDE CONTENTUM(descriptor + 16).
FIN-FUNCTIO.

FUNCTIO COMPONE_CONCATENA_TEXTUS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.
    p = COMPONE_TRANSCRIBE(codex, p, 7, 0).
    p = COMPONE_TRANSCRIBE(codex, p, 6, 3).
    p = COMPONE_SUME_INDIRECTUM(codex, p, 8, 7).
    p = COMPONE_SUME_INDIRECTUM(codex, p, 9, 6).
    p = COMPONE_TRANSCRIBE(codex, p, 10, 8).
    p = COMPONE_ADD(codex, p, 10, 9).
    p = COMPONE_TRANSCRIBE(codex, p, 2, 10).
    p = COMPONE_ONERA(codex, p, 1, 17).
    p = COMPONE_ADD(codex, p, 2, 1).
    p = COMPONE_ONERA(codex, p, 1, 33554432).
    p = COMPONE_SUME_INDIRECTUM(codex, p, 0, 1).
    p = COMPONE_SERVA_INDIRECTUM(codex, p, 0, 2).
    p = COMPONE_TRANSCRIBE(codex, p, 3, 0).
    p = COMPONE_ONERA(codex, p, 1, 8).
    p = COMPONE_ADD(codex, p, 0, 1).
    p = COMPONE_IMPONE(codex, p, 0).
    p = COMPONE_TRANSCRIBE(codex, p, 0, 3).
    p = COMPONE_ONERA(codex, p, 1, 8).
    p = COMPONE_ADD(codex, p, 0, 1).
    p = COMPONE_ADD(codex, p, 0, 2).
    p = COMPONE_VERIFICA_TAS(codex, p).
    p = COMPONE_ONERA(codex, p, 1, 33554432).
    p = COMPONE_SERVA_INDIRECTUM(codex, p, 1, 0).
    p = COMPONE_AUFER(codex, p, 0).
    p = COMPONE_TRANSCRIBE(codex, p, 11, 0).
    p = COMPONE_SERVA_INDIRECTUM(codex, p, 11, 10).
    p = COMPONE_TRANSCRIBE(codex, p, 3, 11).
    p = COMPONE_ONERA(codex, p, 1, 8).
    p = COMPONE_ADD(codex, p, 3, 1).
    p = COMPONE_SERVA_INDIRECTUM(codex, p, 3, 10).
    p = COMPONE_ADD(codex, p, 3, 1).
    p = COMPONE_ONERA(codex, p, 1, 16).
    p = COMPONE_ADD(codex, p, 7, 1).
    p = COMPONE_ADD(codex, p, 6, 1).
    DECLARA a SICUT NUMERUS VALENS p.
    p = COMPONE_ONERA(codex, p, 2, 0).
    p = COMPONE_CMP(codex, p, 8, 2).
    DECLARA b SICUT NUMERUS VALENS 0.
    p = COMPONE_JE_FUTURUM(codex, p, SEDES(b)).
    p = COMPONE_MOVZX(codex, p, 0, 7).
    p = COMPONE_SERVA_OCTETUM(codex, p, 3, 0).
    p = COMPONE_ONERA(codex, p, 2, 1).
    p = COMPONE_ADD(codex, p, 7, 2).
    p = COMPONE_ADD(codex, p, 3, 2).
    p = COMPONE_SUB(codex, p, 8, 2).
    p = COMPONE_JMP_RETRO(codex, p, a).
    DECLARA c SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, b, p).
    DECLARA d SICUT NUMERUS VALENS p.
    p = COMPONE_ONERA(codex, p, 2, 0).
    p = COMPONE_CMP(codex, p, 9, 2).
    DECLARA e SICUT NUMERUS VALENS 0.
    p = COMPONE_JE_FUTURUM(codex, p, SEDES(e)).
    p = COMPONE_MOVZX(codex, p, 0, 6).
    p = COMPONE_SERVA_OCTETUM(codex, p, 3, 0).
    p = COMPONE_ONERA(codex, p, 2, 1).
    p = COMPONE_ADD(codex, p, 6, 2).
    p = COMPONE_ADD(codex, p, 3, 2).
    p = COMPONE_SUB(codex, p, 9, 2).
    p = COMPONE_JMP_RETRO(codex, p, d).
    c = CORRIGE_SALTUM(codex, e, p).
    p = COMPONE_ONERA(codex, p, 0, 0).
    p = COMPONE_SERVA_OCTETUM(codex, p, 3, 0).
    p = COMPONE_TRANSCRIBE(codex, p, 0, 11).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_COMPARA_TEXTUS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    DECLARA p SICUT NUMERUS VALENS pos.
    DECLARA a SICUT NUMERUS VALENS 0.
    DECLARA b SICUT NUMERUS VALENS 0.
    DECLARA c SICUT NUMERUS VALENS 0.
    DECLARA d SICUT NUMERUS VALENS 0.
    p = COMPONE_TRANSCRIBE(codex, p, 7, 0).
    p = COMPONE_TRANSCRIBE(codex, p, 6, 3).
    p = COMPONE_SUME_INDIRECTUM(codex, p, 8, 7).
    p = COMPONE_SUME_INDIRECTUM(codex, p, 9, 6).
    p = COMPONE_ONERA(codex, p, 1, 16).
    p = COMPONE_ADD(codex, p, 7, 1).
    p = COMPONE_ADD(codex, p, 6, 1).
    DECLARA e SICUT NUMERUS VALENS p.
    p = COMPONE_ONERA(codex, p, 2, 0).
    p = COMPONE_CMP(codex, p, 8, 2).
    p = COMPONE_JE_FUTURUM(codex, p, SEDES(a)).
    p = COMPONE_CMP(codex, p, 9, 2).
    p = COMPONE_JE_FUTURUM(codex, p, SEDES(b)).
    p = COMPONE_MOVZX(codex, p, 0, 7).
    p = COMPONE_MOVZX(codex, p, 2, 6).
    p = COMPONE_CMP(codex, p, 0, 2).
    p = COMPONE_JNE_FUTURUM(codex, p, SEDES(c)).
    p = COMPONE_ONERA(codex, p, 2, 1).
    p = COMPONE_ADD(codex, p, 7, 2).
    p = COMPONE_ADD(codex, p, 6, 2).
    p = COMPONE_SUB(codex, p, 8, 2).
    p = COMPONE_SUB(codex, p, 9, 2).
    p = COMPONE_JMP_RETRO(codex, p, e).
    DECLARA f SICUT NUMERUS VALENS p.
    DECLARA g SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, a, f).
    g = CORRIGE_SALTUM(codex, b, f).
    p = COMPONE_TRANSCRIBE(codex, p, 0, 8).
    p = COMPONE_SUB(codex, p, 0, 9).
    p = COMPONE_JMP_FUTURUM(codex, p, SEDES(d)).
    g = CORRIGE_SALTUM(codex, c, p).
    p = COMPONE_SUB(codex, p, 0, 2).
    g = CORRIGE_SALTUM(codex, d, p).
    p = COMPONE_ONERA(codex, p, 2, 0).
    p = COMPONE_CMP(codex, p, 0, 2).
    REDDE p.
FIN-FUNCTIO.

FUNCTIO COMPONE_LITTERALE_TEXTUS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos_codicis SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    DECLARA loci_saltus_textus SICUT NUMERUS VALENS 0.
    DECLARA sedes_textus SICUT NUMERUS VALENS 0.
    DECLARA mensura_textus SICUT NUMERUS VALENS 0.
    DECLARA ign_textus SICUT NUMERUS VALENS 0.

    SI CONTENTUM(pos_fontis) >= n || fons[CONTENTUM(pos_fontis)] != 34 TUNC
        REDDE 1.
    FIN-SI.

    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
    CONTENTUM(pos_codicis) = COMPONE_JMP_FUTURUM(codex, CONTENTUM(pos_codicis), SEDES(loci_saltus_textus)).
    sedes_textus = CONTENTUM(pos_codicis).
    CONTENTUM(pos_codicis) = SCRIBE_U64(codex, CONTENTUM(pos_codicis), 0).
    CONTENTUM(pos_codicis) = SCRIBE_U64(codex, CONTENTUM(pos_codicis), 0).

    DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] != 34 PERFICE
        CODEX_SCRIBE(codex, CONTENTUM(pos_codicis), fons[CONTENTUM(pos_fontis)]).
        CONTENTUM(pos_codicis) = CONTENTUM(pos_codicis) + 1.
        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
        mensura_textus = mensura_textus + 1.
    FIN-DUM.

    SI CONTENTUM(pos_fontis) >= n TUNC
        REDDE 2.
    FIN-SI.

    CODEX_SCRIBE(codex, CONTENTUM(pos_codicis), 0).
    CONTENTUM(pos_codicis) = CONTENTUM(pos_codicis) + 1.
    CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.

    ign_textus = CORRIGE_PILA(codex, sedes_textus, mensura_textus).
    ign_textus = CORRIGE_PILA(codex, sedes_textus + 8, mensura_textus).
    ign_textus = CORRIGE_SALTUM(codex, loci_saltus_textus, CONTENTUM(pos_codicis)).
    CONTENTUM(pos_codicis) = COMPONE_ONERA(codex, CONTENTUM(pos_codicis), 0, 4194304 + sedes_textus).
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO COMPONE_IMPRIME_TEXTUS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos SICUT NUMERUS.
    DECLARA p_textus SICUT NUMERUS VALENS pos.
    p_textus = COMPONE_TRANSCRIBE(codex, p_textus, 3, 0).
    p_textus = COMPONE_SUME_INDIRECTUM(codex, p_textus, 2, 3).
    p_textus = COMPONE_TRANSCRIBE(codex, p_textus, 6, 3).
    p_textus = COMPONE_ONERA(codex, p_textus, 1, 16).
    p_textus = COMPONE_ADD(codex, p_textus, 6, 1).
    p_textus = COMPONE_ONERA(codex, p_textus, 0, 1).
    p_textus = COMPONE_ONERA(codex, p_textus, 7, 1).
    p_textus = COMPONE_VOCA_NUCLEUM(codex, p_textus).
    REDDE p_textus.
FIN-FUNCTIO.

FUNCTIO ANALYSA_BLOCUS REDDENS NUMERUS.
    ACCIPIT codex SICUT ACUS<NUMERUS>.
    ACCIPIT pos_codicis SICUT ACUS<NUMERUS>.
    ACCIPIT fons SICUT ACUS<LITTERA>.
    ACCIPIT pos_fontis SICUT ACUS<NUMERUS>.
    ACCIPIT n SICUT NUMERUS.
    ACCIPIT contextus_parseris SICUT ACUS<NUMERUS>.

    DECLARA continua SICUT NUMERUS VALENS 1.
    DUM continua == 1 PERFICE
        DECLARA ignoratum SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
        DECLARA i SICUT NUMERUS VALENS CONTENTUM(pos_fontis).

        SI i >= n TUNC
            continua = 0.
        ALITER
            SI fons[i] == 65 && i + 5 < n && fons[i+1] == 76 && fons[i+2] == 73 && fons[i+3] == 84 && fons[i+4] == 69 && fons[i+5] == 82 TUNC
                continua = 0.
            ALITER
                SI fons[i] == 70 && i + 3 < n && fons[i+1] == 73 && fons[i+2] == 78 && fons[i+3] == 45 TUNC
                    continua = 0.
                ALITER
                    SI fons[i] == 68 && i + 6 < n && fons[i+1] == 69 && fons[i+2] == 67 && fons[i+3] == 76 && fons[i+4] == 65 && fons[i+5] == 82 && fons[i+6] == 65 TUNC
                        CONTENTUM(pos_fontis) = i + 7.
                        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                        DECLARA nomen SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, pos_fontis, n).
                        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                        CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 6.
                        ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).

                        SI fons[CONTENTUM(pos_fontis)] == 79 && CONTENTUM(pos_fontis) + 3 < n && fons[CONTENTUM(pos_fontis)+1] == 82 && fons[CONTENTUM(pos_fontis)+2] == 68 && fons[CONTENTUM(pos_fontis)+3] == 79 TUNC
                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 5.
                            ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 3.
                            ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                            DECLARA es_arr_fluitans SICUT NUMERUS VALENS 0.
                            SI fons[CONTENTUM(pos_fontis)] == 70 && CONTENTUM(pos_fontis) + 7 < n && fons[CONTENTUM(pos_fontis)+1] == 76 && fons[CONTENTUM(pos_fontis)+2] == 85 && fons[CONTENTUM(pos_fontis)+3] == 73 && fons[CONTENTUM(pos_fontis)+4] == 84 && fons[CONTENTUM(pos_fontis)+5] == 65 && fons[CONTENTUM(pos_fontis)+6] == 78 && fons[CONTENTUM(pos_fontis)+7] == 83 TUNC
                                es_arr_fluitans = 1.
                            FIN-SI.
                            DECLARA nomen_typus_ordo SICUT NUMERUS VALENS EXTRAHE_ET_SIGNA(fons, pos_fontis, n).
                            ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).
                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 10.
                            ignoratum = IGNORA_SPATIA(fons, pos_fontis, n).

                            DECLARA numerus_campi_ordo SICUT NUMERUS VALENS NUMERUS_CAMPORUM_FORMAE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), nomen_typus_ordo).
                            DECLARA magnitudo_elem_ordo SICUT NUMERUS VALENS 8.
                            SI numerus_campi_ordo > 0 TUNC
                                magnitudo_elem_ordo = numerus_campi_ordo * 8.
                            FIN-SI.

                            DECLARA mensura_tabulae SICUT NUMERUS VALENS 0.
                            DUM CONTENTUM(pos_fontis) < n && fons[CONTENTUM(pos_fontis)] >= 48 && fons[CONTENTUM(pos_fontis)] <= 57 PERFICE
                                mensura_tabulae = mensura_tabulae * 10 + (fons[CONTENTUM(pos_fontis)] - 48).
                                CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 1.
                            FIN-DUM.

                            CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - (magnitudo_elem_ordo * mensura_tabulae)).
                            DECLARA intervallum_base SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris) + 8.
                            DECLARA idx_nova SICUT NUMERUS VALENS PROXIMUS_LOCUS_LIBER(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris)).
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_nova, 0, nomen).
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_nova, 1, intervallum_base).
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_nova, 2, 1).
                            SI es_arr_fluitans == 1 TUNC
                                LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_nova, 5, 1).
                            FIN-SI.
                            SI numerus_campi_ordo > 0 TUNC
                                LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_nova, 3, magnitudo_elem_ordo).
                                DECLARA idx_struct_ordo SICUT NUMERUS VALENS INDEX_STRUCTURAE(DESCRIPTOR_FORMARUM_LEGE(contextus_parseris), nomen_typus_ordo).
                                SI idx_struct_ordo >= 0 TUNC
                                    LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_nova, 4, idx_struct_ordo + 1).
                                FIN-SI.
                            FIN-SI.
                        ALITER
                        SI fons[CONTENTUM(pos_fontis)] == 70 && CONTENTUM(pos_fontis) + 7 < n && fons[CONTENTUM(pos_fontis)+1] == 76 && fons[CONTENTUM(pos_fontis)+2] == 85 && fons[CONTENTUM(pos_fontis)+3] == 73 && fons[CONTENTUM(pos_fontis)+4] == 84 && fons[CONTENTUM(pos_fontis)+5] == 65 && fons[CONTENTUM(pos_fontis)+6] == 78 && fons[CONTENTUM(pos_fontis)+7] == 83 && (CONTENTUM(pos_fontis)+8 >= n || fons[CONTENTUM(pos_fontis)+8] == 32 || fons[CONTENTUM(pos_fontis)+8] == 46 || fons[CONTENTUM(pos_fontis)+8] == 10 || fons[CONTENTUM(pos_fontis)+8] == 9) TUNC
                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 9.
                            DECLARA ig_flot1 SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                            CONTENTUM(pos_fontis) = CONTENTUM(pos_fontis) + 7.
                            DECLARA ig_flot2 SICUT NUMERUS VALENS IGNORA_SPATIA(fons, pos_fontis, n).
                            DECLARA intervallum_flot SICUT NUMERUS VALENS CURSOR_PILAE_LEGE(contextus_parseris).
                            DECLARA idx_flot SICUT NUMERUS VALENS PROXIMUS_LOCUS_LIBER(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris)).
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_flot, 0, nomen).
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_flot, 1, intervallum_flot).
                            LOCALE_SCRIBE(DESCRIPTOR_LOCALIUM_LEGE(contextus_parseris), idx_flot, 5, 1).
                            CURSOR_PILAE_SCRIBE(contextus_parseris, CURSOR_PILAE_LEGE(contextus_parseris) - 8).
                            DECLARA ig_flot3 SICUT NUMERUS VALENS ANALYSA_COMPARATIO(codex, pos_codicis, fons, pos_fontis, n, contextus_parseris).
                            CONTENTUM(pos_codicis) = COMPONE_MOVSD_SALVA(codex, CONTENTUM(pos_codicis), intervallum_flot, 0).
                        ALITER
                            SI (fons[CONTENTUM(pos_fontis)] == 78 && CONTENTUM(pos_fontis) + 6 < n && fons[CONTENTUM(pos_fontis)+1] == 85 && fons[CONTENTUM(pos_fontis)+2] == 77 && fons[CONTENTUM(pos_fontis)+3] == 69 && fons[CONTENTUM(pos_fontis)+4] == 82 && fons[CONTENTUM(pos_fontis)+5] == 85 && fons[CONTENTUM(pos_fontis)+6] == 83) || (fons[CONTENTUM(pos_fontis)] == 65 && CONTENTUM(pos_fontis) + 4 < n && fons[CONTENTUM(pos_fontis)+1] == 67 && fons[CONTENTUM(pos_fontis)+2] == 85 && fons[CONTENTUM(pos_fontis)+3] == 83 && fons[CONTENTUM(pos_fontis)+4] == 60) || (fons[CONTENTUM(pos_fontis)] == 86 && CONTENTUM(pos_fontis) + 6 < n && fons[CONTENTUM(pos_fontis)+1] == 69 && fons[CONTENTUM(pos_fontis)+2] == 82 && fons[CONTENTUM(pos_fontis)+3] == 73 && fons[CONTENTUM(pos_fontis)+4] == 84 && fons[CONTENTUM(pos_fontis)+5] == 65 && fons[CONTENTUM(pos_fontis)+6] == 83) || (fons[CONTENTUM(pos_fontis)] == 84 && CONTENTUM(pos_fontis) + 5 < n && fons[CONTENTUM(pos_fontis)+1] == 69 && fons[CONTENTUM(pos_fontis)+2] == 88 && fons[CONTENTUM(pos_fontis)+3] == 84 && fons[CONTENTUM(pos_fontis)+4] == 85 && fons[CONTENTUM(pos_fontis)+5] == 83) TUNC
                            DECLARA intervallum_typi SICUT NUMERUS VALENS 8.
