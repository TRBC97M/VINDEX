// TABULA — client compactus runtime Fenestralis II Gradus I.
// Eundem mailbox Gradus G consumit; forma plena in tabula_fenestrale_ii_i.vindex manet.

FUNCTIO TI_AD_EST REDDENS NUMERUS.
    SI CONTENTUM(50333952) != 14159808274651475 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50333960) != 1 || CONTENTUM(50333968) < 128 TUNC REDDE 0. FIN-SI.
    SI (CONTENTUM(50333976) & 32) == 0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50335232) != 14162041607313747 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50335240) != 1 || CONTENTUM(50335248) < 256 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TI_COLOR REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    REDDE r + g * 256 + b * 65536 + 4278190080.
FIN-FUNCTIO.

FUNCTIO TI_RECT REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA basis SICUT NUMERUS VALENS CONTENTUM(50335312).
    DECLARA linea SICUT NUMERUS VALENS CONTENTUM(50335320).
    SI basis == 0 || linea == 0 || w <= 0 || h <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA fx SICUT NUMERUS VALENS x + w.
    DECLARA fy SICUT NUMERUS VALENS y + h.
    SI x % 2 != 0 TUNC x = x + 1. FIN-SI.
    DECLARA par SICUT NUMERUS VALENS color + color * 4294967296.
    DECLARA py SICUT NUMERUS VALENS y.
    DUM py < fy PERFICE
        DECLARA px SICUT NUMERUS VALENS x.
        DUM px + 1 < fx PERFICE
            CONTENTUM(basis + (py * linea + px) * 4) = par.
            px = px + 2.
        FIN-DUM.
        py = py + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TI_CREA REDDENS NUMERUS.
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(50333992).
    DECLARA sh SICUT NUMERUS VALENS CONTENTUM(50334000).
    DECLARA barra SICUT NUMERUS VALENS CONTENTUM(50334064).
    SI barra != 28 TUNC REDDE 0. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS sw * 56 / 100.
    DECLARA h SICUT NUMERUS VALENS (sh - barra) * 58 / 100.
    SI w < 620 TUNC w = 620. FIN-SI.
    SI w > sw - 48 TUNC w = sw - 48. FIN-SI.
    SI w % 2 != 0 TUNC w = w - 1. FIN-SI.
    SI h < 400 TUNC h = 400. FIN-SI.
    SI h > sh - barra - 48 TUNC h = sh - barra - 48. FIN-SI.
    CONTENTUM(50335264) = 1.
    CONTENTUM(50335272) = 2.
    CONTENTUM(50335280) = 0.
    CONTENTUM(50335288) = 7.
    CONTENTUM(50335296) = w.
    CONTENTUM(50335304) = h.
    CONTENTUM(50335384) = 0.
    CONTENTUM(50335392) = CONTENTUM(50335392) + 1.
    CONTENTUM(50335256) = 1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO TI_PINGE REDDENS NUMERUS.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(50335296).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(50335304).
    SI w < 480 || h < 320 TUNC REDDE 0. FIN-SI.
    DECLARA ebur SICUT NUMERUS VALENS TI_COLOR(241, 238, 228).
    DECLARA argentum SICUT NUMERUS VALENS TI_COLOR(185, 196, 207).
    DECLARA profundum SICUT NUMERUS VALENS TI_COLOR(8, 35, 61).
    DECLARA vitrum SICUT NUMERUS VALENS TI_COLOR(14, 66, 111).
    DECLARA medium SICUT NUMERUS VALENS TI_COLOR(26, 93, 146).
    DECLARA aqua SICUT NUMERUS VALENS TI_COLOR(98, 215, 242).
    DECLARA lux SICUT NUMERUS VALENS TI_COLOR(234, 248, 255).
    DECLARA bronzeum SICUT NUMERUS VALENS TI_COLOR(185, 138, 82).
    DECLARA rubrum SICUT NUMERUS VALENS TI_COLOR(168, 58, 58).
    DECLARA grid SICUT NUMERUS VALENS TI_COLOR(207, 216, 220).
    DECLARA activa SICUT NUMERUS VALENS TI_COLOR(225, 245, 249).
    DECLARA factum SICUT NUMERUS VALENS TI_RECT(0, 0, w, h, ebur).

    // Fenestra quadrata et titulus XXVIII.
    factum = TI_RECT(0, 0, w, 1, bronzeum).
    factum = TI_RECT(0, 0, 2, h, argentum).
    factum = TI_RECT(w - 2, 0, 2, h, profundum).
    factum = TI_RECT(0, h - 2, w, 2, profundum).
    factum = TI_RECT(2, 1, w - 4, 27, vitrum).
    factum = TI_RECT(2, 1, w - 4, 1, aqua).
    factum = TI_RECT(12, 10, 58, 8, lux).
    factum = TI_RECT(w - 70, 4, 18, 20, argentum).
    factum = TI_RECT(w - 48, 4, 18, 20, argentum).
    factum = TI_RECT(w - 26, 4, 20, 20, rubrum).

    // Menu XXII et instrumenta XXXIV.
    factum = TI_RECT(2, 28, w - 4, 22, ebur).
    factum = TI_RECT(2, 50, w - 4, 34, argentum).
    factum = TI_RECT(10, 55, 62, 24, lux).
    factum = TI_RECT(78, 55, 62, 24, lux).
    factum = TI_RECT(146, 55, 72, 24, lux).
    factum = TI_RECT(224, 55, 62, 24, lux).

    // Barra formulae.
    factum = TI_RECT(8, 88, w - 16, 30, lux).
    factum = TI_RECT(8, 88, 2, 30, medium).
    factum = TI_RECT(18, 98, 58, 8, medium).

    // Rete tabularis compactum sine cyclis generatoriis.
    DECLARA top SICUT NUMERUS VALENS 124.
    DECLARA left SICUT NUMERUS VALENS 42.
    DECLARA gw SICUT NUMERUS VALENS w - 52.
    DECLARA gh SICUT NUMERUS VALENS h - 152.
    DECLARA cw SICUT NUMERUS VALENS gw / 4.
    DECLARA rh SICUT NUMERUS VALENS (gh - 24) / 5.
    factum = TI_RECT(8, top, 34, gh, argentum).
    factum = TI_RECT(left, top, gw, 24, argentum).
    factum = TI_RECT(left, top + 24, gw, gh - 24, lux).
    factum = TI_RECT(left + cw, top, 2, gh, grid).
    factum = TI_RECT(left + cw * 2, top, 2, gh, grid).
    factum = TI_RECT(left + cw * 3, top, 2, gh, grid).
    factum = TI_RECT(8, top + 24 + rh, w - 18, 2, grid).
    factum = TI_RECT(8, top + 24 + rh * 2, w - 18, 2, grid).
    factum = TI_RECT(8, top + 24 + rh * 3, w - 18, 2, grid).
    factum = TI_RECT(8, top + 24 + rh * 4, w - 18, 2, grid).
    factum = TI_RECT(left + 2, top + 26, cw - 4, rh - 4, activa).
    factum = TI_RECT(left + 2, top + 26, cw - 4, 2, bronzeum).
    factum = TI_RECT(left + 2, top + 26, 2, rh - 4, bronzeum).
    factum = TI_RECT(2, h - 20, w - 4, 18, argentum).
    REDDE factum.
FIN-FUNCTIO.

FUNCTIO TI_PRAESENTA REDDENS NUMERUS.
    DECLARA superficies SICUT NUMERUS VALENS CONTENTUM(50335280).
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(50335296).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(50335304).
    SI superficies == 0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(50335256) = 0.
    CONTENTUM(50335264) = 3.
    CONTENTUM(50335272) = 2.
    CONTENTUM(50335280) = superficies.
    CONTENTUM(50335352) = 0.
    CONTENTUM(50335360) = 0.
    CONTENTUM(50335368) = w.
    CONTENTUM(50335376) = h.
    CONTENTUM(50335384) = 0.
    CONTENTUM(50335392) = CONTENTUM(50335392) + 1.
    CONTENTUM(50335256) = 1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI TI_AD_EST() == 0 TUNC REDDE 5. FIN-SI.
    DECLARA status SICUT NUMERUS VALENS CONTENTUM(50335256).
    SI status == 0 TUNC
        SI TI_CREA() == 0 TUNC REDDE 6. FIN-SI.
        REDDE 10.
    FIN-SI.
    SI status == 1 TUNC REDDE 11. FIN-SI.
    SI status == 3 || CONTENTUM(50335384) != 0 TUNC REDDE 12. FIN-SI.
    DECLARA operatio SICUT NUMERUS VALENS CONTENTUM(50335264).
    SI operatio == 1 TUNC
        SI CONTENTUM(50335312) == 0 || CONTENTUM(50335320) == 0 TUNC REDDE 13. FIN-SI.
        SI TI_PINGE() == 0 TUNC REDDE 14. FIN-SI.
        SI TI_PRAESENTA() == 0 TUNC REDDE 15. FIN-SI.
        REDDE 11.
    FIN-SI.
    SI operatio == 3 TUNC
        CONTENTUM(50335256) = 0.
        REDDE 0.
    FIN-SI.
    REDDE 16.
FIN-FUNCTIO.
