IMPORTA "bibliotheca/simg_ii.vindex".

FUNCTIO P_SII_PIXELA REDDENS TEXTUS.
    DECLARA d SICUT NUMERUS VALENS RESERVA_OCTETA(33).
    SI d<=0 TUNC
        REDDE 0.
    FIN-SI.
    CONTENTUM(d)=16.
    CONTENTUM(d+8)=16.
    DECLARA b SICUT NUMERUS VALENS d+16.
    // 2x2: ruber, ruber, caeruleus alpha CXXVIII, transparens.
    SCRIBE_OCTETUM_AB(b,255).
    SCRIBE_OCTETUM_AB(b+1,0).
    SCRIBE_OCTETUM_AB(b+2,0).
    SCRIBE_OCTETUM_AB(b+3,255).
    SCRIBE_OCTETUM_AB(b+4,255).
    SCRIBE_OCTETUM_AB(b+5,0).
    SCRIBE_OCTETUM_AB(b+6,0).
    SCRIBE_OCTETUM_AB(b+7,255).
    SCRIBE_OCTETUM_AB(b+8,0).
    SCRIBE_OCTETUM_AB(b+9,0).
    SCRIBE_OCTETUM_AB(b+10,255).
    SCRIBE_OCTETUM_AB(b+11,128).
    SCRIBE_OCTETUM_AB(b+12,0).
    SCRIBE_OCTETUM_AB(b+13,0).
    SCRIBE_OCTETUM_AB(b+14,0).
    SCRIBE_OCTETUM_AB(b+15,0).
    SCRIBE_OCTETUM_AB(b+16,0).
    REDDE d.
FIN-FUNCTIO.

FUNCTIO P_SII_COMPARA REDDENS NUMERUS.
    ACCIPIT a SICUT TEXTUS.
    ACCIPIT b SICUT TEXTUS.
    SI SII_LONGITUDO(a)!=SII_LONGITUDO(b) TUNC
        REDDE 0.
    FIN-SI.
    DECLARA n SICUT NUMERUS VALENS SII_LONGITUDO(a).
    DECLARA pa SICUT NUMERUS VALENS SII_CORPUS(a).
    DECLARA pb SICUT NUMERUS VALENS SII_CORPUS(b).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<n PERFICE
        SI OCTETUS_AB(pa+i)!=OCTETUS_AB(pb+i) TUNC
            REDDE 0.
        FIN-SI.
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA pix SICUT TEXTUS VALENS P_SII_PIXELA().
    SI SII_LONGITUDO(pix)!=16 TUNC
        REDDE 1.
    FIN-SI.

    DECLARA raw SICUT TEXTUS VALENS SII_CREA_RGBA(2,2,pix,0,2,1000).
    SI SII_VALIDUS(raw)==0 TUNC
        REDDE 2.
    FIN-SI.
    SI SII_LATITUDO(raw)!=2 || SII_ALTITUDO(raw)!=2 || SII_STRIDE(raw)!=8 TUNC
        REDDE 3.
    FIN-SI.
    SI SII_COMPRESSIO(raw)!=0 || SII_GENUS(raw)!=2 || SII_SCALA(raw)!=1000 TUNC
        REDDE 4.
    FIN-SI.
    SI SII_PAYLOAD_MENSURA(raw)!=16 || SII_CHECKSUM(raw)==0 TUNC
        REDDE 5.
    FIN-SI.
    SI SII_PIXEL_RGBA(raw,0,0)!=4278190335 TUNC
        REDDE 6.
    FIN-SI.
    SI SII_PIXEL_RGBA(raw,1,0)!=4278190335 TUNC
        REDDE 7.
    FIN-SI.
    SI SII_PIXEL_RGBA(raw,0,1)!=2164195328 TUNC
        REDDE 8.
    FIN-SI.
    SI SII_PIXEL_RGBA(raw,1,1)!=0 || SII_PIXEL_RGBA(raw,2,0)!=-1 TUNC
        REDDE 9.
    FIN-SI.

    SI SII_META_NOVEM(raw,1,0,1,0)==0 TUNC
        REDDE 10.
    FIN-SI.
    SI (SII_META_VEXILLA(raw)&1)==0 TUNC
        REDDE 11.
    FIN-SI.
    SI SII_MARGO(raw,0)!=1 || SII_MARGO(raw,1)!=0 || SII_MARGO(raw,2)!=1 || SII_MARGO(raw,3)!=0 TUNC
        REDDE 12.
    FIN-SI.
    SI SII_META_CURSOR(raw,1,1)==0 TUNC
        REDDE 13.
    FIN-SI.
    SI (SII_META_VEXILLA(raw)&2)==0 || SII_HOTSPOT_X(raw)!=1 || SII_HOTSPOT_Y(raw)!=1 TUNC
        REDDE 14.
    FIN-SI.

    DECLARA rle SICUT TEXTUS VALENS SII_CREA_RGBA(2,2,pix,1,2,2000).
    SI SII_VALIDUS(rle)==0 TUNC
        REDDE 15.
    FIN-SI.
    SI SII_COMPRESSIO(rle)!=1 || SII_PAYLOAD_MENSURA(rle)!=15 || SII_SCALA(rle)!=2000 TUNC
        REDDE 16.
    FIN-SI.
    SI SII_PIXEL_RGBA(rle,0,0)!=4278190335 || SII_PIXEL_RGBA(rle,1,0)!=4278190335 TUNC
        REDDE 17.
    FIN-SI.
    SI SII_PIXEL_RGBA(rle,0,1)!=2164195328 || SII_PIXEL_RGBA(rle,1,1)!=0 TUNC
        REDDE 18.
    FIN-SI.
    DECLARA exp SICUT TEXTUS VALENS SII_EXPANDE_RGBA(rle).
    SI P_SII_COMPARA(exp,pix)==0 TUNC
        REDDE 19.
    FIN-SI.

    // Integritas payload mutatum detegere debet.
    DECLARA rb SICUT NUMERUS VALENS SII_CORPUS(rle).
    DECLARA po SICUT NUMERUS VALENS SII_U32_LE(rb,24).
    DECLARA pl SICUT NUMERUS VALENS SII_U32_LE(rb,28).
    DECLARA scriptum SICUT NUMERUS VALENS SII_CHECKSUM(rle).
    DECLARA ante SICUT NUMERUS VALENS SII_ADLER32(rb+po,pl).
    SI scriptum!=ante TUNC
        REDDE 20.
    FIN-SI.
    DECLARA vetus SICUT NUMERUS VALENS OCTETUS_AB(rb+po+1).
    SI vetus==255 TUNC
        SCRIBE_OCTETUM_AB(rb+po+1,254).
    ALITER
        SCRIBE_OCTETUM_AB(rb+po+1,vetus+1).
    FIN-SI.
    DECLARA novus SICUT NUMERUS VALENS OCTETUS_AB(rb+po+1).
    SI novus==vetus TUNC
        REDDE 21.
    FIN-SI.
    DECLARA post SICUT NUMERUS VALENS SII_ADLER32(rb+po,pl).
    SI post==scriptum TUNC
        REDDE 22.
    FIN-SI.
    SI SII_VALIDUS(rle)!=0 TUNC
        REDDE 23.
    FIN-SI.

    // Metadata invalida numquam admittitur.
    SI SII_META_NOVEM(raw,2,0,1,0)!=0 TUNC
        REDDE 24.
    FIN-SI.
    SI SII_META_CURSOR(raw,2,1)!=0 TUNC
        REDDE 25.
    FIN-SI.

    REDDE 0.
FIN-FUNCTIO.
