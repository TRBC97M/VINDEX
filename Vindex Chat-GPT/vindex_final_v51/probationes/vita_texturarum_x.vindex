IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_vii.vindex".
IMPORTA "bibliotheca/imago_raster_vii.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_viii.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_x.vindex".
IMPORTA "bibliotheca/fenestrale_coda_graphica.vindex".
IMPORTA "bibliotheca/fenestrale_cache_texturarum_x.vindex".
IMPORTA "bibliotheca/fenestrale_backend_x.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA src SICUT NUMERUS VALENS GX_CREA(4,4).
    DECLARA dst SICUT NUMERUS VALENS GX_CREA(4,4).
    DECLARA fragilis SICUT NUMERUS VALENS GX_CREA(3,3).
    SI src==0 || dst==0 || fragilis==0 TUNC REDDE 1. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_RECT_ALPHA(src,GVIII_RECT_CREA(0,0,4,4),255,192).
    f=GX_RECT_ALPHA(fragilis,GVIII_RECT_CREA(0,0,3,3),16777215,128).
    DECLARA b SICUT NUMERUS VALENS BX_CREA_SW(16).
    SI b==0 || (CONTENTUM(b+16)&BX_CAP_VITA_TEXTURE())==0 TUNC REDDE 2. FIN-SI.
    DECLARA r SICUT NUMERUS VALENS BX_RESOURCE_CREA(b,src).
    SI r==0 || BX_RESOURCE_STATUS(r)!=0 || BX_RESOURCE_GENERATIO(r)!=CONTENTUM(src+72) TUNC REDDE 3. FIN-SI.

    DECLARA totum SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,4,4).
    SI BX_FRAME_INCIPE(b)==0 || BX_TEXTURE_CREA_ADDE(b,r)==0 || BX_COMPONE_ADDE(b,dst,src,totum,totum,255)==0 TUNC REDDE 4. FIN-SI.
    SI BX_FRAME_COMMITTE(b)!=1 TUNC REDDE 5. FIN-SI.
    DECLARA q SICUT NUMERUS VALENS BX_CODA(b).
    SI QVIII_NUMERUS(q)!=2 || QVIII_OPCODE(q,0)!=BX_OP_TEXTURE_CREA() || QVIII_OPCODE(q,1)!=BX_OP_COMPONE() TUNC REDDE 6. FIN-SI.
    SI BX_RESOURCE_STATUS(r)!=1 || BX_RESOURCE_MANUBRIUM(r)==0 || BX_RESOURCE_CREATAE(b)!=1 || BX_RESOURCE_OCTETA(b)!=64 || BX_RESOURCE_RESIDENTES(b)!=1 TUNC REDDE 7. FIN-SI.
    SI GX_PIX_PM_LEGE(dst,0,0)!=GX_PIX_PM_LEGE(src,0,0) TUNC REDDE 8. FIN-SI.

    DECLARA gen0 SICUT NUMERUS VALENS BX_RESOURCE_GENERATIO(r).
    f=GX_PIX_PONE(src,0,0,65280,255).
    SI CONTENTUM(src+72)==gen0 TUNC REDDE 9. FIN-SI.
    SI BX_FRAME_INCIPE(b)==0 || BX_TEXTURE_RENOVA_ADDE(b,r)==0 || BX_COMPONE_ADDE(b,dst,src,totum,totum,255)==0 TUNC REDDE 10. FIN-SI.
    SI BX_FRAME_COMMITTE(b)!=2 || BX_RESOURCE_GENERATIO(r)!=CONTENTUM(src+72) || BX_RESOURCE_RENOVATAE(b)!=1 || CONTENTUM(r+56)!=1 TUNC REDDE 11. FIN-SI.
    SI QVIII_NUMERUS(q)!=2 || QVIII_OPCODE(q,0)!=BX_OP_TEXTURE_RENOVA() || QVIII_OPCODE(q,1)!=BX_OP_COMPONE() TUNC REDDE 12. FIN-SI.

    SI BX_FRAME_INCIPE(b)==0 || BX_TEXTURE_LIBERA_ADDE(b,r)==0 || BX_FRAME_COMMITTE(b)!=3 TUNC REDDE 13. FIN-SI.
    SI BX_RESOURCE_STATUS(r)!=2 || BX_RESOURCE_MANUBRIUM(r)!=0 || BX_RESOURCE_LIBERATAE(b)!=1 || BX_RESOURCE_OCTETA(b)!=0 || BX_RESOURCE_RESIDENTES(b)!=0 TUNC REDDE 14. FIN-SI.

    DECLARA src2 SICUT NUMERUS VALENS GX_CREA(4,4).
    DECLARA r2 SICUT NUMERUS VALENS BX_RESOURCE_CREA(b,src2).
    SI src2==0 || r2==0 || BX_FRAME_INCIPE(b)==0 || BX_TEXTURE_CREA_ADDE(b,r2)==0 || BX_FRAME_COMMITTE(b)!=4 TUNC REDDE 15. FIN-SI.
    DECLARA gen2 SICUT NUMERUS VALENS BX_RESOURCE_GENERATIO(r2).
    f=GX_PIX_PONE(src2,1,1,16711680,255).
    DECLARA novem SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,3,3).
    SI BX_FRAME_INCIPE(b)==0 || BX_TEXTURE_RENOVA_ADDE(b,r2)==0 || BX_NOVEM_ADDE(b,dst,fragilis,novem,novem,255)==0 TUNC REDDE 16. FIN-SI.
    CONTENTUM(fragilis)=2.
    SI BX_FRAME_COMMITTE(b)!=0 TUNC REDDE 17. FIN-SI.
    SI BX_RESOURCE_STATUS(r2)!=1 || BX_RESOURCE_GENERATIO(r2)!=gen2 || BX_RESOURCE_RENOVATAE(b)!=1 || CONTENTUM(r2+72)!=0 TUNC REDDE 18. FIN-SI.
    SI BX_FENCE_COMPLETA(b)!=4 || QVIII_NUMERUS(q)!=0 || BX_ERRATUM(b)!=6 TUNC REDDE 19. FIN-SI.

    CONTENTUM(fragilis)=3.
    SI BX_FRAME_INCIPE(b)==0 || BX_TEXTURE_RENOVA_ADDE(b,r2)==0 || BX_FRAME_COMMITTE(b)!=5 TUNC REDDE 20. FIN-SI.
    SI BX_RESOURCE_GENERATIO(r2)!=CONTENTUM(src2+72) || BX_RESOURCE_RENOVATAE(b)!=2 TUNC REDDE 21. FIN-SI.
    SI BX_FRAME_INCIPE(b)==0 || BX_TEXTURE_LIBERA_ADDE(b,r2)==0 || BX_FRAME_COMMITTE(b)!=6 TUNC REDDE 22. FIN-SI.
    SI BX_RESOURCE_LIBERATAE(b)!=2 || BX_RESOURCE_OCTETA(b)!=0 || BX_RESOURCE_RESIDENTES(b)!=0 TUNC REDDE 23. FIN-SI.

    DECLARA src3 SICUT NUMERUS VALENS GX_CREA(2,2).
    DECLARA r3 SICUT NUMERUS VALENS BX_RESOURCE_CREA(b,src3).
    SI r3==0 || BX_FRAME_INCIPE(b)==0 || BX_TEXTURE_CREA_ADDE(b,r3)==0 TUNC REDDE 24. FIN-SI.
    SI BX_FRAME_ABICE(b)==0 || BX_RESOURCE_STATUS(r3)!=0 || CONTENTUM(r3+72)!=0 || QVIII_NUMERUS(q)!=0 || BX_FENCE_COMPLETA(b)!=6 TUNC REDDE 25. FIN-SI.

    REDDE 0.
FIN-FUNCTIO.
