IMPORTA "bibliotheca/simg_ii.vindex".
IMPORTA "bibliotheca/simg_ii_compat_v1.vindex".
IMPORTA "bibliotheca/simg_ii_bridge_vii.vindex".

FUNCTIO P_SII_PONTE_PIX REDDENS TEXTUS.
    DECLARA d SICUT NUMERUS VALENS RESERVA_OCTETA(25).
    SI d<=0 TUNC
        REDDE 0.
    FIN-SI.
    CONTENTUM(d)=8.
    CONTENTUM(d+8)=8.
    DECLARA b SICUT NUMERUS VALENS d+16.
    SCRIBE_OCTETUM_AB(b,10).
    SCRIBE_OCTETUM_AB(b+1,20).
    SCRIBE_OCTETUM_AB(b+2,30).
    SCRIBE_OCTETUM_AB(b+3,255).
    SCRIBE_OCTETUM_AB(b+4,40).
    SCRIBE_OCTETUM_AB(b+5,50).
    SCRIBE_OCTETUM_AB(b+6,60).
    SCRIBE_OCTETUM_AB(b+7,128).
    SCRIBE_OCTETUM_AB(b+8,0).
    REDDE d.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA pix SICUT TEXTUS VALENS P_SII_PONTE_PIX().
    DECLARA ii SICUT TEXTUS VALENS SII_CREA_RGBA(2,1,pix,1,6,1000).
    SI SII_VALIDUS(ii)==0 TUNC
        REDDE 1.
    FIN-SI.
    DECLARA i SICUT TEXTUS VALENS SII_AD_V1(ii).
    SI SII_V1_VALIDUS(i)==0 TUNC
        REDDE 2.
    FIN-SI.
    DECLARA b SICUT NUMERUS VALENS SII_CORPUS(i).
    SI SII_U32_LE(b,8)!=2 || SII_U32_LE(b,12)!=1 || SII_U32_LE(b,16)!=8 TUNC
        REDDE 3.
    FIN-SI.
    SI SII_U32_LE(b+24,0)!=4280161290 TUNC
        REDDE 4.
    FIN-SI.
    SI SII_U32_LE(b+28,0)!=2151428648 TUNC
        REDDE 5.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
