IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_vii.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI GVII_INTERPOLA_COMPONENTEM(10,110,1,2)!=60 TUNC REDDE 1. FIN-SI.
    SI GVII_INTERPOLA_COMPONENTEM(10,110,-4,2)!=10 TUNC REDDE 2. FIN-SI.
    SI GVII_INTERPOLA_COMPONENTEM(10,110,8,2)!=110 TUNC REDDE 3. FIN-SI.

    DECLARA niger SICUT NUMERUS VALENS 0.
    DECLARA albus SICUT NUMERUS VALENS 16777215.
    SI GVII_COLOR_INTERPOLA(niger,albus,1,2)!=8355711 TUNC REDDE 4. FIN-SI.
    SI GVII_COLOR_ALPHA(albus,niger,0)!=niger TUNC REDDE 5. FIN-SI.
    SI GVII_COLOR_ALPHA(albus,niger,255)!=albus TUNC REDDE 6. FIN-SI.
    SI GVII_COLOR_ALPHA(albus,niger,128)!=8421504 TUNC REDDE 7. FIN-SI.

    DECLARA ruber_raw SICUT NUMERUS VALENS 255.
    DECLARA caeruleus_raw SICUT NUMERUS VALENS 16711680.
    SI GVII_COLOR_INTERPOLA(ruber_raw,caeruleus_raw,1,2)!=8323199 TUNC REDDE 8. FIN-SI.

    REDDE 0.
FIN-FUNCTIO.
