// Diagnostica Purus B: corpus PRINCIPALIS reale, auxiliis minimis.
// Probat an ipsa ansa principalis compilatorem VINDEX implicet.

FUNCTIO FV_AD_EST REDDENS NUMERUS.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FB_PROTOCOLA_PARA REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FB_REDDE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FB_CLAVIS_LEGE REDDENS NUMERUS.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FB_CLAVIS_AGE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT q SICUT NUMERUS.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FB_MURUS_ABSOLUTUS REDDENS NUMERUS.
    ACCIPIT murus SICUT NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FB_MURUS_RELATIVUS REDDENS NUMERUS.
    ACCIPIT murus SICUT NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FB_MOUSE_DOWN REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FB_DRAG REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FB_STALL REDDENS NUMERUS.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI FV_AD_EST() == 0 TUNC REDDE 5. FIN-SI.
    DECLARA s SICUT ORDO DE NUMERUS CAPACITAS 32.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(50333728).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(50333736).
    s[0]=1. s[1]=0. s[2]=0.
    s[5]=w*58/100. s[6]=(h-28)*66/100.
    s[9]=w*42/100. s[10]=(h-28)*52/100.
    SI s[5] < 640 TUNC s[5]=640. FIN-SI. SI s[6] < 420 TUNC s[6]=420. FIN-SI.
    SI s[9] < 500 TUNC s[9]=500. FIN-SI. SI s[10] < 360 TUNC s[10]=360. FIN-SI.
    SI s[5] > w TUNC s[5]=w. FIN-SI. SI s[6] > h-28 TUNC s[6]=h-28. FIN-SI.
    SI s[9] > w TUNC s[9]=w. FIN-SI. SI s[10] > h-28 TUNC s[10]=h-28. FIN-SI.
    s[3]=w*6/100. s[4]=h*7/100.
    s[7]=w-s[9]-w*5/100. s[8]=h*21/100.
    SI s[3]+s[5] > w TUNC s[3]=w-s[5]. FIN-SI.
    SI s[4]+s[6] > h-28 TUNC s[4]=h-28-s[6]. FIN-SI.
    SI s[7] < 0 TUNC s[7]=0. FIN-SI. SI s[8]+s[10] > h-28 TUNC s[8]=h-28-s[10]. FIN-SI.
    s[11]=w/2. s[12]=h/2. s[13]=0. s[14]=0. s[17]=0. s[22]=0.
    DECLARA pp SICUT NUMERUS VALENS FB_PROTOCOLA_PARA(s).
    DECLARA f SICUT NUMERUS VALENS FB_REDDE(s).
    DECLARA finis SICUT NUMERUS VALENS 0.
    DUM finis == 0 PERFICE
        DECLARA redde SICUT NUMERUS VALENS 0.
        DECLARA q SICUT NUMERUS VALENS FB_CLAVIS_LEGE().
        SI q != 0 TUNC
            DECLARA qa SICUT NUMERUS VALENS FB_CLAVIS_AGE(s,q).
            SI qa == 2 TUNC finis=1. ALITER SI qa == 1 TUNC redde=1. FIN-SI. FIN-SI.
        FIN-SI.
        DECLARA muris SICUT NUMERUS VALENS FB_MURUS_ABSOLUTUS(s[29],s).
        SI muris == 0 TUNC muris = FB_MURUS_RELATIVUS(s[28],s). FIN-SI.
        SI muris != 0 TUNC
            DECLARA bullae SICUT NUMERUS VALENS muris - 1.
            SI (bullae & 1) != 0 && (s[13] & 1) == 0 TUNC DECLARA md SICUT NUMERUS VALENS FB_MOUSE_DOWN(s). FIN-SI.
            SI (bullae & 1) != 0 && s[14] != 0 TUNC DECLARA dr SICUT NUMERUS VALENS FB_DRAG(s). FIN-SI.
            SI (bullae & 1) == 0 && (s[13] & 1) != 0 TUNC s[14]=0. FIN-SI.
            s[13]=bullae. redde=1.
        FIN-SI.
        SI redde == 1 TUNC f = FB_REDDE(s). FIN-SI.
        DECLARA pausa SICUT NUMERUS VALENS FB_STALL().
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.
