// P12-V3 — ABI tractatoris et calculi IDT/MSI sine privilegio probantur.

IMPORTA "systema/rectores/pci.vindex".
IMPORTA "systema/rectores/interruptiones.vindex".

FUNCTIO ABI_TRACTATOR_SEDES REDDENS NUMERUS.
    REDDE SEDES_FUNCTIONIS(PROBA_TRACTATOR).
FIN-FUNCTIO.

INTERRUPTIO PROBA_TRACTATOR.
    CONTENTUM(8388608) = CONTENTUM(8388608) + 1.
    REDDE 0.
FIN-INTERRUPTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA vexilla SICUT NUMERUS VALENS INTERRUPTIONES_STATUS().
    DECLARA selector SICUT NUMERUS VALENS CODICIS_SELECTOR().
    DECLARA tractator SICUT NUMERUS VALENS ABI_TRACTATOR_SEDES().
    SI vexilla == 0 || selector == 0 || tractator == 0 TUNC REDDE 1. FIN-SI.
    DECLARA inferior SICUT NUMERUS VALENS IN_PORTA_INFERIOR(1234605616436508552, 40).
    DECLARA superior SICUT NUMERUS VALENS IN_PORTA_SUPERIOR(1234605616436508552).
    SI (inferior & 65535) != 30600 TUNC REDDE 2. FIN-SI.
    SI ((inferior / 65536) & 65535) != 40 TUNC REDDE 3. FIN-SI.
    SI ((inferior / 1099511627776) & 255) != 142 TUNC REDDE 4. FIN-SI.
    SI superior != 287454020 TUNC REDDE 5. FIN-SI.
    SI IN_MSI_CAPUT_INACTIVUM(4294967295) != 4287561727 TUNC REDDE 6. FIN-SI.
    SI IN_MSI_CAPUT_ACTIVUM(4294967295) != 4287627263 TUNC REDDE 7. FIN-SI.
    SI IN_MSI_DATUM(2863267840, 241) != 2863268081 TUNC REDDE 8. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
