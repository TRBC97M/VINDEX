// Probatio VINDEX: registrum fenestrarum Purus I sine capacitate fixa.

IMPORTA "bibliotheca/fenestrae_registrum_i.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA r SICUT NUMERUS VALENS FI_CREA().
    SI r==0 TUNC REDDE 71. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<80 PERFICE
        DECLARA id SICUT NUMERUS VALENS FI_ADDE(r,1000+i,10+i,20+i,360,240).
        SI id!=i+1 TUNC REDDE 65. FIN-SI.
        i=i+1.
    FIN-DUM.
    SI FI_NUMERUS(r)!=80 TUNC REDDE 65. FIN-SI.
    SI FI_FOCUS_ID(r)!=80 TUNC REDDE 65. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS FI_FOCUS(r,1).
    SI f!=1 || FI_FOCUS_ID(r)!=1 TUNC REDDE 65. FIN-SI.
    SI CONTENTUM(FI_SUPREMUS(r))!=1 TUNC REDDE 65. FIN-SI.
    DECLARA m SICUT NUMERUS VALENS FI_MINIMIZA(r,1).
    SI FI_STATUS(r,1)!=1 || FI_FOCUS_ID(r)==1 TUNC REDDE 65. FIN-SI.
    DECLARA rr SICUT NUMERUS VALENS FI_STATUS_PONE(r,1,0).
    f=FI_FOCUS(r,1).
    DECLARA z SICUT NUMERUS VALENS FI_MAX_TOGGLE(r,1,1280,720).
    DECLARA n SICUT NUMERUS VALENS FI_QUAERE(r,1).
    SI n==0 || CONTENTUM(n+16)!=0 || CONTENTUM(n+24)!=0 TUNC REDDE 65. FIN-SI.
    SI CONTENTUM(n+32)!=1280 || CONTENTUM(n+40)!=692 TUNC REDDE 65. FIN-SI.
    z=FI_MAX_TOGGLE(r,1,1280,720).
    SI CONTENTUM(n+16)!=10 || CONTENTUM(n+24)!=20 TUNC REDDE 65. FIN-SI.
    DECLARA c SICUT NUMERUS VALENS FI_CLAUDE(r,40).
    SI FI_STATUS(r,40)!=2 TUNC REDDE 65. FIN-SI.
    SI FI_APERTA_NUM(r)!=79 TUNC REDDE 65. FIN-SI.
    SI FI_CLIENTIS(r,1039)!=0 TUNC REDDE 65. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
