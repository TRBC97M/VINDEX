IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_vii.vindex".
IMPORTA "bibliotheca/imago_raster_vii.vindex".
IMPORTA "bibliotheca/textus.vindex".
IMPORTA "bibliotheca/emblema_sylviae_vii.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_viii.vindex".
IMPORTA "bibliotheca/fenestrale_damage_viii.vindex".
IMPORTA "bibliotheca/fenestrale_typographia_viii.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI GVIII_MIN(4,9)!=4 TUNC REDDE 1. FIN-SI.
    SI GVIII_MAX(4,9)!=9 TUNC REDDE 2. FIN-SI.
    SI GVIII_CLAMPA(-3,0,10)!=0 TUNC REDDE 3. FIN-SI.
    SI GVIII_CLAMPA(14,0,10)!=10 TUNC REDDE 4. FIN-SI.
    SI GVIII_CLAMPA(7,0,10)!=7 TUNC REDDE 5. FIN-SI.

    DECLARA a SICUT NUMERUS VALENS GVIII_RECT_CREA(-10,5,30,20).
    DECLARA limen SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,100,100).
    SI a==0 || limen==0 TUNC REDDE 6. FIN-SI.
    SI GVIII_RECT_X(a)!=-10 || GVIII_RECT_Y(a)!=5 || GVIII_RECT_W(a)!=30 || GVIII_RECT_H(a)!=20 TUNC REDDE 7. FIN-SI.
    DECLARA r SICUT NUMERUS VALENS GVIII_RECT_SECA(a,limen).
    SI r==0 TUNC REDDE 8. FIN-SI.
    SI GVIII_RECT_X(r)!=0 || GVIII_RECT_Y(r)!=5 || GVIII_RECT_W(r)!=20 || GVIII_RECT_H(r)!=20 TUNC REDDE 9. FIN-SI.
    SI GVIII_RECT_SECA(GVIII_RECT_CREA(120,120,5,5),limen)!=0 TUNC REDDE 10. FIN-SI.
    SI GVIII_COORD_SCALA(5,10,20,40)!=40 TUNC REDDE 11. FIN-SI.
    SI GVIII_COVER_ROTUNDUM(0,0,8)!=0 TUNC REDDE 12. FIN-SI.
    SI GVIII_COVER_ROTUNDUM(7,7,8)!=255 TUNC REDDE 13. FIN-SI.

    DECLARA m SICUT NUMERUS VALENS GVIII_MARGINES_CREA(4,5,6,7).
    SI GVIII_MARGO_SIN(m)!=4 || GVIII_MARGO_SUP(m)!=5 || GVIII_MARGO_DEX(m)!=6 || GVIII_MARGO_INF(m)!=7 TUNC REDDE 14. FIN-SI.

    DECLARA d SICUT ORDO DE NUMERUS CAPACITAS 5.
    SI DVIII_INIT(d)!=1 || DVIII_NUMERUS(d)!=0 TUNC REDDE 15. FIN-SI.
    SI DVIII_ADDE(d,4,GVIII_RECT_CREA(10,10,20,20),GVIII_RECT_CREA(0,0,300,200))!=1 TUNC REDDE 16. FIN-SI.
    SI DVIII_NUMERUS(d)!=1 TUNC REDDE 17. FIN-SI.
    SI DVIII_ADDE(d,4,GVIII_RECT_CREA(25,25,20,20),GVIII_RECT_CREA(0,0,300,200))!=1 TUNC REDDE 18. FIN-SI.
    SI DVIII_NUMERUS(d)!=1 TUNC REDDE 19. FIN-SI.
    SI DVIII_X(d,0)!=10 || DVIII_Y(d,0)!=10 || DVIII_W(d,0)!=35 || DVIII_H(d,0)!=35 TUNC REDDE 20. FIN-SI.
    SI DVIII_ADDE(d,4,GVIII_RECT_CREA(100,100,10,10),GVIII_RECT_CREA(0,0,300,200))!=1 TUNC REDDE 21. FIN-SI.
    SI DVIII_NUMERUS(d)!=2 TUNC REDDE 22. FIN-SI.
    SI DVIII_ADDE(d,4,GVIII_RECT_CREA(-10,-10,15,15),GVIII_RECT_CREA(0,0,300,200))!=1 TUNC REDDE 23. FIN-SI.
    SI DVIII_NUMERUS(d)!=3 TUNC REDDE 24. FIN-SI.
    SI DVIII_X(d,2)!=0 || DVIII_Y(d,2)!=0 || DVIII_W(d,2)!=5 || DVIII_H(d,2)!=5 TUNC REDDE 25. FIN-SI.
    SI DVIII_AREA(d)!=(35*35+10*10+5*5) TUNC REDDE 26. FIN-SI.
    SI DVIII_ADDE(d,3,GVIII_RECT_CREA(200,150,20,20),GVIII_RECT_CREA(0,0,300,200))!=1 TUNC REDDE 27. FIN-SI.
    SI DVIII_NUMERUS(d)!=1 TUNC REDDE 28. FIN-SI.
    SI DVIII_X(d,0)!=0 || DVIII_Y(d,0)!=0 || DVIII_X(d,0)+DVIII_W(d,0)<220 || DVIII_Y(d,0)+DVIII_H(d,0)<170 TUNC REDDE 29. FIN-SI.

    SI TVIII_GLYPHUM_INDEX(65,32,96)!=33 TUNC REDDE 30. FIN-SI.
    SI TVIII_GLYPHUM_INDEX(31,32,96)!=-1 TUNC REDDE 31. FIN-SI.
    DECLARA exemplar SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,10,16).
    SI TVIII_TEXTUM_MENSURA("ABCD",exemplar,2)!=46 TUNC REDDE 32. FIN-SI.

    // Emblema XXXII fit atlas unius glyphi ad contractum descriptoris exercendum.
    DECLARA atlas SICUT TEXTUS VALENS EVII_CREA().
    SI IR_VALIDUS(atlas)==0 TUNC REDDE 33. FIN-SI.
    DECLARA fons SICUT NUMERUS VALENS TVIII_FONS_CREA(atlas,1,32,32,65,1).
    SI fons==0 || TVIII_FONS_VALIDUS(fons)==0 TUNC REDDE 34. FIN-SI.
    SI TVIII_FONS_INDEX(fons,65)!=0 || TVIII_FONS_INDEX(fons,66)!=-1 TUNC REDDE 35. FIN-SI.
    DECLARA gr SICUT NUMERUS VALENS TVIII_GLYPHUM_FONS_RECT(fons,65).
    SI gr==0 || GVIII_RECT_W(gr)!=32 || GVIII_RECT_H(gr)!=32 TUNC REDDE 36. FIN-SI.

    REDDE 0.
FIN-FUNCTIO.
