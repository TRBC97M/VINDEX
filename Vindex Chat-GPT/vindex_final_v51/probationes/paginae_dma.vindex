IMPORTA "systema/rectores/pci.vindex".
IMPORTA "systema/rectores/mmio.vindex".
IMPORTA "systema/rectores/paginae_dma.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA rudis SICUT NUMERUS VALENS RESERVA_OCTETA(16384).
    SI rudis == 0 TUNC REDDE 1. FIN-SI.
    DECLARA memoria SICUT NUMERUS VALENS ((rudis + 4095) / 4096) * 4096.
    DECLARA vexilla SICUT NUMERUS VALENS DMA_X86_COHERENS() | DMA_APPARATUS_LEGE() | DMA_APPARATUS_SCRIBE().
    DECLARA regio SICUT NUMERUS VALENS DMA_REGIO_ADOPTA(memoria, memoria, 8193, 12288, vexilla).
    SI regio == 0 TUNC REDDE 2. FIN-SI.
    SI CONTENTUM(regio) != memoria || CONTENTUM(regio + 8) != memoria || CONTENTUM(regio + 16) != 8193 TUNC REDDE 3. FIN-SI.
    SI CONTENTUM(regio + 24) != 12288 || CONTENTUM(regio + 32) != 3 || CONTENTUM(regio + 80) != 1 TUNC REDDE 4. FIN-SI.
    SI CONTENTUM(regio + 96) != 0 || CONTENTUM(regio + 104) != 0 TUNC REDDE 4. FIN-SI.
    SI (CONTENTUM(regio + 40) & DMA_IDENTITAS()) == 0 || (CONTENTUM(regio + 40) & DMA_PROPRIETAS_UEFI()) != 0 TUNC REDDE 5. FIN-SI.

    SI DMA_SCRIBE8(regio, 8192, 90) == 0 || DMA_LEGE8(regio, 8192) != 90 TUNC REDDE 6. FIN-SI.
    SI DMA_SCRIBE16(regio, 2, 13398) == 0 || DMA_LEGE16(regio, 2) != 13398 TUNC REDDE 7. FIN-SI.
    SI DMA_SCRIBE32(regio, 4, 2309737967) == 0 || DMA_LEGE32(regio, 4) != 2309737967 TUNC REDDE 8. FIN-SI.
    SI DMA_SCRIBE64(regio, 8, 1234605616436508552) == 0 || DMA_LEGE64(regio, 8) != 1234605616436508552 TUNC REDDE 9. FIN-SI.
    SI DMA_PHYSICA(regio, 4096, 64) != memoria + 4096 TUNC REDDE 10. FIN-SI.

    SI DMA_ADRESSA(regio, 8192, 2) != 0 || DMA_ERRATUM(regio) != 5 TUNC REDDE 11. FIN-SI.
    SI DMA_ADRESSA(regio, 3, 4) != 0 || DMA_ERRATUM(regio) != 6 TUNC REDDE 12. FIN-SI.
    SI DMA_PHYSICA(regio, 8193, 1) != 0 || DMA_ERRATUM(regio) != 5 TUNC REDDE 13. FIN-SI.

    SI DMA_SYNCHRONIZA(regio, DMA_AD_APPARATUM()) == 0 TUNC REDDE 14. FIN-SI.
    SI DMA_SYNCHRONIZA(regio, DMA_AB_APPARATU()) == 0 TUNC REDDE 15. FIN-SI.
    SI DMA_SYNCHRONIZA(regio, DMA_BIDIRECTA()) == 0 TUNC REDDE 16. FIN-SI.
    SI CONTENTUM(regio + 88) != 3 || CONTENTUM(regio + 112) != DMA_BIDIRECTA() TUNC REDDE 17. FIN-SI.
    SI DMA_SYNCHRONIZA(regio, 4) != 0 || DMA_ERRATUM(regio) != 8 TUNC REDDE 18. FIN-SI.

    DECLARA lectio SICUT NUMERUS VALENS DMA_REGIO_ADOPTA(memoria, memoria, 4096, 4096, DMA_X86_COHERENS() | DMA_APPARATUS_LEGE()).
    SI lectio == 0 || DMA_SYNCHRONIZA(lectio, DMA_AB_APPARATU()) != 0 || DMA_ERRATUM(lectio) != 10 TUNC REDDE 19. FIN-SI.
    SI DMA_REGIO_ADOPTA(memoria + 1, memoria, 4096, 4096, vexilla) != 0 TUNC REDDE 20. FIN-SI.
    SI DMA_REGIO_ADOPTA(memoria, memoria, 4097, 4096, vexilla) != 0 TUNC REDDE 21. FIN-SI.
    SI DMA_REGIO_ADOPTA(memoria, memoria, 4096, 4096, 0) != 0 TUNC REDDE 22. FIN-SI.
    SI DMA_UEFI_LIBERA(regio) != 0 || DMA_ERRATUM(regio) != 11 TUNC REDDE 23. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
