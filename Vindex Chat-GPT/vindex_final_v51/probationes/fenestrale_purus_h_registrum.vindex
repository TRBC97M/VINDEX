// Probatio executionis: registrum dynamicum clientium Fenestralis Purus H.

IMPORTA "bibliotheca/clientia_registrum_h.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA r SICUT NUMERUS VALENS CH_CREA().
    SI r == 0 TUNC REDDE 71. FIN-SI.
    SI CH_NUMERUS(r) != 0 TUNC REDDE 65. FIN-SI.
    DECLARA a SICUT NUMERUS VALENS CH_ADDE(r,1,1,4096,7).
    DECLARA b SICUT NUMERUS VALENS CH_ADDE(r,2,2,8192,11).
    DECLARA c SICUT NUMERUS VALENS CH_ADDE(r,37,9,12288,13).
    SI a==0 || b==0 || c==0 TUNC REDDE 65. FIN-SI.
    SI CH_NUMERUS(r) != 3 TUNC REDDE 65. FIN-SI.
    SI CH_ADDE(r,2,8,9999,0) != 0 TUNC REDDE 65. FIN-SI.
    SI CH_GENUS(r,37) != 9 TUNC REDDE 65. FIN-SI.
    SI CH_SUPERFICIES(r,2) != 8192 TUNC REDDE 65. FIN-SI.
    SI CH_STATUS(r,1) != 7 TUNC REDDE 65. FIN-SI.
    SI CH_STATUS_PONE(r,1,42) != 1 TUNC REDDE 65. FIN-SI.
    SI CH_STATUS(r,1) != 42 TUNC REDDE 65. FIN-SI.
    SI CH_QUAERE(r,999) != 0 TUNC REDDE 65. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
