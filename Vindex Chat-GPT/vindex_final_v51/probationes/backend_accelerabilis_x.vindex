IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_vii.vindex".
IMPORTA "bibliotheca/imago_raster_vii.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_viii.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_x.vindex".
IMPORTA "bibliotheca/fenestrale_coda_graphica.vindex".
IMPORTA "bibliotheca/fenestrale_backend_x.vindex".
IMPORTA "bibliotheca/fenestrale_compositor_x.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA color SICUT NUMERUS VALENS 3351057.
    DECLARA src SICUT NUMERUS VALENS GX_CREA(6,4).
    SI src==0 TUNC REDDE 1. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_RECT_ALPHA(src,GVIII_RECT_CREA(0,0,6,4),color,255).

    DECLARA memoria SICUT NUMERUS VALENS RESERVA_OCTETA(96).
    SI memoria==0 TUNC REDDE 2. FIN-SI.
    f=GX_MEM_PURA(memoria,96).
    DECLARA target SICUT NUMERUS VALENS BX_TARGET_CREA(memoria,6,6,4,0).
    DECLARA backend SICUT NUMERUS VALENS BX_CREA_SW_TARGET(4,target).
    SI target==0 || backend==0 || BX_COMPATIBILIS(backend)==0 || BX_PARATUS(backend)==0 TUNC REDDE 3. FIN-SI.
    SI CONTENTUM(backend)!=BX_ABI() || CONTENTUM(backend+8)!=BX_GENUS_SOFTWARE() TUNC REDDE 4. FIN-SI.
    SI (CONTENTUM(backend+16)&BX_CAP_MINIMUM())!=BX_CAP_MINIMUM() TUNC REDDE 5. FIN-SI.
    SI (CONTENTUM(backend+16)&BX_CAP_TEXTURE())!=0 TUNC REDDE 6. FIN-SI.

    DECLARA a SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,3,4).
    DECLARA b SICUT NUMERUS VALENS GVIII_RECT_CREA(3,0,3,4).
    SI BX_FRAME_INCIPE(backend)!=1 TUNC REDDE 7. FIN-SI.
    SI BX_PRAESENTA_ADDE(backend,src,a)==0 || BX_PRAESENTA_ADDE(backend,src,b)==0 TUNC REDDE 8. FIN-SI.
    DECLARA q SICUT NUMERUS VALENS BX_CODA(backend).
    SI QVIII_NUMERUS(q)!=2 || QVIII_OPCODE(q,0)!=BX_OP_PRAESENTA() TUNC REDDE 9. FIN-SI.
    SI QVIII_A(q,0)!=src || QVIII_B(q,1)==0 || CONTENTUM(backend+64)!=2 TUNC REDDE 10. FIN-SI.
    SI BX_FRAME_COMMITTE(backend)!=1 || BX_FENCE_COMPLETA(backend)!=1 TUNC REDDE 11. FIN-SI.
    SI CONTENTUM(backend+72)!=2 || CONTENTUM(backend+32)!=0 || BX_ERRATUM(backend)!=0 TUNC REDDE 12. FIN-SI.
    SI OCTETUS_AB(memoria)!=17 || OCTETUS_AB(memoria+1)!=34 || OCTETUS_AB(memoria+2)!=51 || OCTETUS_AB(memoria+3)!=0 TUNC REDDE 13. FIN-SI.
    SI OCTETUS_AB(memoria+92)!=17 || OCTETUS_AB(memoria+94)!=51 || OCTETUS_AB(memoria+95)!=0 TUNC REDDE 14. FIN-SI.

    DECLARA memoria_bgr SICUT NUMERUS VALENS RESERVA_OCTETA(96).
    f=GX_MEM_PURA(memoria_bgr,96).
    DECLARA target_bgr SICUT NUMERUS VALENS BX_TARGET_CREA(memoria_bgr,6,6,4,1).
    DECLARA backend_bgr SICUT NUMERUS VALENS BX_CREA_SW_TARGET(2,target_bgr).
    SI BX_FRAME_INCIPE(backend_bgr)==0 || BX_PRAESENTA_ADDE(backend_bgr,src,GVIII_RECT_CREA(0,0,6,4))==0 TUNC REDDE 15. FIN-SI.
    SI BX_FRAME_COMMITTE(backend_bgr)!=1 TUNC REDDE 16. FIN-SI.
    SI OCTETUS_AB(memoria_bgr)!=51 || OCTETUS_AB(memoria_bgr+1)!=34 || OCTETUS_AB(memoria_bgr+2)!=17 || OCTETUS_AB(memoria_bgr+3)!=0 TUNC REDDE 17. FIN-SI.

    DECLARA parvus SICUT NUMERUS VALENS BX_CREA_SW_TARGET(1,target).
    SI BX_FRAME_INCIPE(parvus)==0 || BX_PRAESENTA_ADDE(parvus,src,a)==0 TUNC REDDE 18. FIN-SI.
    SI BX_PRAESENTA_ADDE(parvus,src,b)!=0 || BX_ERRATUM(parvus)!=3 TUNC REDDE 19. FIN-SI.
    SI BX_FRAME_ABICE(parvus)==0 || QVIII_NUMERUS(BX_CODA(parvus))!=0 TUNC REDDE 20. FIN-SI.

    DECLARA scena SICUT NUMERUS VALENS CX_SCENA_CREA(6,4,src).
    SI scena==0 || CX_SCENA_BACKEND(scena)==0 TUNC REDDE 21. FIN-SI.
    SI CX_SCENA_BACKEND_PONE(scena,backend)==0 TUNC REDDE 22. FIN-SI.
    SI CX_PRAESENTA_FB(scena)==0 || CX_DAMNA_RECT(scena)!=0 TUNC REDDE 23. FIN-SI.
    SI CONTENTUM(scena+104)!=24 || CONTENTUM(scena+120)!=2 || BX_FENCE_COMPLETA(backend)!=2 TUNC REDDE 24. FIN-SI.

    DECLARA gpu_fictum SICUT NUMERUS VALENS BX_CREA_SW_TARGET(2,target).
    CONTENTUM(gpu_fictum+8)=BX_GENUS_GPU().
    SI BX_COMPATIBILIS(gpu_fictum)==0 || BX_PARATUS(gpu_fictum)!=0 TUNC REDDE 25. FIN-SI.
    SI CX_SCENA_BACKEND_PONE(scena,gpu_fictum)!=0 TUNC REDDE 26. FIN-SI.
    DECLARA fallback SICUT NUMERUS VALENS BX_ELIGE(gpu_fictum,2).
    SI fallback==0 || CONTENTUM(fallback+8)!=BX_GENUS_SOFTWARE() || CONTENTUM(fallback+88)!=1 TUNC REDDE 27. FIN-SI.
    DECLARA target_fractus SICUT NUMERUS VALENS RESERVA_OCTETA(40).
    f=GX_MEM_PURA(target_fractus,40).
    DECLARA fractus SICUT NUMERUS VALENS BX_CREA_SW_TARGET(2,target_fractus).
    SI CX_SCENA_BACKEND_PONE(scena,fractus)==0 || CX_PRAESENTA_FB(scena)!=0 TUNC REDDE 28. FIN-SI.
    SI CX_DAMNA_RECT(scena)==0 TUNC REDDE 29. FIN-SI.
    SI CX_SCENA_BACKEND_PONE(scena,backend)==0 || CX_PRAESENTA_FB(scena)==0 TUNC REDDE 30. FIN-SI.
    SI CX_DAMNA_RECT(scena)!=0 || BX_FENCE_COMPLETA(backend)!=3 TUNC REDDE 31. FIN-SI.

    REDDE 0.
FIN-FUNCTIO.
