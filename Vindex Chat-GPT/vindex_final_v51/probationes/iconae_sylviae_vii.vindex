// P16-VII: atlas iconarum rasterarum applicationum.
IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_vii.vindex".
IMPORTA "bibliotheca/imago_raster_vii.vindex".
IMPORTA "bibliotheca/raster_rle_vii.vindex".
IMPORTA "bibliotheca/iconae_sylviae_vii.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA atlas SICUT TEXTUS VALENS ICVII_CREA().
    SI IR_VALIDUS(atlas)==0 TUNC REDDE 81. FIN-SI.
    SI IR_LATITUDO(atlas)!=96 || IR_ALTITUDO(atlas)!=96 || IR_STRIDE(atlas)!=384 TUNC REDDE 82. FIN-SI.

    DECLARA p1 SICUT NUMERUS VALENS IR_PIXEL_RGBA(atlas,24,24).
    DECLARA p2 SICUT NUMERUS VALENS IR_PIXEL_RGBA(atlas,72,24).
    DECLARA p3 SICUT NUMERUS VALENS IR_PIXEL_RGBA(atlas,24,72).
    DECLARA p4 SICUT NUMERUS VALENS IR_PIXEL_RGBA(atlas,72,72).
    SI ((p1>>24)&255)<200 || ((p2>>24)&255)<200 || ((p3>>24)&255)<200 || ((p4>>24)&255)<200 TUNC REDDE 83. FIN-SI.
    SI (p1&16777215)==(p2&16777215) || (p2&16777215)==(p3&16777215) || (p3&16777215)==(p4&16777215) TUNC REDDE 84. FIN-SI.

    SI ICVII_FONS_X(1)!=0 || ICVII_FONS_Y(1)!=0 TUNC REDDE 85. FIN-SI.
    SI ICVII_FONS_X(2)!=48 || ICVII_FONS_Y(2)!=0 TUNC REDDE 86. FIN-SI.
    SI ICVII_FONS_X(3)!=0 || ICVII_FONS_Y(3)!=48 TUNC REDDE 87. FIN-SI.
    SI ICVII_FONS_X(4)!=48 || ICVII_FONS_Y(4)!=48 TUNC REDDE 88. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
