IMPORTA "systema/rectores/pci.vindex".
IMPORTA "systema/rectores/mmio.vindex".
IMPORTA "systema/rectores/paginae_dma.vindex".
IMPORTA "systema/rectores/virtio_pci.vindex".
IMPORTA "systema/rectores/virtio_gpu.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI VQ_DESCRIPTORES_MENSURA(8) != 128 TUNC REDDE 1. FIN-SI.
    SI VQ_PRAEBITA_MENSURA(8) != 22 TUNC REDDE 2. FIN-SI.
    SI VQ_ADHIBITA_MENSURA(8) != 70 TUNC REDDE 3. FIN-SI.
    SI VQ_SPATIUM(8) != 224 TUNC REDDE 4. FIN-SI.
    SI VQ_POTENTIA_DUORUM(8) != 1 || VQ_POTENTIA_DUORUM(7) != 0 || VQ_POTENTIA_DUORUM(65536) != 0 TUNC REDDE 5. FIN-SI.
    SI VP_CAP_TERMINI(4096, 128, 256, 56) != 1 TUNC REDDE 6. FIN-SI.
    SI VP_CAP_TERMINI(4096, 4000, 128, 1) != 0 || VP_CAP_TERMINI(4096, 0, 1, 2) != 0 TUNC REDDE 7. FIN-SI.
    SI VP_CAP_ADRESSA(51539607552, 0) != 51539607552 || VP_CAP_ADRESSA(51539607552, 4096) != 51539611648 TUNC REDDE 40. FIN-SI.
    SI VP_CAP_ADRESSA(0, 0) != 0 || VP_CAP_ADRESSA(4096, -1) != 0 TUNC REDDE 41. FIN-SI.
    SI VP_NOTIFICATIONIS_INTERVALLUM(4096, 3, 4, 2) != 12 TUNC REDDE 8. FIN-SI.
    SI VP_NOTIFICATIONIS_INTERVALLUM(16, 4, 4, 2) != -1 TUNC REDDE 9. FIN-SI.

    DECLARA rudis SICUT NUMERUS VALENS RESERVA_OCTETA(8192).
    SI rudis == 0 TUNC REDDE 10. FIN-SI.
    DECLARA memoria SICUT NUMERUS VALENS ((rudis + 4095) / 4096) * 4096.
    DECLARA vexilla SICUT NUMERUS VALENS DMA_X86_COHERENS() | DMA_APPARATUS_LEGE() | DMA_APPARATUS_SCRIBE().
    DECLARA regio SICUT NUMERUS VALENS DMA_REGIO_ADOPTA(memoria, memoria, 4096, 4096, vexilla).
    SI regio == 0 TUNC REDDE 11. FIN-SI.
    DECLARA commune SICUT NUMERUS VALENS MMIO_REGIO_CREA(memoria + 2048, 64, MMIO_LECTIO() | MMIO_SCRIPTIO()).
    SI commune == 0 || VP_COMMUNE_SCRIBE64(commune, 0, 1234605616436508552) == 0 TUNC REDDE 12. FIN-SI.
    SI MR_LEGE32(commune, 0) != 1432778632 || MR_LEGE32(commune, 4) != 287454020 TUNC REDDE 13. FIN-SI.
    DECLARA coda SICUT NUMERUS VALENS VQ_CREA(regio, 8).
    SI coda == 0 TUNC REDDE 14. FIN-SI.
    SI CONTENTUM(coda + 16) != 0 || CONTENTUM(coda + 24) != 128 || CONTENTUM(coda + 32) != 152 TUNC REDDE 15. FIN-SI.
    SI CONTENTUM(coda + 120) != 224 || CONTENTUM(coda + 72) != 1 TUNC REDDE 16. FIN-SI.

    SI VG_DISPLAY_INFO_PRAEPARA(coda, 256, 512) == 0 TUNC REDDE 17. FIN-SI.
    SI DMA_LEGE32(regio, 256) != 256 || DMA_LEGE64(regio, 264) != 0 TUNC REDDE 16. FIN-SI.
    SI DMA_LEGE64(regio, 0) != memoria + 256 || DMA_LEGE32(regio, 8) != 24 TUNC REDDE 17. FIN-SI.
    SI DMA_LEGE16(regio, 12) != 1 || DMA_LEGE16(regio, 14) != 1 TUNC REDDE 18. FIN-SI.
    SI DMA_LEGE64(regio, 16) != memoria + 512 || DMA_LEGE32(regio, 24) != 408 TUNC REDDE 19. FIN-SI.
    SI DMA_LEGE16(regio, 28) != 2 || DMA_LEGE16(regio, 30) != 0 TUNC REDDE 20. FIN-SI.
    SI DMA_LEGE16(regio, 128) != 1 || DMA_LEGE16(regio, 130) != 1 || DMA_LEGE16(regio, 132) != 0 TUNC REDDE 21. FIN-SI.
    SI CONTENTUM(coda + 40) != 1 || CONTENTUM(coda + 112) != 1 TUNC REDDE 22. FIN-SI.

    SI DMA_SCRIBE32(regio, 152 + 4, 0) == 0 || DMA_SCRIBE32(regio, 152 + 8, 408) == 0 TUNC REDDE 23. FIN-SI.
    SI DMA_SCRIBE16(regio, 152 + 2, 1) == 0 TUNC REDDE 24. FIN-SI.
    SI DMA_SCRIBE32(regio, 512, 4353) == 0 TUNC REDDE 25. FIN-SI.
    SI DMA_SCRIBE32(regio, 512 + 32, 1280) == 0 || DMA_SCRIBE32(regio, 512 + 36, 800) == 0 TUNC REDDE 26. FIN-SI.
    SI DMA_SCRIBE32(regio, 512 + 40, 1) == 0 TUNC REDDE 27. FIN-SI.
    SI VQ_COMPLETUM(coda) != 1 TUNC REDDE 28. FIN-SI.
    SI CONTENTUM(coda + 56) != 0 || CONTENTUM(coda + 64) != 408 || CONTENTUM(coda + 112) != 0 TUNC REDDE 29. FIN-SI.
    SI VG_RESPONSUM_GENUS(coda, 512) != 4353 TUNC REDDE 30. FIN-SI.
    SI VG_SCANOUT_LATITUDO(coda, 512, 0) != 1280 || VG_SCANOUT_ALTITUDO(coda, 512, 0) != 800 TUNC REDDE 31. FIN-SI.
    SI VG_SCANOUT_ACTIVUS(coda, 512, 0) != 1 || VQ_COMPLETUM(coda) != 0 TUNC REDDE 32. FIN-SI.

    CONTENTUM(coda + 40) = 65535.
    SI DMA_SCRIBE16(regio, CONTENTUM(coda + 24) + 2, 65535) == 0 TUNC REDDE 33. FIN-SI.
    SI VQ_PRAEBE(coda, 0) == 0 TUNC REDDE 34. FIN-SI.
    SI CONTENTUM(coda + 40) != 0 || DMA_LEGE16(regio, CONTENTUM(coda + 24) + 2) != 0 TUNC REDDE 35. FIN-SI.
    SI DMA_LEGE16(regio, CONTENTUM(coda + 24) + 4 + 14) != 0 TUNC REDDE 36. FIN-SI.
    SI VQ_DESCRIPTOR_SCRIBE(coda, 8, memoria, 8, 0, 0) != 0 || VQ_ERRATUM(coda) != 3 TUNC REDDE 37. FIN-SI.
    SI VQ_DESCRIPTOR_SCRIBE(coda, 2, memoria, 8, 1, 2) != 0 || VQ_ERRATUM(coda) != 5 TUNC REDDE 38. FIN-SI.

    DECLARA parva SICUT NUMERUS VALENS DMA_REGIO_ADOPTA(memoria, memoria, 200, 4096, vexilla).
    SI parva == 0 || VQ_CREA(parva, 8) != 0 TUNC REDDE 39. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
