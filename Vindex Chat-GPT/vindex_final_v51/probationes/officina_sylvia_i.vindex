// Probatio P18-I — OFFICINA SYLVIAE: lineae UTF-8 et cursor dynamicus.
IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/officina_clientis_i.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA s SICUT NUMERUS VALENS OE_CREA().
    SI s==0 || CONTENTUM(s+32)!=1 TUNC REDDE 71. FIN-SI.

    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<300 PERFICE
        DECLARA a SICUT NUMERUS VALENS OE_INSERE_SCALARE(s,65+(i%26)).
        SI a==0 TUNC REDDE 65. FIN-SI.
        i=i+1.
    FIN-DUM.
    DECLARA linea SICUT NUMERUS VALENS CONTENTUM(s+16).
    DECLARA d SICUT NUMERUS VALENS CONTENTUM(linea).
    SI CONTENTUM(d)!=300 || CONTENTUM(d+8)<300 || CONTENTUM(s+24)!=300 TUNC REDDE 65. FIN-SI.

    i=0.
    DUM i<50 PERFICE
        DECLARA sin SICUT NUMERUS VALENS OE_CURSOR_SINISTRUM(s).
        i=i+1.
    FIN-DUM.
    SI CONTENTUM(s+24)!=250 TUNC REDDE 65. FIN-SI.

    // U+00E9: C3 A9; backspace totum scalare delet.
    DECLARA e SICUT NUMERUS VALENS OE_INSERE_SCALARE(s,233).
    d=CONTENTUM(CONTENTUM(s+16)).
    SI CONTENTUM(d)!=302 || OCTETUS_AB(d+266)!=195 || OCTETUS_AB(d+267)!=169 TUNC REDDE 65. FIN-SI.
    DECLARA retro SICUT NUMERUS VALENS OE_RETROCEDE(s).
    d=CONTENTUM(CONTENTUM(s+16)).
    SI CONTENTUM(d)!=300 || CONTENTUM(s+24)!=250 TUNC REDDE 65. FIN-SI.

    // U+1F600: F0 9F 98 80; contractus TEXTUS totum spatium Unicode servatur.
    DECLARA emoji SICUT NUMERUS VALENS OE_INSERE_SCALARE(s,128512).
    d=CONTENTUM(CONTENTUM(s+16)).
    SI emoji==0 || CONTENTUM(d)!=304 || CONTENTUM(s+24)!=254 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(d+266)!=240 || OCTETUS_AB(d+267)!=159 || OCTETUS_AB(d+268)!=152 || OCTETUS_AB(d+269)!=128 TUNC REDDE 65. FIN-SI.
    retro=OE_RETROCEDE(s).
    d=CONTENTUM(CONTENTUM(s+16)).
    SI CONTENTUM(d)!=300 || CONTENTUM(s+24)!=250 TUNC REDDE 65. FIN-SI.
    SI OE_INSERE_SCALARE(s,55296)!=0 || OE_INSERE_SCALARE(s,1114112)!=0 TUNC REDDE 65. FIN-SI.

    DECLARA nl SICUT NUMERUS VALENS OE_NOVA_LINEA(s).
    SI nl==0 || CONTENTUM(s+32)!=2 TUNC REDDE 65. FIN-SI.
    DECLARA prima SICUT NUMERUS VALENS CONTENTUM(s).
    DECLARA secunda SICUT NUMERUS VALENS CONTENTUM(prima+16).
    SI secunda==0 TUNC REDDE 65. FIN-SI.
    SI CONTENTUM(CONTENTUM(prima))!=250 || CONTENTUM(CONTENTUM(secunda))!=50 TUNC REDDE 65. FIN-SI.

    DECLARA dex SICUT NUMERUS VALENS OE_CURSOR_DEXTRUM(s).
    dex=OE_CURSOR_DEXTRUM(s). dex=OE_CURSOR_DEXTRUM(s). dex=OE_CURSOR_DEXTRUM(s). dex=OE_CURSOR_DEXTRUM(s).
    DECLARA sur SICUT NUMERUS VALENS OE_CURSOR_SURSUM(s).
    SI CONTENTUM(s+16)!=prima || CONTENTUM(s+24)!=5 TUNC REDDE 65. FIN-SI.
    DECLARA z SICUT NUMERUS VALENS OE_INSERE_SCALARE(s,90).
    SI CONTENTUM(CONTENTUM(prima))!=251 || CONTENTUM(s+24)!=6 TUNC REDDE 65. FIN-SI.
    DECLARA deorsum SICUT NUMERUS VALENS OE_CURSOR_DEORSUM(s).
    SI CONTENTUM(s+16)!=secunda || CONTENTUM(s+24)!=6 TUNC REDDE 65. FIN-SI.

    i=0.
    DUM i<80 PERFICE
        DECLARA ld SICUT NUMERUS VALENS CONTENTUM(CONTENTUM(s+16)).
        CONTENTUM(s+24)=CONTENTUM(ld).
        DECLARA nova SICUT NUMERUS VALENS OE_NOVA_LINEA(s).
        SI nova==0 TUNC REDDE 65. FIN-SI.
        i=i+1.
    FIN-DUM.
    SI CONTENTUM(s+32)!=82 TUNC REDDE 65. FIN-SI.

    DECLARA numeratae SICUT NUMERUS VALENS 0.
    DECLARA nodus SICUT NUMERUS VALENS CONTENTUM(s).
    DECLARA prior SICUT NUMERUS VALENS 0.
    DUM nodus!=0 PERFICE
        SI CONTENTUM(nodus+8)!=prior TUNC REDDE 65. FIN-SI.
        prior=nodus.
        nodus=CONTENTUM(nodus+16).
        numeratae=numeratae+1.
    FIN-DUM.
    SI numeratae!=82 || prior!=CONTENTUM(s+8) TUNC REDDE 65. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
