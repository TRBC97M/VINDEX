// Probatio executionis: coda circularis eventuum Fenestralis Purus G.

IMPORTA "bibliotheca/fenestrale_eventa_g.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA coda SICUT NUMERUS VALENS EG_CREA(3).
    SI coda == 0 TUNC REDDE 71. FIN-SI.
    SI EG_PONE(coda,1,1,10,20,100) != 1 TUNC REDDE 65. FIN-SI.
    SI EG_PONE(coda,1,2,30,40,200) != 1 TUNC REDDE 65. FIN-SI.
    SI EG_PONE(coda,2,1,50,60,300) != 1 TUNC REDDE 65. FIN-SI.
    SI EG_NUMERUS(coda) != 3 TUNC REDDE 65. FIN-SI.
    SI EG_PONE(coda,9,9,9,9,9) != 0 TUNC REDDE 65. FIN-SI.
    DECLARA e SICUT ORDO DE NUMERUS CAPACITAS 5.
    SI EG_CAPE(coda,e) != 1 TUNC REDDE 65. FIN-SI.
    SI e[0]!=1 || e[1]!=1 || e[2]!=10 || e[3]!=20 || e[4]!=100 TUNC REDDE 65. FIN-SI.
    SI EG_PONE(coda,3,2,70,80,400) != 1 TUNC REDDE 65. FIN-SI.
    SI EG_CAPE(coda,e) != 1 TUNC REDDE 65. FIN-SI.
    SI e[1]!=2 || e[2]!=30 || e[4]!=200 TUNC REDDE 65. FIN-SI.
    SI EG_CAPE(coda,e) != 1 TUNC REDDE 65. FIN-SI.
    SI e[0]!=2 || e[2]!=50 || e[4]!=300 TUNC REDDE 65. FIN-SI.
    SI EG_CAPE(coda,e) != 1 TUNC REDDE 65. FIN-SI.
    SI e[0]!=3 || e[1]!=2 || e[2]!=70 || e[3]!=80 || e[4]!=400 TUNC REDDE 65. FIN-SI.
    SI EG_NUMERUS(coda) != 0 TUNC REDDE 65. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
