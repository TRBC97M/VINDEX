IMPORTA "systema/rectores/pci.vindex".
IMPORTA "systema/rectores/mmio.vindex".
IMPORTA "systema/rectores/paginae_dma.vindex".
IMPORTA "systema/rectores/virtio_pci.vindex".
IMPORTA "systema/rectores/virtio_gpu.vindex".
IMPORTA "systema/rectores/virtio_gpu_3d.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI VG3D_F_VIRGL() != 1 || VG3D_F_CONTEXT_INIT() != 16 TUNC REDDE 1. FIN-SI.
    SI VG3D_FACULTATES_ACCIPE(0) != 0 || VG3D_FACULTATES_ACCIPE(16) != 0 TUNC REDDE 2. FIN-SI.
    SI VG3D_FACULTATES_ACCIPE(1) != 1 || VG3D_FACULTATES_ACCIPE(17) != 17 TUNC REDDE 3. FIN-SI.
    SI VG3D_CAPSET_MELIUS(0, 1) != 1 || VG3D_CAPSET_MELIUS(1, 2) != 2 TUNC REDDE 4. FIN-SI.
    SI VG3D_CAPSET_MELIUS(2, 1) != 2 || VG3D_CAPSET_MELIUS(0, 5) != 0 TUNC REDDE 5. FIN-SI.
    SI VG3D_CMD_CAPSET_INFO() != 264 || VG3D_CMD_CAPSET() != 265 TUNC REDDE 6. FIN-SI.
    SI VG3D_CMD_CTX_CREA() != 512 || VG3D_CMD_CTX_LIBERA() != 513 TUNC REDDE 7. FIN-SI.
    SI VG3D_RESP_CAPSET_INFO() != 4354 || VG3D_RESP_CAPSET() != 4355 || VG3D_RESP_NODATA() != 4352 TUNC REDDE 8. FIN-SI.
    SI VQ_CONFORMA(24 + 308, 8) != 336 TUNC REDDE 9. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
