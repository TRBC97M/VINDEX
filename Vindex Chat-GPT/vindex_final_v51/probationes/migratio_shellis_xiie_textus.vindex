FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA forma SICUT NUMERUS VALENS RESERVA_OCTETA(2048). SI forma<=0 TUNC REDDE 1. FIN-SI.
    DECLARA purum SICUT NUMERUS VALENS GX_MEM_PURA(forma,2048).
    SCRIBE_OCTETUM_AB(forma+65*8,129).
    DECLARA dst SICUT NUMERUS VALENS GX_CREA(20,12). SI dst==0 TUNC REDDE 2. FIN-SI.
    DECLARA color SICUT NUMERUS VALENS XIIE_COLOR(40,80,120).
    SI XIIE_TEXTUM_GX_FONTE(dst,2,2,"A",color,1,forma)==0 TUNC REDDE 3. FIN-SI.
    DECLARA q SICUT NUMERUS VALENS GX_PIX_PM_LEGE(dst,2,2).
    SI (q&255)!=40 || ((q>>8)&255)!=80 || ((q>>16)&255)!=120 || ((q>>24)&255)!=255 TUNC REDDE 4. FIN-SI.
    SI GX_PIX_PM_LEGE(dst,3,2)!=0 TUNC REDDE 5. FIN-SI.
    q=GX_PIX_PM_LEGE(dst,9,2).
    SI ((q>>24)&255)!=255 TUNC REDDE 6. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
