// Probatio P16-IV: catalogus applicationum dynamicus sine duobus slotis fixis.

IMPORTA "bibliotheca/applicationes_registrum_iv.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA r SICUT NUMERUS VALENS AI_CREA().
    SI r==0 TUNC REDDE 71. FIN-SI.

    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<96 PERFICE
        DECLARA id SICUT NUMERUS VALENS AI_ADDE(r,1000+i,(i%3)+1,"APPLICATIO",i%2).
        SI id!=i+1 TUNC REDDE 65. FIN-SI.
        i=i+1.
    FIN-DUM.

    SI AI_NUMERUS(r)!=96 TUNC REDDE 65. FIN-SI.
    SI AI_NODUS_ID(AI_PRIMUS(r))!=1 TUNC REDDE 65. FIN-SI.
    SI AI_NODUS_ID(AI_ULTIMUS(r))!=96 TUNC REDDE 65. FIN-SI.

    DECLARA n SICUT NUMERUS VALENS AI_PRIMUS(r).
    DECLARA numerus SICUT NUMERUS VALENS 0.
    DUM n!=0 PERFICE
        numerus=numerus+1.
        n=AI_PROXIMUS(n).
    FIN-DUM.
    SI numerus!=96 TUNC REDDE 65. FIN-SI.

    DECLARA q SICUT NUMERUS VALENS AI_QUAERE(r,64).
    SI q==0 TUNC REDDE 65. FIN-SI.
    SI AI_NODUS_CLIENTE(q)!=1063 TUNC REDDE 65. FIN-SI.
    SI AI_NODUS_GENUS(q)!=1 TUNC REDDE 65. FIN-SI.
    SI AI_NODUS_IN_BUREAU(q)!=1 TUNC REDDE 65. FIN-SI.
    SI AI_CLIENTIS(r,1063)!=q TUNC REDDE 65. FIN-SI.

    DECLARA nomen SICUT TEXTUS VALENS AI_NODUS_NOMEN(q).
    DECLARA sedes SICUT NUMERUS VALENS AI_TEXTUS_SEDES(nomen).
    SI sedes==0 || CONTENTUM(sedes)!=10 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(sedes+16)!=65 TUNC REDDE 65. FIN-SI.

    SI AI_ADDE(r,1063,9,"DUPLICATA",1)!=0 TUNC REDDE 65. FIN-SI.
    SI AI_NUMERUS(r)!=96 TUNC REDDE 65. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
