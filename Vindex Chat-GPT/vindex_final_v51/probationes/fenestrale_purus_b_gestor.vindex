// Diagnostica Gradus B: status, focus, z-order et geometria separatim.

FUNCTIO G_RELEGE_ACTIVUM REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    SI s[0] == 1 && s[1] == 0 TUNC REDDE 1. FIN-SI.
    SI s[0] == 2 && s[2] == 0 TUNC REDDE 2. FIN-SI.
    SI s[1] == 0 TUNC s[0] = 1. REDDE 1. FIN-SI.
    SI s[2] == 0 TUNC s[0] = 2. REDDE 2. FIN-SI.
    s[0] = 0.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO G_FOCUS REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    SI id == 1 && s[1] == 0 TUNC s[0] = 1. REDDE 1. FIN-SI.
    SI id == 2 && s[2] == 0 TUNC s[0] = 2. REDDE 1. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO G_IN_FENESTRA REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    SI id == 1 TUNC
        SI s[1] != 0 TUNC REDDE 0. FIN-SI.
        SI x >= s[3] && y >= s[4] && x < s[3] + s[5] && y < s[4] + s[6] TUNC REDDE 1. FIN-SI.
        REDDE 0.
    FIN-SI.
    SI id == 2 TUNC
        SI s[2] != 0 TUNC REDDE 0. FIN-SI.
        SI x >= s[7] && y >= s[8] && x < s[7] + s[9] && y < s[8] + s[10] TUNC REDDE 1. FIN-SI.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO G_HIT REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    SI s[0] == 1 TUNC
        SI G_IN_FENESTRA(s,1,x,y) == 1 TUNC REDDE 1. FIN-SI.
        SI G_IN_FENESTRA(s,2,x,y) == 1 TUNC REDDE 2. FIN-SI.
    FIN-SI.
    SI s[0] == 2 TUNC
        SI G_IN_FENESTRA(s,2,x,y) == 1 TUNC REDDE 2. FIN-SI.
        SI G_IN_FENESTRA(s,1,x,y) == 1 TUNC REDDE 1. FIN-SI.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO G_MAX_TOGGLE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    DECLARA w SICUT NUMERUS VALENS 1280.
    DECLARA h SICUT NUMERUS VALENS 692.
    SI id == 1 TUNC
        SI s[17] == 0 TUNC
            s[18]=s[3]. s[19]=s[4]. s[20]=s[5]. s[21]=s[6].
            s[3]=0. s[4]=0. s[5]=w. s[6]=h. s[17]=1.
        ALITER
            s[3]=s[18]. s[4]=s[19]. s[5]=s[20]. s[6]=s[21]. s[17]=0.
        FIN-SI.
        REDDE 1.
    FIN-SI.
    SI id == 2 TUNC
        SI s[22] == 0 TUNC
            s[23]=s[7]. s[24]=s[8]. s[25]=s[9]. s[26]=s[10].
            s[7]=0. s[8]=0. s[9]=w. s[10]=h. s[22]=1.
        ALITER
            s[7]=s[23]. s[8]=s[24]. s[9]=s[25]. s[10]=s[26]. s[22]=0.
        FIN-SI.
        REDDE 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO G_MINIMIZA REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    SI id == 1 && s[1] == 0 TUNC s[1] = 1. FIN-SI.
    SI id == 2 && s[2] == 0 TUNC s[2] = 1. FIN-SI.
    REDDE G_RELEGE_ACTIVUM(s).
FIN-FUNCTIO.

FUNCTIO G_CLAUDE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    SI id == 1 TUNC s[1]=2. FIN-SI.
    SI id == 2 TUNC s[2]=2. FIN-SI.
    s[14]=0.
    REDDE G_RELEGE_ACTIVUM(s).
FIN-FUNCTIO.

FUNCTIO G_DRAG REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    DECLARA id SICUT NUMERUS VALENS s[14].
    SI id == 0 TUNC REDDE 0. FIN-SI.
    DECLARA nx SICUT NUMERUS VALENS s[11]-s[15].
    DECLARA ny SICUT NUMERUS VALENS s[12]-s[16].
    DECLARA ww SICUT NUMERUS VALENS s[5].
    DECLARA hh SICUT NUMERUS VALENS s[6].
    SI id == 2 TUNC ww=s[9]. hh=s[10]. FIN-SI.
    SI nx < 0 TUNC nx=0. FIN-SI. SI ny < 0 TUNC ny=0. FIN-SI.
    SI nx+ww > 1280 TUNC nx=1280-ww. FIN-SI.
    SI ny+hh > 692 TUNC ny=692-hh. FIN-SI.
    SI id == 1 TUNC s[3]=nx. s[4]=ny. ALITER s[7]=nx. s[8]=ny. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO G_MOVE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    DECLARA id SICUT NUMERUS VALENS s[0].
    SI id == 0 TUNC REDDE 0. FIN-SI.
    DECLARA x SICUT NUMERUS VALENS s[3]. DECLARA y SICUT NUMERUS VALENS s[4].
    DECLARA ww SICUT NUMERUS VALENS s[5]. DECLARA hh SICUT NUMERUS VALENS s[6].
    SI id == 2 TUNC x=s[7]. y=s[8]. ww=s[9]. hh=s[10]. FIN-SI.
    x=x+dx. y=y+dy.
    SI x < 0 TUNC x=0. FIN-SI. SI y < 0 TUNC y=0. FIN-SI.
    SI x+ww > 1280 TUNC x=1280-ww. FIN-SI.
    SI y+hh > 692 TUNC y=692-hh. FIN-SI.
    SI id == 1 TUNC s[3]=x. s[4]=y. ALITER s[7]=x. s[8]=y. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO G_TAB REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    SI s[0] == 1 && s[2] == 0 TUNC s[0]=2. REDDE 1. FIN-SI.
    SI s[0] == 2 && s[1] == 0 TUNC s[0]=1. REDDE 1. FIN-SI.
    SI s[1] == 0 TUNC s[0]=1. REDDE 1. FIN-SI.
    SI s[2] == 0 TUNC s[0]=2. REDDE 1. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA s SICUT ORDO DE NUMERUS CAPACITAS 32.
    s[0]=1. s[1]=0. s[2]=0. s[3]=40. s[4]=40. s[5]=700. s[6]=440.
    s[7]=600. s[8]=120. s[9]=520. s[10]=380. s[11]=300. s[12]=200.
    DECLARA h SICUT NUMERUS VALENS G_HIT(s,300,200).
    DECLARA f SICUT NUMERUS VALENS G_FOCUS(s,h).
    DECLARA m SICUT NUMERUS VALENS G_MAX_TOGGLE(s,1).
    DECLARA n SICUT NUMERUS VALENS G_MINIMIZA(s,2).
    DECLARA t SICUT NUMERUS VALENS G_TAB(s).
    DECLARA d SICUT NUMERUS VALENS G_DRAG(s).
    DECLARA v SICUT NUMERUS VALENS G_MOVE(s,12,0).
    REDDE f+m+n+t+d+v.
FIN-FUNCTIO.