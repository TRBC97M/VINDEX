// Regressio: vetus hash base XXXI confundebat `vp` et `x2` (3770).
FUNCTIO RECTE REDDENS NUMERUS.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO COLLISIO_VP_X2 REDDENS NUMERUS.
    ACCIPIT systema SICUT NUMERUS.
    ACCIPIT bus SICUT NUMERUS.
    ACCIPIT apparatus SICUT NUMERUS.
    ACCIPIT functio SICUT NUMERUS.
    DECLARA gestor SICUT NUMERUS VALENS 9001.
    DECLARA pura SICUT NUMERUS VALENS 1.
    DECLARA vp SICUT NUMERUS VALENS 123456.
    SI RECTE()==0 TUNC DECLARA x0 SICUT NUMERUS VALENS 0. REDDE 40. FIN-SI.
    DECLARA oblatae SICUT NUMERUS VALENS 257.
    SI RECTE()==0 TUNC DECLARA x1 SICUT NUMERUS VALENS 0. REDDE 41. FIN-SI.
    DECLARA acceptae SICUT NUMERUS VALENS oblatae.
    SI RECTE()==0 TUNC DECLARA x2 SICUT NUMERUS VALENS 0. REDDE 42. FIN-SI.
    SI vp!=123456 TUNC REDDE 24. FIN-SI.
    SI gestor!=9001 || pura!=1 || oblatae!=257 || acceptae!=257 TUNC REDDE 25. FIN-SI.
    SI systema!=11 || bus!=22 || apparatus!=33 || functio!=44 TUNC REDDE 26. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    REDDE COLLISIO_VP_X2(11,22,33,44).
FIN-FUNCTIO.
