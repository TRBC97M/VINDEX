IMPORTA "systema/rectores/pci.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI PCI_BAR_REGISTRUM(0) != 16 || PCI_BAR_REGISTRUM(5) != 36 TUNC REDDE 1. FIN-SI.
    SI PCI_BAR_EST_MEMORIA(4096) != 1 || PCI_BAR_EST_MEMORIA(49153) != 0 TUNC REDDE 2. FIN-SI.
    SI PCI_BAR_EST_LXIV(4) != 1 || PCI_BAR_EST_LXIV(0) != 0 || PCI_BAR_EST_LXIV(1) != 0 TUNC REDDE 3. FIN-SI.
    SI PCI_BAR_PRAEFETCHABILIS(8) != 1 || PCI_BAR_PRAEFETCHABILIS(0) != 0 TUNC REDDE 4. FIN-SI.
    SI PCI_BAR_ADRESSA(49153) != 49152 || PCI_BAR_ADRESSA(305419896) != 305419888 TUNC REDDE 5. FIN-SI.
    SI PCI_BAR_ADRESSA_EX(4293918724, 1) != 8588886016 TUNC REDDE 6. FIN-SI.
    SI PCI_BAR_MENSURA_EX(4293918720, 0) != 1048576 TUNC REDDE 7. FIN-SI.
    SI PCI_BAR_MENSURA_EX(4294967041, 0) != 256 TUNC REDDE 8. FIN-SI.
    SI PCI_BAR_MENSURA_EX(4292870148, 4294967295) != 2097152 TUNC REDDE 9. FIN-SI.
    SI PCI_BAR_MENSURA_EX(4, 4294967295) != 4294967296 TUNC REDDE 10. FIN-SI.
    SI PCI_BAR_MENSURA_EX(0, 0) != 0 TUNC REDDE 11. FIN-SI.
    SI PCI_BAR_LIMES_EX(0) != 6 || PCI_BAR_LIMES_EX(128) != 6 TUNC REDDE 12. FIN-SI.
    SI PCI_BAR_LIMES_EX(1) != 2 || PCI_BAR_LIMES_EX(129) != 2 TUNC REDDE 13. FIN-SI.
    SI PCI_BAR_LIMES_EX(2) != 1 || PCI_BAR_LIMES_EX(3) != 0 TUNC REDDE 14. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
