// Probatio minima Gradus B: UEFI_VOCA6 cum vectoribus VINDEX.

FUNCTIO PROBA_VOCA REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    DECLARA data SICUT ORDO DE NUMERUS CAPACITAS 4.
    DECLARA functio SICUT NUMERUS VALENS s[0].
    SI functio == 0 TUNC REDDE 0. FIN-SI.
    REDDE UEFI_VOCA6(functio, s[1], SEDES(data), 0, 0, 0, 0).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA s SICUT ORDO DE NUMERUS CAPACITAS 2.
    s[0] = 1.
    s[1] = 2.
    DECLARA r SICUT NUMERUS VALENS PROBA_VOCA(s).
    REDDE r.
FIN-FUNCTIO.