IMPORTA "bibliotheca/simg_ii.vindex".
IMPORTA "bibliotheca/simg_ii_compat_v1.vindex".
IMPORTA "bibliotheca/simg_ii_bridge_vii.vindex".
IMPORTA "bibliotheca/simg_ii_assetum.vindex".

FUNCTIO P_AII_PIXEL REDDENS TEXTUS.
    ACCIPIT r SICUT NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    DECLARA d SICUT NUMERUS VALENS RESERVA_OCTETA(21).
    SI d<=0 TUNC
        REDDE 0.
    FIN-SI.
    CONTENTUM(d)=4.
    CONTENTUM(d+8)=4.
    SCRIBE_OCTETUM_AB(d+16,r).
    SCRIBE_OCTETUM_AB(d+17,g).
    SCRIBE_OCTETUM_AB(d+18,b).
    SCRIBE_OCTETUM_AB(d+19,a).
    SCRIBE_OCTETUM_AB(d+20,0).
    REDDE d.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA ruber SICUT TEXTUS VALENS P_AII_PIXEL(255,0,0,255).
    DECLARA viridis SICUT TEXTUS VALENS P_AII_PIXEL(0,255,0,255).
    DECLARA caeruleus SICUT TEXTUS VALENS P_AII_PIXEL(0,0,255,255).
    DECLARA albus SICUT TEXTUS VALENS P_AII_PIXEL(255,255,255,255).
    DECLARA i1000 SICUT TEXTUS VALENS SII_CREA_RGBA(1,1,ruber,0,2,1000).
    DECLARA i1500 SICUT TEXTUS VALENS SII_CREA_RGBA(1,1,viridis,0,2,1500).
    DECLARA i2000 SICUT TEXTUS VALENS SII_CREA_RGBA(1,1,caeruleus,1,2,2000).
    DECLARA alius SICUT TEXTUS VALENS SII_CREA_RGBA(1,1,albus,0,2,1000).
    SI SII_VALIDUS(i1000)==0 || SII_VALIDUS(i1500)==0 || SII_VALIDUS(i2000)==0 || SII_VALIDUS(alius)==0 TUNC
        REDDE 1.
    FIN-SI.

    DECLARA a SICUT NUMERUS VALENS AII_CREA(1600).
    SI a==0 || AII_NUMERUS(a)!=0 || AII_SCALA(a)!=1600 || AII_GENERATIO(a)!=1 TUNC
        REDDE 2.
    FIN-SI.
    DECLARA n1000 SICUT NUMERUS VALENS AII_ADDE(a,7,i1000).
    DECLARA n1500 SICUT NUMERUS VALENS AII_ADDE(a,7,i1500).
    DECLARA n2000 SICUT NUMERUS VALENS AII_ADDE(a,7,i2000).
    DECLARA n8 SICUT NUMERUS VALENS AII_ADDE(a,8,alius).
    SI n1000==0 || n1500==0 || n2000==0 || n8==0 || AII_NUMERUS(a)!=4 TUNC
        REDDE 3.
    FIN-SI.
    SI AII_ADDE(a,7,i1500)!=0 TUNC
        REDDE 4.
    FIN-SI.
    SI AII_VARIANS_EXACTA(a,7,1500)!=n1500 TUNC
        REDDE 5.
    FIN-SI.

    // 1600 petit minimam variantem supra: 2000.
    DECLARA opt SICUT TEXTUS VALENS AII_OPTIMUM(a,7).
    SI SII_SCALA(opt)!=2000 || SII_PIXEL_RGBA(opt,0,0)!=4294901760 TUNC
        REDDE 6.
    FIN-SI.
    SI AII_USUS(n2000)!=1 TUNC
        REDDE 7.
    FIN-SI.

    // Exacta 1500 vincit.
    SI AII_SCALA_PONE(a,1500)==0 TUNC
        REDDE 8.
    FIN-SI.
    opt=AII_OPTIMUM(a,7).
    SI SII_SCALA(opt)!=1500 || SII_PIXEL_RGBA(opt,0,0)!=4278255360 TUNC
        REDDE 9.
    FIN-SI.

    // Supra maximam: maxima infra 2000.
    DECLARA g0 SICUT NUMERUS VALENS AII_GENERATIO(a).
    SI AII_SCALA_PONE(a,2200)==0 || AII_GENERATIO(a)!=g0+1 TUNC
        REDDE 10.
    FIN-SI.
    opt=AII_OPTIMUM(a,7).
    SI SII_SCALA(opt)!=2000 TUNC
        REDDE 11.
    FIN-SI.

    // Infra minimam: minima supra 1000.
    SI AII_SCALA_PONE(a,900)==0 TUNC
        REDDE 12.
    FIN-SI.
    opt=AII_OPTIMUM(a,7).
    SI SII_SCALA(opt)!=1000 || SII_PIXEL_RGBA(opt,0,0)!=4278190335 TUNC
        REDDE 13.
    FIN-SI.

    // Cache ad pipeline v1 semel creatur et deinde idem descriptor redditur.
    SI AII_SCALA_PONE(a,1600)==0 TUNC
        REDDE 14.
    FIN-SI.
    DECLARA c1 SICUT TEXTUS VALENS AII_V1_CACHE(a,7).
    DECLARA c2 SICUT TEXTUS VALENS AII_V1_CACHE(a,7).
    SI SII_V1_VALIDUS(c1)==0 || SII_V1_VALIDUS(c2)==0 TUNC
        REDDE 15.
    FIN-SI.
    SI SII_TEXTUS_SEDES(c1)!=SII_TEXTUS_SEDES(c2) TUNC
        REDDE 16.
    FIN-SI.
    SI SII_U32_LE(SII_CORPUS(c1)+24,0)!=4294901760 TUNC
        REDDE 17.
    FIN-SI.
    SI AII_USUS(n2000)<3 TUNC
        REDDE 18.
    FIN-SI.

    // Id aliud suam familiam habet.
    DECLARA x SICUT TEXTUS VALENS AII_OPTIMUM(a,8).
    SI SII_PIXEL_RGBA(x,0,0)!=4294967295 TUNC
        REDDE 19.
    FIN-SI.
    SI AII_OPTIMUM_NODUS(a,999)!=0 TUNC
        REDDE 20.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
