IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_vii.vindex".
IMPORTA "bibliotheca/imago_raster_vii.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA d SICUT NUMERUS VALENS RESERVA_OCTETA(49).
    SI d<=0 TUNC REDDE 1. FIN-SI.
    CONTENTUM(d)=32.
    CONTENTUM(d+8)=32.
    DECLARA b SICUT NUMERUS VALENS d+16.

    // SIMG v1, RGBA8888, 2x1, stride VIII.
    SCRIBE_OCTETUM_AB(b,83). SCRIBE_OCTETUM_AB(b+1,73). SCRIBE_OCTETUM_AB(b+2,77). SCRIBE_OCTETUM_AB(b+3,71).
    SCRIBE_OCTETUM_AB(b+4,1). SCRIBE_OCTETUM_AB(b+5,1). SCRIBE_OCTETUM_AB(b+6,0). SCRIBE_OCTETUM_AB(b+7,0).
    SCRIBE_OCTETUM_AB(b+8,2). SCRIBE_OCTETUM_AB(b+9,0). SCRIBE_OCTETUM_AB(b+10,0). SCRIBE_OCTETUM_AB(b+11,0).
    SCRIBE_OCTETUM_AB(b+12,1). SCRIBE_OCTETUM_AB(b+13,0). SCRIBE_OCTETUM_AB(b+14,0). SCRIBE_OCTETUM_AB(b+15,0).
    SCRIBE_OCTETUM_AB(b+16,8). SCRIBE_OCTETUM_AB(b+17,0). SCRIBE_OCTETUM_AB(b+18,0). SCRIBE_OCTETUM_AB(b+19,0).
    SCRIBE_OCTETUM_AB(b+20,0). SCRIBE_OCTETUM_AB(b+21,0). SCRIBE_OCTETUM_AB(b+22,0). SCRIBE_OCTETUM_AB(b+23,0).

    // Pixel I ruber opacus; pixel II caeruleus dimidius.
    SCRIBE_OCTETUM_AB(b+24,255). SCRIBE_OCTETUM_AB(b+25,0). SCRIBE_OCTETUM_AB(b+26,0). SCRIBE_OCTETUM_AB(b+27,255).
    SCRIBE_OCTETUM_AB(b+28,0). SCRIBE_OCTETUM_AB(b+29,0). SCRIBE_OCTETUM_AB(b+30,255). SCRIBE_OCTETUM_AB(b+31,128).

    DECLARA imago SICUT TEXTUS VALENS d.
    SI IR_VALIDUS(imago)==0 TUNC REDDE 2. FIN-SI.
    SI IR_LATITUDO(imago)!=2 || IR_ALTITUDO(imago)!=1 || IR_STRIDE(imago)!=8 TUNC REDDE 3. FIN-SI.
    SI IR_PIXEL_RGBA(imago,0,0)!=4278190335 TUNC REDDE 4. FIN-SI.
    SI IR_PIXEL_RGBA(imago,1,0)!=2164195328 TUNC REDDE 5. FIN-SI.
    SI IR_PIXEL_RGBA(imago,2,0)!=-1 TUNC REDDE 6. FIN-SI.

    SCRIBE_OCTETUM_AB(b,0).
    SI IR_VALIDUS(imago)!=0 TUNC REDDE 7. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
