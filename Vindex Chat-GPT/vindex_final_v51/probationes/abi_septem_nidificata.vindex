// Regressio ABI SysV x86-64: septimum argumentum per acervum, etiam intra
// functionem quae ipsa argumenta et locales possidet.

FUNCTIO ABI7_CALLEE REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT d SICUT NUMERUS.
    ACCIPIT e SICUT NUMERUS.
    ACCIPIT f SICUT NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    REDDE a + b * 10 + c * 100 + d * 1000 + e * 10000 + f * 100000 + g * 1000000.
FIN-FUNCTIO.

FUNCTIO ABI7_NIDUS REDDENS NUMERUS.
    ACCIPIT radix SICUT NUMERUS.
    ACCIPIT additio SICUT NUMERUS.
    DECLARA a SICUT NUMERUS VALENS 1 + additio.
    DECLARA b SICUT NUMERUS VALENS 2 + additio.
    DECLARA c SICUT NUMERUS VALENS 3 + additio.
    DECLARA d SICUT NUMERUS VALENS 4 + additio.
    DECLARA e SICUT NUMERUS VALENS 5 + additio.
    DECLARA f SICUT NUMERUS VALENS 6 + additio.
    DECLARA g SICUT NUMERUS VALENS radix + additio.
    REDDE ABI7_CALLEE(a, b, c, d, e, f, g).
FIN-FUNCTIO.

FUNCTIO ABI7_NIDUS_IMMEDIATUS REDDENS NUMERUS.
    ACCIPIT nihil SICUT NUMERUS.
    DECLARA custodia SICUT NUMERUS VALENS nihil + 1234.
    SI custodia < 0 TUNC REDDE 0. FIN-SI.
    REDDE ABI7_CALLEE(1, 2, 3, 4, 5, 6, 7).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA directe SICUT NUMERUS VALENS ABI7_CALLEE(1, 2, 3, 4, 5, 6, 7).
    SI directe != 7654321 TUNC REDDE 1. FIN-SI.
    DECLARA immediatum SICUT NUMERUS VALENS ABI7_NIDUS_IMMEDIATUS(9).
    SI immediatum != 7654321 TUNC REDDE 2. FIN-SI.
    DECLARA nidum SICUT NUMERUS VALENS ABI7_NIDUS(7, 0).
    SI nidum != 7654321 TUNC REDDE 3. FIN-SI.
    DECLARA nidum2 SICUT NUMERUS VALENS ABI7_NIDUS(8, 1).
    SI nidum2 != 9765432 TUNC REDDE 4. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
