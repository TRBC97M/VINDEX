IMPORTA "bibliotheca/simg_ii_compat_v1.vindex".

FUNCTIO P_V1_CREA REDDENS TEXTUS.
    DECLARA d SICUT NUMERUS VALENS RESERVA_OCTETA(49).
    SI d<=0 TUNC
        REDDE 0.
    FIN-SI.
    CONTENTUM(d)=32.
    CONTENTUM(d+8)=32.
    DECLARA b SICUT NUMERUS VALENS d+16.
    SCRIBE_OCTETUM_AB(b,83).
    SCRIBE_OCTETUM_AB(b+1,73).
    SCRIBE_OCTETUM_AB(b+2,77).
    SCRIBE_OCTETUM_AB(b+3,71).
    SCRIBE_OCTETUM_AB(b+4,1).
    SCRIBE_OCTETUM_AB(b+5,1).
    SCRIBE_OCTETUM_AB(b+6,0).
    SCRIBE_OCTETUM_AB(b+7,0).
    DECLARA z SICUT NUMERUS VALENS SII_U32_PONE(b+8,2).
    z=SII_U32_PONE(b+12,1).
    z=SII_U32_PONE(b+16,8).
    z=SII_U32_PONE(b+20,0).
    // Ruber opacus et caeruleus alpha CXXVIII.
    SCRIBE_OCTETUM_AB(b+24,255).
    SCRIBE_OCTETUM_AB(b+25,0).
    SCRIBE_OCTETUM_AB(b+26,0).
    SCRIBE_OCTETUM_AB(b+27,255).
    SCRIBE_OCTETUM_AB(b+28,0).
    SCRIBE_OCTETUM_AB(b+29,0).
    SCRIBE_OCTETUM_AB(b+30,255).
    SCRIBE_OCTETUM_AB(b+31,128).
    SCRIBE_OCTETUM_AB(b+32,0).
    REDDE d.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA vetus SICUT TEXTUS VALENS P_V1_CREA().
    SI SII_V1_VALIDUS(vetus)==0 TUNC
        REDDE 1.
    FIN-SI.
    DECLARA novum SICUT TEXTUS VALENS SII_EX_V1(vetus,2,1000,0).
    SI SII_VALIDUS(novum)==0 TUNC
        REDDE 2.
    FIN-SI.
    SI SII_LATITUDO(novum)!=2 || SII_ALTITUDO(novum)!=1 TUNC
        REDDE 3.
    FIN-SI.
    SI SII_GENUS(novum)!=2 || SII_COMPRESSIO(novum)!=0 TUNC
        REDDE 4.
    FIN-SI.
    SI SII_PIXEL_RGBA(novum,0,0)!=4278190335 TUNC
        REDDE 5.
    FIN-SI.
    SI SII_PIXEL_RGBA(novum,1,0)!=2164195328 TUNC
        REDDE 6.
    FIN-SI.

    DECLARA rle SICUT TEXTUS VALENS SII_EX_V1(vetus,2,2000,1).
    SI SII_VALIDUS(rle)==0 || SII_COMPRESSIO(rle)!=1 || SII_SCALA(rle)!=2000 TUNC
        REDDE 7.
    FIN-SI.
    SI SII_PIXEL_RGBA(rle,0,0)!=4278190335 || SII_PIXEL_RGBA(rle,1,0)!=2164195328 TUNC
        REDDE 8.
    FIN-SI.

    DECLARA vb SICUT NUMERUS VALENS SII_CORPUS(vetus).
    SCRIBE_OCTETUM_AB(vb,0).
    SI SII_V1_VALIDUS(vetus)!=0 TUNC
        REDDE 9.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
