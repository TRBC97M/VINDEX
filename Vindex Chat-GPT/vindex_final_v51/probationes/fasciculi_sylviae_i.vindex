// Probatio P19-I — contractus puri viarum ante backend firmware.
// VINDEX importationes ordine canonico tractat: dependentia TEXTUS primo venit.
IMPORTA "bibliotheca/textus.vindex".
IMPORTA "bibliotheca/fasciculi_sylviae_i.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA via SICUT TEXTUS VALENS "A/é/😀.VIX".
    DECLARA u16 SICUT NUMERUS VALENS FU_VIA_UTF16(via).
    SI u16==0 TUNC REDDE 65. FIN-SI.

    // A\é\😀.VIX + NUL in UTF-16LE.
    SI OCTETUS_AB(u16)!=65 || OCTETUS_AB(u16+1)!=0 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(u16+2)!=92 || OCTETUS_AB(u16+3)!=0 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(u16+4)!=233 || OCTETUS_AB(u16+5)!=0 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(u16+6)!=92 || OCTETUS_AB(u16+7)!=0 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(u16+8)!=61 || OCTETUS_AB(u16+9)!=216 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(u16+10)!=0 || OCTETUS_AB(u16+11)!=222 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(u16+12)!=46 || OCTETUS_AB(u16+13)!=0 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(u16+14)!=86 || OCTETUS_AB(u16+16)!=73 || OCTETUS_AB(u16+18)!=88 TUNC REDDE 65. FIN-SI.
    SI OCTETUS_AB(u16+20)!=0 || OCTETUS_AB(u16+21)!=0 TUNC REDDE 65. FIN-SI.

    DECLARA modus SICUT NUMERUS VALENS FU_MODUS_CREANDI().
    SI (modus&3)!=3 || ((modus>>63)&1)!=1 TUNC REDDE 65. FIN-SI.

    DECLARA a SICUT TEXTUS VALENS "SYLVIA".
    DECLARA b SICUT TEXTUS VALENS "SYLVIA".
    DECLARA c SICUT TEXTUS VALENS "VINDEX".
    SI FS_TEXTUS_AEQUALIS(a,b)!=1 || FS_TEXTUS_AEQUALIS(a,c)!=0 TUNC REDDE 65. FIN-SI.

    REDDE 0.
FIN-FUNCTIO.
