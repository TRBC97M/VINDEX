// Regressio ABI: expressiones quae ipsae functiones vocant intra argumenta
// vocationis exterioris. Valores priorum argumentorum servari debent.

FUNCTIO ABI_NID_CONST_A REDDENS NUMERUS.
    REDDE 3.
FIN-FUNCTIO.

FUNCTIO ABI_NID_CONST_B REDDENS NUMERUS.
    REDDE 5.
FIN-FUNCTIO.

FUNCTIO ABI_NID_SEX REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT d SICUT NUMERUS.
    ACCIPIT e SICUT NUMERUS.
    ACCIPIT f SICUT NUMERUS.
    REDDE a + b*10 + c*100 + d*1000 + e*10000 + f*100000.
FIN-FUNCTIO.

FUNCTIO ABI_NID_SEPTEM REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT d SICUT NUMERUS.
    ACCIPIT e SICUT NUMERUS.
    ACCIPIT f SICUT NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    REDDE a + b*10 + c*100 + d*1000 + e*10000 + f*100000 + g*1000000.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA sex SICUT NUMERUS VALENS ABI_NID_SEX(1,2,ABI_NID_CONST_A(),4,ABI_NID_CONST_B(),6).
    SI sex != 654321 TUNC REDDE 1. FIN-SI.

    DECLARA septem SICUT NUMERUS VALENS ABI_NID_SEPTEM(1,2,ABI_NID_CONST_A(),4,ABI_NID_CONST_B(),6,7).
    SI septem != 7654321 TUNC REDDE 2. FIN-SI.

    // Etiam primum argumentum potest vocatio esse: argumenta sequentia
    // non debent eventum prioris vocationis corrumpere.
    DECLARA initium SICUT NUMERUS VALENS ABI_NID_SEX(ABI_NID_CONST_A(),2,3,4,5,6).
    SI initium != 654323 TUNC REDDE 3. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
