// Diagnostica Gradus B: taskbar, mouse-down et claves cum stubs VINDEX.

FUNCTIO X_RELEGE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    REDDE s[0].
FIN-FUNCTIO.

FUNCTIO X_FOCUS REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    s[0]=id.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO X_HIT REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    REDDE s[0].
FIN-FUNCTIO.

FUNCTIO X_MAX REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    REDDE id.
FIN-FUNCTIO.

FUNCTIO X_MIN REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    SI id==1 TUNC
        s[1]=1.
    ALITER
        s[2]=1.
    FIN-SI.
    REDDE X_RELEGE(s).
FIN-FUNCTIO.

FUNCTIO X_CLOSE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    SI id==1 TUNC
        s[1]=2.
    ALITER
        s[2]=2.
    FIN-SI.
    REDDE X_RELEGE(s).
FIN-FUNCTIO.

FUNCTIO X_MOVE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT dx SICUT NUMERUS.
    ACCIPIT dy SICUT NUMERUS.
    s[3]=s[3]+dx.
    s[4]=s[4]+dy.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO X_TAB REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    SI s[0]==1 TUNC
        s[0]=2.
    ALITER
        s[0]=1.
    FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO X_TASKBAR_CLICK REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    SI x >= 98 && x < 286 && s[1] != 2 TUNC
        SI s[1] == 1 TUNC s[1]=0. s[0]=1. REDDE 1. FIN-SI.
        SI s[0] == 1 TUNC DECLARA m SICUT NUMERUS VALENS X_MIN(s,1). REDDE 1. FIN-SI.
        s[0]=1. REDDE 1.
    FIN-SI.
    SI x >= 292 && x < 430 && s[2] != 2 TUNC
        SI s[2] == 1 TUNC s[2]=0. s[0]=2. REDDE 1. FIN-SI.
        SI s[0] == 2 TUNC DECLARA m2 SICUT NUMERUS VALENS X_MIN(s,2). REDDE 1. FIN-SI.
        s[0]=2. REDDE 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO X_MOUSE_DOWN REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    DECLARA mx SICUT NUMERUS VALENS s[11].
    DECLARA my SICUT NUMERUS VALENS s[12].
    SI my >= 692 TUNC REDDE X_TASKBAR_CLICK(s,mx). FIN-SI.
    DECLARA id SICUT NUMERUS VALENS X_HIT(s,mx,my).
    SI id == 0 TUNC REDDE 0. FIN-SI.
    DECLARA foc SICUT NUMERUS VALENS X_FOCUS(s,id).
    DECLARA x SICUT NUMERUS VALENS s[3].
    DECLARA y SICUT NUMERUS VALENS s[4].
    DECLARA w SICUT NUMERUS VALENS s[5].
    DECLARA maximus SICUT NUMERUS VALENS s[17].
    SI id == 2 TUNC x=s[7]. y=s[8]. w=s[9]. maximus=s[22]. FIN-SI.
    DECLARA lx SICUT NUMERUS VALENS mx-x.
    DECLARA ly SICUT NUMERUS VALENS my-y.
    SI ly >= 4 && ly < 24 && lx >= w-26 && lx < w-6 TUNC DECLARA c SICUT NUMERUS VALENS X_CLOSE(s,id). REDDE 1. FIN-SI.
    SI ly >= 4 && ly < 24 && lx >= w-70 && lx < w-52 TUNC DECLARA m SICUT NUMERUS VALENS X_MIN(s,id). REDDE 1. FIN-SI.
    SI ly >= 4 && ly < 24 && lx >= w-48 && lx < w-30 TUNC DECLARA z SICUT NUMERUS VALENS X_MAX(s,id). REDDE 1. FIN-SI.
    SI ly >= 0 && ly < 28 && lx >= 0 && lx < w-74 && maximus == 0 TUNC s[14]=id. s[15]=mx-x. s[16]=my-y. REDDE 1. FIN-SI.
    REDDE foc.
FIN-FUNCTIO.

FUNCTIO X_CLAVIS_AGE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    ACCIPIT q SICUT NUMERUS.
    SI q == 0 TUNC REDDE 0. FIN-SI.
    DECLARA scan SICUT NUMERUS VALENS (q / 2) % 65536.
    DECLARA unicode SICUT NUMERUS VALENS q / 131072.
    SI scan == 23 || unicode == 27 TUNC REDDE 2. FIN-SI.
    SI unicode == 9 TUNC DECLARA t SICUT NUMERUS VALENS X_TAB(s). REDDE 1. FIN-SI.
    SI scan == 1 TUNC DECLARA a1 SICUT NUMERUS VALENS X_MOVE(s,0,0-12). REDDE 1. FIN-SI.
    SI scan == 2 TUNC DECLARA a2 SICUT NUMERUS VALENS X_MOVE(s,0,12). REDDE 1. FIN-SI.
    SI scan == 3 TUNC DECLARA a3 SICUT NUMERUS VALENS X_MOVE(s,12,0). REDDE 1. FIN-SI.
    SI scan == 4 TUNC DECLARA a4 SICUT NUMERUS VALENS X_MOVE(s,0-12,0). REDDE 1. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA s SICUT ORDO DE NUMERUS CAPACITAS 32.
    s[0]=1. s[1]=0. s[2]=0. s[3]=20. s[4]=20. s[5]=600. s[7]=500. s[8]=100. s[9]=500. s[11]=100. s[12]=100.
    DECLARA a SICUT NUMERUS VALENS X_MOUSE_DOWN(s).
    DECLARA b SICUT NUMERUS VALENS X_CLAVIS_AGE(s,9*131072+1).
    REDDE a+b.
FIN-FUNCTIO.
