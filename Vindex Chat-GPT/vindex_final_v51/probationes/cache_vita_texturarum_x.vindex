IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_vii.vindex".
IMPORTA "bibliotheca/imago_raster_vii.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_viii.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_x.vindex".
IMPORTA "bibliotheca/fenestrale_coda_graphica.vindex".
IMPORTA "bibliotheca/fenestrale_cache_texturarum_x.vindex".
IMPORTA "bibliotheca/fenestrale_backend_x.vindex".

FUNCTIO PF5_COMPONE REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT dst SICUT NUMERUS.
    ACCIPIT src SICUT NUMERUS.
    ACCIPIT rectum SICUT NUMERUS.
    SI BX_FRAME_INCIPE(b)==0 TUNC REDDE 0. FIN-SI.
    SI BX_COMPONE_ADDE(b,dst,src,rectum,rectum,255)==0 TUNC REDDE 0. FIN-SI.
    REDDE BX_FRAME_COMMITTE(b).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA src1 SICUT NUMERUS VALENS GX_CREA(4,4).
    DECLARA src2 SICUT NUMERUS VALENS GX_CREA(4,4).
    DECLARA dst SICUT NUMERUS VALENS GX_CREA(4,4).
    SI src1==0 || src2==0 || dst==0 TUNC REDDE 1. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS GX_RECT_ALPHA(src1,GVIII_RECT_CREA(0,0,4,4),255,255).
    f=GX_RECT_ALPHA(src2,GVIII_RECT_CREA(0,0,4,4),65280,255).
    DECLARA rectum SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,4,4).

    DECLARA b SICUT NUMERUS VALENS BX_CREA_SW(16).
    DECLARA cache SICUT NUMERUS VALENS BX_CACHE_INSTITUE(b,1,64).
    SI b==0 || cache==0 TUNC REDDE 2. FIN-SI.
    SI BX_FRAME_INCIPE(b)==0 || BX_COMPONE_ADDE(b,dst,src1,rectum,rectum,255)==0 TUNC REDDE 3. FIN-SI.
    DECLARA r1 SICUT NUMERUS VALENS BX_RESOURCE_QUAERE(b,src1).
    DECLARA q SICUT NUMERUS VALENS BX_CODA(b).
    SI r1==0 || CONTENTUM(r1+48)==0 || TXC_FIBULAE(CONTENTUM(r1+48))!=1 TUNC REDDE 4. FIN-SI.
    SI QVIII_NUMERUS(q)!=2 || QVIII_OPCODE(q,0)!=BX_OP_TEXTURE_CREA() || QVIII_OPCODE(q,1)!=BX_OP_COMPONE() TUNC REDDE 5. FIN-SI.
    SI BX_FRAME_COMMITTE(b)!=1 || BX_RESOURCE_STATUS(r1)!=1 || CONTENTUM(r1+48)!=0 TUNC REDDE 6. FIN-SI.
    SI BX_RESOURCE_CREATAE(b)!=1 || BX_RESOURCE_RESIDENTES(b)!=1 || TXC_MISSES(cache)!=1 || TXC_HITS(cache)!=0 TUNC REDDE 7. FIN-SI.

    SI PF5_COMPONE(b,dst,src1,rectum)!=2 TUNC REDDE 8. FIN-SI.
    SI QVIII_NUMERUS(q)!=1 || QVIII_OPCODE(q,0)!=BX_OP_COMPONE() || BX_RESOURCE_CREATAE(b)!=1 || TXC_HITS(cache)!=1 TUNC REDDE 9. FIN-SI.

    DECLARA generatio1 SICUT NUMERUS VALENS BX_RESOURCE_GENERATIO(r1).
    f=GX_PIX_PONE(src1,0,0,16711680,255).
    SI PF5_COMPONE(b,dst,src1,rectum)!=3 TUNC REDDE 10. FIN-SI.
    SI QVIII_NUMERUS(q)!=2 || QVIII_OPCODE(q,0)!=BX_OP_TEXTURE_RENOVA() || QVIII_OPCODE(q,1)!=BX_OP_COMPONE() TUNC REDDE 11. FIN-SI.
    SI BX_RESOURCE_GENERATIO(r1)==generatio1 || BX_RESOURCE_GENERATIO(r1)!=CONTENTUM(src1+72) || BX_RESOURCE_RENOVATAE(b)!=1 || TXC_INVALIDATIONES(cache)!=1 TUNC REDDE 12. FIN-SI.

    SI PF5_COMPONE(b,dst,src2,rectum)!=4 TUNC REDDE 13. FIN-SI.
    DECLARA r2 SICUT NUMERUS VALENS BX_RESOURCE_QUAERE(b,src2).
    SI r2==0 || QVIII_NUMERUS(q)!=3 || QVIII_OPCODE(q,0)!=BX_OP_TEXTURE_CREA() || QVIII_OPCODE(q,1)!=BX_OP_COMPONE() || QVIII_OPCODE(q,2)!=BX_OP_TEXTURE_LIBERA() TUNC REDDE 14. FIN-SI.
    SI BX_RESOURCE_STATUS(r1)!=2 || BX_RESOURCE_STATUS(r2)!=1 || BX_RESOURCE_LIBERATAE(b)!=1 || BX_RESOURCE_RESIDENTES(b)!=1 || TXC_EVICTIONES(cache)!=1 TUNC REDDE 15. FIN-SI.

    SI PF5_COMPONE(b,dst,src1,rectum)!=5 TUNC REDDE 16. FIN-SI.
    SI BX_RESOURCE_QUAERE(b,src1)!=r1 || BX_RESOURCE_STATUS(r1)!=1 || BX_RESOURCE_STATUS(r2)!=2 TUNC REDDE 17. FIN-SI.
    SI BX_RESOURCE_CREATAE(b)!=3 || BX_RESOURCE_LIBERATAE(b)!=2 || BX_RESOURCE_RESIDENTES(b)!=1 || QVIII_OPCODE(q,2)!=BX_OP_TEXTURE_LIBERA() TUNC REDDE 18. FIN-SI.

    SI BX_FRAME_INCIPE(b)==0 || BX_COMPONE_ADDE(b,dst,src1,rectum,rectum,255)==0 TUNC REDDE 19. FIN-SI.
    SI CONTENTUM(r1+48)==0 || BX_FRAME_ABICE(b)==0 TUNC REDDE 20. FIN-SI.
    SI CONTENTUM(r1+48)!=0 || CONTENTUM(r1+72)!=0 || QVIII_NUMERUS(q)!=0 || BX_FENCE_COMPLETA(b)!=5 TUNC REDDE 21. FIN-SI.

    DECLARA sa SICUT NUMERUS VALENS GX_CREA(4,4).
    DECLARA fragilis SICUT NUMERUS VALENS GX_CREA(3,3).
    DECLARA b2 SICUT NUMERUS VALENS BX_CREA_SW(8).
    DECLARA cache2 SICUT NUMERUS VALENS BX_CACHE_INSTITUE(b2,2,128).
    SI sa==0 || fragilis==0 || b2==0 || cache2==0 TUNC REDDE 22. FIN-SI.
    f=GX_RECT_ALPHA(sa,rectum,16777215,255).
    f=GX_RECT_ALPHA(fragilis,GVIII_RECT_CREA(0,0,3,3),255,128).
    SI PF5_COMPONE(b2,dst,sa,rectum)!=1 TUNC REDDE 23. FIN-SI.
    DECLARA ra SICUT NUMERUS VALENS BX_RESOURCE_QUAERE(b2,sa).
    DECLARA gena SICUT NUMERUS VALENS BX_RESOURCE_GENERATIO(ra).
    f=GX_PIX_PONE(sa,1,1,65280,255).
    SI BX_FRAME_INCIPE(b2)==0 || BX_COMPONE_ADDE(b2,dst,sa,rectum,rectum,255)==0 TUNC REDDE 24. FIN-SI.
    DECLARA novem SICUT NUMERUS VALENS GVIII_RECT_CREA(0,0,3,3).
    SI BX_NOVEM_ADDE(b2,dst,fragilis,novem,novem,255)==0 TUNC REDDE 25. FIN-SI.
    DECLARA rf SICUT NUMERUS VALENS BX_RESOURCE_QUAERE(b2,fragilis).
    CONTENTUM(fragilis)=2.
    SI BX_FRAME_COMMITTE(b2)!=0 TUNC REDDE 26. FIN-SI.
    SI BX_RESOURCE_GENERATIO(ra)!=gena || BX_RESOURCE_RENOVATAE(b2)!=0 || BX_RESOURCE_STATUS(rf)!=0 || BX_RESOURCE_CREATAE(b2)!=1 TUNC REDDE 27. FIN-SI.
    SI CONTENTUM(ra+48)!=0 || CONTENTUM(rf+48)!=0 || CONTENTUM(ra+72)!=0 || CONTENTUM(rf+72)!=0 || QVIII_NUMERUS(BX_CODA(b2))!=0 || BX_ERRATUM(b2)!=6 TUNC REDDE 28. FIN-SI.

    DECLARA parvus SICUT NUMERUS VALENS BX_CREA_SW(1).
    DECLARA cache3 SICUT NUMERUS VALENS BX_CACHE_INSTITUE(parvus,1,64).
    SI parvus==0 || cache3==0 || BX_FRAME_INCIPE(parvus)==0 TUNC REDDE 29. FIN-SI.
    SI BX_COMPONE_ADDE(parvus,dst,src2,rectum,rectum,255)!=0 TUNC REDDE 30. FIN-SI.
    DECLARA rp SICUT NUMERUS VALENS BX_RESOURCE_QUAERE(parvus,src2).
    SI rp==0 || CONTENTUM(rp+48)==0 || CONTENTUM(rp+72)!=BX_OP_TEXTURE_CREA() TUNC REDDE 31. FIN-SI.
    SI BX_FRAME_ABICE(parvus)==0 TUNC REDDE 32. FIN-SI.
    SI CONTENTUM(rp+48)!=0 || CONTENTUM(rp+72)!=0 || QVIII_NUMERUS(BX_CODA(parvus))!=0 || BX_FENCE_COMPLETA(parvus)!=0 TUNC REDDE 33. FIN-SI.

    DECLARA b4 SICUT NUMERUS VALENS BX_CREA_SW(8).
    DECLARA cache4 SICUT NUMERUS VALENS BX_CACHE_INSTITUE(b4,1,64).
    DECLARA manualis SICUT NUMERUS VALENS BX_RESOURCE_CREA(b4,src1).
    SI b4==0 || cache4==0 || manualis==0 || BX_RESOURCE_AUTOMATA(manualis)!=0 TUNC REDDE 34. FIN-SI.
    SI BX_FRAME_INCIPE(b4)==0 || BX_TEXTURE_CREA_ADDE(b4,manualis)==0 || BX_FRAME_COMMITTE(b4)!=1 TUNC REDDE 35. FIN-SI.
    SI BX_FRAME_INCIPE(b4)==0 || BX_COMPONE_ADDE(b4,dst,src2,rectum,rectum,255)==0 || BX_FRAME_COMMITTE(b4)!=2 TUNC REDDE 36. FIN-SI.
    DECLARA automata SICUT NUMERUS VALENS BX_RESOURCE_QUAERE(b4,src2).
    SI automata==0 || BX_RESOURCE_AUTOMATA(automata)!=1 TUNC REDDE 37. FIN-SI.
    SI BX_RESOURCE_STATUS(manualis)!=1 || BX_RESOURCE_STATUS(automata)!=1 || BX_RESOURCE_LIBERATAE(b4)!=0 || BX_RESOURCE_RESIDENTES(b4)!=2 TUNC REDDE 38. FIN-SI.

    REDDE 0.
FIN-FUNCTIO.
