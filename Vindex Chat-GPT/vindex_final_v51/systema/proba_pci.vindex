// P12 — probatio enumerationis PCI sub UEFI vero.
//
// Enumerat apparatus PCI per primitivas portuum VINDEX nativas, deinde
// numerum inventorum et primos apparatus in schermo per firmware scribit.

IMPORTA "rectores/pci.vindex".

FUNCTIO MEMORIA_VACUA REDDENS NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT mensura SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < mensura PERFICE
        SCRIBE_OCTETUM_AB(destinatio + i, 0).
        i = i + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO CIFRA_HEX REDDENS NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SI valor < 10 TUNC REDDE 48 + valor. FIN-SI.
    REDDE 55 + valor.
FIN-FUNCTIO.

// Scribit numerum XVI-bitorum ut quattuor cifras hexadecimales UTF-16.
FUNCTIO HEX16_SCRIBE REDDENS NUMERUS.
    ACCIPIT buf SICUT NUMERUS.
    ACCIPIT positio SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SCRIBE_OCTETUM_AB(buf + positio, CIFRA_HEX((valor / 4096) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 2, CIFRA_HEX((valor / 256) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 4, CIFRA_HEX((valor / 16) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 6, CIFRA_HEX(valor & 15)).
    REDDE 8.
FIN-FUNCTIO.

FUNCTIO SCRIBE_CATENAM REDDENS NUMERUS.
    ACCIPIT conout SICUT NUMERUS.
    ACCIPIT catena SICUT NUMERUS.
    DECLARA sc SICUT NUMERUS VALENS CONTENTUM(conout + 8).
    REDDE UEFI_VOCA6(sc, conout, catena, 0, 0, 0, 0).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA ts SICUT NUMERUS VALENS CONTENTUM(16777224).
    SI ts == 0 TUNC REDDE 1. FIN-SI.
    DECLARA co SICUT NUMERUS VALENS CONTENTUM(ts + 64).

    DECLARA registrum SICUT NUMERUS VALENS RESERVA_OCTETA(4096).
    DECLARA ig_v SICUT NUMERUS VALENS MEMORIA_VACUA(registrum, 4096).

    DECLARA numerus SICUT NUMERUS VALENS PCI_ENUMERA(registrum, 64).

    DECLARA buf SICUT NUMERUS VALENS RESERVA_OCTETA(256).
    DECLARA ig_b SICUT NUMERUS VALENS MEMORIA_VACUA(buf, 256).

    // "PCI=" + numerus (hex)
    SCRIBE_OCTETUM_AB(buf, 80).
    SCRIBE_OCTETUM_AB(buf + 2, 67).
    SCRIBE_OCTETUM_AB(buf + 4, 73).
    SCRIBE_OCTETUM_AB(buf + 6, 61).
    DECLARA ig_h SICUT NUMERUS VALENS HEX16_SCRIBE(buf, 8, numerus).
    SCRIBE_OCTETUM_AB(buf + 16, 13).
    SCRIBE_OCTETUM_AB(buf + 18, 10).
    DECLARA ig_s SICUT NUMERUS VALENS SCRIBE_CATENAM(co, buf).

    // Primos quattuor apparatus monstra: venditor:apparatus classis
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA quot SICUT NUMERUS VALENS numerus.
    SI quot > 4 TUNC quot = 4. FIN-SI.
    DUM i < quot PERFICE
        DECLARA ig_v2 SICUT NUMERUS VALENS MEMORIA_VACUA(buf, 256).
        DECLARA sedes SICUT NUMERUS VALENS registrum + (i * 64).
        DECLARA ig_h1 SICUT NUMERUS VALENS HEX16_SCRIBE(buf, 0, CONTENTUM(sedes + 24)).
        SCRIBE_OCTETUM_AB(buf + 8, 58).
        DECLARA ig_h2 SICUT NUMERUS VALENS HEX16_SCRIBE(buf, 10, CONTENTUM(sedes + 32)).
        SCRIBE_OCTETUM_AB(buf + 18, 32).
        DECLARA ig_h3 SICUT NUMERUS VALENS HEX16_SCRIBE(buf, 20, CONTENTUM(sedes + 40)).
        SCRIBE_OCTETUM_AB(buf + 28, 13).
        SCRIBE_OCTETUM_AB(buf + 30, 10).
        DECLARA ig_s2 SICUT NUMERUS VALENS SCRIBE_CATENAM(co, buf).
        i = i + 1.
    FIN-DUM.

    REDDE 0.
FIN-FUNCTIO.
