// TEMPORARIUM — diagnostica initializationis F9-II; ante PR delendum.
IMPORTA "rectores/pci.vindex".
IMPORTA "rectores/mmio.vindex".
IMPORTA "rectores/paginae_dma.vindex".
IMPORTA "rectores/virtio_pci.vindex".
IMPORTA "rectores/virtio_gpu.vindex".
IMPORTA "rectores/virtio_gpu_3d.vindex".
IMPORTA "../bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "../bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "../bibliotheca/fenestrale_graphica_vii.vindex".
IMPORTA "../bibliotheca/imago_raster_vii.vindex".
IMPORTA "../bibliotheca/fenestrale_graphica_viii.vindex".
IMPORTA "../bibliotheca/fenestrale_graphica_x.vindex".

FUNCTIO DIAG_PARA REDDENS NUMERUS.
    DECLARA mora SICUT NUMERUS VALENS 0.
    DECLARA status SICUT NUMERUS VALENS PORTUS_LEGE(1021).
    DECLARA tx SICUT NUMERUS VALENS status & 32.
    DUM tx == 0 && mora < 100000 PERFICE
        mora = mora + 1.
        status = PORTUS_LEGE(1021).
        tx = status & 32.
    FIN-DUM.
    SI tx == 0 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO DIAG_CHAR REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    SI DIAG_PARA() == 0 TUNC REDDE 0. FIN-SI.
    PORTUS_SCRIBE(1016, c).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO DIAG_HEX REDDENS NUMERUS.
    ACCIPIT v SICUT NUMERUS.
    DECLARA hi SICUT NUMERUS VALENS (v / 16) & 15.
    DECLARA lo SICUT NUMERUS VALENS v & 15.
    SI hi < 10 TUNC hi = hi + 48. ALITER hi = hi + 55. FIN-SI.
    SI lo < 10 TUNC lo = lo + 48. ALITER lo = lo + 55. FIN-SI.
    DECLARA a SICUT NUMERUS VALENS DIAG_CHAR(hi).
    DECLARA b SICUT NUMERUS VALENS DIAG_CHAR(lo).
    REDDE a & b.
FIN-FUNCTIO.

FUNCTIO DIAG_NUNTIA REDDENS NUMERUS.
    ACCIPIT codex SICUT NUMERUS.
    DECLARA a SICUT NUMERUS VALENS DIAG_CHAR(86).
    a = DIAG_CHAR(73). a = DIAG_CHAR(79). a = DIAG_CHAR(68). a = DIAG_CHAR(32).
    a = DIAG_HEX(codex). a = DIAG_CHAR(13). a = DIAG_CHAR(10).
    REDDE codex.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA systema SICUT NUMERUS VALENS CONTENTUM(16777224).
    SI systema == 0 TUNC REDDE DIAG_NUNTIA(1). FIN-SI.

    DECLARA gestor SICUT NUMERUS VALENS RESERVA_OCTETA(192).
    SI gestor == 0 TUNC REDDE DIAG_NUNTIA(2). FIN-SI.
    DECLARA pura SICUT NUMERUS VALENS GX_MEM_PURA(gestor, 192).
    SI pura == 0 TUNC REDDE DIAG_NUNTIA(3). FIN-SI.

    DECLARA registrum SICUT NUMERUS VALENS RESERVA_OCTETA(24).
    SI registrum == 0 TUNC REDDE DIAG_NUNTIA(4). FIN-SI.
    SI PCI_REGISTRUM_INITIA(registrum, 8) != 0 TUNC REDDE DIAG_NUNTIA(5). FIN-SI.
    DECLARA numerus SICUT NUMERUS VALENS PCI_ENUMERA_PER_PONTES(registrum).
    DECLARA sedes_gpu SICUT NUMERUS VALENS 0.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < numerus PERFICE
        DECLARA sedes SICUT NUMERUS VALENS PCI_REGISTRUM_SEDES(registrum, i).
        SI CONTENTUM(sedes + 24) == 6900 && CONTENTUM(sedes + 32) == 4176 TUNC sedes_gpu = sedes. FIN-SI.
        i = i + 1.
    FIN-DUM.
    SI sedes_gpu == 0 TUNC REDDE DIAG_NUNTIA(6). FIN-SI.
    DECLARA bus SICUT NUMERUS VALENS CONTENTUM(sedes_gpu).
    DECLARA app SICUT NUMERUS VALENS CONTENTUM(sedes_gpu + 8).
    DECLARA fn SICUT NUMERUS VALENS CONTENTUM(sedes_gpu + 16).

    DECLARA vp SICUT NUMERUS VALENS VP_CREA(bus, app, fn).
    SI vp == 0 TUNC REDDE DIAG_NUNTIA(7). FIN-SI.
    SI VP_FACULTATES_LEGE(vp) == 0 TUNC DECLARA r0 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(8). FIN-SI.
    DECLARA oblatae SICUT NUMERUS VALENS CONTENTUM(vp + 112).
    SI (oblatae & VG3D_F_VIRGL()) == 0 TUNC DECLARA r1 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(9). FIN-SI.
    DECLARA acceptae SICUT NUMERUS VALENS VG3D_FACULTATES_ACCIPE(oblatae).
    SI VP_INITIALIZA(vp, acceptae, 1) == 0 TUNC DECLARA r2 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(10). FIN-SI.
    DECLARA coda SICUT NUMERUS VALENS VP_CODAM_CONFIGURA(vp, systema, 0, 8).
    SI coda == 0 TUNC DECLARA r3 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(11). FIN-SI.
    SI VP_DRIVER_PARATUS(vp) == 0 TUNC DECLARA r4 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(12). FIN-SI.
    DECLARA caps SICUT NUMERUS VALENS VG3D_NUM_CAPSETS(vp).
    SI caps <= 0 TUNC DECLARA r5 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(13). FIN-SI.
    DECLARA info SICUT NUMERUS VALENS RESERVA_OCTETA(24).
    SI info == 0 TUNC DECLARA r6 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(14). FIN-SI.
    DECLARA electus SICUT NUMERUS VALENS 0.
    DECLARA versio SICUT NUMERUS VALENS 0.
    DECLARA mensura SICUT NUMERUS VALENS 0.
    i = 0.
    DUM i < caps && i < 16 PERFICE
        SI VG3D_CAPSET_INFO(vp, coda, 256, 1024, i, info) == 0 TUNC DECLARA r7 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(15). FIN-SI.
        DECLARA cand SICUT NUMERUS VALENS CONTENTUM(info).
        DECLARA melior SICUT NUMERUS VALENS VG3D_CAPSET_MELIUS(electus, cand).
        SI melior != electus TUNC electus = melior. versio = CONTENTUM(info + 8). mensura = CONTENTUM(info + 16). FIN-SI.
        i = i + 1.
    FIN-DUM.
    SI electus == 0 || mensura <= 0 TUNC DECLARA r8 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(16). FIN-SI.
    SI VG3D_CAPSET_LEGE(vp, coda, 256, 1024, electus, versio, mensura) == 0 TUNC DECLARA r9 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(17). FIN-SI.
    DECLARA init SICUT NUMERUS VALENS 0.
    SI (acceptae & VG3D_F_CONTEXT_INIT()) != 0 TUNC init = electus. FIN-SI.
    SI VG3D_CTX_CREA(vp, coda, 256, 1024, 1, init) == 0 TUNC DECLARA r10 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(18). FIN-SI.
    SI VG3D_CTX_LIBERA(vp, coda, 256, 1024, 1) == 0 TUNC DECLARA r11 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE DIAG_NUNTIA(19). FIN-SI.
    SI VP_RESTITUE(vp) == 0 TUNC REDDE DIAG_NUNTIA(20). FIN-SI.
    REDDE DIAG_NUNTIA(0).
FIN-FUNCTIO.
