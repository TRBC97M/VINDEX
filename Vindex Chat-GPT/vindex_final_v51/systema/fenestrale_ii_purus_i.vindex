// Sylvia OS — Fenestrale II Purus I, facies P16-XII-E / P17-II / P19-II.
// Fenestrae, clientes et applicationes in registris dynamicis VINDEX vivunt.
// P16-XII-E testam realem super scenam persistentem Graphica X componit;
// clientia FS_* manent compatibilia per pontem explicitum FS -> GX.

IMPORTA "systema/rectores/murus_ps2.vindex".
IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_vii.vindex".
IMPORTA "bibliotheca/imago_raster_vii.vindex".
IMPORTA "bibliotheca/imago_raster_partes_vii.vindex".
IMPORTA "bibliotheca/raster_rle_vii.vindex".
IMPORTA "bibliotheca/textus.vindex".
IMPORTA "bibliotheca/emblema_sylviae_vii.vindex".
IMPORTA "bibliotheca/iconae_sylviae_vii.vindex".
IMPORTA "bibliotheca/fasciculi_sylviae_i.vindex".
IMPORTA "bibliotheca/simg_ii.vindex".
IMPORTA "bibliotheca/simg_ii_bridge_vii.vindex".
IMPORTA "bibliotheca/simg_ii_assetum.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_viii.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_ix.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_x.vindex".
IMPORTA "bibliotheca/fenestrale_effectus_x.vindex".
IMPORTA "bibliotheca/fenestrale_compositor_x.vindex".
IMPORTA "bibliotheca/fenestrale_effectus_productio_x.vindex".
IMPORTA "bibliotheca/fenestrale_graphica_x_asseta.vindex".
IMPORTA "bibliotheca/fenestrale_tempus_x.vindex".
IMPORTA "bibliotheca/fenestrale_motus_x.vindex".
IMPORTA "bibliotheca/programmata_clientis_e.vindex".
IMPORTA "bibliotheca/tabula_clientis_f.vindex".
IMPORTA "bibliotheca/terminale_clientis_i.vindex".
IMPORTA "bibliotheca/officina_clientis_i.vindex".
IMPORTA "bibliotheca/officina_persistentia_ii.vindex".
IMPORTA "bibliotheca/fenestrale_eventa_g.vindex".
IMPORTA "bibliotheca/clientia_registrum_h.vindex".
IMPORTA "bibliotheca/fenestrae_registrum_i.vindex".
IMPORTA "bibliotheca/clientes_eventa_i.vindex".
IMPORTA "bibliotheca/fenestrale_input_i.vindex".
IMPORTA "bibliotheca/applicationes_registrum_iv.vindex".
IMPORTA "bibliotheca/fenestrale_gestor_i.vindex".
IMPORTA "bibliotheca/fenestrale_applicationes_iv.vindex".
IMPORTA "bibliotheca/fenestrale_iconographia_vii.vindex".
IMPORTA "bibliotheca/fenestrale_iconographia_xib.vindex".
IMPORTA "bibliotheca/fenestrale_chrome_viii.vindex".
IMPORTA "bibliotheca/fenestrale_compositor_viii.vindex".
IMPORTA "bibliotheca/fenestrale_shell_ix.vindex".
IMPORTA "bibliotheca/fenestrale_compositor_ix.vindex".
IMPORTA "bibliotheca/fenestrale_shell_xiie.vindex".

// Rector PS/2 historice hanc functionem vocat. Fenestrale coordinatas suas
// ex dx/dy crudis legit; hic adaptor tantum contractum rectoris implet.
FUNCTIO UEFI_MURIS_PUBLICA REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT bullae SICUT NUMERUS.
    REDDE 1.
FIN-FUNCTIO.

// Vector systematis nullam geometriam neque statum fenestrae continet.
// 11/12 murus x/y; 13 bullae; 14 fenestra tractata; 15/16 offset vel murus prior.
// 27 margines resize; 28 murus relativus; 29 murus absolutus.
// 34 coda eventuum; 35 eventa perdita; 36 clientes; 37 fenestrae;
// 38 INITIUM apertum; 39 catalogus applicationum; 40 emblema SIMG; 41 atlas P16-VII;
// 42 gestor assetorum premium P16-XI-B, vel 0 si familia runtime deest;
// 43 scena CX; 44 cache XP; 45 motus MX; 46 horologium TX; 47 gestor XII-E.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI FV_AD_EST()==0 TUNC REDDE 5. FIN-SI.
    DECLARA s SICUT ORDO DE NUMERUS CAPACITAS 48.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(50333728). DECLARA h SICUT NUMERUS VALENS CONTENTUM(50333736).
    DECLARA utilis_h SICUT NUMERUS VALENS h-FV_METRUM_TASKBAR().
    s[11]=w/2. s[12]=h/2. s[13]=0. s[14]=0. s[15]=0. s[16]=0. s[27]=0.
    s[28]=0. s[29]=0. s[35]=0. s[38]=0. s[40]=0. s[41]=0. s[42]=0.
    s[43]=0. s[44]=0. s[45]=0. s[46]=0. s[47]=0.
    s[34]=EG_CREA(32). SI s[34]==0 TUNC REDDE 71. FIN-SI.
    s[36]=CH_CREA(). SI s[36]==0 TUNC REDDE 71. FIN-SI.
    s[37]=FI_CREA(). SI s[37]==0 TUNC REDDE 71. FIN-SI.
    s[39]=AI_CREA(). SI s[39]==0 TUNC REDDE 71. FIN-SI.
    DECLARA emblema SICUT TEXTUS VALENS EVII_CREA().
    SI IR_VALIDUS(emblema)==0 TUNC REDDE 71. FIN-SI.
    s[40]=TEXTUS_SEDES(emblema).
    DECLARA atlas SICUT TEXTUS VALENS ICVII_CREA().
    SI IR_VALIDUS(atlas)==0 TUNC REDDE 71. FIN-SI.
    s[41]=TEXTUS_SEDES(atlas).

    DECLARA superficies_p SICUT NUMERUS VALENS FS_CREA(496,260).
    DECLARA superficies_t SICUT NUMERUS VALENS FS_CREA(396,226).
    DECLARA superficies_e SICUT NUMERUS VALENS FS_CREA(680,320).
    DECLARA superficies_o SICUT NUMERUS VALENS FS_CREA(820,430).
    DECLARA status_e SICUT NUMERUS VALENS TE_CREA().
    DECLARA status_o SICUT NUMERUS VALENS OP_CREA().
    SI superficies_p==0 || superficies_t==0 || superficies_e==0 || superficies_o==0 || status_e==0 || status_o==0 TUNC REDDE 71. FIN-SI.
    DECLARA cp SICUT NUMERUS VALENS CH_ADDE(s[36],1,1,superficies_p,0).
    DECLARA ct SICUT NUMERUS VALENS CH_ADDE(s[36],2,2,superficies_t,0).
    DECLARA ce SICUT NUMERUS VALENS CH_ADDE(s[36],3,3,superficies_e,status_e).
    DECLARA co SICUT NUMERUS VALENS CH_ADDE(s[36],4,4,superficies_o,status_o).
    SI cp==0 || ct==0 || ce==0 || co==0 || CH_NUMERUS(s[36])!=4 TUNC REDDE 71. FIN-SI.
    DECLARA ap SICUT NUMERUS VALENS AI_ADDE(s[39],1,1,"PROGRAMMATA",1).
    DECLARA at SICUT NUMERUS VALENS AI_ADDE(s[39],2,2,"TABULA",1).
    DECLARA ae SICUT NUMERUS VALENS AI_ADDE(s[39],3,3,"TERMINALE",1).
    DECLARA ao SICUT NUMERUS VALENS AI_ADDE(s[39],4,4,"OFFICINA",1).
    SI ap==0 || at==0 || ae==0 || ao==0 || AI_NUMERUS(s[39])!=4 TUNC REDDE 71. FIN-SI.
    DECLARA rp SICUT NUMERUS VALENS PE_RENDE(superficies_p,0).
    DECLARA rt SICUT NUMERUS VALENS TF_RENDE(superficies_t,0).
    DECLARA re SICUT NUMERUS VALENS TE_RENDE(superficies_e,status_e).
    DECLARA ro SICUT NUMERUS VALENS OP_RENDE(superficies_o,status_o).

    DECLARA pw SICUT NUMERUS VALENS w*58/100. DECLARA ph SICUT NUMERUS VALENS utilis_h*66/100.
    DECLARA tw SICUT NUMERUS VALENS w*42/100. DECLARA th SICUT NUMERUS VALENS utilis_h*52/100.
    DECLARA ew SICUT NUMERUS VALENS w*62/100. DECLARA eh SICUT NUMERUS VALENS utilis_h*58/100.
    DECLARA ow SICUT NUMERUS VALENS w*72/100. DECLARA oh SICUT NUMERUS VALENS utilis_h*74/100.
    SI pw<640 TUNC pw=640. FIN-SI. SI ph<420 TUNC ph=420. FIN-SI.
    SI tw<500 TUNC tw=500. FIN-SI. SI th<360 TUNC th=360. FIN-SI.
    SI ew<700 TUNC ew=700. FIN-SI. SI eh<420 TUNC eh=420. FIN-SI.
    SI ow<860 TUNC ow=860. FIN-SI. SI oh<520 TUNC oh=520. FIN-SI.
    SI pw>w TUNC pw=w. FIN-SI. SI ph>utilis_h TUNC ph=utilis_h. FIN-SI.
    SI tw>w TUNC tw=w. FIN-SI. SI th>utilis_h TUNC th=utilis_h. FIN-SI.
    SI ew>w TUNC ew=w. FIN-SI. SI eh>utilis_h TUNC eh=utilis_h. FIN-SI.
    SI ow>w TUNC ow=w. FIN-SI. SI oh>utilis_h TUNC oh=utilis_h. FIN-SI.
    DECLARA px SICUT NUMERUS VALENS w*6/100. DECLARA py SICUT NUMERUS VALENS h*7/100.
    DECLARA tx SICUT NUMERUS VALENS w-tw-w*5/100. DECLARA ty SICUT NUMERUS VALENS h*21/100.
    DECLARA ex SICUT NUMERUS VALENS w*18/100. DECLARA ey SICUT NUMERUS VALENS h*12/100.
    DECLARA ox SICUT NUMERUS VALENS w*12/100. DECLARA oy SICUT NUMERUS VALENS h*8/100.
    SI px+pw>w TUNC px=w-pw. FIN-SI. SI py+ph>utilis_h TUNC py=utilis_h-ph. FIN-SI.
    SI tx<0 TUNC tx=0. FIN-SI. SI ty+th>utilis_h TUNC ty=utilis_h-th. FIN-SI.
    SI ex+ew>w TUNC ex=w-ew. FIN-SI. SI ey+eh>utilis_h TUNC ey=utilis_h-eh. FIN-SI.
    SI ox+ow>w TUNC ox=w-ow. FIN-SI. SI oy+oh>utilis_h TUNC oy=utilis_h-oh. FIN-SI.
    DECLARA fp SICUT NUMERUS VALENS FI_ADDE(s[37],1,px,py,pw,ph).
    DECLARA ft SICUT NUMERUS VALENS FI_ADDE(s[37],2,tx,ty,tw,th).
    DECLARA fe SICUT NUMERUS VALENS FI_ADDE(s[37],3,ex,ey,ew,eh).
    DECLARA fo SICUT NUMERUS VALENS FI_ADDE(s[37],4,ox,oy,ow,oh).
    SI fp==0 || ft==0 || fe==0 || fo==0 || FI_NUMERUS(s[37])!=4 TUNC REDDE 71. FIN-SI.
    DECLARA sp SICUT NUMERUS VALENS FI_STATUS_PONE(s[37],fp,2).
    DECLARA st SICUT NUMERUS VALENS FI_STATUS_PONE(s[37],ft,2).
    DECLARA se SICUT NUMERUS VALENS FI_STATUS_PONE(s[37],fe,2).
    DECLARA so SICUT NUMERUS VALENS FI_STATUS_PONE(s[37],fo,2).
    SI sp==0 || st==0 || se==0 || so==0 TUNC REDDE 71. FIN-SI.

    // Omnes allocationes Fenestrales iam perfectae sunt: input et PS/2
    // ante primam operationem fasciculorum persistentium parantur.
    DECLARA pp SICUT NUMERUS VALENS IN_PARA(s).
    // Familia premium non est conditio boot: si volumine deest, atlas VII manet.
    s[42]=XIB_CREA().
    // OFFICINA manet utilis etiam si backend non adest aut lectio errat.
    DECLARA init_o SICUT NUMERUS VALENS OP_INIT(status_o).
    ro=OP_RENDE(superficies_o,status_o).

    // P16-XII-E: scena moderna temptatur semel. Si firmware/horologium vel
    // aliqua allocatio deficit, renderer IX historicus manet fallback verus.
    DECLARA modernum SICUT NUMERUS VALENS XIIE_SCENA_INIT(s,s[37],s[36],s[39]).
    DECLARA f SICUT NUMERUS VALENS 0.
    SI modernum==0 TUNC
        f=IVIX_REDDE(s,s[37],s[36],s[39],TEXTUS_EX_SEDE(s[40]),TEXTUS_EX_SEDE(s[41])).
    FIN-SI.

    DECLARA finis SICUT NUMERUS VALENS 0.
    DUM finis==0 PERFICE
        DECLARA redde SICUT NUMERUS VALENS 0.
        DECLARA renova_clientes SICUT NUMERUS VALENS 0.
        // AUX/PS2 ante claviaturam firmware pollitur.
        DECLARA muris SICUT NUMERUS VALENS IN_MURUS(s).
        DECLARA q SICUT NUMERUS VALENS IN_CLAVIS().
        SI q!=0 TUNC
            DECLARA qa SICUT NUMERUS VALENS GI_CLAVIS(s,s[37],s[36],s[34],q).
            SI qa==2 TUNC finis=1. ALITER SI qa==1 TUNC redde=1. FIN-SI. FIN-SI.
        FIN-SI.
        SI muris!=0 TUNC
            DECLARA bullae SICUT NUMERUS VALENS muris-1.
            SI (bullae&1)!=0 && (s[13]&1)==0 TUNC
                DECLARA md SICUT NUMERUS VALENS IV_MOUSE_DOWN(s,s[37],s[34],s[39]).
            FIN-SI.
            SI (bullae&1)!=0 && s[14]!=0 TUNC DECLARA dr SICUT NUMERUS VALENS GI_DRAG(s,s[37]). FIN-SI.
            SI (bullae&1)==0 && (s[13]&1)!=0 TUNC s[14]=0. s[27]=0. FIN-SI.
            s[13]=bullae. redde=1.
        FIN-SI.
        DECLARA acta SICUT NUMERUS VALENS CI_EVENTA_AGE(s[36],s[37],s[34]).
        SI acta>0 TUNC redde=1. renova_clientes=1. FIN-SI.

        SI redde==1 TUNC
            SI modernum!=0 TUNC
                DECLARA sync SICUT NUMERUS VALENS XIIE_UI_SYNC(s,s[37],s[36],s[39],renova_clientes).
                SI sync!=0 TUNC f=CX_PRAESENTA_FB(s[43]). FIN-SI.
                DECLARA status_pendens SICUT NUMERUS VALENS OP_RENDE_PENDENS(superficies_o,status_o).
                SI status_pendens!=0 TUNC
                    DECLARA sync_status SICUT NUMERUS VALENS XIIE_UI_SYNC(s,s[37],s[36],s[39],1).
                    SI sync_status!=0 TUNC f=CX_PRAESENTA_FB(s[43]). FIN-SI.
                FIN-SI.
            ALITER
                DECLARA status_pendens_vetus SICUT NUMERUS VALENS OP_RENDE_PENDENS(superficies_o,status_o).
                f=IVIX_REDDE(s,s[37],s[36],s[39],TEXTUS_EX_SEDE(s[40]),TEXTUS_EX_SEDE(s[41])).
            FIN-SI.
        FIN-SI.

        // Motus XII-D numquam input expectat: si tick realis advenit, tantum
        // strata mutata componuntur et praesentantur. Renderer IX fallback
        // hunc ramum omnino non attingit.
        SI modernum!=0 TUNC DECLARA anima SICUT NUMERUS VALENS XIIE_PULSA(s). FIN-SI.
        DECLARA pausa SICUT NUMERUS VALENS IN_STALL().
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.
