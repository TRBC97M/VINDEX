// TEMPORARIUM — quaerit defectum alignmenti per unum slot localem futurum.
IMPORTA "rectores/pci.vindex".
IMPORTA "rectores/mmio.vindex".
IMPORTA "rectores/paginae_dma.vindex".
IMPORTA "rectores/virtio_pci.vindex".
IMPORTA "rectores/virtio_gpu.vindex".
IMPORTA "rectores/virtio_gpu_3d.vindex".

FUNCTIO DQ_MEM_PURA REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    SI basis==0 || n<=0 TUNC REDDE 0. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i+8<=n PERFICE CONTENTUM(basis+i)=0. i=i+8. FIN-DUM.
    DUM i<n PERFICE SCRIBE_OCTETUM_AB(basis+i,0). i=i+1. FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO DQ_PARA REDDENS NUMERUS.
    DECLARA mora SICUT NUMERUS VALENS 0.
    DECLARA status SICUT NUMERUS VALENS PORTUS_LEGE(1021).
    DUM (status&32)==0 && mora<100000 PERFICE mora=mora+1. status=PORTUS_LEGE(1021). FIN-DUM.
    SI (status&32)==0 TUNC REDDE 0. FIN-SI. REDDE 1.
FIN-FUNCTIO.
FUNCTIO DQ_CHAR REDDENS NUMERUS. ACCIPIT c SICUT NUMERUS. SI DQ_PARA()==0 TUNC REDDE 0. FIN-SI. PORTUS_SCRIBE(1016,c). REDDE 1. FIN-FUNCTIO.
FUNCTIO DQ_HEX REDDENS NUMERUS.
    ACCIPIT v SICUT NUMERUS.
    DECLARA a SICUT NUMERUS VALENS (v>>4)&15. DECLARA b SICUT NUMERUS VALENS v&15.
    SI a<10 TUNC a=a+48. ALITER a=a+55. FIN-SI. SI b<10 TUNC b=b+48. ALITER b=b+55. FIN-SI.
    DECLARA x SICUT NUMERUS VALENS DQ_CHAR(a). x=DQ_CHAR(b). REDDE x.
FIN-FUNCTIO.
FUNCTIO DQ_OUT REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    DECLARA x SICUT NUMERUS VALENS DQ_CHAR(86). x=DQ_CHAR(73). x=DQ_CHAR(79). x=DQ_CHAR(81). x=DQ_CHAR(32). x=DQ_HEX(c). x=DQ_CHAR(13). x=DQ_CHAR(10). REDDE c.
FIN-FUNCTIO.

FUNCTIO DQ_CREA REDDENS NUMERUS.
    ACCIPIT systema SICUT NUMERUS. ACCIPIT bus SICUT NUMERUS. ACCIPIT app SICUT NUMERUS. ACCIPIT fn SICUT NUMERUS.
    SI systema==0 TUNC REDDE 18. FIN-SI.
    DECLARA gestor SICUT NUMERUS VALENS RESERVA_OCTETA(192). SI gestor==0 TUNC REDDE 16. FIN-SI.
    DECLARA pura SICUT NUMERUS VALENS DQ_MEM_PURA(gestor,192). SI pura==0 TUNC REDDE 17. FIN-SI.
    CONTENTUM(gestor+32)=4096. CONTENTUM(gestor+120)=systema.
    CONTENTUM(gestor+128)=bus. CONTENTUM(gestor+136)=app. CONTENTUM(gestor+144)=fn.
    DECLARA vp SICUT NUMERUS VALENS VP_CREA(bus,app,fn). SI vp==0 TUNC REDDE 1. FIN-SI.
    CONTENTUM(gestor)=vp. CONTENTUM(gestor+48)=1.
    SI VP_FACULTATES_LEGE(vp)==0 TUNC DECLARA r0 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE 2. FIN-SI.
    DECLARA oblatae SICUT NUMERUS VALENS CONTENTUM(vp+112).
    SI (oblatae & VG3D_F_VIRGL())==0 TUNC DECLARA r1 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE 3. FIN-SI.
    DECLARA acceptae SICUT NUMERUS VALENS VG3D_FACULTATES_ACCIPE(oblatae).
    CONTENTUM(gestor+152)=acceptae.
    SI VP_INITIALIZA(vp,acceptae,1)==0 TUNC DECLARA r2 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE 4. FIN-SI.
    DECLARA coda SICUT NUMERUS VALENS VP_CODAM_CONFIGURA(vp,systema,0,8).
    SI coda==0 TUNC
        DECLARA internum SICUT NUMERUS VALENS CONTENTUM(vp+168).
        DECLARA r3 SICUT NUMERUS VALENS VP_RESTITUE(vp).
        REDDE 32+internum.
    FIN-SI.
    CONTENTUM(gestor+8)=coda.
    // Haec localis post codam numquam afficit logicam ante codam; tantum frame mutat.
    DECLARA bascula SICUT NUMERUS VALENS 0.
    SI bascula!=0 TUNC REDDE 19. FIN-SI.
    DECLARA r4 SICUT NUMERUS VALENS VP_RESTITUE(vp).
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA systema SICUT NUMERUS VALENS CONTENTUM(16777224). SI systema==0 TUNC REDDE DQ_OUT(64). FIN-SI.
    DECLARA reg SICUT NUMERUS VALENS RESERVA_OCTETA(24). SI reg==0 || PCI_REGISTRUM_INITIA(reg,8)!=0 TUNC REDDE DQ_OUT(65). FIN-SI.
    DECLARA n SICUT NUMERUS VALENS PCI_ENUMERA_PER_PONTES(reg). DECLARA gpu SICUT NUMERUS VALENS 0. DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<n PERFICE DECLARA s SICUT NUMERUS VALENS PCI_REGISTRUM_SEDES(reg,i). SI CONTENTUM(s+24)==6900 && CONTENTUM(s+32)==4176 TUNC gpu=s. FIN-SI. i=i+1. FIN-DUM.
    SI gpu==0 TUNC REDDE DQ_OUT(66). FIN-SI.
    DECLARA c SICUT NUMERUS VALENS DQ_CREA(systema,CONTENTUM(gpu),CONTENTUM(gpu+8),CONTENTUM(gpu+16)).
    REDDE DQ_OUT(c).
FIN-FUNCTIO.
