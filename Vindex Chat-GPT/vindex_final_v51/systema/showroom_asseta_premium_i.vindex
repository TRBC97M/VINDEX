// Sylvia OS — P16-XI-A: showroom assetorum premium ex PNG/SIMG II realibus.
// Asseta e volumine FAT leguntur; hic nulla icona proceduraliter fingitur.

FUNCTIO SAPI_TEXTUM REDDENS NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT gw SICUT NUMERUS.
    ACCIPIT gh SICUT NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    ACCIPIT color SICUT NUMERUS.
    REDDE TVIII_TEXTUM_FB(fons,GVIII_RECT_CREA(x,y,gw,gh),1,textus,color,255).
FIN-FUNCTIO.

FUNCTIO SAPI_LEGE REDDENS TEXTUS.
    ACCIPIT via SICUT TEXTUS.
    DECLARA imago SICUT TEXTUS VALENS FS_LEGE_TEXTUM(via).
    SI TEXTUS_SEDES(imago)==0 TUNC REDDE 0. FIN-SI.
    SI SII_VALIDUS(imago)==0 TUNC REDDE 0. FIN-SI.
    SI SII_GENUS(imago)!=2 TUNC REDDE 0. FIN-SI.
    REDDE imago.
FIN-FUNCTIO.

FUNCTIO SAPI_STATUS_SCALAE REDDENS NUMERUS.
    ACCIPIT gestor SICUT NUMERUS.
    ACCIPIT scala SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT viridis SICUT NUMERUS.
    ACCIPIT ruber SICUT NUMERUS.
    DECLARA f SICUT NUMERUS VALENS AII_SCALA_PONE(gestor,scala).
    DECLARA n SICUT NUMERUS VALENS AII_OPTIMUM_NODUS(gestor,101).
    DECLARA color SICUT NUMERUS VALENS ruber.
    SI n!=0 && AII_NODUS_SCALA(n)==scala TUNC color=viridis. FIN-SI.
    f=FV_RECT(x,y,14,14,color).
    REDDE n.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI FV_AD_EST()==0 TUNC REDDE 5. FIN-SI.
    SI FS_DISPONIBILIS()==0 TUNC REDDE 6. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(50333728).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(50333736).
    SI w<1280 || h<800 TUNC REDDE 7. FIN-SI.

    DECLARA graphite SICUT NUMERUS VALENS FV_COLOR(26,29,32).
    DECLARA frigidum SICUT NUMERUS VALENS FV_COLOR(74,96,114).
    DECLARA ebur SICUT NUMERUS VALENS FV_COLOR(242,244,247).
    DECLARA argentum SICUT NUMERUS VALENS FV_COLOR(191,199,207).
    DECLARA aqua SICUT NUMERUS VALENS FV_COLOR(189,239,242).
    DECLARA cyan SICUT NUMERUS VALENS FV_COLOR(0,198,255).
    DECLARA laurea SICUT NUMERUS VALENS FV_COLOR(104,177,123).
    DECLARA bronzeum SICUT NUMERUS VALENS FV_COLOR(181,138,84).
    DECLARA ruber SICUT NUMERUS VALENS FV_COLOR(196,72,72).
    DECLARA nox SICUT NUMERUS VALENS FV_COLOR(9,16,21).

    DECLARA atlas SICUT TEXTUS VALENS FUIVIII_CREA().
    SI IR_VALIDUS(atlas)==0 TUNC REDDE 8. FIN-SI.
    DECLARA fons SICUT NUMERUS VALENS TVIII_FONS_CREA(atlas,16,16,20,32,95).
    SI fons==0 TUNC REDDE 9. FIN-SI.

    DECLARA prg1 SICUT TEXTUS VALENS SAPI_LEGE("PRG1.SMG").
    DECLARA prg15 SICUT TEXTUS VALENS SAPI_LEGE("PRG15.SMG").
    DECLARA prg2 SICUT TEXTUS VALENS SAPI_LEGE("PRG2.SMG").
    DECLARA tab2 SICUT TEXTUS VALENS SAPI_LEGE("TAB2.SMG").
    DECLARA trm2 SICUT TEXTUS VALENS SAPI_LEGE("TRM2.SMG").
    DECLARA off2 SICUT TEXTUS VALENS SAPI_LEGE("OFF2.SMG").
    SI SII_VALIDUS(prg1)==0 || SII_VALIDUS(prg15)==0 || SII_VALIDUS(prg2)==0 TUNC REDDE 10. FIN-SI.
    SI SII_VALIDUS(tab2)==0 || SII_VALIDUS(trm2)==0 || SII_VALIDUS(off2)==0 TUNC REDDE 11. FIN-SI.
    SI SII_SCALA(prg1)!=1000 || SII_SCALA(prg15)!=1500 || SII_SCALA(prg2)!=2000 TUNC REDDE 12. FIN-SI.
    SI SII_SCALA(tab2)!=2000 || SII_SCALA(trm2)!=2000 || SII_SCALA(off2)!=2000 TUNC REDDE 13. FIN-SI.

    DECLARA gestor SICUT NUMERUS VALENS AII_CREA(1000).
    SI gestor==0 TUNC REDDE 14. FIN-SI.
    SI AII_ADDE(gestor,101,prg1)==0 || AII_ADDE(gestor,101,prg15)==0 || AII_ADDE(gestor,101,prg2)==0 TUNC REDDE 15. FIN-SI.
    SI AII_ADDE(gestor,102,tab2)==0 || AII_ADDE(gestor,103,trm2)==0 || AII_ADDE(gestor,104,off2)==0 TUNC REDDE 16. FIN-SI.

    DECLARA f SICUT NUMERUS VALENS GVII_GRADUS_VERTICALIS(0,0,w,h,FV_COLOR(17,27,33),FV_COLOR(7,14,19)).
    f=FV_RECT(42,34,w-84,h-68,graphite).
    f=GVII_UMBRA_GRADATA(42,34,w-84,h-68,8,nox,92).
    f=FV_RECT(68,104,w-136,2,bronzeum).
    f=FV_RECT(68,107,w-136,1,aqua).
    f=SAPI_TEXTUM(fons,72,54,16,20,"SYLVIA OS — ASSETA PREMIUM I",ebur).
    f=SAPI_TEXTUM(fons,72,82,10,14,"PNG → SIMG II → GRAPHICA IX → FRAMEBUFFER",aqua).

    f=FV_RECT(72,140,420,318,frigidum).
    f=FV_RECT(84,152,396,294,FV_COLOR(18,25,30)).
    f=FV_RECT(520,140,420,318,frigidum).
    f=FV_RECT(532,152,396,294,FV_COLOR(18,25,30)).
    f=SAPI_TEXTUM(fons,100,166,11,15,"VETUS — NEAREST",argentum).
    f=SAPI_TEXTUM(fons,548,166,11,15,"GRAPHICA IX — PREMIUM",ebur).
    f=AII_SCALA_PONE(gestor,1000).
    DECLARA vetus SICUT TEXTUS VALENS AII_V1_CACHE(gestor,101).
    SI IR_VALIDUS(vetus)==0 TUNC REDDE 17. FIN-SI.
    f=GVIII_SIMG_SCALA_FB(vetus,GVIII_RECT_CREA(164,208,236,212),255).
    f=GIX_ASSET_LINEAR_FB(gestor,101,GVIII_RECT_CREA(612,208,236,212),255).

    f=FV_RECT(968,140,240,318,FV_COLOR(31,39,44)).
    f=SAPI_TEXTUM(fons,988,166,10,14,"MULTI-SCALA",aqua).
    DECLARA n1 SICUT NUMERUS VALENS SAPI_STATUS_SCALAE(gestor,1000,988,206,laurea,ruber).
    f=SAPI_TEXTUM(fons,1012,204,9,12,"1000 / 48px",ebur).
    f=GIX_ASSET_LINEAR_FB(gestor,101,GVIII_RECT_CREA(1088,192,48,48),255).
    DECLARA n15 SICUT NUMERUS VALENS SAPI_STATUS_SCALAE(gestor,1500,988,272,laurea,ruber).
    f=SAPI_TEXTUM(fons,1012,270,9,12,"1500 / 72px",ebur).
    f=GIX_ASSET_LINEAR_FB(gestor,101,GVIII_RECT_CREA(1076,252,72,72),255).
    DECLARA n2 SICUT NUMERUS VALENS SAPI_STATUS_SCALAE(gestor,2000,988,360,laurea,ruber).
    f=SAPI_TEXTUM(fons,1012,358,9,12,"2000 / 96px",ebur).
    f=GIX_ASSET_LINEAR_FB(gestor,101,GVIII_RECT_CREA(1064,338,96,96),255).

    f=FV_RECT(72,488,868,246,FV_COLOR(22,30,35)).
    f=SAPI_TEXTUM(fons,92,506,11,15,"FAMILIA PRINCIPALIS 2X",bronzeum).
    f=AII_SCALA_PONE(gestor,2000).
    f=GIX_ASSET_LINEAR_FB(gestor,101,GVIII_RECT_CREA(108,548,112,112),255).
    f=GIX_ASSET_LINEAR_FB(gestor,102,GVIII_RECT_CREA(310,548,112,112),255).
    f=GIX_ASSET_LINEAR_FB(gestor,103,GVIII_RECT_CREA(512,548,112,112),255).
    f=GIX_ASSET_LINEAR_FB(gestor,104,GVIII_RECT_CREA(714,548,112,112),255).
    f=SAPI_TEXTUM(fons,106,678,8,11,"PROGRAMMATA",ebur).
    f=SAPI_TEXTUM(fons,328,678,8,11,"TABULA",ebur).
    f=SAPI_TEXTUM(fons,516,678,8,11,"TERMINALE",ebur).
    f=SAPI_TEXTUM(fons,724,678,8,11,"OFFICINA",ebur).

    f=FV_RECT(968,488,240,246,FV_COLOR(31,39,44)).
    f=SAPI_TEXTUM(fons,988,506,10,14,"SUPERFICIES",aqua).
    DECLARA superficies SICUT NUMERUS VALENS FS_CREA(152,152).
    SI superficies==0 TUNC REDDE 18. FIN-SI.
    f=FS_RECT(superficies,0,0,152,152,graphite).
    f=GIX_ASSET_LINEAR_S(superficies,gestor,104,GVIII_RECT_CREA(20,20,112,112),255).
    f=FS_BLIT(superficies,1012,546,152,152).
    f=SAPI_TEXTUM(fons,990,710,8,11,"decode semel / compone saepe",argentum).

    f=FV_RECT(1182,708,12,12,laurea).

    DECLARA pausa SICUT NUMERUS VALENS 0.
    DUM 1==1 PERFICE
        pausa=pausa+1.
        SI pausa>1000000 TUNC pausa=0. FIN-SI.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.
