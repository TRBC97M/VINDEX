// Regressio UEFI: vocatio functionis intra argumenta vocationis exterioris.
// Eadem semantica ac probatio ELF; serialis codex 00 victoriam significat.

FUNCTIO ABIU_CONST_A REDDENS NUMERUS.
    REDDE 3.
FIN-FUNCTIO.

FUNCTIO ABIU_CONST_B REDDENS NUMERUS.
    REDDE 5.
FIN-FUNCTIO.

FUNCTIO ABIU_SEX REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT d SICUT NUMERUS.
    ACCIPIT e SICUT NUMERUS.
    ACCIPIT f SICUT NUMERUS.
    REDDE a + b*10 + c*100 + d*1000 + e*10000 + f*100000.
FIN-FUNCTIO.

FUNCTIO ABIU_SEPTEM REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT d SICUT NUMERUS.
    ACCIPIT e SICUT NUMERUS.
    ACCIPIT f SICUT NUMERUS.
    ACCIPIT g SICUT NUMERUS.
    REDDE a + b*10 + c*100 + d*1000 + e*10000 + f*100000 + g*1000000.
FIN-FUNCTIO.

FUNCTIO ABIU_PARA REDDENS NUMERUS.
    DECLARA mora SICUT NUMERUS VALENS 0.
    DECLARA status SICUT NUMERUS VALENS PORTUS_LEGE(1021).
    DUM (status & 32) == 0 && mora < 100000 PERFICE
        mora = mora + 1.
        status = PORTUS_LEGE(1021).
    FIN-DUM.
    SI (status & 32) == 0 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ABIU_CHAR REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    SI ABIU_PARA() == 0 TUNC REDDE 0. FIN-SI.
    PORTUS_SCRIBE(1016,c).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO ABIU_HEX REDDENS NUMERUS.
    ACCIPIT v SICUT NUMERUS.
    DECLARA hi SICUT NUMERUS VALENS (v>>4)&15.
    DECLARA lo SICUT NUMERUS VALENS v&15.
    SI hi<10 TUNC hi=hi+48. ALITER hi=hi+55. FIN-SI.
    SI lo<10 TUNC lo=lo+48. ALITER lo=lo+55. FIN-SI.
    DECLARA x SICUT NUMERUS VALENS ABIU_CHAR(hi).
    x=ABIU_CHAR(lo).
    REDDE x.
FIN-FUNCTIO.

FUNCTIO ABIU_NUNTIA REDDENS NUMERUS.
    ACCIPIT codex SICUT NUMERUS.
    DECLARA x SICUT NUMERUS VALENS ABIU_CHAR(65).
    x=ABIU_CHAR(66). x=ABIU_CHAR(73). x=ABIU_CHAR(85). x=ABIU_CHAR(32).
    x=ABIU_HEX(codex). x=ABIU_CHAR(13). x=ABIU_CHAR(10).
    REDDE codex.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA sex SICUT NUMERUS VALENS ABIU_SEX(1,2,ABIU_CONST_A(),4,ABIU_CONST_B(),6).
    SI sex != 654321 TUNC REDDE ABIU_NUNTIA(1). FIN-SI.
    DECLARA septem SICUT NUMERUS VALENS ABIU_SEPTEM(1,2,ABIU_CONST_A(),4,ABIU_CONST_B(),6,7).
    SI septem != 7654321 TUNC REDDE ABIU_NUNTIA(2). FIN-SI.
    DECLARA initium SICUT NUMERUS VALENS ABIU_SEX(ABIU_CONST_A(),2,3,4,5,6).
    SI initium != 654323 TUNC REDDE ABIU_NUNTIA(3). FIN-SI.
    REDDE ABIU_NUNTIA(0).
FIN-FUNCTIO.
