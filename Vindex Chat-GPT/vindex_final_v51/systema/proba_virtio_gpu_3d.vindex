// P16-XII-F9-I — VIRGL, capset et contextus III-D sub UEFI/QEMU.
IMPORTA "rectores/pci.vindex".
IMPORTA "rectores/mmio.vindex".
IMPORTA "rectores/paginae_dma.vindex".
IMPORTA "rectores/virtio_pci.vindex".
IMPORTA "rectores/virtio_gpu.vindex".
IMPORTA "rectores/virtio_gpu_3d.vindex".

FUNCTIO F9_VACUA REDDENS NUMERUS.
    ACCIPIT basis SICUT NUMERUS. ACCIPIT mensura SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < mensura PERFICE SCRIBE_OCTETUM_AB(basis + i, 0). i = i + 1. FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.
FUNCTIO F9_CIFRA REDDENS NUMERUS.
    ACCIPIT v SICUT NUMERUS. SI v < 10 TUNC REDDE 48 + v. FIN-SI. REDDE 55 + v.
FIN-FUNCTIO.
FUNCTIO F9_LIT REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS. ACCIPIT p SICUT NUMERUS. ACCIPIT c SICUT NUMERUS. SCRIBE_OCTETUM_AB(b+p,c). REDDE 2.
FIN-FUNCTIO.
FUNCTIO F9_HEX8 REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS. ACCIPIT p SICUT NUMERUS. ACCIPIT v SICUT NUMERUS.
    SCRIBE_OCTETUM_AB(b+p,F9_CIFRA((v/16)&15)). SCRIBE_OCTETUM_AB(b+p+2,F9_CIFRA(v&15)). REDDE 4.
FIN-FUNCTIO.
FUNCTIO F9_HEX32 REDDENS NUMERUS.
    ACCIPIT b SICUT NUMERUS. ACCIPIT p SICUT NUMERUS. ACCIPIT v SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 7.
    DUM i >= 0 PERFICE
        SCRIBE_OCTETUM_AB(b+p+(7-i)*2,F9_CIFRA((v>>(i*4))&15)).
        i=i-1.
    FIN-DUM.
    REDDE 16.
FIN-FUNCTIO.
FUNCTIO F9_SER_PARA REDDENS NUMERUS.
    DECLARA mora SICUT NUMERUS VALENS 0.
    DECLARA status SICUT NUMERUS VALENS PORTUS_LEGE(1021).
    DECLARA transmittens SICUT NUMERUS VALENS status & 32.
    DUM transmittens == 0 && mora < 100000 PERFICE
        mora=mora+1.
        status=PORTUS_LEGE(1021).
        transmittens=status & 32.
    FIN-DUM.
    SI transmittens == 0 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.
FUNCTIO F9_SER_SCRIBE REDDENS NUMERUS.
    ACCIPIT catena SICUT NUMERUS. SI catena==0 TUNC REDDE 0. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM OCTETUS_AB(catena+i)!=0 PERFICE
        SI F9_SER_PARA()==0 TUNC REDDE 0. FIN-SI.
        PORTUS_SCRIBE(1016,OCTETUS_AB(catena+i)).
        i=i+2.
    FIN-DUM.
    REDDE i/2.
FIN-FUNCTIO.
FUNCTIO F9_ERR REDDENS NUMERUS.
    ACCIPIT codex SICUT NUMERUS.
    DECLARA b SICUT NUMERUS VALENS RESERVA_OCTETA(48). SI b==0 TUNC REDDE codex. FIN-SI.
    DECLARA z SICUT NUMERUS VALENS F9_VACUA(b,48). DECLARA p SICUT NUMERUS VALENS 0.
    p=p+F9_LIT(b,p,86). p=p+F9_LIT(b,p,73). p=p+F9_LIT(b,p,79). p=p+F9_LIT(b,p,57). p=p+F9_LIT(b,p,32).
    p=p+F9_LIT(b,p,69). p=p+F9_LIT(b,p,82). p=p+F9_LIT(b,p,82). p=p+F9_HEX8(b,p,codex).
    p=p+F9_LIT(b,p,13). p=p+F9_LIT(b,p,10). DECLARA w SICUT NUMERUS VALENS F9_SER_SCRIBE(b). REDDE codex.
FIN-FUNCTIO.
FUNCTIO F9_NUNTIA REDDENS NUMERUS.
    ACCIPIT oblatae SICUT NUMERUS. ACCIPIT acceptae SICUT NUMERUS. ACCIPIT numerus SICUT NUMERUS.
    ACCIPIT capset SICUT NUMERUS. ACCIPIT mensura SICUT NUMERUS. ACCIPIT init SICUT NUMERUS. ACCIPIT operationes SICUT NUMERUS.
    DECLARA b SICUT NUMERUS VALENS RESERVA_OCTETA(320). SI b==0 TUNC REDDE 0. FIN-SI.
    DECLARA z SICUT NUMERUS VALENS F9_VACUA(b,320). DECLARA p SICUT NUMERUS VALENS 0.
    p=p+F9_LIT(b,p,86). p=p+F9_LIT(b,p,73). p=p+F9_LIT(b,p,79). p=p+F9_LIT(b,p,57).
    p=p+F9_LIT(b,p,32). p=p+F9_LIT(b,p,79). p=p+F9_HEX32(b,p,oblatae).
    p=p+F9_LIT(b,p,32). p=p+F9_LIT(b,p,65). p=p+F9_HEX32(b,p,acceptae).
    p=p+F9_LIT(b,p,32). p=p+F9_LIT(b,p,78). p=p+F9_HEX32(b,p,numerus).
    p=p+F9_LIT(b,p,32). p=p+F9_LIT(b,p,83). p=p+F9_HEX8(b,p,capset).
    p=p+F9_LIT(b,p,32). p=p+F9_LIT(b,p,77). p=p+F9_HEX32(b,p,mensura).
    p=p+F9_LIT(b,p,32). p=p+F9_LIT(b,p,73). p=p+F9_HEX8(b,p,init).
    p=p+F9_LIT(b,p,32). p=p+F9_LIT(b,p,81). p=p+F9_HEX32(b,p,operationes).
    p=p+F9_LIT(b,p,32). p=p+F9_LIT(b,p,82). p=p+F9_LIT(b,p,13). p=p+F9_LIT(b,p,10).
    REDDE F9_SER_SCRIBE(b).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA systema SICUT NUMERUS VALENS CONTENTUM(16777224). SI systema==0 TUNC REDDE F9_ERR(1). FIN-SI.
    DECLARA registrum SICUT NUMERUS VALENS RESERVA_OCTETA(24). SI PCI_REGISTRUM_INITIA(registrum,4)!=0 TUNC REDDE F9_ERR(1). FIN-SI.
    DECLARA numerus_pci SICUT NUMERUS VALENS PCI_ENUMERA_PER_PONTES(registrum).
    DECLARA sedes_gpu SICUT NUMERUS VALENS 0. DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<numerus_pci PERFICE
        DECLARA sedes SICUT NUMERUS VALENS PCI_REGISTRUM_SEDES(registrum,i).
        SI CONTENTUM(sedes+24)==6900 && CONTENTUM(sedes+32)==4176 TUNC sedes_gpu=sedes. FIN-SI.
        i=i+1.
    FIN-DUM.
    SI sedes_gpu==0 TUNC REDDE F9_ERR(1). FIN-SI.
    DECLARA bus SICUT NUMERUS VALENS CONTENTUM(sedes_gpu). DECLARA app SICUT NUMERUS VALENS CONTENTUM(sedes_gpu+8). DECLARA fn SICUT NUMERUS VALENS CONTENTUM(sedes_gpu+16).
    DECLARA vp SICUT NUMERUS VALENS VP_CREA(bus,app,fn). SI vp==0 TUNC REDDE F9_ERR(1). FIN-SI.
    SI VP_FACULTATES_LEGE(vp)==0 TUNC DECLARA r1 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(1). FIN-SI.
    DECLARA oblatae SICUT NUMERUS VALENS CONTENTUM(vp+112).
    SI (oblatae & VG3D_F_VIRGL())==0 TUNC DECLARA r2 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(2). FIN-SI.
    DECLARA acceptae SICUT NUMERUS VALENS VG3D_FACULTATES_ACCIPE(oblatae).
    SI VP_INITIALIZA(vp,acceptae,1)==0 TUNC DECLARA r3 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(3). FIN-SI.
    DECLARA coda SICUT NUMERUS VALENS VP_CODAM_CONFIGURA(vp,systema,0,8). SI coda==0 TUNC DECLARA r4 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(4). FIN-SI.
    SI VP_DRIVER_PARATUS(vp)==0 TUNC DECLARA r5 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(5). FIN-SI.
    DECLARA n SICUT NUMERUS VALENS VG3D_NUM_CAPSETS(vp). SI n<=0 TUNC DECLARA r6 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(6). FIN-SI.
    DECLARA info SICUT NUMERUS VALENS RESERVA_OCTETA(24). SI info==0 TUNC DECLARA r7 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(7). FIN-SI.
    DECLARA electus SICUT NUMERUS VALENS 0. DECLARA versio SICUT NUMERUS VALENS 0. DECLARA mensura SICUT NUMERUS VALENS 0.
    i=0.
    DUM i<n && i<16 PERFICE
        SI VG3D_CAPSET_INFO(vp,coda,256,1024,i,info)==0 TUNC DECLARA r8 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(8). FIN-SI.
        DECLARA candidatus SICUT NUMERUS VALENS CONTENTUM(info). DECLARA melior SICUT NUMERUS VALENS VG3D_CAPSET_MELIUS(electus,candidatus).
        SI melior!=electus TUNC electus=melior. versio=CONTENTUM(info+8). mensura=CONTENTUM(info+16). FIN-SI.
        i=i+1.
    FIN-DUM.
    SI electus==0 || mensura<=0 TUNC DECLARA r9 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(9). FIN-SI.
    SI VG3D_CAPSET_LEGE(vp,coda,256,1024,electus,versio,mensura)==0 TUNC DECLARA r10 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(10). FIN-SI.
    DECLARA init SICUT NUMERUS VALENS 0. SI (acceptae & VG3D_F_CONTEXT_INIT())!=0 TUNC init=electus. FIN-SI.
    SI VG3D_CTX_CREA(vp,coda,256,1024,1,init)==0 TUNC DECLARA r11 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(11). FIN-SI.
    SI VG3D_CTX_LIBERA(vp,coda,256,1024,1)==0 TUNC DECLARA r12 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE F9_ERR(12). FIN-SI.
    DECLARA operationes SICUT NUMERUS VALENS i+3. DECLARA commandum SICUT NUMERUS VALENS CONTENTUM(vp+152).
    DECLARA restitutum SICUT NUMERUS VALENS VP_RESTITUE(vp). SI restitutum==0 || (PCI_LEGE(bus,app,fn,4)&65535)!=commandum TUNC REDDE F9_ERR(13). FIN-SI.
    DECLARA nuntiatum SICUT NUMERUS VALENS F9_NUNTIA(oblatae,acceptae,n,electus,mensura,init,operationes).
    REDDE 0.
FIN-FUNCTIO.
