// VINDEX Systema Fenestrale 0.51 — Bibliotheca duplex VXNAT.
// Omnis pictura et administratio fenestrarum ipsa VINDEX perficitur.

FUNCTIO PIXEL_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    SI CONTENTUM(50333696) == 0 TUNC
        SCRIBE_OCTETUM_AB(655360 + y * 320 + x, color).
        REDDE 0.
    FIN-SI.
    DECLARA umbra SICUT NUMERUS VALENS CONTENTUM(50333776).
    SCRIBE_OCTETUM_AB(umbra + y * 320 + x, color).

    DECLARA ruber SICUT NUMERUS VALENS 0.
    DECLARA viridis SICUT NUMERUS VALENS 0.
    DECLARA caeruleus SICUT NUMERUS VALENS 0.
    SI color == 1 TUNC caeruleus = 170. FIN-SI.
    SI color == 2 TUNC viridis = 170. FIN-SI.
    SI color == 3 TUNC viridis = 170. caeruleus = 170. FIN-SI.
    SI color == 4 TUNC ruber = 170. FIN-SI.
    SI color == 5 TUNC ruber = 170. caeruleus = 170. FIN-SI.
    SI color == 6 TUNC ruber = 170. viridis = 85. FIN-SI.
    SI color == 7 TUNC ruber = 170. viridis = 170. caeruleus = 170. FIN-SI.
    SI color == 8 TUNC ruber = 85. viridis = 85. caeruleus = 85. FIN-SI.
    SI color == 9 TUNC ruber = 85. viridis = 85. caeruleus = 255. FIN-SI.
    SI color == 10 TUNC ruber = 85. viridis = 255. caeruleus = 85. FIN-SI.
    SI color == 11 TUNC ruber = 85. viridis = 255. caeruleus = 255. FIN-SI.
    SI color == 12 TUNC ruber = 255. viridis = 85. caeruleus = 85. FIN-SI.
    SI color == 13 TUNC ruber = 255. viridis = 85. caeruleus = 255. FIN-SI.
    SI color == 14 TUNC ruber = 255. viridis = 255. caeruleus = 85. FIN-SI.
    SI color == 15 TUNC ruber = 255. viridis = 255. caeruleus = 255. FIN-SI.

    DECLARA scala SICUT NUMERUS VALENS CONTENTUM(50333752).
    DECLARA linea SICUT NUMERUS VALENS CONTENTUM(50333720).
    DECLARA basis SICUT NUMERUS VALENS CONTENTUM(50333712).
    DECLARA initium_x SICUT NUMERUS VALENS CONTENTUM(50333760).
    DECLARA initium_y SICUT NUMERUS VALENS CONTENTUM(50333768).
    DECLARA formatum SICUT NUMERUS VALENS CONTENTUM(50333744).
    DECLARA sy SICUT NUMERUS VALENS 0.
    DUM sy < scala PERFICE
        DECLARA sx SICUT NUMERUS VALENS 0.
        DUM sx < scala PERFICE
            DECLARA locus SICUT NUMERUS VALENS basis + ((initium_y + y * scala + sy) * linea + initium_x + x * scala + sx) * 4.
            SI formatum == 0 TUNC
                SCRIBE_OCTETUM_AB(locus, ruber).
                SCRIBE_OCTETUM_AB(locus + 1, viridis).
                SCRIBE_OCTETUM_AB(locus + 2, caeruleus).
            ALITER
                SCRIBE_OCTETUM_AB(locus, caeruleus).
                SCRIBE_OCTETUM_AB(locus + 1, viridis).
                SCRIBE_OCTETUM_AB(locus + 2, ruber).
            FIN-SI.
            SCRIBE_OCTETUM_AB(locus + 3, 0).
            sx = sx + 1.
        FIN-DUM.
        sy = sy + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PIXEL_LEGE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    SI CONTENTUM(50333696) == 0 TUNC
        REDDE OCTETUS_AB(655360 + y * 320 + x).
    FIN-SI.
    REDDE OCTETUS_AB(CONTENTUM(50333776) + y * 320 + x).
FIN-FUNCTIO.

FUNCTIO RECTANGULUM REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT latitudo SICUT NUMERUS.
    ACCIPIT altitudo SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py < altitudo PERFICE
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px < latitudo PERFICE
            DECLARA factum_pixel SICUT NUMERUS VALENS PIXEL_SCRIBE(x + px, y + py, color).
            px = px + 1.
        FIN-DUM.
        py = py + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO LITTERAM_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT littera SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py < 8 PERFICE
        DECLARA forma SICUT NUMERUS VALENS 32768.
        SI CONTENTUM(50333696) == 1 TUNC forma = CONTENTUM(50333784). FIN-SI.
        DECLARA linea SICUT NUMERUS VALENS OCTETUS_AB(forma + littera * 8 + py).
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px < 8 PERFICE
            SI (linea & (128 >> px)) != 0 TUNC
                DECLARA factum_pixel SICUT NUMERUS VALENS PIXEL_SCRIBE(x + px, y + py, color).
            FIN-SI.
            px = px + 1.
        FIN-DUM.
        py = py + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO TEXTUM_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT NUMERUS.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < longitudo PERFICE
        DECLARA littera SICUT NUMERUS VALENS OCTETUS_AB(textus + i).
        DECLARA factum SICUT NUMERUS VALENS LITTERAM_SCRIBE(x + i * 8, y, littera, color).
        i = i + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO CURSOREM_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py < 14 PERFICE
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px <= py PERFICE
            SI px == 0 || px == py || py == 13 TUNC
                DECLARA factum_niger SICUT NUMERUS VALENS PIXEL_SCRIBE(x + px, y + py, 0).
            ALITER
                DECLARA factum_albus SICUT NUMERUS VALENS PIXEL_SCRIBE(x + px, y + py, 15).
            FIN-SI.
            px = px + 1.
        FIN-DUM.
        py = py + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FUNDUM_CURS_SALVA REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py < 14 PERFICE
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px < 14 PERFICE
            DECLARA color SICUT NUMERUS VALENS PIXEL_LEGE(x + px, y + py).
            SCRIBE_OCTETUM_AB(50331904 + py * 14 + px, color).
            px = px + 1.
        FIN-DUM.
        py = py + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FUNDUM_CURS_RESTITUE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py < 14 PERFICE
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px < 14 PERFICE
            DECLARA color SICUT NUMERUS VALENS OCTETUS_AB(50331904 + py * 14 + px).
            DECLARA factum_pixel SICUT NUMERUS VALENS PIXEL_SCRIBE(x + px, y + py, color).
            px = px + 1.
        FIN-DUM.
        py = py + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO FENESTRAM_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT latitudo SICUT NUMERUS.
    ACCIPIT altitudo SICUT NUMERUS.
    ACCIPIT titulus SICUT NUMERUS.
    ACCIPIT longitudo SICUT NUMERUS.
    DECLARA factum SICUT NUMERUS VALENS RECTANGULUM(x + 4, y + 4, latitudo, altitudo, 8).
    factum = RECTANGULUM(x, y, latitudo, altitudo, 0).
    factum = RECTANGULUM(x + 1, y + 1, latitudo - 2, altitudo - 2, 7).
    factum = RECTANGULUM(x + 2, y + 2, latitudo - 4, 1, 15).
    factum = RECTANGULUM(x + 2, y + 2, 1, altitudo - 4, 15).
    factum = RECTANGULUM(x + latitudo - 3, y + 3, 1, altitudo - 5, 8).
    factum = RECTANGULUM(x + 3, y + altitudo - 3, latitudo - 5, 1, 8).
    factum = RECTANGULUM(x + 3, y + 3, latitudo - 6, 17, 1).
    factum = TEXTUM_SCRIBE(x + 8, y + 7, titulus, longitudo, 15).
    factum = RECTANGULUM(x + latitudo - 18, y + 5, 13, 13, 0).
    factum = RECTANGULUM(x + latitudo - 17, y + 6, 11, 11, 7).
    factum = RECTANGULUM(x + latitudo - 14, y + 9, 5, 5, 0).
    factum = RECTANGULUM(x + latitudo - 13, y + 8, 3, 7, 7).
    factum = RECTANGULUM(x + latitudo - 15, y + 10, 7, 3, 7).
    REDDE factum.
FIN-FUNCTIO.

FUNCTIO DESKTOP_SCRIBE REDDENS NUMERUS.
    ACCIPIT modus SICUT NUMERUS.
    DECLARA factum SICUT NUMERUS VALENS RECTANGULUM(0, 0, 320, 200, 3).
    factum = TEXTUM_SCRIBE(120, 20, 4390912, 21, 11).
    factum = RECTANGULUM(27, 19, 38, 34, 0).
    factum = RECTANGULUM(28, 20, 36, 32, 15).
    factum = RECTANGULUM(31, 23, 30, 6, 1).
    factum = RECTANGULUM(33, 32, 26, 2, 3).
    factum = RECTANGULUM(33, 37, 20, 1, 8).
    factum = RECTANGULUM(33, 41, 24, 1, 8).
    factum = TEXTUM_SCRIBE(13, 58, 4390960, 8, 15).
    factum = RECTANGULUM(29, 87, 36, 36, 0).
    factum = RECTANGULUM(30, 88, 34, 34, 15).
    factum = RECTANGULUM(34, 92, 26, 26, 0).
    factum = RECTANGULUM(38, 96, 6, 6, 10).
    factum = RECTANGULUM(44, 102, 6, 6, 10).
    factum = RECTANGULUM(50, 108, 6, 6, 10).
    factum = RECTANGULUM(50, 96, 6, 6, 14).
    factum = RECTANGULUM(38, 108, 6, 6, 14).
    factum = TEXTUM_SCRIBE(17, 128, 4390976, 7, 15).
    factum = RECTANGULUM(121, 87, 42, 31, 0).
    factum = RECTANGULUM(122, 88, 40, 29, 15).
    factum = RECTANGULUM(126, 94, 14, 5, 14).
    factum = RECTANGULUM(126, 99, 32, 14, 14).
    factum = RECTANGULUM(129, 102, 26, 8, 6).
    factum = TEXTUM_SCRIBE(105, 128, 4391328, 9, 15).
    factum = RECTANGULUM(213, 87, 42, 31, 0).
    factum = RECTANGULUM(214, 88, 40, 29, 15).
    factum = RECTANGULUM(217, 91, 34, 6, 1).
    factum = RECTANGULUM(218, 101, 8, 8, 10).
    factum = RECTANGULUM(230, 101, 8, 8, 11).
    factum = RECTANGULUM(242, 101, 8, 8, 14).
    factum = TEXTUM_SCRIBE(190, 128, 4391744, 11, 15).
    factum = RECTANGULUM(0, 179, 320, 21, 0).
    factum = RECTANGULUM(0, 180, 320, 20, 7).
    factum = RECTANGULUM(1, 180, 318, 1, 15).
    factum = RECTANGULUM(2, 182, 70, 16, 0).
    factum = RECTANGULUM(3, 183, 68, 14, 7).
    factum = RECTANGULUM(4, 184, 66, 1, 15).
    factum = TEXTUM_SCRIBE(8, 186, 4390944, 7, 0).
    SI modus == 1 TUNC
        factum = RECTANGULUM(77, 182, 126, 16, 0).
        factum = RECTANGULUM(78, 183, 124, 14, 8).
        factum = TEXTUM_SCRIBE(84, 186, 4390960, 8, 15).
    FIN-SI.
    SI modus == 2 TUNC
        factum = RECTANGULUM(77, 182, 126, 16, 0).
        factum = RECTANGULUM(78, 183, 124, 14, 8).
        factum = TEXTUM_SCRIBE(84, 186, 4390976, 7, 15).
    FIN-SI.
    SI modus == 3 TUNC
        factum = RECTANGULUM(77, 182, 126, 16, 0).
        factum = RECTANGULUM(78, 183, 124, 14, 8).
        factum = TEXTUM_SCRIBE(84, 186, 4391328, 9, 15).
    FIN-SI.
    SI modus == 4 TUNC
        factum = RECTANGULUM(77, 182, 126, 16, 0).
        factum = RECTANGULUM(78, 183, 124, 14, 8).
        factum = TEXTUM_SCRIBE(84, 186, 4391744, 11, 15).
    FIN-SI.
    SI modus == 5 TUNC
        factum = RECTANGULUM(77, 182, 126, 16, 0).
        factum = RECTANGULUM(78, 183, 124, 14, 8).
        factum = TEXTUM_SCRIBE(84, 186, 4391880, 5, 15).
    FIN-SI.
    factum = TEXTUM_SCRIBE(224, 186, 4391296, 11, 0).
    REDDE factum.
FIN-FUNCTIO.

FUNCTIO MENUM_INITII_SCRIBE REDDENS NUMERUS.
    DECLARA factum SICUT NUMERUS VALENS RECTANGULUM(5, 38, 132, 142, 8).
    factum = RECTANGULUM(1, 34, 132, 145, 0).
    factum = RECTANGULUM(2, 35, 130, 143, 7).
    factum = RECTANGULUM(3, 36, 18, 141, 1).
    factum = RECTANGULUM(24, 39, 104, 29, 15).
    factum = TEXTUM_SCRIBE(32, 49, 4390960, 8, 0).
    factum = RECTANGULUM(24, 72, 104, 29, 15).
    factum = TEXTUM_SCRIBE(32, 82, 4391328, 9, 0).
    factum = RECTANGULUM(24, 105, 104, 29, 15).
    factum = TEXTUM_SCRIBE(32, 115, 4391744, 11, 0).
    factum = RECTANGULUM(24, 138, 104, 29, 15).
    factum = TEXTUM_SCRIBE(32, 148, 4390976, 7, 0).
    REDDE factum.
FIN-FUNCTIO.

FUNCTIO CURSOR_LINEA REDDENS NUMERUS.
    ACCIPIT textus SICUT ORDO DE LITTERA.
    ACCIPIT cursor SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA columna SICUT NUMERUS VALENS 0.
    DECLARA linea SICUT NUMERUS VALENS 0.
    DUM i < cursor PERFICE
        SI textus[i] == 10 TUNC
            columna = 0.
            linea = linea + 1.
        ALITER
            columna = columna + 1.
            SI columna >= 32 TUNC columna = 0. linea = linea + 1. FIN-SI.
        FIN-SI.
        i = i + 1.
    FIN-DUM.
    REDDE linea.
FIN-FUNCTIO.

FUNCTIO CURSOR_COLUMNA REDDENS NUMERUS.
    ACCIPIT textus SICUT ORDO DE LITTERA.
    ACCIPIT cursor SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA columna SICUT NUMERUS VALENS 0.
    DUM i < cursor PERFICE
        SI textus[i] == 10 TUNC
            columna = 0.
        ALITER
            columna = columna + 1.
            SI columna >= 32 TUNC columna = 0. FIN-SI.
        FIN-SI.
        i = i + 1.
    FIN-DUM.
    REDDE columna.
FIN-FUNCTIO.

FUNCTIO CURSOR_LOCUS REDDENS NUMERUS.
    ACCIPIT textus SICUT ORDO DE LITTERA.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT linea_scopus SICUT NUMERUS.
    ACCIPIT columna_scopus SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA columna SICUT NUMERUS VALENS 0.
    DECLARA linea SICUT NUMERUS VALENS 0.
    DUM i < longitudo PERFICE
        SI linea == linea_scopus && columna >= columna_scopus TUNC REDDE i. FIN-SI.
        SI textus[i] == 10 TUNC
            SI linea == linea_scopus TUNC REDDE i. FIN-SI.
            columna = 0.
            linea = linea + 1.
        ALITER
            columna = columna + 1.
            SI columna >= 32 TUNC columna = 0. linea = linea + 1. FIN-SI.
        FIN-SI.
        SI linea > linea_scopus TUNC REDDE i + 1. FIN-SI.
        i = i + 1.
    FIN-DUM.
    REDDE longitudo.
FIN-FUNCTIO.

FUNCTIO TEXTUM_EDITORIS_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT ORDO DE LITTERA.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT cursor SICUT NUMERUS.
    ACCIPIT prima_linea SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA columna SICUT NUMERUS VALENS 0.
    DECLARA linea SICUT NUMERUS VALENS 0.
    DECLARA caret_columna SICUT NUMERUS VALENS 0.
    DECLARA caret_linea SICUT NUMERUS VALENS 0.
    DECLARA caret_visibilis SICUT NUMERUS VALENS 0.
    DUM i < longitudo && linea < prima_linea + 10 PERFICE
        SI i == cursor && linea >= prima_linea TUNC
            caret_columna = columna.
            caret_linea = linea.
            caret_visibilis = 1.
        FIN-SI.
        DECLARA littera SICUT NUMERUS VALENS textus[i].
        SI littera == 10 TUNC
            columna = 0.
            linea = linea + 1.
        ALITER
            SI linea >= prima_linea TUNC
                DECLARA factum SICUT NUMERUS VALENS LITTERAM_SCRIBE(x + columna * 8, y + (linea - prima_linea) * 9, littera, 0).
            FIN-SI.
            columna = columna + 1.
            SI columna >= 32 TUNC columna = 0. linea = linea + 1. FIN-SI.
        FIN-SI.
        i = i + 1.
    FIN-DUM.
    SI cursor == longitudo && linea >= prima_linea && linea < prima_linea + 10 TUNC
        caret_columna = columna.
        caret_linea = linea.
        caret_visibilis = 1.
    FIN-SI.
    SI caret_visibilis == 1 TUNC
        DECLARA caret SICUT NUMERUS VALENS RECTANGULUM(x + caret_columna * 8, y + (caret_linea - prima_linea) * 9, 1, 8, 0).
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ORDINEM_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT ORDO DE LITTERA.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < longitudo PERFICE
        DECLARA factum SICUT NUMERUS VALENS LITTERAM_SCRIBE(x + i * 8, y, textus[i], color).
        i = i + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO ORDINEM_PARTEM_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT ORDO DE LITTERA.
    ACCIPIT initium SICUT NUMERUS.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < longitudo PERFICE
        DECLARA factum SICUT NUMERUS VALENS LITTERAM_SCRIBE(x + i * 8, y, textus[initium + i], color).
        i = i + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO SCRIPTOR_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT ORDO DE LITTERA.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT cursor SICUT NUMERUS.
    ACCIPIT prima_linea SICUT NUMERUS.
    DECLARA status_archivi SICUT NUMERUS VALENS CONTENTUM(50333832).
    DECLARA fasciculus_activus SICUT NUMERUS VALENS CONTENTUM(50333840).
    DECLARA factum SICUT NUMERUS VALENS FENESTRAM_SCRIBE(x, y, 286, 164, 4391032, 18).
    factum = RECTANGULUM(x + 3, y + 21, 280, 15, 7).
    factum = RECTANGULUM(x + 7, y + 22, 48, 14, 0).
    factum = RECTANGULUM(x + 8, y + 23, 46, 12, 15).
    factum = TEXTUM_SCRIBE(x + 11, y + 25, 4391392, 5, 0).
    factum = RECTANGULUM(x + 59, y + 22, 48, 14, 0).
    factum = RECTANGULUM(x + 60, y + 23, 46, 12, 15).
    factum = TEXTUM_SCRIBE(x + 63, y + 25, 4391384, 5, 0).
    SI fasciculus_activus < 12 && CONTENTUM(50401344 + fasciculus_activus * 32) == 1 TUNC
        factum = TEXTUM_SCRIBE(x + 120, y + 25, 50401360 + fasciculus_activus * 32, 12, 8).
    ALITER
        factum = TEXTUM_SCRIBE(x + 120, y + 25, 4391368, 12, 8).
    FIN-SI.
    factum = RECTANGULUM(x + 7, y + 38, 272, 105, 0).
    factum = RECTANGULUM(x + 8, y + 39, 270, 103, 15).
    SI longitudo == 0 TUNC
        factum = TEXTUM_SCRIBE(x + 16, y + 47, 4391096, 10, 8).
    FIN-SI.
    factum = TEXTUM_EDITORIS_SCRIBE(x + 16, y + 47, textus, longitudo, cursor, prima_linea).
    factum = RECTANGULUM(x + 7, y + 146, 272, 13, 15).
    SI fasciculus_activus < 12 && CONTENTUM(50401344 + fasciculus_activus * 32) == 1 TUNC
        factum = TEXTUM_SCRIBE(x + 12, y + 149, 50401360 + fasciculus_activus * 32, 12, 8).
    ALITER
        factum = TEXTUM_SCRIBE(x + 12, y + 149, 4391368, 12, 8).
    FIN-SI.
    SI status_archivi == 0 TUNC factum = TEXTUM_SCRIBE(x + 210, y + 149, 4391264, 7, 8). FIN-SI.
    SI status_archivi == 1 TUNC factum = TEXTUM_SCRIBE(x + 202, y + 149, 4391400, 8, 2). FIN-SI.
    SI status_archivi == 2 TUNC factum = TEXTUM_SCRIBE(x + 210, y + 149, 4391416, 7, 1). FIN-SI.
    SI status_archivi == 3 TUNC factum = TEXTUM_SCRIBE(x + 210, y + 149, 4391440, 7, 4). FIN-SI.
    REDDE factum.
FIN-FUNCTIO.

FUNCTIO FASCICULUM_VXNAT REDDENS NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    SI indice < 0 || indice >= 12 || CONTENTUM(50401344 + indice * 32) != 1 TUNC REDDE 0. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < 16 && OCTETUS_AB(50401360 + indice * 32 + i) != 0 && OCTETUS_AB(50401360 + indice * 32 + i) != 32 PERFICE
        i = i + 1.
    FIN-DUM.
    SI i < 6 TUNC REDDE 0. FIN-SI.
    DECLARA locus SICUT NUMERUS VALENS 50401360 + indice * 32 + i - 6.
    SI OCTETUS_AB(locus) == 46 && OCTETUS_AB(locus + 1) == 86 && OCTETUS_AB(locus + 2) == 88 && OCTETUS_AB(locus + 3) == 78 && OCTETUS_AB(locus + 4) == 65 && OCTETUS_AB(locus + 5) == 84 TUNC
        REDDE 1.
    FIN-SI.
