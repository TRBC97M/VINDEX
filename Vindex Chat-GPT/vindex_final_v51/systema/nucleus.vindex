                    SCRIBE_OCTETUM_AB(50401363 + nomen_scopus * 32 + longitudo_nominis, 78).
                    SCRIBE_OCTETUM_AB(50401364 + nomen_scopus * 32 + longitudo_nominis, 65).
                    SCRIBE_OCTETUM_AB(50401365 + nomen_scopus * 32 + longitudo_nominis, 84).
                FIN-SI.
                fasciculus_activus = nomen_scopus.
                SI nomen_genus == 0 TUNC fasciculus_electus = nomen_scopus. ALITER programma_electus = nomen_scopus. FIN-SI.
                CONTENTUM(50401312) = nomen_scopus.
                factum = VOLUMEN_NUMERA().
                SI nomen_creatio == 0 TUNC longitudo_editoris = FASCICULUM_LEGE(nomen_scopus, editor). cursor_editoris = longitudo_editoris. prima_linea = 0. FIN-SI.
                SI nomen_creatio == 1 && nomen_genus == 0 TUNC longitudo_editoris = 0. cursor_editoris = 0. prima_linea = 0. status_archivi = 0. FIN-SI.
                SI nomen_creatio == 1 && nomen_genus == 1 TUNC
                    longitudo_editoris = 0.
                    DECLARA locus_programmatis_novi SICUT NUMERUS VALENS FASCICULUM_LOCUS(nomen_scopus).
                    DUM longitudo_editoris < 1279 && OCTETUS_AB(4391904 + longitudo_editoris) != 0 PERFICE
                        editor[longitudo_editoris] = OCTETUS_AB(4391904 + longitudo_editoris).
                        SCRIBE_OCTETUM_AB(locus_programmatis_novi + longitudo_editoris, editor[longitudo_editoris]).
                        longitudo_editoris = longitudo_editoris + 1.
                    FIN-DUM.
                    cursor_editoris = longitudo_editoris.
                    prima_linea = 0.
                    CONTENTUM(50401352 + nomen_scopus * 32) = longitudo_editoris.
                FIN-SI.
                SI VOLUMEN_SERVA() == 1 TUNC
                    SI nomen_creatio == 1 TUNC status_fasciculi = 2. ALITER status_fasciculi = 1. FIN-SI.
                    SI nomen_genus == 1 TUNC status_programmatis = 2. FIN-SI.
                ALITER status_fasciculi = 4. SI nomen_genus == 1 TUNC status_programmatis = 4. FIN-SI. FIN-SI.
                nomen_modus = 0.
            FIN-SI.
            actio_fasciculi = 0.
            pingendum = 1.
        FIN-SI.

        DECLARA novum_tempus SICUT NUMERUS VALENS CONTENTUM(50331728).
        SI modus == 2 && finis_ludi == 0 && novum_tempus - vetus_tempus >= 8 TUNC
            vetus_tempus = novum_tempus.
            DECLARA novum_x SICUT NUMERUS VALENS serpent_x[0].
            DECLARA novum_y SICUT NUMERUS VALENS serpent_y[0].
            SI directio == 0 TUNC novum_y = novum_y - 1. FIN-SI.
            SI directio == 1 TUNC novum_x = novum_x + 1. FIN-SI.
            SI directio == 2 TUNC novum_y = novum_y + 1. FIN-SI.
            SI directio == 3 TUNC novum_x = novum_x - 1. FIN-SI.
            SI novum_x < 0 || novum_x >= 22 || novum_y < 0 || novum_y >= 12 TUNC
                finis_ludi = 1.
            FIN-SI.
            DECLARA collision SICUT NUMERUS VALENS 0.
            DUM collision < longitudo_serpentis PERFICE
                SI serpent_x[collision] == novum_x && serpent_y[collision] == novum_y TUNC
                    finis_ludi = 1.
                FIN-SI.
                collision = collision + 1.
            FIN-DUM.
            SI finis_ludi == 0 TUNC
                DECLARA crevit SICUT NUMERUS VALENS 0.
                SI novum_x == cibus_x && novum_y == cibus_y TUNC
                    SI longitudo_serpentis < 63 TUNC
                        longitudo_serpentis = longitudo_serpentis + 1.
                    FIN-SI.
                    puncta = puncta + 1.
                    crevit = 1.
                FIN-SI.
                DECLARA corpus SICUT NUMERUS VALENS longitudo_serpentis - 1.
                DUM corpus > 0 PERFICE
                    serpent_x[corpus] = serpent_x[corpus - 1].
                    serpent_y[corpus] = serpent_y[corpus - 1].
                    corpus = corpus - 1.
                FIN-DUM.
                serpent_x[0] = novum_x.
                serpent_y[0] = novum_y.
                SI crevit == 1 TUNC
                    cibus_x = (cibus_x * 7 + 3) % 22.
                    cibus_y = (cibus_y * 5 + 1) % 12.
                    SI cibus_x == novum_x && cibus_y == novum_y TUNC
                        cibus_x = (cibus_x + 5) % 22.
                    FIN-SI.
                FIN-SI.
            FIN-SI.
            pingendum = 1.
        FIN-SI.

        SI pingendum == 1 TUNC
            factum = DESKTOP_SCRIBE(modus).
            SI modus == 1 TUNC
                CONTENTUM(50333832) = status_archivi.
                CONTENTUM(50333840) = fasciculus_activus.
                factum = SCRIPTOR_SCRIBE(fenestra_x, fenestra_y, editor, longitudo_editoris, cursor_editoris, prima_linea).
            FIN-SI.
            SI modus == 3 TUNC
                CONTENTUM(50333824) = status_fasciculi.
                CONTENTUM(50333848) = dele_modus.
                factum = FASCICULI_SCRIBE(fenestra_x, fenestra_y, fasciculus_electus, nomen_modus, nomen_editor, longitudo_nominis).
            FIN-SI.
            SI modus == 4 TUNC
                CONTENTUM(50333848) = dele_modus.
                CONTENTUM(50333856) = status_programmatis.
                factum = PROGRAMMATA_SCRIBE(fenestra_x, fenestra_y, programma_electus, nomen_modus, nomen_editor, longitudo_nominis).
            FIN-SI.
            SI modus == 5 TUNC
                factum = PROGRAMMA_SCRIBE(fenestra_x, fenestra_y, editor, longitudo_editoris, fasciculus_activus).
            FIN-SI.
            SI modus == 2 TUNC
                factum = SERPENS_SCRIBE(fenestra_x, fenestra_y, serpent_x, serpent_y, longitudo_serpentis, puncta).
                SI finis_ludi == 0 TUNC
                    factum = RECTANGULUM(fenestra_x + 22 + cibus_x * 8, fenestra_y + 34 + cibus_y * 8, 7, 7, 4).
                ALITER
                    factum = RECTANGULUM(fenestra_x + 43, fenestra_y + 67, 134, 43, 7).
                    factum = RECTANGULUM(fenestra_x + 44, fenestra_y + 68, 132, 41, 15).
                    factum = TEXTUM_SCRIBE(fenestra_x + 70, fenestra_y + 75, 4391144, 10, 4).
                    factum = TEXTUM_SCRIBE(fenestra_x + 58, fenestra_y + 92, 4391160, 13, 0).
                FIN-SI.
            FIN-SI.
            SI menu == 1 TUNC
                factum = MENUM_INITII_SCRIBE().
            FIN-SI.
            factum = FUNDUM_CURS_SALVA(mus_x, mus_y).
            factum = CURSOREM_SCRIBE(mus_x, mus_y).
            cursor_positus = 1.
            pingendum = 0.
        ALITER
            SI mus_mutatus == 1 TUNC
                factum = FUNDUM_CURS_SALVA(mus_x, mus_y).
                factum = CURSOREM_SCRIBE(mus_x, mus_y).
                cursor_positus = 1.
            FIN-SI.
        FIN-SI.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.
