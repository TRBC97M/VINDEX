FUNCTIO LINEAE_NUMERUM REDDENS NUMERUS.
    ACCIPIT textus SICUT ORDO DE LITTERA.
    ACCIPIT initium SICUT NUMERUS.
    ACCIPIT finis SICUT NUMERUS.
    ACCIPIT ordo SICUT NUMERUS.
    DECLARA cursor SICUT NUMERUS VALENS initium.
    DECLARA inventus SICUT NUMERUS VALENS 0.
    DUM cursor < finis PERFICE
        DUM cursor < finis && textus[cursor] == 32 PERFICE cursor = cursor + 1. FIN-DUM.
        SI cursor >= finis TUNC REDDE 0 - 1. FIN-SI.
        SI textus[cursor] < 48 || textus[cursor] > 57 TUNC REDDE 0 - 1. FIN-SI.
        DECLARA valor SICUT NUMERUS VALENS 0.
        DUM cursor < finis && textus[cursor] >= 48 && textus[cursor] <= 57 PERFICE
            valor = valor * 10 + textus[cursor] - 48.
            cursor = cursor + 1.
        FIN-DUM.
        SI inventus == ordo TUNC REDDE valor. FIN-SI.
        inventus = inventus + 1.
        SI cursor < finis && textus[cursor] != 32 TUNC REDDE 0 - 1. FIN-SI.
    FIN-DUM.
    REDDE 0 - 1.
FIN-FUNCTIO.

FUNCTIO PROGRAMMA_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT ORDO DE LITTERA.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    DECLARA titulus SICUT NUMERUS VALENS 4391840.
    SI FASCICULUM_VXNAT(indice) == 1 TUNC titulus = 50401360 + indice * 32. FIN-SI.
    DECLARA factum SICUT NUMERUS VALENS FENESTRAM_SCRIBE(x, y, 286, 164, titulus, 12).
    factum = RECTANGULUM(x + 7, y + 25, 272, 118, 0).
    factum = RECTANGULUM(x + 8, y + 26, 270, 116, 15).
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA cursor_x SICUT NUMERUS VALENS 0.
    DECLARA cursor_y SICUT NUMERUS VALENS 0.
    DECLARA color SICUT NUMERUS VALENS 0.
    DECLARA erratum SICUT NUMERUS VALENS 0.
    DUM i < longitudo PERFICE
        DECLARA initium SICUT NUMERUS VALENS i.
        DUM i < longitudo && textus[i] != 10 PERFICE i = i + 1. FIN-DUM.
        DECLARA finis SICUT NUMERUS VALENS i.
        SI finis - initium >= 7 && textus[initium] == 83 && textus[initium + 1] == 67 && textus[initium + 2] == 82 && textus[initium + 3] == 73 && textus[initium + 4] == 66 && textus[initium + 5] == 69 && textus[initium + 6] == 32 TUNC
            DECLARA mensura SICUT NUMERUS VALENS finis - initium - 7.
            SI cursor_x >= 0 && cursor_x <= 246 && cursor_y >= 0 && cursor_y <= 92 TUNC
                DECLARA spatium_textus SICUT NUMERUS VALENS (254 - cursor_x) / 8.
                SI mensura > spatium_textus TUNC mensura = spatium_textus. FIN-SI.
                factum = ORDINEM_PARTEM_SCRIBE(x + 16 + cursor_x, y + 34 + cursor_y, textus, initium + 7, mensura, color).
                cursor_y = cursor_y + 10.
            ALITER erratum = 1. FIN-SI.
        ALITER
            SI (finis - initium == 7 || finis - initium == 8) && textus[initium] == 67 && textus[initium + 1] == 79 && textus[initium + 2] == 76 && textus[initium + 3] == 79 && textus[initium + 4] == 82 && textus[initium + 5] == 32 TUNC
                DECLARA novus_color SICUT NUMERUS VALENS textus[initium + 6] - 48.
                SI textus[initium + 6] < 48 || textus[initium + 6] > 57 TUNC erratum = 1. FIN-SI.
                SI finis - initium == 8 TUNC
                    SI textus[initium + 7] >= 48 && textus[initium + 7] <= 57 TUNC novus_color = novus_color * 10 + textus[initium + 7] - 48. ALITER erratum = 1. FIN-SI.
                FIN-SI.
                SI erratum == 0 && novus_color >= 0 && novus_color <= 15 TUNC color = novus_color. ALITER erratum = 1. FIN-SI.
            ALITER
                SI finis - initium >= 6 && textus[initium] == 76 && textus[initium + 1] == 79 && textus[initium + 2] == 67 && textus[initium + 3] == 85 && textus[initium + 4] == 83 && textus[initium + 5] == 32 TUNC
                    DECLARA locus_x SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 6, finis, 0).
                    DECLARA locus_y SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 6, finis, 1).
                    SI locus_x >= 0 && locus_x <= 246 && locus_y >= 0 && locus_y <= 92 TUNC
                        cursor_x = locus_x.
                        cursor_y = locus_y.
                    ALITER erratum = 1. FIN-SI.
                ALITER
                    SI finis - initium >= 12 && textus[initium] == 82 && textus[initium + 1] == 69 && textus[initium + 2] == 67 && textus[initium + 3] == 84 && textus[initium + 4] == 65 && textus[initium + 5] == 78 && textus[initium + 6] == 71 && textus[initium + 7] == 85 && textus[initium + 8] == 76 && textus[initium + 9] == 85 && textus[initium + 10] == 77 && textus[initium + 11] == 32 TUNC
                        DECLARA rect_x SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 12, finis, 0).
                        DECLARA rect_y SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 12, finis, 1).
                        DECLARA rect_w SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 12, finis, 2).
                        DECLARA rect_h SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 12, finis, 3).
                        DECLARA rect_c SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 12, finis, 4).
                        SI rect_x >= 0 && rect_y >= 0 && rect_w > 0 && rect_h > 0 && rect_c >= 0 && rect_c <= 15 && rect_x + rect_w <= 254 && rect_y + rect_h <= 100 TUNC
                            factum = RECTANGULUM(x + 16 + rect_x, y + 34 + rect_y, rect_w, rect_h, rect_c).
                        ALITER erratum = 1. FIN-SI.
                    ALITER
                        SI finis - initium >= 6 && textus[initium] == 77 && textus[initium + 1] == 65 && textus[initium + 2] == 82 && textus[initium + 3] == 71 && textus[initium + 4] == 79 && textus[initium + 5] == 32 TUNC
                            DECLARA margo_x SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 6, finis, 0).
                            DECLARA margo_y SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 6, finis, 1).
                            DECLARA margo_w SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 6, finis, 2).
                            DECLARA margo_h SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 6, finis, 3).
                            DECLARA margo_c SICUT NUMERUS VALENS LINEAE_NUMERUM(textus, initium + 6, finis, 4).
                            SI margo_x >= 0 && margo_y >= 0 && margo_w >= 2 && margo_h >= 2 && margo_c >= 0 && margo_c <= 15 && margo_x + margo_w <= 254 && margo_y + margo_h <= 100 TUNC
                                factum = RECTANGULUM(x + 16 + margo_x, y + 34 + margo_y, margo_w, 1, margo_c).
                                factum = RECTANGULUM(x + 16 + margo_x, y + 33 + margo_y + margo_h, margo_w, 1, margo_c).
                                factum = RECTANGULUM(x + 16 + margo_x, y + 34 + margo_y, 1, margo_h, margo_c).
                                factum = RECTANGULUM(x + 15 + margo_x + margo_w, y + 34 + margo_y, 1, margo_h, margo_c).
                            ALITER erratum = 1. FIN-SI.
                        ALITER
                            SI finis - initium >= 9 && textus[initium] == 80 && textus[initium + 1] == 82 && textus[initium + 2] == 79 && textus[initium + 3] == 71 && textus[initium + 4] == 82 && textus[initium + 5] == 65 && textus[initium + 6] == 77 && textus[initium + 7] == 77 && textus[initium + 8] == 65 TUNC
                                erratum = erratum.
                            ALITER
                                SI finis - initium == 5 && textus[initium] == 70 && textus[initium + 1] == 73 && textus[initium + 2] == 78 && textus[initium + 3] == 73 && textus[initium + 4] == 83 TUNC
                                    i = longitudo.
                                ALITER
                                    SI finis > initium TUNC erratum = 1. FIN-SI.
                                FIN-SI.
                            FIN-SI.
                        FIN-SI.
                    FIN-SI.
                FIN-SI.
            FIN-SI.
        FIN-SI.
        i = i + 1.
    FIN-DUM.
    factum = RECTANGULUM(x + 7, y + 146, 272, 13, 15).
    SI erratum == 0 TUNC factum = TEXTUM_SCRIBE(x + 12, y + 149, 4391840, 14, 2). FIN-SI.
    SI erratum == 1 TUNC factum = TEXTUM_SCRIBE(x + 12, y + 149, 4391856, 17, 4). FIN-SI.
    REDDE factum.
FIN-FUNCTIO.

FUNCTIO SERPENTEM_INIT REDDENS NUMERUS.
    ACCIPIT serpent_x SICUT ORDO DE NUMERUS.
    ACCIPIT serpent_y SICUT ORDO DE NUMERUS.
    serpent_x[0] = 10.
    serpent_y[0] = 6.
    serpent_x[1] = 9.
    serpent_y[1] = 6.
    serpent_x[2] = 8.
    serpent_y[2] = 6.
    serpent_x[3] = 7.
    serpent_y[3] = 6.
    REDDE 4.
FIN-FUNCTIO.

FUNCTIO SERPENS_SCRIBE REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT serpent_x SICUT ORDO DE NUMERUS.
    ACCIPIT serpent_y SICUT ORDO DE NUMERUS.
    ACCIPIT longitudo SICUT NUMERUS.
    ACCIPIT puncta SICUT NUMERUS.
    DECLARA factum SICUT NUMERUS VALENS FENESTRAM_SCRIBE(x, y, 220, 164, 4391056, 14).
    factum = RECTANGULUM(x + 12, y + 25, 196, 111, 0).
    factum = RECTANGULUM(x + 20, y + 32, 180, 100, 0).
    DECLARA i SICUT NUMERUS VALENS longitudo - 1.
    DUM i >= 0 PERFICE
        DECLARA color SICUT NUMERUS VALENS 10.
        SI i == 0 TUNC
            color = 14.
        FIN-SI.
        factum = RECTANGULUM(x + 22 + serpent_x[i] * 8, y + 34 + serpent_y[i] * 8, 7, 7, color).
        i = i - 1.
    FIN-DUM.
    factum = TEXTUM_SCRIBE(x + 12, y + 146, 4391112, 6, 0).
    DECLARA decem SICUT NUMERUS VALENS puncta / 10.
    DECLARA unum SICUT NUMERUS VALENS puncta % 10.
    SI decem > 0 TUNC
        factum = LITTERAM_SCRIBE(x + 64, y + 146, 48 + decem, 0).
    FIN-SI.
    factum = LITTERAM_SCRIBE(x + 72, y + 146, 48 + unum, 0).
    factum = TEXTUM_SCRIBE(x + 92, y + 146, 4391184, 15, 8).
    REDDE factum.
FIN-FUNCTIO.

