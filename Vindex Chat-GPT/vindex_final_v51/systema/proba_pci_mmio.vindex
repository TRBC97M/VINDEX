// P12-V1 — lectio MMIO vera ex BAR e1000e sub UEFI.

IMPORTA "rectores/pci.vindex".
IMPORTA "rectores/mmio.vindex".

FUNCTIO MMIO_MEMORIA_VACUA REDDENS NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT mensura SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < mensura PERFICE
        SCRIBE_OCTETUM_AB(destinatio + i, 0).
        i = i + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO MMIO_CIFRA_HEX REDDENS NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SI valor < 10 TUNC REDDE 48 + valor. FIN-SI.
    REDDE 55 + valor.
FIN-FUNCTIO.

FUNCTIO MMIO_HEX16_SCRIBE REDDENS NUMERUS.
    ACCIPIT buf SICUT NUMERUS.
    ACCIPIT positio SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SCRIBE_OCTETUM_AB(buf + positio, MMIO_CIFRA_HEX((valor / 4096) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 2, MMIO_CIFRA_HEX((valor / 256) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 4, MMIO_CIFRA_HEX((valor / 16) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 6, MMIO_CIFRA_HEX(valor & 15)).
    REDDE 8.
FIN-FUNCTIO.

FUNCTIO MMIO_HEX32_SCRIBE REDDENS NUMERUS.
    ACCIPIT buf SICUT NUMERUS.
    ACCIPIT positio SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    DECLARA f1 SICUT NUMERUS VALENS MMIO_HEX16_SCRIBE(buf, positio, (valor / 65536) & 65535).
    DECLARA f2 SICUT NUMERUS VALENS MMIO_HEX16_SCRIBE(buf, positio + 8, valor & 65535).
    REDDE 16.
FIN-FUNCTIO.

FUNCTIO MMIO_HEX64_SCRIBE REDDENS NUMERUS.
    ACCIPIT buf SICUT NUMERUS.
    ACCIPIT positio SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    DECLARA f1 SICUT NUMERUS VALENS MMIO_HEX32_SCRIBE(buf, positio, (valor / 4294967296) & 4294967295).
    DECLARA f2 SICUT NUMERUS VALENS MMIO_HEX32_SCRIBE(buf, positio + 16, valor & 4294967295).
    REDDE 32.
FIN-FUNCTIO.

FUNCTIO MMIO_CATENAM_SCRIBE REDDENS NUMERUS.
    ACCIPIT conout SICUT NUMERUS.
    ACCIPIT catena SICUT NUMERUS.
    DECLARA scribe SICUT NUMERUS VALENS CONTENTUM(conout + 8).
    REDDE UEFI_VOCA6(scribe, conout, catena, 0, 0, 0, 0).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA ts SICUT NUMERUS VALENS CONTENTUM(16777224).
    SI ts == 0 TUNC REDDE 1. FIN-SI.
    DECLARA conout SICUT NUMERUS VALENS CONTENTUM(ts + 64).
    DECLARA descriptor SICUT NUMERUS VALENS RESERVA_OCTETA(24).
    SI PCI_REGISTRUM_INITIA(descriptor, 2) != 0 TUNC REDDE 2. FIN-SI.
    DECLARA numerus SICUT NUMERUS VALENS PCI_ENUMERA_PER_PONTES(descriptor).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < numerus PERFICE
        DECLARA sedes SICUT NUMERUS VALENS PCI_REGISTRUM_SEDES(descriptor, i).
        SI CONTENTUM(sedes + 24) == 32902 && CONTENTUM(sedes + 32) == 4307 TUNC
            DECLARA bus SICUT NUMERUS VALENS CONTENTUM(sedes).
            DECLARA app SICUT NUMERUS VALENS CONTENTUM(sedes + 8).
            DECLARA fn SICUT NUMERUS VALENS CONTENTUM(sedes + 16).
            DECLARA regio SICUT NUMERUS VALENS MMIO_PCI_MAPPA(bus, app, fn, 0, MMIO_LECTIO()).
            SI regio == 0 TUNC REDDE 3. FIN-SI.
            DECLARA status1 SICUT NUMERUS VALENS MR_LEGE32(regio, 8).
            DECLARA err1 SICUT NUMERUS VALENS MMIO_ERRATUM(regio).
            DECLARA status2 SICUT NUMERUS VALENS MR_LEGE32(regio, 8).
            DECLARA err2 SICUT NUMERUS VALENS MMIO_ERRATUM(regio).
            DECLARA rectum SICUT NUMERUS VALENS 1.
            SI err1 != 0 || err2 != 0 || (CONTENTUM(regio + 40) & MMIO_APPARATUS()) == 0 || (CONTENTUM(regio + 40) & MMIO_IDENTITAS()) == 0 TUNC rectum = 0. FIN-SI.
            SI (CONTENTUM(regio + 40) & MMIO_SCRIPTIO()) != 0 || CONTENTUM(regio) != CONTENTUM(regio + 8) TUNC rectum = 0. FIN-SI.

            DECLARA buf SICUT NUMERUS VALENS RESERVA_OCTETA(256).
            DECLARA f SICUT NUMERUS VALENS MMIO_MEMORIA_VACUA(buf, 256).
            DECLARA p SICUT NUMERUS VALENS 0.
            p = p + MMIO_HEX16_SCRIBE(buf, p, 32902).
            SCRIBE_OCTETUM_AB(buf + p, 58). p = p + 2.
            p = p + MMIO_HEX16_SCRIBE(buf, p, 4307).
            SCRIBE_OCTETUM_AB(buf + p, 32). p = p + 2.
            SCRIBE_OCTETUM_AB(buf + p, 77). p = p + 2.
            SCRIBE_OCTETUM_AB(buf + p, 32). p = p + 2.
            p = p + MMIO_HEX64_SCRIBE(buf, p, CONTENTUM(regio)).
            SCRIBE_OCTETUM_AB(buf + p, 32). p = p + 2.
            p = p + MMIO_HEX64_SCRIBE(buf, p, CONTENTUM(regio + 16)).
            SCRIBE_OCTETUM_AB(buf + p, 32). p = p + 2.
            p = p + MMIO_HEX32_SCRIBE(buf, p, status1).
            SCRIBE_OCTETUM_AB(buf + p, 32). p = p + 2.
            p = p + MMIO_HEX32_SCRIBE(buf, p, status2).
            SCRIBE_OCTETUM_AB(buf + p, 32). p = p + 2.
            SI rectum == 1 TUNC SCRIBE_OCTETUM_AB(buf + p, 82). ALITER SCRIBE_OCTETUM_AB(buf + p, 88). FIN-SI.
            p = p + 2.
            SCRIBE_OCTETUM_AB(buf + p, 13). SCRIBE_OCTETUM_AB(buf + p + 2, 10).
            f = MMIO_CATENAM_SCRIBE(conout, buf).
            REDDE 0.
        FIN-SI.
        i = i + 1.
    FIN-DUM.
    REDDE 4.
FIN-FUNCTIO.
