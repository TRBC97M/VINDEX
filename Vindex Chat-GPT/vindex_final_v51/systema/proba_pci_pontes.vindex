// P12-III — probatio enumerationis PCI per pontes sub UEFI vero.
//
// Probat quod enumeratio non amplius unum spatium bus planum supponit,
// sed pontes agnoscit et bus secundarios post eos percurrit.

IMPORTA "rectores/pci.vindex".

FUNCTIO MEMORIA_VACUA REDDENS NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT mensura SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < mensura PERFICE
        SCRIBE_OCTETUM_AB(destinatio + i, 0).
        i = i + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO CIFRA_HEX REDDENS NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SI valor < 10 TUNC REDDE 48 + valor. FIN-SI.
    REDDE 55 + valor.
FIN-FUNCTIO.

FUNCTIO HEX16_SCRIBE REDDENS NUMERUS.
    ACCIPIT buf SICUT NUMERUS.
    ACCIPIT positio SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SCRIBE_OCTETUM_AB(buf + positio, CIFRA_HEX((valor / 4096) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 2, CIFRA_HEX((valor / 256) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 4, CIFRA_HEX((valor / 16) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 6, CIFRA_HEX(valor & 15)).
    REDDE 8.
FIN-FUNCTIO.

FUNCTIO HEX8_SCRIBE REDDENS NUMERUS.
    ACCIPIT buf SICUT NUMERUS.
    ACCIPIT positio SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SCRIBE_OCTETUM_AB(buf + positio, CIFRA_HEX((valor / 16) & 15)).
    SCRIBE_OCTETUM_AB(buf + positio + 2, CIFRA_HEX(valor & 15)).
    REDDE 4.
FIN-FUNCTIO.

FUNCTIO SCRIBE_CATENAM REDDENS NUMERUS.
    ACCIPIT conout SICUT NUMERUS.
    ACCIPIT catena SICUT NUMERUS.
    DECLARA sc SICUT NUMERUS VALENS CONTENTUM(conout + 8).
    REDDE UEFI_VOCA6(sc, conout, catena, 0, 0, 0, 0).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA ts SICUT NUMERUS VALENS CONTENTUM(16777224).
    SI ts == 0 TUNC REDDE 1. FIN-SI.
    DECLARA co SICUT NUMERUS VALENS CONTENTUM(ts + 64).

    DECLARA buf SICUT NUMERUS VALENS RESERVA_OCTETA(256).

    // Capacitas initialis parva de industria: probat crescentiam veram.
    DECLARA descriptor SICUT NUMERUS VALENS RESERVA_OCTETA(24).
    SI PCI_REGISTRUM_INITIA(descriptor, 2) != 0 TUNC REDDE 2. FIN-SI.

    DECLARA numerus SICUT NUMERUS VALENS PCI_ENUMERA_PER_PONTES(descriptor).

    // "PCIP=" numerus " CAP=" capacitas
    DECLARA ig_v SICUT NUMERUS VALENS MEMORIA_VACUA(buf, 256).
    SCRIBE_OCTETUM_AB(buf, 80).
    SCRIBE_OCTETUM_AB(buf + 2, 67).
    SCRIBE_OCTETUM_AB(buf + 4, 73).
    SCRIBE_OCTETUM_AB(buf + 6, 80).
    SCRIBE_OCTETUM_AB(buf + 8, 61).
    DECLARA ig_h SICUT NUMERUS VALENS HEX16_SCRIBE(buf, 10, numerus).
    SCRIBE_OCTETUM_AB(buf + 18, 32).
    SCRIBE_OCTETUM_AB(buf + 20, 67).
    SCRIBE_OCTETUM_AB(buf + 22, 65).
    SCRIBE_OCTETUM_AB(buf + 24, 80).
    SCRIBE_OCTETUM_AB(buf + 26, 61).
    DECLARA ig_h0 SICUT NUMERUS VALENS HEX16_SCRIBE(buf, 28, CONTENTUM(descriptor + 8)).
    SCRIBE_OCTETUM_AB(buf + 36, 13).
    SCRIBE_OCTETUM_AB(buf + 38, 10).
    DECLARA ig_s SICUT NUMERUS VALENS SCRIBE_CATENAM(co, buf).

    // Quisque apparatus: bus:app.fn venditor:id classis/subclassis [PONS->sec]
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < numerus PERFICE
        DECLARA ig_v2 SICUT NUMERUS VALENS MEMORIA_VACUA(buf, 256).
        DECLARA sedes SICUT NUMERUS VALENS PCI_REGISTRUM_SEDES(descriptor, i).
        DECLARA p SICUT NUMERUS VALENS 0.
        p = p + HEX8_SCRIBE(buf, p, CONTENTUM(sedes)).
        SCRIBE_OCTETUM_AB(buf + p, 58).
        p = p + 2.
        p = p + HEX8_SCRIBE(buf, p, CONTENTUM(sedes + 8)).
        SCRIBE_OCTETUM_AB(buf + p, 46).
        p = p + 2.
        p = p + HEX8_SCRIBE(buf, p, CONTENTUM(sedes + 16)).
        SCRIBE_OCTETUM_AB(buf + p, 32).
        p = p + 2.
        p = p + HEX16_SCRIBE(buf, p, CONTENTUM(sedes + 24)).
        SCRIBE_OCTETUM_AB(buf + p, 58).
        p = p + 2.
        p = p + HEX16_SCRIBE(buf, p, CONTENTUM(sedes + 32)).
        SCRIBE_OCTETUM_AB(buf + p, 32).
        p = p + 2.
        p = p + HEX8_SCRIBE(buf, p, CONTENTUM(sedes + 40)).
        SCRIBE_OCTETUM_AB(buf + p, 47).
        p = p + 2.
        p = p + HEX8_SCRIBE(buf, p, CONTENTUM(sedes + 48)).
        // Profunditas vera in arbore
        SCRIBE_OCTETUM_AB(buf + p, 32).
        p = p + 2.
        SCRIBE_OCTETUM_AB(buf + p, 80).
        SCRIBE_OCTETUM_AB(buf + p + 2, 61).
        p = p + 4.
        p = p + HEX8_SCRIBE(buf, p, CONTENTUM(sedes + 80)).
        SI CONTENTUM(sedes + 64) > 0 TUNC
            SCRIBE_OCTETUM_AB(buf + p, 32).
            p = p + 2.
            SCRIBE_OCTETUM_AB(buf + p, 80).
            SCRIBE_OCTETUM_AB(buf + p + 2, 79).
            SCRIBE_OCTETUM_AB(buf + p + 4, 78).
            SCRIBE_OCTETUM_AB(buf + p + 6, 83).
            SCRIBE_OCTETUM_AB(buf + p + 8, 62).
            p = p + 10.
            p = p + HEX8_SCRIBE(buf, p, CONTENTUM(sedes + 56)).
            SCRIBE_OCTETUM_AB(buf + p, 47).
            p = p + 2.
            p = p + HEX8_SCRIBE(buf, p, CONTENTUM(sedes + 64)).
            SCRIBE_OCTETUM_AB(buf + p, 47).
            p = p + 2.
            p = p + HEX8_SCRIBE(buf, p, CONTENTUM(sedes + 72)).
        FIN-SI.
        SCRIBE_OCTETUM_AB(buf + p, 13).
        SCRIBE_OCTETUM_AB(buf + p + 2, 10).
        DECLARA ig_s2 SICUT NUMERUS VALENS SCRIBE_CATENAM(co, buf).
        i = i + 1.
    FIN-DUM.

    REDDE 0.
FIN-FUNCTIO.
