// TEMPORARIUM — praefixum exactum RV3D_CREA_EX cum custodiis ante codam.
IMPORTA "rectores/pci.vindex".
IMPORTA "rectores/mmio.vindex".
IMPORTA "rectores/paginae_dma.vindex".
IMPORTA "rectores/virtio_pci.vindex".
IMPORTA "rectores/virtio_gpu.vindex".
IMPORTA "rectores/virtio_gpu_2d.vindex".
IMPORTA "rectores/virtio_gpu_3d.vindex".
IMPORTA "rectores/virtio_gpu_3d_residentia.vindex".
IMPORTA "../bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "../bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "../bibliotheca/fenestrale_graphica_vii.vindex".
IMPORTA "../bibliotheca/imago_raster_vii.vindex".
IMPORTA "../bibliotheca/fenestrale_graphica_viii.vindex".
IMPORTA "../bibliotheca/fenestrale_graphica_x.vindex".
IMPORTA "../bibliotheca/fenestrale_residentia_virtio_3d_x.vindex".

FUNCTIO DX_PARA REDDENS NUMERUS.
    DECLARA mora SICUT NUMERUS VALENS 0.
    DECLARA status SICUT NUMERUS VALENS PORTUS_LEGE(1021).
    DUM (status & 32) == 0 && mora < 100000 PERFICE mora=mora+1. status=PORTUS_LEGE(1021). FIN-DUM.
    SI (status & 32) == 0 TUNC REDDE 0. FIN-SI. REDDE 1.
FIN-FUNCTIO.
FUNCTIO DX_CHAR REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS. SI DX_PARA()==0 TUNC REDDE 0. FIN-SI. PORTUS_SCRIBE(1016,c). REDDE 1.
FIN-FUNCTIO.
FUNCTIO DX_HEX REDDENS NUMERUS.
    ACCIPIT v SICUT NUMERUS.
    DECLARA hi SICUT NUMERUS VALENS (v>>4)&15. DECLARA lo SICUT NUMERUS VALENS v&15.
    SI hi<10 TUNC hi=hi+48. ALITER hi=hi+55. FIN-SI. SI lo<10 TUNC lo=lo+48. ALITER lo=lo+55. FIN-SI.
    DECLARA x SICUT NUMERUS VALENS DX_CHAR(hi). x=DX_CHAR(lo). REDDE x.
FIN-FUNCTIO.
FUNCTIO DX_NUNTIA REDDENS NUMERUS.
    ACCIPIT codex SICUT NUMERUS.
    DECLARA x SICUT NUMERUS VALENS DX_CHAR(86). x=DX_CHAR(73). x=DX_CHAR(79). x=DX_CHAR(69). x=DX_CHAR(32).
    x=DX_HEX(codex). x=DX_CHAR(13). x=DX_CHAR(10). REDDE codex.
FIN-FUNCTIO.

FUNCTIO DX_CREA_EX REDDENS NUMERUS.
    ACCIPIT systema SICUT NUMERUS.
    ACCIPIT bus SICUT NUMERUS.
    ACCIPIT apparatus SICUT NUMERUS.
    ACCIPIT functio SICUT NUMERUS.
    SI systema == 0 TUNC REDDE 0-1. FIN-SI.
    DECLARA gestor SICUT NUMERUS VALENS RESERVA_OCTETA(192).
    SI gestor == 0 TUNC REDDE 0-2. FIN-SI.
    DECLARA pura SICUT NUMERUS VALENS GX_MEM_PURA(gestor,192).
    CONTENTUM(gestor+32)=4096. CONTENTUM(gestor+120)=systema.
    CONTENTUM(gestor+128)=bus. CONTENTUM(gestor+136)=apparatus. CONTENTUM(gestor+144)=functio.
    DECLARA vp SICUT NUMERUS VALENS VP_CREA(bus,apparatus,functio).
    SI vp==0 TUNC CONTENTUM(gestor+56)=1. REDDE 0-3. FIN-SI.
    CONTENTUM(gestor)=vp. CONTENTUM(gestor+48)=1.
    SI VP_FACULTATES_LEGE(vp)==0 TUNC CONTENTUM(gestor+56)=2. DECLARA x0 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE 0-4. FIN-SI.
    DECLARA oblatae SICUT NUMERUS VALENS CONTENTUM(vp+112).
    SI (oblatae & VG3D_F_VIRGL())==0 TUNC CONTENTUM(gestor+56)=3. DECLARA x1 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE 0-5. FIN-SI.
    DECLARA acceptae SICUT NUMERUS VALENS VG3D_FACULTATES_ACCIPE(oblatae).
    CONTENTUM(gestor+152)=acceptae.
    SI VP_INITIALIZA(vp,acceptae,1)==0 TUNC CONTENTUM(gestor+56)=4. DECLARA x2 SICUT NUMERUS VALENS VP_RESTITUE(vp). REDDE 0-6. FIN-SI.

    // Custodiae ante VP_CODAM_CONFIGURA: 20..22 si status iam corruptus est.
    SI systema != CONTENTUM(gestor+120) TUNC REDDE 0-20. FIN-SI.
    SI CONTENTUM(vp+160) != 1 TUNC REDDE 0-21. FIN-SI.
    SI CONTENTUM(vp+176) != 0 TUNC REDDE 0-22. FIN-SI.

    DECLARA coda SICUT NUMERUS VALENS VP_CODAM_CONFIGURA(vp,systema,0,8).
    SI coda==0 TUNC
        DECLARA internum SICUT NUMERUS VALENS CONTENTUM(vp+168).
        DECLARA x3 SICUT NUMERUS VALENS VP_RESTITUE(vp).
        REDDE 0-(32+internum).
    FIN-SI.
    CONTENTUM(gestor+8)=coda.
    REDDE gestor.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA systema SICUT NUMERUS VALENS CONTENTUM(16777224). SI systema==0 TUNC REDDE DX_NUNTIA(64). FIN-SI.
    DECLARA registrum SICUT NUMERUS VALENS RESERVA_OCTETA(24). SI registrum==0 || PCI_REGISTRUM_INITIA(registrum,8)!=0 TUNC REDDE DX_NUNTIA(65). FIN-SI.
    DECLARA numerus SICUT NUMERUS VALENS PCI_ENUMERA_PER_PONTES(registrum). DECLARA sedes_gpu SICUT NUMERUS VALENS 0. DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<numerus PERFICE
        DECLARA sedes SICUT NUMERUS VALENS PCI_REGISTRUM_SEDES(registrum,i).
        SI CONTENTUM(sedes+24)==6900 && CONTENTUM(sedes+32)==4176 TUNC sedes_gpu=sedes. FIN-SI. i=i+1.
    FIN-DUM.
    SI sedes_gpu==0 TUNC REDDE DX_NUNTIA(66). FIN-SI.
    DECLARA bus SICUT NUMERUS VALENS CONTENTUM(sedes_gpu). DECLARA app SICUT NUMERUS VALENS CONTENTUM(sedes_gpu+8). DECLARA fn SICUT NUMERUS VALENS CONTENTUM(sedes_gpu+16).
    DECLARA gestor SICUT NUMERUS VALENS DX_CREA_EX(systema,bus,app,fn).
    SI gestor<0 TUNC REDDE DX_NUNTIA(0-gestor). FIN-SI. SI gestor==0 TUNC REDDE DX_NUNTIA(63). FIN-SI.
    REDDE DX_NUNTIA(0).
FIN-FUNCTIO.
