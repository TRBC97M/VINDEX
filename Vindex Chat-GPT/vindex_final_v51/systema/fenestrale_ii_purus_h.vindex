// Sylvia OS — Fenestrale II Purus H.
// Clientium superficies et status in registro dynamico VINDEX servantur.

IMPORTA "bibliotheca/fenestrale_ii_purus.vindex".
IMPORTA "bibliotheca/fenestrale_ii_superficies.vindex".
IMPORTA "bibliotheca/programmata_clientis_e.vindex".
IMPORTA "bibliotheca/tabula_clientis_f.vindex".
IMPORTA "bibliotheca/fenestrale_eventa_g.vindex".
IMPORTA "bibliotheca/clientia_registrum_h.vindex".
IMPORTA "bibliotheca/clientes_eventa_h.vindex".
IMPORTA "bibliotheca/fenestrale_gestor_g.vindex".

// Status vectoris systematis:
// 0 activum; 1 status fenestrae PROGRAMMATA; 2 status fenestrae TABULA.
// 3..6 PROGRAMMATA x/y/w/h; 7..10 TABULA x/y/w/h.
// 11/12 murus; 13 bullae; 14 tractio; 15/16 offset vel murus prior.
// 17 max PROGRAMMATA; 18..21 restitutio; 22 max TABULA; 23..26 restitutio.
// 27 margines; 28 murus relativus; 29 murus absolutus.
// 30..33 non iam clientium locis fixis reservantur.
// 34 coda eventuum; 35 eventa perdita; 36 registrum dynamicum clientium.

FUNCTIO FH_PROGRAMMATA REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS. ACCIPIT activa SICUT NUMERUS.
    DECLARA superficies SICUT NUMERUS VALENS CH_SUPERFICIES(s[36],1).
    SI superficies == 0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS FV_FENESTRA(s[3],s[4],s[5],s[6],"PROGRAMMATA",activa).
    DECLARA maxw SICUT NUMERUS VALENS s[5]-20. DECLARA maxh SICUT NUMERUS VALENS s[6]-74.
    SI maxw>0 && maxh>0 TUNC f=FS_BLIT(superficies,s[3]+10,s[4]+52,maxw,maxh). FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FH_TABULA REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS. ACCIPIT activa SICUT NUMERUS.
    DECLARA superficies SICUT NUMERUS VALENS CH_SUPERFICIES(s[36],2).
    SI superficies == 0 TUNC REDDE 0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS FV_FENESTRA(s[7],s[8],s[9],s[10],"TABULA",activa).
    DECLARA maxw SICUT NUMERUS VALENS s[9]-20. DECLARA maxh SICUT NUMERUS VALENS s[10]-74.
    SI maxw>0 && maxh>0 TUNC f=FS_BLIT(superficies,s[7]+10,s[8]+52,maxw,maxh). FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO FH_REDDE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    DECLARA f SICUT NUMERUS VALENS FV_FUNDUM().
    DECLARA a SICUT NUMERUS VALENS FB_RELEGE_ACTIVUM(s).
    SI s[0]==1 TUNC
        SI s[2]==0 TUNC f=FH_TABULA(s,0). FIN-SI.
        SI s[1]==0 TUNC f=FH_PROGRAMMATA(s,1). FIN-SI.
    ALITER
        SI s[1]==0 TUNC f=FH_PROGRAMMATA(s,0). FIN-SI.
        SI s[2]==0 TUNC f=FH_TABULA(s,1). FIN-SI.
    FIN-SI.
    f=FV_TASKBAR(s[1],s[2],s[0]).
    f=FV_CURSOR(s[11],s[12]).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI FV_AD_EST()==0 TUNC REDDE 5. FIN-SI.
    DECLARA s SICUT ORDO DE NUMERUS CAPACITAS 48.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(50333728).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(50333736).
    s[0]=1. s[1]=0. s[2]=0.
    s[5]=w*58/100. s[6]=(h-28)*66/100. s[9]=w*42/100. s[10]=(h-28)*52/100.
    SI s[5]<640 TUNC s[5]=640. FIN-SI. SI s[6]<420 TUNC s[6]=420. FIN-SI.
    SI s[9]<500 TUNC s[9]=500. FIN-SI. SI s[10]<360 TUNC s[10]=360. FIN-SI.
    SI s[5]>w TUNC s[5]=w. FIN-SI. SI s[6]>h-28 TUNC s[6]=h-28. FIN-SI.
    SI s[9]>w TUNC s[9]=w. FIN-SI. SI s[10]>h-28 TUNC s[10]=h-28. FIN-SI.
    s[3]=w*6/100. s[4]=h*7/100. s[7]=w-s[9]-w*5/100. s[8]=h*21/100.
    SI s[3]+s[5]>w TUNC s[3]=w-s[5]. FIN-SI. SI s[4]+s[6]>h-28 TUNC s[4]=h-28-s[6]. FIN-SI.
    SI s[7]<0 TUNC s[7]=0. FIN-SI. SI s[8]+s[10]>h-28 TUNC s[8]=h-28-s[10]. FIN-SI.
    s[11]=w/2. s[12]=h/2. s[13]=0. s[14]=0. s[17]=0. s[22]=0. s[27]=0. s[35]=0.
    s[34]=EG_CREA(32). SI s[34]==0 TUNC REDDE 71. FIN-SI.
    s[36]=CH_CREA(). SI s[36]==0 TUNC REDDE 71. FIN-SI.
    DECLARA superficies_p SICUT NUMERUS VALENS FS_CREA(496,260).
    DECLARA superficies_t SICUT NUMERUS VALENS FS_CREA(396,226).
    SI superficies_p==0 || superficies_t==0 TUNC REDDE 71. FIN-SI.
    DECLARA np SICUT NUMERUS VALENS CH_ADDE(s[36],1,1,superficies_p,0).
    DECLARA nt SICUT NUMERUS VALENS CH_ADDE(s[36],2,2,superficies_t,0).
    SI np==0 || nt==0 || CH_NUMERUS(s[36])!=2 TUNC REDDE 71. FIN-SI.
    DECLARA rp SICUT NUMERUS VALENS PE_RENDE(superficies_p,0).
    DECLARA rt SICUT NUMERUS VALENS TF_RENDE(superficies_t,0).
    DECLARA pp SICUT NUMERUS VALENS FB_PROTOCOLA_PARA(s).
    DECLARA f SICUT NUMERUS VALENS FH_REDDE(s).
    DECLARA finis SICUT NUMERUS VALENS 0.
    DUM finis==0 PERFICE
        DECLARA redde SICUT NUMERUS VALENS 0.
        DECLARA q SICUT NUMERUS VALENS FB_CLAVIS_LEGE().
        SI q!=0 TUNC
            DECLARA qa SICUT NUMERUS VALENS FB_CLAVIS_AGE(s,q).
            SI qa==2 TUNC finis=1. ALITER SI qa==1 TUNC redde=1. FIN-SI. FIN-SI.
        FIN-SI.
        DECLARA muris SICUT NUMERUS VALENS FB_MURUS_ABSOLUTUS(s[29],s).
        SI muris==0 TUNC muris=FB_MURUS_RELATIVUS(s[28],s). FIN-SI.
        SI muris!=0 TUNC
            DECLARA bullae SICUT NUMERUS VALENS muris-1.
            SI (bullae&1)!=0 && (s[13]&1)==0 TUNC DECLARA md SICUT NUMERUS VALENS FG_MOUSE_DOWN(s,s[34]). FIN-SI.
            SI (bullae&1)!=0 && s[14]!=0 TUNC DECLARA dr SICUT NUMERUS VALENS FB_DRAG(s). FIN-SI.
            SI (bullae&1)==0 && (s[13]&1)!=0 TUNC s[14]=0. s[27]=0. FIN-SI.
            s[13]=bullae. redde=1.
        FIN-SI.
        DECLARA acta SICUT NUMERUS VALENS CH_EVENTA_AGE(s,s[36],s[34]).
        SI acta>0 TUNC redde=1. FIN-SI.
        SI redde==1 TUNC f=FH_REDDE(s). FIN-SI.
        DECLARA pausa SICUT NUMERUS VALENS FB_STALL().
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.
