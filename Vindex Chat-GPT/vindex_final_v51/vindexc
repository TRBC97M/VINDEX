#!/usr/bin/env bash
# Interfacies publica compilatoris VINDEX.
#
# Formae acceptae:
#   ./vindexc fons.vindex exsecutabile
#   ./vindexc fons.vindex -o exsecutabile
#   ./vindexc --verifica fons.vindex

set -u

RADIX="$(cd "$(dirname "$0")" && pwd)"
COMPILATOR="$RADIX/compilator_vindex"
VERIFICATOR="$RADIX/instrumenta/vindex_verifica.py"
PRAEPARATOR="$RADIX/instrumenta/vindex_praepara.py"
TUTELA="$RADIX/instrumenta/vindex_tutela_052.py"

usus() {
    printf '%s\n' \
        "USUS:" \
        "  $0 <fons.vindex> <exsecutabile>" \
        "  $0 <fons.vindex> -o <exsecutabile>" \
        "  $0 --verifica <fons.vindex>"
}

verifica() {
    local fons="$1"
    if command -v python3 >/dev/null 2>&1 && [ -f "$VERIFICATOR" ]; then
        python3 "$VERIFICATOR" "$fons"
        return $?
    fi
    printf '%s\n' "VINDEX: Python 3 abest; verificatio provecta omittitur." >&2
    return 0
}

praepara() {
    local fons="$1"
    local exitus="$2"
    if command -v python3 >/dev/null 2>&1 && [ -f "$PRAEPARATOR" ]; then
        python3 "$PRAEPARATOR" "$fons" "$exitus"
        return $?
    fi
    cp -- "$fons" "$exitus"
}

tutela() {
    local fons="$1"
    if command -v python3 >/dev/null 2>&1 && [ -f "$TUTELA" ]; then
        python3 "$TUTELA" "$fons"
        return $?
    fi
    return 0
}

if [ "$#" -eq 0 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usus
    if [ "$#" -eq 0 ]; then exit 64; else exit 0; fi
fi

if [ "${1:-}" = "--verifica" ]; then
    if [ "$#" -ne 2 ]; then
        usus >&2
        exit 64
    fi
    TEMP_VERIFICA="$(mktemp "${TMPDIR:-/tmp}/vindex-verifica.XXXXXX")" || exit 73
    trap 'rm -f -- "$TEMP_VERIFICA"' EXIT HUP INT TERM
    praepara "$2" "$TEMP_VERIFICA" || exit $?
    tutela "$TEMP_VERIFICA" || exit $?
    verifica "$TEMP_VERIFICA"
    STATUS=$?
    rm -f -- "$TEMP_VERIFICA"
    trap - EXIT HUP INT TERM
    exit "$STATUS"
fi

if [ "$#" -eq 2 ]; then
    FONS="$1"
    EXITUS="$2"
elif [ "$#" -eq 3 ] && [ "$2" = "-o" ]; then
    FONS="$1"
    EXITUS="$3"
else
    usus >&2
    exit 64
fi

if [ ! -f "$FONS" ]; then
    printf 'VINDEX: fons non inventus: %s\n' "$FONS" >&2
    exit 66
fi
if [ ! -r "$FONS" ]; then
    printf 'VINDEX: fons legi non potest: %s\n' "$FONS" >&2
    exit 66
fi
if [ ! -x "$COMPILATOR" ]; then
    printf 'VINDEX: compilator abest aut exsequi non potest: %s\n' "$COMPILATOR" >&2
    exit 69
fi
if [ "$FONS" = "$EXITUS" ]; then
    printf '%s\n' "VINDEX: fons et exitus diversi esse debent." >&2
    exit 64
fi

EXITUS_PARENT="$(dirname "$EXITUS")"
if [ ! -d "$EXITUS_PARENT" ]; then
    printf 'VINDEX: directorium exitus non inventum: %s\n' "$EXITUS_PARENT" >&2
    exit 73
fi

TEMP_FONS="$(mktemp "${TMPDIR:-/tmp}/vindex-fons.XXXXXX")" || exit 73
TEMPORARIUM="$(mktemp "$EXITUS_PARENT/.vindex-exitus.XXXXXX")" || {
    rm -f -- "$TEMP_FONS"
    exit 73
}
purga() {
    if [ -n "${TEMP_FONS:-}" ] && [ -e "$TEMP_FONS" ]; then
        rm -f -- "$TEMP_FONS"
    fi
    if [ -n "${TEMPORARIUM:-}" ] && [ -e "$TEMPORARIUM" ]; then
        rm -f -- "$TEMPORARIUM"
    fi
}
trap purga EXIT HUP INT TERM

praepara "$FONS" "$TEMP_FONS" || exit $?
tutela "$TEMP_FONS" || exit $?
verifica "$TEMP_FONS" || exit $?

"$COMPILATOR" "$TEMP_FONS" "$TEMPORARIUM"
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
    printf 'VINDEX: compilatio defecit (status %s).\n' "$STATUS" >&2
    exit "$STATUS"
fi

MAGIA="$(od -An -tx1 -N4 "$TEMPORARIUM" 2>/dev/null | tr -d ' \n')"
if [ "$MAGIA" != "7f454c46" ]; then
    printf '%s\n' "VINDEX: compilator ELF validum non genuit." >&2
    exit 70
fi

chmod 755 "$TEMPORARIUM" || exit 73
mv -f -- "$TEMPORARIUM" "$EXITUS" || exit 73
TEMPORARIUM=""
rm -f -- "$TEMP_FONS"
TEMP_FONS=""
trap - EXIT HUP INT TERM

printf 'Compilatum: %s\n' "$EXITUS"
