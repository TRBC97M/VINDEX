// VINDEX 0.52 — probatio comparationis TEXTUS secundum contentum.
// Sedes memoriae diversae eundem contentum aequalem habere debent.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA primus SICUT TEXTUS VALENS "Sylvia".
    DECLARA secundus SICUT TEXTUS VALENS "Syl" + "via".
    DECLARA tertius SICUT TEXTUS VALENS "Sylvie".

    SI primus != secundus TUNC
        REDDE 1.
    FIN-SI.
    SI primus == tertius TUNC
        REDDE 2.
    FIN-SI.
    SI "Sylvia" != primus TUNC
        REDDE 3.
    FIN-SI.

    PROCLAMA "RECTE".
    REDDE 0.
FIN-FUNCTIO.
