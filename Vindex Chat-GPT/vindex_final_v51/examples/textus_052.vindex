// VINDEX 0.52 — programma probationis TEXTUS
// Hoc fasciculum contractum primae implementationis definit.
// Debet compilari atque exsequi antequam TEXTUS perfectum habetur.

FUNCTIO SALUTA REDDENS VACUUM.
    ACCIPIT nomen SICUT TEXTUS.
    DECLARA nuntius SICUT TEXTUS VALENS "Salve, " + nomen + ".".
    PROCLAMA nuntius.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA nomen SICUT TEXTUS VALENS "Sylvia".
    DECLARA systema SICUT TEXTUS VALENS nomen + " OS".

    PROCLAMA systema.
    PROCLAMA LONGITUDO(systema).

    SI nomen == "Sylvia" TUNC
        SALUTA(nomen).
    FIN-SI.

    REDDE 0.
FIN-FUNCTIO.
