// VINDEX 0.52 — probatio assignationis inter variabilia TEXTUS.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA primus SICUT TEXTUS VALENS "Sylvia".
    DECLARA secundus SICUT TEXTUS VALENS "VINDEX".
    secundus = primus.
    SI secundus != "Sylvia" TUNC
        REDDE 1.
    FIN-SI.
    PROCLAMA secundus.
    REDDE 0.
FIN-FUNCTIO.
