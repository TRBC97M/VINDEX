// LABORATORIUM SYLVIAE — probatio ABI TEXTUS sine UEFI.

FUNCTIO PT_LONGITUDO REDDENS NUMERUS.
    ACCIPIT t SICUT TEXTUS.
    REDDE CONTENTUM(t).
FIN-FUNCTIO.

FUNCTIO PT_PRIMA REDDENS NUMERUS.
    ACCIPIT t SICUT TEXTUS.
    REDDE OCTETUS_AB(t+16).
FIN-FUNCTIO.

FUNCTIO PT_SECUNDA REDDENS NUMERUS.
    ACCIPIT t SICUT TEXTUS.
    REDDE OCTETUS_AB(t+17).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA t SICUT TEXTUS VALENS "ABC".
    SI CONTENTUM(t)!=3 TUNC REDDE 11. FIN-SI.
    SI OCTETUS_AB(t+16)!=65 TUNC REDDE 12. FIN-SI.
    SI OCTETUS_AB(t+17)!=66 TUNC REDDE 13. FIN-SI.
    SI PT_LONGITUDO(t)!=3 TUNC REDDE 14. FIN-SI.
    SI PT_PRIMA(t)!=65 TUNC REDDE 15. FIN-SI.
    SI PT_SECUNDA(t)!=66 TUNC REDDE 16. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
