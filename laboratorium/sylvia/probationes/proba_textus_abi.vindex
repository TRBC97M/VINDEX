// LABORATORIUM SYLVIAE — probatio ABI TEXTUS sine UEFI.

IMPORTA "Vindex Chat-GPT/vindex_final_v51/bibliotheca/textus.vindex".

FUNCTIO PT_PRIMA REDDENS NUMERUS.
    ACCIPIT t SICUT TEXTUS.
    REDDE OCTETUS_AB(t+16).
FIN-FUNCTIO.

FUNCTIO PT_SECUNDA REDDENS NUMERUS.
    ACCIPIT t SICUT TEXTUS.
    REDDE OCTETUS_AB(t+17).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI LONGITUDO("ABC")!=3 TUNC REDDE 11. FIN-SI.
    SI PT_PRIMA("ABC")!=65 TUNC REDDE 12. FIN-SI.
    SI PT_SECUNDA("ABC")!=66 TUNC REDDE 13. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
