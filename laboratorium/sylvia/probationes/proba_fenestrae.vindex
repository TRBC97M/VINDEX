// LABORATORIUM SYLVIAE — probatio registri dynamici fenestrarum.
IMPORTA "laboratorium/sylvia/bibliotheca/fenestrae.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA r SICUT NUMERUS VALENS LF_CREA().
    SI r==0 TUNC REDDE 71. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<128 PERFICE
        DECLARA id SICUT NUMERUS VALENS LF_ADDE(r,1+(i%3),10+i,10+i,320,220).
        SI id==0 TUNC REDDE 71. FIN-SI.
        i=i+1.
    FIN-DUM.
    SI LF_NUMERUS(r)!=128 TUNC REDDE 65. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS LF_FOCUS(r,17).
    SI LF_FOCUS_ID(r)!=17 TUNC REDDE 65. FIN-SI.
    DECLARA m SICUT NUMERUS VALENS LF_MINIMIZA(r,17).
    SI LF_FOCUS_ID(r)==17 TUNC REDDE 65. FIN-SI.
    DECLARA rr SICUT NUMERUS VALENS LF_RESTITUE(r,17).
    SI LF_FOCUS_ID(r)!=17 TUNC REDDE 65. FIN-SI.
    DECLARA z SICUT NUMERUS VALENS LF_MAX_TOGGLE(r,17).
    z=LF_MAX_TOGGLE(r,17).
    DECLARA c SICUT NUMERUS VALENS LF_CLAUDE(r,17).
    SI LF_HIT(r,27,27)==17 TUNC REDDE 65. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.
