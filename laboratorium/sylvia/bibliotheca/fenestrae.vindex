// LABORATORIUM SYLVIAE — registrum dynamicum fenestrarum VINDEX.
// Registrum: numerus, ima, summa, focus, id sequens.
// Nodus: id, genus, x, y, w, h, status, maximus, rx, ry, rw, rh, prior, proximus.
// Acervus experimentalis a bootstrap UEFI in metadata [16..19] traditur.

FUNCTIO LM_RESERVA REDDENS NUMERUS.
    ACCIPIT mensura SICUT NUMERUS.
    SI mensura<=0 TUNC REDDE 0. FIN-SI.
    DECLARA basis SICUT NUMERUS VALENS CONTENTUM(50333824).
    DECLARA amplitudo SICUT NUMERUS VALENS CONTENTUM(50333832).
    SI basis==0 || amplitudo<=0 TUNC REDDE 0. FIN-SI.
    DECLARA cursor SICUT NUMERUS VALENS CONTENTUM(50333840).
    DECLARA finis SICUT NUMERUS VALENS CONTENTUM(50333848).
    SI cursor==0 TUNC
        cursor=basis.
        finis=basis+amplitudo.
        CONTENTUM(50333840)=cursor.
        CONTENTUM(50333848)=finis.
    FIN-SI.
    DECLARA m SICUT NUMERUS VALENS ((mensura+7)/8)*8.
    SI cursor+m>finis TUNC REDDE 0. FIN-SI.
    DECLARA exitus SICUT NUMERUS VALENS cursor.
    CONTENTUM(50333840)=cursor+m.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<m PERFICE
        SCRIBE_OCTETUM_AB(exitus+i,0).
        i=i+1.
    FIN-DUM.
    REDDE exitus.
FIN-FUNCTIO.

FUNCTIO LF_CREA REDDENS NUMERUS.
    DECLARA r SICUT NUMERUS VALENS LM_RESERVA(40).
    SI r==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(r)=0. CONTENTUM(r+8)=0. CONTENTUM(r+16)=0. CONTENTUM(r+24)=0. CONTENTUM(r+32)=1.
    REDDE r.
FIN-FUNCTIO.

FUNCTIO LF_NUMERUS REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI r==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(r).
FIN-FUNCTIO.

FUNCTIO LF_PRIMUS REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI r==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(r+8).
FIN-FUNCTIO.

FUNCTIO LF_SUPREMUS REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI r==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(r+16).
FIN-FUNCTIO.

FUNCTIO LF_FOCUS_ID REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI r==0 TUNC REDDE 0. FIN-SI.
    REDDE CONTENTUM(r+24).
FIN-FUNCTIO.

FUNCTIO LF_QUAERE REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    SI r==0 || id<=0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(r+8).
    DUM n!=0 PERFICE
        SI CONTENTUM(n)==id TUNC REDDE n. FIN-SI.
        n=CONTENTUM(n+104).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO LF_ADDE REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT genus SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS. ACCIPIT w SICUT NUMERUS. ACCIPIT h SICUT NUMERUS.
    SI r==0 || genus<=0 || w<=0 || h<=0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS LM_RESERVA(112).
    SI n==0 TUNC REDDE 0. FIN-SI.
    DECLARA id SICUT NUMERUS VALENS CONTENTUM(r+32).
    DECLARA summa SICUT NUMERUS VALENS CONTENTUM(r+16).
    CONTENTUM(n)=id. CONTENTUM(n+8)=genus.
    CONTENTUM(n+16)=x. CONTENTUM(n+24)=y. CONTENTUM(n+32)=w. CONTENTUM(n+40)=h.
    CONTENTUM(n+48)=0. CONTENTUM(n+56)=0.
    CONTENTUM(n+64)=x. CONTENTUM(n+72)=y. CONTENTUM(n+80)=w. CONTENTUM(n+88)=h.
    CONTENTUM(n+96)=summa. CONTENTUM(n+104)=0.
    SI summa!=0 TUNC CONTENTUM(summa+104)=n. ALITER CONTENTUM(r+8)=n. FIN-SI.
    CONTENTUM(r+16)=n. CONTENTUM(r+24)=id. CONTENTUM(r+32)=id+1. CONTENTUM(r)=CONTENTUM(r)+1.
    REDDE id.
FIN-FUNCTIO.

FUNCTIO LF_RELEGE_FOCUS REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    SI r==0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(r+16).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)==0 TUNC CONTENTUM(r+24)=CONTENTUM(n). REDDE CONTENTUM(n). FIN-SI.
        n=CONTENTUM(n+96).
    FIN-DUM.
    CONTENTUM(r+24)=0.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO LF_FOCUS REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS LF_QUAERE(r,id).
    SI n==0 || CONTENTUM(n+48)==2 TUNC REDDE 0. FIN-SI.
    CONTENTUM(n+48)=0.
    DECLARA summa SICUT NUMERUS VALENS CONTENTUM(r+16).
    SI n!=summa TUNC
        DECLARA p SICUT NUMERUS VALENS CONTENTUM(n+96).
        DECLARA q SICUT NUMERUS VALENS CONTENTUM(n+104).
        SI p!=0 TUNC CONTENTUM(p+104)=q. ALITER CONTENTUM(r+8)=q. FIN-SI.
        SI q!=0 TUNC CONTENTUM(q+96)=p. FIN-SI.
        CONTENTUM(n+96)=summa. CONTENTUM(n+104)=0.
        SI summa!=0 TUNC CONTENTUM(summa+104)=n. ALITER CONTENTUM(r+8)=n. FIN-SI.
        CONTENTUM(r+16)=n.
    FIN-SI.
    CONTENTUM(r+24)=id.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LF_HIT REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS.
    SI r==0 TUNC REDDE 0. FIN-SI.
    DECLARA n SICUT NUMERUS VALENS CONTENTUM(r+16).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)==0 TUNC
            DECLARA nx SICUT NUMERUS VALENS CONTENTUM(n+16). DECLARA ny SICUT NUMERUS VALENS CONTENTUM(n+24).
            DECLARA nw SICUT NUMERUS VALENS CONTENTUM(n+32). DECLARA nh SICUT NUMERUS VALENS CONTENTUM(n+40).
            SI x>=nx && y>=ny && x<nx+nw && y<ny+nh TUNC REDDE CONTENTUM(n). FIN-SI.
        FIN-SI.
        n=CONTENTUM(n+96).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO LF_MINIMIZA REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS LF_QUAERE(r,id).
    SI n==0 || CONTENTUM(n+48)!=0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(n+48)=1.
    SI CONTENTUM(r+24)==id TUNC CONTENTUM(r+24)=0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS LF_RELEGE_FOCUS(r).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LF_RESTITUE REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS LF_QUAERE(r,id).
    SI n==0 || CONTENTUM(n+48)==2 TUNC REDDE 0. FIN-SI.
    CONTENTUM(n+48)=0.
    REDDE LF_FOCUS(r,id).
FIN-FUNCTIO.

FUNCTIO LF_CLAUDE REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS LF_QUAERE(r,id).
    SI n==0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(n+48)=2.
    SI CONTENTUM(r+24)==id TUNC CONTENTUM(r+24)=0. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS LF_RELEGE_FOCUS(r).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LF_MAX_TOGGLE REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT id SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS LF_QUAERE(r,id).
    SI n==0 || CONTENTUM(n+48)!=0 TUNC REDDE 0. FIN-SI.
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(50333728).
    DECLARA sh SICUT NUMERUS VALENS CONTENTUM(50333736)-28.
    SI CONTENTUM(n+56)==0 TUNC
        CONTENTUM(n+64)=CONTENTUM(n+16). CONTENTUM(n+72)=CONTENTUM(n+24).
        CONTENTUM(n+80)=CONTENTUM(n+32). CONTENTUM(n+88)=CONTENTUM(n+40).
        CONTENTUM(n+16)=0. CONTENTUM(n+24)=0. CONTENTUM(n+32)=sw. CONTENTUM(n+40)=sh. CONTENTUM(n+56)=1.
    ALITER
        CONTENTUM(n+16)=CONTENTUM(n+64). CONTENTUM(n+24)=CONTENTUM(n+72).
        CONTENTUM(n+32)=CONTENTUM(n+80). CONTENTUM(n+40)=CONTENTUM(n+88). CONTENTUM(n+56)=0.
    FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LF_MOVE REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT id SICUT NUMERUS. ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS LF_QUAERE(r,id).
    SI n==0 || CONTENTUM(n+48)!=0 || CONTENTUM(n+56)!=0 TUNC REDDE 0. FIN-SI.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(n+32). DECLARA h SICUT NUMERUS VALENS CONTENTUM(n+40).
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(50333728). DECLARA sh SICUT NUMERUS VALENS CONTENTUM(50333736)-28.
    SI x<0 TUNC x=0. FIN-SI. SI y<0 TUNC y=0. FIN-SI.
    SI x+w>sw TUNC x=sw-w. FIN-SI. SI y+h>sh TUNC y=sh-h. FIN-SI.
    CONTENTUM(n+16)=x. CONTENTUM(n+24)=y.
    REDDE 1.
FIN-FUNCTIO.
