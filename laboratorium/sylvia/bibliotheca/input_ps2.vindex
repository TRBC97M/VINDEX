FUNCTIO LP_STUBS_PARA REDDENS NUMERUS.
    SCRIBE_OCTETUM_AB(50432000,137).
    SCRIBE_OCTETUM_AB(50432001,202).
    SCRIBE_OCTETUM_AB(50432002,49).
    SCRIBE_OCTETUM_AB(50432003,192).
    SCRIBE_OCTETUM_AB(50432004,236).
    SCRIBE_OCTETUM_AB(50432005,195).
    SCRIBE_OCTETUM_AB(50432016,137).
    SCRIBE_OCTETUM_AB(50432017,208).
    SCRIBE_OCTETUM_AB(50432018,137).
    SCRIBE_OCTETUM_AB(50432019,202).
    SCRIBE_OCTETUM_AB(50432020,238).
    SCRIBE_OCTETUM_AB(50432021,49).
    SCRIBE_OCTETUM_AB(50432022,192).
    SCRIBE_OCTETUM_AB(50432023,195).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LP_IN REDDENS NUMERUS.
    ACCIPIT portus SICUT NUMERUS.
    REDDE UEFI_VOCA6(50432000,portus,0,0,0,0,0).
FIN-FUNCTIO.

FUNCTIO LP_OUT REDDENS NUMERUS.
    ACCIPIT portus SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    REDDE UEFI_VOCA6(50432016,portus,valor,0,0,0,0).
FIN-FUNCTIO.

FUNCTIO LP_ATTENDE_SCRIBE REDDENS NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<10000 PERFICE
        DECLARA s SICUT NUMERUS VALENS LP_IN(100).
        SI (s&2)==0 TUNC REDDE 1. FIN-SI.
        i=i+1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO LP_LEGE_DATA REDDENS NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<10000 PERFICE
        DECLARA s SICUT NUMERUS VALENS LP_IN(100).
        SI (s&1)!=0 TUNC REDDE LP_IN(96). FIN-SI.
        i=i+1.
    FIN-DUM.
    REDDE 256.
FIN-FUNCTIO.

FUNCTIO LP_LEGE_AUX REDDENS NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<20000 PERFICE
        DECLARA s SICUT NUMERUS VALENS LP_IN(100).
        SI (s&1)!=0 TUNC
            DECLARA d SICUT NUMERUS VALENS LP_IN(96).
            SI (s&32)!=0 TUNC REDDE d. FIN-SI.
        FIN-SI.
        i=i+1.
    FIN-DUM.
    REDDE 256.
FIN-FUNCTIO.

FUNCTIO LP_CMD REDDENS NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SI LP_ATTENDE_SCRIBE()==0 TUNC REDDE 0. FIN-SI.
    DECLARA r SICUT NUMERUS VALENS LP_OUT(100,valor).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LP_DATA REDDENS NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SI LP_ATTENDE_SCRIBE()==0 TUNC REDDE 0. FIN-SI.
    DECLARA r SICUT NUMERUS VALENS LP_OUT(96,valor).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LP_AUX_CMD REDDENS NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    SI LP_CMD(212)==0 TUNC REDDE 256. FIN-SI.
    SI LP_DATA(valor)==0 TUNC REDDE 256. FIN-SI.
    REDDE LP_LEGE_AUX().
FIN-FUNCTIO.

FUNCTIO LP_FLUSH REDDENS NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<64 PERFICE
        DECLARA s SICUT NUMERUS VALENS LP_IN(100).
        SI (s&1)==0 TUNC REDDE 1. FIN-SI.
        DECLARA d SICUT NUMERUS VALENS LP_IN(96).
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LP_8042_PARA REDDENS NUMERUS.
    SCRIBE_OCTETUM_AB(50432064,1).
    DECLARA f SICUT NUMERUS VALENS LP_FLUSH().
    SI LP_CMD(168)==0 TUNC SCRIBE_OCTETUM_AB(50432064,2). REDDE 0. FIN-SI.
    SI LP_CMD(32)==0 TUNC SCRIBE_OCTETUM_AB(50432064,3). REDDE 0. FIN-SI.
    DECLARA cfg SICUT NUMERUS VALENS LP_LEGE_DATA().
    SI cfg>255 TUNC SCRIBE_OCTETUM_AB(50432064,4). REDDE 0. FIN-SI.
    cfg=cfg&221.
    SI LP_CMD(96)==0 TUNC SCRIBE_OCTETUM_AB(50432064,5). REDDE 0. FIN-SI.
    SI LP_DATA(cfg)==0 TUNC SCRIBE_OCTETUM_AB(50432064,6). REDDE 0. FIN-SI.
    DECLARA a1 SICUT NUMERUS VALENS LP_AUX_CMD(246).
    SCRIBE_OCTETUM_AB(50432065,a1&255).
    SI a1!=250 TUNC SCRIBE_OCTETUM_AB(50432064,7). REDDE 0. FIN-SI.
    DECLARA a2 SICUT NUMERUS VALENS LP_AUX_CMD(244).
    SCRIBE_OCTETUM_AB(50432066,a2&255).
    SI a2!=250 TUNC SCRIBE_OCTETUM_AB(50432064,8). REDDE 0. FIN-SI.
    SCRIBE_OCTETUM_AB(50432064,9).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LP_PARA REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    DECLARA z SICUT NUMERUS VALENS LP_STUBS_PARA().
    s[10]=0. s[11]=0. s[12]=0. s[13]=0.
    SCRIBE_OCTETUM_AB(50432067,0).
    SCRIBE_OCTETUM_AB(50432068,0).
    REDDE LP_8042_PARA().
FIN-FUNCTIO.

FUNCTIO LP_LEGE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    DECLARA status SICUT NUMERUS VALENS LP_IN(100).
    SCRIBE_OCTETUM_AB(50432068,status&255).
    SI (status&1)==0 TUNC REDDE 0. FIN-SI.
    DECLARA b SICUT NUMERUS VALENS LP_IN(96).
    SI (status&32)==0 TUNC REDDE 0. FIN-SI.
    SI s[10]==0 TUNC
        SI (b&8)==0 TUNC REDDE 0. FIN-SI.
        s[11]=b. s[10]=1. REDDE 0.
    FIN-SI.
    SI s[10]==1 TUNC s[12]=b. s[10]=2. REDDE 0. FIN-SI.
    s[13]=b. s[10]=0.
    DECLARA flags SICUT NUMERUS VALENS s[11].
    SI (flags&192)!=0 TUNC REDDE 0. FIN-SI.
    DECLARA dx SICUT NUMERUS VALENS s[12].
    DECLARA dy SICUT NUMERUS VALENS s[13].
    SI (flags&16)!=0 TUNC dx=dx-256. FIN-SI.
    SI (flags&32)!=0 TUNC dy=dy-256. FIN-SI.
    s[0]=s[0]+dx.
    s[1]=s[1]-dy.
    SI s[0]<0 TUNC s[0]=0. FIN-SI.
    SI s[1]<0 TUNC s[1]=0. FIN-SI.
    SI s[0]>=CONTENTUM(50333728) TUNC s[0]=CONTENTUM(50333728)-1. FIN-SI.
    SI s[1]>=CONTENTUM(50333736)-28 TUNC s[1]=CONTENTUM(50333736)-29. FIN-SI.
    s[2]=flags&7.
    SCRIBE_OCTETUM_AB(50432067,(OCTETUS_AB(50432067)+1)&255).
    REDDE 1.
FIN-FUNCTIO.