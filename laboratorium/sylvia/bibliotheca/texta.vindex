// LABORATORIUM SYLVIAE — texta humilia sine ABI TEXTUS.
// Hic tractus VINDEX purus glyphos formae 8x8 ex codicibus ASCII numeris pingit.

FUNCTIO LT_GLYPH REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS.
    ACCIPIT littera SICUT NUMERUS. ACCIPIT color SICUT NUMERUS.
    DECLARA forma SICUT NUMERUS VALENS CONTENTUM(50333784).
    SI forma==0 || littera<0 || littera>255 TUNC REDDE 0. FIN-SI.
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py<8 PERFICE
        DECLARA bits SICUT NUMERUS VALENS OCTETUS_AB(forma+littera*8+py).
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px<8 PERFICE
            SI (bits&(128>>px))!=0 TUNC
                DECLARA q SICUT NUMERUS VALENS LG_PIXEL(x+px,y+py,color).
            FIN-SI.
            px=px+1.
        FIN-DUM.
        py=py+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LT_MENSURA REDDENS NUMERUS.
    ACCIPIT id SICUT NUMERUS.
    SI id==1 TUNC REDDE 11. FIN-SI.
    SI id==2 TUNC REDDE 6. FIN-SI.
    SI id==3 TUNC REDDE 12. FIN-SI.
    SI id==4 TUNC REDDE 5. FIN-SI.
    SI id==5 TUNC REDDE 5. FIN-SI.
    SI id==6 TUNC REDDE 5. FIN-SI.
    SI id==7 TUNC REDDE 7. FIN-SI.
    SI id==8 TUNC REDDE 12. FIN-SI.
    SI id==9 TUNC REDDE 10. FIN-SI.
    SI id==10 TUNC REDDE 5. FIN-SI.
    SI id==11 TUNC REDDE 19. FIN-SI.
    SI id==12 TUNC REDDE 27. FIN-SI.
    SI id==13 TUNC REDDE 19. FIN-SI.
    SI id==14 TUNC REDDE 22. FIN-SI.
    SI id==15 TUNC REDDE 11. FIN-SI.
    SI id==16 TUNC REDDE 7. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO LT_LITTERA REDDENS NUMERUS.
    ACCIPIT id SICUT NUMERUS. ACCIPIT i SICUT NUMERUS.
    // PROGRAMMATA
    SI id==1 TUNC
        SI i==0 TUNC REDDE 80. FIN-SI. SI i==1 TUNC REDDE 82. FIN-SI. SI i==2 TUNC REDDE 79. FIN-SI.
        SI i==3 TUNC REDDE 71. FIN-SI. SI i==4 TUNC REDDE 82. FIN-SI. SI i==5 TUNC REDDE 65. FIN-SI.
        SI i==6 TUNC REDDE 77. FIN-SI. SI i==7 TUNC REDDE 77. FIN-SI. SI i==8 TUNC REDDE 65. FIN-SI.
        SI i==9 TUNC REDDE 84. FIN-SI. SI i==10 TUNC REDDE 65. FIN-SI.
    FIN-SI.
    // TABULA
    SI id==2 TUNC
        SI i==0 TUNC REDDE 84. FIN-SI. SI i==1 TUNC REDDE 65. FIN-SI. SI i==2 TUNC REDDE 66. FIN-SI.
        SI i==3 TUNC REDDE 85. FIN-SI. SI i==4 TUNC REDDE 76. FIN-SI. SI i==5 TUNC REDDE 65. FIN-SI.
    FIN-SI.
    // LABORATORIUM
    SI id==3 TUNC
        SI i==0 TUNC REDDE 76. FIN-SI. SI i==1 TUNC REDDE 65. FIN-SI. SI i==2 TUNC REDDE 66. FIN-SI.
        SI i==3 TUNC REDDE 79. FIN-SI. SI i==4 TUNC REDDE 82. FIN-SI. SI i==5 TUNC REDDE 65. FIN-SI.
        SI i==6 TUNC REDDE 84. FIN-SI. SI i==7 TUNC REDDE 79. FIN-SI. SI i==8 TUNC REDDE 82. FIN-SI.
        SI i==9 TUNC REDDE 73. FIN-SI. SI i==10 TUNC REDDE 85. FIN-SI. SI i==11 TUNC REDDE 77. FIN-SI.
    FIN-SI.
    // NOVUM
    SI id==4 TUNC
        SI i==0 TUNC REDDE 78. FIN-SI. SI i==1 TUNC REDDE 79. FIN-SI. SI i==2 TUNC REDDE 86. FIN-SI.
        SI i==3 TUNC REDDE 85. FIN-SI. SI i==4 TUNC REDDE 77. FIN-SI.
    FIN-SI.
    // EDITE
    SI id==5 TUNC
        SI i==0 TUNC REDDE 69. FIN-SI. SI i==1 TUNC REDDE 68. FIN-SI. SI i==2 TUNC REDDE 73. FIN-SI.
        SI i==3 TUNC REDDE 84. FIN-SI. SI i==4 TUNC REDDE 69. FIN-SI.
    FIN-SI.
    // NOMEN
    SI id==6 TUNC
        SI i==0 TUNC REDDE 78. FIN-SI. SI i==1 TUNC REDDE 79. FIN-SI. SI i==2 TUNC REDDE 77. FIN-SI.
        SI i==3 TUNC REDDE 69. FIN-SI. SI i==4 TUNC REDDE 78. FIN-SI.
    FIN-SI.
    // LOCORUM
    SI id==7 TUNC
        SI i==0 TUNC REDDE 76. FIN-SI. SI i==1 TUNC REDDE 79. FIN-SI. SI i==2 TUNC REDDE 67. FIN-SI.
        SI i==3 TUNC REDDE 79. FIN-SI. SI i==4 TUNC REDDE 82. FIN-SI. SI i==5 TUNC REDDE 85. FIN-SI.
        SI i==6 TUNC REDDE 77. FIN-SI.
    FIN-SI.
    // TABULA.VXNAT
    SI id==8 TUNC
        SI i==0 TUNC REDDE 84. FIN-SI. SI i==1 TUNC REDDE 65. FIN-SI. SI i==2 TUNC REDDE 66. FIN-SI.
        SI i==3 TUNC REDDE 85. FIN-SI. SI i==4 TUNC REDDE 76. FIN-SI. SI i==5 TUNC REDDE 65. FIN-SI.
        SI i==6 TUNC REDDE 46. FIN-SI. SI i==7 TUNC REDDE 86. FIN-SI. SI i==8 TUNC REDDE 88. FIN-SI.
        SI i==9 TUNC REDDE 78. FIN-SI. SI i==10 TUNC REDDE 65. FIN-SI. SI i==11 TUNC REDDE 84. FIN-SI.
    FIN-SI.
    // APPLICATIO
    SI id==9 TUNC
        SI i==0 TUNC REDDE 65. FIN-SI. SI i==1 TUNC REDDE 80. FIN-SI. SI i==2 TUNC REDDE 80. FIN-SI.
        SI i==3 TUNC REDDE 76. FIN-SI. SI i==4 TUNC REDDE 73. FIN-SI. SI i==5 TUNC REDDE 67. FIN-SI.
        SI i==6 TUNC REDDE 65. FIN-SI. SI i==7 TUNC REDDE 84. FIN-SI. SI i==8 TUNC REDDE 73. FIN-SI.
        SI i==9 TUNC REDDE 79. FIN-SI.
    FIN-SI.
    // SERVA
    SI id==10 TUNC
        SI i==0 TUNC REDDE 83. FIN-SI. SI i==1 TUNC REDDE 69. FIN-SI. SI i==2 TUNC REDDE 82. FIN-SI.
        SI i==3 TUNC REDDE 86. FIN-SI. SI i==4 TUNC REDDE 65. FIN-SI.
    FIN-SI.
    // SYLVIA LABORATORIUM
    SI id==11 TUNC
        SI i==0 TUNC REDDE 83. FIN-SI. SI i==1 TUNC REDDE 89. FIN-SI. SI i==2 TUNC REDDE 76. FIN-SI.
        SI i==3 TUNC REDDE 86. FIN-SI. SI i==4 TUNC REDDE 73. FIN-SI. SI i==5 TUNC REDDE 65. FIN-SI.
        SI i==6 TUNC REDDE 32. FIN-SI.
        REDDE LT_LITTERA(3,i-7).
    FIN-SI.
    // VINDEX VERITAS ABSOLUTA EST
    SI id==12 TUNC
        SI i==0 TUNC REDDE 86. FIN-SI. SI i==1 TUNC REDDE 73. FIN-SI. SI i==2 TUNC REDDE 78. FIN-SI.
        SI i==3 TUNC REDDE 68. FIN-SI. SI i==4 TUNC REDDE 69. FIN-SI. SI i==5 TUNC REDDE 88. FIN-SI.
        SI i==6 TUNC REDDE 32. FIN-SI.
        SI i==7 TUNC REDDE 86. FIN-SI. SI i==8 TUNC REDDE 69. FIN-SI. SI i==9 TUNC REDDE 82. FIN-SI.
        SI i==10 TUNC REDDE 73. FIN-SI. SI i==11 TUNC REDDE 84. FIN-SI. SI i==12 TUNC REDDE 65. FIN-SI.
        SI i==13 TUNC REDDE 83. FIN-SI. SI i==14 TUNC REDDE 32. FIN-SI.
        SI i==15 TUNC REDDE 65. FIN-SI. SI i==16 TUNC REDDE 66. FIN-SI. SI i==17 TUNC REDDE 83. FIN-SI.
        SI i==18 TUNC REDDE 79. FIN-SI. SI i==19 TUNC REDDE 76. FIN-SI. SI i==20 TUNC REDDE 85. FIN-SI.
        SI i==21 TUNC REDDE 84. FIN-SI. SI i==22 TUNC REDDE 65. FIN-SI. SI i==23 TUNC REDDE 32. FIN-SI.
        SI i==24 TUNC REDDE 69. FIN-SI. SI i==25 TUNC REDDE 83. FIN-SI. SI i==26 TUNC REDDE 84. FIN-SI.
    FIN-SI.
    // FENESTRAE DYNAMICAE
    SI id==13 TUNC
        SI i==0 TUNC REDDE 70. FIN-SI. SI i==1 TUNC REDDE 69. FIN-SI. SI i==2 TUNC REDDE 78. FIN-SI.
        SI i==3 TUNC REDDE 69. FIN-SI. SI i==4 TUNC REDDE 83. FIN-SI. SI i==5 TUNC REDDE 84. FIN-SI.
        SI i==6 TUNC REDDE 82. FIN-SI. SI i==7 TUNC REDDE 65. FIN-SI. SI i==8 TUNC REDDE 69. FIN-SI.
        SI i==9 TUNC REDDE 32. FIN-SI.
        SI i==10 TUNC REDDE 68. FIN-SI. SI i==11 TUNC REDDE 89. FIN-SI. SI i==12 TUNC REDDE 78. FIN-SI.
        SI i==13 TUNC REDDE 65. FIN-SI. SI i==14 TUNC REDDE 77. FIN-SI. SI i==15 TUNC REDDE 73. FIN-SI.
        SI i==16 TUNC REDDE 67. FIN-SI. SI i==17 TUNC REDDE 65. FIN-SI. SI i==18 TUNC REDDE 69. FIN-SI.
    FIN-SI.
    // MURUS ET CLAVIS VINDEX
    SI id==14 TUNC
        SI i==0 TUNC REDDE 77. FIN-SI. SI i==1 TUNC REDDE 85. FIN-SI. SI i==2 TUNC REDDE 82. FIN-SI.
        SI i==3 TUNC REDDE 85. FIN-SI. SI i==4 TUNC REDDE 83. FIN-SI. SI i==5 TUNC REDDE 32. FIN-SI.
        SI i==6 TUNC REDDE 69. FIN-SI. SI i==7 TUNC REDDE 84. FIN-SI. SI i==8 TUNC REDDE 32. FIN-SI.
        SI i==9 TUNC REDDE 67. FIN-SI. SI i==10 TUNC REDDE 76. FIN-SI. SI i==11 TUNC REDDE 65. FIN-SI.
        SI i==12 TUNC REDDE 86. FIN-SI. SI i==13 TUNC REDDE 73. FIN-SI. SI i==14 TUNC REDDE 83. FIN-SI.
        SI i==15 TUNC REDDE 32. FIN-SI.
        SI i==16 TUNC REDDE 86. FIN-SI. SI i==17 TUNC REDDE 73. FIN-SI. SI i==18 TUNC REDDE 78. FIN-SI.
        SI i==19 TUNC REDDE 68. FIN-SI. SI i==20 TUNC REDDE 69. FIN-SI. SI i==21 TUNC REDDE 88. FIN-SI.
    FIN-SI.
    // ESC: EXITUS
    SI id==15 TUNC
        SI i==0 TUNC REDDE 69. FIN-SI. SI i==1 TUNC REDDE 83. FIN-SI. SI i==2 TUNC REDDE 67. FIN-SI.
        SI i==3 TUNC REDDE 58. FIN-SI. SI i==4 TUNC REDDE 32. FIN-SI.
        SI i==5 TUNC REDDE 69. FIN-SI. SI i==6 TUNC REDDE 88. FIN-SI. SI i==7 TUNC REDDE 73. FIN-SI.
        SI i==8 TUNC REDDE 84. FIN-SI. SI i==9 TUNC REDDE 85. FIN-SI. SI i==10 TUNC REDDE 83. FIN-SI.
    FIN-SI.
    // INITIUM
    SI id==16 TUNC
        SI i==0 TUNC REDDE 73. FIN-SI. SI i==1 TUNC REDDE 78. FIN-SI. SI i==2 TUNC REDDE 73. FIN-SI.
        SI i==3 TUNC REDDE 84. FIN-SI. SI i==4 TUNC REDDE 73. FIN-SI. SI i==5 TUNC REDDE 85. FIN-SI.
        SI i==6 TUNC REDDE 77. FIN-SI.
    FIN-SI.
    REDDE 32.
FIN-FUNCTIO.

FUNCTIO LT_TEXT REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS.
    ACCIPIT id SICUT NUMERUS. ACCIPIT color SICUT NUMERUS.
    DECLARA n SICUT NUMERUS VALENS LT_MENSURA(id).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<n PERFICE
        DECLARA c SICUT NUMERUS VALENS LT_LITTERA(id,i).
        DECLARA q SICUT NUMERUS VALENS LT_GLYPH(x+i*8,y,c,color).
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.
