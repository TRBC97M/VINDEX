// LABORATORIUM SYLVIAE — graphica nativa VINDEX.

FUNCTIO LG_AD_EST REDDENS NUMERUS.
    SI CONTENTUM(50333696) != 1 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50333712) == 0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50333728) < 640 || CONTENTUM(50333736) < 480 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50333720) < CONTENTUM(50333728) TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50333744) > 1 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(50333784) == 0 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LG_COLOR REDDENS NUMERUS.
    ACCIPIT rubrum SICUT NUMERUS.
    ACCIPIT viride SICUT NUMERUS.
    ACCIPIT caeruleum SICUT NUMERUS.
    SI CONTENTUM(50333744) == 0 TUNC REDDE rubrum + viride*256 + caeruleum*65536. FIN-SI.
    REDDE caeruleum + viride*256 + rubrum*65536.
FIN-FUNCTIO.

FUNCTIO LG_PIXEL REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS. ACCIPIT color SICUT NUMERUS.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(50333728).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(50333736).
    SI x<0 || y<0 || x>=w || y>=h TUNC REDDE 0. FIN-SI.
    DECLARA locus SICUT NUMERUS VALENS CONTENTUM(50333712) + (y*CONTENTUM(50333720)+x)*4.
    SCRIBE_OCTETUM_AB(locus,color&255).
    SCRIBE_OCTETUM_AB(locus+1,(color>>8)&255).
    SCRIBE_OCTETUM_AB(locus+2,(color>>16)&255).
    SCRIBE_OCTETUM_AB(locus+3,0).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LG_RECT REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS. ACCIPIT h SICUT NUMERUS. ACCIPIT color SICUT NUMERUS.
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(50333728).
    DECLARA sh SICUT NUMERUS VALENS CONTENTUM(50333736).
    SI w<=0 || h<=0 TUNC REDDE 0. FIN-SI.
    SI x<0 TUNC w=w+x. x=0. FIN-SI.
    SI y<0 TUNC h=h+y. y=0. FIN-SI.
    SI x>=sw || y>=sh || w<=0 || h<=0 TUNC REDDE 0. FIN-SI.
    SI x+w>sw TUNC w=sw-x. FIN-SI.
    SI y+h>sh TUNC h=sh-y. FIN-SI.
    DECLARA yy SICUT NUMERUS VALENS y.
    DUM yy<y+h PERFICE
        DECLARA xx SICUT NUMERUS VALENS x.
        DUM xx<x+w PERFICE
            DECLARA p SICUT NUMERUS VALENS LG_PIXEL(xx,yy,color).
            xx=xx+1.
        FIN-DUM.
        yy=yy+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LG_TEXTUM REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT TEXTUS. ACCIPIT color SICUT NUMERUS.
    DECLARA forma SICUT NUMERUS VALENS CONTENTUM(50333784).
    SI forma==0 TUNC REDDE 0. FIN-SI.
    DECLARA longitudo SICUT NUMERUS VALENS CONTENTUM(textus).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<longitudo PERFICE
        DECLARA littera SICUT NUMERUS VALENS OCTETUS_AB(textus+16+i).
        DECLARA py SICUT NUMERUS VALENS 0.
        DUM py<8 PERFICE
            DECLARA bits SICUT NUMERUS VALENS OCTETUS_AB(forma+littera*8+py).
            DECLARA px SICUT NUMERUS VALENS 0.
            DUM px<8 PERFICE
                SI (bits&(128>>px))!=0 TUNC DECLARA q SICUT NUMERUS VALENS LG_PIXEL(x+i*8+px,y+py,color). FIN-SI.
                px=px+1.
            FIN-DUM.
            py=py+1.
        FIN-DUM.
        i=i+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LG_FUNDUM REDDENS NUMERUS.
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(50333728).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(50333736).
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<24 PERFICE
        DECLARA y0 SICUT NUMERUS VALENS i*(h-28)/24.
        DECLARA y1 SICUT NUMERUS VALENS (i+1)*(h-28)/24.
        DECLARA r SICUT NUMERUS VALENS 8-i/4.
        DECLARA g SICUT NUMERUS VALENS 52-i.
        DECLARA b SICUT NUMERUS VALENS 90-i.
        SI r<4 TUNC r=4. FIN-SI. SI g<24 TUNC g=24. FIN-SI. SI b<52 TUNC b=52. FIN-SI.
        DECLARA f SICUT NUMERUS VALENS LG_RECT(0,y0,w,y1-y0,LG_COLOR(r,g,b)).
        i=i+1.
    FIN-DUM.
    DECLARA arc SICUT NUMERUS VALENS 0.
    DUM arc<50 PERFICE
        DECLARA ax SICUT NUMERUS VALENS w*12/100 + arc*w*72/5000.
        DECLARA ay SICUT NUMERUS VALENS h*68/100 - arc*arc*h/185000.
        DECLARA a SICUT NUMERUS VALENS LG_RECT(ax,ay,w/170+2,1,LG_COLOR(98,215,242)).
        arc=arc+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LG_FENESTRA REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS. ACCIPIT w SICUT NUMERUS. ACCIPIT h SICUT NUMERUS.
    ACCIPIT titulus SICUT TEXTUS. ACCIPIT activa SICUT NUMERUS.
    DECLARA ebur SICUT NUMERUS VALENS LG_COLOR(241,238,228).
    DECLARA argentum SICUT NUMERUS VALENS LG_COLOR(185,196,207).
    DECLARA profundum SICUT NUMERUS VALENS LG_COLOR(8,35,61).
    DECLARA vitrum SICUT NUMERUS VALENS LG_COLOR(14,66,111).
    DECLARA medium SICUT NUMERUS VALENS LG_COLOR(26,93,146).
    DECLARA aqua SICUT NUMERUS VALENS LG_COLOR(98,215,242).
    DECLARA lux SICUT NUMERUS VALENS LG_COLOR(234,248,255).
    DECLARA bronzeum SICUT NUMERUS VALENS LG_COLOR(185,138,82).
    DECLARA rubrum SICUT NUMERUS VALENS LG_COLOR(168,58,58).
    DECLARA margo SICUT NUMERUS VALENS argentum.
    SI activa==1 TUNC margo=bronzeum. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS LG_RECT(x+6,y+7,w,h,LG_COLOR(4,18,31)).
    f=LG_RECT(x,y,w,h,ebur).
    f=LG_RECT(x,y,w,1,margo). f=LG_RECT(x,y,2,h,argentum).
    f=LG_RECT(x+w-2,y,2,h,profundum). f=LG_RECT(x,y+h-2,w,2,profundum).
    f=LG_RECT(x+2,y+1,w-4,27,vitrum).
    SI activa==0 TUNC f=LG_RECT(x+2,y+2,w-4,26,medium). FIN-SI.
    f=LG_RECT(x+2,y+1,w-4,1,aqua).
    f=LG_TEXTUM(x+10,y+10,titulus,lux).
    f=LG_RECT(x+w-70,y+4,18,20,argentum).
    f=LG_RECT(x+w-48,y+4,18,20,argentum).
    f=LG_RECT(x+w-26,y+4,20,20,rubrum).
    f=LG_RECT(x+w-66,y+18,10,2,profundum).
    f=LG_RECT(x+w-44,y+8,10,2,profundum). f=LG_RECT(x+w-44,y+8,2,10,profundum).
    f=LG_RECT(x+w-36,y+8,2,10,profundum). f=LG_RECT(x+w-44,y+16,10,2,profundum).
    f=LG_RECT(x+w-21,y+10,10,2,lux). f=LG_RECT(x+w-17,y+6,2,10,lux).
    f=LG_RECT(x+2,y+28,w-4,22,ebur). f=LG_RECT(x+2,y+50,w-4,34,argentum).
    f=LG_RECT(x+2,y+h-20,w-4,18,argentum).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LG_CURSOR REDDENS NUMERUS.
    ACCIPIT x SICUT NUMERUS. ACCIPIT y SICUT NUMERUS.
    DECLARA niger SICUT NUMERUS VALENS LG_COLOR(12,20,27).
    DECLARA ebur SICUT NUMERUS VALENS LG_COLOR(241,238,228).
    DECLARA py SICUT NUMERUS VALENS 0.
    DUM py<14 PERFICE
        DECLARA px SICUT NUMERUS VALENS 0.
        DUM px<=py/2+1 PERFICE
            DECLARA c SICUT NUMERUS VALENS ebur.
            SI px==0 || px==py/2+1 || py==13 TUNC c=niger. FIN-SI.
            DECLARA p SICUT NUMERUS VALENS LG_PIXEL(x+px,y+py,c).
            px=px+1.
        FIN-DUM.
        py=py+1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.
