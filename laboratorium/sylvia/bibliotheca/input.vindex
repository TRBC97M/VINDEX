// LABORATORIUM SYLVIAE — input UEFI directe a VINDEX.
// Vector status: 0 x; 1 y; 2 bullae; 3 murus relativus; 4 murus absolutus; 9 eventus receptus.

FUNCTIO LI_I32 REDDENS NUMERUS.
    ACCIPIT locus SICUT NUMERUS.
    DECLARA valor SICUT NUMERUS VALENS OCTETUS_AB(locus).
    valor=valor|(OCTETUS_AB(locus+1)<<8).
    valor=valor|(OCTETUS_AB(locus+2)<<16).
    valor=valor|(OCTETUS_AB(locus+3)<<24).
    SI valor>=2147483648 TUNC valor=valor-4294967296. FIN-SI.
    REDDE valor.
FIN-FUNCTIO.

FUNCTIO LI_GUID_PONE REDDENS NUMERUS.
    ACCIPIT guid SICUT ACUS<LITTERA>. ACCIPIT genus SICUT NUMERUS.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i<16 PERFICE guid[i]=0. i=i+1. FIN-DUM.
    SI genus==1 TUNC
        guid[0]=135. guid[1]=140. guid[2]=135. guid[3]=49. guid[4]=117. guid[5]=11. guid[6]=213. guid[7]=17.
        guid[8]=154. guid[9]=79. guid[10]=0. guid[11]=144. guid[12]=39. guid[13]=63. guid[14]=193. guid[15]=77.
    FIN-SI.
    SI genus==2 TUNC
        guid[0]=43. guid[1]=211. guid[2]=89. guid[3]=141. guid[4]=85. guid[5]=198. guid[6]=233. guid[7]=74.
        guid[8]=155. guid[9]=21. guid[10]=242. guid[11]=89. guid[12]=4. guid[13]=153. guid[14]=42. guid[15]=67.
    FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LI_PROTOCOL_LOCATE REDDENS NUMERUS.
    ACCIPIT genus SICUT NUMERUS.
    DECLARA systema SICUT NUMERUS VALENS CONTENTUM(50333704).
    SI systema==0 TUNC REDDE 0. FIN-SI.
    DECLARA boot SICUT NUMERUS VALENS CONTENTUM(systema+96).
    SI boot==0 TUNC REDDE 0. FIN-SI.
    DECLARA locate SICUT NUMERUS VALENS CONTENTUM(boot+320).
    SI locate==0 TUNC REDDE 0. FIN-SI.
    DECLARA guid SICUT ORDO DE LITTERA CAPACITAS 16.
    DECLARA g SICUT NUMERUS VALENS LI_GUID_PONE(guid,genus).
    DECLARA protocol SICUT NUMERUS VALENS 0.
    DECLARA status SICUT NUMERUS VALENS UEFI_VOCA6(locate,SEDES(guid),0,SEDES(protocol),0,0,0).
    SI status!=0 TUNC REDDE 0. FIN-SI.
    REDDE protocol.
FIN-FUNCTIO.

FUNCTIO LI_PARA REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    s[3]=CONTENTUM(50333840).
    s[4]=CONTENTUM(50333848).
    SI s[3]==0 TUNC s[3]=LI_PROTOCOL_LOCATE(1). FIN-SI.
    SI s[4]==0 TUNC s[4]=LI_PROTOCOL_LOCATE(2). FIN-SI.
    s[9]=0.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LI_CLAVIS REDDENS NUMERUS.
    DECLARA rubrum SICUT NUMERUS VALENS LG_COLOR(168,58,58).
    DECLARA viride SICUT NUMERUS VALENS LG_COLOR(95,122,104).
    DECLARA d0 SICUT NUMERUS VALENS LG_RECT(2,12,8,8,rubrum).
    DECLARA systema SICUT NUMERUS VALENS CONTENTUM(50333704).
    SI systema==0 TUNC REDDE 0. FIN-SI.
    DECLARA conin SICUT NUMERUS VALENS CONTENTUM(systema+48).
    SI conin==0 TUNC REDDE 0. FIN-SI.
    DECLARA lege SICUT NUMERUS VALENS CONTENTUM(conin+8).
    SI lege==0 TUNC REDDE 0. FIN-SI.
    DECLARA data SICUT NUMERUS VALENS 0.
    DECLARA status SICUT NUMERUS VALENS UEFI_VOCA6(lege,conin,SEDES(data),0,0,0,0).
    DECLARA d1 SICUT NUMERUS VALENS LG_RECT(12,12,8,8,viride).
    SI status!=0 TUNC REDDE 0. FIN-SI.
    DECLARA scan SICUT NUMERUS VALENS OCTETUS_AB(SEDES(data))|(OCTETUS_AB(SEDES(data)+1)<<8).
    DECLARA unicode SICUT NUMERUS VALENS OCTETUS_AB(SEDES(data)+2)|(OCTETUS_AB(SEDES(data)+3)<<8).
    REDDE 1+scan*2+unicode*131072.
FIN-FUNCTIO.

FUNCTIO LI_ABSOLUTUS REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    DECLARA bronzeum SICUT NUMERUS VALENS LG_COLOR(185,138,82).
    DECLARA aqua SICUT NUMERUS VALENS LG_COLOR(98,215,242).
    DECLARA murus SICUT NUMERUS VALENS s[4].
    SI murus==0 TUNC REDDE 190. FIN-SI.
    DECLARA lege SICUT NUMERUS VALENS CONTENTUM(murus+8).
    DECLARA modus SICUT NUMERUS VALENS CONTENTUM(murus+24).
    SI lege==0 || modus==0 TUNC REDDE 191. FIN-SI.
    DECLARA data SICUT ORDO DE NUMERUS CAPACITAS 4.
    DECLARA d0 SICUT NUMERUS VALENS LG_RECT(22,12,8,8,bronzeum).
    DECLARA status SICUT NUMERUS VALENS UEFI_VOCA6(lege,murus,SEDES(data),0,0,0,0).
    DECLARA d1 SICUT NUMERUS VALENS LG_RECT(32,12,8,8,aqua).
    SI status!=0 TUNC REDDE 100+(status&255). FIN-SI.
    DECLARA minx SICUT NUMERUS VALENS CONTENTUM(modus). DECLARA miny SICUT NUMERUS VALENS CONTENTUM(modus+8).
    DECLARA maxx SICUT NUMERUS VALENS CONTENTUM(modus+24). DECLARA maxy SICUT NUMERUS VALENS CONTENTUM(modus+32).
    DECLARA dx SICUT NUMERUS VALENS maxx-minx. DECLARA dy SICUT NUMERUS VALENS maxy-miny.
    SI dx<=0 || dy<=0 TUNC REDDE 192. FIN-SI.
    s[0]=(data[0]-minx)*(CONTENTUM(50333728)-1)/dx.
    s[1]=(data[1]-miny)*(CONTENTUM(50333736)-1)/dy.
    SI s[0]<0 TUNC s[0]=0. FIN-SI. SI s[1]<0 TUNC s[1]=0. FIN-SI.
    SI s[0]>=CONTENTUM(50333728) TUNC s[0]=CONTENTUM(50333728)-1. FIN-SI.
    SI s[1]>=CONTENTUM(50333736) TUNC s[1]=CONTENTUM(50333736)-1. FIN-SI.
    s[2]=data[3]&3.
    s[9]=1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LI_RELATIVUS REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    DECLARA flavum SICUT NUMERUS VALENS LG_COLOR(218,184,92).
    DECLARA viride SICUT NUMERUS VALENS LG_COLOR(95,122,104).
    DECLARA aqua SICUT NUMERUS VALENS LG_COLOR(98,215,242).
    DECLARA d_enter SICUT NUMERUS VALENS LG_RECT(42,12,8,8,flavum).
    DECLARA murus SICUT NUMERUS VALENS s[3].
    SI murus==0 TUNC REDDE 290. FIN-SI.
    DECLARA d_murus SICUT NUMERUS VALENS LG_RECT(52,12,8,8,viride).
    DECLARA lege SICUT NUMERUS VALENS CONTENTUM(murus+8).
    SI lege==0 TUNC REDDE 291. FIN-SI.
    DECLARA d_lege SICUT NUMERUS VALENS LG_RECT(62,12,8,8,aqua).
    DECLARA data SICUT ORDO DE NUMERUS CAPACITAS 2.
    DECLARA d0 SICUT NUMERUS VALENS LG_RECT(72,12,8,8,flavum).
    DECLARA status SICUT NUMERUS VALENS UEFI_VOCA6(lege,murus,SEDES(data),0,0,0,0).
    DECLARA d1 SICUT NUMERUS VALENS LG_RECT(82,12,8,8,viride).
    SI status!=0 TUNC REDDE 200+(status&255). FIN-SI.
    DECLARA dx SICUT NUMERUS VALENS LI_I32(SEDES(data)).
    DECLARA dy SICUT NUMERUS VALENS LI_I32(SEDES(data)+4).
    DECLARA rawx SICUT NUMERUS VALENS dx. DECLARA rawy SICUT NUMERUS VALENS dy.
    dx=dx*CONTENTUM(50333728)/640. dy=dy*CONTENTUM(50333736)/400.
    SI rawx!=0 && dx==0 TUNC SI rawx<0 TUNC dx=0-1. ALITER dx=1. FIN-SI. FIN-SI.
    SI rawy!=0 && dy==0 TUNC SI rawy<0 TUNC dy=0-1. ALITER dy=1. FIN-SI. FIN-SI.
    s[0]=s[0]+dx. s[1]=s[1]+dy.
    SI s[0]<0 TUNC s[0]=0. FIN-SI. SI s[1]<0 TUNC s[1]=0. FIN-SI.
    SI s[0]>=CONTENTUM(50333728) TUNC s[0]=CONTENTUM(50333728)-1. FIN-SI.
    SI s[1]>=CONTENTUM(50333736) TUNC s[1]=CONTENTUM(50333736)-1. FIN-SI.
    DECLARA b SICUT NUMERUS VALENS 0.
    SI OCTETUS_AB(SEDES(data)+12)!=0 TUNC b=b|1. FIN-SI.
    SI OCTETUS_AB(SEDES(data)+13)!=0 TUNC b=b|2. FIN-SI.
    s[2]=b.
    s[9]=2.
    REDDE 2.
FIN-FUNCTIO.

FUNCTIO LI_LEGE REDDENS NUMERUS.
    ACCIPIT s SICUT ORDO DE NUMERUS.
    DECLARA rubrum SICUT NUMERUS VALENS LG_COLOR(168,58,58).
    DECLARA viride SICUT NUMERUS VALENS LG_COLOR(95,122,104).
    DECLARA aqua SICUT NUMERUS VALENS LG_COLOR(98,215,242).
    DECLARA bronzeum SICUT NUMERUS VALENS LG_COLOR(185,138,82).
    DECLARA flavum SICUT NUMERUS VALENS LG_COLOR(218,184,92).
    DECLARA relcol SICUT NUMERUS VALENS rubrum.
    DECLARA abscol SICUT NUMERUS VALENS rubrum.
    SI s[3]!=0 TUNC relcol=viride. FIN-SI.
    SI s[4]!=0 TUNC abscol=aqua. FIN-SI.
    DECLARA relstatus SICUT NUMERUS VALENS 299.
    DECLARA absstatus SICUT NUMERUS VALENS 199.
    SI s[3]!=0 TUNC
        relstatus=LI_RELATIVUS(s).
    ALITER
        SI s[4]!=0 TUNC absstatus=LI_ABSOLUTUS(s). FIN-SI.
    FIN-SI.
    DECLARA absstate SICUT NUMERUS VALENS rubrum.
    DECLARA relstate SICUT NUMERUS VALENS rubrum.
    SI absstatus==106 TUNC absstate=flavum. FIN-SI.
    SI relstatus==206 TUNC relstate=flavum. FIN-SI.
    SI absstatus==1 TUNC absstate=aqua. FIN-SI.
    SI relstatus==2 TUNC relstate=bronzeum. FIN-SI.
    DECLARA eventcol SICUT NUMERUS VALENS rubrum.
    SI s[9]==1 TUNC eventcol=aqua. FIN-SI.
    SI s[9]==2 TUNC eventcol=bronzeum. FIN-SI.
    DECLARA dr1 SICUT NUMERUS VALENS LG_RECT(2,2,8,8,relcol).
    DECLARA dr2 SICUT NUMERUS VALENS LG_RECT(12,2,8,8,abscol).
    DECLARA dr3 SICUT NUMERUS VALENS LG_RECT(22,2,8,8,eventcol).
    DECLARA dr4 SICUT NUMERUS VALENS LG_RECT(32,2,8,8,absstate).
    DECLARA dr5 SICUT NUMERUS VALENS LG_RECT(42,2,8,8,relstate).
    SI relstatus==2 || absstatus==1 TUNC REDDE 1. FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO LI_STALL REDDENS NUMERUS.
    DECLARA systema SICUT NUMERUS VALENS CONTENTUM(50333704).
    SI systema==0 TUNC REDDE 0. FIN-SI.
    DECLARA boot SICUT NUMERUS VALENS CONTENTUM(systema+96).
    SI boot==0 TUNC REDDE 0. FIN-SI.
    DECLARA stall SICUT NUMERUS VALENS CONTENTUM(boot+248).
    SI stall==0 TUNC REDDE 0. FIN-SI.
    REDDE UEFI_VOCA6(stall,12000,0,0,0,0,0).
FIN-FUNCTIO.
