// LABORATORIUM SYLVIAE — desktop experimentale omnino VINDEX.
// Hic fons nihil extra laboratorium mutat.

IMPORTA "laboratorium/sylvia/bibliotheca/graphica.vindex".
IMPORTA "laboratorium/sylvia/bibliotheca/fenestrae.vindex".
IMPORTA "laboratorium/sylvia/bibliotheca/input.vindex".
IMPORTA "laboratorium/sylvia/bibliotheca/input_ps2.vindex".
IMPORTA "laboratorium/sylvia/bibliotheca/texta.vindex".
IMPORTA "laboratorium/sylvia/bibliotheca/texta_redde.vindex".

FUNCTIO LL_TITULUS REDDENS TEXTUS.
    ACCIPIT genus SICUT NUMERUS.
    SI genus==1 TUNC REDDE "PROGRAMMATA". FIN-SI.
    SI genus==2 TUNC REDDE "TABULA". FIN-SI.
    REDDE "LABORATORIUM".
FIN-FUNCTIO.

FUNCTIO LL_CONTENTUM REDDENS NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    SI n==0 TUNC REDDE 0. FIN-SI.
    DECLARA genus SICUT NUMERUS VALENS CONTENTUM(n+8).
    DECLARA x SICUT NUMERUS VALENS CONTENTUM(n+16).
    DECLARA y SICUT NUMERUS VALENS CONTENTUM(n+24).
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(n+32).
    DECLARA h SICUT NUMERUS VALENS CONTENTUM(n+40).
    DECLARA profundum SICUT NUMERUS VALENS LG_COLOR(8,35,61).
    DECLARA medium SICUT NUMERUS VALENS LG_COLOR(26,93,146).
    DECLARA aqua SICUT NUMERUS VALENS LG_COLOR(98,215,242).
    DECLARA lux SICUT NUMERUS VALENS LG_COLOR(234,248,255).
    DECLARA ebur SICUT NUMERUS VALENS LG_COLOR(241,238,228).
    DECLARA argentum SICUT NUMERUS VALENS LG_COLOR(185,196,207).
    DECLARA bronzeum SICUT NUMERUS VALENS LG_COLOR(185,138,82).
    DECLARA f SICUT NUMERUS VALENS 0.
    SI genus==1 TUNC
        f=LG_RECT(x+10,y+55,62,24,lux). f=LG_TEXTUM(x+18,y+63,"NOVUM",profundum).
        f=LG_RECT(x+78,y+55,62,24,lux). f=LG_TEXTUM(x+86,y+63,"EDITE",profundum).
        f=LG_RECT(x+146,y+55,62,24,lux). f=LG_TEXTUM(x+154,y+63,"NOMEN",profundum).
        f=LG_RECT(x+10,y+88,132,h-112,argentum). f=LG_TEXTUM(x+20,y+102,"LOCORUM",profundum).
        f=LG_RECT(x+154,y+88,w-166,112,lux). f=LG_RECT(x+154,y+88,w-166,2,medium).
        f=LG_RECT(x+174,y+108,58,58,profundum). f=LG_RECT(x+184,y+118,38,38,aqua).
        f=LG_TEXTUM(x+246,y+118,"TABULA.VXNAT",profundum).
        f=LG_TEXTUM(x+246,y+140,"APPLICATIO",medium).
    FIN-SI.
    SI genus==2 TUNC
        f=LG_RECT(x+10,y+55,58,24,lux). f=LG_TEXTUM(x+18,y+63,"NOVUM",profundum).
        f=LG_RECT(x+74,y+55,58,24,lux). f=LG_TEXTUM(x+84,y+63,"SERVA",profundum).
        DECLARA left SICUT NUMERUS VALENS x+34. DECLARA top SICUT NUMERUS VALENS y+92.
        DECLARA gw SICUT NUMERUS VALENS w-44. DECLARA gh SICUT NUMERUS VALENS h-116.
        SI gw>80 && gh>60 TUNC
            f=LG_RECT(x+8,top,26,gh,argentum). f=LG_RECT(left,top,gw,22,argentum). f=LG_RECT(left,top+22,gw,gh-22,lux).
            DECLARA c SICUT NUMERUS VALENS 0.
            DUM c<=8 PERFICE DECLARA gx SICUT NUMERUS VALENS left+c*gw/8. f=LG_RECT(gx,top,1,gh,argentum). c=c+1. FIN-DUM.
            DECLARA r SICUT NUMERUS VALENS 0.
            DUM r<=12 PERFICE DECLARA gy SICUT NUMERUS VALENS top+22+r*(gh-22)/12. f=LG_RECT(x+8,gy,w-18,1,argentum). r=r+1. FIN-DUM.
            f=LG_RECT(left+2,top+24,gw/8-4,(gh-22)/12-4,LG_COLOR(225,245,249)).
            f=LG_RECT(left+2,top+24,gw/8-4,2,bronzeum).
        FIN-SI.
    FIN-SI.
    SI genus==3 TUNC
        f=LG_RECT(x+10,y+55,w-20,30,profundum).
        f=LG_TEXTUM(x+20,y+66,"SYLVIA LABORATORIUM",aqua).
        f=LG_TEXTUM(x+20,y+102,"VINDEX VERITAS ABSOLUTA EST",profundum).
        f=LG_TEXTUM(x+20,y+124,"FENESTRAE DYNAMICAE",medium).
        f=LG_TEXTUM(x+20,y+146,"MURUS ET CLAVIS VINDEX",medium).
        f=LG_RECT(x+20,y+174,w-40,2,bronzeum).
        f=LG_TEXTUM(x+20,y+190,"ESC: EXITUS",profundum).
    FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LL_FENESTRA REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT n SICUT NUMERUS.
    SI n==0 || CONTENTUM(n+48)!=0 TUNC REDDE 0. FIN-SI.
    DECLARA id SICUT NUMERUS VALENS CONTENTUM(n).
    DECLARA activa SICUT NUMERUS VALENS 0.
    SI LF_FOCUS_ID(r)==id TUNC activa=1. FIN-SI.
    DECLARA f SICUT NUMERUS VALENS LG_FENESTRA(CONTENTUM(n+16),CONTENTUM(n+24),CONTENTUM(n+32),CONTENTUM(n+40),LL_TITULUS(CONTENTUM(n+8)),activa).
    f=LL_CONTENTUM(n).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LL_TASKBAR REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(50333728). DECLARA sh SICUT NUMERUS VALENS CONTENTUM(50333736).
    DECLARA profundum SICUT NUMERUS VALENS LG_COLOR(8,35,61). DECLARA vitrum SICUT NUMERUS VALENS LG_COLOR(14,66,111).
    DECLARA medium SICUT NUMERUS VALENS LG_COLOR(26,93,146). DECLARA aqua SICUT NUMERUS VALENS LG_COLOR(98,215,242).
    DECLARA lux SICUT NUMERUS VALENS LG_COLOR(234,248,255).
    DECLARA f SICUT NUMERUS VALENS LG_RECT(0,sh-28,sw,28,profundum). f=LG_RECT(0,sh-28,sw,1,aqua).
    f=LG_RECT(4,sh-24,86,20,vitrum). f=LG_TEXTUM(14,sh-18,"INITIUM",lux).
    DECLARA aperta SICUT NUMERUS VALENS 0. DECLARA n SICUT NUMERUS VALENS LF_PRIMUS(r).
    DUM n!=0 PERFICE SI CONTENTUM(n+48)!=2 TUNC aperta=aperta+1. FIN-SI. n=CONTENTUM(n+104). FIN-DUM.
    SI aperta<=0 TUNC REDDE 1. FIN-SI.
    DECLARA bw SICUT NUMERUS VALENS (sw-104)/aperta.
    SI bw>188 TUNC bw=188. FIN-SI. SI bw<72 TUNC bw=72. FIN-SI.
    n=LF_PRIMUS(r). DECLARA i SICUT NUMERUS VALENS 0.
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)!=2 TUNC
            DECLARA bx SICUT NUMERUS VALENS 98+i*bw.
            SI bx<sw-6 TUNC
                DECLARA col SICUT NUMERUS VALENS vitrum.
                SI CONTENTUM(n)==LF_FOCUS_ID(r) && CONTENTUM(n+48)==0 TUNC col=medium. FIN-SI.
                f=LG_RECT(bx,sh-24,bw-6,20,col).
                f=LG_TEXTUM(bx+10,sh-18,LL_TITULUS(CONTENTUM(n+8)),lux).
            FIN-SI.
            i=i+1.
        FIN-SI.
        n=CONTENTUM(n+104).
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LL_REDDE REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT m SICUT ORDO DE NUMERUS.
    DECLARA f SICUT NUMERUS VALENS LG_FUNDUM().
    DECLARA n SICUT NUMERUS VALENS LF_PRIMUS(r).
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)==0 TUNC f=LL_FENESTRA(r,n). FIN-SI.
        n=CONTENTUM(n+104).
    FIN-DUM.
    f=LL_TASKBAR(r). f=LT_REDDE(r). f=LG_CURSOR(m[0],m[1]).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO LL_TASKBAR_CLICK REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT x SICUT NUMERUS.
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(50333728).
    DECLARA aperta SICUT NUMERUS VALENS 0. DECLARA n SICUT NUMERUS VALENS LF_PRIMUS(r).
    DUM n!=0 PERFICE SI CONTENTUM(n+48)!=2 TUNC aperta=aperta+1. FIN-SI. n=CONTENTUM(n+104). FIN-DUM.
    SI aperta<=0 || x<98 TUNC REDDE 0. FIN-SI.
    DECLARA bw SICUT NUMERUS VALENS (sw-104)/aperta. SI bw>188 TUNC bw=188. FIN-SI. SI bw<72 TUNC bw=72. FIN-SI.
    DECLARA index SICUT NUMERUS VALENS (x-98)/bw.
    n=LF_PRIMUS(r). DECLARA i SICUT NUMERUS VALENS 0.
    DUM n!=0 PERFICE
        SI CONTENTUM(n+48)!=2 TUNC
            SI i==index TUNC
                DECLARA id SICUT NUMERUS VALENS CONTENTUM(n).
                SI CONTENTUM(n+48)==1 TUNC REDDE LF_RESTITUE(r,id). FIN-SI.
                SI LF_FOCUS_ID(r)==id TUNC REDDE LF_MINIMIZA(r,id). FIN-SI.
                REDDE LF_FOCUS(r,id).
            FIN-SI.
            i=i+1.
        FIN-SI.
        n=CONTENTUM(n+104).
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO LL_MOUSE_DOWN REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT m SICUT ORDO DE NUMERUS.
    DECLARA sh SICUT NUMERUS VALENS CONTENTUM(50333736).
    SI m[1]>=sh-28 TUNC REDDE LL_TASKBAR_CLICK(r,m[0]). FIN-SI.
    DECLARA id SICUT NUMERUS VALENS LF_HIT(r,m[0],m[1]).
    SI id==0 TUNC REDDE 0. FIN-SI.
    DECLARA foc SICUT NUMERUS VALENS LF_FOCUS(r,id).
    DECLARA n SICUT NUMERUS VALENS LF_QUAERE(r,id).
    DECLARA lx SICUT NUMERUS VALENS m[0]-CONTENTUM(n+16). DECLARA ly SICUT NUMERUS VALENS m[1]-CONTENTUM(n+24).
    DECLARA w SICUT NUMERUS VALENS CONTENTUM(n+32).
    SI ly>=4 && ly<24 && lx>=w-26 && lx<w-6 TUNC REDDE LF_CLAUDE(r,id). FIN-SI.
    SI ly>=4 && ly<24 && lx>=w-70 && lx<w-52 TUNC REDDE LF_MINIMIZA(r,id). FIN-SI.
    SI ly>=4 && ly<24 && lx>=w-48 && lx<w-30 TUNC REDDE LF_MAX_TOGGLE(r,id). FIN-SI.
    SI ly>=0 && ly<28 && lx>=0 && lx<w-74 && CONTENTUM(n+56)==0 TUNC
        m[6]=id. m[7]=lx. m[8]=ly. REDDE 1.
    FIN-SI.
    REDDE foc.
FIN-FUNCTIO.

FUNCTIO LL_DRAG REDDENS NUMERUS.
    ACCIPIT r SICUT NUMERUS. ACCIPIT m SICUT ORDO DE NUMERUS.
    SI m[6]==0 TUNC REDDE 0. FIN-SI.
    REDDE LF_MOVE(r,m[6],m[0]-m[7],m[1]-m[8]).
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    SI LG_AD_EST()==0 TUNC REDDE 5. FIN-SI.
    DECLARA r SICUT NUMERUS VALENS LF_CREA(). SI r==0 TUNC REDDE 71. FIN-SI.
    DECLARA sw SICUT NUMERUS VALENS CONTENTUM(50333728). DECLARA sh SICUT NUMERUS VALENS CONTENTUM(50333736)-28.
    DECLARA p SICUT NUMERUS VALENS LF_ADDE(r,1,sw*5/100,sh*7/100,sw*58/100,sh*66/100).
    DECLARA t SICUT NUMERUS VALENS LF_ADDE(r,2,sw*48/100,sh*20/100,sw*43/100,sh*55/100).
    DECLARA l SICUT NUMERUS VALENS LF_ADDE(r,3,sw*21/100,sh*31/100,sw*48/100,sh*46/100).
    SI p==0 || t==0 || l==0 TUNC REDDE 71. FIN-SI.
    DECLARA m SICUT ORDO DE NUMERUS CAPACITAS 14.
    m[0]=sw/2. m[1]=sh/2. m[2]=0. m[5]=0. m[6]=0.
    DECLARA para SICUT NUMERUS VALENS LP_PARA(m).
    DECLARA f SICUT NUMERUS VALENS LL_REDDE(r,m).
    DECLARA finis SICUT NUMERUS VALENS 0.
    DUM finis==0 PERFICE
        DECLARA redde SICUT NUMERUS VALENS 0.
        DECLARA mutata SICUT NUMERUS VALENS LP_LEGE(m).
        SI mutata==1 TUNC
            SI (m[2]&1)!=0 && (m[5]&1)==0 TUNC DECLARA md SICUT NUMERUS VALENS LL_MOUSE_DOWN(r,m). redde=1. FIN-SI.
            SI (m[2]&1)!=0 && m[6]!=0 TUNC DECLARA dr SICUT NUMERUS VALENS LL_DRAG(r,m). redde=1. FIN-SI.
            SI (m[2]&1)==0 && (m[5]&1)!=0 TUNC m[6]=0. redde=1. FIN-SI.
            m[5]=m[2]. redde=1.
        FIN-SI.
        SI redde==1 TUNC f=LL_REDDE(r,m). FIN-SI.
        DECLARA pausa SICUT NUMERUS VALENS LI_STALL().
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.