    DECLARA pos SICUT NUMERUS VALENS 120.

    DECLARA loci_jne SICUT NUMERUS VALENS 0.
    DECLARA loci_jmp SICUT NUMERUS VALENS 0.

    pos = COMPONE_ONERA(exemplar, pos, 0, 5).
    pos = COMPONE_ONERA(exemplar, pos, 3, 7).
    pos = COMPONE_SUB(exemplar, pos, 0, 3).

    pos = COMPONE_JNE_FUTURUM(exemplar, pos, SEDES(loci_jne)).

    DECLARA pos_tunc SICUT NUMERUS VALENS pos.
    pos = COMPONE_ONERA(exemplar, pos, 7, 111).
    pos = COMPONE_JMP_FUTURUM(exemplar, pos, SEDES(loci_jmp)).

    DECLARA pos_aliter SICUT NUMERUS VALENS pos.
    pos = COMPONE_ONERA(exemplar, pos, 7, 222).

    DECLARA pos_fin SICUT NUMERUS VALENS pos.
    pos = COMPONE_ONERA(exemplar, pos, 0, 60).
    pos = COMPONE_VOCA_NUCLEUM(exemplar, pos).

    DECLARA ignoratum1 SICUT NUMERUS VALENS CORRIGE_SALTUM(exemplar, loci_jne, pos_aliter).
    DECLARA ignoratum2 SICUT NUMERUS VALENS CORRIGE_SALTUM(exemplar, loci_jmp, pos_fin).

    DECLARA fd SICUT NUMERUS VALENS APERI_SCRIBERE("factum_si").
    DECLARA scriptum SICUT NUMERUS VALENS MITTE(fd, exemplar, pos).
    CLAUDE(fd).
    PROCLAMA scriptum.

    REDDE 0.
FIN-FUNCTIO.
