    DECLARA pos SICUT NUMERUS VALENS 120.


    pos = COMPONE_ONERA(exemplar, pos, 7, 0).
    pos = COMPONE_ONERA(exemplar, pos, 3, 1).
    pos = COMPONE_ONERA(exemplar, pos, 1, 5).

    DECLARA initium_ansae_localis SICUT NUMERUS VALENS pos.
    pos = COMPONE_ADD(exemplar, pos, 7, 3).
    pos = COMPONE_SUB(exemplar, pos, 1, 3).
    pos = COMPONE_JNE(exemplar, pos, initium_ansae_localis).

    pos = COMPONE_ONERA(exemplar, pos, 0, 60).
    pos = COMPONE_VOCA_NUCLEUM(exemplar, pos).

    DECLARA fd SICUT NUMERUS VALENS APERI_SCRIBERE("factum_boucle").
    DECLARA scriptum SICUT NUMERUS VALENS MITTE(fd, exemplar, pos).
    CLAUDE(fd).
    PROCLAMA scriptum.

    REDDE 0.
FIN-FUNCTIO.
