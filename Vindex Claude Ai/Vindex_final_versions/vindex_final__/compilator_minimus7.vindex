// Bibliotheca componendi codicem machinalis x86-64, tota in VINDEX scripta.
// Continet omnes functiones ex prioribus experimentis collectas.

FUNCTIO SCRIBE_U16 REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    codex[indice] = valor & 255.
    codex[indice + 1] = (valor >> 8) & 255.
    REDDE indice + 2.
FIN-FUNCTIO.

FUNCTIO SCRIBE_U32 REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    codex[indice] = valor & 255.
    codex[indice + 1] = (valor >> 8) & 255.
    codex[indice + 2] = (valor >> 16) & 255.
    codex[indice + 3] = (valor >> 24) & 255.
    REDDE indice + 4.
FIN-FUNCTIO.

FUNCTIO SCRIBE_U64 REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    codex[indice] = valor & 255.
    codex[indice + 1] = (valor >> 8) & 255.
    codex[indice + 2] = (valor >> 16) & 255.
    codex[indice + 3] = (valor >> 24) & 255.
    codex[indice + 4] = (valor >> 32) & 255.
    codex[indice + 5] = (valor >> 40) & 255.
    codex[indice + 6] = (valor >> 48) & 255.
    codex[indice + 7] = (valor >> 56) & 255.
    REDDE indice + 8.
FIN-FUNCTIO.

FUNCTIO CONSTRUE_CAPUT_ELF REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT mensura_codicis SICUT NUMERUS.
    DECLARA basis SICUT NUMERUS VALENS 4194304.
    DECLARA ignoratum SICUT NUMERUS VALENS 0.

    codex[0] = 127.
    codex[1] = 69.
    codex[2] = 76.
    codex[3] = 70.
    codex[4] = 2.
    codex[5] = 1.
    codex[6] = 1.
    codex[7] = 0.

    ignoratum = SCRIBE_U16(codex, 16, 2).
    ignoratum = SCRIBE_U16(codex, 18, 62).
    ignoratum = SCRIBE_U32(codex, 20, 1).
    ignoratum = SCRIBE_U64(codex, 24, basis + 120).
    ignoratum = SCRIBE_U64(codex, 32, 64).
    ignoratum = SCRIBE_U64(codex, 40, 0).
    ignoratum = SCRIBE_U32(codex, 48, 0).
    ignoratum = SCRIBE_U16(codex, 52, 64).
    ignoratum = SCRIBE_U16(codex, 54, 56).
    ignoratum = SCRIBE_U16(codex, 56, 1).
    ignoratum = SCRIBE_U16(codex, 58, 0).
    ignoratum = SCRIBE_U16(codex, 60, 0).
    ignoratum = SCRIBE_U16(codex, 62, 0).

    ignoratum = SCRIBE_U32(codex, 64, 1).
    ignoratum = SCRIBE_U32(codex, 68, 7).
    ignoratum = SCRIBE_U64(codex, 72, 0).
    ignoratum = SCRIBE_U64(codex, 80, basis).
    ignoratum = SCRIBE_U64(codex, 88, basis).
    DECLARA mensura_totalis SICUT NUMERUS VALENS 120 + mensura_codicis.
    ignoratum = SCRIBE_U64(codex, 96, mensura_totalis).
    ignoratum = SCRIBE_U64(codex, 104, mensura_totalis).
    ignoratum = SCRIBE_U64(codex, 112, 4096).

    REDDE 120.
FIN-FUNCTIO.

FUNCTIO COMPONE_ONERA REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registre SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI registre >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 184 + (registre & 7).
    codex[indice + 2] = valor & 255.
    codex[indice + 3] = (valor >> 8) & 255.
    codex[indice + 4] = (valor >> 16) & 255.
    codex[indice + 5] = (valor >> 24) & 255.
    codex[indice + 6] = (valor >> 32) & 255.
    codex[indice + 7] = (valor >> 40) & 255.
    codex[indice + 8] = (valor >> 48) & 255.
    codex[indice + 9] = (valor >> 56) & 255.
    REDDE indice + 10.
FIN-FUNCTIO.

FUNCTIO COMPONE_ARITHMETICA REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT opcode SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI fons >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI destinatio >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = opcode.
    codex[indice + 2] = 192 + ((fons & 7) * 8) + (destinatio & 7).
    REDDE indice + 3.
FIN-FUNCTIO.

FUNCTIO COMPONE_ADD REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 1, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_SUB REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 41, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_CMP REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 57, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_MULTIPLICA REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI destinatio >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI fons >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 15.
    codex[indice + 2] = 175.
    codex[indice + 3] = 192 + ((destinatio & 7) * 8) + (fons & 7).
    REDDE indice + 4.
FIN-FUNCTIO.

FUNCTIO COMPONE_TRANSCRIBE REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI fons >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI destinatio >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 137.
    codex[indice + 2] = 192 + ((fons & 7) * 8) + (destinatio & 7).
    REDDE indice + 3.
FIN-FUNCTIO.

FUNCTIO COMPONE_SERVA_PILA REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT decalage SICUT NUMERUS.
    ACCIPIT registre SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI registre >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 137.
    codex[indice + 2] = 128 + ((registre & 7) * 8) + 5.
    codex[indice + 3] = decalage & 255.
    codex[indice + 4] = (decalage >> 8) & 255.
    codex[indice + 5] = (decalage >> 16) & 255.
    codex[indice + 6] = (decalage >> 24) & 255.
    REDDE indice + 7.
FIN-FUNCTIO.

FUNCTIO COMPONE_SUME_PILA REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registre SICUT NUMERUS.
    ACCIPIT decalage SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI registre >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 139.
    codex[indice + 2] = 128 + ((registre & 7) * 8) + 5.
    codex[indice + 3] = decalage & 255.
    codex[indice + 4] = (decalage >> 8) & 255.
    codex[indice + 5] = (decalage >> 16) & 255.
    codex[indice + 6] = (decalage >> 24) & 255.
    REDDE indice + 7.
FIN-FUNCTIO.

FUNCTIO COMPONE_JNE_RETRO REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    codex[indice] = 15.
    codex[indice + 1] = 133.
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (indice + 6).
    codex[indice + 2] = relatio & 255.
    codex[indice + 3] = (relatio >> 8) & 255.
    codex[indice + 4] = (relatio >> 16) & 255.
    codex[indice + 5] = (relatio >> 24) & 255.
    REDDE indice + 6.
FIN-FUNCTIO.

FUNCTIO COMPONE_JNE_FUTURUM REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT loci SICUT ACUS<NUMERUS>.
    codex[indice] = 15.
    codex[indice + 1] = 133.
    CONTENTUM(loci) = indice + 2.
    REDDE indice + 6.
FIN-FUNCTIO.

FUNCTIO COMPONE_JMP_FUTURUM REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT loci SICUT ACUS<NUMERUS>.
    codex[indice] = 233.
    CONTENTUM(loci) = indice + 1.
    REDDE indice + 5.
FIN-FUNCTIO.

FUNCTIO CORRIGE_SALTUM REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT loci SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (loci + 4).
    codex[loci] = relatio & 255.
    codex[loci + 1] = (relatio >> 8) & 255.
    codex[loci + 2] = (relatio >> 16) & 255.
    codex[loci + 3] = (relatio >> 24) & 255.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO COMPONE_IMPONE REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registre SICUT NUMERUS.
    DECLARA fin SICUT NUMERUS VALENS indice.
    SI registre >= 8 TUNC
        codex[fin] = 65.
        fin = fin + 1.
    FIN-SI.
    codex[fin] = 80 + (registre & 7).
    REDDE fin + 1.
FIN-FUNCTIO.

FUNCTIO COMPONE_AUFER REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registre SICUT NUMERUS.
    DECLARA fin SICUT NUMERUS VALENS indice.
    SI registre >= 8 TUNC
        codex[fin] = 65.
        fin = fin + 1.
    FIN-SI.
    codex[fin] = 88 + (registre & 7).
    REDDE fin + 1.
FIN-FUNCTIO.

FUNCTIO COMPONE_VOCA_FUTURUM REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT loci SICUT ACUS<NUMERUS>.
    codex[indice] = 232.
    CONTENTUM(loci) = indice + 1.
    REDDE indice + 5.
FIN-FUNCTIO.

FUNCTIO COMPONE_REVERTE REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    codex[indice] = 195.
    REDDE indice + 1.
FIN-FUNCTIO.

FUNCTIO COMPONE_VOCA_NUCLEUM REDDENS NUMERUS.
    ACCIPIT codex SICUT SERIES DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    codex[indice] = 15.
    codex[indice + 1] = 5.
    REDDE indice + 2.
FIN-FUNCTIO.


FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("proba7.vindex").
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 2000).
    CLAUDE(fd).

    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA nomen_a SICUT NUMERUS VALENS 0.
    DECLARA valor_a SICUT NUMERUS VALENS 0.
    DECLARA nomen_b SICUT NUMERUS VALENS 0.
    DECLARA valor_b SICUT NUMERUS VALENS 0.
    DECLARA numerus_variabilium SICUT NUMERUS VALENS 0.

    DUM i < n PERFICE
        DECLARA c SICUT NUMERUS VALENS OCTETUS(i).

        SI c == 68 && i + 6 < n && OCTETUS(i + 1) == 69 && OCTETUS(i + 2) == 67 && OCTETUS(i + 3) == 76 && OCTETUS(i + 4) == 65 && OCTETUS(i + 5) == 82 && OCTETUS(i + 6) == 65 TUNC
            i = i + 7.
            DUM i < n && OCTETUS(i) == 32 PERFICE
                i = i + 1.
            FIN-DUM.
            DECLARA nomen_lecta SICUT NUMERUS VALENS OCTETUS(i).
            DUM i < n && (OCTETUS(i) < 48 || OCTETUS(i) > 57) PERFICE
                i = i + 1.
            FIN-DUM.
            DECLARA valor_lecta SICUT NUMERUS VALENS 0.
            DUM i < n && OCTETUS(i) >= 48 && OCTETUS(i) <= 57 PERFICE
                valor_lecta = valor_lecta * 10 + (OCTETUS(i) - 48).
                i = i + 1.
            FIN-DUM.

            SI numerus_variabilium == 0 TUNC
                nomen_a = nomen_lecta.
                valor_a = valor_lecta.
            ALITER
                nomen_b = nomen_lecta.
                valor_b = valor_lecta.
            FIN-SI.
            numerus_variabilium = numerus_variabilium + 1.

        ALITER
            i = i + 1.
        FIN-SI.
    FIN-DUM.

    PROCLAMA valor_a.
    PROCLAMA valor_b.

    DECLARA codex SICUT SERIES DE NUMERUS CAPACITAS 220.
    DECLARA pos SICUT NUMERUS VALENS 120.

    pos = COMPONE_IMPONE(codex, pos, 5).
    pos = COMPONE_TRANSCRIBE(codex, pos, 5, 4).

    pos = COMPONE_ONERA(codex, pos, 0, valor_a).
    pos = COMPONE_SERVA_PILA(codex, pos, 0 - 8, 0).
    pos = COMPONE_ONERA(codex, pos, 0, valor_b).
    pos = COMPONE_SERVA_PILA(codex, pos, 0 - 16, 0).

    pos = COMPONE_SUME_PILA(codex, pos, 7, 0 - 8).
    pos = COMPONE_SUME_PILA(codex, pos, 3, 0 - 16).
    pos = COMPONE_ADD(codex, pos, 7, 3).

    pos = COMPONE_ONERA(codex, pos, 0, 60).
    pos = COMPONE_VOCA_NUCLEUM(codex, pos).

    DECLARA ignoratum SICUT NUMERUS VALENS CONSTRUE_CAPUT_ELF(codex, pos - 120).

    DECLARA fd_scriptio SICUT NUMERUS VALENS APERI_SCRIBERE("proba7_compilata").
    DECLARA scriptum SICUT NUMERUS VALENS MITTE(fd_scriptio, codex, pos).
    CLAUDE(fd_scriptio).

    REDDE 0.
FIN-FUNCTIO.
