FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("exemplum_lectoris5.vindex").
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 3000).
    CLAUDE(fd).

    DECLARA verbum SICUT SERIES DE LITTERA CAPACITAS 64.
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA numerus_verborum SICUT NUMERUS VALENS 0.
    DECLARA numerus_catenarum SICUT NUMERUS VALENS 0.

    DUM i < n PERFICE
        DECLARA c SICUT NUMERUS VALENS OCTETUS(i).

        SI (c >= 65 && c <= 90) || (c >= 97 && c <= 122) TUNC
            DECLARA mensura SICUT NUMERUS VALENS 0.
            DUM i < n && ((OCTETUS(i) >= 65 && OCTETUS(i) <= 90) || (OCTETUS(i) >= 97 && OCTETUS(i) <= 122) || (OCTETUS(i) == 45 && i + 1 < n && ((OCTETUS(i + 1) >= 65 && OCTETUS(i + 1) <= 90) || (OCTETUS(i + 1) >= 97 && OCTETUS(i + 1) <= 122)))) PERFICE
                verbum[mensura] = OCTETUS(i).
                mensura = mensura + 1.
                i = i + 1.
            FIN-DUM.
            numerus_verborum = numerus_verborum + 1.
            SI mensura == 7 && verbum[3] == 45 TUNC
                SCRIBE verbum CAPACITAS mensura.
            FIN-SI.
        ALITER
            SI c == 34 TUNC
                i = i + 1.
                DECLARA mensura SICUT NUMERUS VALENS 0.
                DUM i < n && OCTETUS(i) != 34 PERFICE
                    verbum[mensura] = OCTETUS(i).
                    mensura = mensura + 1.
                    i = i + 1.
                FIN-DUM.
                i = i + 1.
                numerus_catenarum = numerus_catenarum + 1.
                SCRIBE verbum CAPACITAS mensura.
            ALITER
                i = i + 1.
            FIN-SI.
        FIN-SI.
    FIN-DUM.

    PROCLAMA numerus_verborum.
    PROCLAMA numerus_catenarum.

    REDDE 0.
FIN-FUNCTIO.
