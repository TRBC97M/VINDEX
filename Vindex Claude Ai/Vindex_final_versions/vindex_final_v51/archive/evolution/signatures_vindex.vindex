FUNCTIO SIGNUM_VERBI REDDENS NUMERUS.
    ACCIPIT verbum SICUT ORDO DE LITTERA.
    ACCIPIT mensura SICUT NUMERUS.
    DECLARA signum SICUT NUMERUS VALENS 0.
    PER idx AB 0 AD mensura - 1 PERFICE
        signum = signum * 31 + verbum[idx].
    FIN-PER.
    REDDE signum.
FIN-FUNCTIO.

FUNCTIO DISCERNE_VERBUM_TABULA REDDENS NUMERUS.
    ACCIPIT tabula SICUT ORDO DE NUMERUS.
    ACCIPIT numerus_motorum SICUT NUMERUS.
    ACCIPIT verbum SICUT ORDO DE LITTERA.
    ACCIPIT mensura SICUT NUMERUS.
    DECLARA signum SICUT NUMERUS VALENS SIGNUM_VERBI(verbum, mensura).
    DECLARA idx SICUT NUMERUS VALENS 0.
    DUM idx < numerus_motorum PERFICE
        SI tabula[idx] == signum TUNC
            REDDE idx + 1.
        FIN-SI.
        idx = idx + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO EST_APERIENS REDDENS NUMERUS.
    ACCIPIT typus SICUT NUMERUS.
    SI typus == 1 || typus == 5 || typus == 9 || typus == 12 || typus == 29 TUNC
        REDDE 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO EST_CLAUDENS REDDENS NUMERUS.
    ACCIPIT typus SICUT NUMERUS.
    SI typus == 2 || typus == 8 || typus == 11 || typus == 15 || typus == 30 TUNC
        REDDE 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO APERIENS_EXPECTATUM REDDENS NUMERUS.
    ACCIPIT typus_claudens SICUT NUMERUS.
    SI typus_claudens == 2 TUNC
        REDDE 1.
    FIN-SI.
    SI typus_claudens == 8 TUNC
        REDDE 5.
    FIN-SI.
    SI typus_claudens == 11 TUNC
        REDDE 9.
    FIN-SI.
    SI typus_claudens == 15 TUNC
        REDDE 12.
    FIN-SI.
    SI typus_claudens == 30 TUNC
        REDDE 29.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO EST_FOLIUM REDDENS NUMERUS.
    ACCIPIT typus SICUT NUMERUS.
    SI typus == 3 || typus == 4 || typus == 16 || typus == 17 || typus == 18 || typus == 19 || typus == 20 || typus == 21 || typus == 25 || typus == 26 || typus == 31 TUNC
        REDDE 1.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA tabula_signa SICUT ORDO DE NUMERUS CAPACITAS 31.
    tabula_signa[0] = 64632849206.
    tabula_signa[1] = 59371900707789652.
    tabula_signa[2] = 62389866822.
    tabula_signa[3] = 59670022259.
    tabula_signa[4] = 2646.
    tabula_signa[5] = 2586614.
    tabula_signa[6] = 1933340099.
    tabula_signa[7] = 2073827192.
    tabula_signa[8] = 68060.
    tabula_signa[9] = 73053592290.
    tabula_signa[10] = 64288628986.
    tabula_signa[11] = 79101.
    tabula_signa[12] = 2081.
    tabula_signa[13] = 2083.
    tabula_signa[14] = 64288640027.
    tabula_signa[15] = 77851826.
    tabula_signa[16] = 2013050510.
    tabula_signa[17] = 76018331.
    tabula_signa[18] = 2276110338591.
    tabula_signa[19] = 2440610570.
    tabula_signa[20] = 1990360990.
    tabula_signa[21] = 2332695.
    tabula_signa[22] = 73369257.
    tabula_signa[23] = 74829502616.
    tabula_signa[24] = 2245267631.
    tabula_signa[25] = 1915770229667.
    tabula_signa[26] = 78775392.
    tabula_signa[27] = 59388892289201.
    tabula_signa[28] = 67081213.
    tabula_signa[29] = 61781374131099.
    tabula_signa[30] = 1980555487.

    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("signatures_vindex.vindex").
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 12000).
    CLAUDE(fd).

    DECLARA verbum SICUT ORDO DE LITTERA CAPACITAS 64.
    DECLARA acervus SICUT ORDO DE NUMERUS CAPACITAS 256.
    DECLARA summitas SICUT NUMERUS VALENS 0.
    DECLARA i SICUT NUMERUS VALENS 0.

    DECLARA nodi_typus SICUT ORDO DE NUMERUS CAPACITAS 1000.
    DECLARA nodi_parens SICUT ORDO DE NUMERUS CAPACITAS 1000.
    DECLARA nodi_signum SICUT ORDO DE NUMERUS CAPACITAS 1000.
    DECLARA numerus_nodorum SICUT NUMERUS VALENS 0.
    DECLARA attende_nomen SICUT NUMERUS VALENS 0.
    DECLARA nodus_attente SICUT NUMERUS VALENS 0.
    DECLARA erratum SICUT NUMERUS VALENS 0.

    DUM i < n PERFICE
        DECLARA c SICUT NUMERUS VALENS OCTETUS(i).

        SI (c >= 65 && c <= 90) || (c >= 97 && c <= 122) TUNC
            DECLARA mensura SICUT NUMERUS VALENS 0.
            DUM i < n && ((OCTETUS(i) >= 65 && OCTETUS(i) <= 90) || (OCTETUS(i) >= 97 && OCTETUS(i) <= 122) || (OCTETUS(i) == 95) || (OCTETUS(i) == 45 && i + 1 < n && ((OCTETUS(i + 1) >= 65 && OCTETUS(i + 1) <= 90) || (OCTETUS(i + 1) >= 97 && OCTETUS(i + 1) <= 122)))) PERFICE
                verbum[mensura] = OCTETUS(i).
                mensura = mensura + 1.
                i = i + 1.
            FIN-DUM.

            DECLARA typus SICUT NUMERUS VALENS 0.

            SI attende_nomen == 1 TUNC
                nodi_signum[nodus_attente] = SIGNUM_VERBI(verbum, mensura).
                attende_nomen = 0.
            ALITER
                typus = DISCERNE_VERBUM_TABULA(tabula_signa, 31, verbum, mensura).

                SI EST_APERIENS(typus) == 1 TUNC
                    DECLARA parens SICUT NUMERUS VALENS 0.
                    parens = 0 - 1.
                    SI summitas > 0 TUNC
                        parens = acervus[summitas - 1].
                    FIN-SI.
                    nodi_typus[numerus_nodorum] = typus.
                    nodi_parens[numerus_nodorum] = parens.
                    acervus[summitas] = numerus_nodorum.
                    summitas = summitas + 1.

                    SI typus == 1 TUNC
                        attende_nomen = 1.
                        nodus_attente = numerus_nodorum.
                    FIN-SI.

                    numerus_nodorum = numerus_nodorum + 1.
                FIN-SI.

                SI EST_CLAUDENS(typus) == 1 TUNC
                    SI summitas == 0 TUNC
                        erratum = 1.
                    ALITER
                        summitas = summitas - 1.
                        DECLARA apex_localis SICUT NUMERUS VALENS acervus[summitas].
                        SI nodi_typus[apex_localis] != APERIENS_EXPECTATUM(typus) TUNC
                            erratum = 1.
                        FIN-SI.
                    FIN-SI.
                FIN-SI.

                SI EST_FOLIUM(typus) == 1 TUNC
                    DECLARA parens_feuille SICUT NUMERUS VALENS 0.
                    parens_feuille = 0 - 1.
                    SI summitas > 0 TUNC
                        parens_feuille = acervus[summitas - 1].
                    FIN-SI.
                    nodi_typus[numerus_nodorum] = typus.
                    nodi_parens[numerus_nodorum] = parens_feuille.

                    SI typus == 3 || typus == 4 TUNC
                        attende_nomen = 1.
                        nodus_attente = numerus_nodorum.
                    FIN-SI.

                    numerus_nodorum = numerus_nodorum + 1.
                FIN-SI.
            FIN-SI.
        ALITER
            i = i + 1.
        FIN-SI.
    FIN-DUM.

    PROCLAMA numerus_nodorum.
    SI erratum == 1 TUNC
        PROCLAMA "ERRATUM: structura corrupta".
    ALITER
        SI summitas != 0 TUNC
            PROCLAMA "ERRATUM: partes non clausae".
        ALITER
            PROCLAMA "RECTE: structura valida".
        FIN-SI.
    FIN-SI.

    DECLARA numerus_functiones SICUT NUMERUS VALENS 0.
    DECLARA numerus_formae SICUT NUMERUS VALENS 0.
    DECLARA numerus_per SICUT NUMERUS VALENS 0.
    DECLARA j SICUT NUMERUS VALENS 0.
    DUM j < numerus_nodorum PERFICE
        SI nodi_typus[j] == 1 TUNC
            numerus_functiones = numerus_functiones + 1.
        FIN-SI.
        SI nodi_typus[j] == 29 TUNC
            numerus_formae = numerus_formae + 1.
        FIN-SI.
        SI nodi_typus[j] == 12 TUNC
            numerus_per = numerus_per + 1.
        FIN-SI.
        j = j + 1.
    FIN-DUM.
    PROCLAMA numerus_functiones.
    PROCLAMA numerus_formae.
    PROCLAMA numerus_per.

    DECLARA nomen_quaesitum SICUT ORDO DE LITTERA CAPACITAS 16.
    nomen_quaesitum[0] = 83.
    nomen_quaesitum[1] = 73.
    nomen_quaesitum[2] = 71.
    nomen_quaesitum[3] = 78.
    nomen_quaesitum[4] = 85.
    nomen_quaesitum[5] = 77.
    nomen_quaesitum[6] = 95.
    nomen_quaesitum[7] = 86.
    nomen_quaesitum[8] = 69.
    nomen_quaesitum[9] = 82.
    nomen_quaesitum[10] = 66.
    nomen_quaesitum[11] = 73.
    DECLARA signum_quaesitum SICUT NUMERUS VALENS SIGNUM_VERBI(nomen_quaesitum, 12).

    DECLARA nodus_functionis SICUT NUMERUS VALENS 0 - 1.
    DECLARA m SICUT NUMERUS VALENS 0.
    DUM m < numerus_nodorum PERFICE
        SI nodi_typus[m] == 1 && nodi_signum[m] == signum_quaesitum TUNC
            nodus_functionis = m.
        FIN-SI.
        m = m + 1.
    FIN-DUM.

    DECLARA numerus_parametrorum SICUT NUMERUS VALENS 0.
    DECLARA p SICUT NUMERUS VALENS 0.
    DUM p < numerus_nodorum PERFICE
        SI nodi_typus[p] == 4 && nodi_parens[p] == nodus_functionis TUNC
            numerus_parametrorum = numerus_parametrorum + 1.
        FIN-SI.
        p = p + 1.
    FIN-DUM.

    PROCLAMA nodus_functionis.
    PROCLAMA numerus_parametrorum.

    REDDE 0.
FIN-FUNCTIO.
