FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("lector_vindex.vindex").
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 4000).
    CLAUDE(fd).

    DECLARA verbum SICUT ORDO DE LITTERA CAPACITAS 64.
    DECLARA typi_signorum SICUT ORDO DE NUMERUS CAPACITAS 500.
    DECLARA numerus_signorum SICUT NUMERUS VALENS 0.
    DECLARA i SICUT NUMERUS VALENS 0.

    DUM i < n PERFICE
        DECLARA c SICUT NUMERUS VALENS OCTETUS(i).

        SI (c >= 65 && c <= 90) || (c >= 97 && c <= 122) TUNC
            DECLARA mensura SICUT NUMERUS VALENS 0.
            DUM i < n && ((OCTETUS(i) >= 65 && OCTETUS(i) <= 90) || (OCTETUS(i) >= 97 && OCTETUS(i) <= 122) || (OCTETUS(i) == 45 && i + 1 < n && ((OCTETUS(i + 1) >= 65 && OCTETUS(i + 1) <= 90) || (OCTETUS(i + 1) >= 97 && OCTETUS(i + 1) <= 122)))) PERFICE
                verbum[mensura] = OCTETUS(i).
                mensura = mensura + 1.
                i = i + 1.
            FIN-DUM.

            DECLARA typus SICUT NUMERUS VALENS 0.
            SI mensura == 7 && verbum[0] == 70 && verbum[1] == 85 && verbum[2] == 78 && verbum[3] == 67 && verbum[4] == 84 && verbum[5] == 73 && verbum[6] == 79 TUNC
                typus = 1.
            FIN-SI.
            SI mensura == 7 && verbum[0] == 68 && verbum[1] == 69 && verbum[2] == 67 && verbum[3] == 76 && verbum[4] == 65 && verbum[5] == 82 && verbum[6] == 65 TUNC
                typus = 2.
            FIN-SI.
            SI mensura == 2 && verbum[0] == 83 && verbum[1] == 73 TUNC
                typus = 3.
            FIN-SI.
            SI mensura == 5 && verbum[0] == 82 && verbum[1] == 69 && verbum[2] == 68 && verbum[3] == 68 && verbum[4] == 69 TUNC
                typus = 4.
            FIN-SI.

            typi_signorum[numerus_signorum] = typus.
            numerus_signorum = numerus_signorum + 1.
        ALITER
            SI c >= 48 && c <= 57 TUNC
                DUM i < n && OCTETUS(i) >= 48 && OCTETUS(i) <= 57 PERFICE
                    i = i + 1.
                FIN-DUM.
                typi_signorum[numerus_signorum] = 10.
                numerus_signorum = numerus_signorum + 1.
            ALITER
                SI c == 34 TUNC
                    i = i + 1.
                    DUM i < n && OCTETUS(i) != 34 PERFICE
                        i = i + 1.
                    FIN-DUM.
                    i = i + 1.
                    typi_signorum[numerus_signorum] = 11.
                    numerus_signorum = numerus_signorum + 1.
                ALITER
                    i = i + 1.
                FIN-SI.
            FIN-SI.
        FIN-SI.
    FIN-DUM.

    PROCLAMA numerus_signorum.

    DECLARA numerus_functionum SICUT NUMERUS VALENS 0.
    DECLARA numerus_declarationum SICUT NUMERUS VALENS 0.
    DECLARA numerus_numerorum SICUT NUMERUS VALENS 0.
    DECLARA j SICUT NUMERUS VALENS 0.
    DUM j < numerus_signorum PERFICE
        SI typi_signorum[j] == 1 TUNC
            numerus_functionum = numerus_functionum + 1.
        FIN-SI.
        SI typi_signorum[j] == 2 TUNC
            numerus_declarationum = numerus_declarationum + 1.
        FIN-SI.
        SI typi_signorum[j] == 10 TUNC
            numerus_numerorum = numerus_numerorum + 1.
        FIN-SI.
        j = j + 1.
    FIN-DUM.

    PROCLAMA numerus_functionum.
    PROCLAMA numerus_declarationum.
    PROCLAMA numerus_numerorum.

    REDDE 0.
FIN-FUNCTIO.
