FUNCTIO SIGNUM_VERBI REDDENS NUMERUS.
    ACCIPIT verbum SICUT ORDO DE LITTERA.
    ACCIPIT mensura SICUT NUMERUS.
    DECLARA signum SICUT NUMERUS VALENS 0.
    PER idx AB 0 AD mensura - 1 PERFICE
        signum = signum * 31 + verbum[idx].
    FIN-PER.
    REDDE signum.
FIN-FUNCTIO.

FUNCTIO DISCERNE_VERBUM_TABULA REDDENS NUMERUS.
    ACCIPIT tabula SICUT ORDO DE NUMERUS.
    ACCIPIT numerus_motorum SICUT NUMERUS.
    ACCIPIT verbum SICUT ORDO DE LITTERA.
    ACCIPIT mensura SICUT NUMERUS.
    DECLARA signum SICUT NUMERUS VALENS SIGNUM_VERBI(verbum, mensura).
    DECLARA idx SICUT NUMERUS VALENS 0.
    DUM idx < numerus_motorum PERFICE
        SI tabula[idx] == signum TUNC
            REDDE idx + 1.
        FIN-SI.
        idx = idx + 1.
    FIN-DUM.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA tabula_signa SICUT ORDO DE NUMERUS CAPACITAS 31.
    tabula_signa[0] = 64632849206.
    tabula_signa[1] = 59371900707789652.
    tabula_signa[2] = 62389866822.
    tabula_signa[3] = 59670022259.
    tabula_signa[4] = 2646.
    tabula_signa[5] = 2586614.
    tabula_signa[6] = 1933340099.
    tabula_signa[7] = 2073827192.
    tabula_signa[8] = 68060.
    tabula_signa[9] = 73053592290.
    tabula_signa[10] = 64288628986.
    tabula_signa[11] = 79101.
    tabula_signa[12] = 2081.
    tabula_signa[13] = 2083.
    tabula_signa[14] = 64288640027.
    tabula_signa[15] = 77851826.
    tabula_signa[16] = 2013050510.
    tabula_signa[17] = 76018331.
    tabula_signa[18] = 2276110338591.
    tabula_signa[19] = 2440610570.
    tabula_signa[20] = 1990360990.
    tabula_signa[21] = 2332695.
    tabula_signa[22] = 73369257.
    tabula_signa[23] = 74829502616.
    tabula_signa[24] = 2245267631.
    tabula_signa[25] = 1915770229667.
    tabula_signa[26] = 78775392.
    tabula_signa[27] = 59388892289201.
    tabula_signa[28] = 67081213.
    tabula_signa[29] = 61781374131099.
    tabula_signa[30] = 1980555487.

    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("lector_finalis.vindex").
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 8000).
    CLAUDE(fd).

    DECLARA verbum SICUT ORDO DE LITTERA CAPACITAS 64.
    DECLARA signorum_typus SICUT ORDO DE NUMERUS CAPACITAS 1000.
    DECLARA signorum_valor SICUT ORDO DE NUMERUS CAPACITAS 1000.
    DECLARA numerus_tokenorum SICUT NUMERUS VALENS 0.
    DECLARA i SICUT NUMERUS VALENS 0.

    DUM i < n PERFICE
        DECLARA c SICUT NUMERUS VALENS OCTETUS(i).

        SI (c >= 65 && c <= 90) || (c >= 97 && c <= 122) TUNC
            DECLARA mensura SICUT NUMERUS VALENS 0.
            DUM i < n && ((OCTETUS(i) >= 65 && OCTETUS(i) <= 90) || (OCTETUS(i) >= 97 && OCTETUS(i) <= 122) || (OCTETUS(i) == 95) || (OCTETUS(i) == 45 && i + 1 < n && ((OCTETUS(i + 1) >= 65 && OCTETUS(i + 1) <= 90) || (OCTETUS(i + 1) >= 97 && OCTETUS(i + 1) <= 122)))) PERFICE
                verbum[mensura] = OCTETUS(i).
                mensura = mensura + 1.
                i = i + 1.
            FIN-DUM.

            DECLARA typus_verbi SICUT NUMERUS VALENS DISCERNE_VERBUM_TABULA(tabula_signa, 31, verbum, mensura).
            SI typus_verbi > 0 TUNC
                signorum_typus[numerus_tokenorum] = typus_verbi.
                signorum_valor[numerus_tokenorum] = 0.
            ALITER
                signorum_typus[numerus_tokenorum] = 100.
                signorum_valor[numerus_tokenorum] = SIGNUM_VERBI(verbum, mensura).
            FIN-SI.
            numerus_tokenorum = numerus_tokenorum + 1.

        ALITER
            SI c >= 48 && c <= 57 TUNC
                DECLARA valor_numeri SICUT NUMERUS VALENS 0.
                DUM i < n && OCTETUS(i) >= 48 && OCTETUS(i) <= 57 PERFICE
                    valor_numeri = valor_numeri * 10 + (OCTETUS(i) - 48).
                    i = i + 1.
                FIN-DUM.
                signorum_typus[numerus_tokenorum] = 101.
                signorum_valor[numerus_tokenorum] = valor_numeri.
                numerus_tokenorum = numerus_tokenorum + 1.
            ALITER
                SI c == 34 TUNC
                    i = i + 1.
                    DUM i < n && OCTETUS(i) != 34 PERFICE
                        i = i + 1.
                    FIN-DUM.
                    i = i + 1.
                    signorum_typus[numerus_tokenorum] = 102.
                    signorum_valor[numerus_tokenorum] = 0.
                    numerus_tokenorum = numerus_tokenorum + 1.
                ALITER
                    i = i + 1.
                FIN-SI.
            FIN-SI.
        FIN-SI.
    FIN-DUM.

    PROCLAMA numerus_tokenorum.

    DECLARA numerus_clavium_verbi SICUT NUMERUS VALENS 0.
    DECLARA numerus_identificatorum SICUT NUMERUS VALENS 0.
    DECLARA numerus_numerorum SICUT NUMERUS VALENS 0.
    DECLARA numerus_catenarum SICUT NUMERUS VALENS 0.
    DECLARA j SICUT NUMERUS VALENS 0.
    DUM j < numerus_tokenorum PERFICE
        SI signorum_typus[j] >= 1 && signorum_typus[j] <= 31 TUNC
            numerus_clavium_verbi = numerus_clavium_verbi + 1.
        FIN-SI.
        SI signorum_typus[j] == 100 TUNC
            numerus_identificatorum = numerus_identificatorum + 1.
        FIN-SI.
        SI signorum_typus[j] == 101 TUNC
            numerus_numerorum = numerus_numerorum + 1.
        FIN-SI.
        SI signorum_typus[j] == 102 TUNC
            numerus_catenarum = numerus_catenarum + 1.
        FIN-SI.
        j = j + 1.
    FIN-DUM.

    PROCLAMA numerus_clavium_verbi.
    PROCLAMA numerus_identificatorum.
    PROCLAMA numerus_numerorum.
    PROCLAMA numerus_catenarum.

    REDDE 0.
FIN-FUNCTIO.
