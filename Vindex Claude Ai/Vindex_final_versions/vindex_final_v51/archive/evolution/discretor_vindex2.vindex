FUNCTIO DISCERNE_VERBUM REDDENS NUMERUS.
    ACCIPIT verbum SICUT ORDO DE LITTERA.
    ACCIPIT mensura SICUT NUMERUS.

    SI mensura == 7 && verbum[0] == 70 && verbum[1] == 85 && verbum[2] == 78 && verbum[3] == 67 && verbum[4] == 84 && verbum[5] == 73 && verbum[6] == 79 TUNC
        REDDE 1.
    FIN-SI.
    SI mensura == 11 && verbum[0] == 70 && verbum[1] == 73 && verbum[2] == 78 && verbum[3] == 45 && verbum[4] == 70 && verbum[5] == 85 && verbum[6] == 78 && verbum[7] == 67 && verbum[8] == 84 && verbum[9] == 73 && verbum[10] == 79 TUNC
        REDDE 5.
    FIN-SI.
    SI mensura == 2 && verbum[0] == 83 && verbum[1] == 73 TUNC
        REDDE 3.
    FIN-SI.
    SI mensura == 6 && verbum[0] == 70 && verbum[1] == 73 && verbum[2] == 78 && verbum[3] == 45 && verbum[4] == 83 && verbum[5] == 73 TUNC
        REDDE 6.
    FIN-SI.
    SI mensura == 3 && verbum[0] == 68 && verbum[1] == 85 && verbum[2] == 77 TUNC
        REDDE 7.
    FIN-SI.
    SI mensura == 7 && verbum[0] == 70 && verbum[1] == 73 && verbum[2] == 78 && verbum[3] == 45 && verbum[4] == 68 && verbum[5] == 85 && verbum[6] == 77 TUNC
        REDDE 8.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("discretor_vindex2.vindex").
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 4000).
    CLAUDE(fd).

    DECLARA verbum SICUT ORDO DE LITTERA CAPACITAS 64.
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA profunditas_functio SICUT NUMERUS VALENS 0.
    DECLARA profunditas_si SICUT NUMERUS VALENS 0.
    DECLARA profunditas_dum SICUT NUMERUS VALENS 0.

    DUM i < n PERFICE
        DECLARA c SICUT NUMERUS VALENS OCTETUS(i).
        SI (c >= 65 && c <= 90) || (c >= 97 && c <= 122) TUNC
            DECLARA mensura SICUT NUMERUS VALENS 0.
            DUM i < n && ((OCTETUS(i) >= 65 && OCTETUS(i) <= 90) || (OCTETUS(i) >= 97 && OCTETUS(i) <= 122) || (OCTETUS(i) == 45 && i + 1 < n && ((OCTETUS(i + 1) >= 65 && OCTETUS(i + 1) <= 90) || (OCTETUS(i + 1) >= 97 && OCTETUS(i + 1) <= 122)))) PERFICE
                verbum[mensura] = OCTETUS(i).
                mensura = mensura + 1.
                i = i + 1.
            FIN-DUM.

            DECLARA typus SICUT NUMERUS VALENS DISCERNE_VERBUM(verbum, mensura).
            SI typus == 1 TUNC
                profunditas_functio = profunditas_functio + 1.
            FIN-SI.
            SI typus == 5 TUNC
                profunditas_functio = profunditas_functio - 1.
            FIN-SI.
            SI typus == 3 TUNC
                profunditas_si = profunditas_si + 1.
            FIN-SI.
            SI typus == 6 TUNC
                profunditas_si = profunditas_si - 1.
            FIN-SI.
            SI typus == 7 TUNC
                profunditas_dum = profunditas_dum + 1.
            FIN-SI.
            SI typus == 8 TUNC
                profunditas_dum = profunditas_dum - 1.
            FIN-SI.
        ALITER
            i = i + 1.
        FIN-SI.
    FIN-DUM.

    PROCLAMA profunditas_functio.
    PROCLAMA profunditas_si.
    PROCLAMA profunditas_dum.

    REDDE 0.
FIN-FUNCTIO.
