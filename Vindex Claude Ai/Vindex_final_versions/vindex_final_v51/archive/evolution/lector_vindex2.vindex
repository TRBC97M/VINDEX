FUNCTIO DISCERNE_VERBUM REDDENS NUMERUS.
    ACCIPIT verbum SICUT ORDO DE LITTERA.
    ACCIPIT mensura SICUT NUMERUS.

    SI mensura == 7 && verbum[0] == 70 && verbum[1] == 85 && verbum[2] == 78 && verbum[3] == 67 && verbum[4] == 84 && verbum[5] == 73 && verbum[6] == 79 TUNC
        REDDE 1.
    FIN-SI.
    SI mensura == 7 && verbum[0] == 68 && verbum[1] == 69 && verbum[2] == 67 && verbum[3] == 76 && verbum[4] == 65 && verbum[5] == 82 && verbum[6] == 65 TUNC
        REDDE 2.
    FIN-SI.
    SI mensura == 2 && verbum[0] == 83 && verbum[1] == 73 TUNC
        REDDE 3.
    FIN-SI.
    SI mensura == 5 && verbum[0] == 82 && verbum[1] == 69 && verbum[2] == 68 && verbum[3] == 68 && verbum[4] == 69 TUNC
        REDDE 4.
    FIN-SI.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("lector_vindex2.vindex").
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 4000).
    CLAUDE(fd).

    DECLARA verbum SICUT ORDO DE LITTERA CAPACITAS 64.
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA numerus_functionum SICUT NUMERUS VALENS 0.
    DECLARA numerus_declarationum SICUT NUMERUS VALENS 0.
    DECLARA numerus_conditionum SICUT NUMERUS VALENS 0.
    DECLARA numerus_redditionum SICUT NUMERUS VALENS 0.

    DUM i < n PERFICE
        DECLARA c SICUT NUMERUS VALENS OCTETUS(i).
        SI (c >= 65 && c <= 90) || (c >= 97 && c <= 122) TUNC
            DECLARA mensura SICUT NUMERUS VALENS 0.
            DUM i < n && ((OCTETUS(i) >= 65 && OCTETUS(i) <= 90) || (OCTETUS(i) >= 97 && OCTETUS(i) <= 122)) PERFICE
                verbum[mensura] = OCTETUS(i).
                mensura = mensura + 1.
                i = i + 1.
            FIN-DUM.

            DECLARA typus SICUT NUMERUS VALENS DISCERNE_VERBUM(verbum, mensura).
            SI typus == 1 TUNC
                numerus_functionum = numerus_functionum + 1.
            FIN-SI.
            SI typus == 2 TUNC
                numerus_declarationum = numerus_declarationum + 1.
            FIN-SI.
            SI typus == 3 TUNC
                numerus_conditionum = numerus_conditionum + 1.
            FIN-SI.
            SI typus == 4 TUNC
                numerus_redditionum = numerus_redditionum + 1.
            FIN-SI.
        ALITER
            i = i + 1.
        FIN-SI.
    FIN-DUM.

    PROCLAMA numerus_functionum.
    PROCLAMA numerus_declarationum.
    PROCLAMA numerus_conditionum.
    PROCLAMA numerus_redditionum.

    REDDE 0.
FIN-FUNCTIO.
