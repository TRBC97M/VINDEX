    codex[51] = 0.
    codex[52] = 64.
    codex[53] = 0.
    codex[54] = 56.
    codex[55] = 0.
    codex[56] = 1.
    codex[57] = 0.
    codex[58] = 0.
    codex[59] = 0.
    codex[60] = 0.
    codex[61] = 0.
    codex[62] = 0.
    codex[63] = 0.
    codex[64] = 1.
    codex[65] = 0.
    codex[66] = 0.
    codex[67] = 0.
    codex[68] = 7.
    codex[69] = 0.
