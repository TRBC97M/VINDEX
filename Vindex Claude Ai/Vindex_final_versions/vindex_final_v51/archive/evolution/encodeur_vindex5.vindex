FUNCTIO COMPONE_ONERA REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT registrum SICUT NUMERUS.
    ACCIPIT valor SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI registrum >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = 184 + (registrum & 7).
    codex[indice + 2] = valor & 255.
    codex[indice + 3] = (valor >> 8) & 255.
    codex[indice + 4] = (valor >> 16) & 255.
    codex[indice + 5] = (valor >> 24) & 255.
    codex[indice + 6] = (valor >> 32) & 255.
    codex[indice + 7] = (valor >> 40) & 255.
    codex[indice + 8] = (valor >> 48) & 255.
    codex[indice + 9] = (valor >> 56) & 255.
    REDDE indice + 10.
FIN-FUNCTIO.

FUNCTIO COMPONE_ARITHMETICA REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT opcode SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    DECLARA rex SICUT NUMERUS VALENS 72.
    SI fons >= 8 TUNC
        rex = rex | 4.
    FIN-SI.
    SI destinatio >= 8 TUNC
        rex = rex | 1.
    FIN-SI.
    codex[indice] = rex.
    codex[indice + 1] = opcode.
    codex[indice + 2] = 192 + ((fons & 7) * 8) + (destinatio & 7).
    REDDE indice + 3.
FIN-FUNCTIO.

FUNCTIO COMPONE_ADD REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 1, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_SUB REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    ACCIPIT fons SICUT NUMERUS.
    REDDE COMPONE_ARITHMETICA(codex, indice, 41, destinatio, fons).
FIN-FUNCTIO.

FUNCTIO COMPONE_JNE_RETRO REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    codex[indice] = 15.
    codex[indice + 1] = 133.
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (indice + 6).
    codex[indice + 2] = relatio & 255.
    codex[indice + 3] = (relatio >> 8) & 255.
    codex[indice + 4] = (relatio >> 16) & 255.
    codex[indice + 5] = (relatio >> 24) & 255.
    REDDE indice + 6.
FIN-FUNCTIO.

FUNCTIO COMPONE_JNE_FUTURUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT loci SICUT ACUS<NUMERUS>.
    codex[indice] = 15.
    codex[indice + 1] = 133.
    CONTENTUM(loci) = indice + 2.
    REDDE indice + 6.
FIN-FUNCTIO.

FUNCTIO COMPONE_JMP_FUTURUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    ACCIPIT loci SICUT ACUS<NUMERUS>.
    codex[indice] = 233.
    CONTENTUM(loci) = indice + 1.
    REDDE indice + 5.
FIN-FUNCTIO.

FUNCTIO CORRIGE_SALTUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT loci SICUT NUMERUS.
    ACCIPIT destinatio SICUT NUMERUS.
    DECLARA relatio SICUT NUMERUS VALENS destinatio - (loci + 4).
    codex[loci] = relatio & 255.
    codex[loci + 1] = (relatio >> 8) & 255.
    codex[loci + 2] = (relatio >> 16) & 255.
    codex[loci + 3] = (relatio >> 24) & 255.
    REDDE 0.
FIN-FUNCTIO.

FUNCTIO COMPONE_VOCA_NUCLEUM REDDENS NUMERUS.
    ACCIPIT codex SICUT ORDO DE NUMERUS.
    ACCIPIT indice SICUT NUMERUS.
    codex[indice] = 15.
    codex[indice + 1] = 5.
    REDDE indice + 2.
FIN-FUNCTIO.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA codex SICUT ORDO DE NUMERUS CAPACITAS 220.
    codex[0] = 127.
    codex[1] = 69.
    codex[2] = 76.
    codex[3] = 70.
    codex[4] = 2.
    codex[5] = 1.
    codex[6] = 1.
    codex[7] = 0.
