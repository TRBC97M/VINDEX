    codex[110] = 0.
    codex[111] = 0.
    codex[112] = 0.
    codex[113] = 16.
    codex[114] = 0.
    codex[115] = 0.
    codex[116] = 0.
    codex[117] = 0.
    codex[118] = 0.
    codex[119] = 0.

    DECLARA pos SICUT NUMERUS VALENS 120.
    DECLARA loci_jne1 SICUT NUMERUS VALENS 0.
    DECLARA loci_jmp1 SICUT NUMERUS VALENS 0.

    pos = COMPONE_ONERA(codex, pos, 7, 0).
    pos = COMPONE_ONERA(codex, pos, 1, 10).
    pos = COMPONE_ONERA(codex, pos, 6, 1).
    pos = COMPONE_ONERA(codex, pos, 3, 1).

    DECLARA initium_ansae_localis SICUT NUMERUS VALENS pos.

    pos = COMPONE_ONERA(codex, pos, 0, 5).
    pos = COMPONE_SUB(codex, pos, 0, 6).
    pos = COMPONE_JNE_FUTURUM(codex, pos, SEDES(loci_jne1)).
    pos = COMPONE_JMP_FUTURUM(codex, pos, SEDES(loci_jmp1)).

    DECLARA pos_additus SICUT NUMERUS VALENS pos.
    pos = COMPONE_ADD(codex, pos, 7, 6).

    DECLARA pos_post_si SICUT NUMERUS VALENS pos.
    pos = COMPONE_ADD(codex, pos, 6, 3).
    pos = COMPONE_SUB(codex, pos, 1, 3).
    pos = COMPONE_JNE_RETRO(codex, pos, initium_ansae_localis).

    pos = COMPONE_ONERA(codex, pos, 0, 60).
    pos = COMPONE_VOCA_NUCLEUM(codex, pos).

    DECLARA ignoratum1 SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_jne1, pos_additus).
    DECLARA ignoratum2 SICUT NUMERUS VALENS CORRIGE_SALTUM(codex, loci_jmp1, pos_post_si).

    DECLARA fd SICUT NUMERUS VALENS APERI_SCRIBERE("factum_somme").
    DECLARA scriptum SICUT NUMERUS VALENS MITTE(fd, codex, pos).
    CLAUDE(fd).

    PROCLAMA pos.

    REDDE 0.
FIN-FUNCTIO.
