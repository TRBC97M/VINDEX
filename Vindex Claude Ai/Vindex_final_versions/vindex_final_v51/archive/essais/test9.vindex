FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA textus SICUT ORDO DE LITTERA CAPACITAS 9.
    textus[0] = 'A'.
    textus[1] = 'v'.
    textus[2] = 'e'.
    textus[3] = ' '.
    textus[4] = 'N'.
    textus[5] = 'u'.
    textus[6] = 'm'.
    textus[7] = 'i'.
    textus[8] = '!'.

    DECLARA fd_scriptio SICUT NUMERUS VALENS APERI_SCRIBERE("probatio.txt").
    DECLARA scriptum SICUT NUMERUS VALENS MITTE(fd_scriptio, textus, 9).
    CLAUDE(fd_scriptio).

    PROCLAMA scriptum.

    DECLARA fd_lectio SICUT NUMERUS VALENS APERI_LEGERE("probatio.txt").
    DECLARA lectum SICUT NUMERUS VALENS LEGE(fd_lectio, 100).
    CLAUDE(fd_lectio).

    PROCLAMA lectum.
    SCRIBE_LECTUS(lectum).
    PROCLAMA OCTETUS(0).

    REDDE 0.
FIN-FUNCTIO.
