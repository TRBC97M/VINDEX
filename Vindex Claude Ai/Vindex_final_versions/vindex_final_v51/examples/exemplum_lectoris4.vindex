FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA fd SICUT NUMERUS VALENS APERI_LEGERE("exemplum_lectoris4.vindex").
    DECLARA n SICUT NUMERUS VALENS LEGE(fd, 2000).
    CLAUDE(fd).

    DECLARA verbum SICUT ORDO DE LITTERA CAPACITAS 64.
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA numerus_verborum SICUT NUMERUS VALENS 0.
    DECLARA numerus_numerorum SICUT NUMERUS VALENS 0.
    DECLARA numerus_symbolorum SICUT NUMERUS VALENS 0.

    DUM i < n PERFICE
        DECLARA c SICUT NUMERUS VALENS OCTETUS(i).

        SI (c >= 65 && c <= 90) || (c >= 97 && c <= 122) TUNC
            DECLARA mensura SICUT NUMERUS VALENS 0.
            DUM i < n && ((OCTETUS(i) >= 65 && OCTETUS(i) <= 90) || (OCTETUS(i) >= 97 && OCTETUS(i) <= 122)) PERFICE
                verbum[mensura] = OCTETUS(i).
                mensura = mensura + 1.
                i = i + 1.
            FIN-DUM.
            numerus_verborum = numerus_verborum + 1.
        ALITER
            SI c >= 48 && c <= 57 TUNC
                DECLARA valor SICUT NUMERUS VALENS 0.
                DUM i < n && OCTETUS(i) >= 48 && OCTETUS(i) <= 57 PERFICE
                    valor = valor * 10 + (OCTETUS(i) - 48).
                    i = i + 1.
                FIN-DUM.
                numerus_numerorum = numerus_numerorum + 1.
                PROCLAMA valor.
            ALITER
                SI c == 46 || c == 40 || c == 41 || c == 44 || c == 61 TUNC
                    numerus_symbolorum = numerus_symbolorum + 1.
                FIN-SI.
                i = i + 1.
            FIN-SI.
        FIN-SI.
    FIN-DUM.

    PROCLAMA numerus_verborum.
    PROCLAMA numerus_numerorum.
    PROCLAMA numerus_symbolorum.

    REDDE 0.
FIN-FUNCTIO.
