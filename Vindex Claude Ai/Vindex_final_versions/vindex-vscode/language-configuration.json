{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(FUNCTIO|SI\\b.*\\bTUNC\\s*$|ALITER\\s*$|DUM\\b.*\\bPERFICE\\s*$|PER\\b.*\\bPERFICE\\s*$)",
    "decreaseIndentPattern": "^\\s*(FIN-FUNCTIO|FIN-SI|ALITER|FIN-DUM|FIN-PER)\\."
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
