{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "VINDEX",
  "scopeName": "source.vindex",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#structure-keywords" },
    { "include": "#type-keywords" },
    { "include": "#declaration-keywords" },
    { "include": "#io-keywords" },
    { "include": "#memory-keywords" },
    { "include": "#pointer-keywords" },
    { "include": "#principalis" },
    { "include": "#function-definition" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vindex",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vindex",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vindex",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.vindex",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "structure-keywords": {
      "patterns": [
        {
          "name": "keyword.control.vindex",
          "match": "\\b(FUNCTIO|FIN-FUNCTIO|SI|TUNC|ALITER|FIN-SI|DUM|PERFICE|FIN-DUM|PER|AB|AD|FIN-PER|DESINE)\\b"
        }
      ]
    },
    "type-keywords": {
      "patterns": [
        {
          "name": "storage.type.vindex",
          "match": "\\b(NUMERUS|LITTERA|ACUS|SERIES|DE|CAPACITAS|FORMA|CAMPUS|VERITAS|VACUUM)\\b"
        }
      ]
    },
    "declaration-keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.vindex",
          "match": "\\b(DECLARA|ACCIPIT|SICUT|VALENS|REDDENS|REDDE)\\b"
        }
      ]
    },
    "io-keywords": {
      "patterns": [
        {
          "name": "support.function.io.vindex",
          "match": "\\b(PROCLAMA|SCRIBE|SCRIBE_LECTUS|APERI_LEGERE|APERI_SCRIBERE|LEGE|MITTE|CLAUDE|OCTETUS)\\b"
        }
      ]
    },
    "memory-keywords": {
      "patterns": [
        {
          "name": "support.function.memory.vindex",
          "match": "\\b(RESERVA|LIBERA|IMPONE|AUFER)\\b"
        }
      ]
    },
    "pointer-keywords": {
      "patterns": [
        {
          "name": "keyword.operator.pointer.vindex",
          "match": "\\b(SEDES|CONTENTUM)\\b"
        }
      ]
    },
    "principalis": {
      "patterns": [
        {
          "name": "entity.name.function.entrypoint.vindex",
          "match": "\\bPRINCIPALIS\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(FUNCTIO)\\s+([A-Z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.vindex" },
            "2": { "name": "entity.name.function.vindex" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.vindex"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vindex",
          "match": "(&&|\\|\\||==|!=|>=|<=|>>|<<|[+\\-*/%&|<>=])"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.vindex",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.comma.vindex",
          "match": ","
        },
        {
          "name": "punctuation.brackets.vindex",
          "match": "[\\(\\)\\[\\]]"
        }
      ]
    }
  }
}
