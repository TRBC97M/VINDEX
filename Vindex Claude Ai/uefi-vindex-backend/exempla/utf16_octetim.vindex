// Probatio: catena UTF-16 per SCRIBE_OCTETUM_AB, octetim, sine artificio.

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    DECLARA ts SICUT NUMERUS VALENS CONTENTUM(16777224).
    DECLARA co SICUT NUMERUS VALENS CONTENTUM(ts + 64).
    DECLARA sc SICUT NUMERUS VALENS CONTENTUM(co + 8).

    DECLARA buf SICUT NUMERUS VALENS RESERVA_OCTETA(64).

    SCRIBE_OCTETUM_AB(buf, 80).
    SCRIBE_OCTETUM_AB(buf + 1, 0).
    SCRIBE_OCTETUM_AB(buf + 2, 85).
    SCRIBE_OCTETUM_AB(buf + 3, 0).
    SCRIBE_OCTETUM_AB(buf + 4, 82).
    SCRIBE_OCTETUM_AB(buf + 5, 0).
    SCRIBE_OCTETUM_AB(buf + 6, 85).
    SCRIBE_OCTETUM_AB(buf + 7, 0).
    SCRIBE_OCTETUM_AB(buf + 8, 83).
    SCRIBE_OCTETUM_AB(buf + 9, 0).
    SCRIBE_OCTETUM_AB(buf + 10, 13).
    SCRIBE_OCTETUM_AB(buf + 11, 0).
    SCRIBE_OCTETUM_AB(buf + 12, 10).
    SCRIBE_OCTETUM_AB(buf + 13, 0).
    SCRIBE_OCTETUM_AB(buf + 14, 0).
    SCRIBE_OCTETUM_AB(buf + 15, 0).

    DECLARA ig SICUT NUMERUS VALENS UEFI_VOCA6(sc, co, buf, 0, 0, 0, 0).
    REDDE 0.
FIN-FUNCTIO.
