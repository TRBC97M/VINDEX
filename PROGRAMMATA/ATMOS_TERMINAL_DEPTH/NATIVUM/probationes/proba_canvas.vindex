IMPORTA "../../../../Vindex Chat-GPT/vindex_final_v51/bibliotheca/textus.vindex".
IMPORTA "../../../../Vindex Chat-GPT/vindex_final_v51/bibliotheca/canvas_bgra.vindex".
IMPORTA "../../../../Vindex Chat-GPT/vindex_final_v51/bibliotheca/canvas_bgra_fx.vindex".
IMPORTA "../../../../Vindex Chat-GPT/vindex_final_v51/bibliotheca/fons_bitmap_5x7.vindex".
IMPORTA "../../../../Vindex Chat-GPT/vindex_final_v51/bibliotheca/fons_stroke_5x7.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    ACCIPIT argc SICUT NUMERUS.
    ACCIPIT argv SICUT ACUS<NUMERUS>.

    PROCLAMA "C0 CREA".
    DECLARA c SICUT NUMERUS VALENS CBGRA_CREA(96, 64).
    SI c <= 0 TUNC REDDE 10. FIN-SI.
    DECLARA fundum SICUT NUMERUS VALENS CBGRA_COLOR(1, 2, 3).
    DECLARA rubrum SICUT NUMERUS VALENS CBGRA_COLOR(9, 8, 7).
    DECLARA lux SICUT NUMERUS VALENS CBGRA_COLOR(125, 255, 192).
    PROCLAMA "C1 LIMPA".
    SI CBGRA_LIMPA(c, fundum) == 0 TUNC REDDE 11. FIN-SI.
    PROCLAMA "C2 RECT".
    SI CBGRA_RECT(c, 2, 2, 10, 5, rubrum) == 0 TUNC REDDE 12. FIN-SI.

    PROCLAMA "C3 LEGE".
    DECLARA p SICUT NUMERUS VALENS CBGRA_PIXELS(c) + (2 * 96 + 2) * 4.
    SI OCTETUS_AB(p) != 7 || OCTETUS_AB(p + 1) != 8 || OCTETUS_AB(p + 2) != 9 TUNC REDDE 13. FIN-SI.

    PROCLAMA "C4 LINEA".
    SI CBGRA_LINEA(c, 0, 0, 12, 12, lux) == 0 TUNC REDDE 14. FIN-SI.
    PROCLAMA "C5 CIRCULUS".
    SI CBGRA_CIRCULUS(c, 48, 24, 10, lux) == 0 TUNC REDDE 15. FIN-SI.
    PROCLAMA "C6 TEXTUS BITMAP".
    SI FB5_TEXTUS(c, 16, 8, "ATMOS 123", 1, lux) == 0 TUNC REDDE 16. FIN-SI.

    PROCLAMA "C7 ALPHA".
    SI CBGRA_PIXEL_ALPHA(c, 95, 63, lux, 128) == 0 TUNC REDDE 17. FIN-SI.
    p = CBGRA_PIXELS(c) + (63 * 96 + 95) * 4.
    SI OCTETUS_AB(p) != 98 || OCTETUS_AB(p + 1) != 129 || OCTETUS_AB(p + 2) != 63 TUNC REDDE 18. FIN-SI.

    PROCLAMA "C8 GLOW".
    SI CBGRA_LINEA_GLOW(c, 8, 52, 42, 52, lux) == 0 TUNC REDDE 19. FIN-SI.
    SI CBGRA_CIRCULUS_GLOW(c, 70, 48, 8, lux) == 0 TUNC REDDE 20. FIN-SI.

    PROCLAMA "C9 FONS STROKE".
    SI FS5_TEXTUS_GLOW(c, 8, 36, "FX", 2, lux) == 0 TUNC REDDE 21. FIN-SI.

    PROCLAMA "C10 NUMERA".
    DECLARA basis SICUT NUMERUS VALENS CBGRA_PIXELS(c).
    DECLARA i SICUT NUMERUS VALENS 0.
    DECLARA pixela_lucida SICUT NUMERUS VALENS 0.
    DECLARA pixela_mixta SICUT NUMERUS VALENS 0.
    DUM i < 96 * 64 PERFICE
        DECLARA q SICUT NUMERUS VALENS basis + i * 4.
        SI OCTETUS_AB(q) == 192 && OCTETUS_AB(q + 1) == 255 && OCTETUS_AB(q + 2) == 125 TUNC
            pixela_lucida = pixela_lucida + 1.
        FIN-SI.
        SI OCTETUS_AB(q) != 3 || OCTETUS_AB(q + 1) != 2 || OCTETUS_AB(q + 2) != 1 TUNC
            pixela_mixta = pixela_mixta + 1.
        FIN-SI.
        i = i + 1.
    FIN-DUM.
    SI pixela_lucida < 80 TUNC REDDE 22. FIN-SI.
    SI pixela_mixta <= pixela_lucida TUNC REDDE 23. FIN-SI.

    PROCLAMA "RECTE: CANVAS BGRA, ALPHA, GLOW ET FONS STROKE VINDEX".
    PROCLAMA pixela_lucida.
    PROCLAMA pixela_mixta.
    REDDE 0.
FIN-FUNCTIO.