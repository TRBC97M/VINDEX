IMPORTA "../../../../Vindex Chat-GPT/vindex_final_v51/bibliotheca/aleatorium.vindex".
IMPORTA "../ludus/mathematica.vindex".
IMPORTA "../ludus/mundus.vindex".
IMPORTA "../ludus/status.vindex".
IMPORTA "../ludus/resourca.vindex".
IMPORTA "../ludus/statio.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    ACCIPIT argc SICUT NUMERUS.
    ACCIPIT argv SICUT ACUS<NUMERUS>.

    DECLARA s SICUT NUMERUS VALENS NAT_STATUS_CREA(7319).
    SI s <= 0 TUNC REDDE 20. FIN-SI.
    SI CONTENTUM(s) != 1000 || CONTENTUM(s + 8) != 1000 || CONTENTUM(s + 16) != 1000 TUNC REDDE 21. FIN-SI.
    SI CONTENTUM(s + 24) != 2140 || CONTENTUM(s + 32) != 350 || CONTENTUM(s + 160) != 280 || CONTENTUM(s + 232) != 1 TUNC REDDE 22. FIN-SI.

    SI NAT_CURSUS_IMPONE(s, 140, 0) == 0 TUNC REDDE 23. FIN-SI.
    SI NAT_CURSUS_RELIQUUM(s) != 140 || NAT_CURSUS_PROGRESSUS(s) != 0 TUNC REDDE 24. FIN-SI.

    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < 20 PERFICE
        DECLARA g0 SICUT NUMERUS VALENS NAT_CURSUS_GRADUS(s).
        i = i + 1.
    FIN-DUM.
    SI CONTENTUM(s + 40) <= 0 || CONTENTUM(s + 40) >= 140 TUNC REDDE 25. FIN-SI.
    DECLARA reliquum SICUT NUMERUS VALENS NAT_CURSUS_RELIQUUM(s).
    DECLARA progressus SICUT NUMERUS VALENS NAT_CURSUS_PROGRESSUS(s).
    SI reliquum <= 0 || reliquum >= 140 TUNC REDDE 26. FIN-SI.
    SI progressus <= 0 || progressus >= 1000 TUNC REDDE 27. FIN-SI.
    SI CONTENTUM(s + 24) < 900 || CONTENTUM(s + 24) > 12000 TUNC REDDE 28. FIN-SI.

    DECLARA guard SICUT NUMERUS VALENS 20.
    DUM CONTENTUM(s + 80) != 0 && guard < 1000 PERFICE
        DECLARA g SICUT NUMERUS VALENS NAT_CURSUS_GRADUS(s).
        guard = guard + 1.
    FIN-DUM.
    SI CONTENTUM(s + 80) != 0 TUNC REDDE 29. FIN-SI.
    SI CONTENTUM(s + 40) != 140 || CONTENTUM(s + 48) != 0 TUNC REDDE 30. FIN-SI.
    SI CONTENTUM(s + 24) < 900 || CONTENTUM(s + 24) > 12000 TUNC REDDE 31. FIN-SI.
    SI CONTENTUM(s) >= 1000 TUNC REDDE 32. FIN-SI.

    i = 0.
    DUM i < 188 PERFICE
        DECLARA d SICUT NUMERUS VALENS NAT_DRAIN_GRADUS(s).
        i = i + 1.
    FIN-DUM.
    SI CONTENTUM(s + 8) != 998 TUNC REDDE 33. FIN-SI.

    DECLARA s2 SICUT NUMERUS VALENS NAT_STATUS_CREA(7319).
    SI s2 <= 0 TUNC REDDE 34. FIN-SI.
    CONTENTUM(s2 + 40) = 2999950.
    CONTENTUM(s2 + 48) = 0.
    DECLARA pd SICUT NUMERUS VALENS NAT_STATUS_PROFUNDITAS_RENOVA(s2).
    SI NAT_CURSUS_IMPONE(s2, 3000230, 0) == 0 TUNC REDDE 35. FIN-SI.
    DECLARA ex SICUT NUMERUS VALENS CONTENTUM(s2 + 104).
    DECLARA ey SICUT NUMERUS VALENS CONTENTUM(s2 + 112).
    SI NAT_ISQRT(ex * ex + ey * ey) > NAT_MUNDUS_RADIUS() TUNC REDDE 36. FIN-SI.
    SI ex != 3000000 || ey != 0 TUNC REDDE 37. FIN-SI.

    DECLARA d0 SICUT NUMERUS VALENS NAT_MUNDUS_PROFUNDITAS(7319, 0, 0).
    DECLARA d1 SICUT NUMERUS VALENS NAT_MUNDUS_PROFUNDITAS(7319, 1, 0).
    DECLARA d100 SICUT NUMERUS VALENS NAT_MUNDUS_PROFUNDITAS(7319, 100, 0).
    SI d0 != 2140 TUNC REDDE 38. FIN-SI.
    SI NAT_ABS(d1 - d0) > 10 TUNC REDDE 39. FIN-SI.
    SI NAT_ABS(d100 - d0) > 100 TUNC REDDE 40. FIN-SI.

    DECLARA regio0 SICUT NUMERUS VALENS NAT_MUNDUS_REGIO(7319, 0, 0).
    DECLARA regio_lim SICUT NUMERUS VALENS NAT_MUNDUS_REGIO(7319, 2990000, 0).
    DECLARA relief0 SICUT NUMERUS VALENS NAT_MUNDUS_RELIEF(7319, 0, 0).
    SI regio0 != 1 TUNC REDDE 41. FIN-SI.
    SI regio_lim != 5 TUNC REDDE 42. FIN-SI.
    SI relief0 < 1 || relief0 > 4 TUNC REDDE 43. FIN-SI.

    DECLARA s3 SICUT NUMERUS VALENS NAT_STATUS_CREA(7319).
    SI s3 <= 0 TUNC REDDE 44. FIN-SI.
    SI NAT_RES_VISIBILIS(s3) == 0 TUNC REDDE 45. FIN-SI.
    SI CONTENTUM(s3 + 216) != 0 || CONTENTUM(s3 + 224) != 60 TUNC REDDE 46. FIN-SI.
    SI NAT_RES_CURSUS(s3) == 0 TUNC REDDE 47. FIN-SI.
    SI CONTENTUM(s3 + 192) != 1 TUNC REDDE 48. FIN-SI.

    DECLARA rg SICUT NUMERUS VALENS 0.
    DUM CONTENTUM(s3 + 80) != 0 && rg < 1000 PERFICE
        DECLARA gm SICUT NUMERUS VALENS NAT_CURSUS_GRADUS(s3).
        rg = rg + 1.
    FIN-DUM.
    SI CONTENTUM(s3 + 80) != 0 TUNC REDDE 49. FIN-SI.
    SI NAT_RES_DISTANTIA(s3) > CONTENTUM(s3 + 184) + 2 TUNC REDDE 50. FIN-SI.

    DECLARA j SICUT NUMERUS VALENS 0.
    DUM j < 63 PERFICE
        DECLARA e SICUT NUMERUS VALENS NAT_EXTRACTIO_GRADUS(s3).
        j = j + 1.
    FIN-DUM.
    SI CONTENTUM(s3 + 200) != 1 TUNC REDDE 51. FIN-SI.
    SI CONTENTUM(s3 + 216) != 1 || CONTENTUM(s3 + 224) != 59 TUNC REDDE 52. FIN-SI.
    SI CONTENTUM(s3 + 8) != 997 TUNC REDDE 53. FIN-SI.

    DECLARA br SICUT NUMERUS VALENS NAT_RES_ABRUMPE(s3).
    SI CONTENTUM(s3 + 192) != 0 || CONTENTUM(s3 + 200) != 0 TUNC REDDE 54. FIN-SI.

    // Cargo -> statio -> docking. Nihil venditur automatice.
    SI NAT_STAT_VISIBILIS(s3) == 0 TUNC REDDE 55. FIN-SI.
    CONTENTUM(s3 + 216) = 5.
    DECLARA credita_ante SICUT NUMERUS VALENS CONTENTUM(s3 + 32).
    SI NAT_STAT_CURSUS(s3) == 0 TUNC REDDE 56. FIN-SI.
    SI NAT_STAT_CURSUS_ACTIVUS(s3) == 0 TUNC REDDE 57. FIN-SI.

    DECLARA sg SICUT NUMERUS VALENS 0.
    DUM CONTENTUM(s3 + 80) != 0 && sg < 1000 PERFICE
        DECLARA gs SICUT NUMERUS VALENS NAT_CURSUS_GRADUS(s3).
        sg = sg + 1.
    FIN-DUM.
    SI CONTENTUM(s3 + 80) != 0 TUNC REDDE 58. FIN-SI.
    SI NAT_STAT_DOCKED(s3) == 0 TUNC REDDE 59. FIN-SI.
    DECLARA stat_tick SICUT NUMERUS VALENS NAT_STAT_GRADUS(s3).
    SI stat_tick != 1 TUNC REDDE 60. FIN-SI.
    SI CONTENTUM(s3 + 216) != 5 || CONTENTUM(s3 + 32) != credita_ante TUNC REDDE 61. FIN-SI.

    // Pretium ex imagine HTML: hull 72%=112, O2 31%=138, energy 54%=92.
    CONTENTUM(s3 + 16) = 720.
    CONTENTUM(s3 + 0) = 310.
    CONTENTUM(s3 + 8) = 540.
    SI NAT_STAT_PRETIUM_HULL(s3) != 112 TUNC REDDE 62. FIN-SI.
    SI NAT_STAT_PRETIUM_O2(s3) != 138 TUNC REDDE 63. FIN-SI.
    SI NAT_STAT_PRETIUM_ENERGIA(s3) != 92 TUNC REDDE 64. FIN-SI.

    // Repair est actio voluntaria; test dat satis creditis ad omnes tres.
    CONTENTUM(s3 + 32) = 1000.
    SI NAT_STAT_REPARA_HULL(s3) == 0 TUNC REDDE 65. FIN-SI.
    SI NAT_STAT_REPLE_O2(s3) == 0 TUNC REDDE 66. FIN-SI.
    SI NAT_STAT_REPLE_ENERGIA(s3) == 0 TUNC REDDE 67. FIN-SI.
    SI CONTENTUM(s3 + 16) != 1000 || CONTENTUM(s3 + 0) != 1000 || CONTENTUM(s3 + 8) != 1000 TUNC REDDE 68. FIN-SI.
    SI CONTENTUM(s3 + 32) != 658 TUNC REDDE 69. FIN-SI.

    // Market quoque manualis: cargo manet donec VENDERE eligitur.
    SI CONTENTUM(s3 + 216) != 5 TUNC REDDE 70. FIN-SI.
    SI NAT_STAT_VENDE_OMNE(s3) == 0 TUNC REDDE 71. FIN-SI.
    SI CONTENTUM(s3 + 216) != 0 || CONTENTUM(s3 + 32) != 718 TUNC REDDE 72. FIN-SI.

    // Undock est voluntarium et stationis modum statim claudit.
    SI NAT_STAT_UNDOCK(s3) == 0 TUNC REDDE 73. FIN-SI.
    SI CONTENTUM(s3 + 80) == 0 || NAT_STAT_DOCKED(s3) != 0 TUNC REDDE 74. FIN-SI.
    DECLARA ug SICUT NUMERUS VALENS 0.
    DUM CONTENTUM(s3 + 80) != 0 && ug < 1000 PERFICE
        DECLARA gu SICUT NUMERUS VALENS NAT_CURSUS_GRADUS(s3).
        ug = ug + 1.
    FIN-DUM.
    SI NAT_STAT_DISTANTIA(s3) <= NAT_STAT_RADIUS() TUNC REDDE 75. FIN-SI.

    PROCLAMA "RECTE: ATMOS NATIVUM SANDBOX STATIONIS".
    PROCLAMA CONTENTUM(s + 40).
    PROCLAMA CONTENTUM(s + 48).
    PROCLAMA CONTENTUM(s + 24).
    PROCLAMA ex.
    PROCLAMA regio0.
    PROCLAMA relief0.
    PROCLAMA CONTENTUM(s3 + 216).
    PROCLAMA CONTENTUM(s3 + 32).
    REDDE 0.
FIN-FUNCTIO.
