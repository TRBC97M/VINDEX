IMPORTA "../../../../Vindex Chat-GPT/vindex_final_v51/bibliotheca/aleatorium.vindex".
IMPORTA "../ludus/mathematica.vindex".
IMPORTA "../ludus/mundus.vindex".
IMPORTA "../ludus/status.vindex".

FUNCTIO PRINCIPALIS REDDENS NUMERUS.
    ACCIPIT argc SICUT NUMERUS.
    ACCIPIT argv SICUT ACUS<NUMERUS>.

    DECLARA s SICUT NUMERUS VALENS NAT_STATUS_CREA(7319).
    SI s <= 0 TUNC REDDE 20. FIN-SI.
    SI CONTENTUM(s) != 1000 || CONTENTUM(s + 8) != 1000 || CONTENTUM(s + 16) != 1000 TUNC REDDE 21. FIN-SI.
    SI CONTENTUM(s + 24) != 2140 || CONTENTUM(s + 32) != 350 || CONTENTUM(s + 160) != 280 TUNC REDDE 22. FIN-SI.

    SI NAT_CURSUS_IMPONE(s, 140, 0) == 0 TUNC REDDE 23. FIN-SI.
    DECLARA guard SICUT NUMERUS VALENS 0.
    DUM CONTENTUM(s + 80) != 0 && guard < 1000 PERFICE
        DECLARA g SICUT NUMERUS VALENS NAT_CURSUS_GRADUS(s).
        guard = guard + 1.
    FIN-DUM.
    SI CONTENTUM(s + 80) != 0 TUNC REDDE 24. FIN-SI.
    SI CONTENTUM(s + 40) != 140 || CONTENTUM(s + 48) != 0 TUNC REDDE 25. FIN-SI.
    SI CONTENTUM(s + 24) < 900 || CONTENTUM(s + 24) > 12000 TUNC REDDE 26. FIN-SI.
    SI CONTENTUM(s) >= 1000 TUNC REDDE 27. FIN-SI.

    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < 188 PERFICE
        DECLARA d SICUT NUMERUS VALENS NAT_DRAIN_GRADUS(s).
        i = i + 1.
    FIN-DUM.
    SI CONTENTUM(s + 8) != 998 TUNC REDDE 28. FIN-SI.

    PROCLAMA "RECTE: ATMOS NATIVUM NUCLEUS".
    PROCLAMA CONTENTUM(s + 40).
    PROCLAMA CONTENTUM(s + 48).
    PROCLAMA CONTENTUM(s + 24).
    PROCLAMA CONTENTUM(s + 0).
    PROCLAMA CONTENTUM(s + 8).
    REDDE 0.
FIN-FUNCTIO.
