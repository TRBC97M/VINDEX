// ATMOS NATIVUM — interface docking separata, resolutione independens.
// Stationis modus est locus decisionum: tabs, actiones manuales, undock voluntarium.

FUNCTIO NAT_STAT_UI_TAB REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT nomen SICUT TEXTUS.
    ACCIPIT activa SICUT NUMERUS.
    DECLARA panel SICUT NUMERUS VALENS CBGRA_COLOR(11, 36, 26).
    DECLARA panel2 SICUT NUMERUS VALENS CBGRA_COLOR(17, 55, 39).
    DECLARA edge SICUT NUMERUS VALENS CBGRA_COLOR(45, 117, 81).
    DECLARA phosphor SICUT NUMERUS VALENS CBGRA_COLOR(119, 255, 188).
    DECLARA text_d SICUT NUMERUS VALENS CBGRA_COLOR(176, 201, 187).
    DECLARA f SICUT NUMERUS VALENS NATG_RECT(c, x, 94, w, 34, panel).
    SI activa != 0 TUNC f = NATG_RECT(c, x, 94, w, 34, panel2). FIN-SI.
    f = NATG_RECT(c, x, 127, w, 1, edge).
    SI activa != 0 TUNC
        f = NATG_TEXT_GLOW(c, x + 8, 105, nomen, 1, phosphor).
    ALITER
        f = NATG_TEXT(c, x + 8, 105, nomen, 1, text_d).
    FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NAT_STAT_UI_BUTON REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT text SICUT TEXTUS.
    DECLARA fundum SICUT NUMERUS VALENS CBGRA_COLOR(8, 29, 21).
    DECLARA edge SICUT NUMERUS VALENS CBGRA_COLOR(45, 117, 81).
    DECLARA phosphor SICUT NUMERUS VALENS CBGRA_COLOR(119, 255, 188).
    DECLARA f SICUT NUMERUS VALENS NATG_RECT(c, x, y, w, h, fundum).
    f = NATG_RECT(c, x, y, w, 1, edge).
    f = NATG_RECT(c, x, y + h - 1, w, 1, edge).
    f = NATG_RECT(c, x, y, 1, h, edge).
    f = NATG_RECT(c, x + w - 1, y, 1, h, edge).
    f = NATG_TEXT_GLOW(c, x + 8, y + 11, text, 1, phosphor).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NAT_STAT_UI_RENDE REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI c <= 0 || s <= 0 || NAT_STAT_DOCKED(s) == 0 TUNC REDDE 0. FIN-SI.

    DECLARA void SICUT NUMERUS VALENS CBGRA_COLOR(6, 21, 15).
    DECLARA panel SICUT NUMERUS VALENS CBGRA_COLOR(10, 35, 25).
    DECLARA panel2 SICUT NUMERUS VALENS CBGRA_COLOR(14, 46, 33).
    DECLARA edge SICUT NUMERUS VALENS CBGRA_COLOR(45, 117, 81).
    DECLARA phosphor SICUT NUMERUS VALENS CBGRA_COLOR(119, 255, 188).
    DECLARA echo SICUT NUMERUS VALENS CBGRA_COLOR(137, 241, 245).
    DECLARA amber SICUT NUMERUS VALENS CBGRA_COLOR(255, 201, 104).
    DECLARA text_d SICUT NUMERUS VALENS CBGRA_COLOR(176, 201, 187).

    DECLARA f SICUT NUMERUS VALENS CBGRA_LIMPA(c, void).
    f = NATG_SCANLINES(c, 52).
    f = NATG_RECT(c, 0, 0, 960, 52, panel).
    f = NATG_RECT(c, 0, 50, 960, 2, edge).
    f = NATG_TEXT_GLOW(c, 18, 16, "ATMOS // TERMINAL DEPTH", 2, phosphor).
    DECLARA t SICUT TEXTUS VALENS "CREDITS " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 32)).
    f = NATG_TEXT_GLOW(c, 790, 18, t, 1, amber).

    f = NATG_TEXT_GLOW(c, 18, 63, "HABITAT-01", 2, amber).
    f = NAT_STAT_UI_BUTON(c, 842, 56, 100, 32, "UNDOCK").

    DECLARA tab SICUT NUMERUS VALENS CONTENTUM(s + 232).
    DECLARA a1 SICUT NUMERUS VALENS 0.
    DECLARA a2 SICUT NUMERUS VALENS 0.
    DECLARA a3 SICUT NUMERUS VALENS 0.
    DECLARA a4 SICUT NUMERUS VALENS 0.
    DECLARA a5 SICUT NUMERUS VALENS 0.
    DECLARA a6 SICUT NUMERUS VALENS 0.
    SI tab == 1 TUNC a1 = 1. FIN-SI.
    SI tab == 2 TUNC a2 = 1. FIN-SI.
    SI tab == 3 TUNC a3 = 1. FIN-SI.
    SI tab == 4 TUNC a4 = 1. FIN-SI.
    SI tab == 5 TUNC a5 = 1. FIN-SI.
    SI tab == 6 TUNC a6 = 1. FIN-SI.
    f = NAT_STAT_UI_TAB(c, 18, 88, "REPAIR", a1).
    f = NAT_STAT_UI_TAB(c, 110, 88, "MARKET", a2).
    f = NAT_STAT_UI_TAB(c, 202, 104, "FABRICATE", a3).
    f = NAT_STAT_UI_TAB(c, 310, 72, "REFIT", a4).
    f = NAT_STAT_UI_TAB(c, 386, 104, "CONTRACTS", a5).
    f = NAT_STAT_UI_TAB(c, 494, 116, "REPUTATION", a6).

    f = NATG_RECT(c, 18, 148, 924, 500, panel).
    f = NATG_RECT(c, 18, 148, 924, 1, edge).

    SI tab == 1 TUNC
        f = NATG_TEXT_GLOW(c, 30, 166, "REPAIR // MANUAL SERVICE", 2, phosphor).
        f = NATG_TEXT(c, 30, 194, "CHOOSE WHAT TO RESTORE. NOTHING IS AUTOMATIC.", 1, text_d).

        f = NATG_RECT(c, 30, 214, 902, 64, panel2).
        f = NATG_TEXT_GLOW(c, 42, 226, "HULL", 2, echo).
        t = "CURRENT " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 16) / 10) + "%".
        f = NATG_TEXT(c, 42, 252, t, 1, text_d).
        t = TEXTUS_EX_NUMERO_DECIMALI(NAT_STAT_PRETIUM_HULL(s)) + " CR".
        f = NAT_STAT_UI_BUTON(c, 812, 222, 120, 44, t).

        f = NATG_RECT(c, 30, 300, 902, 64, panel2).
        f = NATG_TEXT_GLOW(c, 42, 312, "OXYGEN", 2, echo).
        t = "CURRENT " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 0) / 10) + "%".
        f = NATG_TEXT(c, 42, 338, t, 1, text_d).
        t = TEXTUS_EX_NUMERO_DECIMALI(NAT_STAT_PRETIUM_O2(s)) + " CR".
        f = NAT_STAT_UI_BUTON(c, 812, 308, 120, 44, t).

        f = NATG_RECT(c, 30, 386, 902, 64, panel2).
        f = NATG_TEXT_GLOW(c, 42, 398, "ENERGY", 2, echo).
        t = "CURRENT " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 8) / 10) + "%".
        f = NATG_TEXT(c, 42, 424, t, 1, text_d).
        t = TEXTUS_EX_NUMERO_DECIMALI(NAT_STAT_PRETIUM_ENERGIA(s)) + " CR".
        f = NAT_STAT_UI_BUTON(c, 812, 394, 120, 44, t).
    FIN-SI.

    SI tab == 2 TUNC
        f = NATG_TEXT_GLOW(c, 30, 166, "MARKET // HABITAT-01", 2, phosphor).
        f = NATG_TEXT(c, 30, 194, "LOCAL BUY ORDER // FERROUS NODULES", 1, text_d).
        f = NATG_RECT(c, 30, 224, 902, 100, panel2).
        t = "CARGO " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 216)) + " / 40".
        f = NATG_TEXT_GLOW(c, 42, 240, t, 2, amber).
        t = "PRICE " + TEXTUS_EX_NUMERO_DECIMALI(NAT_STAT_PRETIUM()) + " CR / UNIT".
        f = NATG_TEXT(c, 42, 278, t, 1, text_d).
        t = "VALUE " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 216) * NAT_STAT_PRETIUM()) + " CR".
        f = NATG_TEXT_GLOW(c, 350, 278, t, 1, echo).
        f = NAT_STAT_UI_BUTON(c, 782, 244, 150, 48, "SELL ALL ORE").
        f = NATG_TEXT_GLOW(c, 30, 350, "SELLING REQUIRES YOUR CLICK. DOCKING NEVER SELLS CARGO.", 1, phosphor).
    FIN-SI.

    SI tab == 3 TUNC
        f = NATG_TEXT_GLOW(c, 30, 166, "FABRICATE", 2, phosphor).
        f = NATG_TEXT(c, 30, 206, "FABRICATION SYSTEM RESERVED FOR NEXT GAMEPLAY PASS.", 1, text_d).
    FIN-SI.
    SI tab == 4 TUNC
        f = NATG_TEXT_GLOW(c, 30, 166, "REFIT", 2, phosphor).
        f = NATG_TEXT(c, 30, 206, "SHIP MODULE REFIT SYSTEM RESERVED FOR NEXT GAMEPLAY PASS.", 1, text_d).
    FIN-SI.
    SI tab == 5 TUNC
        f = NATG_TEXT_GLOW(c, 30, 166, "CONTRACTS", 2, phosphor).
        f = NATG_TEXT(c, 30, 206, "CONTRACT BOARD RESERVED FOR NEXT GAMEPLAY PASS.", 1, text_d).
    FIN-SI.
    SI tab == 6 TUNC
        f = NATG_TEXT_GLOW(c, 30, 166, "REPUTATION", 2, phosphor).
        f = NATG_TEXT(c, 30, 206, "FACTION REPUTATION RESERVED FOR NEXT GAMEPLAY PASS.", 1, text_d).
    FIN-SI.

    f = NATG_RECT(c, 0, 666, 960, 54, panel).
    f = NATG_RECT(c, 0, 666, 960, 1, edge).
    t = "DEPTH " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 24)) + " M".
    f = NATG_TEXT_GLOW(c, 18, 688, t, 1, echo).
    t = "HULL " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 16) / 10) + "%".
    f = NATG_TEXT(c, 240, 688, t, 1, text_d).
    t = "ENERGY " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 8) / 10) + "%".
    f = NATG_TEXT(c, 450, 688, t, 1, text_d).
    t = "OXYGEN " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 0) / 10) + "%".
    f = NATG_TEXT(c, 680, 688, t, 1, text_d).

    REDDE 1.
FIN-FUNCTIO.