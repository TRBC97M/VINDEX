// ATMOS NATIVUM — station, docking et premier marche mineral.
// Contractus HTML: statio est entitas mundi; clic -> course; intra radium -> docking.
// Prima economia NATIVUM: noduli ferrosi venduntur XII credita per unitatem.

FUNCTIO NAT_STAT_X REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    REDDE -35.
FIN-FUNCTIO.

FUNCTIO NAT_STAT_Y REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    REDDE 75.
FIN-FUNCTIO.

FUNCTIO NAT_STAT_RADIUS REDDENS NUMERUS.
    REDDE 24.
FIN-FUNCTIO.

FUNCTIO NAT_STAT_PRETIUM REDDENS NUMERUS.
    REDDE 12.
FIN-FUNCTIO.

FUNCTIO NAT_STAT_DISTANTIA REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI s <= 0 TUNC REDDE 0. FIN-SI.
    REDDE NAT_DISTANTIA(CONTENTUM(s + 40), CONTENTUM(s + 48), NAT_STAT_X(s), NAT_STAT_Y(s)).
FIN-FUNCTIO.

FUNCTIO NAT_STAT_VISIBILIS REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI s <= 0 TUNC REDDE 0. FIN-SI.
    SI NAT_STAT_DISTANTIA(s) > CONTENTUM(s + 160) TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NAT_STAT_DOCKED REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI s <= 0 || CONTENTUM(s + 80) != 0 TUNC REDDE 0. FIN-SI.
    SI NAT_STAT_DISTANTIA(s) > NAT_STAT_RADIUS() TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

// Verum si finis cursus activi intra zonam docking stationis iacet.
FUNCTIO NAT_STAT_CURSUS_ACTIVUS REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI s <= 0 || CONTENTUM(s + 80) == 0 TUNC REDDE 0. FIN-SI.
    DECLARA d SICUT NUMERUS VALENS NAT_DISTANTIA(CONTENTUM(s + 104), CONTENTUM(s + 112), NAT_STAT_X(s), NAT_STAT_Y(s)).
    SI d > NAT_STAT_RADIUS() + 4 TUNC REDDE 0. FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

// Approche stationis: destination paulo intra docking radius.
FUNCTIO NAT_STAT_CURSUS REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI s <= 0 || CONTENTUM(s + 64) == 0 || CONTENTUM(s + 72) != 0 TUNC REDDE 0. FIN-SI.
    DECLARA br SICUT NUMERUS VALENS NAT_RES_ABRUMPE(s).
    DECLARA dist SICUT NUMERUS VALENS NAT_STAT_DISTANTIA(s).
    DECLARA r SICUT NUMERUS VALENS NAT_STAT_RADIUS().
    SI dist <= r TUNC REDDE 1. FIN-SI.

    DECLARA px SICUT NUMERUS VALENS CONTENTUM(s + 40).
    DECLARA py SICUT NUMERUS VALENS CONTENTUM(s + 48).
    DECLARA dx SICUT NUMERUS VALENS NAT_STAT_X(s) - px.
    DECLARA dy SICUT NUMERUS VALENS NAT_STAT_Y(s) - py.
    DECLARA aditus SICUT NUMERUS VALENS dist - (r - 4).
    SI aditus < 1 TUNC aditus = 1. FIN-SI.
    DECLARA tx SICUT NUMERUS VALENS px + dx * aditus / dist.
    DECLARA ty SICUT NUMERUS VALENS py + dy * aditus / dist.
    REDDE NAT_CURSUS_IMPONE(s, tx, ty).
FIN-FUNCTIO.

FUNCTIO NAT_STAT_CLIC REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    ACCIPIT mx SICUT NUMERUS.
    ACCIPIT my SICUT NUMERUS.
    SI NAT_STAT_VISIBILIS(s) == 0 TUNC REDDE 0. FIN-SI.
    DECLARA cx SICUT NUMERUS VALENS 324.
    DECLARA cy SICUT NUMERUS VALENS 374.
    DECLARA range SICUT NUMERUS VALENS CONTENTUM(s + 160).
    DECLARA sx SICUT NUMERUS VALENS cx + (NAT_STAT_X(s) - CONTENTUM(s + 40)) * 270 / range.
    DECLARA sy SICUT NUMERUS VALENS cy + (NAT_STAT_Y(s) - CONTENTUM(s + 48)) * 270 / range.
    DECLARA dx SICUT NUMERUS VALENS mx - sx.
    DECLARA dy SICUT NUMERUS VALENS my - sy.
    SI dx * dx + dy * dy > 256 TUNC REDDE 0. FIN-SI.
    REDDE NAT_STAT_CURSUS(s).
FIN-FUNCTIO.

// 0 non docked; 1 docked sine venditione; 2 cargo venditus.
FUNCTIO NAT_STAT_GRADUS REDDENS NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI NAT_STAT_DOCKED(s) == 0 TUNC REDDE 0. FIN-SI.
    DECLARA cargo SICUT NUMERUS VALENS CONTENTUM(s + 216).
    SI cargo <= 0 TUNC REDDE 1. FIN-SI.
    DECLARA pretium SICUT NUMERUS VALENS NAT_STAT_PRETIUM().
    CONTENTUM(s + 32) = CONTENTUM(s + 32) + cargo * pretium.
    CONTENTUM(s + 216) = 0.
    REDDE 2.
FIN-FUNCTIO.
