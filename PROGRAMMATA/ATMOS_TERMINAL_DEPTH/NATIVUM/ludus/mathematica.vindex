// ATMOS NATIVUM — mathematica integra minima.

FUNCTIO NAT_ABS REDDENS NUMERUS.
    ACCIPIT v SICUT NUMERUS.
    SI v < 0 TUNC REDDE 0 - v. FIN-SI.
    REDDE v.
FIN-FUNCTIO.

FUNCTIO NAT_MIN REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI a < b TUNC REDDE a. FIN-SI.
    REDDE b.
FIN-FUNCTIO.

FUNCTIO NAT_MAX REDDENS NUMERUS.
    ACCIPIT a SICUT NUMERUS.
    ACCIPIT b SICUT NUMERUS.
    SI a > b TUNC REDDE a. FIN-SI.
    REDDE b.
FIN-FUNCTIO.

FUNCTIO NAT_CLAMPA REDDENS NUMERUS.
    ACCIPIT v SICUT NUMERUS.
    ACCIPIT minimum SICUT NUMERUS.
    ACCIPIT maximum SICUT NUMERUS.
    SI v < minimum TUNC REDDE minimum. FIN-SI.
    SI v > maximum TUNC REDDE maximum. FIN-SI.
    REDDE v.
FIN-FUNCTIO.

// Radix quadrata integra Newtoniana; input non-negativus 64-bit.
FUNCTIO NAT_ISQRT REDDENS NUMERUS.
    ACCIPIT n SICUT NUMERUS.
    SI n <= 0 TUNC REDDE 0. FIN-SI.
    SI n <= 3 TUNC REDDE 1. FIN-SI.
    DECLARA x SICUT NUMERUS VALENS n.
    DECLARA y SICUT NUMERUS VALENS (x + 1) / 2.
    DUM y < x PERFICE
        x = y.
        y = (x + n / x) / 2.
    FIN-DUM.
    REDDE x.
FIN-FUNCTIO.

FUNCTIO NAT_DISTANTIA REDDENS NUMERUS.
    ACCIPIT x0 SICUT NUMERUS.
    ACCIPIT y0 SICUT NUMERUS.
    ACCIPIT x1 SICUT NUMERUS.
    ACCIPIT y1 SICUT NUMERUS.
    DECLARA dx SICUT NUMERUS VALENS x1 - x0.
    DECLARA dy SICUT NUMERUS VALENS y1 - y0.
    REDDE NAT_ISQRT(dx * dx + dy * dy).
FIN-FUNCTIO.
