// ATMOS NATIVUM — renderer unicus in canvas BGRA.
// Nullus TextOutA, nullus overlay GDI: omnia hic ante unicam praesentatiionem.

FUNCTIO NAT_UI_BAR REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT valor_x10 SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA fundum SICUT NUMERUS VALENS CBGRA_COLOR(10, 30, 22).
    DECLARA lim SICUT NUMERUS VALENS NAT_CLAMPA(valor_x10, 0, 1000) * w / 1000.
    DECLARA f SICUT NUMERUS VALENS CBGRA_RECT(c, x, y, w, 8, fundum).
    SI lim > 0 TUNC f = CBGRA_RECT(c, x, y, lim, 8, color). FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NAT_RENDE REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI c <= 0 || s <= 0 TUNC REDDE 0. FIN-SI.

    DECLARA void SICUT NUMERUS VALENS CBGRA_COLOR(10, 24, 18).
    DECLARA panel SICUT NUMERUS VALENS CBGRA_COLOR(16, 40, 32).
    DECLARA edge SICUT NUMERUS VALENS CBGRA_COLOR(45, 107, 78).
    DECLARA phosphor SICUT NUMERUS VALENS CBGRA_COLOR(125, 255, 192).
    DECLARA phosphor_d SICUT NUMERUS VALENS CBGRA_COLOR(58, 154, 98).
    DECLARA echo SICUT NUMERUS VALENS CBGRA_COLOR(143, 245, 246).
    DECLARA amber SICUT NUMERUS VALENS CBGRA_COLOR(255, 208, 128).
    DECLARA text_d SICUT NUMERUS VALENS CBGRA_COLOR(176, 196, 184).
    DECLARA danger SICUT NUMERUS VALENS CBGRA_COLOR(255, 128, 144).

    DECLARA f SICUT NUMERUS VALENS CBGRA_LIMPA(c, void).
    f = CBGRA_RECT(c, 0, 0, 960, 52, panel).
    f = CBGRA_RECT(c, 0, 50, 960, 2, edge).
    f = CBGRA_RECT(c, 648, 52, 2, 668, edge).
    f = CBGRA_RECT(c, 420, 78, 220, 188, panel).
    f = CBGRA_RECT(c, 420, 78, 220, 1, edge).

    // CRT manet tantum in strato fundi.
    DECLARA y SICUT NUMERUS VALENS 55.
    DUM y < 720 PERFICE
        f = CBGRA_RECT(c, 0, y, 960, 1, CBGRA_COLOR(8, 20, 15)).
        y = y + 4.
    FIN-DUM.

    f = FB5_TEXTUS(c, 18, 17, "ATMOS // TERMINAL DEPTH", 2, phosphor).
    f = FB5_TEXTUS(c, 720, 17, "SYSTEM LOG", 2, phosphor).

    DECLARA cx SICUT NUMERUS VALENS 324.
    DECLARA cy SICUT NUMERUS VALENS 374.
    DECLARA radius SICUT NUMERUS VALENS 270.
    f = CBGRA_CIRCULUS(c, cx, cy, 90, phosphor_d).
    f = CBGRA_CIRCULUS(c, cx, cy, 180, phosphor_d).
    f = CBGRA_CIRCULUS(c, cx, cy, radius, phosphor_d).
    f = CBGRA_LINEA(c, cx - radius, cy, cx + radius, cy, phosphor_d).
    f = CBGRA_LINEA(c, cx, cy - radius, cx, cy + radius, phosphor_d).

    // Navis in centro referentiae sonar.
    f = CBGRA_LINEA(c, cx, cy - 10, cx - 7, cy + 8, echo).
    f = CBGRA_LINEA(c, cx - 7, cy + 8, cx + 7, cy + 8, echo).
    f = CBGRA_LINEA(c, cx + 7, cy + 8, cx, cy - 10, echo).
    f = CBGRA_CIRCULUS(c, cx, cy, 14, echo).

    DECLARA t SICUT TEXTUS VALENS "".
    DECLARA res_vis SICUT NUMERUS VALENS NAT_RES_VISIBILIS(s).

    // Contact mineralis in coordonnatis mundi relative ad player.
    SI res_vis != 0 TUNC
        DECLARA rr SICUT NUMERUS VALENS CONTENTUM(s + 160).
        DECLARA rx SICUT NUMERUS VALENS cx + (CONTENTUM(s + 168) - CONTENTUM(s + 40)) * radius / rr.
        DECLARA ry SICUT NUMERUS VALENS cy + (CONTENTUM(s + 176) - CONTENTUM(s + 48)) * radius / rr.
        f = CBGRA_CIRCULUS(c, rx, ry, 8, amber).
        f = CBGRA_LINEA(c, rx - 10, ry, rx + 10, ry, amber).
        f = CBGRA_LINEA(c, rx, ry - 10, rx, ry + 10, amber).
        f = CBGRA_RECT(c, rx - 2, ry - 2, 5, 5, amber).
    FIN-SI.

    // Cursus activus.
    SI CONTENTUM(s + 80) != 0 TUNC
        DECLARA range SICUT NUMERUS VALENS CONTENTUM(s + 160).
        DECLARA dx SICUT NUMERUS VALENS CONTENTUM(s + 104) - CONTENTUM(s + 40).
        DECLARA dy SICUT NUMERUS VALENS CONTENTUM(s + 112) - CONTENTUM(s + 48).
        DECLARA tx SICUT NUMERUS VALENS cx + dx * radius / range.
        DECLARA ty SICUT NUMERUS VALENS cy + dy * radius / range.
        f = CBGRA_LINEA(c, cx, cy, tx, ty, echo).
        f = CBGRA_CIRCULUS(c, tx, ty, 7, amber).
        f = CBGRA_LINEA(c, tx - 10, ty, tx + 10, ty, amber).
        f = CBGRA_LINEA(c, tx, ty - 10, tx, ty + 10, amber).
        SI CONTENTUM(s + 192) != 0 TUNC
            f = FB5_TEXTUS(c, 18, 58, "SONAR // MINERAL APPROACH", 2, amber).
        ALITER
            f = FB5_TEXTUS(c, 18, 58, "SONAR // EN ROUTE", 2, echo).
        FIN-SI.
    ALITER
        SI CONTENTUM(s + 200) != 0 TUNC
            f = FB5_TEXTUS(c, 18, 58, "SONAR // EXTRACTION ACTIVE", 2, amber).
        ALITER
            SI res_vis != 0 TUNC
                f = FB5_TEXTUS(c, 18, 58, "SONAR // MINERAL CONTACT", 2, amber).
            ALITER
                f = FB5_TEXTUS(c, 18, 58, "SONAR // READY - CLICK TO NAVIGATE", 2, echo).
            FIN-SI.
        FIN-SI.
    FIN-SI.

    // HUD.
    t = "DEPTH " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 24)).
    t = t + " M".
    f = FB5_TEXTUS(c, 432, 90, t, 2, echo).
    t = "OXYGEN " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 0) / 10).
    f = FB5_TEXTUS(c, 432, 118, t, 2, text_d).
    f = NAT_UI_BAR(c, 432, 136, 196, CONTENTUM(s + 0), phosphor).
    t = "ENERGY " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 8) / 10).
    f = FB5_TEXTUS(c, 432, 157, t, 2, text_d).
    f = NAT_UI_BAR(c, 432, 175, 196, CONTENTUM(s + 8), phosphor).
    t = "HULL " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 16) / 10).
    f = FB5_TEXTUS(c, 432, 196, t, 2, text_d).
    f = NAT_UI_BAR(c, 432, 214, 196, CONTENTUM(s + 16), phosphor).
    t = "CREDITS " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 32)).
    f = FB5_TEXTUS(c, 432, 237, t, 2, amber).

    // Coordonnatae + cargo.
    t = "X " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 40)).
    t = t + "  Y " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 48)).
    f = FB5_TEXTUS(c, 18, 680, t, 2, text_d).
    t = "RANGE " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 160)).
    t = t + " M".
    f = FB5_TEXTUS(c, 270, 680, t, 2, text_d).
    t = "ORE " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 216)).
    t = t + "/40".
    f = FB5_TEXTUS(c, 500, 680, t, 2, amber).

    DECLARA regio SICUT NUMERUS VALENS NAT_MUNDUS_REGIO(CONTENTUM(s + 56), CONTENTUM(s + 40), CONTENTUM(s + 48)).
    DECLARA relief SICUT NUMERUS VALENS NAT_MUNDUS_RELIEF(CONTENTUM(s + 56), CONTENTUM(s + 40), CONTENTUM(s + 48)).
    DECLARA nomen_regio SICUT TEXTUS VALENS "UPPER SLOPE".
    SI regio == 2 TUNC nomen_regio = "LOWER SLOPE". FIN-SI.
    SI regio == 3 TUNC nomen_regio = "ABYSSAL PLAIN". FIN-SI.
    SI regio == 4 TUNC nomen_regio = "DEEP BASIN". FIN-SI.
    SI regio == 5 TUNC nomen_regio = "HADAL TRENCH". FIN-SI.
    DECLARA nomen_relief SICUT TEXTUS VALENS "SMOOTH".
    SI relief == 2 TUNC nomen_relief = "ROLLING". FIN-SI.
    SI relief == 3 TUNC nomen_relief = "BROKEN". FIN-SI.
    SI relief == 4 TUNC nomen_relief = "ESCARPMENT". FIN-SI.

    f = FB5_TEXTUS(c, 660, 78, "DIVE CORE ONLINE", 2, phosphor).

    SI CONTENTUM(s + 200) != 0 TUNC
        f = FB5_TEXTUS(c, 660, 104, "EXTRACTION ACTIVE", 2, amber).
        f = FB5_TEXTUS(c, 660, 130, "FERROUS NODULES", 2, echo).
        t = "ORE " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 216)).
        t = t + " / 40".
        f = FB5_TEXTUS(c, 660, 156, t, 2, text_d).
        t = "DEPOSIT " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 224)).
        f = FB5_TEXTUS(c, 660, 182, t, 2, amber).
        f = FB5_TEXTUS(c, 660, 208, "ENERGY -0.3 / TICK", 2, text_d).
        t = "REGION " + nomen_regio.
        f = FB5_TEXTUS(c, 660, 246, t, 2, echo).
        t = "SEABED " + nomen_relief.
        f = FB5_TEXTUS(c, 660, 272, t, 2, text_d).
    ALITER
        SI CONTENTUM(s + 80) != 0 TUNC
            SI CONTENTUM(s + 192) != 0 TUNC
                f = FB5_TEXTUS(c, 660, 104, "MINERAL APPROACH", 2, amber).
                f = FB5_TEXTUS(c, 660, 130, "FERROUS NODULES", 2, echo).
            ALITER
                f = FB5_TEXTUS(c, 660, 104, "COURSE ACTIVE", 2, echo).
                t = "TARGET X " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 104)).
                f = FB5_TEXTUS(c, 660, 130, t, 2, text_d).
            FIN-SI.
            t = "TARGET Y " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 112)).
            f = FB5_TEXTUS(c, 660, 156, t, 2, text_d).
            t = "DIST " + TEXTUS_EX_NUMERO_DECIMALI(NAT_CURSUS_RELIQUUM(s)).
            t = t + " M".
            f = FB5_TEXTUS(c, 660, 182, t, 2, amber).
            DECLARA progressus SICUT NUMERUS VALENS NAT_CURSUS_PROGRESSUS(s).
            t = "PROGRESS " + TEXTUS_EX_NUMERO_DECIMALI(progressus / 10).
            t = t + "%".
            f = FB5_TEXTUS(c, 660, 208, t, 2, text_d).
            f = NAT_UI_BAR(c, 660, 230, 270, progressus, echo).
            t = "REGION " + nomen_regio.
            f = FB5_TEXTUS(c, 660, 258, t, 2, echo).
            t = "SEABED " + nomen_relief.
            f = FB5_TEXTUS(c, 660, 284, t, 2, text_d).
        ALITER
            SI res_vis != 0 TUNC
                f = FB5_TEXTUS(c, 660, 104, "MINERAL CONTACT", 2, amber).
                f = FB5_TEXTUS(c, 660, 130, "FERROUS NODULES", 2, echo).
                f = FB5_TEXTUS(c, 660, 156, "CLICK AMBER CONTACT", 2, text_d).
                t = "DEPOSIT " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 224)).
                f = FB5_TEXTUS(c, 660, 182, t, 2, amber).
                t = "REGION " + nomen_regio.
                f = FB5_TEXTUS(c, 660, 220, t, 2, echo).
                t = "SEABED " + nomen_relief.
                f = FB5_TEXTUS(c, 660, 246, t, 2, text_d).
            ALITER
                f = FB5_TEXTUS(c, 660, 104, "CLICK SONAR TO SET COURSE", 2, text_d).
                f = FB5_TEXTUS(c, 660, 130, "WORLD RADIUS 3000 KM", 2, text_d).
                f = FB5_TEXTUS(c, 660, 156, "ESC OR WINDOW X TO EXIT", 2, text_d).
                t = "REGION " + nomen_regio.
                f = FB5_TEXTUS(c, 660, 194, t, 2, echo).
                t = "SEABED " + nomen_relief.
                f = FB5_TEXTUS(c, 660, 220, t, 2, text_d).
            FIN-SI.
        FIN-SI.
    FIN-SI.

    SI CONTENTUM(s + 64) == 0 TUNC
        f = FB5_TEXTUS(c, 660, 330, "SIGNAL LOST", 2, danger).
    FIN-SI.

    REDDE 1.
FIN-FUNCTIO.
