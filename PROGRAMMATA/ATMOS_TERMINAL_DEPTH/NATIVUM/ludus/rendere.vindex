// ATMOS NATIVUM — renderer unicus in canvas BGRA.
// Nullus TextOutA, nullus overlay GDI: omnia hic ante unicam praesentatiionem.

FUNCTIO NAT_UI_BAR REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT valor_x10 SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA fundum SICUT NUMERUS VALENS CBGRA_COLOR(10, 30, 22).
    DECLARA lim SICUT NUMERUS VALENS NAT_CLAMPA(valor_x10, 0, 1000) * w / 1000.
    DECLARA f SICUT NUMERUS VALENS CBGRA_RECT(c, x, y, w, 8, fundum).
    SI lim > 0 TUNC f = CBGRA_RECT(c, x, y, lim, 8, color). FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NAT_RENDE REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT s SICUT NUMERUS.
    SI c <= 0 || s <= 0 TUNC REDDE 0. FIN-SI.

    DECLARA void SICUT NUMERUS VALENS CBGRA_COLOR(10, 24, 18).
    DECLARA panel SICUT NUMERUS VALENS CBGRA_COLOR(16, 40, 32).
    DECLARA edge SICUT NUMERUS VALENS CBGRA_COLOR(45, 107, 78).
    DECLARA phosphor SICUT NUMERUS VALENS CBGRA_COLOR(125, 255, 192).
    DECLARA phosphor_d SICUT NUMERUS VALENS CBGRA_COLOR(58, 154, 98).
    DECLARA echo SICUT NUMERUS VALENS CBGRA_COLOR(143, 245, 246).
    DECLARA amber SICUT NUMERUS VALENS CBGRA_COLOR(255, 208, 128).
    DECLARA text_d SICUT NUMERUS VALENS CBGRA_COLOR(176, 196, 184).
    DECLARA danger SICUT NUMERUS VALENS CBGRA_COLOR(255, 128, 144).

    DECLARA f SICUT NUMERUS VALENS CBGRA_LIMPA(c, void).
    // Header et separatio desktop sicut layout HTML.
    f = CBGRA_RECT(c, 0, 0, 960, 52, panel).
    f = CBGRA_RECT(c, 0, 50, 960, 2, edge).
    f = CBGRA_RECT(c, 648, 52, 2, 668, edge).
    f = FB5_TEXTUS(c, 18, 17, "ATMOS // TERMINAL DEPTH", 2, phosphor).
    f = FB5_TEXTUS(c, 690, 19, "SYSTEM LOG", 1, phosphor).

    // Sonar 600x600 logicum intra tabulam sinistram.
    DECLARA cx SICUT NUMERUS VALENS 324.
    DECLARA cy SICUT NUMERUS VALENS 374.
    DECLARA radius SICUT NUMERUS VALENS 270.
    f = CBGRA_CIRCULUS(c, cx, cy, 90, phosphor_d).
    f = CBGRA_CIRCULUS(c, cx, cy, 180, phosphor_d).
    f = CBGRA_CIRCULUS(c, cx, cy, radius, phosphor_d).
    f = CBGRA_LINEA(c, cx - radius, cy, cx + radius, cy, phosphor_d).
    f = CBGRA_LINEA(c, cx, cy - radius, cx, cy + radius, phosphor_d).

    // Navis in centro referentiae sonar.
    f = CBGRA_LINEA(c, cx, cy - 10, cx - 7, cy + 8, echo).
    f = CBGRA_LINEA(c, cx - 7, cy + 8, cx + 7, cy + 8, echo).
    f = CBGRA_LINEA(c, cx + 7, cy + 8, cx, cy - 10, echo).
    f = CBGRA_CIRCULUS(c, cx, cy, 14, echo).

    // Cursus: destinatio relative ad navem, appropinquans centro dum movetur.
    SI CONTENTUM(s + 80) != 0 TUNC
        DECLARA range SICUT NUMERUS VALENS CONTENTUM(s + 160).
        DECLARA dx SICUT NUMERUS VALENS CONTENTUM(s + 104) - CONTENTUM(s + 40).
        DECLARA dy SICUT NUMERUS VALENS CONTENTUM(s + 112) - CONTENTUM(s + 48).
        DECLARA tx SICUT NUMERUS VALENS cx + dx * radius / range.
        DECLARA ty SICUT NUMERUS VALENS cy + dy * radius / range.
        f = CBGRA_LINEA(c, cx, cy, tx, ty, echo).
        f = CBGRA_CIRCULUS(c, tx, ty, 6, amber).
        f = FB5_TEXTUS(c, 18, 62, "SONAR // EN ROUTE", 1, echo).
    ALITER
        f = FB5_TEXTUS(c, 18, 62, "SONAR // READY - CLICK TO NAVIGATE", 1, echo).
    FIN-SI.

    // Resource HUD unicus intra canvas.
    f = CBGRA_RECT(c, 425, 72, 205, 178, panel).
    f = CBGRA_RECT(c, 425, 72, 205, 1, edge).
    DECLARA t SICUT TEXTUS VALENS "DEPTH " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 24)).
    t = t + " M".
    f = FB5_TEXTUS(c, 438, 85, t, 1, echo).
    t = "OXYGEN " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 0) / 10).
    f = FB5_TEXTUS(c, 438, 112, t, 1, text_d).
    f = NAT_UI_BAR(c, 438, 126, 178, CONTENTUM(s + 0), phosphor).
    t = "ENERGY " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 8) / 10).
    f = FB5_TEXTUS(c, 438, 147, t, 1, text_d).
    f = NAT_UI_BAR(c, 438, 161, 178, CONTENTUM(s + 8), phosphor).
    t = "HULL " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 16) / 10).
    f = FB5_TEXTUS(c, 438, 182, t, 1, text_d).
    f = NAT_UI_BAR(c, 438, 196, 178, CONTENTUM(s + 16), phosphor).
    t = "CREDITS " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 32)).
    f = FB5_TEXTUS(c, 438, 220, t, 1, amber).

    // Coordonnatae et range infra sonar.
    t = "X " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 40)).
    t = t + "  Y " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 48)).
    f = FB5_TEXTUS(c, 18, 688, t, 1, text_d).
    t = "RANGE " + TEXTUS_EX_NUMERO_DECIMALI(CONTENTUM(s + 160)).
    t = t + " M".
    f = FB5_TEXTUS(c, 250, 688, t, 1, text_d).

    // Journal minimal, eiusdem framebuffer pars.
    f = FB5_TEXTUS(c, 670, 72, "DIVE CORE ONLINE", 1, phosphor).
    f = FB5_TEXTUS(c, 670, 94, "CLICK SONAR TO SET COURSE", 1, text_d).
    f = FB5_TEXTUS(c, 670, 116, "WORLD RADIUS 3000 KM", 1, text_d).
    f = FB5_TEXTUS(c, 670, 138, "ESC OR WINDOW X TO EXIT", 1, text_d).
    SI CONTENTUM(s + 64) == 0 TUNC
        f = FB5_TEXTUS(c, 670, 184, "SIGNAL LOST", 2, danger).
    FIN-SI.

    // Scanlines simulatae in ipso canvas, non overlay alterius API.
    DECLARA y SICUT NUMERUS VALENS 55.
    DUM y < 720 PERFICE
        f = CBGRA_RECT(c, 0, y, 960, 1, CBGRA_COLOR(8, 20, 15)).
        y = y + 4.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.
