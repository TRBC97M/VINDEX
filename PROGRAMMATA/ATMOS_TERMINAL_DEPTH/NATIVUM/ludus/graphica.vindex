// ATMOS NATIVUM — pont Graphica resolutione independens.
// Spatium logicum UI manet 960x720; canvas physicus nunc a Stabilitas II ad 720p software capitur.
// Stabilitas II: bulk alpha utitur via celere; phosphor duplicatus et scanlines superfluae minuuntur.

FUNCTIO NATG_X REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    REDDE x * CBGRA_W(c) / 960.
FIN-FUNCTIO.

FUNCTIO NATG_Y REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    REDDE y * CBGRA_H(c) / 720.
FIN-FUNCTIO.

FUNCTIO NATG_R REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT r SICUT NUMERUS.
    DECLARA rr SICUT NUMERUS VALENS r * CBGRA_H(c) / 720.
    SI rr < 1 TUNC rr = 1. FIN-SI.
    REDDE rr.
FIN-FUNCTIO.

FUNCTIO NATG_CRASSITUDO REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT base SICUT NUMERUS.
    DECLARA t SICUT NUMERUS VALENS base * CBGRA_H(c) / 720.
    SI t < 1 TUNC t = 1. FIN-SI.
    REDDE t.
FIN-FUNCTIO.

FUNCTIO NATG_ABS REDDENS NUMERUS.
    ACCIPIT v SICUT NUMERUS.
    SI v < 0 TUNC REDDE 0 - v. FIN-SI.
    REDDE v.
FIN-FUNCTIO.

// Velum circulare impletum pro contactibus et phosphore sonar.
FUNCTIO NATG_DISC_ALPHA REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT cx SICUT NUMERUS.
    ACCIPIT cy SICUT NUMERUS.
    ACCIPIT radius SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    SI c <= 0 || radius <= 0 || alpha <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA pcx SICUT NUMERUS VALENS NATG_X(c, cx).
    DECLARA pcy SICUT NUMERUS VALENS NATG_Y(c, cy).
    DECLARA pr SICUT NUMERUS VALENS NATG_R(c, radius).
    DECLARA yy SICUT NUMERUS VALENS 0 - pr.
    DUM yy <= pr PERFICE
        DECLARA rest SICUT NUMERUS VALENS pr * pr - yy * yy.
        DECLARA ext SICUT NUMERUS VALENS NAT_ISQRT(rest).
        DECLARA q SICUT NUMERUS VALENS CBGRA_RECT_ALPHA_CELER(c, pcx - ext, pcy + yy, ext * 2 + 1, 1, color, alpha).
        yy = yy + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

// Strates horizontales CRT/sonar legeres. Conservata pro API, non adhibita in magno sonar Stabilitas II.
FUNCTIO NATG_SONAR_STRATA REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT cx SICUT NUMERUS.
    ACCIPIT cy SICUT NUMERUS.
    ACCIPIT radius SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    SI c <= 0 || radius <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA yy SICUT NUMERUS VALENS 0 - radius.
    DUM yy <= radius PERFICE
        DECLARA ay SICUT NUMERUS VALENS NATG_ABS(yy).
        DECLARA ext SICUT NUMERUS VALENS radius - ay * ay / radius.
        SI ext > 0 TUNC
            DECLARA a SICUT NUMERUS VALENS alpha.
            SI (ay / 12) % 3 == 0 TUNC a = alpha + 8. FIN-SI.
            DECLARA q SICUT NUMERUS VALENS CBGRA_LINEA_ALPHA(c, NATG_X(c, cx - ext), NATG_Y(c, cy + yy), NATG_X(c, cx + ext), NATG_Y(c, cy + yy), color, a).
        FIN-SI.
        yy = yy + 12.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NATG_SONAR_FAN REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT cx SICUT NUMERUS.
    ACCIPIT cy SICUT NUMERUS.
    ACCIPIT x1 SICUT NUMERUS.
    ACCIPIT y1 SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    SI c <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA dx SICUT NUMERUS VALENS x1 - cx.
    DECLARA dy SICUT NUMERUS VALENS y1 - cy.
    SI dx == 0 && dy == 0 TUNC REDDE 1. FIN-SI.

    DECLARA x55 SICUT NUMERUS VALENS cx + (dx * 574 + dy * 819) / 1000.
    DECLARA y55 SICUT NUMERUS VALENS cy + ((0 - dx) * 819 + dy * 574) / 1000.
    DECLARA x34 SICUT NUMERUS VALENS cx + (dx * 829 + dy * 559) / 1000.
    DECLARA y34 SICUT NUMERUS VALENS cy + ((0 - dx) * 559 + dy * 829) / 1000.
    DECLARA x17 SICUT NUMERUS VALENS cx + (dx * 956 + dy * 292) / 1000.
    DECLARA y17 SICUT NUMERUS VALENS cy + ((0 - dx) * 292 + dy * 956) / 1000.

    DECLARA pcx SICUT NUMERUS VALENS NATG_X(c, cx).
    DECLARA pcy SICUT NUMERUS VALENS NATG_Y(c, cy).
    DECLARA phx SICUT NUMERUS VALENS NATG_X(c, x1).
    DECLARA phy SICUT NUMERUS VALENS NATG_Y(c, y1).

    DECLARA rgba SICUT NUMERUS VALENS CBGRA_COLOR_ALPHA(color, 13).
    DECLARA q SICUT NUMERUS VALENS CBGRA_TRIANGULUM_ALPHA(c, pcx, pcy, phx, phy, NATG_X(c, x55), NATG_Y(c, y55), rgba).
    rgba = CBGRA_COLOR_ALPHA(color, 22).
    q = CBGRA_TRIANGULUM_ALPHA(c, pcx, pcy, phx, phy, NATG_X(c, x34), NATG_Y(c, y34), rgba).
    rgba = CBGRA_COLOR_ALPHA(color, 34).
    q = CBGRA_TRIANGULUM_ALPHA(c, pcx, pcy, phx, phy, NATG_X(c, x17), NATG_Y(c, y17), rgba).
    q = CBGRA_LINEA_ALPHA(c, pcx, pcy, NATG_X(c, x55), NATG_Y(c, y55), color, 28).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NATG_RECT_CHAMFER REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    ACCIPIT margo SICUT NUMERUS.
    SI c <= 0 || w <= 0 || h <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA x0 SICUT NUMERUS VALENS NATG_X(c, x).
    DECLARA y0 SICUT NUMERUS VALENS NATG_Y(c, y).
    DECLARA x1 SICUT NUMERUS VALENS NATG_X(c, x + w).
    DECLARA y1 SICUT NUMERUS VALENS NATG_Y(c, y + h).
    DECLARA ww SICUT NUMERUS VALENS x1 - x0.
    DECLARA hh SICUT NUMERUS VALENS y1 - y0.
    DECLARA rr SICUT NUMERUS VALENS NATG_R(c, margo).
    SI rr < 1 TUNC rr = 1. FIN-SI.
    DECLARA row SICUT NUMERUS VALENS 0.
    DUM row < hh PERFICE
        DECLARA d SICUT NUMERUS VALENS row.
        SI hh - 1 - row < d TUNC d = hh - 1 - row. FIN-SI.
        DECLARA inset SICUT NUMERUS VALENS 0.
        SI d < rr TUNC
            DECLARA qd SICUT NUMERUS VALENS rr - d.
            inset = qd * qd / (rr * 2 + 1).
        FIN-SI.
        DECLARA a SICUT NUMERUS VALENS alpha.
        SI hh > 1 TUNC a = alpha - alpha * row / (hh * 3). FIN-SI.
        SI a < 24 TUNC a = 24. FIN-SI.
        DECLARA span SICUT NUMERUS VALENS ww - inset * 2.
        SI span > 0 TUNC DECLARA q SICUT NUMERUS VALENS CBGRA_RECT_ALPHA_CELER(c, x0 + inset, y0 + row, span, 1, color, a). FIN-SI.
        row = row + 1.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NATG_RECT REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA x0 SICUT NUMERUS VALENS NATG_X(c, x).
    DECLARA y0 SICUT NUMERUS VALENS NATG_Y(c, y).
    DECLARA x1 SICUT NUMERUS VALENS NATG_X(c, x + w).
    DECLARA y1 SICUT NUMERUS VALENS NATG_Y(c, y + h).
    DECLARA ww SICUT NUMERUS VALENS x1 - x0.
    DECLARA hh SICUT NUMERUS VALENS y1 - y0.
    SI ww < 1 TUNC ww = 1. FIN-SI.
    SI hh < 1 TUNC hh = 1. FIN-SI.
    SI hh <= 2 TUNC REDDE CBGRA_RECT(c, x0, y0, ww, hh, color). FIN-SI.
    SI w >= 90 && h >= 26 && w < 900 TUNC REDDE NATG_RECT_CHAMFER(c, x, y, w, h, color, 235, 7). FIN-SI.
    REDDE CBGRA_RECT_DEGRADE_V_CELER(c, x0, y0, ww, hh, color, 255, 218).
FIN-FUNCTIO.

FUNCTIO NATG_RECT_ALPHA REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT alpha SICUT NUMERUS.
    DECLARA x0 SICUT NUMERUS VALENS NATG_X(c, x).
    DECLARA y0 SICUT NUMERUS VALENS NATG_Y(c, y).
    DECLARA x1 SICUT NUMERUS VALENS NATG_X(c, x + w).
    DECLARA y1 SICUT NUMERUS VALENS NATG_Y(c, y + h).
    DECLARA ww SICUT NUMERUS VALENS x1 - x0.
    DECLARA hh SICUT NUMERUS VALENS y1 - y0.
    SI ww < 1 TUNC ww = 1. FIN-SI.
    SI hh < 1 TUNC hh = 1. FIN-SI.
    SI w >= 90 && h >= 26 && w < 900 TUNC REDDE NATG_RECT_CHAMFER(c, x, y, w, h, color, alpha, 7). FIN-SI.
    DECLARA bas SICUT NUMERUS VALENS alpha * 3 / 5.
    SI hh <= 2 TUNC REDDE CBGRA_RECT_ALPHA_CELER(c, x0, y0, ww, hh, color, alpha). FIN-SI.
    REDDE CBGRA_RECT_DEGRADE_V_CELER(c, x0, y0, ww, hh, color, alpha, bas).
FIN-FUNCTIO.

FUNCTIO NATG_PANEL REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    ACCIPIT edge SICUT NUMERUS.
    DECLARA x0 SICUT NUMERUS VALENS NATG_X(c, x).
    DECLARA y0 SICUT NUMERUS VALENS NATG_Y(c, y).
    DECLARA x1 SICUT NUMERUS VALENS NATG_X(c, x + w).
    DECLARA y1 SICUT NUMERUS VALENS NATG_Y(c, y + h).
    DECLARA ww SICUT NUMERUS VALENS x1 - x0.
    DECLARA hh SICUT NUMERUS VALENS y1 - y0.
    DECLARA q SICUT NUMERUS VALENS NATG_RECT_CHAMFER(c, x, y, w, h, color, 205, 8).
    q = CBGRA_RECT_GLOW(c, x0, y0, ww, hh, edge).
    q = CBGRA_LINEA_MOLLIS(c, x0 + NATG_R(c,8), y0, x1 - NATG_R(c,8), y0, NATG_CRASSITUDO(c,1), edge, 180).
    q = CBGRA_LINEA_MOLLIS(c, x0 + NATG_R(c,8), y1 - 1, x1 - NATG_R(c,8), y1 - 1, NATG_CRASSITUDO(c,1), edge, 70).
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NATG_LINEA REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x0 SICUT NUMERUS.
    ACCIPIT y0 SICUT NUMERUS.
    ACCIPIT x1 SICUT NUMERUS.
    ACCIPIT y1 SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    REDDE CBGRA_LINEA_MOLLIS(c, NATG_X(c, x0), NATG_Y(c, y0), NATG_X(c, x1), NATG_Y(c, y1), NATG_CRASSITUDO(c,1), color, 190).
FIN-FUNCTIO.

FUNCTIO NATG_LINEA_GLOW REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x0 SICUT NUMERUS.
    ACCIPIT y0 SICUT NUMERUS.
    ACCIPIT x1 SICUT NUMERUS.
    ACCIPIT y1 SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    SI x0 == 324 && y0 == 374 && color == CBGRA_COLOR(48, 132, 86) TUNC
        DECLARA d SICUT NUMERUS VALENS NATG_ABS(x1 - x0).
        SI NATG_ABS(y1 - y0) > d TUNC d = NATG_ABS(y1 - y0). FIN-SI.
        SI d >= 220 TUNC DECLARA fan SICUT NUMERUS VALENS NATG_SONAR_FAN(c, x0, y0, x1, y1, color). FIN-SI.
    FIN-SI.
    REDDE CBGRA_LINEA_GLOW(c, NATG_X(c, x0), NATG_Y(c, y0), NATG_X(c, x1), NATG_Y(c, y1), color).
FIN-FUNCTIO.

FUNCTIO NATG_CIRCULUS REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT cx SICUT NUMERUS.
    ACCIPIT cy SICUT NUMERUS.
    ACCIPIT radius SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    SI radius <= 72 TUNC DECLARA v SICUT NUMERUS VALENS NATG_DISC_ALPHA(c, cx, cy, radius, color, 28). FIN-SI.
    REDDE CBGRA_CIRCULUS_MOLLIS(c, NATG_X(c, cx), NATG_Y(c, cy), NATG_R(c, radius), color).
FIN-FUNCTIO.

FUNCTIO NATG_CIRCULUS_GLOW REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT cx SICUT NUMERUS.
    ACCIPIT cy SICUT NUMERUS.
    ACCIPIT radius SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    SI radius <= 36 TUNC DECLARA v SICUT NUMERUS VALENS NATG_DISC_ALPHA(c, cx, cy, radius, color, 26). FIN-SI.
    // Radius magnus: renderer iam velum sonar semel ponit. Duplicatio per-pixel hic remota est.
    REDDE CBGRA_CIRCULUS_GLOW(c, NATG_X(c, cx), NATG_Y(c, cy), NATG_R(c, radius), color).
FIN-FUNCTIO.

FUNCTIO NATG_TEXT_GRADUS REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT scala SICUT NUMERUS.
    DECLARA g SICUT NUMERUS VALENS scala * CBGRA_H(c) / 540.
    SI g < 2 TUNC g = 2. FIN-SI.
    REDDE g.
FIN-FUNCTIO.

FUNCTIO NATG_TEXT REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    ACCIPIT scala SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    REDDE FS5_TEXTUS(c, NATG_X(c, x), NATG_Y(c, y), textus, NATG_TEXT_GRADUS(c, scala), color).
FIN-FUNCTIO.

FUNCTIO NATG_TEXT_GLOW REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT textus SICUT TEXTUS.
    ACCIPIT scala SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    REDDE FS5_TEXTUS_GLOW(c, NATG_X(c, x), NATG_Y(c, y), textus, NATG_TEXT_GRADUS(c, scala), color).
FIN-FUNCTIO.

FUNCTIO NATG_BAR REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT x SICUT NUMERUS.
    ACCIPIT y SICUT NUMERUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT valor_x10 SICUT NUMERUS.
    ACCIPIT color SICUT NUMERUS.
    DECLARA fundum SICUT NUMERUS VALENS CBGRA_COLOR(7, 27, 20).
    DECLARA lim SICUT NUMERUS VALENS NAT_CLAMPA(valor_x10, 0, 1000) * w / 1000.
    DECLARA f SICUT NUMERUS VALENS NATG_RECT_ALPHA(c, x, y, w, 7, fundum, 150).
    SI lim > 0 TUNC
        f = NATG_RECT_ALPHA(c, x, y, lim, 7, color, 195).
        f = NATG_LINEA(c, x, y, x + lim, y, color).
        f = NATG_LINEA_GLOW(c, x + lim, y, x + lim, y + 6, color).
    FIN-SI.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NATG_SCANLINES REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT y0 SICUT NUMERUS.
    DECLARA dark SICUT NUMERUS VALENS CBGRA_COLOR(0, 7, 4).
    DECLARA y SICUT NUMERUS VALENS y0.
    DUM y < 720 PERFICE
        DECLARA f SICUT NUMERUS VALENS NATG_RECT_ALPHA(c, 0, y, 960, 1, dark, 18).
        y = y + 10.
    FIN-DUM.
    REDDE 1.
FIN-FUNCTIO.