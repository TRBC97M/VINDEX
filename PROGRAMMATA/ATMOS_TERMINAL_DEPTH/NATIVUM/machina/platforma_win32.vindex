// ATMOS NATIVUM — platforma Win32 minima, tota VINDEX.
// Client importare debet textus.vindex et win32_ffi.vindex.
// Haec unitas solum fenestram principalem veram creat.
// Eventa/raster/presentatio per bibliothecam Win32 applicativam aguntur.

// Contextus LXIV octeta:
// +0 user32, +8 kernel32,
// +16 CreateWindowExA, +24 GetModuleHandleA,
// +32 RegisterClassExA, +40 DefWindowProcA,
// +48 LoadCursorA, +56 classis registrata 0/1.
FUNCTIO NATWIN_CREA REDDENS NUMERUS.
    DECLARA c SICUT NUMERUS VALENS RESERVA_OCTETA(64).
    SI c <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA u SICUT NUMERUS VALENS WIN32_MODULUM_APERI("user32.dll").
    DECLARA k SICUT NUMERUS VALENS WIN32_MODULUM_APERI("kernel32.dll").
    SI u == 0 || k == 0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(c + 0) = u.
    CONTENTUM(c + 8) = k.
    CONTENTUM(c + 16) = WIN32_SYMBOLUM(u, "CreateWindowExA").
    CONTENTUM(c + 24) = WIN32_SYMBOLUM(k, "GetModuleHandleA").
    CONTENTUM(c + 32) = WIN32_SYMBOLUM(u, "RegisterClassExA").
    CONTENTUM(c + 40) = WIN32_SYMBOLUM(u, "DefWindowProcA").
    CONTENTUM(c + 48) = WIN32_SYMBOLUM(u, "LoadCursorA").
    CONTENTUM(c + 56) = 0.
    SI CONTENTUM(c + 16) == 0 || CONTENTUM(c + 24) == 0 || CONTENTUM(c + 32) == 0 || CONTENTUM(c + 40) == 0 || CONTENTUM(c + 48) == 0 TUNC REDDE 0. FIN-SI.
    REDDE c.
FIN-FUNCTIO.

FUNCTIO NATWIN_HINSTANCE REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    SI c <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA a SICUT ORDO DE NUMERUS CAPACITAS 16.
    DECLARA p SICUT NUMERUS VALENS SEDES(a).
    DECLARA ig SICUT NUMERUS VALENS MSX64_ARGUMENTA_VACUA(p).
    CONTENTUM(p) = 0.
    REDDE MSX64_VOCA(CONTENTUM(c + 24), p).
FIN-FUNCTIO.

FUNCTIO NATWIN_CLASSIS REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    SI c <= 0 TUNC REDDE 0. FIN-SI.
    SI CONTENTUM(c + 56) == 1 TUNC REDDE 1. FIN-SI.
    DECLARA hinstance SICUT NUMERUS VALENS NATWIN_HINSTANCE(c).
    SI hinstance == 0 TUNC REDDE 0. FIN-SI.

    DECLARA a SICUT ORDO DE NUMERUS CAPACITAS 16.
    DECLARA p SICUT NUMERUS VALENS SEDES(a).
    DECLARA ig SICUT NUMERUS VALENS MSX64_ARGUMENTA_VACUA(p).
    CONTENTUM(p + 0) = 0.
    CONTENTUM(p + 8) = 32512.
    DECLARA cursor SICUT NUMERUS VALENS MSX64_VOCA(CONTENTUM(c + 48), p).

    // WNDCLASSEXA Win64: 80 octeta.
    DECLARA wc SICUT NUMERUS VALENS RESERVA_OCTETA(80).
    SI wc <= 0 TUNC REDDE 0. FIN-SI.
    DECLARA i SICUT NUMERUS VALENS 0.
    DUM i < 80 PERFICE SCRIBE_OCTETUM_AB(wc + i, 0). i = i + 1. FIN-DUM.
    SCRIBE_OCTETUM_AB(wc + 0, 80).
    SCRIBE_OCTETUM_AB(wc + 4, 3). // CS_VREDRAW | CS_HREDRAW
    CONTENTUM(wc + 8) = CONTENTUM(c + 40).
    CONTENTUM(wc + 24) = hinstance.
    CONTENTUM(wc + 40) = cursor.
    DECLARA classis SICUT TEXTUS VALENS "ATMOS_NATIVUM".
    CONTENTUM(wc + 64) = TEXTUS_BASIS_OCTETORUM(classis).

    ig = MSX64_ARGUMENTA_VACUA(p).
    CONTENTUM(p) = wc.
    DECLARA atom SICUT NUMERUS VALENS MSX64_VOCA(CONTENTUM(c + 32), p).
    SI atom == 0 TUNC REDDE 0. FIN-SI.
    CONTENTUM(c + 56) = 1.
    REDDE 1.
FIN-FUNCTIO.

FUNCTIO NATWIN_FENESTRA REDDENS NUMERUS.
    ACCIPIT c SICUT NUMERUS.
    ACCIPIT titulus SICUT TEXTUS.
    ACCIPIT w SICUT NUMERUS.
    ACCIPIT h SICUT NUMERUS.
    SI c <= 0 || w <= 0 || h <= 0 TUNC REDDE 0. FIN-SI.
    SI NATWIN_CLASSIS(c) == 0 TUNC REDDE 0. FIN-SI.
    DECLARA hinstance SICUT NUMERUS VALENS NATWIN_HINSTANCE(c).
    SI hinstance == 0 TUNC REDDE 0. FIN-SI.

    DECLARA a SICUT ORDO DE NUMERUS CAPACITAS 16.
    DECLARA p SICUT NUMERUS VALENS SEDES(a).
    DECLARA ig SICUT NUMERUS VALENS MSX64_ARGUMENTA_VACUA(p).
    DECLARA classis SICUT TEXTUS VALENS "ATMOS_NATIVUM".
    CONTENTUM(p + 0) = 0.
    CONTENTUM(p + 8) = TEXTUS_BASIS_OCTETORUM(classis).
    CONTENTUM(p + 16) = TEXTUS_BASIS_OCTETORUM(titulus).
    CONTENTUM(p + 24) = 13565952. // WS_OVERLAPPEDWINDOW
    CONTENTUM(p + 32) = 80.
    CONTENTUM(p + 40) = 80.
    CONTENTUM(p + 48) = w.
    CONTENTUM(p + 56) = h.
    CONTENTUM(p + 64) = 0.
    CONTENTUM(p + 72) = 0.
    CONTENTUM(p + 80) = hinstance.
    CONTENTUM(p + 88) = 0.
    REDDE MSX64_VOCA(CONTENTUM(c + 16), p).
FIN-FUNCTIO.
